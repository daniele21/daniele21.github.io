---
/**
 * aura-finance.astro
 * Product / proving-ground page using the shared archetype-based project UX.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectProof from '../components/project/ProjectProof.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectRelations from '../components/project/ProjectRelations.astro';

import AuraWhy from '../components/aurafinance/AuraWhy.astro';
import AuraSolution from '../components/aurafinance/AuraSolution.astro';
import AuraBenefits from '../components/aurafinance/AuraBenefits.astro';
import AuraProduct from '../components/aurafinance/AuraProduct.astro';
import AuraPayment from '../components/aurafinance/AuraPayment.astro';
import AuraArchitecture from '../components/aurafinance/AuraArchitecture.astro';
import AuraCta from '../components/aurafinance/AuraCta.astro';

import { auraFinanceData } from '../content/auraFinance';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const { hero } = auraFinanceData;

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Workflow', href: '#workflow' },
  { label: 'Product', href: '#product' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Evidence', href: '#evidence' },
];

const auraFinanceSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Aura Finance",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Cross-platform",
  "description": auraFinanceData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": "https://github.com/daniele21/personal-budget/tree/new-features"
};
---

<BaseLayout
  title={auraFinanceData.meta.title}
  description={auraFinanceData.meta.description}
  jsonLd={auraFinanceSchema}
>
  <ProductSubHeader
    title="Aura Finance"
    badge="Active app"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: 'https://github.com/daniele21/personal-budget/tree/new-features' }}
  />

  <div id="top" data-project-page data-project-archetype="product">
    <ProjectHero
      eyebrow="PRODUCT · LOCAL-FIRST FINANCE"
      title="Aura Finance"
      lede="Understand what you can safely spend, where your money goes and what still needs attention, while keeping the canonical financial workspace on the device first."
      status="Active app"
      meta={['Local-first ledger', 'Deterministic finance rules', 'Human-reviewed automation']}
      actions={[
        { label: 'See the workflow ↓', href: '#workflow' },
        { label: 'GitHub ↗', href: 'https://github.com/daniele21/personal-budget/tree/new-features', variant: 'secondary' },
      ]}
      visualLabel="Aura Finance actual and net home views"
    >
      <div class="aura-hero-visual">
        <figure>
          <img
            data-zoomable
            src={`${baseUrl}/${hero.phoneActual}`}
            alt="Aura Finance Actual home view"
            width="540"
            height="1080"
            loading="eager"
          />
          <figcaption>Actual · complete month</figcaption>
        </figure>
        <figure>
          <img
            data-zoomable
            src={`${baseUrl}/${hero.phoneNet}`}
            alt="Aura Finance Net home view"
            width="540"
            height="1080"
            loading="eager"
          />
          <figcaption>Net · repeatable pattern</figcaption>
        </figure>
        <div class="aura-hero-note">
          <strong>{hero.noteTitle}</strong>
          <span>{hero.noteSub}</span>
        </div>
      </div>
    </ProjectHero>

    <ProjectProof
      statement="A useful financial workspace can keep the local ledger authoritative while automation remains reviewable and cloud continuity stays optional."
      detail="Aura separates deterministic financial decisions from platform-specific capture so convenience does not silently take ownership of the user's history."
    />

    <AuraWhy />
    <AuraBenefits />

    <div id="workflow" class="project-anchor">
      <AuraSolution />
      <AuraPayment baseUrl={baseUrl} />
    </div>

    <div id="product" class="project-anchor">
      <AuraProduct baseUrl={baseUrl} />
    </div>

    <div id="architecture" class="project-anchor">
      <AuraArchitecture baseUrl={baseUrl} />
    </div>

    <ProjectSection
      id="evidence"
      eyebrow="EVIDENCE & LIMITS"
      title="The current proof is about ownership, reviewability and explicit boundaries."
      description="Aura demonstrates a local-first financial workspace and reversible automation. It does not turn those properties into unsupported claims about detection accuracy or financial outcomes."
      tone="subtle"
      width="wide"
    >
      <ProjectEvidenceNote
        title="Implemented product boundaries are not outcome guarantees."
        body="The current implementation supports a local source-of-truth ledger, deterministic finance rules, explicit review of Android payment candidates and optional client-side encrypted cloud continuity."
        evidenced={[
          'Local workspace remains the canonical source of truth',
          'Safe-to-spend and reporting derive from deterministic recorded data',
          'Detected Android payments require explicit review before recording',
          'Optional cloud payloads are encrypted client-side before synchronization',
        ]}
        missing={[
          'Comparative payment-detection accuracy benchmark',
          'Measured financial-outcome improvement versus alternative budgeting tools',
        ]}
      />
    </ProjectSection>

    <ProjectRelations
      title="Related Android system work"
      items={[
        {
          stage: 'BUILD · INFRASTRUCTURE',
          title: 'Android Local LLM Harness',
          href: '/android-local-llm-harness',
          note: 'Reusable on-device AI runtime work',
        },
        {
          stage: 'PRODUCT · LOCAL-FIRST',
          title: 'Aura Finance',
          current: true,
          note: 'Local ownership and reviewable automation',
        },
        {
          stage: 'MEASURE · OBSERVABILITY',
          title: 'Traffic Monitoring Android',
          href: '/traffic-monitoring-android',
          note: 'Android network-boundary observability',
        },
      ]}
    />

    <AuraCta />
  </div>
</BaseLayout>

<style>
  .aura-hero-visual {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 320px)) minmax(220px, 1fr);
    justify-content: center;
    align-items: center;
    gap: clamp(18px, 3vw, 38px);
    padding: clamp(26px, 4vw, 52px);
    border: 1px solid var(--border-medium);
    border-radius: clamp(18px, 2.5vw, 28px);
    background: var(--surface-subtle);
    overflow: hidden;
  }

  .aura-hero-visual figure {
    margin: 0;
    min-width: 0;
  }

  .aura-hero-visual img {
    display: block;
    width: 100%;
    max-height: 620px;
    object-fit: contain;
    border-radius: clamp(16px, 2vw, 24px);
    box-shadow: var(--shadow-lg);
  }

  .aura-hero-visual figcaption {
    margin-top: 10px;
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    text-align: center;
  }

  .aura-hero-note {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink-muted);
  }

  .aura-hero-note strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    letter-spacing: -0.035em;
  }

  .project-anchor {
    scroll-margin-top: calc(var(--header-height) + 64px);
  }

  @media (max-width: 820px) {
    .aura-hero-visual {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .aura-hero-note {
      grid-column: 1 / -1;
      text-align: center;
      align-items: center;
    }
  }

  @media (max-width: 520px) {
    .aura-hero-visual {
      gap: 12px;
      padding: 18px 12px;
    }
  }
</style>
