---
/**
 * Lightweight event-networking card. The two images are approved original
 * flyer exports. Keep their artwork intact and present them as a single
 * vertically continuous mobile-first experience.
 * Standalone layout intentionally avoids the full site navigation in a quick-scan flow.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const frontImage = `${base}/images/network-card-front.png`;
const backImage = `${base}/images/network-card-back.png`;
const vcardUrl = `${base}/daniele-moltisanti.vcf`;
const portfolioUrl = `${base}/`;
const linkedinUrl = 'https://www.linkedin.com/in/daniele-moltisanti/';
const canonicalUrl = 'https://daniele21.github.io/connect';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1025" />
    <meta name="description" content="Daniele Moltisanti — AI Strategy Leader & AI Builder. Local-first. Your AI. Your Data. Your Control." />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Daniele Moltisanti · LOCAL-FIRST." />
    <meta property="og:description" content="Strategic vision. Hands-on execution. Local where it works. Cloud where it adds value." />
    <meta property="og:image" content="https://daniele21.github.io/images/network-card-front.png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <title>Daniele Moltisanti · Digital Card</title>
  </head>
  <body>
    <main class="digital-card-page">
      <header class="topline">
        <span class="eyebrow">DIGITAL BUSINESS CARD</span>
        <span class="topline-brand">LOCAL-FIRST<span class="dot">.</span></span>
      </header>

      <section class="experience" aria-labelledby="flyer-title">
        <h1 id="flyer-title" class="sr-only">Daniele Moltisanti — Local-first AI strategy and product building</h1>
        <div class="flyer-continuum" aria-label="Front and back of the original Local-first flyer, presented vertically">
          <img
            class="flyer-image flyer-front"
            src={frontImage}
            width="1050"
            height="600"
            alt="Front: Daniele Moltisanti, AI Strategy Leader and AI Builder. Local-first. Your AI. Your Data. Your Control."
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <img
            class="flyer-image flyer-back"
            src={backImage}
            width="1672"
            height="941"
            alt="Back: Strategic vision, hands-on execution. Strategy, Build and Control. Local-first is not local-only."
            loading="eager"
            decoding="async"
          />
        </div>
      </section>

      <nav class="actions" aria-label="Contact and sharing">
        <a class="action action-primary" href={vcardUrl} download="Daniele-Moltisanti.vcf">
          <span aria-hidden="true">↓</span> Save contact
        </a>
        <a class="action action-secondary" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <button class="action action-secondary" id="share-button" type="button">
          <span aria-hidden="true">↗</span> Share this card
        </button>
        <a class="action action-text" href={portfolioUrl}>
          Explore my work <span aria-hidden="true">→</span>
        </a>
      </nav>
      <p class="share-status" id="share-status" role="status" aria-live="polite"></p>

      <footer>Private by design. Cloud by choice.</footer>
    </main>

    <script>
      const shareButton = document.getElementById('share-button');
      const shareStatus = document.getElementById('share-status');

      shareButton?.addEventListener('click', async () => {
        const shareUrl = 'https://daniele21.github.io/connect';
        const payload = { title: 'Daniele Moltisanti · LOCAL-FIRST.', text: 'AI Strategy Leader & AI Builder', url: shareUrl };
        if (navigator.share) {
          try {
            await navigator.share(payload);
            return;
          } catch (error) {
            if ((error as Error).name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(shareUrl);
          if (shareStatus) shareStatus.textContent = 'Link copied — ready to share.';
        } catch {
          if (shareStatus) shareStatus.textContent = `Share this link: ${shareUrl}`;
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; color-scheme: dark; }
  :global(body) {
    margin: 0;
    min-height: 100svh;
    color: #f7f8ff;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(ellipse 70% 45% at 50% 56%, rgba(72, 50, 151, .29), transparent),
      radial-gradient(ellipse 55% 30% at 80% 100%, rgba(28, 83, 193, .22), transparent),
      #080c1d;
  }
  :global(button), :global(a) { font: inherit; }
  :global(button:focus-visible), :global(a:focus-visible) { outline: 3px solid #8edbff; outline-offset: 4px; }
  .digital-card-page {
    width: min(100%, 1060px);
    padding: max(24px, env(safe-area-inset-top)) clamp(16px, 4vw, 44px) max(32px, env(safe-area-inset-bottom));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  .topline { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: clamp(24px, 6vh, 66px); }
  .eyebrow { font-size: .72rem; letter-spacing: .18em; color: #99a3ce; font-weight: 700; }
  .topline-brand { font-size: .82rem; color: #eff0ff; letter-spacing: .045em; font-weight: 800; }
  .dot { color: #a98dff; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .experience { flex: 0 0 auto; width: 100%; }
  .flyer-continuum {
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    border-radius: clamp(14px, 3vw, 28px);
    background: linear-gradient(160deg, #090e24 0%, #12122f 55%, #171048 100%);
    box-shadow: 0 24px 58px rgba(0, 0, 0, .32);
  }
  .flyer-continuum::after {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 1px solid rgba(157, 157, 228, .24);
    border-radius: inherit;
  }
  .flyer-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    margin: 0;
  }
  /* A subtle crossfade hides the gray export border between the two
     approved images, preserving both pieces of original artwork. */
  .flyer-front {
    position: relative;
    z-index: 1;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 96%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 96%, transparent 100%);
  }
  .flyer-back {
    margin-top: -2.5%;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 4%, #000 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 4%, #000 100%);
  }
  .actions { margin: clamp(18px, 4vh, 40px) auto 0; display: grid; width: min(100%, 680px); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .action {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    min-height: 51px;
    padding: 13px 15px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    font-size: .95rem;
    cursor: pointer;
    text-align: center;
    border: 1px solid rgba(184, 179, 237, .32);
    color: #f7f8ff;
    background: rgba(51, 52, 98, .28);
    transition: background .15s, border-color .15s;
  }
  .action:hover { border-color: #b99aff; background: rgba(116, 99, 206, .22); }
  .action-primary { background: linear-gradient(112deg, #785bdb, #375cae); border-color: #9a8ae9; }
  .action-primary:hover { background: linear-gradient(112deg, #866de4, #4571c9); }
  .action-text { border-color: transparent; background: transparent; color: #bdb5ff; }
  .share-status { min-height: 1rem; text-align: center; color: #c3beff; font-size: .82rem; margin: 11px auto 0; }
  footer { text-align: center; color: #838eb7; font-size: .75rem; margin-top: auto; padding-top: clamp(22px, 5vh, 56px); letter-spacing: .02em; }
  @media (max-width: 540px) {
    .topline { padding-bottom: clamp(22px, 6vh, 55px); }
    .actions { gap: 9px; }
    .action { font-size: .83rem; min-height: 49px; border-radius: 12px; padding: 10px 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .action { transition: none; }
  }
</style>
