---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectPhase from '../components/project/ProjectPhase.astro';
import ProjectDecisionBand from '../components/project/ProjectDecisionBand.astro';

import TrafficMacHero from '../components/trafficmonitoring/macos/TrafficMacHero.astro';
import TrafficMacMission from '../components/trafficmonitoring/macos/TrafficMacMission.astro';
import TrafficMacProblem from '../components/trafficmonitoring/macos/TrafficMacProblem.astro';
import TrafficMacEvidence from '../components/trafficmonitoring/macos/TrafficMacEvidence.astro';
import TrafficMacSurfaces from '../components/trafficmonitoring/macos/TrafficMacSurfaces.astro';
import TrafficMacCoverage from '../components/trafficmonitoring/macos/TrafficMacCoverage.astro';
import TrafficMacArchitecture from '../components/trafficmonitoring/macos/TrafficMacArchitecture.astro';
import TrafficMacMaturity from '../components/trafficmonitoring/macos/TrafficMacMaturity.astro';
import TrafficPrivacyBoundary from '../components/trafficmonitoring/shared/TrafficPrivacyBoundary.astro';
import TrafficFinalCta from '../components/trafficmonitoring/shared/TrafficFinalCta.astro';

import { trafficMonitoringData as mac } from '../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const subHeaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Decide', href: '#decide' },
  { label: 'Build', href: '#build' },
  { label: 'Test', href: '#test' },
  { label: 'Measure', href: '#measure' },
  { label: 'Decide again', href: '#decide-again' },
];

const cta = {
  label: 'GitHub ↗',
  href: 'https://github.com/daniele21/traffic-monitoring',
};
---

<BaseLayout
  title="Traffic Monitoring for macOS - Local Network Observability"
  description="A privacy-first macOS utility for network usage history, observation coverage, evidence export and progressively stronger application activity evidence."
  canonical={`${import.meta.env.SITE || 'https://daniele21.github.io'}${baseUrl}/traffic-monitoring`}
  ogTitle="Traffic Monitoring for macOS - Local Network Observability"
  ogDescription="Measure what moves. Understand where it moves. Local network evidence for macOS."
  ogImage={`${baseUrl}/images/traffic-monitoring/overview.png`}
>
  <ProductSubHeader
    title="Traffic Monitoring for macOS"
    badge="Active observability project"
    logoPath="images/traffic-monitoring/shield.png"
    links={subHeaderLinks}
    cta={cta}
  />

  <div id="top" data-project-page data-project-archetype="experiment">
    <TrafficMacHero />

    <ProjectPhase
      id="decide"
      step="01"
      label="DECIDE"
      title="What network behavior can be observed locally without overstating the evidence?"
      description="The project starts from useful questions -usage by network, observation coverage and application activity -while treating unknown or unsupported conclusions as valid outcomes rather than gaps to hide."
    >
      <TrafficMacMission />
      <TrafficMacProblem />
    </ProjectPhase>

    <ProjectPhase
      id="build"
      step="02"
      label="BUILD"
      title="Separate authoritative counters, previews and experimental flow evidence."
      description="The architecture keeps platform sources, tracking, persistence, analytics and UI boundaries explicit so stronger evidence can be added without silently changing what earlier tiers are allowed to claim."
      tone="subtle"
    >
      <TrafficMacArchitecture />
    </ProjectPhase>

    <ProjectPhase
      id="test"
      step="03"
      label="TEST"
      title="Make coverage and uncertainty visible in the product itself."
      description="The real workflow is not just a byte counter. Product surfaces expose usage, networks, trends, application previews and technical diagnostics while showing when observation is partial or degraded."
    >
      <TrafficMacSurfaces />
      <TrafficMacCoverage />
    </ProjectPhase>

    <ProjectPhase
      id="measure"
      step="04"
      label="MEASURE"
      title="Tie every conclusion to the strength of its evidence source."
      description="Traffic Monitoring explicitly distinguishes authoritative physical-interface evidence, best-effort application previews and an experimental signed provider path. Privacy boundaries and maturity status are part of the evidence, not footnotes."
      tone="subtle"
    >
      <TrafficMacEvidence />
      <TrafficPrivacyBoundary
        title="macOS Privacy & Trust Boundaries"
        keptVisible={mac.privacy.keptVisible}
        notClaimed={mac.privacy.notClaimed}
      />
      <TrafficMacMaturity />
    </ProjectPhase>

    <ProjectPhase
      id="decide-again"
      step="05"
      label="DECIDE AGAIN"
      title="Keep strong claims narrow until stronger evidence is release-validated."
      description="The current decision is to treat physical-interface usage and historical export as authoritative, application activity as best-effort preview, and per-app locality as unresolved until controlled signed real-Mac evidence exists."
    >
      <ProjectDecisionBand
        title="Authoritative where measured. Explicitly uncertain everywhere else."
        body="Core network usage and coverage are implemented from physical-interface evidence. Application activity remains a non-privileged best-effort preview, while per-app locality and byte accounting are not release-validated. The product keeps those evidence tiers separate instead of collapsing them into one confidence level."
        signals={[
          'Physical-interface usage and historical evidence are implemented',
          'Application activity remains Beta / best-effort',
          'Per-app locality waits for controlled signed real-Mac validation',
        ]}
      />
    </ProjectPhase>

    <TrafficFinalCta
      kicker={mac.finalCta.kicker}
      headline={mac.finalCta.headline}
      body={mac.finalCta.body}
      primaryCtaLabel={mac.finalCta.primaryCtaLabel}
      primaryCtaHref={mac.finalCta.primaryCtaHref}
      secondaryCtaLabel={mac.finalCta.secondaryCtaLabel}
      secondaryCtaHref={mac.finalCta.secondaryCtaHref}
    />
  </div>
</BaseLayout>
