---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const guideSections = [
  {
    id: 'fundamentals',
    number: '01',
    title: 'Fundamentals',
    question: 'Should this workload be local at all?',
    description: 'Start with the execution boundary before choosing a model or runtime.',
    topics: ['Local AI vs cloud AI', 'Local-first vs local-only', 'Open-weight models', 'Quantization', 'Local / cloud boundaries'],
    outcome: 'A clear reason for what belongs on-device and what does not.',
  },
  {
    id: 'models',
    number: '02',
    title: 'Models & inference',
    question: 'What is the smallest model that can solve the task?',
    description: 'Model quality only matters in the context of the workload and device budget.',
    topics: ['Dense vs MoE', '1B–7B model classes', 'GGUF', 'Quantization formats', 'Context & KV cache'],
    outcome: 'A model class and representation that fit the task, not a leaderboard.',
  },
  {
    id: 'runtimes',
    number: '03',
    title: 'Runtimes',
    question: 'How should the model actually execute?',
    description: 'The runtime is the layer that translates model weights into product behaviour.',
    topics: ['llama.cpp', 'MLX', 'Ollama', 'MLC / ExecuTorch', 'Runtime abstraction'],
    outcome: 'An execution layer compatible with the target platform and lifecycle.',
  },
  {
    id: 'hardware',
    number: '04',
    title: 'Hardware',
    question: 'What constraints does the device impose?',
    description: 'RAM, memory bandwidth and thermals can invalidate an otherwise good model choice.',
    topics: ['Apple Silicon', 'Android', 'CPU / GPU / NPU', 'Memory pressure', 'Thermal behaviour'],
    outcome: 'A realistic device envelope for latency, memory and sustained use.',
  },
  {
    id: 'engineering',
    number: '05',
    title: 'Product engineering',
    question: 'What happens after the first successful generation?',
    description: 'Product-grade local AI needs lifecycle, sharing, observability and failure handling.',
    topics: ['Model lifecycle', 'Residency & switching', 'Concurrency', 'IPC', 'Observability & evidence'],
    outcome: 'A runtime architecture that can survive real application behaviour.',
  },
  {
    id: 'benchmarks',
    number: '06',
    title: 'Benchmarking',
    question: 'How do we know the system is good enough?',
    description: 'Measure the real workload on the real device instead of relying on generic scores.',
    topics: ['TTFT', 'Tokens / second', 'Peak RAM', 'Load time', 'Thermals', 'Task quality'],
    outcome: 'Evidence that connects technical performance to product usefulness.',
  },
];

const experiments = [
  {
    number: '01',
    title: 'Android Local LLM Harness',
    text: 'On-device model lifecycle, memory, IPC and multi-application runtime behaviour.',
    href: `${baseUrl}/android-local-llm-harness`,
    signal: 'Android · llama.cpp · physical devices',
  },
  {
    number: '02',
    title: 'Local LLM Server',
    text: 'Desktop model residency, routing, concurrency, runtime backends and telemetry.',
    href: `${baseUrl}/local-llm-server`,
    signal: 'Desktop · GGUF / MLX · lifecycle',
  },
  {
    number: '03',
    title: 'Traffic Monitoring',
    text: 'Evidence for what local software did — and did not — send over the network.',
    href: `${baseUrl}/traffic-monitoring`,
    signal: 'Network evidence · privacy claims',
  },
];
---

<BaseLayout
  title="Local AI Field Guide — Daniele Moltisanti"
  description="A working field guide to local AI, on-device inference, llama.cpp, quantization, runtimes, hardware constraints, product engineering and workload-based benchmarking."
  ogTitle="The Local AI Field Guide — Daniele Moltisanti"
  ogDescription="Notes, experiments and engineering principles for moving suitable AI workloads closer to the user."
>
  <section class="guide-hero" id="top">
    <div class="shell guide-hero-grid">
      <div>
        <div class="guide-identity"><span>Daniele Moltisanti</span><b aria-hidden="true">·</b> Local AI Field Guide</div>
        <h1>A working map of <span>product-grade local AI.</span></h1>
        <p>This is not a glossary. It is a decision path: from deciding whether a workload belongs locally to proving that the resulting system is good enough.</p>
        <div class="guide-actions">
          <a class="guide-button primary" href="#guide">Start with the map →</a>
          <a class="guide-button" href={`${baseUrl}/#local-ai-lab`}>See running experiments →</a>
        </div>
      </div>
      <aside class="guide-note">
        <div class="note-mark" aria-hidden="true">◎</div>
        <span>WORKING PRINCIPLE</span>
        <strong>Benchmark the workload, not the leaderboard.</strong>
        <p>The useful question is not “what model wins?” but “what is the smallest system that solves this task reliably on this hardware?”</p>
      </aside>
    </div>

    <div class="shell decision-strip" aria-label="Local AI decision path">
      <span>Boundary</span><b>→</b><span>Model</span><b>→</b><span>Runtime</span><b>→</b><span>Hardware</span><b>→</b><span>Engineering</span><b>→</b><span>Evidence</span>
    </div>
  </section>

  <section class="section guide-section" id="guide">
    <div class="shell">
      <div class="section-heading">
        <div>
          <div class="section-kicker">THE DECISION MAP</div>
          <h2>Six layers, in the order I evaluate them.</h2>
        </div>
        <p>Each layer answers one decision before the next one becomes useful.</p>
      </div>

      <div class="guide-layout">
        <aside class="guide-nav" aria-label="Field guide chapters">
          <div class="guide-nav-inner">
            <span class="guide-nav-label">JUMP TO</span>
            {guideSections.map((section) => (
              <a href={`#${section.id}`}>
                <span>{section.number}</span>
                <strong>{section.title}</strong>
              </a>
            ))}
            <div class="reading-note">
              <strong>Read it as a system.</strong>
              <p>A model decision can change when hardware, runtime or workload evidence changes.</p>
            </div>
          </div>
        </aside>

        <div class="guide-content">
          {guideSections.map((section) => (
            <article class="chapter-card" id={section.id}>
              <div class="chapter-top">
                <span class="chapter-number">{section.number}</span>
                <div>
                  <span class="chapter-label">DECISION LAYER</span>
                  <h3>{section.title}</h3>
                </div>
              </div>

              <div class="chapter-question">
                <span>QUESTION</span>
                <strong>{section.question}</strong>
              </div>

              <p class="chapter-description">{section.description}</p>

              <div class="chapter-details">
                <div>
                  <span class="detail-label">CORE TOPICS</span>
                  <ul>
                    {section.topics.map((topic) => <li>{topic}</li>)}
                  </ul>
                </div>
                <div class="chapter-outcome">
                  <span class="detail-label">OUTPUT</span>
                  <p>{section.outcome}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section experiments-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <div class="section-kicker">FROM MAP TO EVIDENCE</div>
          <h2>The guide stays connected to running software.</h2>
        </div>
        <p>These projects expose constraints that generic AI guidance tends to hide.</p>
      </div>

      <div class="experiment-grid">
        {experiments.map((experiment) => (
          <a class="experiment-card" href={experiment.href}>
            <div class="experiment-head"><span>{experiment.number}</span><small>{experiment.signal}</small></div>
            <h3>{experiment.title}</h3>
            <p>{experiment.text}</p>
            <strong>Explore experiment →</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section guide-cta">
    <div class="shell guide-cta-inner">
      <div>
        <div class="section-kicker">FOLLOW THE WORK</div>
        <h2>Code, analysis and working ideas.</h2>
        <p>GitHub shows the implementation. stAI tuned carries the deeper analysis. LinkedIn is where new findings surface first.</p>
      </div>
      <div class="channel-links">
        <a href="https://github.com/daniele21" target="_blank" rel="noreferrer"><span>Code</span>GitHub ↗</a>
        <a href="https://staituned.com" target="_blank" rel="noreferrer"><span>Analysis</span>stAI tuned ↗</a>
        <a href="https://www.linkedin.com/in/daniele-moltisanti/" target="_blank" rel="noreferrer"><span>Updates</span>LinkedIn ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-hero { padding: clamp(48px, 7vw, 92px) 0 clamp(48px, 7vw, 80px); }
  .guide-hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, .62fr); gap: clamp(40px, 7vw, 92px); align-items: center; }
  .guide-identity { display: flex; align-items: center; gap: 8px; margin-bottom: var(--space-5); color: var(--ink-subtle); font-size: .72rem; font-weight: 750; letter-spacing: .07em; text-transform: uppercase; }
  .guide-identity span { color: var(--ink); font-weight: 850; }
  .guide-identity b { color: var(--accent-blue); }
  .guide-hero h1 { margin: 0; max-width: 820px; color: var(--ink); font-family: var(--font-display); font-size: clamp(2.75rem, 5.4vw, 5rem); line-height: .99; letter-spacing: -.055em; }
  .guide-hero h1 span { color: var(--accent-blue); }
  .guide-hero-grid > div > p { max-width: 700px; margin: var(--space-6) 0 0; color: var(--ink-muted); font-size: var(--text-body-lg); line-height: 1.62; }
  .guide-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7, 28px); }
  .guide-button { display: inline-flex; min-height: 46px; align-items: center; padding: 10px 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--ink); background: var(--surface-card); text-decoration: none; font-size: var(--text-small); font-weight: 750; transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease; }
  .guide-button:hover { transform: translateY(-2px); border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
  .guide-button.primary { border-color: var(--accent-blue); color: #fff; background: var(--accent-blue); }

  .guide-note { position: relative; padding: clamp(24px, 3vw, 32px); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-card); box-shadow: var(--shadow-md); overflow: hidden; }
  .guide-note::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 100% 0%, var(--surface-blue), transparent 50%); }
  .guide-note > * { position: relative; }
  .note-mark { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: var(--space-5); border-radius: 12px; background: var(--surface-blue); color: var(--accent-blue); font-size: 1.2rem; }
  .guide-note span { color: var(--accent-blue); font-size: .66rem; font-weight: 850; letter-spacing: .12em; }
  .guide-note strong { display: block; margin-top: var(--space-3); color: var(--ink); font-family: var(--font-display); font-size: 1.25rem; line-height: 1.3; }
  .guide-note p { margin: var(--space-3) 0 0; color: var(--ink-muted); font-size: .79rem; line-height: 1.55; }

  .decision-strip { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: clamp(38px, 5vw, 60px); padding: 14px 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-muted); }
  .decision-strip span { color: var(--ink); font-size: .72rem; font-weight: 720; }
  .decision-strip b { color: var(--border-strong); font-weight: 500; }

  .guide-section { border-top: 1px solid var(--border-subtle); }
  .guide-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .guide-nav { position: relative; }
  .guide-nav-inner { position: sticky; top: calc(var(--header-height) + 24px); padding: 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-card); }
  .guide-nav-label { display: block; margin-bottom: 10px; color: var(--ink-subtle); font-size: .63rem; font-weight: 850; letter-spacing: .1em; }
  .guide-nav a { display: grid; grid-template-columns: 24px 1fr; gap: 9px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border-subtle); color: var(--ink-muted); text-decoration: none; }
  .guide-nav a:hover { color: var(--accent-blue); }
  .guide-nav a span { color: var(--accent-blue); font-family: var(--font-mono); font-size: .64rem; font-weight: 800; }
  .guide-nav a strong { font-size: .75rem; font-weight: 690; }
  .reading-note { margin-top: var(--space-4); padding: 12px; border-radius: 10px; background: var(--surface-blue); }
  .reading-note strong { color: var(--ink); font-size: .72rem; }
  .reading-note p { margin: 5px 0 0; color: var(--ink-muted); font-size: .67rem; line-height: 1.45; }

  .guide-content { display: grid; gap: var(--space-4); }
  .chapter-card { scroll-margin-top: calc(var(--header-height) + 24px); padding: clamp(24px, 3vw, 32px); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-card); }
  .chapter-top { display: grid; grid-template-columns: 52px 1fr; gap: var(--space-4); align-items: center; }
  .chapter-number { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--surface-blue); color: var(--accent-blue); font-family: var(--font-mono); font-size: .74rem; font-weight: 850; }
  .chapter-label { display: block; color: var(--ink-subtle); font-size: .61rem; font-weight: 850; letter-spacing: .1em; }
  .chapter-card h3 { margin: 4px 0 0; color: var(--ink); font-family: var(--font-display); font-size: 1.28rem; }
  .chapter-question { margin-top: var(--space-5); padding: 14px 16px; border-left: 3px solid var(--accent-blue); background: var(--surface-blue); }
  .chapter-question span { display: block; color: var(--accent-blue); font-size: .6rem; font-weight: 850; letter-spacing: .09em; }
  .chapter-question strong { display: block; margin-top: 5px; color: var(--ink); font-family: var(--font-display); font-size: .9rem; }
  .chapter-description { margin: var(--space-4) 0 0; color: var(--ink-muted); font-size: .86rem; line-height: 1.58; }
  .chapter-details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, .7fr); gap: var(--space-5); margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--border-subtle); }
  .detail-label { display: block; margin-bottom: 10px; color: var(--ink-subtle); font-size: .61rem; font-weight: 850; letter-spacing: .09em; }
  .chapter-details ul { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .chapter-details li { padding: 5px 8px; border-radius: 999px; background: var(--surface-muted); color: var(--ink-muted); font-size: .68rem; font-weight: 650; }
  .chapter-outcome { padding-left: var(--space-5); border-left: 1px solid var(--border-subtle); }
  .chapter-outcome p { margin: 0; color: var(--ink); font-size: .78rem; font-weight: 620; line-height: 1.5; }

  .experiments-section { background: var(--surface-muted); }
  .experiment-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .experiment-card { display: flex; flex-direction: column; min-height: 235px; padding: var(--space-5); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-card); text-decoration: none; transition: transform var(--duration-base) var(--ease-out-expo), box-shadow var(--duration-base) ease, border-color var(--duration-fast) ease; }
  .experiment-card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-md); }
  .experiment-head { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
  .experiment-head span { color: var(--accent-blue); font-family: var(--font-mono); font-size: .66rem; font-weight: 850; }
  .experiment-head small { color: var(--ink-subtle); font-size: .62rem; text-align: right; }
  .experiment-card h3 { margin: var(--space-5) 0 0; color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; }
  .experiment-card p { margin: var(--space-3) 0 0; color: var(--ink-muted); font-size: .79rem; line-height: 1.55; }
  .experiment-card > strong { margin-top: auto; padding-top: var(--space-5); color: var(--accent-blue); font-size: .75rem; }

  .guide-cta-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .7fr); gap: var(--space-8); align-items: center; padding: clamp(28px, 4vw, 42px); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); background: var(--surface-card); }
  .guide-cta h2 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: var(--text-h2); }
  .guide-cta p { max-width: 700px; margin: var(--space-3) 0 0; color: var(--ink-muted); line-height: 1.58; }
  .channel-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
  .channel-links a { display: flex; flex-direction: column; gap: 5px; padding: 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--ink); background: var(--surface-muted); text-decoration: none; font-size: .75rem; font-weight: 750; }
  .channel-links a span { color: var(--ink-subtle); font-size: .6rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .channel-links a:hover { border-color: var(--border-strong); color: var(--accent-blue); }

  @media (max-width: 980px) {
    .guide-hero-grid { grid-template-columns: 1fr; }
    .guide-note { max-width: 620px; }
    .guide-layout { grid-template-columns: 1fr; }
    .guide-nav-inner { position: static; display: flex; gap: 7px; overflow-x: auto; padding: 10px; }
    .guide-nav-label,
    .reading-note { display: none; }
    .guide-nav a { grid-template-columns: auto auto; flex: 0 0 auto; gap: 6px; padding: 8px 10px; border: 1px solid var(--border-subtle); border-radius: 999px; }
    .experiment-grid { grid-template-columns: 1fr; }
    .experiment-card { min-height: 0; }
    .guide-cta-inner { grid-template-columns: 1fr; align-items: start; }
  }

  @media (max-width: 700px) {
    .decision-strip { overflow-x: auto; justify-content: flex-start; }
    .decision-strip span,
    .decision-strip b { flex: 0 0 auto; }
    .chapter-details { grid-template-columns: 1fr; }
    .chapter-outcome { padding: var(--space-4) 0 0; border-left: 0; border-top: 1px solid var(--border-subtle); }
    .channel-links { grid-template-columns: 1fr; }
  }

  @media (max-width: 580px) {
    .guide-hero { padding-top: 28px; }
    .guide-identity { align-items: flex-start; flex-wrap: wrap; }
    .guide-actions { flex-direction: column; }
    .guide-button { width: 100%; justify-content: center; }
    .chapter-top { grid-template-columns: 44px 1fr; }
    .chapter-number { width: 42px; height: 42px; border-radius: 12px; }
  }
</style>
