---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const guideSections = [
  {
    id: 'fundamentals',
    number: '01',
    title: 'Fundamentals',
    description: 'The vocabulary and architectural choices behind local-first systems.',
    topics: ['Local AI vs cloud AI', 'Local-first vs local-only', 'Open-weight models', 'Quantization', 'Local / cloud boundaries'],
  },
  {
    id: 'models',
    number: '02',
    title: 'Models & inference',
    description: 'Choosing the smallest model and representation that still solves the workload.',
    topics: ['Dense vs MoE', '1B–7B model classes', 'GGUF', 'Quantization formats', 'Context & KV cache'],
  },
  {
    id: 'runtimes',
    number: '03',
    title: 'Runtimes',
    description: 'The execution layer between model weights, hardware and the application.',
    topics: ['llama.cpp', 'MLX', 'Ollama', 'MLC / ExecuTorch', 'Runtime abstraction'],
  },
  {
    id: 'hardware',
    number: '04',
    title: 'Hardware',
    description: 'Where memory bandwidth, available RAM and thermals reshape architecture.',
    topics: ['Apple Silicon', 'Android', 'CPU / GPU / NPU', 'Memory pressure', 'Thermal behaviour'],
  },
  {
    id: 'engineering',
    number: '05',
    title: 'Product engineering',
    description: 'The work required after the model has generated its first token.',
    topics: ['Model lifecycle', 'Residency & switching', 'Concurrency', 'IPC', 'Observability & evidence'],
  },
  {
    id: 'benchmarks',
    number: '06',
    title: 'Benchmarking',
    description: 'Measure the actual workload on the actual device instead of optimizing for a leaderboard.',
    topics: ['TTFT', 'Tokens / second', 'Peak RAM', 'Load time', 'Thermals', 'Task quality'],
  },
];

const experiments = [
  {
    title: 'Android Local LLM Harness',
    text: 'On-device model lifecycle, memory, IPC and multi-application runtime behaviour.',
    href: `${baseUrl}/android-local-llm-harness`,
  },
  {
    title: 'Local LLM Server',
    text: 'Desktop model residency, routing, concurrency, runtime backends and telemetry.',
    href: `${baseUrl}/local-llm-server`,
  },
  {
    title: 'Traffic Monitoring',
    text: 'Evidence for what local software did — and did not — send over the network.',
    href: `${baseUrl}/traffic-monitoring`,
  },
];
---

<BaseLayout
  title="Local AI Field Guide — Daniele Moltisanti"
  description="A working field guide to local AI, on-device inference, llama.cpp, quantization, runtimes, hardware constraints, product engineering and workload-based benchmarking."
  ogTitle="The Local AI Field Guide — Daniele Moltisanti"
  ogDescription="Notes, experiments and engineering principles for moving suitable AI workloads closer to the user."
>
  <section class="guide-hero" id="top">
    <div class="shell guide-hero-grid">
      <div>
        <div class="section-kicker">LOCAL AI FIELD GUIDE</div>
        <h1>A working map of <span>product-grade local AI.</span></h1>
        <p>This is not a glossary. It is an evolving index of the engineering questions I use to decide whether a workload belongs locally, in the cloud, or across both.</p>
        <div class="guide-actions">
          <a class="guide-button primary" href="#guide">Explore the guide →</a>
          <a class="guide-button" href={`${baseUrl}/#local-ai-lab`}>Open the Local AI Lab →</a>
        </div>
      </div>
      <aside class="guide-note">
        <span>WORKING PRINCIPLE</span>
        <strong>Benchmark the workload, not the leaderboard.</strong>
        <p>The useful question is not “what model wins?” but “what is the smallest system that solves this task reliably on this hardware?”</p>
      </aside>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="section" id="guide">
    <div class="shell">
      <div class="section-heading">
        <div>
          <div class="section-kicker">THE MAP</div>
          <h2>Six layers to understand.</h2>
        </div>
        <p>Local AI becomes a product discipline when model quality, runtime behaviour and hardware constraints are evaluated as one system.</p>
      </div>

      <div class="guide-grid">
        {guideSections.map((section) => (
          <article class="guide-card" id={section.id}>
            <div class="guide-index">{section.number}</div>
            <h3>{section.title}</h3>
            <p>{section.description}</p>
            <ul>
              {section.topics.map((topic) => <li>{topic}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section experiments-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <div class="section-kicker">FROM NOTES TO EVIDENCE</div>
          <h2>Current experiments behind the guide.</h2>
        </div>
        <p>The field guide stays connected to running software. These projects expose the constraints that generic AI guidance tends to hide.</p>
      </div>

      <div class="experiment-grid">
        {experiments.map((experiment) => (
          <a class="experiment-card" href={experiment.href}>
            <h3>{experiment.title}</h3>
            <p>{experiment.text}</p>
            <span>Explore experiment →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section guide-cta">
    <div class="shell guide-cta-inner">
      <div>
        <div class="section-kicker">FOLLOW THE WORK</div>
        <h2>The guide will grow with the experiments.</h2>
        <p>Code and measurements live on GitHub. Deeper analysis lives on stAI tuned. Working ideas and new findings surface on LinkedIn.</p>
      </div>
      <div class="channel-links">
        <a href="https://github.com/daniele21" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://staituned.com" target="_blank" rel="noreferrer">stAI tuned ↗</a>
        <a href="https://www.linkedin.com/in/daniele-moltisanti/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-hero { padding: clamp(56px, 8vw, 110px) 0 clamp(64px, 9vw, 120px); }
  .guide-hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .6fr); gap: clamp(40px, 7vw, 96px); align-items: center; }
  .guide-hero h1 { margin: 0; max-width: 820px; color: var(--ink); font-family: var(--font-display); font-size: clamp(2.8rem, 5.5vw, 5.2rem); line-height: .98; letter-spacing: -.055em; }
  .guide-hero h1 span { color: var(--accent-blue); }
  .guide-hero > .shell > div > p { max-width: 720px; margin: var(--space-6) 0 0; color: var(--ink-muted); font-size: var(--text-body-lg); line-height: 1.65; }
  .guide-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .guide-button { display: inline-flex; min-height: 46px; align-items: center; padding: 10px 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--ink); background: var(--surface-card); text-decoration: none; font-size: var(--text-small); font-weight: 750; }
  .guide-button.primary { border-color: var(--accent-blue); color: #fff; background: var(--accent-blue); }
  .guide-note { padding: clamp(24px, 3vw, 34px); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: linear-gradient(145deg, var(--surface-card), var(--surface-blue)); box-shadow: var(--shadow-md); }
  .guide-note span { color: var(--accent-blue); font-size: var(--text-xs); font-weight: 800; letter-spacing: .12em; }
  .guide-note strong { display: block; margin-top: var(--space-4); color: var(--ink); font-family: var(--font-display); font-size: 1.3rem; line-height: 1.3; }
  .guide-note p { margin: var(--space-3) 0 0; color: var(--ink-muted); font-size: var(--text-small); line-height: 1.6; }

  .guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .guide-card { padding: var(--space-6); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-card); scroll-margin-top: calc(var(--header-height) + 20px); }
  .guide-index { color: var(--accent-blue); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 800; }
  .guide-card h3 { margin: var(--space-4) 0 var(--space-2); color: var(--ink); font-family: var(--font-display); }
  .guide-card > p { margin: 0; min-height: 70px; color: var(--ink-muted); font-size: var(--text-small); line-height: 1.55; }
  .guide-card ul { display: grid; gap: 7px; margin: var(--space-5) 0 0; padding: var(--space-4) 0 0; border-top: 1px solid var(--border-subtle); list-style: none; }
  .guide-card li { color: var(--ink-subtle); font-size: var(--text-small); }
  .guide-card li::before { content: '→'; margin-right: 8px; color: var(--accent-blue); }

  .experiments-section { background: var(--surface-muted); }
  .experiment-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .experiment-card { display: block; padding: var(--space-6); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-card); text-decoration: none; transition: transform var(--duration-base) var(--ease-out-expo), box-shadow var(--duration-base) ease; }
  .experiment-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .experiment-card h3 { margin: 0; color: var(--ink); font-family: var(--font-display); }
  .experiment-card p { margin: var(--space-3) 0 0; color: var(--ink-muted); font-size: var(--text-small); line-height: 1.6; }
  .experiment-card span { display: block; margin-top: var(--space-6); color: var(--accent-blue); font-size: var(--text-small); font-weight: 750; }

  .guide-cta-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); align-items: end; padding: clamp(28px, 4vw, 44px); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); background: var(--surface-card); }
  .guide-cta h2 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: var(--text-h2); }
  .guide-cta p { max-width: 720px; margin: var(--space-3) 0 0; color: var(--ink-muted); line-height: 1.6; }
  .channel-links { display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-end; }
  .channel-links a { color: var(--accent-blue); text-decoration: none; font-size: var(--text-small); font-weight: 750; }

  @media (max-width: 980px) {
    .guide-hero-grid { grid-template-columns: 1fr; }
    .guide-note { max-width: 620px; }
    .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .experiment-grid { grid-template-columns: 1fr; }
    .guide-cta-inner { grid-template-columns: 1fr; align-items: start; }
    .channel-links { align-items: flex-start; }
  }

  @media (max-width: 640px) {
    .guide-grid { grid-template-columns: 1fr; }
    .guide-actions { flex-direction: column; }
    .guide-button { width: 100%; justify-content: center; }
  }
</style>
