---
/**
 * closedroom.astro
 * Product / proving-ground page using the shared archetype-based project UX.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectProof from '../components/project/ProjectProof.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectRelations from '../components/project/ProjectRelations.astro';

import ClosedRoomProblem from '../components/closedroom/ClosedRoomProblem.astro';
import ClosedRoomSolution from '../components/closedroom/ClosedRoomSolution.astro';
import ClosedRoomValues from '../components/closedroom/ClosedRoomValues.astro';
import ClosedRoomProduct from '../components/closedroom/ClosedRoomProduct.astro';
import ClosedRoomFlow from '../components/closedroom/ClosedRoomFlow.astro';
import ClosedRoomArchitecture from '../components/closedroom/ClosedRoomArchitecture.astro';
import ClosedRoomTrust from '../components/closedroom/ClosedRoomTrust.astro';
import ClosedRoomCta from '../components/closedroom/ClosedRoomCta.astro';

import { closedRoomData } from '../content/closedRoom';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const { hero } = closedRoomData;

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Workflow', href: '#workflow' },
  { label: 'Product', href: '#product' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Evidence', href: '#evidence' },
];

const closedRoomSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ClosedRoom",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "macOS",
  "description": closedRoomData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": "https://github.com/daniele21/local-asr-server/tree/speaker_detection"
};
---

<BaseLayout
  title={closedRoomData.meta.title}
  description={closedRoomData.meta.description}
  jsonLd={closedRoomSchema}
>
  <ProductSubHeader
    title="ClosedRoom"
    badge="macOS app"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: 'https://github.com/daniele21/local-asr-server/tree/speaker_detection' }}
  />

  <div id="top" data-project-page data-project-archetype="product">
    <ProjectHero
      eyebrow="PRODUCT · LOCAL-FIRST MEETING INTELLIGENCE"
      title="ClosedRoom"
      lede="Record, transcribe, identify speakers, analyze and remember meetings locally on macOS, so decisions and project context do not disappear after the call."
      status="macOS app · active development"
      meta={['Local-first by default', 'Speaker-aware transcripts', 'Cross-meeting project memory']}
      actions={[
        { label: 'See the workflow ↓', href: '#workflow' },
        { label: 'GitHub ↗', href: 'https://github.com/daniele21/local-asr-server/tree/speaker_detection', variant: 'secondary' },
      ]}
      visualLabel="ClosedRoom meeting and project intelligence interfaces"
    >
      <div class="closedroom-hero-visual">
        <figure class="hero-shot hero-shot-main">
          <img
            data-zoomable
            src={`${baseUrl}/${hero.imageHome}`}
            alt="ClosedRoom home workspace"
            width="1440"
            height="900"
            loading="eager"
          />
          <figcaption>Meeting workspace</figcaption>
        </figure>
        <figure class="hero-shot hero-shot-secondary">
          <img
            data-zoomable
            src={`${baseUrl}/${hero.imageAnalysis}`}
            alt="ClosedRoom structured meeting analysis"
            width="1440"
            height="900"
            loading="eager"
          />
          <figcaption>Structured meeting intelligence</figcaption>
        </figure>
        <p class="hero-flow-note">{hero.visualNote}</p>
      </div>
    </ProjectHero>

    <ProjectProof
      statement="Meeting intelligence can keep the default trust boundary local while still producing actions, decisions, risks and reusable project memory."
      detail="ClosedRoom separates capture, transcription, enrichment and analysis so optional cloud providers remain explicit choices rather than hidden dependencies."
    />

    <ClosedRoomProblem />
    <ClosedRoomValues />

    <div id="workflow" class="project-anchor">
      <ClosedRoomSolution />
      <ClosedRoomFlow baseUrl={baseUrl} />
    </div>

    <div id="product" class="project-anchor">
      <ClosedRoomProduct baseUrl={baseUrl} />
    </div>

    <div id="architecture" class="project-anchor">
      <ClosedRoomArchitecture baseUrl={baseUrl} />
    </div>

    <ProjectSection
      id="evidence"
      eyebrow="EVIDENCE & TRUST BOUNDARY"
      title="Local by default is implemented as a system boundary, not a marketing label."
      description="The strongest current evidence is architectural and product-level: the default path keeps meeting artifacts and local analysis on the Mac, while external providers remain explicit opt-in paths."
      tone="subtle"
      width="wide"
    >
      <ClosedRoomTrust />
      <ProjectEvidenceNote
        title="The trust boundary is explicit; broader privacy guarantees still require scoped validation."
        body="ClosedRoom documents and implements a local default path for meeting artifacts and analysis state. Optional Speechmatics and Gemini integrations sit outside that boundary and are used only when selected."
        evidenced={[
          'Audio, transcripts and project state remain on the Mac in the default path',
          'Local ASR and local model runtimes are available behind explicit service boundaries',
          'Cloud providers remain explicit opt-in choices',
          'Optional enrichment can fail without invalidating a usable transcript',
        ]}
        missing={[
          'Independent end-to-end privacy certification',
          'Published representative performance benchmark across supported Macs',
        ]}
      />
    </ProjectSection>

    <ProjectRelations
      items={[
        {
          stage: 'BUILD · SPEECH INFRASTRUCTURE',
          title: 'Local ASR Server',
          href: '/local-asr-server',
          note: 'Reusable local speech recognition layer',
        },
        {
          stage: 'PRODUCT · MEETING INTELLIGENCE',
          title: 'ClosedRoom',
          current: true,
          note: 'Local-first end-to-end proving ground',
        },
        {
          stage: 'MEASURE · PERFORMANCE',
          title: 'Performance Lab',
          href: '/performance-lab',
          note: 'Hardware and runtime viability evidence',
        },
      ]}
    />

    <ClosedRoomCta />
  </div>
</BaseLayout>

<style>
  .closedroom-hero-visual {
    position: relative;
    min-height: clamp(430px, 58vw, 680px);
    padding: clamp(24px, 4vw, 46px);
    border: 1px solid var(--border-medium);
    border-radius: clamp(18px, 2.5vw, 28px);
    background: var(--surface-subtle);
    overflow: hidden;
  }

  .hero-shot {
    margin: 0;
    border: 1px solid var(--border-medium);
    border-radius: clamp(14px, 2vw, 22px);
    background: var(--surface-card);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-shot figcaption {
    padding: 9px 12px;
    border-top: 1px solid var(--border-subtle);
    color: var(--ink-subtle);
    font-size: var(--text-caption);
  }

  .hero-shot-main {
    width: min(78%, 820px);
  }

  .hero-shot-secondary {
    position: absolute;
    right: clamp(20px, 4vw, 48px);
    bottom: clamp(48px, 6vw, 78px);
    width: min(48%, 520px);
  }

  .hero-flow-note {
    position: absolute;
    left: clamp(24px, 4vw, 46px);
    bottom: clamp(18px, 3vw, 32px);
    margin: 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .project-anchor {
    scroll-margin-top: calc(var(--header-height) + 64px);
  }

  @media (max-width: 720px) {
    .closedroom-hero-visual {
      min-height: 0;
      display: grid;
      gap: 16px;
    }

    .hero-shot-main,
    .hero-shot-secondary {
      position: static;
      width: 100%;
    }

    .hero-flow-note {
      position: static;
    }
  }
</style>
