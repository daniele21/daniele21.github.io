---
/**
 * harnex.astro
 * Harnex infrastructure project page.
 * Narrative: value → differentiators → real product → architecture → integration → evidence → status.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectProof from '../components/project/ProjectProof.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectDecisionBand from '../components/project/ProjectDecisionBand.astro';
import ProjectRelations from '../components/project/ProjectRelations.astro';
import ProjectCta from '../components/project/ProjectCta.astro';

import {
  harnexArchitectureLayers,
  harnexProductSurfaces,
  harnexProjectData as data,
  harnexRuntimeCapabilities,
} from '../content/locales/en/harnexProject';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const formatHighlight = (text: string) =>
  text ? text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') : '';

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Runtime', href: '#runtime' },
  { label: 'Evidence', href: '#evidence' },
  { label: 'Status', href: '#status' },
];

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.hero.title,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Android',
  description: data.meta.description,
  author: {
    '@type': 'Person',
    name: 'Daniele Moltisanti',
    url: 'https://daniele21.github.io/',
  },
  codeRepository: data.cta.primaryAction.href,
};
---

<BaseLayout
  title={data.meta.title}
  description={data.meta.description}
  jsonLd={projectSchema}
>
  <ProductSubHeader
    title={data.hero.title}
    badge={data.hero.status.split('·')[0]?.trim()}
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: data.cta.primaryAction.href }}
  />

  <div id="top" data-project-page data-project-archetype="infrastructure">
    <ProjectHero
      eyebrow={data.hero.eyebrow}
      title={data.hero.title}
      lede={data.hero.lede}
      status={data.hero.status}
      meta={data.hero.meta}
      actions={data.hero.actions}
      visualLabel={data.hero.visualLabel}
    >
      <div class="media-frame media-frame--hero">
        <img
          data-zoomable
          src={`${baseUrl}/${data.hero.imageHero.replace(/^\//, '')}`}
          alt={data.hero.visualLabel}
          width="1672"
          height="941"
          loading="eager"
        />
        {(data.hero.imageCaptionLeft || data.hero.imageCaptionRight) && (
          <div class="media-caption media-caption--split">
            <span>{data.hero.imageCaptionLeft}</span>
            <span>{data.hero.imageCaptionRight}</span>
          </div>
        )}
      </div>
    </ProjectHero>

    <ProjectProof
      statement={data.proof.statement}
      detail={data.proof.detail}
    />

    <ProjectSection
      id="why"
      eyebrow={data.why.eyebrow}
      title={data.why.title}
      description={data.why.description}
      tone="canvas"
    >
      <div class="principle-strip" aria-label="What makes Harnex different">
        {data.why.principles.map((principle) => (
          <article class={`signal-card signal-card--${principle.color || 'blue'}`}>
            <strong>{principle.title}</strong>
            <p set:html={formatHighlight(principle.subtitle)} />
          </article>
        ))}
      </div>
    </ProjectSection>

    <ProjectSection
      id="today"
      eyebrow="WHAT WORKS TODAY"
      title="A real Android host, not just an architecture diagram."
      description="The shared runtime, cross-app boundary and engineering control plane are already integrated on the current development line."
      tone="subtle"
      width="wide"
    >
      <div class="capability-grid" aria-label="Current Harnex capabilities">
        {harnexRuntimeCapabilities.map((capability) => (
          <article class="capability-card">
            <strong>{capability.title}</strong>
            <p set:html={formatHighlight(capability.description)} />
          </article>
        ))}
      </div>

      {data.runtime.surfacesImage && (
        <div class="media-frame product-visual">
          <img
            data-zoomable
            src={`${baseUrl}/${data.runtime.surfacesImage.replace(/^\//, '')}`}
            alt={data.runtime.surfacesAlt || 'Harnex control plane surfaces'}
            width="1672"
            height="941"
            loading="lazy"
          />
          {data.runtime.surfacesCaption && (
            <div class="media-caption">
              <span>{data.runtime.surfacesCaption}</span>
            </div>
          )}
        </div>
      )}

      <div class="surface-band" aria-label="Current Harnex product surfaces">
        <div class="surface-copy">
          <span class="surface-label">CURRENT SURFACES</span>
          <p>One console to operate and inspect the shared runtime.</p>
        </div>
        <ul>
          {harnexProductSurfaces.map((surface) => <li>{surface}</li>)}
        </ul>
      </div>
    </ProjectSection>

    <div id="architecture" class="project-anchor">
      <ProjectSection
        id="architecture-inner"
        eyebrow={data.architecture.eyebrow}
        title={data.architecture.title}
        description={data.architecture.description}
        tone="canvas"
        width="wide"
      >
        {data.architecture.diagramImage && (
          <div class="media-frame architecture-diagram">
            <img
              data-zoomable
              src={`${baseUrl}/${data.architecture.diagramImage.replace(/^\//, '')}`}
              alt={data.architecture.diagramAlt || 'Harnex architecture diagram'}
              width="1774"
              height="887"
              loading="lazy"
            />
          </div>
        )}

        <div class="ownership-heading">
          <span>WHO OWNS WHAT</span>
          <p>Four boundaries are enough to understand the system.</p>
        </div>
        <div class="ownership-flow" aria-label="Harnex architecture ownership boundaries">
          {harnexArchitectureLayers.map((layer, index) => (
            <article class="ownership-card">
              <div class="ownership-head">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <small>{layer.label}</small>
              </div>
              <strong>{layer.title}</strong>
              <p set:html={formatHighlight(layer.description)} />
            </article>
          ))}
        </div>

        <div class="architecture-callout">
          <strong>llama.cpp is the current backend, not the architecture.</strong>
          <p>The runtime core keeps <strong>policy and lifecycle separate from the execution engine</strong> through a backend-neutral boundary.</p>
        </div>
      </ProjectSection>
    </div>

    <div id="runtime" class="project-anchor">
      <ProjectSection
        id="runtime-inner"
        eyebrow={data.runtime.eyebrow}
        title={data.runtime.title}
        description={data.runtime.description}
        tone="subtle"
        width="wide"
      >
        <div class="integration-layout">
          <div class="integration-flow" aria-label="Consumer integration flow">
            <div class="integration-step">
              <span>01</span>
              <div>
                <strong>Keep the product workflow in your app</strong>
                <p>The consumer owns <strong>UI, product state and application data</strong>.</p>
              </div>
            </div>
            <div class="integration-step">
              <span>02</span>
              <div>
                <strong>Call the Consumer SDK</strong>
                <p><strong>Typed contracts</strong> cross the Binder boundary without exposing Harnex internals.</p>
              </div>
            </div>
            <div class="integration-step">
              <span>03</span>
              <div>
                <strong>Let Harnex operate the runtime</strong>
                <p><strong>Authorization, model policy, residency, lifecycle and audit</strong> stay host-owned.</p>
              </div>
            </div>
          </div>

          {data.runtime.codePreview && (
            <div class="code-preview">
              <div class="code-preview-header">
                <span class="code-preview-lang">{data.runtime.codePreview.language}</span>
                <span class="code-preview-title">{data.runtime.codePreview.title}</span>
              </div>
              <pre tabindex="0" aria-label="Consumer Android SDK example; scroll horizontally to inspect code"><code set:text={data.runtime.codePreview.code} /></pre>
              <p class="code-scroll-hint">Scroll to inspect code</p>
            </div>
          )}
        </div>
      </ProjectSection>
    </div>

    <ProjectSection
      id="evidence"
      eyebrow={data.evidence.eyebrow}
      title={data.evidence.title}
      description={data.evidence.description}
      tone="canvas"
      width="wide"
    >
      <ProjectEvidenceNote
        title={data.evidence.note.title}
        body={data.evidence.note.body}
        evidenced={data.evidence.note.evidenced}
        missing={data.evidence.note.missing}
      />
    </ProjectSection>

    <ProjectSection
      id="status"
      eyebrow={data.status.eyebrow}
      title={data.status.title}
      description={data.status.description}
      tone="subtle"
      width="wide"
    >
      {data.status.decision && (
        <ProjectDecisionBand
          title={data.status.decision.title}
          body={data.status.decision.body}
          signals={data.status.decision.signals}
        />
      )}
    </ProjectSection>

    <ProjectRelations items={data.relations} />

    <ProjectCta
      badge={data.cta.badge}
      title={data.cta.title}
      description={data.cta.description}
      primaryLabel={data.cta.primaryAction.label}
      primaryHref={data.cta.primaryAction.href}
      secondaryLabel={data.cta.secondaryAction?.label}
      secondaryHref={data.cta.secondaryAction?.href}
      variant="dark"
    />
  </div>
</BaseLayout>

<style>
  .project-anchor {
    scroll-margin-top: 118px;
  }

  .media-frame {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: clamp(16px, 2.2vw, 24px);
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
  }

  .media-frame img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--duration-normal) ease;
  }

  .media-frame:hover img {
    transform: scale(1.004);
  }

  .media-frame--hero img,
  .product-visual img {
    max-height: 720px;
  }

  .architecture-diagram img {
    max-height: 700px;
  }

  .media-caption {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1px solid var(--border-subtle);
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .media-caption--split {
    justify-content: space-between;
  }

  .principle-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .signal-card {
    min-height: 180px;
    padding: clamp(20px, 2.5vw, 28px);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-blue);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .signal-card--teal {
    border-top-color: var(--accent-teal, #14b8a6);
  }

  .signal-card--violet {
    border-top-color: var(--accent-violet, #8b5cf6);
  }

  .signal-card > strong,
  .capability-card > strong,
  .ownership-card > strong,
  .integration-step > div > strong,
  .architecture-callout > strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-weight: 750;
  }

  .signal-card > strong,
  .capability-card > strong,
  .ownership-card > strong {
    font-size: clamp(1.03rem, 1.5vw, 1.22rem);
  }

  .signal-card p,
  .capability-card p,
  .ownership-card p,
  .integration-step p,
  .architecture-callout p {
    margin: 8px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }

  .signal-card p strong,
  .capability-card p strong,
  .ownership-card p strong,
  .integration-step p strong,
  .architecture-callout p strong {
    color: var(--ink);
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .capability-card {
    padding: clamp(18px, 2vw, 24px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .product-visual {
    margin-top: var(--space-3);
  }

  .surface-band {
    display: grid;
    grid-template-columns: minmax(240px, 0.65fr) minmax(0, 1.35fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: clamp(18px, 2.4vw, 26px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .surface-label,
  .ownership-heading span {
    color: var(--accent-blue-dark);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .surface-copy p,
  .ownership-heading p {
    margin: 7px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }

  .surface-band ul {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .surface-band li {
    padding: 7px 11px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  .ownership-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-5) 0 var(--space-3);
  }

  .ownership-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .ownership-card {
    min-width: 0;
    padding: clamp(18px, 2vw, 24px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .ownership-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    color: var(--ink-subtle);
    font-family: var(--font-mono);
  }

  .ownership-head span {
    color: var(--accent-blue);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .ownership-head small {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .architecture-callout {
    display: grid;
    grid-template-columns: minmax(250px, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: clamp(18px, 2.5vw, 26px);
    border-left: 3px solid var(--accent-teal, #14b8a6);
    background: var(--surface-subtle);
  }

  .architecture-callout > strong {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  }

  .architecture-callout p {
    margin: 0;
  }

  .integration-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: stretch;
  }

  .integration-flow {
    display: grid;
    align-content: start;
    gap: 0;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    overflow: hidden;
  }

  .integration-step {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 14px;
    padding: clamp(18px, 2.4vw, 24px);
  }

  .integration-step + .integration-step {
    border-top: 1px solid var(--border-subtle);
  }

  .integration-step > span {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .integration-step > div > strong {
    font-size: 1rem;
  }

  .code-preview {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: #0f172a;
    box-shadow: var(--shadow-md);
  }

  .code-preview-header {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.09);
  }

  .code-preview-lang {
    color: #5eead4;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .code-preview-title {
    color: #94a3b8;
    font-size: var(--text-caption);
  }

  .code-preview pre {
    max-width: 100%;
    min-height: 280px;
    margin: 0;
    padding: clamp(18px, 2.5vw, 26px);
    overflow: auto;
    color: #e2e8f0;
    font-family: var(--font-mono);
    font-size: clamp(0.76rem, 1.1vw, 0.9rem);
    line-height: 1.65;
    tab-size: 2;
  }

  .code-preview pre:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: -4px;
  }

  .code-scroll-hint {
    display: none;
    margin: 0;
    padding: 8px 16px;
    border-top: 1px solid rgb(255 255 255 / 0.09);
    color: #94a3b8;
    font-size: 0.7rem;
  }

  @media (max-width: 1050px) {
    .capability-grid,
    .ownership-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .integration-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .principle-strip,
    .capability-grid,
    .ownership-flow,
    .surface-band,
    .architecture-callout {
      grid-template-columns: 1fr;
    }

    .signal-card {
      min-height: 0;
    }

    .surface-band ul {
      justify-content: flex-start;
    }

    .ownership-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .media-caption--split {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .code-scroll-hint {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-frame img {
      transition: none;
    }
  }
</style>
