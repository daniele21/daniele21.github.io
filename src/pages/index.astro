---
/**
 * Main Index Page - Landing Page for Daniele Moltisanti.
 * Assembles all 10 strategic sections into a single-page narrative layout.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import VisionMissionSection from '../components/sections/VisionMissionSection.astro';
import ChallengesSection from '../components/sections/ChallengesSection.astro';
import InfrastructureSection from '../components/infrastructure/InfrastructureSection.astro';
import ApplicationsSection from '../components/applications/ApplicationsSection.astro';
import PossibilitiesSection from '../components/sections/PossibilitiesSection.astro';
import PrinciplesSection from '../components/sections/PrinciplesSection.astro';
import CredibilitySection from '../components/sections/CredibilitySection.astro';
import JourneySection from '../components/sections/JourneySection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import CollaborationSection from '../components/sections/CollaborationSection.astro';
---

<BaseLayout>
  <HeroSection />
  <VisionMissionSection />
  <ChallengesSection />
  <InfrastructureSection />
  <ApplicationsSection />
  <PossibilitiesSection />
  <PrinciplesSection />
  <CredibilitySection />
  <JourneySection />
  <AboutSection />
  <CollaborationSection />
</BaseLayout>

