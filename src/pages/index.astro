---
/**
 * index.astro
 * Production homepage — Evidence-led Applied AI research landing page.
 * Narrative progression: Decide -> Build -> Test -> Measure -> Decide Again.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import ContinuousJourneyPath from '../components/landing/ContinuousJourneyPath.astro';
import DecisionStage from '../components/landing/DecisionStage.astro';
import MethodThread from '../components/landing/MethodThread.astro';
import BuildStage from '../components/landing/BuildStage.astro';
import TestStage from '../components/landing/TestStage.astro';
import EvidenceStage from '../components/landing/EvidenceStage.astro';
import FieldNotes from '../components/landing/FieldNotes.astro';
import AboutSignal from '../components/landing/AboutSignal.astro';
import FinalCta from '../components/landing/FinalCta.astro';
---

<BaseLayout
  title="Daniele Moltisanti"
  description="Explore how far AI can move from the cloud to systems we control. Decide where AI should run, build reusable inference infrastructure, test inside real products, and measure what actually works."
>
  <script is:inline>
    document.documentElement.dataset.methodPathReady = 'pending';
  </script>

  <LandingHeader slot="header" />

  <LandingHero />

  <div class="method-journey" data-method-journey>
    <ContinuousJourneyPath />

    <div class="journey-intro" aria-label="Method introduction">
      <div class="shell journey-intro-shell">
        <p>HOW I'M TESTING THAT IDEA <span aria-hidden="true">↓</span></p>
      </div>
    </div>

    <DecisionStage />

    <MethodThread
      fromStep="01 DECIDE"
      toStep="02 BUILD"
      sublabel="A justified Local or Hybrid boundary becomes an engineering brief."
      direction="ltr"
    />

    <BuildStage />

    <MethodThread
      fromStep="02 BUILD"
      toStep="03 TEST"
      sublabel="Reusable infrastructure must survive a real product workflow."
      direction="rtl"
    />

    <TestStage />

    <MethodThread
      fromStep="03 TEST"
      toStep="04 MEASURE"
      sublabel="A useful workflow must still meet real performance constraints."
      direction="ltr"
    />

    <EvidenceStage />
  </div>

  <FieldNotes />

  <AboutSignal />

  <FinalCta />

  <Fragment slot="footer"></Fragment>
</BaseLayout>

<style>
  .journey-intro {
    position: relative;
    z-index: 5;
    padding: clamp(34px, 5vw, 58px) 0 clamp(14px, 2.4vw, 28px);
    background: var(--surface-canvas);
  }

  .journey-intro-shell {
    display: flex;
    justify-content: center;
  }

  .journey-intro p {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent-blue);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journey-intro span {
    display: inline-block;
    font-size: 1.05em;
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    .journey-intro {
      padding: 28px 0 12px;
    }

    .journey-intro-shell {
      justify-content: flex-start;
      padding-left: 52px;
    }
  }
</style>

<script>
  import { initMethodPath } from '../scripts/methodJourney';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMethodPath, { once: true });
  } else {
    initMethodPath();
  }
</script>
