---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectPhase from '../components/project/ProjectPhase.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectDecisionBand from '../components/project/ProjectDecisionBand.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Decide', href: '#decide' },
  { label: 'Build', href: '#build' },
  { label: 'Test', href: '#test' },
  { label: 'Measure', href: '#measure' },
  { label: 'Decide again', href: '#decide-again' },
];
---

<BaseLayout
  title="Performance Lab -Daniele Moltisanti"
  description="A measurement layer for understanding whether Local AI systems can run well on real hardware across latency, throughput and resource constraints."
>
  <ProductSubHeader
    title="Performance Lab"
    badge="Measurement layer"
    links={subheaderLinks}
  />

  <div id="top" data-project-page data-project-archetype="experiment">
    <section class="project-hero">
      <div class="shell project-shell">
        <a class="back" href={`${baseUrl}/#evidence`}>← Observability & Measurement</a>
        <p class="eyebrow">LOCAL AI OBSERVABILITY · PERFORMANCE</p>
        <h1>Performance Lab</h1>
        <p class="lede">
          A measurement layer for moving beyond “it runs”. Performance Lab is where Local AI systems are evaluated against the constraints that matter on real hardware.
        </p>

        <div class="metric-hero" aria-label="Measurement dimensions">
          <div><strong>Latency</strong><span>End-to-end response time</span></div>
          <div><strong>Throughput</strong><span>Tokens and requests over time</span></div>
          <div><strong>Memory</strong><span>Runtime footprint and pressure</span></div>
          <div><strong>Thermal / Battery</strong><span>Device sustainability under load</span></div>
        </div>
      </div>
    </section>

    <ProjectPhase
      id="decide"
      step="01"
      label="DECIDE"
      title="A local model is only useful if the target workload survives the target hardware."
      description="Performance Lab exists to turn 'can this run locally?' into a decision question rather than a demo milestone."
    >
      <div class="shell question-grid">
        <article><span>01</span><h2>Can it run?</h2><p>Establish whether a model and runtime fit the target device or local infrastructure at all.</p></article>
        <article><span>02</span><h2>Can it run well?</h2><p>Measure the latency, throughput and resource trade-offs that determine whether the experience is practical.</p></article>
        <article><span>03</span><h2>Should it run locally?</h2><p>Feed measured evidence back into the Local vs Hybrid vs Cloud decision.</p></article>
      </div>
    </ProjectPhase>

    <ProjectPhase
      id="build"
      step="02"
      label="BUILD"
      title="Define the measurement surface before collecting numbers."
      description="The core dimensions stay explicit so a benchmark can answer a product question instead of producing isolated scores with no architectural consequence."
      tone="subtle"
    >
      <div class="shell measurement-grid">
        <article><strong>Latency</strong><p>How long until a useful response arrives?</p></article>
        <article><strong>Throughput</strong><p>How much work can the runtime sustain over time?</p></article>
        <article><strong>Memory</strong><p>What footprint and pressure does the workload create?</p></article>
        <article><strong>Thermal / Battery</strong><p>Does performance remain sustainable on the target device?</p></article>
      </div>
    </ProjectPhase>

    <ProjectPhase
      id="test"
      step="03"
      label="TEST"
      title="Run the workload on representative hardware, not just a convenient machine."
      description="The experiment should preserve the actual model, runtime, configuration and device context needed to understand why a result is useful or misleading."
    >
      <div class="shell sequence-card">
        <div><span>01</span><strong>Workload</strong><p>Choose the real use case and task shape.</p></div>
        <div><span>02</span><strong>Configuration</strong><p>Record model, quantization, context and runtime choices.</p></div>
        <div><span>03</span><strong>Device</strong><p>Measure on the hardware the decision actually concerns.</p></div>
        <div><span>04</span><strong>Run</strong><p>Collect the same dimensions consistently across candidates.</p></div>
      </div>
    </ProjectPhase>

    <ProjectPhase
      id="measure"
      step="04"
      label="MEASURE"
      title="Publish measured evidence only when the run context is explicit."
      description="This page currently defines the measurement layer and decision model. It does not publish a numeric benchmark dataset yet, so the previous decorative bar chart has been removed rather than implying results that are not present."
      tone="subtle"
    >
      <ProjectEvidenceNote
        title="The measurement framework is defined; representative benchmark results still need to be attached."
        body="Performance Lab is intended to compare Local AI systems across latency, throughput, memory and device sustainability. Until real runs are published with model, runtime, configuration and hardware context, this page deliberately avoids numeric or chart-based performance claims."
        evidenced={[
          'Decision questions are explicit: fit, practicality and deployment boundary',
          'Latency, throughput, memory and thermal/battery are defined as core dimensions',
          'Results are meant to feed back into Local vs Hybrid vs Cloud decisions',
        ]}
        missing={[
          'Published representative benchmark runs',
          'Model/runtime/device comparison table with reproducible configuration',
        ]}
      />
    </ProjectPhase>

    <ProjectPhase
      id="decide-again"
      step="05"
      label="DECIDE AGAIN"
      title="Use performance evidence to change the architecture when necessary."
      description="The final output of the lab is not a leaderboard. It is a deployment decision that can confirm Local, move a workload to Hybrid, or keep it in Cloud when the measured constraints demand it."
    >
      <ProjectDecisionBand
        title="Measurement is useful only when it can change the boundary."
        body="Performance Lab exists to prevent 'local-first' from becoming ideology. A workload should stay local only when representative measurements show that quality, responsiveness and resource use remain acceptable for the actual product context."
        signals={[
          'Keep Local when the workload fits the target hardware',
          'Use Hybrid when only part of the workflow is practical locally',
          'Keep Cloud when measured constraints make local execution the wrong trade-off',
        ]}
      />
    </ProjectPhase>
  </div>
</BaseLayout>

<style>
  .project-hero { min-height: 72vh; padding: clamp(5rem, 10vh, 8rem) 0; }
  .project-shell { max-width: 1000px; }
  .back { color: var(--ink-subtle); text-decoration: none; font-size: var(--text-caption); font-weight: 700; }
  .eyebrow { margin: 4rem 0 0; color: var(--accent-blue); font-size: var(--text-caption); font-weight: 850; letter-spacing: .12em; }
  h1 { margin: .8rem 0 0; font-family: var(--font-display); font-size: clamp(3.2rem, 7vw, 6.5rem); line-height: .98; letter-spacing: -.055em; }
  .lede { max-width: 760px; margin: 1.3rem 0 0; color: var(--ink-muted); font-size: var(--text-lead); line-height: 1.7; }

  .metric-hero,
  .measurement-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); margin-top: 3rem; }
  .metric-hero div,
  .measurement-grid article,
  .question-grid article,
  .sequence-card > div { padding: var(--space-4); border: 1px solid var(--border-medium); border-radius: var(--radius-lg); background: var(--surface-card); }
  .metric-hero strong,
  .measurement-grid strong,
  .sequence-card strong { display: block; color: var(--ink-display); font-family: var(--font-display); }
  .metric-hero span { display: block; margin-top: 6px; color: var(--ink-subtle); font-size: var(--text-caption); line-height: 1.45; }

  .question-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); padding-bottom: clamp(48px, 7vw, 80px); }
  .question-grid span,
  .sequence-card span { color: var(--accent-blue); font-family: var(--font-mono); font-size: var(--text-caption); font-weight: 800; }
  .question-grid h2 { margin: 8px 0 0; font-family: var(--font-display); font-size: var(--text-h3); }
  .question-grid p,
  .measurement-grid p,
  .sequence-card p { margin: 8px 0 0; color: var(--ink-muted); font-size: var(--text-body-sm); line-height: 1.55; }

  .measurement-grid { margin-top: 0; padding-bottom: clamp(48px, 7vw, 80px); }
  .sequence-card { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); padding-bottom: clamp(48px, 7vw, 80px); }

  @media (max-width: 900px) {
    .metric-hero,
    .measurement-grid,
    .sequence-card { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .question-grid,
    .metric-hero,
    .measurement-grid,
    .sequence-card { grid-template-columns: 1fr; }
  }
</style>
