---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const experimentsHref = `${baseUrl}/experiments`;
---

<BaseLayout
  title="Performance Lab has moved into Experiments"
  description="Performance Lab has been consolidated into Experiments, the evidence hub for capability, system and end-to-end AI evaluation."
  canonical="https://daniele21.github.io/experiments"
>
  <section class="legacy-page">
    <div class="shell legacy-shell">
      <p class="eyebrow">PERFORMANCE LAB → EXPERIMENTS</p>
      <h1>Performance measurement is now part of the broader Experiments system.</h1>
      <p class="lede">
        Runtime performance was only one part of the question. The current evaluation work now combines
        <strong>model capability, reliability, latency, failure analysis and end-to-end system effectiveness</strong>
        inside one reproducible Experiments hub.
      </p>

      <div class="migration-map">
        <div>
          <span>BEFORE</span>
          <strong>Performance Lab</strong>
          <p>Hardware/runtime viability as a separate destination.</p>
        </div>
        <b aria-hidden="true">→</b>
        <div>
          <span>NOW</span>
          <strong>Experiments</strong>
          <p>Capability + runtime + product-level evidence in one decision loop.</p>
        </div>
      </div>

      <a class="primary-button" href={experimentsHref}>Open Experiments <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .legacy-page {
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    padding: clamp(70px, 10vw, 120px) 0;
    background:
      radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--accent-blue) 10%, transparent), transparent 42%),
      var(--surface-canvas);
  }

  .legacy-shell { max-width: 980px; }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 850;
    letter-spacing: .09em;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 6vw, 5.5rem);
    line-height: 1;
    letter-spacing: -.058em;
  }

  .lede {
    max-width: 790px;
    margin: 22px 0 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .lede strong { color: var(--ink-display); }

  .migration-map {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 18px;
    align-items: center;
    margin: 34px 0;
  }

  .migration-map > div {
    padding: 20px;
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    background: var(--surface-card);
  }

  .migration-map span {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .08em;
  }

  .migration-map strong {
    display: block;
    margin-top: 7px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .migration-map p {
    margin: 6px 0 0;
    color: var(--ink-muted);
    font-size: .82rem;
    line-height: 1.5;
  }

  .migration-map > b { color: var(--accent-blue); }

  @media (max-width: 700px) {
    .migration-map { grid-template-columns: 1fr; }
    .migration-map > b { transform: rotate(90deg); justify-self: center; }
  }
</style>
