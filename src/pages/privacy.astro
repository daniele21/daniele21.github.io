---
/**
 * privacy.astro
 * Privacy Policy & Data Handling Terms.
 * Fully transparent, GDPR-compliant disclosure.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastUpdated = 'September 1, 2026';
---

<BaseLayout
  title="Privacy Policy & Terms · Daniele Moltisanti"
  description="Privacy policy and data processing transparency for Daniele Moltisanti's website and technical advisory inquiries."
>
  <section class="privacy-section">
    <div class="shell privacy-shell">
      <header class="privacy-header">
        <div class="privacy-badge">
          <span>GDPR COMPLIANCE & TRANSPARENCY</span>
        </div>
        <h1 class="privacy-title">Privacy Policy & Terms</h1>
        <p class="privacy-meta">Last updated: {lastUpdated}</p>
      </header>

      <div class="privacy-content">
        <article class="privacy-card">
          <h2>1. Data Controller</h2>
          <p>
            The Data Controller responsible for the processing of personal data on this website (in accordance with Regulation EU 2016/679 - GDPR) is:
          </p>
          <div class="contact-box">
            <strong>Daniele Moltisanti</strong><br />
            Principal AI Engineer & AI Strategy Lead<br />
            Milan, Italy<br />
            Email: <a href="mailto:danielemoltisanti@gmail.com">danielemoltisanti@gmail.com</a>
          </div>
        </article>

        <article class="privacy-card">
          <h2>2. Personal Data Collected & Purpose</h2>
          <p>
            When you voluntarily submit a message through the <strong>"Get in touch"</strong> contact form, the following data is collected:
          </p>
          <ul>
            <li><strong>Full Name:</strong> to address you personally in our correspondence.</li>
            <li><strong>Work Email:</strong> to reply directly to your technical inquiry.</li>
            <li><strong>Workload / Project Description:</strong> to understand your technical requirements and provide informed architectural guidance.</li>
          </ul>
          <p>
            <strong>Purpose & Legal Basis:</strong> Data is collected solely to evaluate your request and respond to your consultation inquiry (Art. 6(1)(b) GDPR – execution of pre-contractual measures upon request of the interested party).
          </p>
        </article>

        <article class="privacy-card">
          <h2>3. No Marketing Spam & No Data Sharing</h2>
          <p>
            Your information is treated with strict confidentiality:
          </p>
          <ul>
            <li><strong>No automated marketing lists:</strong> You will never be enrolled in promotional newsletters or automated sales sequences.</li>
            <li><strong>No third-party data selling:</strong> Your details will never be sold, rented, or shared with third-party advertisers or data brokers.</li>
          </ul>
        </article>

        <article class="privacy-card">
          <h2>4. Web Analytics & Cookie Policy</h2>
          <p>
            This website prioritizes privacy by design:
          </p>
          <ul>
            <li><strong>Zero invasive tracking:</strong> No Google Analytics, Meta Pixel, or third-party behavioral trackers are installed on this website.</li>
            <li><strong>Essential local storage only:</strong> The site only uses standard local storage strictly to remember your preferred visual theme (Light/Dark mode). No personal identifiers are stored.</li>
          </ul>
        </article>

        <article class="privacy-card">
          <h2>5. Data Retention & Your GDPR Rights</h2>
          <p>
            Your details are retained only for as long as needed to maintain our technical conversation, after which they are archived or deleted.
          </p>
          <p>Under the GDPR (Articles 15–22), you have the right to:</p>
          <ul>
            <li>Request access to the personal data held about you.</li>
            <li>Request correction or deletion of your data (Right to be forgotten).</li>
            <li>Withdraw your consent at any time.</li>
          </ul>
          <p>
            To exercise any of these rights, simply email <a href="mailto:danielemoltisanti@gmail.com">danielemoltisanti@gmail.com</a>.
          </p>
        </article>
      </div>

      <div class="privacy-footer-action">
        <a class="primary-button" href={`${baseUrl}/`}>
          <span>Return to homepage</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-section {
    padding: clamp(48px, 8vw, 84px) 0 clamp(64px, 10vw, 100px);
    background:
      radial-gradient(ellipse 70% 40% at 50% 0%, color-mix(in srgb, var(--accent-blue) 7%, transparent), transparent 75%),
      linear-gradient(160deg, var(--surface-subtle) 0%, var(--surface-canvas) 85%);
  }

  .privacy-shell {
    max-width: 820px;
    margin: 0 auto;
  }

  .privacy-header {
    margin-bottom: clamp(32px, 5vw, 48px);
    text-align: center;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    background: var(--surface-blue-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
    margin-bottom: 12px;
  }

  .privacy-title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.12;
    font-weight: 850;
    letter-spacing: -0.04em;
    color: var(--ink-display);
  }

  .privacy-meta {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  .privacy-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .privacy-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    padding: clamp(22px, 3.5vw, 32px);
    box-shadow: 0 4px 18px rgba(8, 19, 51, 0.03);
  }

  .privacy-card h2 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink-display);
  }

  .privacy-card p {
    margin: 0 0 12px;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .privacy-card p:last-child {
    margin-bottom: 0;
  }

  .privacy-card ul {
    margin: 0 0 14px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .privacy-card li {
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .privacy-card strong {
    color: var(--ink-display);
  }

  .privacy-card a {
    color: var(--accent-blue-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .privacy-card a:hover {
    color: var(--accent-blue);
  }

  .contact-box {
    padding: 14px 18px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink);
    margin-top: 10px;
  }

  .privacy-footer-action {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
</style>
