---
/**
 * about.astro
 * Positioning-first profile page: Local AI thesis, concrete proof, then track record.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutData } from '../content/locales/en/about';

const {
  profile,
  now,
  story,
  manifesto,
  experience,
  divulgation,
  recognition,
} = aboutData;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
const pageHref = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;

const selectedPrincipleTitles = [
  'Local AI First ≠ Local AI Only',
  'Architectural Data Boundaries',
  'Empirical Verification Over Leaderboards',
];
const selectedPrinciples = manifesto.principles.filter((principle) =>
  selectedPrincipleTitles.includes(principle.title)
);
const selectedRoles = experience.roles.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  worksFor: {
    '@type': 'Organization',
    name: profile.affiliation,
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Politecnico di Milano',
  },
  url: 'https://daniele21.github.io/about',
  sameAs: [
    profile.socialLinks.linkedin,
    profile.socialLinks.github,
    profile.socialLinks.staituned,
  ],
  knowsAbout: [
    'Local AI',
    'On-device inference',
    'Enterprise AI Architecture',
    'Generative AI Systems',
    'AI Strategy & Governance',
  ],
};
---

<BaseLayout
  title="About Daniele Moltisanti - Local AI Systems & Architecture"
  description="I build and benchmark Local AI systems to determine when AI should run locally, hybrid, or in the cloud."
  jsonLd={jsonLd}
>
  <div class="about-page">
    <div class="about-shell">
      <section class="about-hero" aria-labelledby="about-title">
        <div class="hero-copy">
          <p class="section-kicker">ABOUT · LOCAL AI</p>
          <p class="hero-name">{profile.name}</p>
          <h1 id="about-title">I build Local AI systems to prove when AI can leave the cloud.</h1>
          <p class="hero-lead">
            I design, build and benchmark AI running on devices and infrastructure we control — across desktop, mobile and speech.
          </p>
          <p class="hero-so-what">
            <strong>The goal:</strong> decide with evidence when Local, Hybrid or Cloud is the right architecture.
          </p>

          <div class="hero-actions">
            <a class="primary-button" href={pageHref('#infrastructure')}>Explore the work ↓</a>
            <a href={profile.socialLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          </div>

          <div class="hero-meta">
            <span>{profile.headline}</span>
            <span aria-hidden="true">·</span>
            <span>{profile.location}</span>
          </div>
        </div>

        <div class="hero-portrait-wrap">
          <img
            src={asset(profile.portraitPath)}
            alt={profile.portraitAlt}
            width="300"
            height="360"
            loading="eager"
            decoding="async"
          />
        </div>
      </section>

      <section class="proof-model" aria-label="How I prove Local AI viability">
        <article>
          <span>01 · BUILD</span>
          <h2>Reusable local infrastructure</h2>
          <p>Inference runtimes and system boundaries that applications can actually depend on.</p>
        </article>
        <article>
          <span>02 · TEST</span>
          <h2>Real applications</h2>
          <p>Privacy, mobile and meeting workflows that expose constraints demos can hide.</p>
        </article>
        <article>
          <span>03 · MEASURE</span>
          <h2>Performance & boundary evidence</h2>
          <p>Latency, memory, thermal and network signals that can change the architecture decision.</p>
        </article>
      </section>

      <section class="about-section now-section" id="now" aria-labelledby="now-title">
        <header class="section-heading-row">
          <div>
            <p class="section-kicker">NOW · {now.lastUpdated.toUpperCase()}</p>
            <h2 id="now-title">What I’m testing now</h2>
          </div>
          <p class="section-intro">Current work at the boundary between model capability and real execution constraints.</p>
        </header>

        <div class="now-list">
          {now.items.map((item) => (
            <article class="now-row">
              <div class="now-marker" aria-hidden="true"></div>
              <div class="now-copy">
                <span class="now-tag">{item.tag}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <span class="now-status">{item.status}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section principles-section" id="principles" aria-labelledby="principles-title">
        <header class="section-heading-row">
          <div>
            <p class="section-kicker">HOW I DECIDE</p>
            <h2 id="principles-title">No Local AI ideology. Just architectural evidence.</h2>
          </div>
          <p class="section-intro">The same principles guide what I build, benchmark and recommend.</p>
        </header>

        <div class="principles-grid">
          {selectedPrinciples.map((principle) => (
            <article class="principle">
              <span class="principle-number">{principle.number}</span>
              <span class="principle-kicker">{principle.kicker}</span>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section journey-section" id="journey" aria-labelledby="journey-title">
        <header class="section-heading-row">
          <div>
            <p class="section-kicker">WHY I WORK THIS WAY</p>
            <h2 id="journey-title">Research rigor, enterprise constraints, then back to the device.</h2>
          </div>
          <p class="section-intro">The track record matters because Local AI is a systems problem, not only a model problem.</p>
        </header>

        <div class="journey-list">
          {story.chapters.map((chapter) => (
            <article class="journey-row">
              <div class="journey-index">{chapter.number}</div>
              <div class="journey-period">{chapter.timeframe}</div>
              <div class="journey-copy">
                <span>{chapter.kicker}</span>
                <h3>{chapter.title}</h3>
                <p>{chapter.keyTakeaway || chapter.paragraphs[0]}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section proof-section" id="proof" aria-labelledby="proof-title">
        <header class="section-heading-row">
          <div>
            <p class="section-kicker">TRACK RECORD</p>
            <h2 id="proof-title">I also build AI under enterprise constraints.</h2>
          </div>
          <p class="section-intro">Local AI experimentation is grounded in experience with production systems, teams and operational trade-offs.</p>
        </header>

        <div class="proof-layout">
          <div class="experience-list">
            {selectedRoles.map((role) => (
              <article class="experience-row">
                <div class="experience-company">
                  <strong>{role.company}</strong>
                  <span>{role.period}</span>
                </div>
                <div class="experience-copy">
                  <h3>{role.role}</h3>
                  <p>{role.description}</p>
                </div>
              </article>
            ))}
          </div>

          <aside class="recognition-panel" aria-label="Recognition and education">
            <p class="mini-label">RECOGNITION</p>
            {recognition.awards.map((award) => (
              <div class="recognition-row">
                <span>{award.year}</span>
                <strong>{award.title}</strong>
                <small>{award.organization}</small>
              </div>
            ))}

            <div class="recognition-divider"></div>
            <p class="mini-label">EDUCATION</p>
            {recognition.education.map((item) => (
              <div class="recognition-row">
                <span>{item.period}</span>
                <strong>{item.degree}</strong>
                <small>{item.institution}</small>
              </div>
            ))}
          </aside>
        </div>
      </section>

      <section class="about-section writing-section" id="writing" aria-labelledby="writing-title">
        <div class="writing-intro">
          <p class="section-kicker">WRITING</p>
          <h2 id="writing-title">I build systems — and explain what survives contact with reality.</h2>
          <p>{divulgation.staiTunedSummary}</p>
          <a class="text-link" href={profile.socialLinks.staituned} target="_blank" rel="noopener noreferrer">
            Explore stAI tuned ↗
          </a>
        </div>

        <div class="article-list" aria-label="Featured writing topics">
          {divulgation.featuredArticles.map((article, index) => (
            <article class="article-row">
              <span class="article-index">0{index + 1}</span>
              <div>
                <span class="article-topic">{article.topic}</span>
                <h3>{article.title}</h3>
                <p>{article.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="advisory-bridge" aria-labelledby="about-advisory-title">
        <div>
          <p class="section-kicker">LOCAL AI ADVISORY</p>
          <h2 id="about-advisory-title">Working on the same question?</h2>
          <p>If you need to decide what should run Local, Hybrid or Cloud, I can apply the same workload-first approach to your architecture.</p>
        </div>
        <a class="primary-button" href={pageHref('#advisory')}>Evaluate your workload →</a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    background: var(--surface-canvas);
    padding: clamp(26px, 3vw, 44px) 0 clamp(64px, 8vw, 104px);
  }

  .about-shell {
    width: min(calc(100% - clamp(28px, 5vw, 64px)), 1120px);
    margin-inline: auto;
  }

  .section-kicker,
  .mini-label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.115em;
    text-transform: uppercase;
    color: var(--accent-blue-dark);
  }

  .about-hero {
    min-height: min(720px, calc(100svh - var(--header-height) - 36px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 300px);
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    padding: clamp(52px, 7vw, 92px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .hero-copy { max-width: 790px; }

  .hero-name {
    margin: 10px 0 18px;
    color: var(--ink-subtle);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  .hero-copy h1 {
    margin: 0;
    max-width: 820px;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6.5vw, 5.7rem);
    line-height: 0.98;
    letter-spacing: -0.062em;
    font-weight: 860;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 730px;
    margin: 26px 0 0;
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .hero-so-what {
    max-width: 730px;
    margin: 18px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--accent-blue);
    color: var(--ink);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 30px;
  }

  .hero-actions > a:not(.primary-button) {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 720;
    text-decoration: none;
  }

  .hero-actions > a:not(.primary-button):hover { color: var(--accent-blue); }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    color: var(--ink-subtle);
    font-size: var(--text-caption);
  }

  .hero-portrait-wrap {
    justify-self: end;
    width: min(100%, 300px);
    aspect-ratio: 5 / 6;
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: clamp(22px, 3vw, 34px);
    background: var(--surface-subtle);
    box-shadow: var(--shadow-md);
  }

  .hero-portrait-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .proof-model {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--border-medium);
  }

  .proof-model article {
    min-height: 190px;
    padding: 30px clamp(22px, 3vw, 38px);
    border-right: 1px solid var(--border-medium);
  }

  .proof-model article:first-child { padding-left: 0; }
  .proof-model article:last-child { border-right: 0; }

  .proof-model span,
  .now-tag,
  .principle-kicker,
  .article-topic,
  .journey-copy > span {
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 780;
  }

  .proof-model h2 {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.62rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--ink-display);
  }

  .proof-model p {
    margin: 12px 0 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .about-section {
    padding: clamp(72px, 9vw, 120px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .section-heading-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 390px);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(34px, 5vw, 56px);
  }

  .section-heading-row h2,
  .writing-intro h2,
  .advisory-bridge h2 {
    margin: 9px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 4.15rem);
    line-height: 1.02;
    letter-spacing: -0.052em;
    font-weight: 830;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .section-intro {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .now-list,
  .experience-list,
  .article-list { border-top: 1px solid var(--border-medium); }

  .now-row {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .now-marker {
    width: 7px;
    height: 7px;
    margin-top: 10px;
    border-radius: 50%;
    background: var(--accent-teal);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent-teal) 9%, transparent);
  }

  .now-copy h3,
  .journey-copy h3,
  .principle h3,
  .article-row h3,
  .experience-copy h3 {
    margin: 5px 0 6px;
    font-family: var(--font-display);
    color: var(--ink-display);
    font-weight: 790;
    letter-spacing: -0.025em;
  }

  .now-copy p,
  .journey-copy p,
  .principle p,
  .article-row p,
  .experience-copy p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .now-status {
    padding: 5px 10px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 680;
    white-space: nowrap;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border-medium);
  }

  .principle {
    padding: clamp(28px, 4vw, 42px);
    border-right: 1px solid var(--border-medium);
  }

  .principle:first-child { padding-left: 0; }
  .principle:last-child { border-right: 0; }
  .principle-number { display: block; margin-bottom: 28px; color: var(--ink-subtle); font-family: var(--font-display); font-weight: 800; }
  .principle h3 { font-size: clamp(1.25rem, 1.9vw, 1.62rem); line-height: 1.18; }
  .principle p { margin-top: 14px; }

  .journey-list { position: relative; }
  .journey-row {
    display: grid;
    grid-template-columns: 44px 190px minmax(0, 1fr);
    gap: clamp(18px, 3vw, 38px);
    padding: 26px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .journey-index {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 34%, var(--border-medium));
    border-radius: 50%;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
  }
  .journey-period { padding-top: 9px; color: var(--ink-subtle); font-size: var(--text-caption); line-height: 1.45; }
  .journey-copy { max-width: 700px; }
  .journey-copy h3 { font-size: clamp(1.25rem, 1.9vw, 1.62rem); }

  .proof-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(270px, 0.75fr);
    gap: clamp(44px, 7vw, 88px);
  }

  .experience-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 28px;
    padding: 26px 0;
    border-bottom: 1px solid var(--border-medium);
  }
  .experience-company { display: flex; flex-direction: column; gap: 4px; }
  .experience-company strong { color: var(--ink-display); font-family: var(--font-display); }
  .experience-company span { color: var(--ink-subtle); font-size: var(--text-caption); }
  .experience-copy h3 { margin-top: 0; font-size: 1.05rem; }

  .recognition-panel {
    padding: 28px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
  }
  .recognition-row { display: flex; flex-direction: column; gap: 3px; padding: 16px 0; border-bottom: 1px solid var(--border-medium); }
  .recognition-row:last-child { border-bottom: 0; }
  .recognition-row span,
  .recognition-row small { color: var(--ink-subtle); font-size: var(--text-caption); }
  .recognition-row strong { color: var(--ink-display); font-family: var(--font-display); font-size: 0.94rem; line-height: 1.35; }
  .recognition-divider { height: 1px; margin: 26px 0; background: var(--border-strong); }

  .writing-section {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(42px, 7vw, 88px);
    align-items: start;
  }
  .writing-intro { position: sticky; top: calc(var(--header-height) + 40px); }
  .writing-intro > p:not(.section-kicker) { margin: 20px 0 0; color: var(--ink-muted); line-height: 1.65; }
  .text-link { display: inline-flex; margin-top: 22px; color: var(--accent-blue-dark); font-family: var(--font-display); font-weight: 740; text-decoration: none; }
  .article-row { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 18px; padding: 26px 0; border-bottom: 1px solid var(--border-medium); }
  .article-index { padding-top: 4px; color: var(--ink-subtle); font-family: var(--font-display); font-size: var(--text-caption); font-weight: 760; }
  .article-row h3 { font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.25; }

  .advisory-bridge {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 42px;
    align-items: end;
    margin-top: clamp(72px, 9vw, 120px);
    padding: clamp(38px, 5vw, 58px) 0;
    border-block: 1px solid var(--border-medium);
  }
  .advisory-bridge h2 { max-width: 760px; }
  .advisory-bridge p:not(.section-kicker) { max-width: 690px; margin: 16px 0 0; color: var(--ink-muted); line-height: 1.6; }

  @media (max-width: 920px) {
    .about-hero { min-height: auto; grid-template-columns: 1fr 220px; gap: 36px; }
    .proof-model { grid-template-columns: 1fr; }
    .proof-model article,
    .proof-model article:first-child { min-height: 0; padding: 26px 0; border-right: 0; border-bottom: 1px solid var(--border-medium); }
    .section-heading-row,
    .writing-section,
    .proof-layout,
    .advisory-bridge { grid-template-columns: 1fr; }
    .principles-grid { grid-template-columns: 1fr; }
    .principle,
    .principle:first-child { padding: 28px 0; border-right: 0; border-bottom: 1px solid var(--border-medium); }
    .writing-intro { position: static; }
  }

  @media (max-width: 680px) {
    .about-shell { width: min(calc(100% - 28px), 1120px); }
    .about-hero { display: flex; flex-direction: column-reverse; align-items: flex-start; gap: 30px; padding-top: 30px; }
    .hero-portrait-wrap { width: 132px; border-radius: 20px; }
    .hero-copy h1 { font-size: clamp(2.65rem, 13vw, 4rem); }
    .hero-meta span[aria-hidden='true'] { display: none; }
    .hero-meta { flex-direction: column; align-items: flex-start; }
    .about-section { padding: 68px 0; }
    .section-heading-row { gap: 18px; margin-bottom: 30px; }
    .section-heading-row h2,
    .writing-intro h2,
    .advisory-bridge h2 { font-size: clamp(2rem, 10vw, 3.2rem); }
    .now-row { grid-template-columns: 12px minmax(0, 1fr); }
    .now-status { grid-column: 2; justify-self: start; margin-top: 6px; }
    .journey-row { grid-template-columns: 44px minmax(0, 1fr); gap: 16px; }
    .journey-period,
    .journey-copy { grid-column: 2; }
    .journey-period { padding-top: 0; }
    .experience-row { grid-template-columns: 1fr; gap: 10px; }
    .advisory-bridge .primary-button { width: 100%; justify-content: center; }
  }
</style>
