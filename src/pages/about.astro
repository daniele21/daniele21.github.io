---
/**
 * about.astro
 * Daniele Moltisanti - World-Class Editorial Profile, Personal Story, Systems Bench, & Track Record.
 * Reconciled against LinkedIn profile, enterprise AI leadership, stAI tuned, and open-weight Local AI research.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutNow from '../components/about/AboutNow.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutPhilosophy from '../components/about/AboutPhilosophy.astro';
import AboutToolkit from '../components/about/AboutToolkit.astro';
import AboutDivulgation from '../components/about/AboutDivulgation.astro';
import AboutExperience from '../components/about/AboutExperience.astro';
import AboutRecognition from '../components/about/AboutRecognition.astro';
import AboutCta from '../components/about/AboutCta.astro';
import { aboutData } from '../content/locales/en/about';

const {
  metaTitle,
  metaDescription,
  profile,
  now,
  story,
  manifesto,
  toolkit,
  experience,
  divulgation,
  recognition,
  cta,
} = aboutData;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  worksFor: {
    '@type': 'Organization',
    name: profile.affiliation,
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Politecnico di Milano',
  },
  url: 'https://daniele21.github.io/about',
  sameAs: [
    profile.socialLinks.linkedin,
    profile.socialLinks.github,
    profile.socialLinks.staituned,
  ],
  knowsAbout: [
    'Local AI',
    'Enterprise AI Architecture',
    'On-Device Inference',
    'Model Context Protocol',
    'Apple Silicon MLX',
    'Quantization',
    'Generative AI Systems',
    'AI Strategy & Governance',
  ],
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  jsonLd={jsonLd}
>
  <LandingHeader slot="header" />

  <div class="about-page">
    <div class="about-shell">
      <!-- 1. Magazine-Grade Editorial Hero -->
      <AboutHero profile={profile} />

      <!-- 2. Real-Time "Now" Focus -->
      <AboutNow
        kicker={now.kicker}
        title={now.title}
        subtitle={now.subtitle}
        lastUpdated={now.lastUpdated}
        items={now.items}
      />

      <!-- 3. Narrative Story Chapters -->
      <AboutStory
        kicker={story.kicker}
        title={story.title}
        subtitle={story.subtitle}
        chapters={story.chapters}
      />

      <!-- 4. Architectural Manifesto & Operating Principles -->
      <AboutPhilosophy
        kicker={manifesto.kicker}
        title={manifesto.title}
        subtitle={manifesto.subtitle}
        principles={manifesto.principles}
      />

      <!-- 5. Systems & Hardware Bench Toolkit -->
      <AboutToolkit
        kicker={toolkit.kicker}
        title={toolkit.title}
        subtitle={toolkit.subtitle}
        categories={toolkit.categories}
      />

      <!-- 6. Knowledge Sharing, stAI tuned & Mentorship -->
      <AboutDivulgation
        kicker={divulgation.kicker}
        title={divulgation.title}
        subtitle={divulgation.subtitle}
        staiTunedSummary={divulgation.staiTunedSummary}
        staiTunedMetrics={divulgation.staiTunedMetrics}
        featuredArticles={divulgation.featuredArticles}
        mentorshipSummary={divulgation.mentorshipSummary}
      />

      <!-- 7. Career & Leadership Timeline -->
      <AboutExperience
        kicker={experience.kicker}
        title={experience.title}
        subtitle={experience.subtitle}
        roles={experience.roles}
      />

      <!-- 8. Honors & Academic Foundations -->
      <AboutRecognition
        kicker={recognition.kicker}
        title={recognition.title}
        subtitle={recognition.subtitle}
        awards={recognition.awards}
        education={recognition.education}
      />

      <!-- 9. Collaboration & Advisory Callout -->
      <AboutCta
        kicker={cta.kicker}
        title={cta.title}
        description={cta.description}
        primaryActionLabel={cta.primaryActionLabel}
        primaryActionHref={cta.primaryActionHref}
        secondaryActionLabel={cta.secondaryActionLabel}
        secondaryActionHref={cta.secondaryActionHref}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: clamp(28px, 4vw, 48px) 0 clamp(48px, 6vw, 72px);
    background: var(--surface-canvas);
  }

  .about-shell {
    width: min(calc(100% - clamp(24px, 4vw, 48px)), 960px);
    margin-inline: auto;
  }
</style>
