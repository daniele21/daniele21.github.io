---
/**
 * about.astro
 * Verifiable professional background, track record, and engineering discipline.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import { landingData } from '../content/locales/en/landing';
import { credibilityProofs, credibilityIntro } from '../content/locales/en/credibility';

const { aboutSignal } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="About Daniele Moltisanti — Applied AI Systems & Research"
  description="Daniele Moltisanti is an AI and software product engineer focused on private compute, on-device intelligence, and verifiable system architecture."
>
  <LandingHeader slot="header" />

  <section class="about-page">
    <div class="shell">
      <!-- Top Profile Intro -->
      <div class="profile-hero">
        <div class="portrait-wrap">
          <img
            src={asset(landingData.hero.identity.portraitPath)}
            alt="Daniele Moltisanti portrait"
            width="140"
            height="140"
            loading="eager"
          />
        </div>
        <div class="profile-content">
          <p class="stage-kicker">ABOUT & BACKGROUND</p>
          <h1 class="page-title">Daniele Moltisanti</h1>
          <p class="profile-role">AI Systems Engineer · Applied Research</p>
          <p class="profile-lead">{credibilityIntro.quote}</p>
        </div>
      </div>

      <!-- Verified Proof Points -->
      <section class="proof-section">
        <h2 class="section-heading">Verified Track Record & Experience</h2>
        <div class="proof-grid">
          {credibilityProofs.map((proof) => (
            <article class="proof-card">
              <div class="proof-top">
                <span class="proof-tag">{proof.tag}</span>
                {proof.metric && <span class="proof-metric">{proof.metric}</span>}
              </div>
              <h3 class="proof-title">{proof.title}</h3>
              <p class="proof-subtitle">{proof.subtitle}</p>
              <p class="proof-desc">{proof.description}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Engineering Principles -->
      <section class="discipline-section">
        <h2 class="section-heading">Engineering Discipline</h2>
        <div class="discipline-grid">
          {aboutSignal.highlights.map((h) => (
            <div class="discipline-card">
              <h3>{h.label}</h3>
              <p>{h.detail}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Contact & Profiles -->
      <section class="profiles-section">
        <h2 class="section-heading">Get in Touch</h2>
        <div class="profiles-actions">
          <a class="primary-button" href="mailto:danielemoltisanti@gmail.com?subject=AI%20Architecture%20conversation">
            Discuss an AI architecture →
          </a>
          <a class="secondary-button" href={aboutSignal.linkedinUrl} target="_blank" rel="noopener noreferrer">
            LinkedIn Profile <span aria-hidden="true">↗</span>
          </a>
          <a class="secondary-button" href={aboutSignal.githubUrl} target="_blank" rel="noopener noreferrer">
            GitHub Profile <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding: clamp(48px, 6vw, 80px) 0;
  }

  .profile-hero {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
    padding: clamp(24px, 3vw, 36px);
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .portrait-wrap {
    width: 140px;
    height: 140px;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 3px solid var(--border-strong);
    box-shadow: 0 4px 16px rgba(20, 91, 255, 0.15);
  }

  .portrait-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink-display);
  }

  .profile-role {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 750;
    color: var(--accent-blue);
    margin: 0 0 var(--space-2);
  }

  .profile-lead {
    font-size: var(--text-lead);
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Proof Grid */
  .proof-section,
  .discipline-section,
  .profiles-section {
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    margin: 0 0 var(--space-4);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .proof-card {
    padding: var(--space-4);
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .proof-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .proof-tag {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .proof-metric {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 800;
    color: var(--accent-blue);
  }

  .proof-title {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--ink-display);
  }

  .proof-subtitle {
    margin: 0 0 var(--space-2);
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--ink-muted);
  }

  .proof-desc {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  /* Discipline Grid */
  .discipline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .discipline-card {
    padding: var(--space-4);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
  }

  .discipline-card h3 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-body);
    color: var(--ink-display);
  }

  .discipline-card p {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* Profiles Actions */
  .profiles-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 768px) {
    .profile-hero {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }

    .proof-grid {
      grid-template-columns: 1fr;
    }

    .profiles-actions {
      flex-direction: column;
    }

    .profiles-actions a {
      width: 100%;
    }
  }
</style>
