---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutData } from '../content/locales/en/about';

const { profile, now, experience } = aboutData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
const selectedRoles = experience.roles.slice(0, 3);
const currentFocus = now.items.slice(0, 3);

const workAreas = [
  {
    title: 'GenAI systems',
    body: 'LLM evaluation, retrieval, integration and production architecture — starting from the product problem rather than a model catalogue.',
  },
  {
    title: 'Local & on-device AI',
    body: 'Understanding what can move from cloud APIs to infrastructure and devices we control, and where that trade-off actually creates value.',
  },
  {
    title: 'AI engineering & strategy',
    body: 'Connecting technical choices with privacy, performance, operating constraints and the decisions teams need to make.',
  },
];

const proofPoints = [
  {
    title: 'Enterprise AI delivery',
    body: `I lead and design AI initiatives in complex production environments at ${profile.affiliation}.`,
  },
  {
    title: 'Hands-on systems',
    body: 'I build the infrastructure and proving grounds myself: local inference, Android runtimes, speech, product applications and measurement tooling.',
  },
  {
    title: 'Public technical work',
    body: 'I use stAI tuned, GitHub and LinkedIn to document architecture trade-offs, experiments and what survives contact with real systems.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  worksFor: { '@type': 'Organization', name: profile.affiliation },
  alumniOf: { '@type': 'EducationalOrganization', name: 'Politecnico di Milano' },
  url: 'https://daniele21.github.io/about',
  sameAs: [profile.socialLinks.linkedin, profile.socialLinks.github, profile.socialLinks.staituned],
  knowsAbout: ['Generative AI Systems', 'Local AI', 'On-device inference', 'AI Architecture', 'AI Strategy'],
};
---

<BaseLayout
  title="About Daniele Moltisanti - GenAI, Local AI & AI Architecture"
  description="AI engineer and strategy lead working on GenAI systems, Local AI and evidence-led architecture decisions across Local, Hybrid and Cloud."
  jsonLd={jsonLd}
>
  <div class="about-page">
    <div class="about-shell">
      <section class="about-hero" aria-labelledby="about-title">
        <div class="hero-copy">
          <h1 id="about-title">I work where GenAI architecture, product constraints and hands-on engineering meet.</h1>
          <p class="hero-lead">
            I'm <strong>{profile.name}</strong>, an AI engineer and strategy lead based in {profile.location}. I work on GenAI systems broadly, with a particular focus on Local and on-device AI — and on deciding what should run Local, Hybrid or Cloud.
          </p>
          <div class="hero-meta">
            <span>{profile.headline}</span>
            <span aria-hidden="true">·</span>
            <span>{profile.affiliation}</span>
          </div>
          <div class="hero-actions">
            <button type="button" class="primary-button" data-open-contact-modal>
              Discuss a workload <span aria-hidden="true">→</span>
            </button>
            <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="secondary-link">LinkedIn ↗</a>
          </div>
        </div>

        <div class="hero-portrait-wrap">
          <img
            src={asset(profile.portraitPath)}
            alt={profile.portraitAlt}
            width="300"
            height="360"
            loading="eager"
            decoding="async"
          />
        </div>
      </section>

      <section class="about-section" aria-labelledby="work-title">
        <header class="section-heading">
          <h2 id="work-title">What I work on</h2>
          <p>Three areas, one recurring question: what architecture makes this AI workload useful, controllable and sustainable?</p>
        </header>
        <div class="row-list">
          {workAreas.map((area) => (
            <article class="info-row">
              <h3>{area.title}</h3>
              <p>{area.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section proof-section" aria-labelledby="proof-title">
        <header class="section-heading">
          <h2 id="proof-title">Why my perspective may be useful</h2>
          <p>The advisory point of view comes from building systems, operating inside enterprise constraints and documenting the trade-offs in public.</p>
        </header>
        <div class="proof-grid">
          {proofPoints.map((point) => (
            <article class="proof-card">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" aria-labelledby="now-title">
        <header class="section-heading">
          <h2 id="now-title">What I'm exploring now</h2>
          <p>Current technical questions I’m using to push the Local / Hybrid / Cloud boundary.</p>
        </header>
        <div class="current-list">
          {currentFocus.map((item) => (
            <article class="current-row">
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <span>{item.status}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" aria-labelledby="track-title">
        <header class="section-heading">
          <h2 id="track-title">Selected track record</h2>
          <p>Enough context to understand where the perspective comes from. LinkedIn has the full chronology.</p>
        </header>
        <div class="experience-list">
          {selectedRoles.map((role) => (
            <article class="experience-row">
              <div class="experience-meta">
                <strong>{role.company}</strong>
                <span>{role.period}</span>
              </div>
              <div>
                <h3>{role.role}</h3>
                <p>{role.description}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="track-links">
          <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener noreferrer">Full experience on LinkedIn ↗</a>
          <a href={profile.socialLinks.staituned} target="_blank" rel="noopener noreferrer">Technical writing on stAI tuned ↗</a>
          <a href={profile.socialLinks.github} target="_blank" rel="noopener noreferrer">Projects on GitHub ↗</a>
        </div>
      </section>

      <section class="about-cta" aria-labelledby="about-cta-title">
        <div>
          <h2 id="about-cta-title">Have an AI workload to figure out?</h2>
          <p>Tell me what you're trying to run and what constraints matter. I'll start from the workload, not the model.</p>
        </div>
        <button type="button" class="primary-button" data-open-contact-modal>
          Evaluate my workload <span aria-hidden="true">→</span>
        </button>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    background: var(--surface-canvas);
    padding: clamp(28px, 4vw, 48px) 0 clamp(72px, 9vw, 118px);
  }

  .about-shell {
    width: min(calc(100% - clamp(28px, 5vw, 64px)), 1100px);
    margin-inline: auto;
  }

  .about-hero {
    min-height: min(680px, calc(100svh - var(--header-height) - 28px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 300px);
    gap: clamp(44px, 7vw, 90px);
    align-items: center;
    padding: clamp(54px, 7vw, 88px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .hero-copy h1 {
    max-width: 790px;
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    font-weight: 850;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 720px;
    margin: 0;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.68;
    color: var(--ink-muted);
  }

  .hero-lead strong {
    color: var(--ink-display);
    font-weight: 720;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
    font-size: 0.8rem;
    color: var(--ink-subtle);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 28px;
  }

  .hero-actions button,
  .about-cta button { cursor: pointer; }

  .secondary-link,
  .track-links a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 680;
  }

  .secondary-link:hover,
  .track-links a:hover { color: var(--accent-blue-dark); }

  .hero-portrait-wrap {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: clamp(24px, 3vw, 34px);
    background: var(--surface-subtle);
    box-shadow: var(--shadow-card);
  }

  .hero-portrait-wrap img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: cover;
  }

  .about-section {
    padding: clamp(64px, 8vw, 100px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1fr);
    gap: clamp(26px, 5vw, 64px);
    align-items: start;
    margin-bottom: clamp(30px, 4vw, 46px);
  }

  .section-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-weight: 820;
    color: var(--ink-display);
  }

  .section-heading > p {
    max-width: 620px;
    margin: 3px 0 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .row-list,
  .current-list,
  .experience-list { border-top: 1px solid var(--border-medium); }

  .info-row,
  .current-row,
  .experience-row {
    display: grid;
    grid-template-columns: minmax(180px, 0.48fr) minmax(0, 1fr);
    gap: clamp(22px, 4vw, 54px);
    padding: 21px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .info-row h3,
  .current-row h3,
  .experience-row h3,
  .proof-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 780;
    color: var(--ink-display);
  }

  .info-row p,
  .current-row p,
  .experience-row p,
  .proof-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .proof-card {
    padding: 22px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .proof-card h3 { margin-bottom: 8px; }

  .current-row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
  }

  .current-row h3 { margin-bottom: 5px; }

  .current-row > span {
    padding: 5px 9px;
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    font-size: 0.72rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .experience-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .experience-meta strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
    color: var(--ink-display);
  }

  .experience-meta span {
    font-size: 0.76rem;
    color: var(--ink-subtle);
  }

  .experience-row h3 { margin-bottom: 5px; }

  .track-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 22px;
  }

  .about-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: clamp(62px, 8vw, 100px);
    padding: clamp(26px, 4vw, 40px);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 22%, var(--border-medium));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-card));
  }

  .about-cta h2 {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    color: var(--ink-display);
  }

  .about-cta p {
    max-width: 650px;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .about-cta button { flex-shrink: 0; }

  @media (max-width: 820px) {
    .about-hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-portrait-wrap { max-width: 280px; order: -1; }
    .section-heading { grid-template-columns: 1fr; gap: 10px; }
    .proof-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .info-row,
    .experience-row { grid-template-columns: 1fr; gap: 7px; }
    .current-row { grid-template-columns: 1fr; gap: 12px; }
    .current-row > span { width: fit-content; }
    .about-cta { align-items: flex-start; flex-direction: column; }
    .about-cta button { width: 100%; justify-content: center; }
  }
</style>
