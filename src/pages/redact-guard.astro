---
/**
 * redact-guard.astro
 * RedactGuard Desktop product page using the current archetype-based project UX.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectVariantSwitch from '../components/project/ProjectVariantSwitch.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectProof from '../components/project/ProjectProof.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectRelations from '../components/project/ProjectRelations.astro';

import RedactGuardProblem from '../components/redactguard/RedactGuardProblem.astro';
import RedactGuardSolution from '../components/redactguard/RedactGuardSolution.astro';
import RedactGuardProduct from '../components/redactguard/RedactGuardProduct.astro';
import RedactGuardArchitecture from '../components/redactguard/RedactGuardArchitecture.astro';
import RedactGuardCta from '../components/redactguard/RedactGuardCta.astro';

import { redactGuardData } from '../content/redactGuard';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const { hero } = redactGuardData;
const desktopRepo = 'https://github.com/daniele21/redact-guard';

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Workflow', href: '#workflow' },
  { label: 'Product', href: '#product' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Evidence', href: '#evidence' },
];

const variants = [
  {
    label: 'Desktop',
    backbone: 'Powered by Korgis',
    href: `${baseUrl}/redact-guard`,
    active: true,
  },
  {
    label: 'Android',
    backbone: 'Powered by Harnex',
    href: `${baseUrl}/redact-guard-android`,
  },
];

const redactGuardSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "RedactGuard Desktop",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Desktop",
  "description": redactGuardData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": desktopRepo
};
---

<BaseLayout
  title={redactGuardData.meta.title}
  description={redactGuardData.meta.description}
  jsonLd={redactGuardSchema}
>
  <ProductSubHeader
    title="RedactGuard"
    badge="Desktop · Korgis"
    logoPath="images/redact-guard/logo.png"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: desktopRepo }}
    underSiteHeader={true}
  />

  <ProjectVariantSwitch
    family="RedactGuard"
    description="One privacy workflow. Two local execution boundaries."
    variants={variants}
  />

  <div id="top" data-project-page data-project-archetype="product" data-project-variant="desktop">
    <ProjectHero
      eyebrow="PRODUCT · DESKTOP · KORGIS"
      title="RedactGuard Desktop"
      lede="Detect configurable PII locally, review every finding, and export only the minimized document while keeping reusable local execution behind Korgis."
      status="Experimental privacy tool"
      meta={['Desktop workflow', 'Korgis backbone', 'Human review']}
      actions={[
        { label: 'See the workflow ↓', href: '#workflow' },
        { label: 'GitHub ↗', href: desktopRepo, variant: 'secondary' },
      ]}
      visualLabel="RedactGuard Desktop review interface"
    >
      <div class="product-hero-frame">
        <img
          data-zoomable
          src={`${baseUrl}/${hero.imageHero.replace(/^\//, '')}`}
          alt="RedactGuard Desktop review screen showing detected sensitive data before redaction"
          width="1440"
          height="900"
          loading="eager"
        />
        <div class="product-hero-caption">
          <span>{hero.imageCaptionLeft}</span>
          <span>{hero.imageCaptionRight}</span>
        </div>
      </div>
    </ProjectHero>

    <ProjectProof
      statement="A sensitive-document product can keep privacy policy and human decisions in the application while local AI execution remains a reusable infrastructure boundary."
      detail="RedactGuard owns the document workflow. Korgis owns reusable local execution. The model proposes findings, but the user still decides what is actually removed."
    />

    <RedactGuardProblem data={redactGuardData} />

    <div id="workflow" class="project-anchor">
      <RedactGuardSolution data={redactGuardData} />
    </div>

    <div id="product" class="project-anchor">
      <RedactGuardProduct baseUrl={baseUrl} data={redactGuardData} />
    </div>

    <div id="architecture" class="project-anchor">
      <RedactGuardArchitecture
        baseUrl={baseUrl}
        data={redactGuardData}
        repoUrl={desktopRepo}
      />
    </div>

    <ProjectSection
      id="evidence"
      eyebrow="EVIDENCE & LIMITS"
      title="The desktop workflow is implemented. Detection is still fallible."
      description="RedactGuard treats reviewability as part of the product boundary: local inference can accelerate detection, but it does not turn the model into an autonomous privacy or compliance authority."
      tone="subtle"
      width="wide"
    >
      <ProjectEvidenceNote
        title="Local, configurable and reviewable does not mean perfect."
        body="The current desktop product supports configurable PII definitions, local execution through the Korgis boundary, reviewable findings and explicit export. The model can still miss, misclassify or over-detect sensitive information, so human review remains mandatory."
        evidenced={[
          'Document analysis can run through a local execution boundary',
          'Standard and custom PII definitions are configurable',
          'Every finding remains visible and reviewable before export',
          'The minimized result moves only after explicit user choices',
        ]}
        missing={[
          'Compliance guarantee',
          'Published perfect-recall or perfect-precision claim across PII domains',
        ]}
      />
    </ProjectSection>

    <ProjectRelations
      items={[
        {
          stage: 'BUILD · INFRASTRUCTURE',
          title: 'Korgis',
          href: '/korgis',
          note: 'Reusable local inference boundary',
        },
        {
          stage: 'PRODUCT · DESKTOP',
          title: 'RedactGuard Desktop',
          current: true,
          note: 'Privacy-first proving ground',
        },
        {
          stage: 'MEASURE · EVIDENCE',
          title: 'Performance Lab',
          href: '/performance-lab',
          note: 'Runtime viability on real hardware',
        },
      ]}
    />

    <RedactGuardCta
      data={redactGuardData}
      repoUrl={desktopRepo}
      buttonLabel="Explore Desktop"
    />
  </div>
</BaseLayout>

<style>
  .product-hero-frame {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: clamp(18px, 2.5vw, 28px);
    background: var(--surface-card);
    box-shadow: 0 28px 72px rgba(8, 19, 51, 0.14);
  }

  .product-hero-frame img {
    display: block;
    width: 100%;
    max-height: 760px;
    object-fit: contain;
    background: var(--surface-subtle);
  }

  .product-hero-caption {
    min-height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 10px 16px;
    border-top: 1px solid var(--border-subtle);
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    font-weight: 650;
  }

  .project-anchor {
    scroll-margin-top: calc(var(--header-height) + 64px);
  }

  @media (max-width: 640px) {
    .product-hero-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
