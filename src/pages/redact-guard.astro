---
/**
 * redact-guard.astro
 * RedactGuard Desktop product deep-dive using the shared project-page journey.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RedactGuardHeader from '../components/redactguard/RedactGuardHeader.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectVariantSwitch from '../components/project/ProjectVariantSwitch.astro';
import ProjectPhase from '../components/project/ProjectPhase.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectDecisionBand from '../components/project/ProjectDecisionBand.astro';
import RedactGuardHero from '../components/redactguard/RedactGuardHero.astro';
import RedactGuardProblem from '../components/redactguard/RedactGuardProblem.astro';
import RedactGuardSolution from '../components/redactguard/RedactGuardSolution.astro';
import RedactGuardBenefits from '../components/redactguard/RedactGuardBenefits.astro';
import RedactGuardProduct from '../components/redactguard/RedactGuardProduct.astro';
import RedactGuardArchitecture from '../components/redactguard/RedactGuardArchitecture.astro';
import RedactGuardCta from '../components/redactguard/RedactGuardCta.astro';

import { redactGuardData } from '../content/redactGuard';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const desktopRepo = 'https://github.com/daniele21/redact-guard';

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Decide', href: '#decide' },
  { label: 'Build', href: '#build' },
  { label: 'Test', href: '#test' },
  { label: 'Measure', href: '#measure' },
  { label: 'Decide again', href: '#decide-again' },
];

const variants = [
  {
    label: 'Desktop',
    backbone: 'Powered by Korgis',
    href: `${baseUrl}/redact-guard`,
    active: true,
  },
  {
    label: 'Android',
    backbone: 'Powered by Harnex',
    href: `${baseUrl}/redact-guard-android`,
  },
];

const redactGuardSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "RedactGuard Desktop",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Desktop",
  "description": redactGuardData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": desktopRepo
};
---

<BaseLayout
  title={redactGuardData.meta.title}
  description={redactGuardData.meta.description}
  jsonLd={redactGuardSchema}
>
  <RedactGuardHeader baseUrl={baseUrl} slot="header" />

  <ProductSubHeader
    title="RedactGuard"
    badge="Desktop · Korgis"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: desktopRepo }}
  />

  <ProjectVariantSwitch
    family="RedactGuard"
    description="One privacy workflow. Two local execution boundaries."
    variants={variants}
  />

  <div id="top" data-project-page data-project-archetype="product" data-project-variant="desktop">
    <RedactGuardHero baseUrl={baseUrl} data={redactGuardData} repoUrl={desktopRepo} />

    <ProjectPhase
      id="decide"
      step="01"
      label="DECIDE"
      title="Can a desktop document workflow adapt to changing PII without moving the source document to cloud AI?"
      description="RedactGuard starts from a changing definition of PII: what is sensitive depends on the document, organization and workflow. The product keeps that policy close to the user instead of making cloud inference the default privacy boundary."
    >
      <RedactGuardProblem data={redactGuardData} />
      <RedactGuardBenefits data={redactGuardData} />
    </ProjectPhase>

    <ProjectPhase
      id="build"
      step="02"
      label="BUILD"
      title="Keep the document workflow in RedactGuard and local execution behind Korgis."
      description="RedactGuard owns import, PII policy, review, redaction and export. Korgis provides the reusable local AI execution boundary underneath, keeping application logic and inference infrastructure separate."
      tone="subtle"
    >
      <RedactGuardSolution data={redactGuardData} />
      <RedactGuardArchitecture baseUrl={baseUrl} data={redactGuardData} repoUrl={desktopRepo} />
    </ProjectPhase>

    <ProjectPhase
      id="test"
      step="03"
      label="TEST"
      title="Prove the architecture inside a complete desktop redaction workflow."
      description="The real test is load → detect → review → redact → export. Local AI accelerates detection, but the final privacy decision remains explicit and human-controlled before anything is shared."
    >
      <RedactGuardProduct baseUrl={baseUrl} data={redactGuardData} />
    </ProjectPhase>

    <ProjectPhase
      id="measure"
      step="04"
      label="MEASURE"
      title="Treat model limits and the local boundary as part of the evidence."
      description="RedactGuard is an experimental privacy tool, not a compliance guarantee. The page separates what the desktop workflow and local execution boundary demonstrate from claims that still require stronger model-quality evidence."
      tone="subtle"
    >
      <ProjectEvidenceNote
        title="The desktop workflow is implemented; detection remains fallible."
        body="The current product supports configurable PII definitions, local execution, reviewable findings and minimized export. A local model can still miss, misclassify or over-detect sensitive information, so human review remains mandatory."
        evidenced={[
          'Document analysis can run through a local execution boundary',
          'Standard and custom PII definitions are configurable',
          'Every finding remains reviewable before export',
          'The minimized result moves only after explicit user choices',
        ]}
        missing={[
          'Compliance guarantee',
          'Published perfect-recall or perfect-precision claim across PII domains',
        ]}
      />
    </ProjectPhase>

    <ProjectPhase
      id="decide-again"
      step="05"
      label="DECIDE AGAIN"
      title="Keep product policy and local execution separate."
      description="The current desktop decision is to let RedactGuard own the privacy workflow while Korgis owns reusable local execution, without transferring the final redaction decision to the model."
    >
      <ProjectDecisionBand
        title="One privacy product. A separate local execution backbone."
        body="RedactGuard keeps document workflow, PII policy and human confirmation at the application layer. Korgis provides the local AI execution boundary beneath it, so the product can evolve without collapsing product-specific logic into runtime infrastructure."
        signals={[
          'RedactGuard owns document workflow and privacy policy',
          'Korgis owns reusable local AI execution',
          'Human review remains required because model detection is fallible',
        ]}
      />
    </ProjectPhase>

    <RedactGuardCta
      data={redactGuardData}
      repoUrl={desktopRepo}
      buttonLabel="Explore Desktop"
    />
  </div>
</BaseLayout>
