---
/**
 * redact-guard.astro
 * Product / proving-ground pilot for the archetype-based project page UX.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RedactGuardHeader from '../components/redactguard/RedactGuardHeader.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectProof from '../components/project/ProjectProof.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectRelations from '../components/project/ProjectRelations.astro';

import RedactGuardProblem from '../components/redactguard/RedactGuardProblem.astro';
import RedactGuardSolution from '../components/redactguard/RedactGuardSolution.astro';
import RedactGuardProduct from '../components/redactguard/RedactGuardProduct.astro';
import RedactGuardArchitecture from '../components/redactguard/RedactGuardArchitecture.astro';
import RedactGuardCta from '../components/redactguard/RedactGuardCta.astro';

import { redactGuardData } from '../content/redactGuard';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const { hero } = redactGuardData;

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Workflow', href: '#workflow' },
  { label: 'Product', href: '#product' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Evidence', href: '#evidence' },
];

const redactGuardSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "RedactGuard",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Cross-platform",
  "description": redactGuardData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": "https://github.com/daniele21/redact-guard"
};
---

<BaseLayout
  title={redactGuardData.meta.title}
  description={redactGuardData.meta.description}
  jsonLd={redactGuardSchema}
>
  <RedactGuardHeader baseUrl={baseUrl} slot="header" />

  <ProductSubHeader
    title="RedactGuard"
    badge="v1.0"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: 'https://github.com/daniele21/redact-guard' }}
  />

  <div id="top" data-project-page data-project-archetype="product">
    <ProjectHero
      eyebrow="PRODUCT · PRIVACY-FIRST LOCAL AI"
      title="RedactGuard"
      lede="Detect sensitive information locally, review every finding, and move only the minimized document into the next workflow."
      status="v1.0 · Experimental privacy tool"
      meta={['Local processing', 'Custom PII', 'Human review']}
      actions={[
        { label: 'See the workflow ↓', href: '#workflow' },
        { label: 'GitHub ↗', href: 'https://github.com/daniele21/redact-guard', variant: 'secondary' },
      ]}
      visualLabel="RedactGuard review interface"
    >
      <div class="product-hero-frame">
        <img
          data-zoomable
          src={`${baseUrl}/${hero.imageHero.replace(/^\//, '')}`}
          alt="RedactGuard review screen showing detected sensitive data before redaction"
          width="1440"
          height="900"
          loading="eager"
        />
        <div class="product-hero-caption">
          <span>{hero.imageCaptionLeft}</span>
          <span>{hero.imageCaptionRight}</span>
        </div>
      </div>
    </ProjectHero>

    <ProjectProof
      statement="Sensitive-document workflows can use adaptable AI detection without making a cloud model the default privacy boundary."
      detail="The model proposes findings locally; the user reviews what is actually removed before any minimized result is exported."
    />

    <RedactGuardProblem />

    <div id="workflow" class="project-anchor">
      <RedactGuardSolution />
    </div>

    <RedactGuardProduct baseUrl={baseUrl} />

    <RedactGuardArchitecture baseUrl={baseUrl} />

    <ProjectSection
      id="evidence"
      eyebrow="EVIDENCE & LIMITS"
      title="The workflow is implemented. Detection is still fallible."
      description="RedactGuard treats reviewability as part of the product boundary: local inference can accelerate detection, but it does not turn the model into an autonomous privacy or compliance authority."
      tone="subtle"
      width="wide"
    >
      <ProjectEvidenceNote
        title="Local, configurable and reviewable does not mean perfect."
        body="The current product supports local GGUF inference, configurable standard and custom PII definitions, reviewable findings and explicit export. The model can still miss, misclassify or over-detect sensitive information, so human review remains mandatory."
        evidenced={[
          'Document analysis can run through local GGUF inference',
          'Standard and custom PII definitions are configurable',
          'Every finding remains visible and reviewable before export',
          'The minimized result moves only after explicit user choices',
        ]}
        missing={[
          'Compliance guarantee',
          'Published perfect-recall or perfect-precision claim across PII domains',
        ]}
      />
    </ProjectSection>

    <ProjectRelations
      items={[
        {
          stage: 'BUILD · INFRASTRUCTURE',
          title: 'Local LLM Server',
          href: '/local-llm-server',
          note: 'Reusable local inference boundary',
        },
        {
          stage: 'TEST · PRODUCT',
          title: 'RedactGuard',
          current: true,
          note: 'Privacy-first proving ground',
        },
        {
          stage: 'MEASURE · EVIDENCE',
          title: 'Performance Lab',
          href: '/performance-lab',
          note: 'Runtime viability on real hardware',
        },
      ]}
    />

    <RedactGuardCta />
  </div>
</BaseLayout>

<style>
  .product-hero-frame {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: clamp(18px, 2.5vw, 28px);
    background: var(--surface-card);
    box-shadow: 0 28px 72px rgba(8, 19, 51, 0.14);
  }

  .product-hero-frame img {
    display: block;
    width: 100%;
    max-height: 760px;
    object-fit: contain;
    background: var(--surface-subtle);
  }

  .product-hero-caption {
    min-height: 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 10px 16px;
    border-top: 1px solid var(--border-subtle);
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    font-weight: 650;
  }

  .project-anchor {
    scroll-margin-top: 104px;
  }

  @media (max-width: 640px) {
    .product-hero-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
