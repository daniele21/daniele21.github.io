---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioNarrative } from '../content/portfolio';

const { experiments } = portfolioNarrative;

const visualGuidance: Record<string, string> = {
  'jev-vs-llm':
    'Insert a compact architecture-comparison visual showing typed decision systems, decomposed LLM workflows, monolithic LLM baselines and local Korgis models feeding the same workload/evaluation contract. Avoid a winner podium.',
  'model-capability-benchmark':
    'Insert the latest neutral capability × model matrix from the generated report. Highlight capability-specific metrics, runtime identity and drill-down rather than one overall score.',
  'redactguard-local-anonymization':
    'Insert the latest React dashboard capture: model comparison, recall-vs-latency trade-off, per-PII-type breakdown and failure explorer. Use only a run whose provenance is publishable.',
  'vlm-capability-benchmark':
    'When the first real run exists, show 3–4 representative tasks side by side: document understanding, chart reasoning, grounding and UI understanding, with exact model/runtime identity.',
  'image-generation-benchmark':
    'When the first real run exists, show blinded side-by-side generations for the same prompt plus the task-specific checks. Do not label a universal winner.',
};

const experimentSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Experiments — Daniele Moltisanti',
  description: 'Reproducible AI experiments across model capability, decision architectures, privacy workflows and multimodal evaluation.',
  author: {
    '@type': 'Person',
    name: 'Daniele Moltisanti',
  },
};
---

<BaseLayout
  title="Experiments — Evidence before architecture decisions"
  description="Reproducible AI experiments across local and API models, bounded decision systems, privacy workflows and multimodal evaluation. Question, method, evidence, so what, decision."
  jsonLd={experimentSchema}
>
  <div class="experiments-page">
    <section class="experiments-hero">
      <div class="shell narrow">
        <p class="eyebrow">EXPERIMENTS · EVALUATION · EVIDENCE</p>
        <h1>Evidence before architecture decisions.</h1>
        <p class="hero-lede">
          I use reproducible experiments to answer product and system questions—not to manufacture a universal leaderboard.
          The goal is to understand <strong>what works, where, under which constraints, and what that should change next</strong>.
        </p>

        <div class="hero-loop" aria-label="Experiment reasoning loop">
          <span>QUESTION</span><b>→</b>
          <span>METHOD</span><b>→</b>
          <span>EVIDENCE</span><b>→</b>
          <span>SO WHAT</span><b>→</b>
          <span>DECISION</span>
        </div>

        <div class="aggregate-grid" aria-label="Current Experiments repository scope">
          {experiments.aggregates.map((item) => (
            <div class="aggregate-card">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
        <p class="aggregate-note">{experiments.note}</p>
      </div>
    </section>

    <section class="experiment-index">
      <div class="shell">
        <div class="section-intro">
          <div>
            <p class="eyebrow">CURRENT TRACKS</p>
            <h2>Each experiment starts with a decision worth improving.</h2>
          </div>
          <p>
            Results stay tied to their exact dataset, model/runtime identity and evaluation contract.
            Failed gates and missing evidence are part of the result, not something to hide.
          </p>
        </div>

        <nav class="track-nav" aria-label="Experiment tracks">
          {experiments.tracks.map((track, index) => (
            <a href={`#${track.id}`}>
              <span>0{index + 1}</span>
              <strong>{track.name}</strong>
              <small>{track.status}</small>
            </a>
          ))}
        </nav>
      </div>
    </section>

    {experiments.tracks.map((track, index) => (
      <section class:list={['experiment-section', { 'experiment-section--alt': index % 2 === 1 }]} id={track.id}>
        <div class="shell">
          <header class="experiment-header">
            <div class="experiment-number">0{index + 1}</div>
            <div class="experiment-title">
              <div class="experiment-meta">
                <span>{track.status}</span>
                <a href={track.href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              </div>
              <h2>{track.name}</h2>
              <p>{track.question}</p>
            </div>
          </header>

          <div class="experiment-story">
            <div class="story-column">
              <article class="story-block">
                <span class="story-label">QUESTION</span>
                <h3>What am I trying to decide?</h3>
                <p>{track.question}</p>
              </article>

              <article class="story-block">
                <span class="story-label">METHOD</span>
                <h3>How is the comparison made credible?</h3>
                <p>{track.method}</p>
              </article>

              <article class="story-block story-block--result">
                <span class="story-label">RESULTS / EVIDENCE</span>
                <h3>What exists today?</h3>
                <p>{track.results}</p>
                {!track.publishableMetrics && (
                  <p class="publication-note">
                    <strong>Publication boundary:</strong> numeric results for restricted providers are intentionally not reproduced publicly unless the applicable terms allow it.
                  </p>
                )}
              </article>
            </div>

            <div class="experiment-visual-column">
              <div class="visual-placeholder">
                <div class="placeholder-label">VISUAL PLACEHOLDER</div>
                <strong>What should be shown here</strong>
                <p>{visualGuidance[track.id]}</p>
                <small>Replace only with evidence generated by the current experiment contract.</small>
              </div>

              <article class="so-what-card">
                <span>SO WHAT?</span>
                <h3>{track.soWhat}</h3>
                <div class="decision-impact">
                  <strong>WHAT IT CHANGED</strong>
                  <p>{track.changed}</p>
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="experiments-close">
      <div class="shell close-grid">
        <div>
          <p class="eyebrow">THE POINT</p>
          <h2>The benchmark is not the output. The better decision is.</h2>
        </div>
        <div>
          <p>
            Experiments connects the rest of the portfolio: product failures become test cases, system constraints become metrics,
            and evidence feeds back into runtime, product and architecture choices.
          </p>
          <div class="feedback-loop">
            <span>System</span><b>→</b>
            <span>Product</span><b>→</b>
            <span>Experiment</span><b>→</b>
            <span>Evidence</span><b>→</b>
            <span>Better system</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .experiments-page { background: var(--surface-canvas); }
  .shell.narrow { max-width: 1100px; }

  .experiments-hero {
    padding: clamp(72px, 9vw, 126px) 0 clamp(64px, 8vw, 104px);
    background:
      radial-gradient(ellipse 58% 45% at 78% 10%, color-mix(in srgb, var(--accent-blue) 11%, transparent), transparent 72%),
      linear-gradient(180deg, var(--surface-canvas), var(--surface-subtle));
    border-bottom: 1px solid var(--border-medium);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .experiments-hero h1 {
    max-width: 980px;
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.6rem);
    line-height: .98;
    letter-spacing: -.064em;
    text-wrap: balance;
  }

  .hero-lede {
    max-width: 830px;
    margin: 24px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    line-height: 1.68;
  }

  .hero-lede strong { color: var(--ink-display); }

  .hero-loop,
  .feedback-loop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 10px;
    margin-top: 28px;
  }

  .hero-loop span,
  .feedback-loop span {
    padding: 6px 9px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink-display);
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 820;
    letter-spacing: .05em;
  }

  .hero-loop b,
  .feedback-loop b { color: var(--accent-blue); }

  .aggregate-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 36px;
  }

  .aggregate-card {
    padding: 17px;
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface-card) 92%, transparent);
  }

  .aggregate-card strong {
    display: block;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    letter-spacing: -.04em;
  }

  .aggregate-card span {
    display: block;
    margin-top: 4px;
    color: var(--ink-muted);
    font-size: .72rem;
    line-height: 1.35;
  }

  .aggregate-note {
    margin: 10px 0 0;
    color: var(--ink-subtle);
    font-size: .72rem;
    line-height: 1.45;
  }

  .experiment-index {
    padding: clamp(58px, 7vw, 86px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(300px, 1.05fr);
    gap: clamp(30px, 6vw, 76px);
    align-items: end;
  }

  .section-intro h2,
  .experiments-close h2 {
    max-width: 650px;
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1.05;
    letter-spacing: -.05em;
  }

  .section-intro > p,
  .close-grid > div:last-child > p {
    margin: 0;
    color: var(--ink-muted);
    font-size: .95rem;
    line-height: 1.68;
  }

  .track-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 34px;
  }

  .track-nav a {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border: 1px solid var(--border-medium);
    border-radius: 12px;
    background: var(--surface-card);
    color: inherit;
    text-decoration: none;
  }

  .track-nav a > span {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 830;
  }

  .track-nav strong {
    color: var(--ink-display);
    font-size: .78rem;
    line-height: 1.35;
  }

  .track-nav small {
    color: var(--ink-subtle);
    font-size: .66rem;
    line-height: 1.35;
  }

  .experiment-section {
    scroll-margin-top: calc(var(--header-height) + 24px);
    padding: clamp(68px, 9vw, 118px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .experiment-section--alt { background: var(--surface-subtle); }

  .experiment-header {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-bottom: 34px;
  }

  .experiment-number {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: .84rem;
    font-weight: 850;
    padding-top: 7px;
  }

  .experiment-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .experiment-meta span {
    padding: 4px 8px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink-muted);
    font-size: .7rem;
  }

  .experiment-meta a {
    color: var(--accent-blue-dark);
    font-size: .72rem;
    font-weight: 750;
    text-decoration: none;
  }

  .experiment-title h2 {
    margin: 10px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 4.1rem);
    line-height: 1;
    letter-spacing: -.055em;
  }

  .experiment-title > p {
    max-width: 780px;
    margin: 14px 0 0;
    color: var(--ink);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    font-weight: 620;
    line-height: 1.6;
  }

  .experiment-story {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(320px, .88fr);
    gap: 18px;
  }

  .story-column {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-medium);
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface-card);
  }

  .story-block {
    padding: 22px 24px;
  }

  .story-block + .story-block { border-top: 1px solid var(--border-subtle); }

  .story-label,
  .so-what-card > span,
  .decision-impact > strong,
  .placeholder-label {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: .67rem;
    font-weight: 850;
    letter-spacing: .08em;
  }

  .story-block h3 {
    margin: 7px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1.03rem;
  }

  .story-block p {
    margin: 8px 0 0;
    color: var(--ink-muted);
    font-size: .88rem;
    line-height: 1.62;
  }

  .story-block--result {
    background: color-mix(in srgb, var(--accent-blue) 3%, var(--surface-card));
  }

  .publication-note {
    padding: 10px 12px;
    border-left: 3px solid #d97706;
    background: #fffaf0;
    color: #7c5b20 !important;
  }

  .experiment-visual-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .visual-placeholder {
    min-height: 230px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
    border: 1.5px dashed color-mix(in srgb, var(--accent-blue) 48%, var(--border-medium));
    border-radius: 18px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 5%, transparent), transparent),
      var(--surface-card);
  }

  .visual-placeholder > strong {
    margin-top: 8px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .visual-placeholder p {
    margin: 8px 0 0;
    color: var(--ink-muted);
    font-size: .82rem;
    line-height: 1.55;
  }

  .visual-placeholder small {
    margin-top: 14px;
    color: var(--ink-subtle);
    font-size: .7rem;
  }

  .so-what-card {
    flex: 1;
    padding: 24px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 25%, var(--border-medium));
    border-radius: 18px;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent-blue) 10%, transparent), transparent 45%),
      var(--surface-card);
  }

  .so-what-card h3 {
    margin: 9px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.22rem, 2vw, 1.65rem);
    line-height: 1.28;
    letter-spacing: -.025em;
  }

  .decision-impact {
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid var(--border-subtle);
  }

  .decision-impact p {
    margin: 6px 0 0;
    color: var(--ink-muted);
    font-size: .8rem;
    line-height: 1.55;
  }

  .experiments-close {
    padding: clamp(72px, 9vw, 118px) 0;
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-canvas));
  }

  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(320px, 1.1fr);
    gap: clamp(34px, 7vw, 90px);
    align-items: center;
  }

  @media (max-width: 980px) {
    .aggregate-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .track-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .section-intro,
    .experiment-story,
    .close-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .experiments-hero h1 { font-size: clamp(2.75rem, 14vw, 4.2rem); }
    .aggregate-grid,
    .track-nav { grid-template-columns: 1fr; }
    .experiment-header { grid-template-columns: 1fr; gap: 7px; }
    .experiment-number { padding: 0; }
  }
</style>
