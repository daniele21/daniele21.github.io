---
/**
 * android-local-llm-harness.astro
 * Infrastructure deep-dive using the shared archetype-based project UX.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectProof from '../components/project/ProjectProof.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectEvidenceNote from '../components/project/ProjectEvidenceNote.astro';
import ProjectRelations from '../components/project/ProjectRelations.astro';

import HarnessMission from '../components/harness/HarnessMission.astro';
import HarnessProblems from '../components/harness/HarnessProblems.astro';
import HarnessConcept from '../components/harness/HarnessConcept.astro';
import HarnessSurfaces from '../components/harness/HarnessSurfaces.astro';
import HarnessArchitecture from '../components/harness/HarnessArchitecture.astro';
import HarnessValues from '../components/harness/HarnessValues.astro';
import HarnessRoadmap from '../components/harness/HarnessRoadmap.astro';
import HarnessCodePreview from '../components/harness/HarnessCodePreview.astro';
import HarnessMaturity from '../components/harness/HarnessMaturity.astro';
import HarnessCta from '../components/harness/HarnessCta.astro';

import { harnessData } from '../content/harness';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const { hero } = harnessData;

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Runtime', href: '#runtime' },
  { label: 'Evidence', href: '#evidence' },
  { label: 'Status', href: '#status' },
];

const harnessSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Android Local LLM Harness",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Android",
  "description": harnessData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": "https://github.com/daniele21/android-local-llm-harness"
};
---

<BaseLayout
  title={harnessData.meta.title}
  description={harnessData.meta.description}
  jsonLd={harnessSchema}
>
  <ProductSubHeader
    title="Harnex"
    badge="Spec & prototype"
    logoPath="images/harness/harnex-symbol.png"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: 'https://github.com/daniele21/android-local-llm-harness' }}
  />

  <div id="top" data-project-page data-project-archetype="infrastructure">
    <ProjectHero
      eyebrow="INFRASTRUCTURE · ANDROID LOCAL AI"
      title="Harnex"
      lede="Your local AI harness for Android: one gateway, shared on-device LLM runtime, model plane, and control plane so Android teams can build local AI features without rebuilding infrastructure inside every app."
      status="Spec & prototype · active validation"
      logoPath="images/harness/harnex-symbol.png"
      meta={['Android API 26+', 'GGUF + llama.cpp', 'Kotlin + JNI/C++', 'MIT']}
      actions={[
        { label: 'Explore architecture ↓', href: '#architecture' },
        { label: 'GitHub ↗', href: 'https://github.com/daniele21/android-local-llm-harness', variant: 'secondary' },
      ]}
      visualLabel="Harnex architecture & Local AI Gateway vision"
    >
      <div class="harness-hero-visual">
        <img
          data-zoomable
          src={`${baseUrl}/${hero.imageHero}`}
          alt="Harnex architecture showing the app, gateway and local inference engine"
          width="1400"
          height="900"
          loading="eager"
        />
        <div class="harness-hero-caption">
          <span>{hero.imageNoteLeft}</span>
          <span>{hero.imageNoteRight}</span>
        </div>
      </div>
    </ProjectHero>

    <ProjectProof
      statement="On-device AI becomes reusable infrastructure only when model identity, lifecycle, memory ownership, client boundaries and diagnostics are explicit."
      detail="Harnex is proving those foundations in one connected Android console before moving runtime ownership into the final cross-application Binder/AIDL gateway."
    />

    <HarnessMission />
    <HarnessProblems />

    <div id="architecture" class="project-anchor">
      <HarnessConcept />
      <HarnessArchitecture baseUrl={baseUrl} />
    </div>

    <div id="runtime" class="project-anchor">
      <HarnessCodePreview />
      <HarnessSurfaces baseUrl={baseUrl} />
      <HarnessValues />
    </div>

    <ProjectSection
      id="evidence"
      eyebrow="EVIDENCE & LIMITS"
      title="The runtime foundation is integrated; the shared gateway is still the target architecture."
      description="The page separates what exists in the connected console today from the physical-device and cross-application evidence still required before stronger platform claims are justified."
      tone="subtle"
      width="wide"
    >
      <HarnessMaturity />
      <ProjectEvidenceNote
        title="Integrated capability is not yet production-readiness evidence."
        body="Harnex currently integrates embedded GGUF inference, streaming, cancellation, model lifecycle and diagnostic surfaces. Representative device evidence and the shared Binder/AIDL host remain necessary before describing it as a production Android inference platform."
        evidenced={[
          'Embedded GGUF inference path is integrated',
          'Streaming, cancellation and model lifecycle are implemented',
          'Runtime health, resources and benchmark surfaces are connected',
          'Client and backend boundaries are explicit in the current architecture',
        ]}
        missing={[
          'Representative physical-device memory and thermal validation',
          'Production packaging and reliability evidence',
          'Cross-application Binder/AIDL host',
        ]}
      />
    </ProjectSection>

    <ProjectSection
      id="status"
      eyebrow="STATUS & NEXT"
      title="Prove the data plane, stabilize the contract, then move ownership."
      description="The roadmap deliberately validates the difficult runtime and model-management foundations before adding cross-application IPC and shared resource ownership."
      tone="canvas"
      width="wide"
    >
      <HarnessRoadmap />
    </ProjectSection>

    <ProjectRelations
      title="How the Android local-AI layer is evaluated"
      items={[
        {
          stage: 'BUILD · INFRASTRUCTURE',
          title: 'Harnex',
          current: true,
          note: 'Runtime, models and diagnostics on-device',
        },
        {
          stage: 'MEASURE · PERFORMANCE',
          title: 'Performance Lab',
          href: '/performance-lab',
          note: 'Latency, throughput and resource-fit evidence',
        },
        {
          stage: 'MEASURE · NETWORK',
          title: 'Traffic Monitoring Android',
          href: '/traffic-monitoring-android',
          note: 'Network-boundary observability on Android',
        },
      ]}
    />

    <HarnessCta baseUrl={baseUrl} />
  </div>
</BaseLayout>

<style>
  .harness-hero-visual {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: clamp(18px, 2.5vw, 28px);
    background: var(--surface-subtle);
    box-shadow: var(--shadow-md);
  }

  .harness-hero-visual img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: contain;
  }

  .harness-hero-caption {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--border-subtle);
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .project-anchor {
    scroll-margin-top: calc(var(--header-height) + 64px);
  }

  @media (max-width: 640px) {
    .harness-hero-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
