---
/**
 * android-local-llm-harness.astro
 * Experiment / measurement deep-dive using the shared project-page journey.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import ProjectPhase from '../components/project/ProjectPhase.astro';
import ProjectDecisionBand from '../components/project/ProjectDecisionBand.astro';
import HarnessHero from '../components/harness/HarnessHero.astro';
import HarnessMission from '../components/harness/HarnessMission.astro';
import HarnessProblems from '../components/harness/HarnessProblems.astro';
import HarnessConcept from '../components/harness/HarnessConcept.astro';
import HarnessSurfaces from '../components/harness/HarnessSurfaces.astro';
import HarnessArchitecture from '../components/harness/HarnessArchitecture.astro';
import HarnessValues from '../components/harness/HarnessValues.astro';
import HarnessRoadmap from '../components/harness/HarnessRoadmap.astro';
import HarnessCodePreview from '../components/harness/HarnessCodePreview.astro';
import HarnessMaturity from '../components/harness/HarnessMaturity.astro';
import HarnessCta from '../components/harness/HarnessCta.astro';

import { harnessData } from '../content/harness';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Decide', href: '#decide' },
  { label: 'Build', href: '#build' },
  { label: 'Test', href: '#test' },
  { label: 'Measure', href: '#measure' },
  { label: 'Decide again', href: '#decide-again' },
];

const harnessSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Android Local LLM Harness",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Android",
  "description": harnessData.meta.description,
  "author": {
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": "https://daniele21.github.io/"
  },
  "codeRepository": "https://github.com/daniele21/android-local-llm-harness"
};
---

<BaseLayout
  title={harnessData.meta.title}
  description={harnessData.meta.description}
  jsonLd={harnessSchema}
>
  <ProductSubHeader
    title="Android LLM Harness"
    badge="Spec & Prototype"
    logoPath="images/harness/logo.svg"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: 'https://github.com/daniele21/android-local-llm-harness' }}
    underSiteHeader={true}
  />

  <div id="top" data-project-page data-project-archetype="experiment">
    <HarnessHero baseUrl={baseUrl} />

    <ProjectPhase
      id="decide"
      step="01"
      label="DECIDE"
      title="Why does Android need a reusable local AI layer?"
      description="Start from the structural friction: duplicated runtimes, memory ownership, IPC and observability. The project only earns complexity if those constraints justify a shared gateway."
    >
      <HarnessMission />
      <HarnessProblems />
    </ProjectPhase>

    <ProjectPhase
      id="build"
      step="02"
      label="BUILD"
      title="Turn the gateway idea into explicit system boundaries."
      description="Move from the concept to the concrete architecture and developer contract: model repository, runtime orchestration, replaceable backend boundaries and a deliberately small client API."
      tone="subtle"
    >
      <HarnessConcept />
      <HarnessArchitecture baseUrl={baseUrl} />
      <HarnessCodePreview />
    </ProjectPhase>

    <ProjectPhase
      id="test"
      step="03"
      label="TEST"
      title="Make the infrastructure survive a real mobile workflow."
      description="The connected console is the test bed: model management, prompting, cancellation, diagnostics and settings expose whether the runtime behaves like a product rather than a demo."
    >
      <HarnessSurfaces baseUrl={baseUrl} />
    </ProjectPhase>

    <ProjectPhase
      id="measure"
      step="04"
      label="MEASURE"
      title="Separate integrated capability from production evidence."
      description="Treat maturity and missing physical-device validation as evidence boundaries. What is integrated today is shown separately from what still blocks stronger performance or production claims."
      tone="subtle"
    >
      <HarnessMaturity />
    </ProjectPhase>

    <ProjectPhase
      id="decide-again"
      step="05"
      label="DECIDE AGAIN"
      title="Use the evidence to decide what moves next."
      description="The current direction is not to jump straight to a multi-app gateway. First stabilize the data plane and client boundary; then move ownership behind Binder/AIDL when representative device evidence supports it."
    >
      <ProjectDecisionBand
        title="Keep proving the data plane before moving runtime ownership cross-app."
        body="Harness already integrates the embedded inference path, model lifecycle, console surfaces and diagnostics. The shared Binder/AIDL gateway remains the target architecture, while representative physical-device memory and thermal validation still block production claims."
        signals={[
          'Embedded console + runtime foundation integrated',
          'Cross-app Binder/AIDL host remains future work',
          'Physical-device memory and thermal evidence still required',
        ]}
      />
      <HarnessValues />
      <HarnessRoadmap />
    </ProjectPhase>

    <HarnessCta baseUrl={baseUrl} />
  </div>
</BaseLayout>
