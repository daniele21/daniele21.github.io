---
import BaseLayout from '../layouts/BaseLayout.astro';
import HarnessHeader from '../components/harness/HarnessHeader.astro';
import ProductSubHeader from '../components/layout/ProductSubHeader.astro';
import HarnessShowcaseLanding from '../components/harness/HarnessShowcaseLanding.astro';
import { harnessData } from '../content/harness';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

const subheaderLinks = [
  { label: 'Overview', href: '#top' },
  { label: 'Evidence', href: '#evidence' },
  { label: 'Workflow', href: '#workflow' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Why Harness', href: '#why' },
];

const harnessSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Android Local LLM Harness',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Android',
  description: harnessData.meta.description,
  author: {
    '@type': 'Person',
    name: 'Daniele Moltisanti',
    url: 'https://daniele21.github.io/',
  },
  codeRepository: 'https://github.com/daniele21/android-local-llm-harness',
};
---

<BaseLayout
  title="Android Local LLM Harness — On-device LLM evidence"
  description="Android Local LLM Harness is a testbed for GGUF and llama.cpp inference on Android: run local models, inspect latency and diagnostics, and evaluate what is viable on-device."
  jsonLd={harnessSchema}
>
  <HarnessHeader baseUrl={baseUrl} slot="header" />

  <ProductSubHeader
    title="Android Harness"
    badge="Local AI Lab"
    links={subheaderLinks}
    cta={{ label: 'GitHub ↗', href: 'https://github.com/daniele21/android-local-llm-harness' }}
  />

  <HarnessShowcaseLanding />
</BaseLayout>