---
/**
 * BaseLayout - Root layout for all pages.
 * Manages document metadata, global styles, structured data, and shared header/footer.
 */
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ImageZoomModal from '../components/common/ImageZoomModal.astro';
import { siteMetadata } from '../content/site';

import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/layout.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
} = Astro.props;

/**
 * Preview environments (dev/, pr-preview/) set ASTRO_BASE environment variable.
 * Only production builds (without ASTRO_BASE) are indexed by search engines.
 */
const isPreview = !!import.meta.env.ASTRO_BASE;
const robotsContent = isPreview
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f7f9ff">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content={robotsContent}>
  <link rel="canonical" href={siteMetadata.canonical}>
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} type="image/png">
  <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`}>
  <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`}>

  <!-- Google Fonts: Plus Jakarta Sans & Inter (Modern Sans-Serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <!-- Anti-flash inline theme initialization -->
  <script is:inline>
    (function () {
      try {
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  <!-- Open Graph & Social Cards -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={siteMetadata.socialTitle}>
  <meta property="og:description" content={siteMetadata.socialDescription}>
  <meta property="og:url" content={siteMetadata.canonical}>
  <meta property="og:image" content={siteMetadata.ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={siteMetadata.socialDescription}>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Daniele Moltisanti",
    "url": siteMetadata.canonical,
    "image": `${siteMetadata.canonical}images/profile-photo.jpg`,
    "sameAs": [
      "https://github.com/daniele21",
      "https://www.linkedin.com/in/daniele-moltisanti/",
      "https://staituned.com"
    ],
    "knowsAbout": [
      "Local AI", "On-device inference", "Privacy-first product design",
      "Large language models", "Speech recognition", "Android AI"
    ]
  })} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot name="header">
    <SiteHeader />
  </slot>
  <main id="main">
    <slot />
  </main>
  <slot name="footer">
    <SiteFooter />
  </slot>
  <ImageZoomModal />
  <script src="../scripts/site.ts"></script>
</body>
</html>
