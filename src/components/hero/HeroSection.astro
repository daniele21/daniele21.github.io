---
/**
 * HeroSection - Primary top section matching target design reference.
 */
import EcosystemMap from './EcosystemMap.astro';
import { getContent } from '../../content';

const { hero } = getContent().home;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy reveal">
      <div class="eyebrow-pill">{hero.eyebrow}</div>
      <h1 id="hero-title">
        {hero.titlePrefix}<br />
        for <span class="blue-text">{hero.titleHighlight}</span>{hero.titleSuffix}
      </h1>
      <p class="hero-lede">
        I explore how <strong>local-first architectures can give AI products more control</strong> over model lifecycle, costs, data, and runtime,  without giving up frontier models where they still make sense.
      </p>
      <p class="hero-lede-detail">
        <strong>Closed models should be an option, not a dependency.</strong>
        {hero.ledeDetail.replace(/^Closed models should be an option, not a dependency\.\s*/, '')}
      </p>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href={hero.primaryActionHref}>{hero.primaryActionLabel} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={hero.secondaryActionHref}>{hero.secondaryActionLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-visual">
      <EcosystemMap />
    </div>
  </div>
</section>


<style>
  .hero {
    padding: clamp(40px, 5vw, 80px) 0 60px;
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 3.5vw, 56px);
  }

  .hero-copy {
    max-width: 560px;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface-blue);
    color: var(--accent-blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.08);
    animation: pill-glow 4s infinite ease-in-out;
  }

  @keyframes pill-glow {
    0%, 100% { box-shadow: 0 2px 10px rgba(37, 99, 235, 0.08); }
    50% { box-shadow: 0 4px 18px rgba(37, 99, 235, 0.22); }
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--ink);
  }

  .blue-text {
    color: var(--accent-blue);
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lede {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .hero-lede-detail {
    margin: var(--space-2) 0 0;
    color: var(--ink-subtle);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease;
    cursor: pointer;
    border: none;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button:active {
    transform: translateY(-1px);
  }

  .button-primary {
    color: #ffffff;
    background: linear-gradient(135deg, var(--accent-blue-dark), var(--accent-blue));
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.28);
  }

  .button-primary::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -60%;
    width: 40%;
    height: 200%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    transform: rotate(25deg);
    transition: left 600ms var(--ease-out-expo);
  }

  .button-primary:hover::after {
    left: 130%;
  }

  .button-primary:hover {
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.38);
  }

  .button-secondary {
    color: var(--ink);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
  }

  .button-secondary:hover {
    background: var(--surface-muted);
    border-color: var(--border-strong);
    color: var(--accent-blue);
    box-shadow: var(--shadow-sm);
  }


  @media (max-width: 1040px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-copy {
      max-width: 100%;
    }
  }

  @media (max-width: 580px) {
    .hero { padding-top: 24px; padding-bottom: 24px; }
    .hero h1 br { display: none; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .button { width: 100%; }
  }
</style>


