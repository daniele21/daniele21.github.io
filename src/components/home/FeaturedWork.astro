---
import { featuredProjects } from '../../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
}

const main = featuredProjects.main;
const stack = featuredProjects.stack;
const more = featuredProjects.more;
---

<section class="section work-section" id="work" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-head">
      <div>
        <span class="kicker">FEATURED WORK</span>
        <h2 id="work-title">Building the local AI stack.</h2>
      </div>
      <p>
        Infrastructure, runtimes and applications built to test and prove on-device AI in real products.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="bento-grid">
      <!-- Main Featured: Android Harness -->
      <a class="bento-card bento-main" href={getHref(main.href)}>
        <div class="main-preview">
          {main.splitImages ? (
            <div class="split-shots">
              {main.splitImages.map((shot) => (
                <div class="split-shot">
                  <span class="split-tag">{shot.tag}</span>
                  <img
                    src={`${baseUrl}/${shot.src.replace(/^\//, '')}`}
                    alt={shot.alt}
                    loading="lazy"
                    width="260"
                    height="380"
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="main-single-img">
              <img
                src={`${baseUrl}/${main.image?.replace(/^\//, '')}`}
                alt={main.imageAlt || main.title}
                loading="lazy"
              />
            </div>
          )}
        </div>

        <div class="bento-content bento-content-dark">
          <div class="bento-meta">
            <span class="bento-eyebrow">{main.eyebrow}</span>
          </div>
          <h3>{main.title}</h3>
          <p class="bento-question">{main.question}</p>
          <p class="bento-desc">{main.description}</p>
          <div class="bento-footer">
            <span class="bento-link-text">Explore project <span aria-hidden="true">→</span></span>
          </div>
        </div>
      </a>

      <!-- Stack: Server & ClosedRoom -->
      <div class="bento-stack">
        {stack.map((item) => (
          <a class="bento-card bento-side" href={getHref(item.href)}>
            {item.image && (
              <div class="side-img-wrapper">
                <img
                  src={`${baseUrl}/${item.image.replace(/^\//, '')}`}
                  alt={item.imageAlt || item.title}
                  loading="lazy"
                  width="480"
                  height="260"
                />
                <div class="side-overlay"></div>
              </div>
            )}
            <div class="bento-content">
              <span class="bento-eyebrow">{item.eyebrow}</span>
              <h3>{item.title}</h3>
              <p class="bento-question">{item.question}</p>
              <p class="bento-desc">{item.description}</p>
              <div class="bento-footer">
                <span class="bento-link-text">Explore <span aria-hidden="true">→</span></span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Secondary Work Row -->
    <div class="secondary-work">
      {more.map((item) => (
        <a class="secondary-card" href={getHref(item.href)}>
          <div class="secondary-info">
            <span class="secondary-title">{item.title}</span>
            <p class="secondary-desc">{item.description}</p>
          </div>
          <span class="secondary-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work-section {
    background: linear-gradient(180deg, transparent, var(--surface-muted) 8%, var(--surface-muted) 92%, transparent);
    padding: clamp(56px, 7vw, 100px) 0;
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 440px);
    gap: 28px;
    align-items: end;
    margin-bottom: clamp(32px, 4.5vw, 48px);
  }

  .kicker {
    display: inline-block;
    color: #7557ff;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  [data-theme="dark"] .kicker {
    color: #a78bfa;
  }

  .section-head h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .section-head > p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: 20px;
  }

  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: 26px;
    background: var(--surface-card);
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .bento-card:hover {
    transform: translateY(-4px);
    border-color: rgba(117, 87, 255, 0.4);
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.12);
  }

  [data-theme="dark"] .bento-card:hover {
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
  }

  /* Main Card: Android Harness */
  .bento-main {
    background: linear-gradient(165deg, #070c18, #0d152c);
    border-color: rgba(255, 255, 255, 0.1);
    justify-content: space-between;
    padding: clamp(20px, 3vw, 28px);
    min-height: 560px;
  }

  .main-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 20px;
  }

  .split-shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 520px;
  }

  .split-shot {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #090e1c;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .split-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(10, 15, 29, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #a78bfa;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .split-shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  .bento-main:hover .split-shot:first-child {
    transform: translateY(-3px) rotate(-0.5deg);
    border-color: rgba(117, 87, 255, 0.5);
  }

  .bento-main:hover .split-shot:last-child {
    transform: translateY(-3px) rotate(0.5deg);
    border-color: rgba(117, 87, 255, 0.5);
  }

  /* Stack Side */
  .bento-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bento-side {
    position: relative;
    min-height: 270px;
    justify-content: flex-end;
    padding: 24px;
  }

  .side-img-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .side-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .bento-side:hover .side-img-wrapper img {
    transform: scale(1.03);
  }

  .side-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 13, 26, 0.2) 0%, rgba(8, 13, 26, 0.85) 60%, rgba(8, 13, 26, 0.98) 100%);
  }

  /* Bento Content Typography */
  .bento-content {
    position: relative;
    z-index: 2;
  }

  .bento-content-dark,
  .bento-side .bento-content {
    color: #ffffff;
  }

  .bento-eyebrow {
    display: inline-block;
    color: #a78bfa;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bento-content h3 {
    margin: 8px 0 4px;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    letter-spacing: -0.03em;
    font-weight: 750;
  }

  .bento-question {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .bento-desc {
    margin: 6px 0 0;
    color: rgba(203, 213, 225, 0.8);
    font-size: 0.84rem;
    line-height: 1.45;
    max-width: 480px;
  }

  .bento-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 14px;
  }

  .bento-link-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #a78bfa;
    font-size: 0.82rem;
    font-weight: 750;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .bento-card:hover .bento-link-text {
    transform: translateX(3px);
    color: #c4b5fd;
  }

  /* Secondary Row */
  .secondary-work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .secondary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 22px;
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    background: var(--surface-card);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .secondary-card:hover {
    transform: translateY(-2px);
    border-color: rgba(117, 87, 255, 0.35);
    box-shadow: var(--shadow-sm);
  }

  .secondary-title {
    display: block;
    color: #7557ff;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-theme="dark"] .secondary-title {
    color: #a78bfa;
  }

  .secondary-desc {
    margin: 4px 0 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .secondary-arrow {
    color: var(--ink-subtle);
    font-size: 1.1rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .secondary-card:hover .secondary-arrow {
    transform: translateX(3px);
    color: #7557ff;
  }

  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .bento-main {
      min-height: auto;
    }
    .secondary-work {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .split-shots {
      gap: 8px;
    }
    .split-tag {
      font-size: 0.55rem;
      padding: 2px 5px;
    }
    .bento-side {
      min-height: 240px;
      padding: 18px;
    }
    .secondary-card {
      padding: 14px 16px;
    }
  }
</style>
