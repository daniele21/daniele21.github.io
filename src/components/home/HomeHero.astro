---
import { heroData } from '../../content';
import GitHubIcon from '../icons/GitHubIcon.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
}

const proofHref = getHref(heroData.proofCard.href);
const proofImgSrc = `${baseUrl}/${heroData.proofCard.image.replace(/^\//, '')}`;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-badge">{heroData.eyebrow}</span>
      </div>

      <h1 id="hero-title">
        {heroData.titlePrefix}<span>{heroData.titleHighlight}</span>
      </h1>

      <p class="hero-lede">
        {heroData.lede}
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={heroData.primaryAction.href}>
          {heroData.primaryAction.label} <span aria-hidden="true">→</span>
        </a>
        <a
          class="button button-ghost button-icon-only"
          href="https://github.com/daniele21"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <GitHubIcon size={20} />
        </a>
        <a
          class="button button-ghost button-icon-only"
          href={heroData.linkedinAction.href}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <LinkedInIcon size={20} />
        </a>
      </div>

      <div class="hero-current">
        <span class="live-dot" aria-hidden="true"></span>
        <span>
          <strong>{heroData.currentExperiment.label}</strong> {heroData.currentExperiment.text}
        </span>
      </div>
    </div>

    <a
      class="hero-proof-card"
      href={proofHref}
      aria-label="Explore Android Local LLM Harness experiment"
    >
      <div class="proof-header">
        <div class="proof-tag">
          <span class="proof-dot"></span>
          <span>{heroData.proofCard.tag}</span>
        </div>
        <span class="proof-sub">Single run</span>
      </div>

      <div class="proof-screen">
        <img
          src={proofImgSrc}
          alt={heroData.proofCard.alt}
          width="720"
          height="450"
          loading="eager"
        />
      </div>

      <div class="proof-metrics-bar">
        {heroData.proofCard.metrics.map((m, idx) => (
          <div class="proof-metric-item" class:list={{ 'is-primary': idx === 1 }}>
            <strong>{m.value}</strong>
            <span>{m.label}</span>
          </div>
        ))}
      </div>
    </a>
  </div>
</section>

<style>
  .hero {
    padding: clamp(48px, 6.5vw, 90px) 0 clamp(54px, 7vw, 96px);
    position: relative;
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 420px);
    gap: clamp(36px, 5vw, 76px);
    align-items: center;
    justify-content: space-between;
  }

  .hero-copy {
    max-width: 680px;
  }

  .hero-eyebrow {
    margin-bottom: clamp(16px, 2.5vw, 24px);
  }

  .hero-eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(117, 87, 255, 0.08);
    border: 1px solid rgba(117, 87, 255, 0.22);
    color: #7557ff;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  [data-theme="dark"] .hero-eyebrow-badge {
    background: rgba(139, 92, 246, 0.12);
    border-color: rgba(139, 92, 246, 0.32);
    color: #a78bfa;
  }

  .hero h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.2vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 800;
  }

  .hero h1 span {
    color: #7557ff;
    display: inline-block;
  }

  [data-theme="dark"] .hero h1 span {
    color: #9d8cff;
  }

  .hero-lede {
    max-width: 580px;
    margin: clamp(18px, 2.5vw, 26px) 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.05rem, 1.35vw, 1.22rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: clamp(24px, 3.5vw, 34px);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease, background var(--duration-fast) ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: #ffffff;
    background: #7557ff;
    box-shadow: 0 8px 24px rgba(117, 87, 255, 0.28);
  }

  .button-primary:hover {
    background: #6343f5;
    box-shadow: 0 12px 30px rgba(117, 87, 255, 0.38);
  }

  .button-ghost {
    color: var(--ink);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
  }

  .button-ghost:hover {
    border-color: var(--accent-blue-light);
    color: var(--accent-blue);
  }

  .button.button-icon-only {
    width: 46px;
    height: 46px;
    padding: 0;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-current {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    color: var(--ink-subtle);
    font-size: 0.82rem;
  }

  .hero-current strong {
    color: var(--ink);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #2dd4bf;
    box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.16);
  }

  /* Hero Proof Composition */
  .hero-proof-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 420px;
    justify-self: end;
    padding: 14px;
    border: 1px solid var(--border-subtle);
    border-radius: 26px;
    background: linear-gradient(155deg, var(--surface-card), rgba(117, 87, 255, 0.05));
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  [data-theme="dark"] .hero-proof-card {
    background: linear-gradient(155deg, rgba(17, 24, 39, 0.95), rgba(117, 87, 255, 0.1));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    border-color: rgba(148, 163, 184, 0.18);
  }

  .hero-proof-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 75px rgba(117, 87, 255, 0.18);
    border-color: rgba(117, 87, 255, 0.35);
  }

  .proof-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px 10px;
  }

  .proof-tag {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #7557ff;
    font-size: 0.69rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  [data-theme="dark"] .proof-tag {
    color: #a78bfa;
  }

  .proof-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2dd4bf;
    box-shadow: 0 0 6px #2dd4bf;
  }

  .proof-sub {
    color: var(--ink-subtle);
    font-size: 0.72rem;
  }

  .proof-screen {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: #080d18;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .proof-screen img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .proof-metrics-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 10px;
    padding: 10px 8px 4px;
    border-top: 1px solid var(--border-subtle);
  }

  .proof-metric-item {
    text-align: center;
  }

  .proof-metric-item strong {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.1;
  }

  .proof-metric-item.is-primary strong {
    color: #7557ff;
  }

  [data-theme="dark"] .proof-metric-item.is-primary strong {
    color: #a78bfa;
  }

  .proof-metric-item span {
    display: block;
    margin-top: 2px;
    color: var(--ink-subtle);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-proof-card {
      max-width: 440px;
      margin: 0 auto;
      justify-self: center;
    }
  }

  @media (max-width: 580px) {
    .hero {
      padding: 36px 0 44px;
    }
    .hero h1 {
      font-size: clamp(2.4rem, 11vw, 3.4rem);
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .button {
      width: 100%;
    }
    .hero-proof-card {
      max-width: 100%;
      padding: 10px;
      border-radius: 22px;
    }
  }
</style>
