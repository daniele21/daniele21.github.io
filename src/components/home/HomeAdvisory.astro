---
import { advisoryData } from '../../content';
---

<section class="section advisory-section" id="advisory" aria-labelledby="advisory-title">
  <div class="shell">
    <div class="advisory-card">
      <div class="advisory-copy">
        <span class="advisory-kicker">{advisoryData.kicker}</span>
        <h2 id="advisory-title">{advisoryData.title}</h2>
        <p>{advisoryData.description}</p>
      </div>

      <div class="advisory-action">
        <a class="button advisory-btn" href={advisoryData.cta.href}>
          {advisoryData.cta.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .advisory-section {
    padding: clamp(48px, 6vw, 84px) 0 clamp(64px, 8vw, 108px);
  }

  .advisory-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;
    padding: clamp(32px, 5vw, 54px);
    border-radius: 30px;
    background: linear-gradient(145deg, #090e1c, #111a36);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 64px rgba(15, 23, 42, 0.25);
  }

  .advisory-kicker {
    display: inline-block;
    color: #a78bfa;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .advisory-copy h2 {
    margin: 8px 0 0;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .advisory-copy p {
    max-width: 620px;
    margin: 14px 0 0;
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .advisory-action {
    display: flex;
    justify-content: flex-end;
  }

  .advisory-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 50px;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 750;
    color: #090e1c;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .advisory-btn:hover {
    transform: translateY(-2px);
    background: #f1f5f9;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 860px) {
    .advisory-card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 32px 24px;
    }
    .advisory-action {
      justify-content: flex-start;
    }
    .advisory-btn {
      width: 100%;
    }
  }
</style>
