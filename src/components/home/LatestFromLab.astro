---
import { latestLab } from '../../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
}
---

<section class="section latest-section" id="latest" aria-labelledby="latest-title">
  <div class="shell">
    <div class="section-head">
      <div>
        <span class="kicker">LATEST FROM THE LAB</span>
        <h2 id="latest-title">What I'm working on now.</h2>
      </div>
      <p>
        Recent experiments, engineering notes and architectural findings from the workbench.
      </p>
    </div>

    <div class="latest-table" role="list">
      {latestLab.map((item) => (
        <a class="latest-row" href={getHref(item.href)} role="listitem">
          <div class="latest-time-cell">
            <time class="latest-date">{item.date}</time>
            {item.year && <span class="latest-year">{item.year}</span>}
          </div>

          <div class="latest-badge-cell">
            <span class={`type-badge badge-${item.type.toLowerCase().replace(/\s+/g, '-')}`}>
              {item.type}
            </span>
          </div>

          <div class="latest-title-cell">
            <h3 class="latest-item-title">{item.title}</h3>
            {item.tags && item.tags.length > 0 && (
              <div class="latest-tags">
                {item.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            )}
          </div>

          <div class="latest-arrow-cell" aria-hidden="true">
            <span class="latest-arrow">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .latest-section {
    padding: clamp(54px, 7vw, 96px) 0;
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 440px);
    gap: 28px;
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .kicker {
    display: inline-block;
    color: #7557ff;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  [data-theme="dark"] .kicker {
    color: #a78bfa;
  }

  .section-head h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .section-head > p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  /* Editorial Table List */
  .latest-table {
    border-top: 1px solid var(--border-subtle);
  }

  .latest-row {
    display: grid;
    grid-template-columns: 110px 140px minmax(0, 1fr) 40px;
    align-items: center;
    gap: 20px;
    padding: 22px 16px;
    border-bottom: 1px solid var(--border-subtle);
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .latest-row:hover {
    background: var(--surface-muted);
    transform: translateX(4px);
  }

  .latest-time-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .latest-date {
    color: #7557ff;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  [data-theme="dark"] .latest-date {
    color: #a78bfa;
  }

  .latest-year {
    color: var(--ink-subtle);
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }

  .latest-badge-cell {
    display: flex;
    align-items: center;
  }

  .type-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink-muted);
  }

  .badge-experiment {
    background: rgba(117, 87, 255, 0.08);
    border-color: rgba(117, 87, 255, 0.25);
    color: #7557ff;
  }

  [data-theme="dark"] .badge-experiment {
    background: rgba(167, 139, 250, 0.12);
    border-color: rgba(167, 139, 250, 0.3);
    color: #c4b5fd;
  }

  .badge-deep-dive {
    background: rgba(13, 148, 136, 0.08);
    border-color: rgba(13, 148, 136, 0.25);
    color: #0d9488;
  }

  [data-theme="dark"] .badge-deep-dive {
    background: rgba(45, 212, 191, 0.12);
    border-color: rgba(45, 212, 191, 0.3);
    color: #5eead4;
  }

  .badge-architecture {
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.25);
    color: #2563eb;
  }

  [data-theme="dark"] .badge-architecture {
    background: rgba(96, 165, 250, 0.12);
    border-color: rgba(96, 165, 250, 0.3);
    color: #93c5fd;
  }

  .latest-title-cell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .latest-item-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .latest-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-pill {
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink-subtle);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .latest-arrow-cell {
    text-align: right;
  }

  .latest-arrow {
    color: var(--ink-subtle);
    font-size: 1.2rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .latest-row:hover .latest-arrow {
    transform: translateX(4px);
    color: #7557ff;
  }

  [data-theme="dark"] .latest-row:hover .latest-arrow {
    color: #a78bfa;
  }

  @media (max-width: 820px) {
    .latest-row {
      grid-template-columns: 80px 1fr 30px;
      gap: 12px;
      padding: 16px 10px;
    }
    .latest-badge-cell {
      grid-column: 2;
      grid-row: 1;
    }
    .latest-title-cell {
      grid-column: 1 / 3;
      grid-row: 2;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .latest-arrow-cell {
      grid-column: 3;
      grid-row: 1 / 3;
      align-self: center;
    }
  }
</style>
