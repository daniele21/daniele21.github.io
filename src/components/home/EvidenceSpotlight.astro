---
import { evidenceSpotlight } from '../../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getHref(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
}
---

<section class="section evidence-section" id="evidence" aria-labelledby="evidence-title">
  <div class="shell evidence-grid">
    <div class="evidence-intro">
      <span class="kicker">{evidenceSpotlight.kicker}</span>
      <h2 id="evidence-title">
        {evidenceSpotlight.titlePrefix}<span>{evidenceSpotlight.titleHighlight}</span>
      </h2>
      <p class="evidence-subtitle">
        {evidenceSpotlight.subtitle}
      </p>
      <a class="text-link" href={getHref(evidenceSpotlight.cta.href)}>
        {evidenceSpotlight.cta.label}
      </a>
    </div>

    <div class="evidence-board">
      <div class="metrics-grid">
        {evidenceSpotlight.metrics.map((m) => (
          <div class="metric-card" class:list={{ 'is-highlight': m.highlight }}>
            <div class="metric-head">
              <span class="metric-label">{m.label}</span>
            </div>
            <div class="metric-value-wrap">
              <strong>{m.value}</strong>
              <span class="metric-unit">{m.unit}</span>
            </div>
            <p class="metric-desc">{m.description}</p>
          </div>
        ))}
      </div>
      <div class="evidence-note">
        <small>{evidenceSpotlight.note}</small>
      </div>
    </div>
  </div>
</section>

<style>
  .evidence-section {
    padding: clamp(56px, 7vw, 96px) 0;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(36px, 6vw, 76px);
    align-items: center;
  }

  .evidence-intro {
    max-width: 480px;
  }

  .kicker {
    display: inline-block;
    color: #7557ff;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  [data-theme="dark"] .kicker {
    color: #a78bfa;
  }

  .evidence-intro h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .evidence-intro h2 span {
    color: #7557ff;
    display: inline-block;
  }

  [data-theme="dark"] .evidence-intro h2 span {
    color: #9d8cff;
  }

  .evidence-subtitle {
    margin: 16px 0 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: #7557ff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 750;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  [data-theme="dark"] .text-link {
    color: #a78bfa;
  }

  .text-link:hover {
    transform: translateX(4px);
    color: #5b3ce6;
  }

  /* Evidence Board */
  .evidence-board {
    padding: 18px;
    border: 1px solid var(--border-subtle);
    border-radius: 28px;
    background: linear-gradient(150deg, var(--surface-muted), var(--surface-card));
    box-shadow: 0 16px 44px rgba(15, 23, 42, 0.06);
  }

  [data-theme="dark"] .evidence-board {
    background: linear-gradient(150deg, rgba(19, 27, 46, 0.85), rgba(17, 24, 39, 0.95));
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    border-color: rgba(148, 163, 184, 0.16);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .metric-card {
    padding: 22px 18px;
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    background: var(--surface-card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 155px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .metric-card:hover {
    transform: translateY(-2px);
    border-color: rgba(117, 87, 255, 0.3);
  }

  .metric-card.is-highlight {
    background: linear-gradient(145deg, rgba(117, 87, 255, 0.09), var(--surface-card));
    border-color: rgba(117, 87, 255, 0.28);
  }

  [data-theme="dark"] .metric-card.is-highlight {
    background: linear-gradient(145deg, rgba(117, 87, 255, 0.16), rgba(17, 24, 39, 0.95));
    border-color: rgba(167, 139, 250, 0.35);
  }

  .metric-label {
    color: var(--ink-subtle);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .metric-card.is-highlight .metric-label {
    color: #7557ff;
  }

  [data-theme="dark"] .metric-card.is-highlight .metric-label {
    color: #a78bfa;
  }

  .metric-value-wrap {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin: 10px 0 6px;
  }

  .metric-value-wrap strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .metric-card.is-highlight strong {
    color: #7557ff;
  }

  [data-theme="dark"] .metric-card.is-highlight strong {
    color: #a78bfa;
  }

  .metric-unit {
    color: var(--ink-subtle);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .metric-desc {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .evidence-note {
    padding: 12px 8px 4px;
    color: var(--ink-subtle);
    font-size: 0.73rem;
    text-align: center;
    line-height: 1.45;
  }

  @media (max-width: 980px) {
    .evidence-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 680px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
    .metric-card {
      min-height: auto;
    }
  }
</style>
