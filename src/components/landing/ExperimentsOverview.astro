---
import { portfolioNarrative } from '../../content/portfolio';

const { experiments } = portfolioNarrative;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => href.startsWith('http') ? href : `${baseUrl}/${href.replace(/^\//, '')}`;
const featured = experiments.tracks.filter((track) => track.status !== 'Planned').slice(0, 3);
---

<div class="experiments-overview">
  <div class="aggregate-grid" aria-label="Experiments aggregate status">
    {experiments.aggregates.map((item) => (
      <div class="aggregate-card">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </div>
    ))}
  </div>

  <p class="aggregate-note">{experiments.note}</p>

  <div class="experiments-layout">
    <div class="tracks-panel">
      <div class="panel-heading">
        <span>ACTIVE EVIDENCE</span>
        <strong>From benchmark harness to architecture decision.</strong>
      </div>

      <div class="track-list">
        {featured.map((track, index) => (
          <article class="track-row">
            <div class="track-index">0{index + 1}</div>
            <div class="track-copy">
              <div class="track-title-line">
                <h3>{track.name}</h3>
                <span>{track.status}</span>
              </div>
              <p>{track.question}</p>
              <div class="track-so-what">
                <strong>SO WHAT</strong>
                <span>{track.soWhat}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <aside class="evidence-changes">
      <span class="aside-kicker">WHAT THE EVIDENCE CHANGES</span>
      <h3>Measurement is only useful if it changes the next decision.</h3>

      <div class="change-list">
        {featured.map((track) => (
          <div class="change-item">
            <strong>{track.name}</strong>
            <p>{track.changed}</p>
          </div>
        ))}
      </div>

      <a class="experiments-cta" href={resolveHref(experiments.href)}>
        Explore all experiments <span aria-hidden="true">→</span>
      </a>
    </aside>
  </div>

  <div class="evidence-loop" aria-label="Evidence loop">
    <span>QUESTION</span><b>→</b>
    <span>EXPERIMENT</span><b>→</b>
    <span>EVIDENCE</span><b>→</b>
    <span>INSIGHT</span><b>→</b>
    <span>DECISION</span>
  </div>
</div>

<style>
  .experiments-overview { display: flex; flex-direction: column; gap: 18px; }

  .aggregate-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .aggregate-card {
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .aggregate-card strong {
    display: block;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  .aggregate-card span {
    display: block;
    margin-top: 5px;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .aggregate-note {
    margin: -6px 0 0;
    color: var(--ink-subtle);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .experiments-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr);
    gap: 14px;
  }

  .tracks-panel,
  .evidence-changes {
    border: 1px solid var(--border-medium);
    border-radius: 18px;
    background: var(--surface-card);
    overflow: hidden;
  }

  .panel-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
  }

  .panel-heading > span,
  .aside-kicker {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 850;
    letter-spacing: .08em;
  }

  .panel-heading strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  .track-list { display: flex; flex-direction: column; }

  .track-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 10px;
    padding: 16px 18px;
  }

  .track-row + .track-row { border-top: 1px solid var(--border-subtle); }

  .track-index {
    padding-top: 3px;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 820;
  }

  .track-copy { min-width: 0; }

  .track-title-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .track-title-line h3 {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .track-title-line > span {
    flex: 0 0 auto;
    padding: 4px 7px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .track-copy > p {
    margin: 6px 0 0;
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .track-so-what {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px;
    margin-top: 10px;
    padding-top: 9px;
    border-top: 1px dashed var(--border-subtle);
  }

  .track-so-what strong {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: .07em;
  }

  .track-so-what span {
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.42;
  }

  .evidence-changes {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent-blue) 9%, transparent), transparent 42%),
      var(--surface-card);
  }

  .evidence-changes h3 {
    margin: 8px 0 18px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.15;
    letter-spacing: -.035em;
  }

  .change-list {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .change-item {
    padding-left: 12px;
    border-left: 2px solid color-mix(in srgb, var(--accent-blue) 55%, var(--border-medium));
  }

  .change-item strong {
    color: var(--ink-display);
    font-size: 0.875rem;
  }

  .change-item p {
    margin: 4px 0 0;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .experiments-cta {
    margin-top: auto;
    padding-top: 20px;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 780;
    text-decoration: none;
  }

  .evidence-loop {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px 10px;
    padding: 12px 14px;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    background: var(--surface-subtle);
  }

  .evidence-loop span {
    color: var(--ink-display);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 830;
    letter-spacing: .05em;
  }

  .evidence-loop b { color: var(--accent-blue); }

  @media (max-width: 980px) {
    .aggregate-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aggregate-card:last-child { grid-column: 1 / -1; }
    .experiments-layout { grid-template-columns: 1fr; }
    .experiments-cta { margin-top: 18px; }
  }

  @media (max-width: 600px) {
    .aggregate-grid { grid-template-columns: 1fr 1fr; }
    .track-title-line { align-items: flex-start; flex-direction: column; }
    .track-so-what { grid-template-columns: 1fr; }
    .panel-heading { align-items: flex-start; flex-direction: column; gap: 4px; }
  }

  /* MOBILE-FIRST EXPERIMENTS */
  @media (max-width: 600px) {
    .experiments-overview { gap: 12px; }

    .aggregate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .aggregate-card {
      padding: 12px;
      border-radius: 12px;
    }

    .aggregate-card strong {
      font-size: 1.18rem;
      line-height: 1.12;
    }

    .aggregate-card span {
      margin-top: 4px;
      line-height: 1.3;
    }

    .aggregate-card:last-child { grid-column: 1 / -1; }

    .experiments-layout { gap: 10px; }

    .tracks-panel,
    .evidence-changes { border-radius: 15px; }

    .panel-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
      padding: 14px;
    }

    .track-row {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 8px;
      padding: 14px;
    }

    .track-title-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .track-so-what {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .evidence-changes { padding: 16px; }

    .evidence-loop {
      justify-content: center;
      flex-wrap: wrap;
    }

    .experiments-cta {
      display: flex;
      min-height: 50px;
      align-items: center;
      padding-top: 14px;
    }
  }

</style>
