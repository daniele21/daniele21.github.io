---
/**
 * ProjectProofCard.astro
 * Semantic proof card with tailored anatomies for Proof (Applications) and Evidence.
 * Strictly adheres to 14px minimum meaningful font size and aligns with the Build layer style.
 */
import type { ProjectCardFeature } from '../../types/landing';
import PlaneCard from './PlaneCard.astro';

interface Props {
  plane?: string;
  variant?: 'execution' | 'proof' | 'evidence' | 'compact';
  tag?: string;
  eyebrow?: string;
  title: string;
  description: string;
  href: string;
  logoPath?: string;
  logoAlt?: string;
  imagePath?: string;
  imageAlt?: string;
  tone?: 'red' | 'purple' | 'blue' | 'green';
  symbol?: 'audio' | 'performance' | 'boundary' | 'feedback';
  features?: ProjectCardFeature[];
  evidenceLabel?: string;
  evidence?: string;
  ctaLabel: string;
  whatItTests?: string;
}

const {
  variant = 'proof',
  tag,
  eyebrow,
  title,
  description,
  href,
  logoPath,
  logoAlt = '',
  imagePath,
  imageAlt = '',
  tone = 'blue',
  symbol,
  features,
  evidenceLabel,
  evidence,
  ctaLabel,
  whatItTests,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<PlaneCard
  href={href}
  accent={tone === 'purple' ? 'violet' : 'blue'}
  className={`project-proof-card project-proof-card--${variant}${tone ? ` project-proof-card--tone-${tone}` : ''}`}
  ariaLabel={`${title}: ${description}`}
>
  {variant === 'compact' ? (
    <div class="proof-row-card">
      <!-- Left: Brand Identity & Content Column -->
      <div class="proof-row-card__main">
        <div class="proof-row-card__topline">
          <div class="proof-row-card__icon-box" aria-hidden={!logoPath ? 'true' : undefined}>
            {logoPath ? (
              <img src={asset(logoPath)} alt={logoAlt} loading="lazy" />
            ) : (
              <svg class="proof-row-card__symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </div>
          <div class="proof-row-card__header-meta">
            <span class="proof-row-card__tag">{tag || eyebrow || 'REFERENCE APPLICATION'}</span>
            <h3 class="proof-row-card__title">{title}</h3>
          </div>
        </div>

        <p class="proof-row-card__question">{description}</p>

        <!-- Validation Section with Chips -->
        {features && features.length > 0 && (
          <div class="proof-row-card__validation">
            <span class="proof-row-card__validation-label">WHAT THIS VALIDATES:</span>
            <div class="proof-row-card__validation-chips">
              {features.map((feature) => (
                <span class="validation-chip">{feature.label}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Footer CTA -->
        <div class="proof-row-card__cta">
          <strong>{ctaLabel}</strong>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </div>
      </div>

      <!-- Right: App Window Preview Mockup -->
      {imagePath && (
        <div class="proof-row-card__preview">
          <div class="proof-row-card__window">
            <div class="proof-row-card__window-bar" aria-hidden="true">
              <div class="window-dots">
                <span class="window-dot window-dot--close"></span>
                <span class="window-dot window-dot--min"></span>
                <span class="window-dot window-dot--max"></span>
              </div>
              <span class="window-title">{title.toLowerCase().replace(/\s+/g, '')}.local</span>
              <span class="proof-row-card__action" aria-hidden="true">↗</span>
            </div>
            <div class="proof-row-card__window-body">
              <img src={asset(imagePath)} alt={imageAlt} loading="lazy" />
              <span class="proof-row-card__window-glare" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      )}
    </div>
  ) : (
    <Fragment slot="header">
      {eyebrow && (
        <div class="project-proof-card__meta">
          <span class="project-proof-card__eyebrow">{eyebrow}</span>
        </div>
      )}
      <span class="project-proof-card__arrow" aria-hidden="true">↗</span>
    </Fragment>

    <div class="project-proof-card__content">
      <div class="project-proof-card__identity">
        <div class="project-proof-card__logo" aria-hidden={!logoPath ? 'true' : undefined}>
          {logoPath ? (
            <img src={asset(logoPath)} alt={logoAlt} loading="lazy" />
          ) : (
            <svg class="project-proof-card__symbol" viewBox="0 0 48 48" aria-hidden="true">
              {symbol === 'audio' && <path d="M8 27h5l3-10 5 20 5-27 5 23 4-12 3 6h4" />}
              {symbol === 'performance' && <path d="M8 36V10m0 26h32M12 31l8-8 7 4 11-14" />}
              {symbol === 'boundary' && <><path d="M24 6 38 12v10c0 9-5 15-14 20-9-5-14-11-14-20V12z" /><path d="M17 24h14M24 17v14" /></>}
              {symbol === 'feedback' && <><path d="M10 19a16 16 0 0 1 27-5l3 4" /><path d="m40 10v8h-8M38 29a16 16 0 0 1-27 5l-3-4" /><path d="M8 38v-8h8" /></>}
            </svg>
          )}
        </div>

        <div class="project-proof-card__titles">
          <h3 class="project-proof-card__title">{title}</h3>
          <p class="project-proof-card__question">{description}</p>
        </div>
      </div>

      {features && features.length > 0 && (
        <div class="project-proof-card__tags">
          {features.map((f) => (
            <span class="proof-tag">{f.label}</span>
          ))}
        </div>
      )}

      {whatItTests && (
        <div class="project-proof-card__body-block">
          <span class="project-proof-card__badge-label">
            {whatItTests ? 'WHAT IT TESTS' : evidenceLabel}
          </span>
          <p class="project-proof-card__body-text">
            {whatItTests || evidence}
          </p>
        </div>
      )}
    </div>

    <Fragment slot="footer">
      <div class="project-proof-card__footer-inner">
        <strong class="project-proof-card__cta">{ctaLabel}<span aria-hidden="true"> →</span></strong>
      </div>
    </Fragment>
  )}
</PlaneCard>

<style>
  /* Base Proof Card Styles (Standard Variant) */
  .project-proof-card__meta {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--plane-card-accent);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-proof-card__arrow {
    color: var(--ink-muted);
    font-size: 1rem;
    transition: transform var(--duration-fast) ease;
  }

  :global(.project-proof-card:hover) .project-proof-card__arrow,
  :global(.project-proof-card:focus-visible) .project-proof-card__arrow {
    transform: translate(2px, -2px);
    color: var(--plane-card-accent);
  }

  .project-proof-card__identity {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .project-proof-card__logo {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background: var(--surface-subtle);
    flex-shrink: 0;
  }

  .project-proof-card__logo img {
    width: 32px;
    height: 32px;
    display: block;
    object-fit: contain;
  }

  .project-proof-card__symbol {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--plane-card-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project-proof-card__titles {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .project-proof-card__title {
    margin: 0 0 3px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .project-proof-card__question {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 600;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .project-proof-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .proof-tag {
    font-size: var(--text-badge);
    font-weight: 650;
    color: var(--ink);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .project-proof-card__body-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    margin-top: auto;
  }

  .project-proof-card__badge-label {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--plane-card-accent);
    text-transform: uppercase;
  }

  .project-proof-card__body-text {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.45;
  }

  .project-proof-card__footer-inner {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .project-proof-card__cta {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--plane-card-accent);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    white-space: nowrap;
  }

  /* ==========================================================================
     COMPACT ROW CARD (PLANE 03 - TEST APPLICATIONS)
     Cohesive with Plane 02 BUILD Layer Aesthetics & Dimensions
     ========================================================================== */

  :global(.plane-card.project-proof-card--compact) {
    --product-accent: #2563eb;
    --product-accent-light: #38bdf8;
    --product-soft: rgba(37, 99, 235, 0.08);
    --product-border: rgba(56, 189, 248, 0.28);
    --product-glow: rgba(56, 189, 248, 0.35);

    height: auto;
    min-height: 154px;
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--product-accent) 22%, var(--border-medium));
    background:
      radial-gradient(circle at 10% 0%, var(--product-soft), transparent 45%),
      var(--surface-card);
    box-shadow:
      0 6px 20px rgba(8, 19, 51, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition:
      transform var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-base) ease;
  }

  /* Tone 1: Blue / Azure (RedactGuard) */
  :global(.plane-card.project-proof-card--tone-blue),
  :global(.plane-card.project-proof-card--tone-red) {
    --product-accent: #2563eb;
    --product-accent-light: #38bdf8;
    --product-soft: rgba(37, 99, 235, 0.08);
    --product-border: rgba(56, 189, 248, 0.28);
    --product-glow: rgba(56, 189, 248, 0.35);
  }

  /* Tone 2: Emerald Green (Aura Finance) */
  :global(.plane-card.project-proof-card--tone-green) {
    --product-accent: #059669;
    --product-accent-light: #34d399;
    --product-soft: rgba(16, 185, 129, 0.08);
    --product-border: rgba(52, 211, 153, 0.28);
    --product-glow: rgba(52, 211, 153, 0.35);
  }

  /* Tone 3: Violet / Purple (ClosedRoom) */
  :global(.plane-card.project-proof-card--tone-purple) {
    --product-accent: #7c3aed;
    --product-accent-light: #a855f7;
    --product-soft: rgba(124, 58, 237, 0.08);
    --product-border: rgba(168, 85, 247, 0.28);
    --product-glow: rgba(168, 85, 247, 0.35);
  }

  :global(.project-proof-card--compact .plane-card__header) {
    display: none;
  }

  :global(.project-proof-card--compact .plane-card__footer) {
    display: none;
  }

  :global(.project-proof-card--compact .plane-card__body) {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0;
    overflow: visible;
  }

  :global(.plane-card.project-proof-card--compact:hover),
  :global(.plane-card.project-proof-card--compact:focus-visible) {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--product-accent) 48%, var(--border-medium));
    box-shadow:
      0 16px 36px rgba(8, 19, 51, 0.09),
      0 0 28px var(--product-soft),
      inset 0 1px 0 rgba(255, 255, 255, 0.98);
  }

  /* Grid Layout inside each horizontal row card */
  .proof-row-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 240px);
    gap: clamp(14px, 2vw, 22px);
    align-items: center;
    padding: 16px 18px;
    min-width: 0;
  }

  .proof-row-card__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 7px;
  }

  /* Topline */
  .proof-row-card__topline {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .proof-row-card__icon-box {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    flex-shrink: 0;
    background: linear-gradient(145deg, var(--product-soft), color-mix(in srgb, var(--product-accent) 14%, transparent));
    border: 1px solid var(--product-border);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 3px 8px rgba(8, 19, 51, 0.04);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .proof-row-card__icon-box img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }

  .proof-row-card__symbol {
    width: 20px;
    height: 20px;
    color: var(--product-accent);
  }

  .proof-row-card__header-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .proof-row-card__tag {
    color: var(--product-accent);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .proof-row-card__title {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .proof-row-card__question {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
    font-weight: 560;
    line-height: 1.35;
    text-wrap: pretty;
  }

  /* Validation Block */
  .proof-row-card__validation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }

  .proof-row-card__validation-label {
    color: var(--product-accent);
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .proof-row-card__validation-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .validation-chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    font-size: 0.67rem;
    font-weight: 650;
    line-height: 1.2;
    color: var(--ink);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  :global(.plane-card.project-proof-card--compact:hover) .validation-chip {
    border-color: color-mix(in srgb, var(--product-accent) 24%, var(--border-subtle));
  }

  /* CTA */
  .proof-row-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 760;
    color: var(--product-accent);
    margin-top: 2px;
    line-height: 1.2;
  }

  .cta-arrow {
    font-size: 0.9rem;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  :global(.plane-card.project-proof-card--compact:hover) .cta-arrow,
  :global(.plane-card.project-proof-card--compact:focus-visible) .cta-arrow {
    transform: translateX(4px);
  }

  /* Right Column Preview Window */
  .proof-row-card__preview {
    height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    min-width: 0;
  }

  .proof-row-card__window {
    width: 100%;
    height: 100%;
    min-height: 120px;
    max-height: 136px;
    position: relative;
    overflow: hidden;
    border-radius: 9px;
    border: 1px solid color-mix(in srgb, var(--product-accent) 20%, var(--border-medium));
    background: #081333;
    box-shadow:
      0 4px 12px rgba(8, 19, 51, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
  }

  .proof-row-card__window-bar {
    height: 22px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(180deg, #132448, #0e1b38);
    border-bottom: 1px solid rgba(188, 208, 255, 0.12);
    flex-shrink: 0;
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 3.5px;
  }

  .window-dot {
    width: 5.5px;
    height: 5.5px;
    border-radius: 50%;
  }

  .window-dot--close { background: #ef4444; opacity: 0.85; }
  .window-dot--min { background: #f59e0b; opacity: 0.85; }
  .window-dot--max { background: #10b981; opacity: 0.85; }

  .window-title {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 600;
    color: rgba(188, 208, 255, 0.6);
    letter-spacing: 0.02em;
  }

  .proof-row-card__action {
    color: rgba(188, 208, 255, 0.7);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    transition: transform var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .proof-row-card__window-body {
    position: relative;
    flex: 1;
    min-height: 98px;
    overflow: hidden;
    background: #0b1736;
  }

  .proof-row-card__window-body img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition:
      transform var(--duration-base) var(--ease-out-expo),
      filter var(--duration-base) ease;
    filter: saturate(0.92) contrast(1.02);
  }

  .proof-row-card__window-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(8, 19, 51, 0.12), transparent 40%, rgba(8, 19, 51, 0.22));
  }

  :global(.plane-card.project-proof-card--compact:hover) .proof-row-card__icon-box,
  :global(.plane-card.project-proof-card--compact:focus-visible) .proof-row-card__icon-box {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 0 16px var(--product-glow);
  }

  :global(.plane-card.project-proof-card--compact:hover) .proof-row-card__action,
  :global(.plane-card.project-proof-card--compact:focus-visible) .proof-row-card__action {
    color: var(--product-accent-light);
    transform: translate(1px, -1px);
  }

  :global(.plane-card.project-proof-card--compact:hover) .proof-row-card__window-body img,
  :global(.plane-card.project-proof-card--compact:focus-visible) .proof-row-card__window-body img {
    transform: scale(1.04);
    filter: saturate(1.02) contrast(1.05);
  }

  @media (max-width: 680px) {
    .proof-row-card {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 14px;
    }

    .proof-row-card__preview {
      width: 100%;
    }

    .proof-row-card__window {
      max-height: 160px;
      min-height: 130px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.plane-card.project-proof-card--compact),
    .proof-row-card__icon-box,
    .proof-row-card__action,
    .proof-row-card__window-body img,
    .cta-arrow {
      transition: none;
    }

    :global(.plane-card.project-proof-card--compact:hover),
    :global(.plane-card.project-proof-card--compact:focus-visible) {
      transform: none;
    }

    :global(.plane-card.project-proof-card--compact:hover) .proof-row-card__icon-box,
    :global(.plane-card.project-proof-card--compact:focus-visible) .proof-row-card__icon-box,
    :global(.plane-card.project-proof-card--compact:hover) .proof-row-card__action,
    :global(.plane-card.project-proof-card--compact:focus-visible) .proof-row-card__action,
    :global(.plane-card.project-proof-card--compact:hover) .proof-row-card__window-body img,
    :global(.plane-card.project-proof-card--compact:focus-visible) .proof-row-card__window-body img,
    :global(.plane-card.project-proof-card--compact:hover) .cta-arrow,
    :global(.plane-card.project-proof-card--compact:focus-visible) .cta-arrow {
      transform: none;
    }
  }
</style>
