---
import LandingHeader from './LandingHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { planLinks, type PlanDetailData } from '../../content/locales/en/planDetails';

interface Props {
  data: PlanDetailData;
  title: string;
  description: string;
}

const { data, title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<BaseLayout title={title} description={description}>
  <LandingHeader slot="header" />

  <article class="plan-detail" id="top">
    <header class="plan-hero">
      <div class="shell plan-hero-grid">
        <div class="plan-hero-copy">
          <a class="back-link" href={`${baseUrl}/#strategy`}>← Back to the complete research path</a>
          <p class="plan-eyebrow">{data.eyebrow}</p>
          <h1>{data.title}</h1>
          <p class="plan-lede">{data.lede}</p>
          <blockquote>{data.thesis}</blockquote>

          <div class="hero-actions">
            <a class="primary-button" href="#why">See how this plane works <span aria-hidden="true">↓</span></a>
            <a class="secondary-button" href="#work">See the work <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="plan-map" aria-label={`Plane ${data.number} of 4: ${data.phase}`}>
          <div class="map-head">
            <span>THE RESEARCH PATH</span>
            <strong>{String(data.number).padStart(2, '0')} / 04</strong>
          </div>
          <ol>
            {planLinks.map((plan) => (
              <li class={Number(plan.number) === data.number ? 'is-current' : ''}>
                <span class="map-node">{plan.number}</span>
                <div>
                  <small>{plan.phase}</small>
                  <strong>{plan.label}</strong>
                </div>
              </li>
            ))}
          </ol>
          <p class="map-caption">Each plane produces the input for the next one.</p>
        </div>
      </div>
    </header>

    <nav class="plan-navigation" aria-label="Research planes">
      <div class="shell plan-navigation-inner">
        {planLinks.map((plan) => (
          <a
            href={resolveHref(plan.href)}
            class={Number(plan.number) === data.number ? 'is-current' : ''}
            aria-current={Number(plan.number) === data.number ? 'page' : undefined}
          >
            <span>{plan.number}</span>
            <strong>{plan.label}</strong>
          </a>
        ))}
      </div>
    </nav>

    <section class="detail-section origin-section" id="why" aria-labelledby="origin-title">
      <div class="shell section-grid">
        <header class="section-heading">
          <p class="section-eyebrow">{data.origin.eyebrow}</p>
          <h2 id="origin-title">{data.origin.title}</h2>
        </header>
        <div class="origin-copy">
          {data.origin.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <div class="thesis-line"><span aria-hidden="true">◎</span><strong>{data.thesis}</strong></div>
        </div>
      </div>
    </section>

    <section class="detail-section method-section" id="method" aria-labelledby="method-title">
      <div class="shell">
        <header class="section-heading narrow-heading">
          <p class="section-eyebrow">{data.method.eyebrow}</p>
          <h2 id="method-title">{data.method.title}</h2>
          <p>{data.method.intro}</p>
        </header>

        <div class="method-list">
          {data.method.items.map((item) => (
            <article class="method-item">
              <span>{item.index}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="detail-section work-section" id="work" aria-labelledby="work-title">
      <div class="shell">
        <header class="section-heading narrow-heading">
          <p class="section-eyebrow">{data.work.eyebrow}</p>
          <h2 id="work-title">{data.work.title}</h2>
          <p>{data.work.intro}</p>
        </header>

        <div class="work-list">
          {data.work.items.map((item) => (
            <article class={`work-item ${item.image ? 'has-image' : ''}`}>
              {item.image && (
                <div class="work-media">
                  <img src={asset(item.image)} alt={item.imageAlt ?? ''} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="work-index">{item.index}</div>
              <div class="work-copy">
                {item.meta && <p class="work-meta">{item.meta}</p>}
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
              {item.href && item.linkLabel && (
                <a class="work-link" href={resolveHref(item.href)}>{item.linkLabel} <span aria-hidden="true">↗</span></a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="plan-handoff" aria-labelledby="handoff-title">
      <div class="shell handoff-grid">
        <div>
          <p class="section-eyebrow">{data.handoff.eyebrow}</p>
          <h2 id="handoff-title">{data.handoff.title}</h2>
          <p>{data.handoff.text}</p>
        </div>
        <a class="handoff-action" href={resolveHref(data.handoff.nextHref)}>
          {data.handoff.nextLabel}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .plan-detail {
    background: var(--surface-canvas);
    color: var(--ink);
  }

  .plan-hero {
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    padding: clamp(56px, 8vw, 104px) 0;
    overflow: clip;
    background:
      radial-gradient(circle at 82% 22%, rgba(20, 91, 255, 0.14), transparent 30%),
      linear-gradient(145deg, #ffffff, #f5f7fc);
  }

  .plan-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.68fr);
    gap: clamp(44px, 8vw, 110px);
    align-items: center;
  }

  .back-link {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover { color: var(--accent-blue); }

  .plan-eyebrow,
  .section-eyebrow {
    margin: 0;
    color: var(--accent-blue);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .plan-hero h1 {
    max-width: 850px;
    margin: var(--space-4) 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 6.2vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .plan-lede {
    max-width: 760px;
    margin: var(--space-5) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-lead);
    line-height: 1.7;
  }

  .plan-hero blockquote {
    max-width: 720px;
    margin: var(--space-5) 0 0;
    padding: 2px 0 2px var(--space-4);
    border-left: 3px solid var(--accent-blue);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 800;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .plan-map {
    padding: clamp(26px, 4vw, 38px);
    border-radius: var(--radius-xl);
    background: var(--ink-display);
    color: var(--ink-inverse);
    box-shadow: 0 30px 80px rgba(8, 19, 51, 0.2);
  }

  .map-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    color: #9dbbff;
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .plan-map ol {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .plan-map ol::before {
    content: '';
    position: absolute;
    top: 17px;
    bottom: 17px;
    left: 17px;
    width: 2px;
    background: linear-gradient(#4c7fff, rgba(157, 187, 255, 0.22));
  }

  .plan-map li {
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: var(--space-3);
    align-items: center;
    opacity: 0.52;
  }

  .plan-map li.is-current { opacity: 1; }

  .map-node {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(157, 187, 255, 0.42);
    border-radius: 50%;
    background: var(--ink-display);
    color: #bcd0ff;
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    z-index: 1;
  }

  .is-current .map-node {
    border-color: #9dbbff;
    background: var(--accent-blue);
    color: #ffffff;
    box-shadow: 0 0 0 7px rgba(20, 91, 255, 0.16);
  }

  .plan-map small,
  .plan-map li strong {
    display: block;
    font-family: var(--font-display);
  }

  .plan-map small {
    color: #9dbbff;
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .plan-map li strong {
    margin-top: 2px;
    font-size: var(--text-body);
  }

  .map-caption {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--text-caption);
  }

  .plan-navigation {
    position: sticky;
    top: var(--header-height);
    z-index: 20;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-medium);
    background: color-mix(in srgb, var(--surface-canvas) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .plan-navigation-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .plan-navigation a {
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px var(--space-4);
    border-left: 1px solid var(--border-subtle);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .plan-navigation a:last-child { border-right: 1px solid var(--border-subtle); }
  .plan-navigation a.is-current { color: var(--accent-blue); background: var(--surface-blue-subtle); }
  .plan-navigation a span { font-family: var(--font-mono); font-size: var(--text-badge); font-weight: 800; }
  .plan-navigation a strong { font-family: var(--font-display); font-size: var(--text-caption); }

  .detail-section {
    padding: clamp(76px, 10vw, 136px) 0;
  }

  .origin-section { background: var(--surface-canvas); }
  .method-section { background: var(--surface-subtle); }
  .work-section { background: var(--surface-canvas); }

  .section-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(44px, 9vw, 120px);
    align-items: start;
  }

  .section-heading h2,
  .plan-handoff h2 {
    margin: var(--space-3) 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.3vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.04;
  }

  .narrow-heading { max-width: 820px; }

  .narrow-heading > p:last-child {
    max-width: 700px;
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-lead);
    line-height: 1.65;
  }

  .origin-copy > p {
    margin: 0 0 var(--space-5);
    color: var(--ink-muted);
    font-size: var(--text-lead);
    line-height: 1.75;
  }

  .thesis-line {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-8);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
  }

  .thesis-line span {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--surface-blue-subtle);
  }

  .method-list {
    display: grid;
    margin-top: clamp(44px, 7vw, 76px);
    border-top: 1px solid var(--border-medium);
  }

  .method-item {
    display: grid;
    grid-template-columns: 70px minmax(210px, 0.7fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: start;
    padding: clamp(24px, 3vw, 34px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .method-item > span,
  .work-index {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 800;
  }

  .method-item h3,
  .work-item h3 {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .method-item p,
  .work-copy > p:last-child {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
    line-height: 1.65;
  }

  .work-list {
    display: grid;
    margin-top: clamp(44px, 7vw, 76px);
    border-top: 1px solid var(--border-medium);
  }

  .work-item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: clamp(18px, 4vw, 48px);
    align-items: center;
    padding: clamp(26px, 4vw, 42px) 0;
    border-bottom: 1px solid var(--border-medium);
  }

  .work-item.has-image {
    grid-template-columns: minmax(250px, 0.76fr) 48px minmax(0, 1fr) auto;
  }

  .work-media {
    height: 210px;
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .work-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: top;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .work-media img[src$=".svg"] {
    object-fit: contain;
    padding: 10px;
    background: #ffffff;
  }

  .work-item:hover .work-media img { transform: scale(1.025); }

  .work-copy { min-width: 0; }
  .work-meta { margin: 0 0 var(--space-2); color: var(--accent-blue); font-size: var(--text-badge); font-weight: 800; letter-spacing: 0.07em; }
  .work-copy > p:last-child { margin-top: var(--space-2); }

  .work-link {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent-blue);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
  }

  .work-link:hover { color: var(--accent-blue-hover); }

  .plan-handoff {
    padding: clamp(76px, 10vw, 132px) 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(20, 91, 255, 0.42), transparent 34%),
      var(--ink-display);
  }

  .handoff-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(34px, 7vw, 90px);
    align-items: center;
  }

  .plan-handoff h2 { color: var(--ink-inverse); }
  .plan-handoff p:not(.section-eyebrow) { max-width: 760px; margin: var(--space-4) 0 0; color: rgba(255, 255, 255, 0.68); font-size: var(--text-lead); line-height: 1.65; }
  .plan-handoff .section-eyebrow { color: #9dbbff; }

  .handoff-action {
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    background: var(--accent-blue);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(20, 91, 255, 0.28);
    transition: transform var(--duration-fast) ease, background var(--duration-fast) ease;
  }

  .handoff-action:hover { transform: translateY(-2px); background: var(--accent-blue-hover); }

  @media (max-width: 980px) {
    .plan-hero { min-height: auto; }
    .plan-hero-grid,
    .section-grid,
    .handoff-grid { grid-template-columns: 1fr; }
    .plan-map { max-width: 560px; }
    .work-item.has-image { grid-template-columns: 220px 44px minmax(0, 1fr); }
    .work-item.has-image .work-link { grid-column: 3; }
    .handoff-action { justify-self: start; }
  }

  @media (max-width: 720px) {
    .plan-hero { padding: 42px 0 58px; }
    .plan-hero-grid { gap: var(--space-8); }
    .plan-hero h1 { font-size: clamp(2.7rem, 13vw, 4.4rem); }
    .plan-navigation { overflow-x: auto; }
    .plan-navigation-inner { width: max-content; }
    .plan-navigation a { min-width: 150px; }
    .method-item { grid-template-columns: 42px 1fr; gap: var(--space-3); }
    .method-item p { grid-column: 2; }
    .work-item,
    .work-item.has-image { grid-template-columns: 42px minmax(0, 1fr); gap: var(--space-3); }
    .work-media { grid-column: 1 / -1; height: 190px; }
    .work-link,
    .work-item.has-image .work-link { grid-column: 2; justify-self: start; white-space: normal; }
    .detail-section { padding: 72px 0; }
  }
</style>
