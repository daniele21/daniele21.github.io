    border: 1px solid color-mix(in srgb, var(--accent-blue) 16%, var(--border-subtle));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent-blue) 4%, var(--surface-card)), var(--surface-card));
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 60%, transparent);
