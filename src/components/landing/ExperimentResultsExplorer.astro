  @media (max-width: 790px) {
    .jev-tradeoff {
      grid-template-columns: 1fr;
    }

    .jev-tradeoff__numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
      padding: 16px 0 0;
    }

    .jev-ranking__columns,
