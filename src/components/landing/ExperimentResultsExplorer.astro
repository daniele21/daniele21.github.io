      font-size: clamp(1.2rem, 5vw, 1.45rem);
      font-weight: 760;
      line-height: 1.2;
      letter-spacing: -.028em;
    }
    .evidence-panel__header p { font-size: var(--text-body-sm); }
    .source-link {
      min-height: var(--touch-target-min);
      align-self: flex-start;
    }
    .run-summary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px;
      margin-top: 13px;
    }
    .run-summary > span {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      min-width: 0;
      padding: 9px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      background: var(--surface-subtle);
      font-size: var(--text-caption);
      overflow-wrap: anywhere;
    }

    /* Results before graphs: readers see real observed values first. */
    .benchmark-story {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 17px;
      padding-top: 15px;
    }
    .benchmark-highlights {
      order: -1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding: 0;
      border: 0;
    }
    .highlight {
      min-width: 0;
      padding: 11px 10px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      background: var(--surface-card);
    }
    .highlight + .highlight { border: 1px solid var(--border-subtle); }
    .highlight:last-child { grid-column: 1 / -1; }
    .highlight strong {
      margin-top: 5px;
      font-size: clamp(1.13rem, 4.4vw, 1.38rem);
      font-weight: 760;
      letter-spacing: -.025em;
      overflow-wrap: anywhere;
    }
    .highlight small { font-size: var(--text-caption); overflow-wrap: anywhere; }
    .highlight--accent::before { display: none; }

    .performance-plot {
      min-width: 0;
      padding: 13px 10px;
      box-shadow: none;
    }
    .plot-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
    .plot-filters { max-width: 100%; }
    .plot-filters button { min-height: var(--touch-target-min); }
    .chart-swipe-hint {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin: 12px 0 4px;
      color: var(--ink-muted);
      font-size: var(--text-caption);
      line-height: 1.4;
    }
    .chart-swipe-hint span { color: var(--accent-blue); }
    .plot-canvas, .rg-plot-canvas {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      border-radius: var(--radius-sm);
    }
    .plot-canvas .plot-svg {
      display: block;
      width: 620px;
      max-width: none;
      min-width: 620px;
      min-height: 0;
      margin-top: 0;
    }
    .rg-plot-canvas svg {
      display: block;
      width: 640px;
      max-width: none;
      min-width: 640px;
    }

    .evidence-takeaway {
      margin-top: 15px;
      padding: 14px;
      gap: 7px;
    }
    .rg-summary, .jev-summary { min-width: 0; }
    .rg-matrix__scroll { overscroll-behavior-inline: contain; }
  }

  /* Evidence Stories: mobile is a concise narrative, not a shrunk dashboard. */
  .experiment-mobile-chooser { display: none; }
  .mcb-story { min-width: 0; }
  .mcb-story .benchmark-story {
    display: block;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .mcb-story .benchmark-highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 17px;
    padding: 0;
    border: none;
  }
  .mcb-story .highlight {
    min-width: 0;
    padding: 13px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }
  .mcb-story .highlight + .highlight {
    border: 1px solid var(--border-subtle);
  }
  .mcb-story .highlight--accent::before { display: none; }

  .mcb-model-browser {
    margin-top: 18px;
