  .jev-stage-coverage :global(.jev-stage-coverage__item) {
    padding: 4px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .jev-stage-coverage :global(.jev-stage-coverage__item.is-published) {
    border-color: color-mix(in srgb, var(--accent-blue) 28%, var(--border-subtle));
    color: var(--accent-blue-dark);
    background: color-mix(in srgb, var(--accent-blue) 6%, var(--surface-card));
  }

  .jev-coverage-banner__count {
    flex: 0 0 auto;
    padding: 6px 10px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    color: var(--ink-muted);
    font-size: var(--text-caption);
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .jev-coverage-banner {
      flex-direction: column;
      gap: 10px;
    }
  }

  .jev-tradeoff {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(230px, 0.72fr);
    gap: clamp(18px, 3vw, 36px);
    align-items: center;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 20%, var(--border-subtle));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--accent-violet) 11%, transparent), transparent 55%),
      linear-gradient(110deg, color-mix(in srgb, var(--accent-blue) 8%, var(--surface-card)), var(--surface-card));
  }

  .jev-tradeoff__main > strong {
    display: block;
    margin-top: 10px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.7vw, 2.15rem);
    font-weight: 830;
    line-height: 1.13;
    letter-spacing: -0.045em;
  }

  .jev-tradeoff__main p {
    max-width: 610px;
    margin: 10px 0 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  .jev-tradeoff__numbers {
    display: grid;
    gap: 14px;
    padding-left: clamp(12px, 2vw, 24px);
    border-left: 1px solid var(--border-medium);
  }

  .jev-tradeoff__numbers > div {
    display: grid;
    gap: 4px;
  }

  .jev-tradeoff__numbers span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .jev-tradeoff__numbers strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .jev-ranking {
    margin-top: clamp(22px, 3vw, 30px);
  }

  .jev-ranking__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 10px;
    margin-bottom: 16px;
  }

  .jev-ranking__header h4 {
    margin: 5px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.8vw, 1.4rem);
    letter-spacing: -0.03em;
  }

  .jev-ranking__header > span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .jev-ranking__columns,
  :global(.jev-model-row) {
    display: grid;
    grid-template-columns: minmax(170px, 1.1fr) minmax(180px, 1.45fr) minmax(120px, 0.65fr);
    align-items: center;
    gap: 20px;
  }

  .jev-ranking__columns {
    padding: 0 16px 10px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 720;
  }

  .jev-ranking__columns > span:last-child {
    text-align: right;
  }

  .jev-ranking__columns small {
    display: block;
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    font-weight: 500;
  }

  .jev-ranking__rows {
    display: grid;
    gap: 7px;
  }

  :global(.jev-model-row) {
    padding: 14px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-card) 90%, var(--surface-subtle));
  }

  :global(.jev-model-row.is-alternative) {
    border-color: color-mix(in srgb, var(--accent-blue) 28%, var(--border-subtle));
    background: color-mix(in srgb, var(--accent-blue) 5%, var(--surface-card));
  }

  :global(.jev-model-row__name strong),
  :global(.jev-model-row__latency strong),
  :global(.jev-model-row__accuracy strong) {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 780;
    line-height: 1.3;
  }

  :global(.jev-model-row__name small),
  :global(.jev-model-row__latency small) {
    display: block;
    margin-top: 3px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.3;
  }

  :global(.jev-model-row__accuracy-head) {
    display: flex;
    justify-content: space-between;
    margin-bottom: 7px;
  }

  :global(.jev-model-row__track) {
    height: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-blue) 11%, var(--surface-subtle));
  }

  :global(.jev-model-row__fill) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent-blue), color-mix(in srgb, var(--accent-blue) 70%, var(--accent-violet)));
  }

  :global(.jev-model-row__latency) {
    text-align: right;
  }
  
  .jev-ranking__note:empty {
    display: none;
  }

  :global(.jev-model-row__mobile-label) {
    display: none;
    margin: 2px 0 7px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .jev-ranking__note {
    margin-top: 14px;
    padding: 12px 15px;
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  .jev-ranking__note :global(strong) {
    color: var(--ink-display);
  }

  .jev-method-note {
    margin: 16px 0 0;
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  @media (max-width: 790px) {
    .jev-tradeoff {
      grid-template-columns: 1fr;
    }

    .jev-tradeoff__numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
      padding: 16px 0 0;
    }

    .jev-ranking__columns,
    :global(.jev-model-row) {
      grid-template-columns: minmax(120px, 1.2fr) minmax(120px, 1fr) minmax(76px, 0.6fr);
      gap: 12px;
    }
  }

  @media (max-width: 520px) {
    .jev-ranking__columns {
      display: none;
    }

    :global(.jev-model-row) {
      grid-template-columns: minmax(0, 1fr) minmax(86px, 0.55fr);
      gap: 12px;
      padding: 14px;
    }

    :global(.jev-model-row__name) {
      grid-column: 1 / -1;
    }

    :global(.jev-model-row__accuracy) {
      grid-column: 1;
    }

    :global(.jev-model-row__latency) {
      grid-column: 2;
    }

    :global(.jev-model-row__mobile-label) {
      display: block;
    }

    .jev-tradeoff__numbers {
      grid-template-columns: 1fr 1fr;
    }
  }


  .experiment-explorer { min-width: 0; }

  .experiment-selector-wrap {
    position: relative;
    margin-bottom: 14px;
  }

  .experiment-selector-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 34px;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--journey-surface-tint, var(--surface-subtle)));
    pointer-events: none;
  }

  .experiment-selector {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 2px 36px 6px 2px;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .experiment-selector::-webkit-scrollbar { display: none; }

  .experiment-tab {
    flex: 0 0 auto;
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface-card) 82%, var(--surface-subtle));
    color: var(--ink-muted);
    cursor: pointer;
    scroll-snap-align: start;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .experiment-tab:hover,
  .experiment-tab:focus-visible {
    border-color: color-mix(in srgb, var(--accent-blue) 36%, var(--border-medium));
    color: var(--ink-display);
  }

  .experiment-tab.is-active {
    border-color: color-mix(in srgb, var(--accent-blue) 52%, var(--border-medium));
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 8%, var(--surface-card)), var(--surface-card));
    color: var(--ink-display);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent-blue) 7%, transparent);
  }

  .experiment-tab__title {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 720;
    white-space: nowrap;
  }

  .status-dot,
  .live-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--ink-subtle);
  }

  .status-dot--live,
  .live-dot {
    background: var(--accent-blue);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-blue) 10%, transparent);
  }

  .evidence-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 24%, var(--border-medium));
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 92% 3%, color-mix(in srgb, var(--accent-blue) 13%, transparent), transparent 31%),
      radial-gradient(circle at 5% 100%, color-mix(in srgb, var(--accent-violet) 7%, transparent), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--surface-card) 96%, var(--accent-blue) 4%), var(--surface-card));
    box-shadow:
      0 24px 60px rgba(8, 19, 51, 0.07),
      inset 0 1px 0 color-mix(in srgb, white 64%, transparent);
  }

  [hidden] { display: none !important; }

  .evidence-panel__loading,
  .evidence-panel__error {
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(22px, 3vw, 32px);
  }

  .evidence-panel__empty {
    min-height: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    padding: 22px 24px;
  }

  .evidence-panel__empty-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent-blue) 8%, var(--surface-card));
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
