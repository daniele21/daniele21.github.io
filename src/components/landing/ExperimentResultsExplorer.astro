  .rg-detail__count strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4vw, 3.2rem);
    font-weight: 820;
    letter-spacing: -0.06em;
    line-height: 1;
