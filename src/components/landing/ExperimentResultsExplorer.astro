---
interface Track {
  id?: string;
  title: string;
  question: string;
  status: string;
  resultUrl?: string;
  sourceUrl?: string;
  resultKind?: 'jev-routing';
}

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;
---

<div class="experiment-explorer" data-experiment-explorer>
  <div class="experiment-selector" role="tablist" aria-label="Select experiment">
    {tracks.map((track, index) => (
      <button
        type="button"
        class:list={['experiment-tab', { 'is-active': index === 0 }]}
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? '0' : '-1'}
        data-experiment-tab
        data-track-id={track.id || ''}
        data-title={track.title}
        data-question={track.question}
        data-status={track.status}
        data-result-url={track.resultUrl || ''}
        data-source-url={track.sourceUrl || ''}
        data-result-kind={track.resultKind || ''}
      >
        <span class="experiment-tab__status">
          <span class:list={['status-dot', { 'status-dot--live': Boolean(track.resultUrl) }]} aria-hidden="true"></span>
          {track.resultUrl ? 'Published evidence' : track.status}
        </span>
        <strong>{track.title}</strong>
        <span class="experiment-tab__question">{track.question}</span>
      </button>
    ))}
  </div>

  <section class="evidence-panel" aria-live="polite" aria-label="Selected experiment evidence">
    <div class="evidence-panel__loading" data-evidence-loading hidden>
      Loading published evidence from GitHub…
    </div>

    <div class="evidence-panel__empty" data-evidence-empty hidden>
      <span class="evidence-panel__eyebrow">NO PUBLISHED RUN YET</span>
      <h3 data-empty-title></h3>
      <p data-empty-question></p>
      <p class="evidence-panel__empty-note">
        The benchmark exists in the Experiments repository, but there is no versioned result artifact
        available to surface here yet. No placeholder metrics are shown.
      </p>
    </div>

    <div class="evidence-panel__result" data-evidence-result hidden>
      <div class="evidence-panel__header">
        <div>
          <span class="evidence-panel__eyebrow">LIVE FROM EXPERIMENTS / MAIN</span>
          <h3 data-result-title></h3>
          <p data-result-question></p>
        </div>
        <a data-result-source href="#" target="_blank" rel="noopener noreferrer">
          View source <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="evidence-context">
        <div>
          <span>MODEL</span>
          <strong data-model>—</strong>
          <small data-quant></small>
        </div>
        <div>
          <span>DATASET</span>
          <strong data-dataset>—</strong>
          <small data-cases></small>
        </div>
        <div>
          <span>LAST RUN</span>
          <strong data-last-run>—</strong>
          <small data-hardware></small>
        </div>
      </div>

      <div class="metric-grid">
        <article>
          <span>ACCURACY</span>
          <strong data-accuracy>—</strong>
          <small>top-1 categorical</small>
        </article>
        <article>
          <span>LATENCY P50</span>
          <strong data-p50>—</strong>
          <small>median request</small>
        </article>
        <article>
          <span>LATENCY P95</span>
          <strong data-p95>—</strong>
          <small>tail latency</small>
        </article>
        <article>
          <span>VALID RATE</span>
          <strong data-valid-rate>—</strong>
          <small>valid responses</small>
        </article>
      </div>

      <div class="evidence-readout">
        <span>OBSERVED TRADE-OFF</span>
        <p data-readout></p>
      </div>
    </div>

    <div class="evidence-panel__error" data-evidence-error hidden>
      <span class="evidence-panel__eyebrow">SOURCE TEMPORARILY UNAVAILABLE</span>
      <h3>Published evidence could not be loaded.</h3>
      <p>
        The portfolio never substitutes cached-looking or invented performance values when the
        source artifact cannot be read.
      </p>
    </div>
  </section>
</div>

<script>
  const initExperimentExplorer = () => {
    document.querySelectorAll('[data-experiment-explorer]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-experiment-tab]'));
      const loading = root.querySelector('[data-evidence-loading]');
      const empty = root.querySelector('[data-evidence-empty]');
      const result = root.querySelector('[data-evidence-result]');
      const error = root.querySelector('[data-evidence-error]');

      let requestId = 0;

      const setHidden = (node, hidden) => {
        if (node instanceof HTMLElement) node.hidden = hidden;
      };

      const setText = (selector, value) => {
        const node = root.querySelector(selector);
        if (node) node.textContent = value ?? '';
      };

      const showOnly = (target) => {
        setHidden(loading, target !== 'loading');
        setHidden(empty, target !== 'empty');
        setHidden(result, target !== 'result');
        setHidden(error, target !== 'error');
      };

      const formatDate = (value) => {
        if (!value) return 'Unknown';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value);
        return new Intl.DateTimeFormat('en', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(date);
      };

      const formatMs = (value) => {
        const number = Number(value);
        return Number.isFinite(number) ? `${Math.round(number)} ms` : '—';
      };

      const renderJevRouting = (data, tab) => {
        const row = data?.overview?.[0] ?? data?.routing?.summary?.[0];
        const leader = data?.leaderboard?.[0];
        const metadata = data?.metadata ?? {};
        if (!row) throw new Error('No published routing row');

        const accuracy = Number(row.accuracy);
        const validRate = Number(row.valid_rate ?? 0);
        const accuracyPct = Number.isFinite(accuracy) ? `${(accuracy * 100).toFixed(1)}%` : '—';
        const validPct = Number.isFinite(validRate) ? `${(validRate * 100).toFixed(1)}%` : '—';
        const cases = Number(row.requests ?? data?.kpi_cards?.total_requests ?? 0);
        const model = row.model ?? leader?.model ?? 'Unknown model';
        const quant = leader?.quant_label ? `Quantization: ${leader.quant_label}` : '';
        const dataset = row.dataset_label ?? leader?.dataset_label ?? row.dataset ?? 'Unknown';
        const hardware = metadata?.hardware
          ? `${metadata.hardware.device || ''} · ${metadata.hardware.chip || ''}`.replace(/^ · | · $/g, '')
          : '';

        setText('[data-result-title]', tab.dataset.title || 'Experiment');
        setText('[data-result-question]', tab.dataset.question || '');
        setText('[data-model]', model);
        setText('[data-quant]', quant);
        setText('[data-dataset]', dataset);
        setText('[data-cases]', cases ? `${cases} evaluated cases` : '');
        setText('[data-last-run]', formatDate(row.latest_run_at ?? leader?.latest_run_at));
        setText('[data-hardware]', hardware);
        setText('[data-accuracy]', accuracyPct);
        setText('[data-p50]', formatMs(row.latency_p50_ms));
        setText('[data-p95]', formatMs(row.latency_p95_ms));
        setText('[data-valid-rate]', validPct);
        setText(
          '[data-readout]',
          `Observed on the published run: ${accuracyPct} accuracy with ${formatMs(row.latency_p50_ms)} median latency across ${cases || 'the published'} cases. The evidence is fast to execute, but the measured task quality is currently low.`,
        );

        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
      };

      const selectTab = async (tab) => {
        tabs.forEach((candidate) => {
          const active = candidate === tab;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-selected', active ? 'true' : 'false');
          candidate.setAttribute('tabindex', active ? '0' : '-1');
        });

        const resultUrl = tab.dataset.resultUrl || '';
        if (!resultUrl) {
          setText('[data-empty-title]', tab.dataset.title || 'Experiment');
          setText('[data-empty-question]', tab.dataset.question || '');
          showOnly('empty');
          return;
        }

        const currentRequest = ++requestId;
        showOnly('loading');

        try {
          const response = await fetch(resultUrl, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (currentRequest !== requestId) return;

          if (tab.dataset.resultKind === 'jev-routing') renderJevRouting(data, tab);
          else throw new Error('Unsupported result adapter');

          showOnly('result');
        } catch (cause) {
          if (currentRequest !== requestId) return;
          console.warn('Experiment evidence unavailable', cause);
          showOnly('error');
        }
      };

      tabs.forEach((tab, index) => {
        if (!(tab instanceof HTMLButtonElement)) return;
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const delta = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1;
          const nextIndex = (index + delta + tabs.length) % tabs.length;
          const next = tabs[nextIndex];
          if (next instanceof HTMLButtonElement) {
            next.focus();
            selectTab(next);
          }
        });
      });

      const initial = tabs.find((tab) => tab instanceof HTMLButtonElement && Boolean(tab.dataset.resultUrl)) ?? tabs[0];
      if (initial instanceof HTMLButtonElement) selectTab(initial);
    });
  };

  initExperimentExplorer();
  document.addEventListener('astro:page-load', initExperimentExplorer);
</script>

<style>
  .experiment-explorer {
    display: grid;
    grid-template-columns: minmax(230px, 0.72fr) minmax(0, 1.6fr);
    gap: clamp(14px, 2vw, 22px);
    align-items: stretch;
  }

  .experiment-selector {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .experiment-tab {
    width: 100%;
    min-height: var(--touch-target-min);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    padding: 15px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-card) 78%, var(--surface-subtle));
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .experiment-tab:hover,
  .experiment-tab:focus-visible {
    border-color: color-mix(in srgb, var(--accent-blue) 40%, var(--border-medium));
    transform: translateX(2px);
  }

  .experiment-tab.is-active {
    border-color: color-mix(in srgb, var(--accent-blue) 58%, var(--border-medium));
    background: var(--surface-blue-subtle);
    box-shadow: inset 3px 0 0 var(--accent-blue);
  }

  .experiment-tab__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-subtle);
  }

  .status-dot--live {
    background: var(--accent-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 12%, transparent);
  }

  .experiment-tab strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 0.94rem;
    line-height: 1.3;
  }

  .experiment-tab__question {
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .evidence-panel {
    min-width: 0;
    min-height: 390px;
    padding: clamp(20px, 2.8vw, 30px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 92% 7%, color-mix(in srgb, var(--accent-blue) 8%, transparent), transparent 35%),
      var(--surface-card);
    box-shadow: var(--shadow-xs);
  }

  .evidence-panel__loading,
  .evidence-panel__empty,
  .evidence-panel__error {
    height: 100%;
    min-height: 330px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  [hidden] { display: none !important; }

  .evidence-panel__eyebrow {
    color: var(--accent-blue-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .evidence-panel__empty h3,
  .evidence-panel__error h3 {
    margin: 10px 0 7px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
  }

  .evidence-panel__empty p,
  .evidence-panel__error p {
    max-width: 640px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .evidence-panel__empty-note {
    margin-top: 16px !important;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .evidence-panel__header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: flex-start;
  }

  .evidence-panel__header h3 {
    margin: 8px 0 4px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    letter-spacing: -0.025em;
  }

  .evidence-panel__header p {
    max-width: 620px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .evidence-panel__header a {
    flex: 0 0 auto;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 760;
    text-decoration: none;
  }

  .evidence-context {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 22px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--border-subtle);
  }

  .evidence-context > div {
    min-width: 0;
    padding: 13px 14px;
    background: var(--surface-subtle);
  }

  .evidence-context span,
  .metric-grid span,
  .evidence-readout span {
    display: block;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 780;
    letter-spacing: 0.055em;
  }

  .evidence-context strong {
    display: block;
    margin-top: 5px;
    overflow: hidden;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 0.88rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .evidence-context small {
    display: block;
    margin-top: 3px;
    color: var(--ink-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .metric-grid article {
    min-width: 0;
    padding: 17px 15px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-canvas);
  }

  .metric-grid strong {
    display: block;
    margin-top: 8px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.28rem, 2vw, 1.7rem);
    letter-spacing: -0.035em;
  }

  .metric-grid small {
    display: block;
    margin-top: 3px;
    color: var(--ink-muted);
    font-size: 0.72rem;
  }

  .evidence-readout {
    margin-top: 14px;
    padding: 14px 16px;
    border-left: 3px solid var(--accent-blue);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--surface-blue-subtle);
  }

  .evidence-readout p {
    margin: 7px 0 0;
    color: var(--ink);
    font-size: 0.87rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .experiment-explorer { grid-template-columns: 1fr; }

    .experiment-selector {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .experiment-selector,
    .metric-grid,
    .evidence-context {
      grid-template-columns: 1fr;
    }

    .evidence-panel { min-height: 0; }

    .evidence-panel__header {
      flex-direction: column;
    }

    .experiment-tab:hover,
    .experiment-tab:focus-visible {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experiment-tab { transition: none; }
  }
</style>
