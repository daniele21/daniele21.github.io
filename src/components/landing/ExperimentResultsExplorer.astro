  .evidence-panel__header h3 {
    margin: 10px 0 5px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.15rem);
    font-weight: 840;
    letter-spacing: -0.045em;
    line-height: 1.06;
