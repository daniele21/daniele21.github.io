  .plot-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .plot-heading__eyebrow,
  .highlight > span,
  .evidence-takeaway > span {
    display: block;
    color: var(--ink-subtle);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 760;
    letter-spacing: 0.045em;
  }

  .plot-heading strong {
    display: block;
    margin-top: 4px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .plot-heading__note {
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .plot-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .plot-filters {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
