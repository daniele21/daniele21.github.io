  .jev-ranking__columns {
    padding: 0 16px 10px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 720;
  }

  .jev-ranking__columns > span:last-child {
    text-align: right;
  }

  .jev-ranking__columns small {
    display: block;
    color: var(--ink-subtle);
    font-size: 0.71rem;
