  }

  /* MEASURE: published-first selection and mobile-sized scientific graphics.
     Evidence is still loaded from the existing published artifacts only. */
  .experiment-index-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px 16px;
    margin-bottom: 12px;
