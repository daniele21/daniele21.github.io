    height: auto;
    min-height: 210px;
    margin-top: 6px;
    overflow: visible;
  }

  .plot-svg :global(.plot-grid line) {
    stroke: color-mix(in srgb, var(--ink-subtle) 16%, transparent);
    stroke-width: 1;
  }

  .plot-svg :global(.plot-axis-labels text) {
    fill: var(--ink-subtle);
    font-family: var(--font-body);
    font-size: var(--text-caption);
  }

  .plot-svg :global(.plot-frontier) {
    fill: none;
    stroke: var(--accent-blue);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 4px 8px color-mix(in srgb, var(--accent-blue) 18%, transparent));
  }

  .plot-svg :global(.plot-point circle) {
    fill: color-mix(in srgb, var(--accent-violet) 62%, var(--accent-blue));
    stroke: var(--surface-card);
    stroke-width: 3;
  }

  .plot-svg :global(.plot-point circle.is-local) {
    fill: var(--accent-blue);
  }

  .plot-svg :global(.plot-point circle.is-api) {
    fill: var(--accent-violet);
  }

  .plot-svg :global(.plot-point circle.is-frontier) {
    stroke-width: 3.5;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent-blue) 26%, transparent));
  }

  .plot-svg :global(.plot-point text) {
    fill: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
  }

  .plot-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .plot-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent-violet) 62%, var(--accent-blue));
  }

  .legend-dot--local {
    background: var(--accent-blue);
  }

  .legend-dot--api {
    background: var(--accent-violet);
  }

  .legend-dot--pilot {
    border: 2px solid var(--accent-violet);
    background: var(--surface-card);
  }

  .plot-svg :global(.plot-point circle.is-pilot) {
    fill: var(--surface-card);
    stroke: var(--accent-violet);
    stroke-width: 3;
  }

  .plot-evidence-note {
    margin: 6px 0 10px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.45;
  }

  .legend-line {
    width: 18px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--accent-blue);
  }

  .benchmark-highlights {
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    border-left: 1px solid var(--border-subtle);
    padding-left: clamp(18px, 2.4vw, 26px);
  }

  .highlight {
    flex: 1 1 0;
    padding: 14px 0;
  }

  .highlight + .highlight {
    border-top: 1px solid var(--border-subtle);
  }

  .highlight--accent {
    position: relative;
  }

  .highlight--accent::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 15px;
    bottom: 15px;
    width: 3px;
    border-radius: var(--radius-full);
    background: linear-gradient(180deg, var(--accent-blue), var(--accent-violet));
  }

  .highlight strong {
    display: block;
    margin-top: 6px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 830;
    letter-spacing: -0.04em;
  }

  .highlight small {
    display: block;
    margin-top: 4px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .evidence-takeaway {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    margin-top: 24px;
    padding: 18px 20px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-subtle));
    border-radius: var(--radius-md);
    background:
      linear-gradient(100deg, color-mix(in srgb, var(--accent-blue) 7%, var(--surface-card)), color-mix(in srgb, var(--accent-violet) 3%, var(--surface-card)));
  }

  .evidence-takeaway strong {
    display: block;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 780;
    line-height: 1.4;
  }

  .evidence-takeaway p {
    max-width: 760px;
    margin: 4px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  html[data-theme='dark'] .evidence-panel {
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.24);
  }

  @media (max-width: 900px) {
    .benchmark-story {
      grid-template-columns: 1fr;
    }

    .benchmark-highlights {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
