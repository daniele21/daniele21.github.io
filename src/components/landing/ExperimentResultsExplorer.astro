  .jev-mcb-rows {
    display: grid;
    gap: 3px;
    margin-top: 17px;
  }

  .jev-mcb-rows :global(.jev-mcb-row) {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(140px, 1.2fr);
    gap: 18px;
    align-items: center;
    padding: 12px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .jev-mcb-rows :global(.jev-mcb-row__model strong),
  .jev-mcb-rows :global(.jev-mcb-row__score strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 0.96rem;
