  .evidence-panel__header p {
    max-width: 720px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .source-link {
    flex: 0 0 auto;
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 760;
    text-decoration: none;
