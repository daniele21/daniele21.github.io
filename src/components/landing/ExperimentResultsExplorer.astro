  .plot-svg :global(.plot-interactive.is-selected circle:not(.plot-hit-area)),
  .plot-svg :global(.plot-interactive:focus-visible circle:not(.plot-hit-area)) {
    stroke: var(--ink-display);
    stroke-width: 3.2px;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent-blue) 36%, transparent));
  }

