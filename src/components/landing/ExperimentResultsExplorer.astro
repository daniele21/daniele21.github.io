    gap: 7px;
  }

  :global(.jev-model-row) {
    padding: 14px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-card) 90%, var(--surface-subtle));
