    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
    padding: 11px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-card));
  }

  .plot-selection > div {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .plot-selection__eyebrow {
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    font-weight: 760;
    letter-spacing: 0.06em;
  }

  .plot-selection strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
  }

  .plot-selection > span {
    flex: 0 0 auto;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    text-align: right;
