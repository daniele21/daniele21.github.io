---
interface Track {
  id?: string;
  title: string;
  question: string;
  status: string;
  resultUrl?: string;
  sourceUrl?: string;
  resultKind?: 'jev-routing' | 'mcb-overview';
}

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;
const sortedTracks = [...tracks].sort((a, b) => Number(Boolean(b.resultUrl)) - Number(Boolean(a.resultUrl)));
const initialIndex = Math.max(0, sortedTracks.findIndex((track) => Boolean(track.resultUrl)));

const selectorLabelFor = (track: Track) => {
  const labels: Record<string, string> = {
    'jev-vs-llm-routing': 'JEV vs LLM',
    'model-capability': 'Model Capability',
    'redactguard-local-anonymization': 'RedactGuard',
    'vlm-capability': 'VLM',
    'image-generation': 'Image Gen',
    diarization: 'Diarization',
  };
  return labels[track.id || ''] || track.title;
};
---

<div class="experiment-explorer" data-experiment-explorer>
  <div class="experiment-selector-wrap">
    <div class="experiment-selector" role="tablist" aria-label="Select experiment">
      {sortedTracks.map((track, index) => (
        <button
          type="button"
          class:list={['experiment-tab', { 'is-active': index === initialIndex }]}
          role="tab"
          aria-selected={index === initialIndex ? 'true' : 'false'}
          tabindex={index === initialIndex ? '0' : '-1'}
          data-experiment-tab
          data-track-id={track.id || ''}
          data-title={track.title}
          data-question={track.question}
          data-status={track.status}
          data-result-url={track.resultUrl || ''}
          data-source-url={track.sourceUrl || ''}
          data-result-kind={track.resultKind || ''}
        >
          <span
            class:list={['status-dot', { 'status-dot--live': Boolean(track.resultUrl) }]}
            aria-hidden="true"
          ></span>
          <span class="experiment-tab__title">{selectorLabelFor(track)}</span>
        </button>
      ))}
    </div>
  </div>

  <section class="evidence-panel" aria-live="polite" aria-label="Selected experiment evidence">
    <div class="evidence-panel__loading" data-evidence-loading hidden>
      Loading published evidence…
    </div>

    <div class="evidence-panel__empty" data-evidence-empty hidden>
      <div class="evidence-panel__empty-icon" aria-hidden="true">↗</div>
      <div>
        <span class="evidence-panel__eyebrow">NO PUBLIC SNAPSHOT YET</span>
        <h3 data-empty-title></h3>
        <p data-empty-question></p>
        <p class="evidence-panel__empty-note">
          Real runs exist outside the published repository snapshot. This view stays empty until a
          versioned evidence artifact is available.
        </p>
      </div>
    </div>

    <div class="evidence-panel__result" data-evidence-result hidden>
      <div class="evidence-panel__header">
        <div>
          <span class="evidence-panel__eyebrow">
            <span class="live-dot" aria-hidden="true"></span>
            PUBLISHED BENCHMARK SNAPSHOT
          </span>
          <h3 data-result-title></h3>
          <p data-result-question></p>
        </div>
        <a class="source-link" data-result-source href="#" target="_blank" rel="noopener noreferrer">
          Source <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="run-summary" data-mcb-scope aria-label="Benchmark scope">
        <span><strong data-model-count>—</strong> models</span>
        <span><strong data-request-count>—</strong> <span data-count-label>requests</span></span>
        <span><strong data-dataset>—</strong> <span data-scope-label>dataset</span></span>
        <span><strong data-runtime>—</strong> <span data-runtime-label>runtime</span></span>
      </div>

      <div class="jev-summary" data-jev-summary hidden>
        <div class="jev-tradeoff">
          <div class="jev-tradeoff__main">
            <span class="jev-eyebrow">WHAT THE RESULTS SHOW</span>
            <strong data-jev-takeaway-headline>—</strong>
            <p data-jev-takeaway-description></p>
          </div>
          <div class="jev-tradeoff__numbers">
            <div>
              <span>Accuracy difference</span>
              <strong data-jev-quality-gap>—</strong>
            </div>
            <div>
              <span>Median response time</span>
              <strong data-jev-speed-comparison>—</strong>
            </div>
          </div>
        </div>

        <div class="jev-ranking">
          <div class="jev-ranking__header">
            <div>
              <span class="jev-eyebrow">ROUTING RESULTS · MATCHED RUN SIZE</span>
              <h4>How the models compare</h4>
            </div>
            <span data-jev-coverage>—</span>
          </div>
          <div class="jev-ranking__columns" aria-hidden="true">
            <span>Model</span>
            <span>Accuracy <small>Higher is better ↑</small></span>
            <span>Median latency <small>Lower is better ↓</small></span>
          </div>
          <div class="jev-ranking__rows" data-jev-rows role="list"></div>
          <div class="jev-ranking__note" data-jev-partial hidden></div>
        </div>
        <p class="jev-method-note">The main ranking compares runs with 77 requests per model. The shorter run stays separate. Response time is the median (p50); suitability depends on the task.</p>
      </div>

      <div class="benchmark-story" data-mcb-story>
        <div class="performance-plot">
          <div class="plot-heading">
            <div>
              <span class="plot-heading__eyebrow">QUALITY × LATENCY</span>
              <strong>Local routing frontier</strong>
            </div>
            <span class="plot-heading__note">Accuracy vs p50 latency</span>
          </div>

          <div class="plot-toolbar" data-mcb-toolbar hidden>
            <span>Quality <span aria-hidden="true">↑</span> &nbsp;·&nbsp; Median latency <span aria-hidden="true">→</span></span>
            <div class="plot-filters" role="group" aria-label="Filter models by deployment">
              <button type="button" data-mcb-filter="all" aria-pressed="true">All</button>
              <button type="button" data-mcb-filter="local" aria-pressed="false">Local</button>
              <button type="button" data-mcb-filter="api" aria-pressed="false">API</button>
            </div>
          </div>

          <svg
            class="plot-svg"
            data-performance-plot
            viewBox="0 0 620 250"
            role="img"
            aria-label="Quality versus median latency; focus or select a model point for details"
          ></svg>

          <div class="plot-selection" data-mcb-detail hidden aria-live="polite">
            <div>
              <span class="plot-selection__eyebrow">INSPECT MODEL</span>
              <strong data-mcb-selected-name>—</strong>
            </div>
            <span data-mcb-selected-metrics>—</span>
          </div>

          <div class="plot-legend">
            <span><i class="legend-dot legend-dot--all"></i>Measured model</span>
            <span><i class="legend-line"></i>Pareto frontier</span>
          </div>
        </div>

        <div class="benchmark-highlights" aria-label="Benchmark highlights">
          <div class="highlight">
            <span>BEST QUALITY</span>
            <strong data-best-quality>—</strong>
            <small data-best-quality-model></small>
          </div>
          <div class="highlight highlight--accent">
            <span>BALANCE POINT</span>
            <strong data-balance>—</strong>
            <small data-balance-model></small>
          </div>
          <div class="highlight">
            <span>FASTEST</span>
            <strong data-fastest>—</strong>
            <small data-fastest-model></small>
          </div>
        </div>
      </div>

      <div class="evidence-takeaway" data-mcb-takeaway>
        <span>TAKEAWAY</span>
        <div>
          <strong data-readout-title></strong>
          <p data-readout></p>
        </div>
      </div>
    </div>

    <div class="evidence-panel__error" data-evidence-error hidden>
      <span class="evidence-panel__eyebrow">SOURCE UNAVAILABLE</span>
      <h3>Published evidence could not be loaded.</h3>
      <p>No fallback or invented performance values are shown.</p>
    </div>
  </section>
</div>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';

  const initExperimentExplorer = () => {
    document.querySelectorAll('[data-experiment-explorer]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-experiment-tab]'));
      const loading = root.querySelector('[data-evidence-loading]');
      const empty = root.querySelector('[data-evidence-empty]');
      const result = root.querySelector('[data-evidence-result]');
      const error = root.querySelector('[data-evidence-error]');

      let requestId = 0;

      const setHidden = (node, hidden) => {
        if (node instanceof HTMLElement) node.hidden = hidden;
      };

      const setText = (selector, value) => {
        const node = root.querySelector(selector);
        if (node) node.textContent = value ?? '';
      };

      const showOnly = (target) => {
        setHidden(loading, target !== 'loading');
        setHidden(empty, target !== 'empty');
        setHidden(result, target !== 'result');
        setHidden(error, target !== 'error');
      };

      const shortModel = (value) => {
        const model = String(value || '');
        return model
          .replace(/^qwen3\.5-/i, 'Qwen 3.5 ')
          .replace(/^nemotron-nano-/i, 'Nemotron ')
          .replace(/-q4km$/i, ' Q4')
          .replace(/-q8$/i, ' Q8')
          .replace(/-/g, ' ')
          .replace(/\b(\d+(?:\.\d+)?)b\b/gi, '$1B');
      };

      const formatPct = (value) => {
        const number = Number(value);
        return Number.isFinite(number) ? `${(number * 100).toFixed(1)}%` : '—';
      };

      const formatSeconds = (value) => {
        const number = Number(value);
        if (!Number.isFinite(number)) return '—';
        if (number < 1000) return `${Math.round(number)} ms`;
        return `${(number / 1000).toFixed(1)} s`;
      };

      const createSvg = (tag, attrs = {}) => {
        const node = document.createElementNS(SVG_NS, tag);
        Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, String(value)));
        return node;
      };

      const mcbState = {
        points: [],
        filter: 'all',
        selected: null,
      };

      const focusMcbPoint = (point) => {
        if (!point) return;
        mcbState.selected = point.model_signature || point.model_key;
        setText('[data-mcb-selected-name]', shortModel(point.model_key));
        setText(
          '[data-mcb-selected-metrics]',
          point.qualityNumber.toFixed(1) + ' / 100 quality · ' +
            formatSeconds(point.latencyNumber) + ' p50 · ' +
            (point.deployment === 'api' ? 'API' : 'Local'),
        );
        root.querySelectorAll('[data-mcb-point]').forEach((group) => {
          const selected = group.getAttribute('data-mcb-point') === mcbState.selected;
          group.classList.toggle('is-selected', selected);
          group.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
      };

      const plotMcbOverview = (data) => {
        const svg = root.querySelector('[data-performance-plot]');
        if (!(svg instanceof SVGElement)) return [];

        const points = Array.isArray(data?.frontier?.points)
          ? data.frontier.points
              .map((point) => ({
                ...point,
                qualityNumber: Number(point.quality),
                latencyNumber: Number(point.latency_p50_ms),
              }))
              .filter(
                (point) =>
                  Number.isFinite(point.qualityNumber) &&
                  Number.isFinite(point.latencyNumber) &&
                  point.latencyNumber > 0,
              )
          : [];
        mcbState.points = points;

        const redraw = () => {
          while (svg.firstChild) svg.removeChild(svg.firstChild);
          const visible = points
            .filter((point) => mcbState.filter === 'all' || point.deployment === mcbState.filter)
            .sort((a, b) => a.latencyNumber - b.latencyNumber);
          if (!visible.length) return;

          const W = 620;
          const H = 250;
          const pad = { left: 46, right: 22, top: 16, bottom: 38 };
          const innerW = W - pad.left - pad.right;
          const innerH = H - pad.top - pad.bottom;
          const minLatency = Math.min(...visible.map((point) => point.latencyNumber)) / 1.25;
          const maxLatency = Math.max(...visible.map((point) => point.latencyNumber)) * 1.3;
          const logMin = Math.log10(minLatency);
          const logSpan = Math.max(0.01, Math.log10(maxLatency) - logMin);
          const x = (value) => pad.left + (Math.log10(value) - logMin) / logSpan * innerW;
          const y = (value) => pad.top + (100 - value) / 100 * innerH;

          const grid = createSvg('g', { class: 'plot-grid' });
          const labels = createSvg('g', { class: 'plot-axis-labels' });
          [0, 25, 50, 75, 100].forEach((tick) => {
            const yy = y(tick);
            grid.appendChild(createSvg('line', {
              x1: pad.left, y1: yy, x2: W - pad.right, y2: yy,
            }));
            const text = createSvg('text', { x: pad.left - 10, y: yy + 4, 'text-anchor': 'end' });
            text.textContent = String(tick);
            labels.appendChild(text);
          });

          [250, 500, 1000, 2000, 5000, 10000, 20000]
            .filter((tick) => tick >= minLatency && tick <= maxLatency)
            .forEach((tick) => {
              const xx = x(tick);
              grid.appendChild(createSvg('line', {
                x1: xx, x2: xx, y1: pad.top, y2: H - pad.bottom,
              }));
              const text = createSvg('text', {
                x: xx, y: H - 12, 'text-anchor': 'middle',
              });
              text.textContent = formatSeconds(tick);
              labels.appendChild(text);
            });
          svg.appendChild(grid);
          svg.appendChild(labels);

          // The projected artifact carries the comparability-aware Pareto flags.
          // Do not reconstruct a mixed local/API Pareto from visual positions.
          const frontier = visible
            .filter((point) => point.pareto_latency === true)
            .sort((a, b) => a.latencyNumber - b.latencyNumber);
          if (frontier.length > 1) {
            svg.appendChild(createSvg('polyline', {
              class: 'plot-frontier',
              points: frontier.map((point) => x(point.latencyNumber) + ',' + y(point.qualityNumber)).join(' '),
            }));
          }

          visible.forEach((point) => {
            const key = point.model_signature || point.model_key;
            const group = createSvg('g', {
              class: 'plot-point plot-interactive',
              role: 'button',
              tabindex: '0',
              'aria-pressed': 'false',
              'aria-label': shortModel(point.model_key) + ', quality ' +
                point.qualityNumber.toFixed(1) + '/100, p50 ' +
                formatSeconds(point.latencyNumber) + ', ' + point.deployment,
              'data-mcb-point': key,
            });
            const isApi = point.deployment === 'api';
            const circle = createSvg('circle', {
              cx: x(point.latencyNumber),
              cy: y(point.qualityNumber),
              r: point.pareto_latency ? 7 : 6,
              class: (isApi ? 'is-api' : 'is-local') +
                (point.pareto_latency ? ' is-frontier' : ''),
            });
            const hit = createSvg('circle', {
              cx: x(point.latencyNumber),
              cy: y(point.qualityNumber),
              r: 16,
              class: 'plot-hit-area',
            });
            const title = createSvg('title');
            title.textContent = group.getAttribute('aria-label') || '';
            group.appendChild(circle);
            group.appendChild(hit);
            group.appendChild(title);
            group.addEventListener('click', () => focusMcbPoint(point));
            group.addEventListener('focus', () => focusMcbPoint(point));
            group.addEventListener('mouseenter', () => focusMcbPoint(point));
            group.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                focusMcbPoint(point);
              }
            });
            svg.appendChild(group);
          });

          const selectedPoint = visible.find(
            (point) => (point.model_signature || point.model_key) === mcbState.selected,
          );
          focusMcbPoint(selectedPoint || [...visible].sort(
            (a, b) => b.qualityNumber - a.qualityNumber,
          )[0]);
        };

        const toolbar = root.querySelector('[data-mcb-toolbar]');
        setHidden(toolbar, false);
        setHidden(root.querySelector('[data-mcb-detail]'), false);
        root.querySelectorAll('[data-mcb-filter]').forEach((button) => {
          button.setAttribute('aria-pressed',
            button.getAttribute('data-mcb-filter') === mcbState.filter ? 'true' : 'false');
        });
        mcbState.redraw = redraw;
        redraw();
        return points;
      };

      root.querySelectorAll('[data-mcb-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-mcb-filter');
          if (!['all', 'local', 'api'].includes(filter)) return;
          mcbState.filter = filter;
          root.querySelectorAll('[data-mcb-filter]').forEach((option) => {
            option.setAttribute('aria-pressed',
              option.getAttribute('data-mcb-filter') === filter ? 'true' : 'false');
          });
          if (typeof mcbState.redraw === 'function') mcbState.redraw();
        });
      });

      const renderMcbOverview = (data, tab) => {
        setHidden(root.querySelector('[data-jev-summary]'), true);
        setHidden(root.querySelector('[data-mcb-scope]'), false);
        setHidden(root.querySelector('[data-mcb-story]'), false);
        setHidden(root.querySelector('[data-mcb-takeaway]'), false);
        setHidden(root.querySelector('[data-jev-toolbar]'), true);
        setHidden(root.querySelector('[data-jev-detail]'), true);
        setHidden(root.querySelector('[data-jev-evidence-note]'), true);
        const points = plotMcbOverview(data);
        if (!points.length) throw new Error('No published MCB frontier points');

        const models = Array.isArray(data?.models) ? data.models : [];
        const capabilities = Array.isArray(data?.capabilities) ? data.capabilities : [];
        const cells = Array.isArray(data?.cells) ? data.cells : [];

        const overallBest = [...points].sort(
          (a, b) => Number(b.quality) - Number(a.quality),
        )[0];

        const localPoints = points.filter((point) => point.deployment === 'local');
        const bestLocal = [...localPoints].sort(
          (a, b) => Number(b.quality) - Number(a.quality),
        )[0];
        const fastestLocal = [...localPoints].sort(
          (a, b) => Number(a.latency_p50_ms) - Number(b.latency_p50_ms),
        )[0];

        setText('[data-result-title]', tab.dataset.title || 'Model Capability Benchmark');
        setText('[data-result-question]', tab.dataset.question || '');
        setText('[data-model-count]', String(models.length || points.length));
        setText('[data-request-count]', String(cells.length || '—'));
        setText('[data-count-label]', 'published cells');
        setText('[data-dataset]', String(capabilities.length || '—'));
        setText('[data-scope-label]', 'capabilities');
        setText('[data-runtime]', '2');
        setText('[data-runtime-label]', 'execution modes');

        setText('[data-best-quality]', `${Number(overallBest.quality).toFixed(1)}`);
        setText('[data-best-quality-model]', shortModel(overallBest.model_key));

        setText(
          '[data-balance]',
          bestLocal
            ? `${Number(bestLocal.quality).toFixed(1)} · ${formatSeconds(bestLocal.latency_p50_ms)}`
            : '—',
        );
        setText(
          '[data-balance-model]',
          bestLocal ? `${shortModel(bestLocal.model_key)} · best local quality` : '',
        );

        setText(
          '[data-fastest]',
          fastestLocal ? formatSeconds(fastestLocal.latency_p50_ms) : '—',
        );
        setText(
          '[data-fastest-model]',
          fastestLocal
            ? `${shortModel(fastestLocal.model_key)} · ${Number(fastestLocal.quality).toFixed(1)} quality`
            : '',
        );

        if (bestLocal && overallBest) {
          const qualityGap = Number(overallBest.quality) - Number(bestLocal.quality);
          const speedRatio =
            Number(bestLocal.latency_p50_ms) / Number(overallBest.latency_p50_ms);

          setText(
            '[data-readout-title]',
            `${shortModel(bestLocal.model_key)} is the strongest local point in the published snapshot.`,
          );
          setText(
            '[data-readout]',
            `${Number(bestLocal.quality).toFixed(1)} aggregate quality at ${formatSeconds(bestLocal.latency_p50_ms)} p50. The top overall point is ${shortModel(overallBest.model_key)} at ${Number(overallBest.quality).toFixed(1)}, a ${qualityGap.toFixed(1)}-point gap${Number.isFinite(speedRatio) ? ` while the local point is ${speedRatio.toFixed(1)}× slower` : ''}.`,
          );
        }

        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) {
          source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
        }

        const heading = root.querySelector('.plot-heading__eyebrow');
        if (heading) heading.textContent = 'MODEL CAPABILITY × LATENCY';

        const plotTitle = root.querySelector('.plot-heading strong');
        if (plotTitle) plotTitle.textContent = 'Model performance map';

        const plotNote = root.querySelector('.plot-heading__note');
        if (plotNote) plotNote.textContent = 'Quality / 100 · Log-scale p50';

        const legend = root.querySelector('.plot-legend');
        if (legend) {
          legend.innerHTML =
            '<span><i class="legend-dot legend-dot--local"></i>Local</span><span><i class="legend-dot legend-dot--api"></i>API</span><span>Different runtime environments</span>';
        }

        const highlightLabels = root.querySelectorAll('.highlight > span');
        if (highlightLabels[0]) highlightLabels[0].textContent = 'BEST OVERALL';
        if (highlightLabels[1]) highlightLabels[1].textContent = 'BEST LOCAL';
        if (highlightLabels[2]) highlightLabels[2].textContent = 'FASTEST LOCAL';
      };

      const renderJevRouting = (data, tab) => {
        const rows = Array.isArray(data?.overview) ? data.overview : [];
        const validRows = rows
          .map((row) => ({
            ...row,
            accuracyValue: Number(row.accuracy),
            latencyValue: Number(row.latency_p50_ms),
            cases: Number(row.requests),
          }))
          .filter((row) =>
            Number.isFinite(row.accuracyValue) &&
            Number.isFinite(row.latencyValue) && row.latencyValue > 0 &&
            Number.isFinite(row.cases) && row.cases > 0,
          );
        if (!validRows.length) throw new Error('No comparable routing evidence');

        // Equal dataset size is necessary before presenting model rankings.
        const coverage = new Map();
        validRows.forEach((row) =>
          coverage.set(row.cases, (coverage.get(row.cases) || 0) + 1),
        );
        const commonCaseCount = [...coverage.keys()].sort(
          (a, b) => coverage.get(b) - coverage.get(a) || b - a,
        )[0];
        const comparable = validRows
          .filter((row) => row.cases === commonCaseCount)
          .sort((a, b) => b.accuracyValue - a.accuracyValue);
        const partial = validRows.filter((row) => row.cases !== commonCaseCount);
        if (comparable.length < 2) throw new Error('Insufficient matched routing runs');

        const bestQuality = comparable[0];
        // Compare the two independently observable endpoints on matched cases:
        // highest accuracy versus lowest median latency. No subjective threshold.
        const alternative = [...comparable]
          .sort((a, b) => a.latencyValue - b.latencyValue)[0];
        const speedup = bestQuality.latencyValue / alternative.latencyValue;
        const accuracyLoss = (bestQuality.accuracyValue - alternative.accuracyValue) * 100;
        const sameModel = bestQuality.model === alternative.model;

        setText('[data-result-title]', tab.dataset.title || 'JEV vs LLM · Routing');
        setText('[data-result-question]', 'Compare routing accuracy with typical response time.');
        setText('[data-model-count]', String(validRows.length));
        setText('[data-request-count]', String(
          validRows.reduce((sum, row) => sum + row.cases, 0),
        ));
        setText('[data-count-label]', 'model-requests');
        setText('[data-dataset]', String(commonCaseCount));
        setText('[data-scope-label]', 'cases per comparable model');
        setText('[data-runtime]', 'Local');
        setText('[data-runtime-label]', 'execution');

        setText(
          '[data-jev-takeaway-headline]',
          sameModel
            ? shortModel(bestQuality.model) + ' leads on both quality and speed.'
            : shortModel(alternative.model) + ' responds ' + speedup.toFixed(1) + '× faster.',
        );
        setText(
          '[data-jev-takeaway-description]',
          sameModel
            ? 'In this published comparison it has both the highest accuracy and the shortest median response time.'
            : 'Compared with ' + shortModel(bestQuality.model) + ', it gives up ' +
                accuracyLoss.toFixed(1) + ' percentage points of accuracy. ' +
                'Which trade-off is acceptable depends on the application.',
        );
        setText(
          '[data-jev-quality-gap]',
          sameModel ? 'No trade-off' : '−' + accuracyLoss.toFixed(1) + ' pts',
        );
        setText(
          '[data-jev-speed-comparison]',
          formatSeconds(alternative.latencyValue) + ' vs ' +
            formatSeconds(bestQuality.latencyValue),
        );
        setText(
          '[data-jev-coverage]',
          comparable.length + ' models · ' + commonCaseCount + ' cases each',
        );

        const container = root.querySelector('[data-jev-rows]');
        if (!(container instanceof HTMLElement)) throw new Error('Missing JEV comparison list');
        container.replaceChildren();

        const make = (tag, cls, value) => {
          const node = document.createElement(tag);
          if (cls) node.className = cls;
          if (value != null) node.textContent = String(value);
          return node;
        };
        comparable.forEach((row) => {
          const isQuality = row.model === bestQuality.model;
          const isAlternative = !sameModel && row.model === alternative.model;
          const item = make('div', 'jev-model-row' + (isAlternative ? ' is-alternative' : ''), null);
          item.setAttribute('role', 'listitem');

          const nameCell = make('div', 'jev-model-row__name', null);
          nameCell.appendChild(make('strong', '', shortModel(row.model)));
          if (isQuality) nameCell.appendChild(make('small', '', 'Most accurate'));
          else if (isAlternative) nameCell.appendChild(make('small', '', 'Fastest response'));

          const accuracyCell = make('div', 'jev-model-row__accuracy', null);
          const accuracyTop = make('div', 'jev-model-row__accuracy-head', null);
          accuracyTop.appendChild(make('strong', '', formatPct(row.accuracyValue)));
          accuracyCell.appendChild(accuracyTop);
          accuracyCell.appendChild(make('small', 'jev-model-row__mobile-label', 'Accuracy'));
          const bar = make('div', 'jev-model-row__track', null);
          bar.setAttribute('aria-hidden', 'true');
          const fill = make('span', 'jev-model-row__fill', null);
          fill.style.width = Math.max(0, Math.min(100, row.accuracyValue * 100)).toFixed(1) + '%';
          bar.appendChild(fill);
          accuracyCell.appendChild(bar);

          const latencyCell = make('div', 'jev-model-row__latency', null);
          latencyCell.appendChild(make('strong', '', formatSeconds(row.latencyValue)));
          latencyCell.appendChild(make('small', '', 'Median response'));
          item.appendChild(nameCell);
          item.appendChild(accuracyCell);
          item.appendChild(latencyCell);
          container.appendChild(item);
        });

        const partialNotice = root.querySelector('[data-jev-partial]');
        if (partial.length && partialNotice instanceof HTMLElement) {
          partialNotice.replaceChildren();
          const label = make('strong', '', 'Separate shorter run: ');
          partialNotice.appendChild(label);
          partialNotice.appendChild(document.createTextNode(
            partial.map((row) =>
              shortModel(row.model) + ' · ' + row.cases + ' cases · ' +
              formatPct(row.accuracyValue) + ' accuracy · ' +
              formatSeconds(row.latencyValue) + ' p50',
            ).join('; ') + '. Excluded from the ranking.',
          ));
        }
        setHidden(partialNotice, !partial.length);

        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) {
          source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
        }

        setHidden(root.querySelector('[data-jev-summary]'), false);
        setHidden(root.querySelector('[data-mcb-scope]'), true);
        setHidden(root.querySelector('[data-mcb-story]'), true);
        setHidden(root.querySelector('[data-mcb-takeaway]'), true);
      };

      const selectTab = async (tab) => {
        tabs.forEach((candidate) => {
          const active = candidate === tab;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-selected', active ? 'true' : 'false');
          candidate.setAttribute('tabindex', active ? '0' : '-1');
        });

        const currentRequest = ++requestId;
        const resultUrl = tab.dataset.resultUrl || '';
        if (!resultUrl) {
          setText('[data-empty-title]', tab.dataset.title || 'Experiment');
          setText('[data-empty-question]', tab.dataset.question || '');
          showOnly('empty');
          return;
        }

        showOnly('loading');

        try {
          const response = await fetch(resultUrl, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (currentRequest !== requestId) return;

          if (tab.dataset.resultKind === 'jev-routing') renderJevRouting(data, tab);
          else if (tab.dataset.resultKind === 'mcb-overview') renderMcbOverview(data, tab);
          else throw new Error('Unsupported result adapter');

          showOnly('result');
        } catch (cause) {
          if (currentRequest !== requestId) return;
          console.warn('Experiment evidence unavailable', cause);
          showOnly('error');
        }
      };

      tabs.forEach((tab, index) => {
        if (!(tab instanceof HTMLButtonElement)) return;

        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const delta = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (index + delta + tabs.length) % tabs.length;
          const next = tabs[nextIndex];
          if (next instanceof HTMLButtonElement) {
            next.focus();
            next.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
            selectTab(next);
          }
        });
      });

      const initial =
        tabs.find((tab) => tab instanceof HTMLButtonElement && tab.getAttribute('aria-selected') === 'true') ??
        tabs.find((tab) => tab instanceof HTMLButtonElement && Boolean(tab.dataset.resultUrl)) ??
        tabs[0];
      if (initial instanceof HTMLButtonElement) selectTab(initial);
    });
  };

  initExperimentExplorer();
  document.addEventListener('astro:page-load', initExperimentExplorer);
</script>

