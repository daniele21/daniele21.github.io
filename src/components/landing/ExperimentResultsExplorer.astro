    justify-content: flex-end;
    gap: 14px;
  }

  .jev-mcb-rows :global(.jev-mcb-row__track) {
    height: 8px;
    width: min(100%, 240px);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent-blue) 13%, var(--surface-subtle));
    overflow: hidden;
  }

  .jev-mcb-rows :global(.jev-mcb-row__fill) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-violet));
  }

  .jev-mcb-bridge__note {
    padding-top: 13px;
    margin-top: 7px;
    border-top: 1px solid var(--border-subtle);
  }

  .jev-local-details {
    margin-top: 14px;
