---
interface Track {
  id?: string;
  title: string;
  question: string;
  status: string;
  resultUrl?: string;
  sourceUrl?: string;
  resultKind?: 'jev-public-summary' | 'mcb-overview' | 'redactguard-public-summary';
  relatedResultUrl?: string;
  relatedSourceUrl?: string;
}

interface Props {
  tracks: Track[];
}

import '../../styles/redactguardInsights.css';

const { tracks } = Astro.props;
const sortedTracks = [...tracks].sort((a, b) => Number(Boolean(b.resultUrl)) - Number(Boolean(a.resultUrl)));
const initialIndex = Math.max(0, sortedTracks.findIndex((track) => Boolean(track.resultUrl)));

const selectorLabelFor = (track: Track) => {
  const labels: Record<string, string> = {
    'jev-vs-llm-routing': 'JEV vs LLM',
    'model-capability': 'Model Capability',
    'redactguard-local-anonymization': 'RedactGuard',
    'vlm-capability': 'VLM',
    'image-generation': 'Image Gen',
    diarization: 'Diarization',
  };
  return labels[track.id || ''] || track.title;
};
---

<div class="experiment-explorer" data-experiment-explorer>
  <div class="experiment-index-heading">
    <div>
      <span class="experiment-index-heading__eyebrow">BROWSE THE EVIDENCE</span>
      <h3>Choose a benchmark</h3>
    </div>
    <span class="experiment-index-heading__count">{sortedTracks.filter((track) => Boolean(track.resultUrl)).length} / {sortedTracks.length} published</span>
  </div>
  <div class="experiment-rail-guide">
    <span>SWIPE TO EXPLORE <span aria-hidden="true">→</span></span>
    <div class="experiment-rail-actions">
      <span class="experiment-rail-count" data-experiment-position aria-live="polite">01 / {String(sortedTracks.length).padStart(2, '0')}</span>
      <button type="button" data-experiment-prev aria-label="Previous benchmark" disabled>←</button>
      <button type="button" data-experiment-next aria-label="Next benchmark">→</button>
    </div>
  </div>
  <div class="experiment-selector-wrap">
    <div class="experiment-selector" role="tablist" aria-label="Swipe through benchmarks and tap to select" data-experiment-rail>
      {sortedTracks.map((track, index) => (
        <button
          type="button"
          class:list={['experiment-tab', { 'is-active': index === initialIndex }]}
          role="tab"
          aria-selected={index === initialIndex ? 'true' : 'false'}
          tabindex={index === initialIndex ? '0' : '-1'}
          data-experiment-tab
          data-published={Boolean(track.resultUrl) ? 'true' : 'false'}
          data-track-id={track.id || ''}
          data-title={track.title}
          data-question={track.question}
          data-status={track.status}
          data-result-url={track.resultUrl || ''}
          data-source-url={track.sourceUrl || ''}
          data-result-kind={track.resultKind || ''}
          data-related-result-url={track.relatedResultUrl || ''}
          data-related-source-url={track.relatedSourceUrl || ''}
        >
          <span
            class:list={['status-dot', { 'status-dot--live': Boolean(track.resultUrl) }]}
            aria-hidden="true"
          ></span>
          <span class="experiment-tab__copy">
            <span class="experiment-tab__title">{selectorLabelFor(track)}</span>
            <span class="experiment-tab__availability">{track.resultUrl ? (track.status.includes('PARTIAL') ? 'Partial evidence' : 'Published results') : 'Not published yet'}</span>
            <span class="experiment-tab__question">{track.question}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <section class="evidence-panel" aria-live="polite" aria-label="Selected experiment evidence">
    <div class="evidence-panel__loading" data-evidence-loading hidden>
      Loading published evidence…
    </div>

    <div class="evidence-panel__empty" data-evidence-empty hidden>
      <div class="evidence-panel__empty-icon" aria-hidden="true">↗</div>
      <div>
        <span class="evidence-panel__eyebrow">NO PUBLIC SNAPSHOT YET</span>
        <h3 data-empty-title></h3>
        <p data-empty-question></p>
        <p class="evidence-panel__empty-note">
          Real runs exist outside the published repository snapshot. This view stays empty until a
          versioned evidence artifact is available.
        </p>
      </div>
    </div>

    <div class="evidence-panel__result" data-evidence-result hidden>
      <div class="evidence-panel__header">
        <div>
          <span class="evidence-panel__eyebrow">
            <span class="live-dot" aria-hidden="true"></span>
            <span data-result-eyebrow>PUBLISHED BENCHMARK SNAPSHOT</span>
          </span>
          <h3 data-result-title></h3>
          <p data-result-question></p>
        </div>
        <a class="source-link" data-result-source href="#" target="_blank" rel="noopener noreferrer">
          Source <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="evidence-takeaway" data-mcb-takeaway>
        <span>TAKEAWAY</span>
        <div>
          <strong data-readout-title></strong>
          <p data-readout></p>
        </div>
      </div>
      <div class="run-summary" data-mcb-scope aria-label="Swipe through benchmark scope metrics" role="region" tabindex="0">
        <span><strong data-model-count>—</strong> models</span>
        <span><strong data-request-count>—</strong> <span data-count-label>requests</span></span>
        <span><strong data-dataset>—</strong> <span data-scope-label>dataset</span></span>
        <span><strong data-runtime>—</strong> <span data-runtime-label>runtime</span></span>
      </div>

      <div class="jev-summary" data-jev-summary hidden>
        <div class="jev-mcb-bridge">
          <div class="jev-mcb-bridge__header">
            <div>
              <span class="jev-eyebrow">RELATED EVIDENCE · MODEL CAPABILITY BENCHMARK</span>
              <h4>JEV and GPT Luna, tested on the same task</h4>
              <p data-jev-mcb-meta>Intent classification · comparing identical benchmark signatures</p>
            </div>
            <a data-jev-mcb-source href="#" target="_blank" rel="noopener noreferrer">MCB source ↗</a>
          </div>
          <div class="jev-mcb-rows" data-jev-mcb-rows role="list"></div>
          <p class="jev-mcb-bridge__note" data-jev-mcb-note>
            This is Model Capability Benchmark evidence, not a result from the separate Jev vs LLM suite.
          </p>
        </div>

        <details class="jev-local-details" data-jev-local-details>
          <summary>
            <span>
              <strong>Explore separate local-routing runs</strong>
              <small>Different benchmark · includes latency measurements</small>
            </span>
            <span aria-hidden="true">+</span>
          </summary>
        <div class="jev-coverage-banner" role="note">
          <div>
            <span class="jev-eyebrow">EVIDENCE AVAILABLE</span>
            <strong data-jev-published-scope>—</strong>
            <p data-jev-scope-note></p>
          </div>
          <span class="jev-coverage-banner__count" data-jev-experiment-count>—</span>
          <div class="jev-stage-coverage" data-jev-stage-coverage aria-label="Public evidence by experiment type"></div>
        </div>
        <div class="jev-tradeoff">
          <div class="jev-tradeoff__main">
            <span class="jev-eyebrow">WHAT THE RESULTS SHOW</span>
            <strong data-jev-takeaway-headline>—</strong>
            <p data-jev-takeaway-description></p>
          </div>
          <div class="jev-tradeoff__numbers">
            <div>
              <span>Accuracy difference</span>
              <strong data-jev-quality-gap>—</strong>
            </div>
            <div>
              <span>Median response time</span>
              <strong data-jev-speed-comparison>—</strong>
            </div>
          </div>
        </div>

        <div class="jev-ranking">
          <div class="jev-ranking__header">
            <div>
              <span class="jev-eyebrow">ROUTING · EQUAL REQUEST COUNT</span>
              <h4>How local models compare</h4>
            </div>
            <span data-jev-coverage>—</span>
          </div>
          <div class="jev-ranking__columns" aria-hidden="true">
            <span>Model</span>
            <span>Accuracy <small>Higher is better ↑</small></span>
            <span>Median latency <small>Lower is better ↓</small></span>
          </div>
          <div class="jev-ranking__rows" data-jev-rows role="list"></div>
          <div class="jev-ranking__note" data-jev-partial hidden></div>
        </div>
        <p class="jev-method-note" data-jev-method-note>Runs with the same request count are shown together; identical samples and configurations have not been independently verified.</p>
        </details>
      </div>

      <div class="rg-summary" data-rg-summary hidden>
        <div class="rg-topline">
          <div>
            <span class="rg-label">PRIVACY BENCHMARK</span>
            <h4>How well do local models protect sensitive data?</h4>
          </div>
          <span class="rg-status" data-rg-publication-status>Measured evidence</span>
        </div>

        <div class="rg-dataset-picker" data-rg-datasets role="group" aria-label="Select RedactGuard test dataset"></div>

        <div class="rg-detail" aria-live="polite">
          <div class="rg-detail__main">
            <span class="rg-label" data-rg-kind>DATASET</span>
            <h4 data-rg-dataset-name>—</h4>
            <p data-rg-focus></p>
          </div>
          <div class="rg-detail__count">
            <strong data-rg-count>—</strong>
            <span data-rg-count-unit>test cases</span>
            <small data-rg-extra hidden></small>
          </div>
          <a class="rg-detail__link" data-rg-dataset-source href="#" target="_blank" rel="noopener noreferrer">
            Dataset source ↗
          </a>
        </div>

        <div class="rg-performance">
          <div class="rg-performance__heading">
            <div>
              <span class="rg-label">MEASURED PERFORMANCE</span>
              <h4>What the results tell us</h4>
            </div>
            <span data-rg-run-status>Awaiting published runs</span>
          </div>

          <div class="rg-insights" data-rg-insights hidden aria-label="Key results"></div>
          <div class="rg-takeaway" data-rg-takeaway hidden>
            <span class="rg-label">KEY TAKEAWAY</span>
            <p data-rg-takeaway-text></p>
          </div>

          <div class="rg-comparison" data-rg-comparison hidden>
            <div class="rg-comparison__heading">
              <div>
                <h5>Compare the models</h5>
                <p data-rg-comparison-note>One run · same benchmark workload</p>
              </div>
              <div class="rg-legend" aria-label="Metric interpretation">
                <span><span class="rg-legend__mark rg-legend__mark--recall"></span> Recall ↑</span>
                <span><span class="rg-legend__mark rg-legend__mark--leakage"></span> Leakage ↓</span>
              </div>
            </div>
            <div data-rg-model-rows class="rg-model-rows" role="list"></div>
            <p class="rg-comparison__footnote">System recall includes inference failures. The p95 shown here was observed during quality runs, not a repeated latency benchmark.</p>
          </div>

          <p data-rg-no-models class="rg-performance__pending">
            The test dataset is published, but no measured model results are available for this dataset yet.
          </p>
        </div>

        <details class="rg-advanced" data-rg-advanced hidden>
          <summary>
            <span>
              <strong>Explore deeper evidence</strong>
              <small>Quality × latency, cross-dataset matrix and methodology</small>
            </span>
            <span class="rg-advanced__chevron" aria-hidden="true">+</span>
          </summary>
          <div class="rg-advanced__body">
            <div class="rg-pareto" data-rg-pareto hidden>
              <div class="rg-pareto__head">
                <div>
                  <span class="rg-label">SAME-RUN QUALITY × LATENCY</span>
                  <strong>Privacy quality vs observed response time</strong>
                </div>
                <span class="rg-pareto__hint">System recall ↑ · observed p95 →</span>
              </div>
              <p class="chart-swipe-hint">Swipe across the chart for full-size labels <span aria-hidden="true">→</span></p>
              <div class="rg-plot-canvas" role="region" tabindex="0" aria-label="Horizontally scrollable RedactGuard quality and latency chart">
                <svg data-rg-pareto-plot viewBox="0 0 640 260" role="img"
                  aria-label="RedactGuard system PII recall versus observed p95 latency within a single evaluated run"></svg>
              </div>
              <p data-rg-pareto-note class="rg-pareto__note"></p>
            </div>
            <p class="rg-pareto__missing" data-rg-pareto-missing hidden>
              The quality–latency comparison requires at least two models measured in the same complete run.
            </p>
            <div class="rg-matrix" data-rg-matrix hidden>
              <div class="rg-matrix__heading">
                <div>
                  <span class="rg-label">ACROSS DATASETS</span>
                  <h4>Model × dataset</h4>
                  <p>Individual dataset scores, never a global rating.</p>
                </div>
                <div class="rg-matrix__metric" role="group" aria-label="RedactGuard matrix metric">
                  <button type="button" data-rg-metric="system_pii_recall" aria-pressed="true">System recall</button>
                  <button type="button" data-rg-metric="system_leakage_rate" aria-pressed="false">System leakage</button>
                </div>
              </div>
              <div class="rg-matrix__scroll" data-rg-matrix-scroll tabindex="0" role="region" aria-label="Scroll horizontally to compare models across datasets"></div>
              <p class="rg-matrix__note">— means that this model/dataset has no published measurement, not 0% performance.</p>
            </div>
            <p class="rg-disclosure">Run comparisons are exploratory. Healthcare and Ambiguous have distinct model cohorts; do not interpret their figures as a controlled leaderboard. Dataset gold spans have not been independently human-reviewed.</p>
          </div>
        </details>
      </div>

      <div class="mcb-story" data-mcb-story>
        <div class="mcb-highlights-viewport" role="region" tabindex="0" aria-label="Swipe through benchmark highlights">
          <div class="benchmark-highlights" aria-label="Benchmark highlights">
          <div class="highlight">
            <span>BEST QUALITY</span>
            <strong data-best-quality>—</strong>
            <small data-best-quality-model></small>
          </div>
          <div class="highlight highlight--accent">
            <span>BALANCE POINT</span>
            <strong data-balance>—</strong>
            <small data-balance-model></small>
          </div>
          <div class="highlight">
            <span>FASTEST</span>
            <strong data-fastest>—</strong>
            <small data-fastest-model></small>
          </div>
          </div>
        </div>
        <section class="mcb-model-browser" aria-label="Compare measured models">
          <div class="mcb-model-browser__heading">
            <span class="mcb-model-browser__eyebrow">MODEL COMPARISON</span>
            <h4>Explore measured models</h4>
            <p>Published aggregate quality and observed p50 latency. Runtimes are not controlled to identical hardware.</p>
          </div>
          <div class="mcb-list-filters" role="group" aria-label="Filter measured models by deployment">
            <button type="button" data-mcb-filter="all" aria-pressed="true">All</button>
            <button type="button" data-mcb-filter="local" aria-pressed="false">Local</button>
            <button type="button" data-mcb-filter="api" aria-pressed="false">API</button>
          </div>
          <div class="mcb-cards-viewport" role="region" tabindex="0" aria-label="Swipe through published measured model scores">
            <div class="mcb-model-cards" role="list" data-mcb-model-cards aria-label="Published model scores ranked by aggregate quality"></div>
          </div>
          <button type="button" class="mcb-show-all" data-mcb-show-all hidden aria-expanded="false">View all measured models</button>
        </section>
        <details class="mcb-chart-details" data-mcb-chart-details open>
          <summary><span><strong>Performance chart & model inspection</strong><small>Quality vs median latency from the published overview</small></span><span aria-hidden="true">+</span></summary>
          <div class="benchmark-story">
            <div class="performance-plot">
          <div class="plot-heading">
            <div>
              <span class="plot-heading__eyebrow">QUALITY × LATENCY</span>
              <strong>Local routing frontier</strong>
            </div>
            <span class="plot-heading__note">Accuracy vs p50 latency</span>
          </div>

          <div class="plot-toolbar" data-mcb-toolbar hidden>
            <span>Quality <span aria-hidden="true">↑</span> &nbsp;·&nbsp; Median latency <span aria-hidden="true">→</span></span>
            <div class="plot-filters" role="group" aria-label="Filter models by deployment">
              <button type="button" data-mcb-filter="all" aria-pressed="true">All</button>
              <button type="button" data-mcb-filter="local" aria-pressed="false">Local</button>
              <button type="button" data-mcb-filter="api" aria-pressed="false">API</button>
            </div>
          </div>

          <p class="chart-swipe-hint">Swipe across the chart to inspect all models <span aria-hidden="true">→</span></p>
          <div class="plot-canvas" role="region" tabindex="0" aria-label="Horizontally scrollable model quality versus latency chart">
            <svg
              class="plot-svg"
              data-performance-plot
              viewBox="0 0 620 250"
              role="img"
              aria-label="Quality versus median latency; focus or select a model point for details"
            ></svg>
          </div>

          <div class="plot-selection" data-mcb-detail hidden aria-live="polite">
            <div>
              <span class="plot-selection__eyebrow">INSPECT MODEL</span>
              <strong data-mcb-selected-name>—</strong>
            </div>
            <span data-mcb-selected-metrics>—</span>
          </div>

          <div class="plot-legend">
            <span><i class="legend-dot legend-dot--all"></i>Measured model</span>
            <span><i class="legend-line"></i>Pareto frontier</span>
          </div>
        </div>
          </div>
        </details>
        <details class="mcb-method-details">
          <summary><span><strong>Methods & limitations</strong><small>What the published snapshot does—and doesn't—support</small></span><span aria-hidden="true">+</span></summary>
          <div class="mcb-method-details__body">
            <p>Aggregate quality is reported by the published Model Capability Benchmark. Latency is the reported median (p50); local and API runtimes have different execution environments.</p>
            <p>These figures describe the published snapshot, not a controlled hardware-normalized leaderboard. Use the linked source for benchmark signatures, tasks and reproducibility details.</p>
          </div>
        </details>
      </div>

    </div>

    <div class="evidence-panel__error" data-evidence-error hidden>
      <span class="evidence-panel__eyebrow">SOURCE UNAVAILABLE</span>
      <h3>Published evidence could not be loaded.</h3>
      <p>No fallback or invented performance values are shown.</p>
    </div>
  </section>
</div>

<script>
  import { redactguardRows } from '../../scripts/redactguardEvidence.js';
  import { renderRedactguardOverview } from '../../scripts/redactguardOverview.js';
  import { initializeRedactguardAnalytics } from '../../scripts/redactguardPresentation.js';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  const initExperimentExplorer = () => {
    document.querySelectorAll('[data-experiment-explorer]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-experiment-tab]'));
      const experimentRail = root.querySelector('[data-experiment-rail]');
      const previousExperiment = root.querySelector('[data-experiment-prev]');
      const nextExperiment = root.querySelector('[data-experiment-next]');
      const experimentPosition = root.querySelector('[data-experiment-position]');
      const chartDetails = root.querySelector('[data-mcb-chart-details]');
      if (chartDetails instanceof HTMLDetailsElement) {
        // Details remain open in static HTML without JS; progressively collapse on phones.
        chartDetails.open = !window.matchMedia('(max-width: 680px)').matches;
      }
      const loading = root.querySelector('[data-evidence-loading]');
      const empty = root.querySelector('[data-evidence-empty]');
      const result = root.querySelector('[data-evidence-result]');
      const error = root.querySelector('[data-evidence-error]');

      let requestId = 0;

      const setHidden = (node, hidden) => {
        if (node instanceof HTMLElement) node.hidden = hidden;
      };

      const setText = (selector, value) => {
        const node = root.querySelector(selector);
        if (node) node.textContent = value ?? '';
      };

      const showOnly = (target) => {
        setHidden(loading, target !== 'loading');
        setHidden(empty, target !== 'empty');
        setHidden(result, target !== 'result');
        setHidden(error, target !== 'error');
      };

      const shortModel = (value) => {
        const model = String(value || '');
        return model
          .replace(/^qwen3\.5-/i, 'Qwen 3.5 ')
          .replace(/^nemotron-nano-/i, 'Nemotron ')
          .replace(/-q4km$/i, ' Q4')
          .replace(/-q8$/i, ' Q8')
          .replace(/-/g, ' ')
          .replace(/\b(\d+(?:\.\d+)?)b\b/gi, '$1B');
      };

      const formatPct = (value) => {
        const number = Number(value);
        return Number.isFinite(number) ? `${(number * 100).toFixed(1)}%` : '—';
      };

      const formatSeconds = (value) => {
        const number = Number(value);
        if (!Number.isFinite(number)) return '—';
        if (number < 1000) return `${Math.round(number)} ms`;
        return `${(number / 1000).toFixed(1)} s`;
      };

      const createSvg = (tag, attrs = {}) => {
        const node = document.createElementNS(SVG_NS, tag);
        Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, String(value)));
        return node;
      };

      const mcbState = {
        points: [],
        filter: 'all',
        selected: null,
        showAll: false,
      };

      const renderMcbCards = (points) => {
        const region = root.querySelector('[data-mcb-model-cards]');
        const toggle = root.querySelector('[data-mcb-show-all]');
        if (!(region instanceof HTMLElement)) return;
        region.replaceChildren();

        const ranked = [...points].sort((a, b) =>
          b.qualityNumber - a.qualityNumber || a.latencyNumber - b.latencyNumber);
        const displayed = mcbState.showAll ? ranked : ranked.slice(0, 3);

        displayed.forEach((point) => {
          const key = point.model_signature || point.model_key;
          const entry = document.createElement('div');
          entry.className = 'mcb-model-entry';
          entry.setAttribute('role', 'listitem');

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'mcb-model-card';
          button.setAttribute('data-mcb-card', key);
          button.setAttribute('aria-pressed', mcbState.selected === key ? 'true' : 'false');
          button.setAttribute('aria-label',
            shortModel(point.model_key) + ', ' + point.qualityNumber.toFixed(1) +
            ' out of 100 aggregate quality, median ' + formatSeconds(point.latencyNumber) +
            ', ' + (point.deployment === 'api' ? 'API' : 'local') + ' runtime');
          const top = document.createElement('span');
          top.className = 'mcb-model-card__top';
          const model = document.createElement('strong');
          model.textContent = shortModel(point.model_key);
          const environment = document.createElement('span');
          environment.className = 'mcb-model-card__runtime';
          environment.textContent = point.deployment === 'api' ? 'API' : 'Local';
          top.append(model, environment);

          const metrics = document.createElement('span');
          metrics.className = 'mcb-model-card__metrics';
          const quality = document.createElement('span');
          quality.textContent = point.qualityNumber.toFixed(1) + ' / 100 quality';
          const latency = document.createElement('span');
          latency.textContent = formatSeconds(point.latencyNumber) + ' p50';
          metrics.append(quality, latency);
          button.append(top, metrics);
          button.addEventListener('click', () => focusMcbPoint(point));
          entry.appendChild(button);
          region.appendChild(entry);
        });

        if (toggle instanceof HTMLButtonElement) {
          toggle.hidden = ranked.length <= 3;
          toggle.textContent = mcbState.showAll
            ? 'Show fewer models'
            : 'View all ' + ranked.length + ' measured models';
          toggle.setAttribute('aria-expanded', mcbState.showAll ? 'true' : 'false');
        }
      };
      const showAllModels = root.querySelector('[data-mcb-show-all]');
      if (showAllModels instanceof HTMLButtonElement) {
        showAllModels.addEventListener('click', () => {
          mcbState.showAll = !mcbState.showAll;
          if (typeof mcbState.redraw === 'function') mcbState.redraw();
        });
      }

      const focusMcbPoint = (point) => {
        if (!point) return;
        mcbState.selected = point.model_signature || point.model_key;
        setText('[data-mcb-selected-name]', shortModel(point.model_key));
        setText(
          '[data-mcb-selected-metrics]',
          point.qualityNumber.toFixed(1) + ' / 100 quality · ' +
            formatSeconds(point.latencyNumber) + ' p50 · ' +
            (point.deployment === 'api' ? 'API' : 'Local'),
        );
        root.querySelectorAll('[data-mcb-point]').forEach((group) => {
          const selected = group.getAttribute('data-mcb-point') === mcbState.selected;
          group.classList.toggle('is-selected', selected);
          group.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
        root.querySelectorAll('[data-mcb-card]').forEach((button) => {
          button.setAttribute('aria-pressed',
            button.getAttribute('data-mcb-card') === mcbState.selected ? 'true' : 'false');
        });
      };

      const plotMcbOverview = (data) => {
        const svg = root.querySelector('[data-performance-plot]');
        if (!(svg instanceof SVGElement)) return [];

        const points = Array.isArray(data?.frontier?.points)
          ? data.frontier.points
              .map((point) => ({
                ...point,
                qualityNumber: Number(point.quality),
                latencyNumber: Number(point.latency_p50_ms),
              }))
              .filter(
                (point) =>
                  Number.isFinite(point.qualityNumber) &&
                  Number.isFinite(point.latencyNumber) &&
                  point.latencyNumber > 0,
              )
          : [];
        mcbState.points = points;

        const redraw = () => {
          while (svg.firstChild) svg.removeChild(svg.firstChild);
          const visible = points
            .filter((point) => mcbState.filter === 'all' || point.deployment === mcbState.filter)
            .sort((a, b) => a.latencyNumber - b.latencyNumber);
          renderMcbCards(visible);
          if (!visible.length) return;

          const W = 620;
          const H = 250;
          const pad = { left: 46, right: 22, top: 16, bottom: 38 };
          const innerW = W - pad.left - pad.right;
          const innerH = H - pad.top - pad.bottom;
          const minLatency = Math.min(...visible.map((point) => point.latencyNumber)) / 1.25;
          const maxLatency = Math.max(...visible.map((point) => point.latencyNumber)) * 1.3;
          const logMin = Math.log10(minLatency);
          const logSpan = Math.max(0.01, Math.log10(maxLatency) - logMin);
          const x = (value) => pad.left + (Math.log10(value) - logMin) / logSpan * innerW;
          const y = (value) => pad.top + (100 - value) / 100 * innerH;

          const grid = createSvg('g', { class: 'plot-grid' });
          const labels = createSvg('g', { class: 'plot-axis-labels' });
          [0, 25, 50, 75, 100].forEach((tick) => {
            const yy = y(tick);
            grid.appendChild(createSvg('line', {
              x1: pad.left, y1: yy, x2: W - pad.right, y2: yy,
            }));
            const text = createSvg('text', { x: pad.left - 10, y: yy + 4, 'text-anchor': 'end' });
            text.textContent = String(tick);
            labels.appendChild(text);
          });

          [250, 500, 1000, 2000, 5000, 10000, 20000]
            .filter((tick) => tick >= minLatency && tick <= maxLatency)
            .forEach((tick) => {
              const xx = x(tick);
              grid.appendChild(createSvg('line', {
                x1: xx, x2: xx, y1: pad.top, y2: H - pad.bottom,
              }));
              const text = createSvg('text', {
                x: xx, y: H - 12, 'text-anchor': 'middle',
              });
              text.textContent = formatSeconds(tick);
              labels.appendChild(text);
            });
          svg.appendChild(grid);
          svg.appendChild(labels);

          // The projected artifact carries the comparability-aware Pareto flags.
          // Do not reconstruct a mixed local/API Pareto from visual positions.
          const frontier = visible
            .filter((point) => point.pareto_latency === true)
            .sort((a, b) => a.latencyNumber - b.latencyNumber);
          if (frontier.length > 1) {
            svg.appendChild(createSvg('polyline', {
              class: 'plot-frontier',
              points: frontier.map((point) => x(point.latencyNumber) + ',' + y(point.qualityNumber)).join(' '),
            }));
          }

          visible.forEach((point) => {
            const key = point.model_signature || point.model_key;
            const group = createSvg('g', {
              class: 'plot-point plot-interactive',
              role: 'button',
              tabindex: '0',
              'aria-pressed': 'false',
              'aria-label': shortModel(point.model_key) + ', quality ' +
                point.qualityNumber.toFixed(1) + '/100, p50 ' +
                formatSeconds(point.latencyNumber) + ', ' + point.deployment,
              'data-mcb-point': key,
            });
            const isApi = point.deployment === 'api';
            const circle = createSvg('circle', {
              cx: x(point.latencyNumber),
              cy: y(point.qualityNumber),
              r: point.pareto_latency ? 7 : 6,
              class: (isApi ? 'is-api' : 'is-local') +
                (point.pareto_latency ? ' is-frontier' : ''),
            });
            const hit = createSvg('circle', {
              cx: x(point.latencyNumber),
              cy: y(point.qualityNumber),
              r: 16,
              class: 'plot-hit-area',
            });
            const title = createSvg('title');
            title.textContent = group.getAttribute('aria-label') || '';
            group.appendChild(circle);
            group.appendChild(hit);
            group.appendChild(title);
            group.addEventListener('click', () => focusMcbPoint(point));
            group.addEventListener('focus', () => focusMcbPoint(point));
            group.addEventListener('mouseenter', () => focusMcbPoint(point));
            group.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                focusMcbPoint(point);
              }
            });
            svg.appendChild(group);
          });

          const selectedPoint = visible.find(
            (point) => (point.model_signature || point.model_key) === mcbState.selected,
          );
          focusMcbPoint(selectedPoint || [...visible].sort(
            (a, b) => b.qualityNumber - a.qualityNumber,
          )[0]);
        };

        const toolbar = root.querySelector('[data-mcb-toolbar]');
        setHidden(toolbar, false);
        setHidden(root.querySelector('[data-mcb-detail]'), false);
        root.querySelectorAll('[data-mcb-filter]').forEach((button) => {
          button.setAttribute('aria-pressed',
            button.getAttribute('data-mcb-filter') === mcbState.filter ? 'true' : 'false');
        });
        mcbState.redraw = redraw;
        redraw();
        return points;
      };

      root.querySelectorAll('[data-mcb-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-mcb-filter');
          if (!['all', 'local', 'api'].includes(filter)) return;
          mcbState.filter = filter;
          root.querySelectorAll('[data-mcb-filter]').forEach((option) => {
            option.setAttribute('aria-pressed',
              option.getAttribute('data-mcb-filter') === filter ? 'true' : 'false');
          });
          if (typeof mcbState.redraw === 'function') mcbState.redraw();
        });
      });

      const renderMcbOverview = (data, tab) => {
        setHidden(root.querySelector('[data-rg-summary]'), true);
        setText('[data-result-eyebrow]', 'PUBLISHED BENCHMARK SNAPSHOT');
        setHidden(root.querySelector('[data-jev-summary]'), true);
        setHidden(root.querySelector('[data-mcb-scope]'), false);
        setHidden(root.querySelector('[data-mcb-story]'), false);
        setHidden(root.querySelector('[data-mcb-takeaway]'), false);
        setHidden(root.querySelector('[data-jev-toolbar]'), true);
        setHidden(root.querySelector('[data-jev-detail]'), true);
        setHidden(root.querySelector('[data-jev-evidence-note]'), true);
        const points = plotMcbOverview(data);
        if (!points.length) throw new Error('No published MCB frontier points');

        const models = Array.isArray(data?.models) ? data.models : [];
        const capabilities = Array.isArray(data?.capabilities) ? data.capabilities : [];
        const cells = Array.isArray(data?.cells) ? data.cells : [];

        const overallBest = [...points].sort(
          (a, b) => Number(b.quality) - Number(a.quality),
        )[0];

        const localPoints = points.filter((point) => point.deployment === 'local');
        const bestLocal = [...localPoints].sort(
          (a, b) => Number(b.quality) - Number(a.quality),
        )[0];
        const fastestLocal = [...localPoints].sort(
          (a, b) => Number(a.latency_p50_ms) - Number(b.latency_p50_ms),
        )[0];

        setText('[data-result-title]', tab.dataset.title || 'Model Capability Benchmark');
        setText('[data-result-question]', tab.dataset.question || '');
        setText('[data-model-count]', String(models.length || points.length));
        setText('[data-request-count]', String(cells.length || '—'));
        setText('[data-count-label]', 'published cells');
        setText('[data-dataset]', String(capabilities.length || '—'));
        setText('[data-scope-label]', 'capabilities');
        setText('[data-runtime]', '2');
        setText('[data-runtime-label]', 'execution modes');

        setText('[data-best-quality]', `${Number(overallBest.quality).toFixed(1)}`);
        setText('[data-best-quality-model]', shortModel(overallBest.model_key));

        setText(
          '[data-balance]',
          bestLocal
            ? `${Number(bestLocal.quality).toFixed(1)} · ${formatSeconds(bestLocal.latency_p50_ms)}`
            : '—',
        );
        setText(
          '[data-balance-model]',
          bestLocal ? `${shortModel(bestLocal.model_key)} · best local quality` : '',
        );

        setText(
          '[data-fastest]',
          fastestLocal ? formatSeconds(fastestLocal.latency_p50_ms) : '—',
        );
        setText(
          '[data-fastest-model]',
          fastestLocal
            ? `${shortModel(fastestLocal.model_key)} · ${Number(fastestLocal.quality).toFixed(1)} quality`
            : '',
        );

        if (bestLocal && overallBest) {
          const qualityGap = Number(overallBest.quality) - Number(bestLocal.quality);
          const speedRatio =
            Number(bestLocal.latency_p50_ms) / Number(overallBest.latency_p50_ms);

          setText(
            '[data-readout-title]',
            `${shortModel(bestLocal.model_key)} is the strongest local point in the published snapshot.`,
          );
          setText(
            '[data-readout]',
            `${Number(bestLocal.quality).toFixed(1)} aggregate quality at ${formatSeconds(bestLocal.latency_p50_ms)} p50. The top overall point is ${shortModel(overallBest.model_key)} at ${Number(overallBest.quality).toFixed(1)}, a ${qualityGap.toFixed(1)}-point gap${Number.isFinite(speedRatio) ? ` while the local point is ${speedRatio.toFixed(1)}× slower` : ''}.`,
          );
        }

        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) {
          source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
        }

        const heading = root.querySelector('.plot-heading__eyebrow');
        if (heading) heading.textContent = 'MODEL CAPABILITY × LATENCY';

        const plotTitle = root.querySelector('.plot-heading strong');
        if (plotTitle) plotTitle.textContent = 'Model performance map';

        const plotNote = root.querySelector('.plot-heading__note');
        if (plotNote) plotNote.textContent = 'Quality / 100 · Log-scale p50';

        const legend = root.querySelector('.plot-legend');
        if (legend) {
          legend.innerHTML =
            '<span><i class="legend-dot legend-dot--local"></i>Local</span><span><i class="legend-dot legend-dot--api"></i>API</span><span>Different runtime environments</span>';
        }

        const highlightLabels = root.querySelectorAll('.highlight > span');
        if (highlightLabels[0]) highlightLabels[0].textContent = 'BEST OVERALL';
        if (highlightLabels[1]) highlightLabels[1].textContent = 'BEST LOCAL';
        if (highlightLabels[2]) highlightLabels[2].textContent = 'FASTEST LOCAL';
      };

      const renderMcbIntentComparison = (mcb, tab) => {
        const container = root.querySelector('[data-jev-mcb-rows]');
        if (!(container instanceof HTMLElement)) return;
        container.replaceChildren();

        const source = root.querySelector('[data-jev-mcb-source]');
        if (source instanceof HTMLAnchorElement) {
          source.href = tab.dataset.relatedSourceUrl || '#';
        }

        const cells = Array.isArray(mcb?.cells) ? mcb.cells : [];
        const intent = cells.filter((cell) =>
          cell.capability_id === 'intent-classification' &&
          cell.primary_metric === 'accuracy' &&
          Number.isFinite(Number(cell.primary_value)) &&
          Number(cell.primary_value) >= 0 &&
          Number(cell.primary_value) <= 1 &&
          Number.isInteger(Number(cell.sample_count)) &&
          Number(cell.sample_count) > 0,
        );

        const jev = intent.find((cell) => cell.model_key === 'jev-1.13.0');
        const luna = intent.find((cell) => cell.model_key === 'gpt-5.6-luna');
        if (
          !jev || !luna ||
          jev.benchmark_signature !== luna.benchmark_signature ||
          jev.sample_count !== luna.sample_count
        ) {
          throw new Error('No matching public MCB signature for JEV and GPT Luna');
        }

        const cohort = intent.filter((cell) =>
          cell.benchmark_signature === jev.benchmark_signature &&
          cell.sample_count === jev.sample_count,
        );
        const topLocals = cohort
          .filter((cell) => cell.deployment === 'local' && cell.model_key)
          .sort((a, b) => Number(b.primary_value) - Number(a.primary_value))
          .slice(0, 2);
        const display = [luna, jev, ...topLocals].sort(
          (a, b) => Number(b.primary_value) - Number(a.primary_value),
        );

        setText(
          '[data-jev-mcb-meta]',
          'Intent classification · ' + jev.sample_count +
            ' samples/model · shared benchmark signature · accuracy',
        );
        setText(
          '[data-jev-mcb-note]',
          'Results are published by Model Capability Benchmark (MCB), not the ' +
            'Jev-vs-LLM routing suite. Matching benchmark signatures and sample sizes ' +
            'support configuration-level comparison; they do not prove identical ' +
            'case-level inputs or authorize republication under TypeSafe terms.',
        );

        display.forEach((cell) => {
          const row = document.createElement('div');
          row.className = 'jev-mcb-row';
          row.setAttribute('role', 'listitem');

          const identity = document.createElement('div');
          identity.className = 'jev-mcb-row__model';
          const name = document.createElement('strong');
          name.textContent = cell.model_key === 'gpt-5.6-luna'
            ? 'GPT-5.6 Luna'
            : cell.model_key === 'jev-1.13.0'
              ? 'JEV 1.13.0'
              : shortModel(cell.model_key);
          const category = document.createElement('small');
          category.textContent =
            cell.model_key === 'jev-1.13.0' ? 'Decision model · API' :
              cell.model_key === 'gpt-5.6-luna' ? 'General-purpose LLM · API' :
                'Local baseline';
          identity.append(name, category);

          const reading = document.createElement('div');
          reading.className = 'jev-mcb-row__score';
          const pct = document.createElement('strong');
          pct.textContent = formatPct(cell.primary_value);
          const bar = document.createElement('div');
          bar.className = 'jev-mcb-row__track';
          bar.setAttribute('aria-hidden', 'true');
          const fill = document.createElement('span');
          fill.className = 'jev-mcb-row__fill';
          fill.style.width = (Number(cell.primary_value) * 100).toFixed(1) + '%';
          bar.appendChild(fill);
          reading.append(pct, bar);
          row.append(identity, reading);
          container.appendChild(row);
        });
      };

      const renderJevRouting = (data, tab, relatedMcb) => {
        setHidden(root.querySelector('[data-rg-summary]'), true);
        setText('[data-result-eyebrow]', 'PUBLISHED BENCHMARK EVIDENCE · MIXED SOURCES');
        const sourceHeading = root.querySelector('[data-jev-mcb-meta]');
        if (relatedMcb) {
          try {
            renderMcbIntentComparison(relatedMcb, tab);
          } catch (cause) {
            console.warn('Published MCB comparison cannot be verified', cause);
            setText('[data-jev-mcb-meta]', 'MCB comparison unavailable — inspect the original benchmark source.');
            const rows = root.querySelector('[data-jev-mcb-rows]');
            if (rows) rows.replaceChildren();
          }
        } else {
          if (sourceHeading) sourceHeading.textContent = 'Related MCB evidence is temporarily unavailable.';
          const rows = root.querySelector('[data-jev-mcb-rows]');
          if (rows) rows.replaceChildren();
        }

        if (
          data?.schema_version !== 1 ||
          data?.benchmark !== 'jev-vs-llm' ||
          data?.publication?.restricted_jev_typesafe_clm_metrics_included !== false ||
          !Array.isArray(data?.experiments)
        ) {
          throw new Error('Invalid or unreviewed Jev public evidence manifest');
        }
        const rows = Array.isArray(data?.routing?.models) ? data.routing.models : [];
        const validRows = rows
          .map((row) => ({
            ...row,
            accuracyValue: Number(row.accuracy),
            latencyValue: Number(row.latency_p50_ms),
            cases: Number(row.requests),
          }))
          .filter((row) =>
            Number.isFinite(row.accuracyValue) &&
            Number.isFinite(row.latencyValue) && row.latencyValue > 0 &&
            Number.isFinite(row.cases) && row.cases > 0,
          );
        if (!validRows.length) throw new Error('No comparable routing evidence');

        // Equal dataset size is necessary before presenting model rankings.
        const coverage = new Map();
        validRows.forEach((row) =>
          coverage.set(row.cases, (coverage.get(row.cases) || 0) + 1),
        );
        const commonCaseCount = [...coverage.keys()].sort(
          (a, b) => coverage.get(b) - coverage.get(a) || b - a,
        )[0];
        const comparable = validRows
          .filter((row) => row.cases === commonCaseCount)
          .sort((a, b) => b.accuracyValue - a.accuracyValue);
        const partial = validRows.filter((row) => row.cases !== commonCaseCount);
        if (comparable.length < 2) throw new Error('Insufficient matched routing runs');

        const bestQuality = comparable[0];
        // Compare the two independently observable endpoints on matched cases:
        // highest accuracy versus lowest median latency. No subjective threshold.
        const alternative = [...comparable]
          .sort((a, b) => a.latencyValue - b.latencyValue)[0];
        const speedup = bestQuality.latencyValue / alternative.latencyValue;
        const accuracyLoss = (bestQuality.accuracyValue - alternative.accuracyValue) * 100;
        const sameModel = bestQuality.model === alternative.model;

        const experimentItems = data.experiments;
        const publishedExperiments = experimentItems.filter(
          (item) => item.status === 'published_subset' || item.status === 'published',
        );
        const providers = Array.isArray(data?.routing?.providers)
          ? data.routing.providers
          : [...new Set(validRows.map((row) => String(row.provider || 'unknown')))];
        const isDirectComparison =
          data.publication.comparison_status === 'complete_provider_comparison';
        setText(
          '[data-result-title]',
          'JEV vs LLM · Published evidence',
        );
        setText(
          '[data-result-question]',
          'MCB intent-classification comparison above · separate Jev suite routing evidence below.',
        );
        setText(
          '[data-jev-published-scope]',
          isDirectComparison
            ? 'Standalone Jev suite: direct comparison published'
            : 'Standalone Jev suite: head-to-head not published',
        );
        setText(
          '[data-jev-experiment-count]',
          publishedExperiments.length + '/' + experimentItems.length + ' experiments',
        );
        setText(
          '[data-jev-scope-note]',
          isDirectComparison
            ? 'A reviewed and authorized public comparison is available.'
            : 'This standalone suite currently publishes ' + providers.join(', ') +
                ' routing aggregates only. Jev/TypeSafe/CLM metrics remain excluded here ' +
                'pending publication clearance. The JEV and GPT Luna results above come from MCB.',
        );

        const coverageStrip = root.querySelector('[data-jev-stage-coverage]');
        if (coverageStrip instanceof HTMLElement) {
          coverageStrip.replaceChildren();
          const names = {
            routing: 'Routing', calibration: 'Calibration', scaling: 'Scaling',
            workflow: 'Workflow', agent: 'Hybrid agent',
          };
          experimentItems.forEach((item) => {
            const published = item.status === 'published_subset' || item.status === 'published';
            const node = document.createElement('span');
            node.className = 'jev-stage-coverage__item' +
              (published ? ' is-published' : '');
            node.textContent = (published ? '● ' : '○ ') +
              (names[item.id] || item.id) +
              (published ? ' · subset' : ' · unpublished');
            coverageStrip.appendChild(node);
          });
        }
        setText('[data-model-count]', String(validRows.length));
        setText('[data-request-count]', String(
          validRows.reduce((sum, row) => sum + row.cases, 0),
        ));
        setText('[data-count-label]', 'model-requests');
        setText('[data-dataset]', String(commonCaseCount));
        setText('[data-scope-label]', 'requests per grouped model');
        setText('[data-runtime]', 'Local');
        setText('[data-runtime-label]', 'execution');

        setText(
          '[data-jev-takeaway-headline]',
          sameModel
            ? 'Best accuracy and speed in one model.'
            : speedup.toFixed(1) + '× faster.',
        );
        setText(
          '[data-jev-takeaway-description]',
          sameModel
            ? 'In this published comparison it has both the highest accuracy and the shortest median response time.'
            : shortModel(alternative.model) + ' vs ' + shortModel(bestQuality.model) +
                ': ' + accuracyLoss.toFixed(1) +
                ' fewer accuracy points with a much shorter median response time.',
        );
        setText(
          '[data-jev-quality-gap]',
          sameModel ? 'No trade-off' : '−' + accuracyLoss.toFixed(1) + ' pts',
        );
        setText(
          '[data-jev-speed-comparison]',
          formatSeconds(alternative.latencyValue) + ' vs ' +
            formatSeconds(bestQuality.latencyValue),
        );
        setText(
          '[data-jev-coverage]',
          comparable.length + ' models · ' + commonCaseCount + ' requests each',
        );
        setText(
          '[data-jev-method-note]',
          'Grouping uses equal request counts, not verified identical test cases. ' +
          'Results are descriptive local baselines, not a controlled Jev-vs-LLM comparison.',
        );

        const container = root.querySelector('[data-jev-rows]');
        if (!(container instanceof HTMLElement)) throw new Error('Missing JEV comparison list');
        container.replaceChildren();

        const make = (tag, cls, value) => {
          const node = document.createElement(tag);
          if (cls) node.className = cls;
          if (value != null) node.textContent = String(value);
          return node;
        };
        comparable.forEach((row) => {
          const isQuality = row.model === bestQuality.model;
          const isAlternative = !sameModel && row.model === alternative.model;
          const item = make('div', 'jev-model-row' + (isAlternative ? ' is-alternative' : ''), null);
          item.setAttribute('role', 'listitem');

          const nameCell = make('div', 'jev-model-row__name', null);
          nameCell.appendChild(make('strong', '', shortModel(row.model)));
          if (isQuality) nameCell.appendChild(make('small', '', 'Most accurate'));
          else if (isAlternative) nameCell.appendChild(make('small', '', 'Fastest response'));

          const accuracyCell = make('div', 'jev-model-row__accuracy', null);
          const accuracyTop = make('div', 'jev-model-row__accuracy-head', null);
          accuracyTop.appendChild(make('strong', '', formatPct(row.accuracyValue)));
          accuracyCell.appendChild(accuracyTop);
          accuracyCell.appendChild(make('small', 'jev-model-row__mobile-label', 'Accuracy'));
          const bar = make('div', 'jev-model-row__track', null);
          bar.setAttribute('aria-hidden', 'true');
          const fill = make('span', 'jev-model-row__fill', null);
          fill.style.width = Math.max(0, Math.min(100, row.accuracyValue * 100)).toFixed(1) + '%';
          bar.appendChild(fill);
          accuracyCell.appendChild(bar);

          const latencyCell = make('div', 'jev-model-row__latency', null);
          latencyCell.appendChild(make('strong', '', formatSeconds(row.latencyValue)));
          latencyCell.appendChild(make('small', '', 'Median response'));
          item.appendChild(nameCell);
          item.appendChild(accuracyCell);
          item.appendChild(latencyCell);
          container.appendChild(item);
        });

        const partialNotice = root.querySelector('[data-jev-partial]');
        if (partial.length && partialNotice instanceof HTMLElement) {
          partialNotice.replaceChildren();
          const label = make('strong', '', 'Separate shorter run: ');
          partialNotice.appendChild(label);
          partialNotice.appendChild(document.createTextNode(
            partial.map((row) =>
              shortModel(row.model) + ' · ' + row.cases + ' cases · ' +
              formatPct(row.accuracyValue) + ' accuracy · ' +
              formatSeconds(row.latencyValue) + ' p50',
            ).join('; ') + '. Excluded from the ranking.',
          ));
        }
        setHidden(partialNotice, !partial.length);

        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) {
          source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
        }

        setHidden(root.querySelector('[data-jev-summary]'), false);
        setHidden(root.querySelector('[data-mcb-scope]'), true);
        setHidden(root.querySelector('[data-mcb-story]'), true);
        setHidden(root.querySelector('[data-mcb-takeaway]'), true);
      };

      const renderRedactGuard = (data, tab) => {
        if (
          data?.schema_version !== 1 ||
          data?.benchmark !== 'redactguard-local-anonymization' ||
          !Array.isArray(data?.datasets) ||
          !Array.isArray(data?.models) ||
          typeof data?.publication?.has_published_model_metrics !== 'boolean' ||
          data?.publication?.contains_raw_pii !== false
        ) {
          throw new Error('Invalid RedactGuard public evidence');
        }

        const datasets = data.datasets.filter((item) =>
          item && typeof item.id === 'string' &&
          Number.isInteger(item.cases ?? item.documents) &&
          (item.cases ?? item.documents) > 0,
        );
        if (!datasets.length) throw new Error('No published RedactGuard datasets');
        setHidden(root.querySelector('[data-jev-summary]'), true);
        setHidden(root.querySelector('[data-mcb-scope]'), true);
        setHidden(root.querySelector('[data-mcb-story]'), true);
        setHidden(root.querySelector('[data-mcb-takeaway]'), true);
        setHidden(root.querySelector('[data-rg-summary]'), false);

        setText(
          '[data-result-eyebrow]',
          data.publication.has_published_model_metrics
            ? 'PUBLISHED MODEL RESULTS · REDACTGUARD'
            : 'PUBLISHED TEST COVERAGE · MODEL SCORES PENDING',
        );
        setText(
          '[data-rg-publication-status]',
          data.publication.has_published_model_metrics
            ? data.models.length + ' measured model × dataset results'
            : 'Dataset coverage published',
        );
        setText('[data-result-title]', 'RedactGuard · Privacy evaluation');
        setText(
          '[data-result-question]',
          'How well can sensitive data be identified across difficult contexts and document types?',
        );
        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) {
          source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
        }

        const picker = root.querySelector('[data-rg-datasets]');
        const resultRows = root.querySelector('[data-rg-model-rows]');
        if (!(picker instanceof HTMLElement) || !(resultRows instanceof HTMLElement)) return;
        picker.replaceChildren();
        const updateAnalytics = initializeRedactguardAnalytics(root, data, {
          formatPct, formatSeconds, shortModel, createSvg, setHidden,
        });

        const setDataset = (dataset) => {
          picker.querySelectorAll('button[data-rg-dataset]').forEach((button) => {
            const active = button.dataset.rgDataset === dataset.id;
            button.classList.toggle('is-selected', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          const isDocuments = Number.isInteger(dataset.documents);
          const count = isDocuments ? dataset.documents : dataset.cases;
          setText('[data-rg-kind]', (dataset.kind || 'test suite').toUpperCase() + ' · SOURCE-VERIFIED');
          setText('[data-rg-dataset-name]', dataset.title);
          setText('[data-rg-focus]', dataset.focus);
          setText('[data-rg-count]', String(count));
          setText('[data-rg-count-unit]', isDocuments ? 'annotated documents' : 'test cases');
          setText('[data-rg-extra]',
            Number.isInteger(dataset.gold_spans) ? dataset.gold_spans.toLocaleString('en-US') + ' gold PII spans' : '',
          );
          setHidden(root.querySelector('[data-rg-extra]'), !Number.isInteger(dataset.gold_spans));
          const link = root.querySelector('[data-rg-dataset-source]');
          if (link instanceof HTMLAnchorElement) {
            link.href = 'https://github.com/daniele21/experiments/blob/dev/' + dataset.source_path;
          }

          updateAnalytics(dataset.id);
          const summary = renderRedactguardOverview(root, data, dataset.id, {
            formatPct, formatSeconds, setHidden,
          });
          const measuredCount = summary.rows.length;
          setText(
            '[data-rg-run-status]',
            measuredCount
              ? measuredCount + ' measured model' + (measuredCount === 1 ? '' : 's')
              : 'No published model run',
          );
          setHidden(root.querySelector('[data-rg-no-models]'), measuredCount > 0);
        };

        datasets.forEach((dataset) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'rg-dataset-pill';
          button.dataset.rgDataset = dataset.id;
          const count = dataset.documents ?? dataset.cases;
          button.textContent = dataset.title + ' · ' + count;
          button.setAttribute('aria-pressed', 'false');
          button.addEventListener('click', () => setDataset(dataset));
          picker.appendChild(button);
        });
        setDataset(
          (data.publication.has_published_model_metrics
            ? datasets.find((item) => item.id === 'challenge' && data.models.some((row) => row.dataset === 'challenge'))
            : null)
          || datasets.find((item) => item.id === 'realistic')
          || datasets[0],
        );
      };

      const selectTab = async (tab) => {
        const index = tabs.indexOf(tab);
        if (experimentPosition) experimentPosition.textContent =
          String(index + 1).padStart(2, '0') + ' / ' + String(tabs.length).padStart(2, '0');
        if (previousExperiment instanceof HTMLButtonElement) previousExperiment.disabled = index <= 0;
        if (nextExperiment instanceof HTMLButtonElement) nextExperiment.disabled = index >= tabs.length - 1;
        if (experimentRail instanceof HTMLElement && tab instanceof HTMLElement &&
            window.matchMedia('(max-width: 680px)').matches) {
          const left = experimentRail.scrollLeft +
            tab.getBoundingClientRect().left - experimentRail.getBoundingClientRect().left;
          experimentRail.scrollTo({
            left,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
          });
        }
        tabs.forEach((candidate) => {
          const active = candidate === tab;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-selected', active ? 'true' : 'false');
          candidate.setAttribute('tabindex', active ? '0' : '-1');
        });

        const currentRequest = ++requestId;
        const resultUrl = tab.dataset.resultUrl || '';
        if (!resultUrl) {
          setText('[data-empty-title]', tab.dataset.title || 'Experiment');
          setText('[data-empty-question]', tab.dataset.question || '');
          showOnly('empty');
          return;
        }

        showOnly('loading');

        try {
          const response = await fetch(resultUrl, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (currentRequest !== requestId) return;

          if (tab.dataset.resultKind === 'jev-public-summary') {
            const relatedUrl = tab.dataset.relatedResultUrl || '';
            let relatedMcb = null;
            if (relatedUrl) {
              try {
                const relatedResponse = await fetch(relatedUrl);
                if (relatedResponse.ok) relatedMcb = await relatedResponse.json();
              } catch (relatedError) {
                console.warn('Related MCB evidence unavailable', relatedError);
              }
            }
            if (currentRequest !== requestId) return;
            renderJevRouting(data, tab, relatedMcb);
          }
          else if (tab.dataset.resultKind === 'mcb-overview') renderMcbOverview(data, tab);
          else if (tab.dataset.resultKind === 'redactguard-public-summary') renderRedactGuard(data, tab);
          else throw new Error('Unsupported result adapter');

          showOnly('result');
        } catch (cause) {
          if (currentRequest !== requestId) return;
          console.warn('Experiment evidence unavailable', cause);
          showOnly('error');
        }
      };

      const moveExperiment = (delta) => {
        const selected = tabs.findIndex((item) => item.getAttribute('aria-selected') === 'true');
        const next = tabs[Math.max(0, Math.min(tabs.length - 1, selected + delta))];
        if (next instanceof HTMLButtonElement) selectTab(next);
      };
      if (previousExperiment instanceof HTMLButtonElement) {
        previousExperiment.addEventListener('click', () => moveExperiment(-1));
      }
      if (nextExperiment instanceof HTMLButtonElement) {
        nextExperiment.addEventListener('click', () => moveExperiment(1));
      }

      tabs.forEach((tab, index) => {
        if (!(tab instanceof HTMLButtonElement)) return;

        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const delta = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (index + delta + tabs.length) % tabs.length;
          const next = tabs[nextIndex];
          if (next instanceof HTMLButtonElement) {
            next.focus();
            next.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
            selectTab(next);
          }
        });
      });

      const initial =
        tabs.find((tab) => tab instanceof HTMLButtonElement && tab.getAttribute('aria-selected') === 'true') ??
        tabs.find((tab) => tab instanceof HTMLButtonElement && Boolean(tab.dataset.resultUrl)) ??
        tabs[0];
      if (initial instanceof HTMLButtonElement) selectTab(initial);
    });
  };

  initExperimentExplorer();
  document.addEventListener('astro:page-load', initExperimentExplorer);
</script>

