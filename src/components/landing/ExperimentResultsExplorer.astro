---
interface Track {
  id?: string;
  title: string;
  question: string;
  status: string;
  resultUrl?: string;
  sourceUrl?: string;
  resultKind?: 'jev-routing';
}

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;
---

<div class="experiment-explorer" data-experiment-explorer>
  <div class="experiment-selector-wrap">
    <div class="experiment-selector" role="tablist" aria-label="Select experiment">
      {tracks.map((track, index) => (
        <button
          type="button"
          class:list={['experiment-tab', { 'is-active': index === 0 }]}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? '0' : '-1'}
          data-experiment-tab
          data-track-id={track.id || ''}
          data-title={track.title}
          data-question={track.question}
          data-status={track.status}
          data-result-url={track.resultUrl || ''}
          data-source-url={track.sourceUrl || ''}
          data-result-kind={track.resultKind || ''}
        >
          <span class="experiment-tab__title">{track.title}</span>
          <span class:list={['experiment-tab__state', { 'is-live': Boolean(track.resultUrl) }]}>
            <span class="status-dot" aria-hidden="true"></span>
            {track.resultUrl ? 'Published' : 'No run'}
          </span>
        </button>
      ))}
    </div>
  </div>

  <section class="evidence-panel" aria-live="polite" aria-label="Selected experiment evidence">
    <div class="evidence-panel__loading" data-evidence-loading hidden>
      Loading published evidence…
    </div>

    <div class="evidence-panel__empty" data-evidence-empty hidden>
      <span class="evidence-panel__eyebrow">NO PUBLISHED RUN</span>
      <h3 data-empty-title></h3>
      <p data-empty-question></p>
      <p class="evidence-panel__empty-note">
        The benchmark is defined in Experiments, but no versioned result artifact is published yet.
      </p>
    </div>

    <div class="evidence-panel__result" data-evidence-result hidden>
      <div class="evidence-panel__header">
        <div class="evidence-panel__heading">
          <span class="evidence-panel__eyebrow">
            <span class="live-dot" aria-hidden="true"></span>
            LATEST PUBLISHED RUN
          </span>
          <h3 data-result-title></h3>
          <p data-result-question></p>
        </div>

        <a class="source-link" data-result-source href="#" target="_blank" rel="noopener noreferrer">
          Source <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="evidence-meta" aria-label="Run context">
        <span class="evidence-meta__item">
          <span class="evidence-meta__label">Model</span>
          <strong data-model>—</strong>
          <small data-quant></small>
        </span>
        <span class="evidence-meta__separator" aria-hidden="true"></span>
        <span class="evidence-meta__item">
          <span class="evidence-meta__label">Dataset</span>
          <strong data-dataset>—</strong>
          <small data-cases></small>
        </span>
        <span class="evidence-meta__separator" aria-hidden="true"></span>
        <span class="evidence-meta__item">
          <span class="evidence-meta__label">Run</span>
          <strong data-last-run>—</strong>
          <small data-hardware></small>
        </span>
      </div>

      <div class="metric-row" aria-label="Key performance metrics">
        <div class="metric">
          <span>Accuracy</span>
          <strong data-accuracy>—</strong>
          <small>Top-1</small>
        </div>
        <div class="metric">
          <span>Latency p50</span>
          <strong data-p50>—</strong>
          <small>Median</small>
        </div>
        <div class="metric">
          <span>Latency p95</span>
          <strong data-p95>—</strong>
          <small>Tail</small>
        </div>
        <div class="metric">
          <span>Valid rate</span>
          <strong data-valid-rate>—</strong>
          <small>Responses</small>
        </div>
      </div>

      <div class="evidence-takeaway">
        <span class="evidence-takeaway__label">TAKEAWAY</span>
        <div>
          <strong data-readout-title></strong>
          <p data-readout></p>
        </div>
      </div>
    </div>

    <div class="evidence-panel__error" data-evidence-error hidden>
      <span class="evidence-panel__eyebrow">SOURCE UNAVAILABLE</span>
      <h3>Published evidence could not be loaded.</h3>
      <p>No fallback or invented performance values are shown.</p>
    </div>
  </section>
</div>

<script>
  const initExperimentExplorer = () => {
    document.querySelectorAll('[data-experiment-explorer]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-experiment-tab]'));
      const loading = root.querySelector('[data-evidence-loading]');
      const empty = root.querySelector('[data-evidence-empty]');
      const result = root.querySelector('[data-evidence-result]');
      const error = root.querySelector('[data-evidence-error]');

      let requestId = 0;

      const setHidden = (node, hidden) => {
        if (node instanceof HTMLElement) node.hidden = hidden;
      };

      const setText = (selector, value) => {
        const node = root.querySelector(selector);
        if (node) node.textContent = value ?? '';
      };

      const showOnly = (target) => {
        setHidden(loading, target !== 'loading');
        setHidden(empty, target !== 'empty');
        setHidden(result, target !== 'result');
        setHidden(error, target !== 'error');
      };

      const formatDate = (value) => {
        if (!value) return 'Unknown';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value);
        return new Intl.DateTimeFormat('en', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(date);
      };

      const formatMs = (value) => {
        const number = Number(value);
        return Number.isFinite(number) ? `${Math.round(number)} ms` : '—';
      };

      const renderJevRouting = (data, tab) => {
        const row = data?.overview?.[0] ?? data?.routing?.summary?.[0];
        const leader = data?.leaderboard?.[0];
        const metadata = data?.metadata ?? {};
        if (!row) throw new Error('No published routing row');

        const accuracy = Number(row.accuracy);
        const validRate = Number(row.valid_rate ?? 0);
        const accuracyPct = Number.isFinite(accuracy) ? `${(accuracy * 100).toFixed(1)}%` : '—';
        const validPct = Number.isFinite(validRate) ? `${(validRate * 100).toFixed(1)}%` : '—';
        const cases = Number(row.requests ?? data?.kpi_cards?.total_requests ?? 0);
        const model = row.model ?? leader?.model ?? 'Unknown model';
        const quant = leader?.quant_label ? `Q: ${leader.quant_label}` : '';
        const dataset = row.dataset_label ?? leader?.dataset_label ?? row.dataset ?? 'Unknown';
        const hardware = metadata?.hardware
          ? `${metadata.hardware.device || ''} · ${metadata.hardware.chip || ''}`.replace(/^ · | · $/g, '')
          : '';

        setText('[data-result-title]', tab.dataset.title || 'Experiment');
        setText('[data-result-question]', tab.dataset.question || '');
        setText('[data-model]', model);
        setText('[data-quant]', quant);
        setText('[data-dataset]', dataset);
        setText('[data-cases]', cases ? `${cases} cases` : '');
        setText('[data-last-run]', formatDate(row.latest_run_at ?? leader?.latest_run_at));
        setText('[data-hardware]', hardware);
        setText('[data-accuracy]', accuracyPct);
        setText('[data-p50]', formatMs(row.latency_p50_ms));
        setText('[data-p95]', formatMs(row.latency_p95_ms));
        setText('[data-valid-rate]', validPct);

        const viabilityTitle = Number.isFinite(accuracy) && accuracy < 0.5
          ? 'Fast enough. Not accurate enough.'
          : 'Performance is viable on this run.';

        const viabilityCopy = Number.isFinite(accuracy) && accuracy < 0.5
          ? `${accuracyPct} accuracy across ${cases || 'the published'} cases makes this model unsuitable for the routing task, despite ${formatMs(row.latency_p50_ms)} median latency.`
          : `${accuracyPct} accuracy with ${formatMs(row.latency_p50_ms)} median latency across ${cases || 'the published'} cases.`;

        setText('[data-readout-title]', viabilityTitle);
        setText('[data-readout]', viabilityCopy);

        const source = root.querySelector('[data-result-source]');
        if (source instanceof HTMLAnchorElement) source.href = tab.dataset.sourceUrl || tab.dataset.resultUrl || '#';
      };

      const selectTab = async (tab) => {
        tabs.forEach((candidate) => {
          const active = candidate === tab;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-selected', active ? 'true' : 'false');
          candidate.setAttribute('tabindex', active ? '0' : '-1');
        });

        const resultUrl = tab.dataset.resultUrl || '';
        if (!resultUrl) {
          setText('[data-empty-title]', tab.dataset.title || 'Experiment');
          setText('[data-empty-question]', tab.dataset.question || '');
          showOnly('empty');
          return;
        }

        const currentRequest = ++requestId;
        showOnly('loading');

        try {
          const response = await fetch(resultUrl, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (currentRequest !== requestId) return;

          if (tab.dataset.resultKind === 'jev-routing') renderJevRouting(data, tab);
          else throw new Error('Unsupported result adapter');

          showOnly('result');
        } catch (cause) {
          if (currentRequest !== requestId) return;
          console.warn('Experiment evidence unavailable', cause);
          showOnly('error');
        }
      };

      tabs.forEach((tab, index) => {
        if (!(tab instanceof HTMLButtonElement)) return;

        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const delta = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (index + delta + tabs.length) % tabs.length;
          const next = tabs[nextIndex];
          if (next instanceof HTMLButtonElement) {
            next.focus();
            next.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
            selectTab(next);
          }
        });
      });

      const initial =
        tabs.find((tab) => tab instanceof HTMLButtonElement && Boolean(tab.dataset.resultUrl)) ?? tabs[0];
      if (initial instanceof HTMLButtonElement) selectTab(initial);
    });
  };

  initExperimentExplorer();
  document.addEventListener('astro:page-load', initExperimentExplorer);
</script>

<style>
  .experiment-explorer {
    min-width: 0;
  }

  .experiment-selector-wrap {
    position: relative;
    margin-bottom: 14px;
  }

  .experiment-selector-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 34px;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--journey-surface-tint, var(--surface-subtle)));
    pointer-events: none;
  }

  .experiment-selector {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 2px 36px 6px 2px;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .experiment-selector::-webkit-scrollbar {
    display: none;
  }

  .experiment-tab {
    flex: 0 0 auto;
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface-card) 82%, var(--surface-subtle));
    color: var(--ink-muted);
    text-align: left;
    cursor: pointer;
    scroll-snap-align: start;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .experiment-tab:hover,
  .experiment-tab:focus-visible {
    border-color: color-mix(in srgb, var(--accent-blue) 36%, var(--border-medium));
    color: var(--ink-display);
  }

  .experiment-tab.is-active {
    border-color: color-mix(in srgb, var(--accent-blue) 50%, var(--border-medium));
    background: var(--surface-blue-subtle);
    color: var(--ink-display);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent-blue) 7%, transparent);
  }

  .experiment-tab__title {
    color: inherit;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 720;
    line-height: 1.2;
    white-space: nowrap;
  }

  .experiment-tab__state {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    line-height: 1;
    white-space: nowrap;
  }

  .experiment-tab__state.is-live {
    color: var(--accent-blue-dark);
  }

  .status-dot,
  .live-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
  }

  .experiment-tab__state.is-live .status-dot,
  .live-dot {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 10%, transparent);
  }

  .evidence-panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 16%, var(--border-medium));
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 96% 0%, color-mix(in srgb, var(--accent-blue) 8%, transparent), transparent 30%),
      var(--surface-card);
    box-shadow: 0 14px 36px rgba(8, 19, 51, 0.04);
  }

  [hidden] {
    display: none !important;
  }

  .evidence-panel__loading,
  .evidence-panel__empty,
  .evidence-panel__error {
    min-height: 230px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 3.2vw, 36px);
  }

  .evidence-panel__result {
    padding: clamp(24px, 3.2vw, 36px);
  }

  .evidence-panel__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 780;
    letter-spacing: 0.055em;
  }

  .evidence-panel__empty h3,
  .evidence-panel__error h3 {
    margin: 9px 0 5px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    letter-spacing: -0.025em;
  }

  .evidence-panel__empty p,
  .evidence-panel__error p {
    max-width: 620px;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  .evidence-panel__empty-note {
    margin-top: 10px !important;
  }

  .evidence-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .evidence-panel__heading {
    min-width: 0;
  }

  .evidence-panel__header h3 {
    margin: 10px 0 5px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    font-weight: 820;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .evidence-panel__header p {
    max-width: 700px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .source-link {
    flex: 0 0 auto;
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 760;
    text-decoration: none;
  }

  .source-link:hover,
  .source-link:focus-visible {
    color: var(--accent-blue);
  }

  .evidence-meta {
    min-width: 0;
    display: flex;
    align-items: stretch;
    gap: 16px;
    margin-top: 24px;
    padding: 14px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .evidence-meta__item {
    min-width: 0;
    flex: 1 1 0;
    display: grid;
    gap: 3px;
  }

  .evidence-meta__label,
  .metric > span,
  .evidence-takeaway__label {
    color: var(--ink-subtle);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 720;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .evidence-meta__item strong {
    min-width: 0;
    overflow: hidden;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 720;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .evidence-meta__item small {
    min-width: 0;
    overflow: hidden;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .evidence-meta__separator {
    width: 1px;
    flex: 0 0 1px;
    background: var(--border-subtle);
  }

  .metric-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 26px;
  }

  .metric {
    min-width: 0;
    padding: 0 clamp(14px, 2vw, 22px);
  }

  .metric:first-child {
    padding-left: 0;
  }

  .metric + .metric {
    border-left: 1px solid var(--border-subtle);
  }

  .metric strong {
    display: block;
    margin-top: 6px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 820;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .metric small {
    display: block;
    margin-top: 6px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .evidence-takeaway {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
  }

  .evidence-takeaway > div {
    min-width: 0;
  }

  .evidence-takeaway strong {
    display: block;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 760;
    line-height: 1.4;
  }

  .evidence-takeaway p {
    max-width: 720px;
    margin: 4px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .experiment-selector {
      padding-right: 28px;
    }

    .experiment-tab__state {
      display: none;
    }

    .evidence-panel__header {
      flex-direction: column;
      gap: 8px;
    }

    .source-link {
      min-height: auto;
    }

    .evidence-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 18px;
    }

    .evidence-meta__separator {
      display: none;
    }

    .evidence-meta__item:last-child {
      grid-column: 1 / -1;
    }

    .metric-row {
      grid-template-columns: 1fr 1fr;
      gap: 20px 0;
    }

    .metric:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }

    .evidence-takeaway {
      grid-template-columns: 1fr;
      gap: 7px;
    }
  }

  @media (max-width: 430px) {
    .evidence-panel__result,
    .evidence-panel__loading,
    .evidence-panel__empty,
    .evidence-panel__error {
      padding: 20px;
    }

    .evidence-meta {
      grid-template-columns: 1fr;
    }

    .evidence-meta__item:last-child {
      grid-column: auto;
    }

    .metric {
      padding-inline: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experiment-tab {
      transition: none;
    }
  }
</style>
