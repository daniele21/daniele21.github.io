  .chart-swipe-hint { display: none; }
  .plot-canvas, .rg-plot-canvas { min-width: 0; }
  .plot-canvas:focus-visible, .rg-plot-canvas:focus-visible,
  .rg-matrix__scroll:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: -2px;
  }

  /* Tablet-width panels need full-sized chart labels too. */
  @media (min-width: 681px) and (max-width: 900px) {
    .chart-swipe-hint {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin: 12px 0 4px;
      color: var(--ink-muted);
      font-size: var(--text-caption);
    }
    .chart-swipe-hint span { color: var(--accent-blue); }
    .plot-canvas, .rg-plot-canvas {
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .plot-canvas .plot-svg { width: 620px; max-width: none; min-width: 620px; }
    .rg-plot-canvas svg { width: 640px; max-width: none; min-width: 640px; }
  }

  @media (max-width: 680px) {
    .experiment-index-heading {
      align-items: flex-start;
      gap: 4px 12px;
      margin-bottom: 12px;
    }
    .experiment-index-heading h3 { font-size: 1.13rem; }
    .experiment-selector-wrap { margin-bottom: 15px; }
    .experiment-selector-wrap::after { display: none; }

    /* Two columns replace the cryptic horizontally cropped tab bar.
       Three published benchmarks appear before unpublished experiments. */
    .experiment-selector {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding: 0 0 2px;
      overflow: visible;
      scroll-snap-type: none;
    }
    .experiment-tab {
      min-width: 0;
      min-height: 69px;
      padding: 10px;
      border-radius: var(--radius-md);
      align-items: flex-start;
      gap: 8px;
      text-align: left;
      scroll-snap-align: none;
    }
    .experiment-tab[data-published='false'] {
      min-height: 59px;
