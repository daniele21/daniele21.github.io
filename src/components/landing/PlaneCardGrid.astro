---
/** Standard three-card responsive grid for every homepage plane. */
interface Props {
  sequence?: boolean;
  className?: string;
  layout?: 'grid' | 'rows';
}

const { sequence = false, className = '', layout = 'grid' } = Astro.props;
---

<div class:list={['plane-card-grid', { 'plane-card-grid--sequence': sequence, 'plane-card-grid--rows': layout === 'rows' }, className]}>
  <slot />
</div>

<style>
  .plane-card-grid {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 20px);
  }

  .plane-card-grid--rows {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(10px, 1.2vw, 14px);
  }

  @media (max-width: 980px) {
    .plane-card-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 820px) {
    .plane-card-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
