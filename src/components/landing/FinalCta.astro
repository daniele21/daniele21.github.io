---
/**
 * FinalCta.astro
 * High-impact advisory conversion layer.
 * Structured as 2x2 Bento Grid: Direct Client Questions & Highlighted Answers.
 */
import { advisoryData } from '../../content/locales/en/advisory';
---

<section class="advisory-section" id="advisory" aria-labelledby="advisory-heading">
  <div class="shell advisory-shell">
    <!-- Centered Section Header -->
    <header class="advisory-header">
      {advisoryData.kicker && (
        <div class="advisory-eyebrow-row">
          <span class="advisory-signal" aria-hidden="true"></span>
          <p class="advisory-kicker">{advisoryData.kicker}</p>
        </div>
      )}

      <h2 id="advisory-heading" class="advisory-heading">{advisoryData.heading}</h2>
      <p class="advisory-body">{advisoryData.body}</p>
    </header>

    <!-- 2x2 Bento Grid: Direct Question & Keyword-Highlighted Answer -->
    <div class="advisory-grid" aria-label="Advisory focus areas and deliverables">
      {advisoryData.areas.map((area, index) => (
        <article class="advisory-card">
          <div class="card-header">
            <span class="card-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="card-question">{area.title}</h3>
          </div>

          <p class="card-benefit" set:html={area.body} />

          <div class="card-deliverable-bar">
            <span class="deliverable-label">DELIVERABLE</span>
            <span class="deliverable-arrow" aria-hidden="true">→</span>
            <strong class="deliverable-title">{area.output}</strong>
          </div>
        </article>
      ))}
    </div>

    <!-- Full-Width Bottom Action Banner -->
    <div class="advisory-bottom-banner">
      <div class="banner-content">
        <h3 class="banner-title">Have a project in mind?</h3>
        <p class="banner-fit">{advisoryData.fitNote}</p>
      </div>

      <div class="banner-actions">
        <button
          type="button"
          class="primary-button banner-primary"
          data-open-contact-modal
          aria-label="Open contact inquiry form"
        >
          <span>{advisoryData.primaryCta.label}</span>
          <span aria-hidden="true">→</span>
        </button>
        <div class="banner-socials" aria-label="Social profiles">
          <a
            class="social-icon-btn"
            href={advisoryData.secondaryCta.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile"
            title="LinkedIn"
          >
            <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a
            class="social-icon-btn"
            href="https://github.com/daniele21"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
            title="GitHub"
          >
            <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .advisory-section {
    position: relative;
    scroll-margin-top: calc(var(--header-height) + 24px);
    padding: clamp(68px, 8.5vw, 116px) 0;
    overflow: clip;
    border-top: 1px solid var(--border-subtle);
    background:
      radial-gradient(ellipse 60% 50% at 50% 12%, color-mix(in srgb, var(--accent-blue) 8.5%, transparent), transparent 74%),
      linear-gradient(160deg, var(--surface-subtle) 0%, var(--surface-canvas) 85%);
  }

  .advisory-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent-blue) 2.2%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent-blue) 2.2%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 74% 75% at 50% 35%, black 12%, transparent 90%);
  }

  .advisory-shell {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(34px, 4.5vw, 48px);
  }

  /* Centered Header */
  .advisory-header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .advisory-eyebrow-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .advisory-signal {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-blue) 12%, transparent);
  }

  .advisory-kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 820;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue-dark);
  }

  .advisory-heading {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 850;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .advisory-body {
    margin: 0;
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* 2x2 Bento Grid */
  .advisory-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 24px);
    width: 100%;
  }

  .advisory-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(22px, 2.6vw, 30px);
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 20px rgba(8, 19, 51, 0.03);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .advisory-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent-blue) 45%, var(--border-medium));
    box-shadow: 0 12px 32px rgba(8, 19, 51, 0.08);
  }

  /* Card Header */
  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .card-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .card-question {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.4vw, 1.28rem);
    line-height: 1.28;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink-display);
  }

  .card-benefit {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--ink-muted);
    flex-grow: 1;
  }

  .card-benefit :global(strong) {
    color: var(--ink-display);
    font-weight: 750;
  }

  /* Deliverable Bar */
  .card-deliverable-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 9px 12px;
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-subtle));
    border: 1px solid color-mix(in srgb, var(--accent-blue) 14%, var(--border-subtle));
    border-radius: var(--radius-sm);
  }

  .deliverable-label {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
  }

  .deliverable-arrow {
    color: var(--accent-blue);
    font-size: var(--text-badge);
    font-weight: 800;
  }

  .deliverable-title {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-display);
  }

  /* Bottom Action Banner */
  .advisory-bottom-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: clamp(24px, 3.2vw, 36px);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--surface-card) 94%, var(--accent-blue) 6%) 0%,
      var(--surface-card) 100%
    );
    border: 1px solid color-mix(in srgb, var(--accent-blue) 22%, var(--border-medium));
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 28px rgba(8, 19, 51, 0.04);
  }

  .banner-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 620px;
  }

  .banner-fit {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.4;
  }

  .banner-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink-display);
  }

  .banner-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }

  .banner-primary {
    min-height: 48px;
    padding-inline: 20px;
    gap: 8px;
  }

  .banner-socials {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-medium);
    background: var(--surface-card);
    color: var(--ink);
    transition: transform 0.18s ease, color 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .social-icon-btn:hover {
    transform: translateY(-2px);
    color: var(--accent-blue-dark);
    border-color: color-mix(in srgb, var(--accent-blue) 45%, var(--border-medium));
    background: var(--surface-subtle);
    box-shadow: 0 4px 14px rgba(8, 19, 51, 0.08);
  }

  .social-icon {
    display: block;
    flex-shrink: 0;
  }

  /* Responsive Breakpoints */
  @media (max-width: 880px) {
    .advisory-grid {
      grid-template-columns: 1fr;
    }

    .advisory-bottom-banner {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .banner-actions {
      flex-direction: column;
      width: 100%;
    }

    .banner-primary,
    .banner-secondary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .advisory-section {
      padding-block: 54px;
    }

    .advisory-card {
      padding: 18px;
      gap: 12px;
    }

    .card-deliverable-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 8px 10px;
    }

    .deliverable-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .advisory-card {
      transition: none;
    }
  }
</style>
