---
/**
 * FinalCta.astro
 * Secondary conversion layer after the site's Local AI proof and evidence.
 */
import { advisoryData } from '../../content/locales/en/advisory';
---

<section class="advisory-section" id="advisory" aria-labelledby="advisory-heading">
  <div class="shell advisory-shell">
    <div class="advisory-intro">
      <p class="advisory-kicker">{advisoryData.kicker}</p>
      <h2 id="advisory-heading" class="advisory-heading">{advisoryData.heading}</h2>
      <p class="advisory-body">{advisoryData.body}</p>

      <p class="fit-note">{advisoryData.fitNote}</p>

      <div class="advisory-actions">
        <a class="primary-button advisory-primary" href={advisoryData.primaryCta.href}>
          {advisoryData.primaryCta.label}
          <span aria-hidden="true">→</span>
        </a>
        <a
          class="advisory-secondary"
          href={advisoryData.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {advisoryData.secondaryCta.label}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="advisory-areas" aria-label="Advisory areas">
      {advisoryData.areas.map((area, index) => (
        <article class="advisory-area">
          <span class="area-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{area.title}</h3>
            <p>{area.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .advisory-section {
    position: relative;
    scroll-margin-top: calc(var(--header-height) + 24px);
    padding: clamp(72px, 9vw, 124px) 0;
    overflow: clip;
    border-top: 1px solid var(--border-subtle);
    background:
      radial-gradient(ellipse 52% 60% at 8% 20%, color-mix(in srgb, var(--accent-blue) 9%, transparent), transparent 72%),
      linear-gradient(150deg, var(--surface-subtle) 0%, var(--surface-canvas) 78%);
  }

  .advisory-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent-blue) 2.2%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent-blue) 2.2%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 68% 75% at 18% 42%, black 8%, transparent 88%);
  }

  .advisory-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(54px, 8vw, 112px);
    align-items: start;
  }

  .advisory-intro {
    max-width: 560px;
  }

  .advisory-kicker {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 820;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue-dark);
  }

  .advisory-heading {
    margin: 0;
    max-width: 520px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 830;
    color: var(--ink-display);
  }

  .advisory-body {
    max-width: 540px;
    margin: 20px 0 0;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.68;
    color: var(--ink-muted);
  }

  .fit-note {
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--ink-subtle);
  }

  .advisory-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 30px;
  }

  .advisory-primary {
    min-height: 48px;
    padding-inline: 18px;
    gap: 9px;
  }

  .advisory-secondary {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    text-decoration: none;
  }

  .advisory-secondary:hover,
  .advisory-secondary:focus-visible {
    color: var(--accent-blue-dark);
  }

  .advisory-areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border-medium);
  }

  .advisory-area {
    min-height: 190px;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 16px;
    padding: 26px 26px 28px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .advisory-area:nth-child(odd) {
    padding-right: 30px;
    border-right: 1px solid var(--border-subtle);
  }

  .advisory-area:nth-child(even) {
    padding-left: 30px;
  }

  .area-index {
    padding-top: 3px;
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 780;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
  }

  .advisory-area h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.25;
    font-weight: 760;
    letter-spacing: -0.018em;
    color: var(--ink-display);
  }

  .advisory-area p {
    margin: 10px 0 0;
    font-size: var(--text-caption);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  @media (max-width: 920px) {
    .advisory-shell {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .advisory-intro {
      max-width: 680px;
    }
  }

  @media (max-width: 620px) {
    .advisory-section {
      padding-block: 64px;
    }

    .advisory-areas {
      grid-template-columns: 1fr;
    }

    .advisory-area,
    .advisory-area:nth-child(odd),
    .advisory-area:nth-child(even) {
      min-height: 0;
      padding: 22px 0;
      border-right: 0;
    }

    .advisory-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .advisory-primary {
      width: 100%;
      justify-content: center;
    }

    .advisory-secondary {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .advisory-secondary { transition: none; }
  }
</style>
