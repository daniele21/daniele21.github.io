---
/**
 * FinalCta.astro
 * Dedicated architecture collaboration and inquiry section at the bottom of the page.
 */
import { landingData } from '../../content/locales/en/landing';

const { finalCta } = landingData;
---

<section class="final-section" id="contact" aria-labelledby="consult-heading">
  <div class="shell final-shell">
    <div class="consultation-card">
      <div class="consultation-content">
        <p class="consult-kicker">COLLABORATION & ADVISORY</p>
        <h2 id="consult-heading" class="consult-heading">{finalCta.consultation.heading}</h2>
        <p class="consult-body">{finalCta.consultation.body}</p>

        <div class="consult-actions">
          <a class="primary-button consult-primary-btn" href={finalCta.consultation.primaryCta.href}>
            {finalCta.consultation.primaryCta.label} <span aria-hidden="true">→</span>
          </a>
          <a
            class="secondary-button"
            href={finalCta.consultation.secondaryCta.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {finalCta.consultation.secondaryCta.label} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-section {
    position: relative;
    padding: clamp(64px, 8vw, 108px) 0;
    overflow: clip;
    background:
      radial-gradient(ellipse 65% 50% at 50% 20%, rgba(20, 91, 255, 0.35), transparent 70%),
      var(--ink-display);
  }

  .consultation-card {
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .consultation-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 680px;
  }

  .consult-kicker {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #93c5fd;
    text-transform: uppercase;
  }

  .consult-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--ink-inverse);
  }

  .consult-body {
    font-size: var(--text-lead);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }

  .consult-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
  }

  .consult-primary-btn {
    padding: 13px 28px;
    font-size: 0.95rem;
  }

  .final-section :global(.secondary-button) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--ink-inverse);
    padding: 13px 24px;
    font-size: 0.95rem;
  }

  .final-section :global(.secondary-button:hover) {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.38);
    color: var(--ink-inverse);
  }

  @media (max-width: 600px) {
    .consult-actions {
      flex-direction: column;
    }

    .consult-actions a {
      width: 100%;
    }
  }
</style>
