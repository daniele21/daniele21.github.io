---
/**
 * FinalCta.astro
 * Loop closing (Decide Again) and a low-pressure peer collaboration invitation.
 */
import { landingData } from '../../content/locales/en/landing';

const { finalCta } = landingData;
const collaborationHeading = 'Working on a workload where the boundary is not obvious?';
const collaborationBody =
  'If you are deciding what should run Local, Hybrid or Cloud, I am always interested in comparing constraints, evidence and architecture choices.';
const collaborationPrimaryLabel = 'Compare an architecture';
---

<section class="final-section" id="contact" aria-labelledby="cta-title">
  <div class="shell final-shell">
    <div class="final-card">
      <div class="loop-panel">
        <p class="stage-kicker">{finalCta.kicker}</p>
        <h2 id="cta-title" class="loop-title">{finalCta.title}</h2>
        <p class="loop-body">{finalCta.body}</p>

        <div class="loop-badge-sequence" aria-label="Research loop sequence">
          <span class="loop-step">DECIDE</span>
          <span class="loop-arrow">→</span>
          <span class="loop-step">BUILD</span>
          <span class="loop-arrow">→</span>
          <span class="loop-step">TEST</span>
          <span class="loop-arrow">→</span>
          <span class="loop-step">MEASURE</span>
          <span class="loop-arrow">→</span>
          <span class="loop-step loop-highlight">DECIDE AGAIN</span>
        </div>

        <p class="loop-payoff"><strong>{finalCta.payoff}</strong></p>
      </div>

      <div class="final-divider" aria-hidden="true"></div>

      <div class="consultation-panel">
        <h3 class="consult-heading">{collaborationHeading}</h3>
        <p class="consult-body">{collaborationBody}</p>

        <div class="consult-actions">
          <a class="primary-button consult-primary-btn" href={finalCta.consultation.primaryCta.href}>
            {collaborationPrimaryLabel} <span aria-hidden="true">→</span>
          </a>
          <a
            class="secondary-button"
            href={finalCta.consultation.secondaryCta.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {finalCta.consultation.secondaryCta.label} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-section {
    position: relative;
    padding: clamp(72px, 9vw, 124px) 0;
    overflow: clip;
    background:
      radial-gradient(circle at 16% 20%, rgba(20, 91, 255, 0.42), transparent 34%),
      var(--ink-display);
  }

  .final-section::after {
    content: '';
    position: absolute;
    right: -8vw;
    bottom: -20vw;
    width: 46vw;
    aspect-ratio: 1;
    border: 1px solid rgba(157, 187, 255, 0.2);
    border-radius: 50%;
    box-shadow: 0 0 0 70px rgba(157, 187, 255, 0.035), 0 0 0 140px rgba(157, 187, 255, 0.025);
  }

  .final-card {
    display: grid;
    grid-template-columns: minmax(320px, 1.25fr) 1px minmax(300px, 1fr);
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
    position: relative;
    z-index: 1;
    padding: 0;
  }

  .loop-panel {
    display: flex;
    flex-direction: column;
  }

  .loop-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--ink-inverse);
  }

  .loop-body {
    font-size: var(--text-body);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0 0 var(--space-3);
  }

  .loop-badge-sequence {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .loop-step {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    color: rgba(255, 255, 255, 0.78);
    letter-spacing: 0.06em;
  }

  .loop-highlight {
    color: #bcd0ff;
  }

  .loop-arrow {
    color: var(--accent-blue);
    font-weight: 800;
    font-size: var(--text-badge);
  }

  .loop-payoff {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    color: #bcd0ff;
  }

  .final-divider {
    width: 1px;
    height: 80%;
    background: rgba(255, 255, 255, 0.18);
  }

  .consultation-panel {
    display: flex;
    flex-direction: column;
  }

  .consult-heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--ink-inverse);
  }

  .consult-body {
    font-size: var(--text-body);
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.55;
    margin: 0 0 var(--space-4);
  }

  .consult-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .consult-primary-btn {
    width: 100%;
    text-align: center;
  }

  .final-section :global(.stage-kicker) {
    color: #9dbbff;
  }

  .final-section :global(.secondary-button) {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.25);
    color: var(--ink-inverse);
    box-shadow: none;
  }

  .final-section :global(.secondary-button:hover) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.42);
    color: var(--ink-inverse);
  }

  @media (max-width: 960px) {
    .final-card {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .final-divider {
      display: none;
    }
  }
</style>
