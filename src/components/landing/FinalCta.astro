---
import { advisoryData } from '../../content/locales/en/advisory';
---

<section class="advisory-section" id="advisory" aria-labelledby="advisory-heading">
  <div class="shell advisory-shell">
    <header class="advisory-header">
      <h2 id="advisory-heading" class="advisory-heading">{advisoryData.heading}</h2>
      <p class="advisory-body">{advisoryData.body}</p>
    </header>

    <div class="advisory-grid" aria-label="Ways I can help with an AI workload">
      {advisoryData.areas.map((area) => (
        <article class="advisory-card">
          <h3 class="card-question">{area.title}</h3>
          <p class="card-benefit" set:html={area.body} />
          <div class="card-output">
            <span>You get</span>
            <strong>{area.output}</strong>
          </div>
        </article>
      ))}
    </div>

    <div class="advisory-bottom-banner">
      <div class="banner-content">
        <h3>Have something you're trying to build?</h3>
        <p>{advisoryData.fitNote}</p>
      </div>
      <button
        type="button"
        class="primary-button banner-primary"
        data-open-contact-modal
        aria-label="Evaluate an AI workload"
      >
        <span>{advisoryData.primaryCta.label}</span>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<style>
  .advisory-section {
    position: relative;
    scroll-margin-top: calc(var(--header-height) + 24px);
    padding: clamp(68px, 8.5vw, 116px) 0;
    overflow: clip;
    border-top: 1px solid var(--border-subtle);
    background:
      radial-gradient(ellipse 60% 50% at 50% 12%, color-mix(in srgb, var(--accent-blue) 7%, transparent), transparent 74%),
      linear-gradient(160deg, var(--surface-subtle) 0%, var(--surface-canvas) 85%);
  }

  .advisory-shell {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(30px, 4vw, 44px);
  }

  .advisory-header {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .advisory-heading {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 850;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .advisory-body {
    max-width: 680px;
    margin: 0 auto;
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .advisory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
  }

  .advisory-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: clamp(22px, 2.6vw, 30px);
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 20px rgba(8, 19, 51, 0.03);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .advisory-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent-blue) 38%, var(--border-medium));
    box-shadow: 0 10px 28px rgba(8, 19, 51, 0.07);
  }

  .card-question {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.45vw, 1.34rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--ink-display);
  }

  .card-benefit {
    flex: 1;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .card-benefit :global(strong) {
    color: var(--ink-display);
    font-weight: 720;
  }

  .card-output {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .card-output span {
    font-size: 0.74rem;
    color: var(--ink-subtle);
  }

  .card-output strong {
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--ink-display);
  }

  .advisory-bottom-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    padding: clamp(22px, 3vw, 32px);
    background: color-mix(in srgb, var(--accent-blue) 3.5%, var(--surface-card));
    border: 1px solid color-mix(in srgb, var(--accent-blue) 20%, var(--border-medium));
    border-radius: var(--radius-lg);
  }

  .banner-content h3 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    color: var(--ink-display);
  }

  .banner-content p {
    max-width: 650px;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .banner-primary {
    flex-shrink: 0;
    min-height: 46px;
    padding-inline: 18px;
    cursor: pointer;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .advisory-grid { grid-template-columns: 1fr; }
    .advisory-card { max-width: 720px; width: 100%; margin-inline: auto; }
  }

  @media (max-width: 680px) {
    .advisory-header { text-align: left; margin-inline: 0; }
    .advisory-body { margin-inline: 0; }
    .advisory-bottom-banner { align-items: flex-start; flex-direction: column; }
    .banner-primary { width: 100%; justify-content: center; }
  }
</style>
