---
import type { MethodStageHandoff } from '../../types/landing';

interface Props {
  handoff: MethodStageHandoff;
  number: number;
  nextLabel?: string;
  compact?: boolean;
}

const { handoff, number, compact = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<footer class:list={['stage-handoff', { 'stage-handoff--compact': compact }]} aria-label={`Outcome of stage ${number}`}>
  <div class="handoff-content">
    <span class="handoff-tag">OUTCOME</span>
    <strong class="handoff-output">{handoff.output}</strong>
  </div>

  <a class="handoff-link" href={resolveHref(handoff.detailCta.href)}>
    {handoff.detailCta.label}
    <span aria-hidden="true">→</span>
  </a>
</footer>

<style>
  .stage-handoff {
    margin-top: clamp(20px, 2.5vw, 28px);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .stage-handoff--compact {
    text-align: left;
  }

  .handoff-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .handoff-tag {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
  }

  .handoff-output {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    line-height: 1.4;
  }

  .handoff-link {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    transition: all var(--duration-fast) ease;
  }

  .handoff-link span {
    transition: transform var(--duration-fast) ease;
  }

  .handoff-link:hover {
    color: var(--accent-blue);
    border-color: var(--border-strong);
    background: var(--surface-card);
  }

  .handoff-link:hover span {
    transform: translateX(2px);
  }

  @media (max-width: 760px) {
    .stage-handoff {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
