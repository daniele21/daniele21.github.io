---
import type { MethodStageHandoff } from '../../types/landing';

interface Props {
  handoff: MethodStageHandoff;
  number: number;
  nextLabel?: string;
  compact?: boolean;
}

const { handoff, number, compact = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<footer class:list={['stage-handoff', { 'stage-handoff--compact': compact }]} aria-label={`Outcome of stage ${number}`}>
  <div class="handoff-content">
    <span class="handoff-tag">OUTCOME:</span>
    <strong class="handoff-output">{handoff.output}</strong>
  </div>
</footer>

<style>
  .stage-handoff {
    margin-top: clamp(14px, 2vw, 20px);
    padding-top: var(--space-2);
    display: inline-flex;
    align-items: center;
  }

  .handoff-content {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
  }

  .handoff-tag {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
  }

  .handoff-output {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    line-height: 1.3;
  }
</style>
