---
import type { MethodStageHandoff } from '../../types/landing';

interface Props {
  handoff: MethodStageHandoff;
  number: number;
  nextLabel: string;
}

const { handoff, number, nextLabel } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<footer class="stage-handoff" aria-label={`Output of plane ${number}`}>
  <p class="handoff-label">OUTPUT → {nextLabel}</p>
  <strong>{handoff.output}</strong>
  <a href={resolveHref(handoff.detailCta.href)}>
    {handoff.detailCta.label}
    <span aria-hidden="true">↗</span>
  </a>
</footer>

<style>
  .stage-handoff {
    margin-top: clamp(24px, 3vw, 34px);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-medium);
  }

  .handoff-label {
    margin: 0 0 5px;
    color: var(--accent-blue);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  strong {
    display: block;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  a {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    text-decoration: none;
  }

  a span {
    transition: transform var(--duration-fast) ease;
  }

  a:hover { color: var(--accent-blue); }
  a:hover span { transform: translate(2px, -2px); }
</style>
