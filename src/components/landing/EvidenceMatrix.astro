---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;

const checks = [
  {
    title: 'Responsive enough?',
    metrics: 'TTFT · tokens/s',
    signal: 'User-perceived speed',
    soWhat: 'If interaction feels slow, local execution is not good enough for that product flow.',
  },
  {
    title: 'Fits the device?',
    metrics: 'Peak RAM · OOM rate',
    signal: 'Hardware fit',
    soWhat: 'If the model does not fit reliably, reduce the model, quantize harder, or move the workload.',
  },
  {
    title: 'Stable under load?',
    metrics: 'Thermals · sustained speed · battery',
    signal: 'Sustained execution',
    soWhat: 'A fast first run is not enough if performance collapses after sustained use.',
  },
  {
    title: 'Good enough for the task?',
    metrics: 'Task success · evaluation score',
    signal: 'Product quality',
    soWhat: 'If the local model misses the quality threshold, harder requests need a stronger model or cloud route.',
  },
];

const decisions = [
  {
    name: 'Local',
    description: 'Critical thresholds pass on the target device.',
  },
  {
    name: 'Hybrid',
    description: 'Local handles the main flow; harder cases need fallback.',
  },
  {
    name: 'Cloud',
    description: 'A hard requirement is not met locally yet.',
  },
];
---

<div class="performance-lab-surface" aria-label="Performance Lab evidence for Local, Hybrid and Cloud decisions">
  <article class="lab-card">
    <header class="lab-header">
      <div class="lab-heading-copy">
        <h3>Performance Lab</h3>
        <p class="lab-question">Can this workload actually run locally well enough?</p>
        <p class="lab-purpose">
          Benchmark the <strong>real model</strong> on the <strong>real target device</strong>. The goal is not a leaderboard score — it is evidence for the architecture decision.
        </p>
      </div>

      <a href={resolveHref('performance-lab')} class="lab-link">
        Open the lab <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="decision-flow" aria-label="Performance Lab method">
      <span>Workload</span>
      <span class="flow-plus" aria-hidden="true">+</span>
      <span>Device</span>
      <span class="flow-plus" aria-hidden="true">+</span>
      <span>Model</span>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <strong>Measure what can break</strong>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <strong>Choose the boundary</strong>
    </div>

    <div class="checks-grid">
      {checks.map((check) => (
        <section class="check-card">
          <div class="check-topline">
            <span class="check-signal">{check.signal}</span>
            <strong>{check.title}</strong>
          </div>

          <div class="metric-line">{check.metrics}</div>
          <p>{check.soWhat}</p>
        </section>
      ))}
    </div>

    <div class="lab-output">
      <div class="output-copy">
        <span class="output-label">SO WHAT?</span>
        <strong>The benchmark changes where the workload should run.</strong>
        <p>Pass the critical thresholds and Local is viable. Miss one, and the evidence tells you whether to adapt the local setup, add a fallback, or use Cloud.</p>
      </div>

      <div class="decision-grid" aria-label="Possible architecture outcomes">
        {decisions.map((decision) => (
          <div class="decision-card">
            <strong>{decision.name}</strong>
            <span>{decision.description}</span>
          </div>
        ))}
      </div>
    </div>
  </article>
</div>

<style>
  .performance-lab-surface {
    width: 100%;
  }

  .lab-card {
    overflow: hidden;
    padding: clamp(22px, 3vw, 34px);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 18%, var(--border-medium));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 94% 0%, color-mix(in srgb, var(--accent-blue) 8%, transparent), transparent 34%),
      var(--surface-card);
    box-shadow: 0 7px 28px rgba(8, 19, 51, 0.05);
  }

  .lab-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px;
  }

  .lab-heading-copy {
    max-width: 760px;
  }

  .lab-heading-copy h3 {
    margin: 0 0 5px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 830;
    color: var(--ink-display);
  }

  .lab-question {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.35vw, 1.14rem);
    line-height: 1.4;
    font-weight: 680;
    color: var(--ink-display);
  }

  .lab-purpose {
    max-width: 720px;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .lab-purpose strong {
    color: var(--ink-display);
    font-weight: 720;
  }

  .lab-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 0 13px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink-display);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 740;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .lab-link:hover,
  .lab-link:focus-visible {
    transform: translateY(-1px);
    color: var(--accent-blue-dark);
    border-color: color-mix(in srgb, var(--accent-blue) 44%, var(--border-medium));
  }

  .decision-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: clamp(20px, 2.5vw, 28px);
    padding: 12px 14px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-subtle) 62%, var(--surface-card));
    font-family: var(--font-display);
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  .decision-flow > span:not(.flow-plus):not(.flow-arrow) {
    padding: 4px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink-display);
    font-weight: 670;
  }

  .decision-flow strong {
    color: var(--accent-blue-dark);
    font-weight: 760;
  }

  .flow-plus,
  .flow-arrow {
    color: var(--ink-subtle);
    font-weight: 700;
  }

  .checks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .check-card {
    min-width: 0;
    padding: clamp(15px, 2vw, 19px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .check-topline {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .check-signal {
    font-size: 0.69rem;
    line-height: 1.3;
    font-weight: 720;
    color: var(--ink-subtle);
  }

  .check-topline strong {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.32;
    color: var(--ink-display);
    font-weight: 780;
  }

  .metric-line {
    width: fit-content;
    margin-top: 10px;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface-blue-subtle);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.74rem;
    line-height: 1.3;
    font-weight: 730;
  }

  .check-card p {
    margin: 9px 0 0;
    font-size: 0.79rem;
    line-height: 1.52;
    color: var(--ink-muted);
  }

  .lab-output {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.5fr);
    gap: clamp(18px, 2.8vw, 30px);
    align-items: center;
    margin-top: 12px;
    padding: clamp(17px, 2.2vw, 22px);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 26%, var(--border-medium));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-card));
  }

  .output-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .output-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    line-height: 1.3;
    font-weight: 820;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
  }

  .output-copy strong {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.38;
    color: var(--ink-display);
  }

  .output-copy p {
    margin: 2px 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
  }

  .decision-card {
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
  }

  .decision-card strong {
    display: block;
    margin-bottom: 3px;
    font-family: var(--font-display);
    font-size: 0.84rem;
    color: var(--ink-display);
  }

  .decision-card span {
    display: block;
    font-size: 0.7rem;
    line-height: 1.42;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .lab-output {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .lab-header {
      flex-direction: column;
      gap: 16px;
    }

    .lab-link {
      width: 100%;
    }

    .checks-grid,
    .decision-grid {
      grid-template-columns: 1fr;
    }

    .decision-flow {
      align-items: flex-start;
    }
  }
</style>
