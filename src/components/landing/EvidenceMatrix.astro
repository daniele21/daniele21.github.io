---
// Homepage placeholders only. Replace these five values per device when the
// representative benchmark averages are ready.
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;

const deviceRuns = [
  {
    id: 'mac',
    label: 'MacBook Air M2 (16GB)',
    model: 'Nemotron Nano 4B Q4',
    image: 'images/performance-lab/macbook-air-m2.svg',
    metrics: { ttft: '0.42 s', tokens: '18', peakRam: '2.6 GB', thermal: '76 °C', taskSuccess: '86%' },
    status: 'Good',
    statusNote: 'Smooth experience for most tasks.',
    tone: 'good',
  },
  {
    id: 'android',
    label: 'Nothing Phone (2) 12GB',
    model: 'Qwen 3.5 2B Q4_K_M',
    image: 'images/performance-lab/nothing-phone-2.svg',
    metrics: { ttft: '0.91 s', tokens: '6.8', peakRam: '1.4 GB', thermal: '42 °C', taskSuccess: '71%' },
    status: 'Review',
    statusNote: 'Good for light tasks, slower on complex ones.',
    tone: 'review',
  },
];

const decisions = [
  { name: 'Local', description: 'All critical thresholds pass.', tone: 'local' },
  { name: 'Hybrid', description: 'Local handles the main flow; harder cases need fallback.', tone: 'hybrid' },
  { name: 'Cloud', description: 'A hard requirement is not met locally yet.', tone: 'cloud' },
];
---

<div class="performance-evidence">
  <div class="evidence-note">
    <span class="note-spark" aria-hidden="true">✧</span>
    <span>We measure what matters on your devices and show the evidence that drives the right deployment choice.</span>
  </div>

  <section class="evidence-panel" aria-labelledby="real-evidence-title">
    <h3 id="real-evidence-title" class="panel-title">Real evidence — my devices</h3>

    <div class="table-scroll">
      <div class="evidence-table" role="table" aria-label="Performance Lab benchmark averages by device">
        <div class="table-header" role="rowgroup">
          <div class="what-matters" role="columnheader">What matters</div>

          <div class="metric-group metric-group--speed" role="columnheader" aria-colspan="2">
            <span class="metric-icon metric-icon--speed" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h8l-1 8 9-12h-8l1-8Z" /></svg>
            </span>
            <strong>Speed</strong>
          </div>

          <div class="metric-group metric-group--memory" role="columnheader">
            <span class="metric-icon metric-icon--memory" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M19 9h3M19 14h3M2 9h3M2 14h3"/></svg>
            </span>
            <strong>Memory</strong>
          </div>

          <div class="metric-group metric-group--stability" role="columnheader">
            <span class="metric-icon metric-icon--stability" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V5a2 2 0 0 0-4 0v9.76a4 4 0 1 0 4 0Z"/></svg>
            </span>
            <strong>Stability</strong>
          </div>

          <div class="metric-group metric-group--quality" role="columnheader">
            <span class="metric-icon metric-icon--quality" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.2 2.2L15.8 9"/></svg>
            </span>
            <strong>Quality</strong>
          </div>

          <div class="status-head" aria-hidden="true"></div>

          <div class="submetric submetric--ttft" role="columnheader">TTFT</div>
          <div class="submetric submetric--tokens" role="columnheader">Tokens/s</div>
          <div class="submetric submetric--ram" role="columnheader">Peak RAM</div>
          <div class="submetric submetric--thermal" role="columnheader">Thermal</div>
          <div class="submetric submetric--quality" role="columnheader">Task success</div>
        </div>

        <div class="device-rows" role="rowgroup">
          {deviceRuns.map((device) => (
            <div class="device-row" role="row">
              <div class="device-cell" role="rowheader">
                <span class:list={['device-visual', `device-visual--${device.id}`]} aria-hidden="true">
                  <img src={asset(device.image)} alt="" loading="lazy" decoding="async" />
                </span>

                <div class="device-copy">
                  <strong>{device.label}</strong>
                  <span>Model: <b>{device.model}</b></span>
                </div>
              </div>

              <div class="metric-value metric-value--ttft" role="cell"><strong>{device.metrics.ttft}</strong></div>
              <div class="metric-value metric-value--tokens" role="cell"><strong>{device.metrics.tokens}</strong></div>
              <div class="metric-value metric-value--ram" role="cell"><strong>{device.metrics.peakRam}</strong></div>
              <div class="metric-value metric-value--thermal" role="cell"><strong>{device.metrics.thermal}</strong></div>
              <div class:list={['metric-value', 'metric-value--quality', `metric-value--${device.tone}`]} role="cell"><strong>{device.metrics.taskSuccess}</strong></div>

              <div class="run-status" role="cell">
                <strong class:list={[`run-status--${device.tone}`]}>
                  <span class="status-dot" aria-hidden="true"></span>{device.status}
                </strong>
                <span>{device.statusNote}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="decision-band" aria-label="Architecture decision outcomes">
    <div class="decision-copy">
      <strong>These results determine<br />where the workload should run.</strong>
    </div>

    {decisions.map((decision) => (
      <div class:list={['decision-card', `decision-card--${decision.tone}`]}>
        <span class="decision-icon" aria-hidden="true">
          {decision.tone === 'local' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="m8.5 12 2.3 2.3 4.8-5.1"/></svg>
          ) : decision.tone === 'hybrid' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h13"/><path d="m15 5 3 3-3 3"/><path d="M19 16H6"/><path d="m9 13-3 3 3 3"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18h10a4 4 0 0 0 .4-8A5.5 5.5 0 0 0 7 9a4.5 4.5 0 0 0 0 9Z"/></svg>
          )}
        </span>
        <div>
          <strong>{decision.name}</strong>
          <span>{decision.description}</span>
        </div>
      </div>
    ))}
  </section>
</div>

<style>
  .performance-evidence {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .evidence-note {
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 14%, var(--border-medium));
    border-radius: 15px;
    background: color-mix(in srgb, var(--surface-blue-subtle) 34%, var(--surface-card));
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .note-spark {
    flex: 0 0 auto;
    color: var(--accent-blue);
    font-size: 1.35rem;
    line-height: 1;
  }

  .evidence-panel {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: 18px;
    background: var(--surface-card);
    box-shadow: 0 2px 8px rgba(8, 19, 51, 0.018);
  }

  .panel-title {
    margin: 0;
    padding: 20px 28px 13px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .table-scroll {
    width: 100%;
    min-width: 0;
  }

  .evidence-table {
    --evidence-columns: 24.7% 10.4% 10.4% 14.2% 14% 12.2% 14.1%;
    width: 100%;
    min-width: 0;
  }

  .table-header,
  .device-row {
    display: grid;
    grid-template-columns: var(--evidence-columns);
  }

  .table-header {
    grid-template-rows: 48px 35px;
    border-bottom: 1px solid var(--border-medium);
  }

  .what-matters,
  .metric-group,
  .status-head,
  .submetric {
    min-width: 0;
  }

  .what-matters {
    grid-column: 1;
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    padding: 8px 28px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .metric-group {
    position: relative;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 6px 8px;
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
  }

  .metric-group::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 1px;
    background: color-mix(in srgb, var(--border-subtle) 82%, transparent);
  }

  .metric-group--speed { grid-column: 2 / span 2; }
  .metric-group--memory { grid-column: 4; }
  .metric-group--stability { grid-column: 5; }
  .metric-group--quality { grid-column: 6; }

  .status-head {
    grid-column: 7;
    grid-row: 1 / 3;
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
  }

  .metric-group strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.2;
    font-weight: 800;
    color: var(--ink-display);
  }

  .metric-icon {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .metric-icon svg { width: 15px; height: 15px; }
  .metric-icon--speed { color: #15803d; background: #edf9f0; }
  .metric-icon--memory { color: #7c3aed; background: #f4efff; }
  .metric-icon--stability { color: #ea580c; background: #fff3ec; }
  .metric-icon--quality { color: var(--accent-blue-dark); background: var(--surface-blue-subtle); }

  .submetric {
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px 6px;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.15;
    font-weight: 650;
    text-align: center;
  }

  .submetric--ttft { grid-column: 2; border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent); }
  .submetric--tokens { grid-column: 3; border-left: 1px solid color-mix(in srgb, var(--border-subtle) 58%, transparent); }
  .submetric--ram { grid-column: 4; border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent); }
  .submetric--thermal { grid-column: 5; border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent); }
  .submetric--quality { grid-column: 6; border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent); }

  .device-row {
    min-height: 92px;
    align-items: stretch;
    border-bottom: 1px solid color-mix(in srgb, var(--border-subtle) 86%, transparent);
  }

  .device-row:last-child {
    border-bottom: 0;
  }

  .device-cell {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 24px;
  }

  .device-visual {
    width: 76px;
    height: 64px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .device-visual img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .device-visual--android {
    width: 58px;
    margin-inline: 9px;
  }

  .device-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .device-copy > strong,
  .device-copy > span {
    white-space: nowrap;
  }

  .device-copy > strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.25;
    font-weight: 800;
    color: var(--ink-display);
  }

  .device-copy > span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.25;
  }

  .device-copy b {
    color: var(--accent-indigo);
    font-weight: 720;
  }

  .metric-value {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 5px;
    text-align: center;
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 66%, transparent);
  }

  .metric-value strong {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.45vw, 1.55rem);
    line-height: 1.05;
    font-weight: 790;
    letter-spacing: -0.025em;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .metric-value--good strong { color: #169c45; }
  .metric-value--review strong { color: #d97706; }

  .run-status {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 10px 16px;
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
  }

  .run-status > strong {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.15;
    font-weight: 800;
  }

  .run-status--good { color: #169c45; }
  .run-status--review { color: #d97706; }

  .status-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
  }

  .run-status > span {
    max-width: 180px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.35;
  }

  .decision-band {
    min-height: 122px;
    display: grid;
    grid-template-columns: 25% repeat(3, minmax(0, 1fr));
    gap: 14px;
    align-items: stretch;
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-medium));
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface-blue-subtle) 26%, var(--surface-card));
  }

  .decision-copy {
    display: flex;
    align-items: center;
    padding: 6px 28px 6px 8px;
    border-right: 1px solid var(--border-subtle);
  }

  .decision-copy strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.35;
    font-weight: 800;
    letter-spacing: -0.012em;
    color: var(--ink-display);
  }

  .decision-card {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    background: var(--surface-card);
  }

  .decision-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .decision-icon svg {
    width: 24px;
    height: 24px;
  }

  .decision-card > div {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .decision-card > div > strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.15;
    font-weight: 800;
  }

  .decision-card > div > span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.32;
  }

  .decision-card--local { border-color: #d5ebdc; background: #fbfffc; }
  .decision-card--local .decision-icon { color: #169c45; background: #e8f7ed; }
  .decision-card--local > div > strong { color: #169c45; }

  .decision-card--hybrid { border-color: #f4dfbe; background: #fffdf9; }
  .decision-card--hybrid .decision-icon { color: #e88900; background: #fff2dd; }
  .decision-card--hybrid > div > strong { color: #e88900; }

  .decision-card--cloud { border-color: #f4d8d8; background: #fffafa; }
  .decision-card--cloud .decision-icon { color: #ef2323; background: #fde9e9; }
  .decision-card--cloud > div > strong { color: #ef2323; }

  @media (max-width: 1180px) {
    .table-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .evidence-table {
      min-width: 980px;
    }

    .decision-band {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .decision-copy {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
      padding: 2px 2px 12px;
    }
  }

  @media (max-width: 640px) {
    .performance-evidence {
      gap: 18px;
    }

    .evidence-note {
      min-height: 54px;
      padding: 10px 13px;
    }

    .panel-title {
      padding: 16px 18px 10px;
    }

    .decision-band {
      grid-template-columns: 1fr;
      padding: 14px;
    }

    .decision-copy {
      grid-column: auto;
    }
  }
</style>
