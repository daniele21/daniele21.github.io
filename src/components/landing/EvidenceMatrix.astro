---
// Homepage placeholders only. Replace these five values per device when the
// representative benchmark averages are ready.
const deviceRuns = [
  {
    id: 'mac',
    label: 'MacBook Air M2 (16GB)',
    model: 'Nemotron Nano 4B Q4',
    metrics: { ttft: '0.42 s', tokens: '18', peakRam: '2.6 GB', thermal: '76 °C', taskSuccess: '86%' },
    status: 'Good',
    statusNote: 'Smooth experience for most tasks.',
    tone: 'good',
  },
  {
    id: 'android',
    label: 'Nothing Phone (2) 12GB',
    model: 'Qwen 3.5 2B Q4_K_M',
    metrics: { ttft: '0.91 s', tokens: '6.8', peakRam: '1.4 GB', thermal: '42 °C', taskSuccess: '71%' },
    status: 'Review',
    statusNote: 'Good for light tasks, slower on complex ones.',
    tone: 'review',
  },
];

const decisions = [
  { name: 'Local', description: 'All critical thresholds pass.', tone: 'local', icon: '✓' },
  { name: 'Hybrid', description: 'Local handles the main flow; harder cases need fallback.', tone: 'hybrid', icon: '↔' },
  { name: 'Cloud', description: 'A hard requirement is not met locally yet.', tone: 'cloud', icon: '☁' },
];
---

<div class="performance-evidence">
  <div class="evidence-note">
    <span class="note-spark" aria-hidden="true">✧</span>
    <span>We measure what matters on your devices and show the evidence that drives the right deployment choice.</span>
  </div>

  <section class="evidence-panel" aria-labelledby="real-evidence-title">
    <h3 id="real-evidence-title" class="panel-title">Real evidence — my devices</h3>

    <div class="table-scroll">
      <div class="evidence-table" role="table" aria-label="Performance Lab benchmark averages by device">
        <div class="group-row" role="row">
          <div class="what-matters" role="columnheader">What matters</div>

          <div class="metric-group metric-group--speed" role="columnheader" aria-colspan="2">
            <span class="metric-icon metric-icon--speed" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h8l-1 8 9-12h-8l1-8Z" /></svg>
            </span>
            <strong>Speed</strong>
          </div>

          <div class="metric-group metric-group--memory" role="columnheader">
            <span class="metric-icon metric-icon--memory" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M19 9h3M19 14h3M2 9h3M2 14h3"/></svg>
            </span>
            <strong>Memory</strong>
          </div>

          <div class="metric-group metric-group--stability" role="columnheader">
            <span class="metric-icon metric-icon--stability" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V5a2 2 0 0 0-4 0v9.76a4 4 0 1 0 4 0Z"/></svg>
            </span>
            <strong>Stability</strong>
          </div>

          <div class="metric-group metric-group--quality" role="columnheader">
            <span class="metric-icon metric-icon--quality" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.2 2.2L15.8 9"/></svg>
            </span>
            <strong>Quality</strong>
          </div>

          <div class="status-head" aria-hidden="true"></div>
        </div>

        <div class="subhead-row" role="row">
          <div aria-hidden="true"></div>
          <div role="columnheader">TTFT</div>
          <div role="columnheader">Tokens/s</div>
          <div role="columnheader">Peak RAM</div>
          <div role="columnheader">Thermal</div>
          <div role="columnheader">Task success</div>
          <div aria-hidden="true"></div>
        </div>

        <div class="device-rows" role="rowgroup">
          {deviceRuns.map((device) => (
            <div class="device-row" role="row">
              <div class="device-cell" role="rowheader">
                <span class:list={['device-visual', `device-visual--${device.id}`]} aria-hidden="true">
                  {device.id === 'mac' ? (
                    <svg viewBox="0 0 52 42" fill="none">
                      <rect x="8" y="4" width="36" height="25" rx="2.5" fill="#10182f"/>
                      <rect x="10.5" y="6.5" width="31" height="20" rx="1.2" fill="url(#macScreen)"/>
                      <path d="M3 32h46l-3 4H6z" fill="#b8c1cf"/>
                      <path d="M18 32h16" stroke="#778399" stroke-width="1.5"/>
                      <defs><linearGradient id="macScreen" x1="11" y1="7" x2="40" y2="27"><stop stop-color="#101b44"/><stop offset="1" stop-color="#5277d9"/></linearGradient></defs>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 34 52" fill="none">
                      <rect x="4" y="1.5" width="26" height="49" rx="6" fill="#11151d"/>
                      <rect x="6.5" y="4" width="21" height="44" rx="4" fill="#303740"/>
                      <circle cx="12" cy="10" r="3.4" fill="#0d1016" stroke="#78828f"/>
                      <circle cx="21" cy="10" r="3.4" fill="#0d1016" stroke="#78828f"/>
                      <circle cx="17" cy="28" r="7" fill="none" stroke="#858d97" stroke-width="1.5"/>
                      <path d="M9 20h16M9 37h16" stroke="#707985" stroke-width="1"/>
                    </svg>
                  )}
                </span>

                <div class="device-copy">
                  <strong>{device.label}</strong>
                  <span>Model: <b>{device.model}</b></span>
                </div>
              </div>

              <div class="metric-value" role="cell"><strong>{device.metrics.ttft}</strong></div>
              <div class="metric-value" role="cell"><strong>{device.metrics.tokens}</strong></div>
              <div class="metric-value" role="cell"><strong>{device.metrics.peakRam}</strong></div>
              <div class="metric-value" role="cell"><strong>{device.metrics.thermal}</strong></div>
              <div class:list={['metric-value', `metric-value--${device.tone}`]} role="cell"><strong>{device.metrics.taskSuccess}</strong></div>

              <div class="run-status" role="cell">
                <strong class:list={[`run-status--${device.tone}`]}>
                  <span class="status-dot" aria-hidden="true"></span>{device.status}
                </strong>
                <span>{device.statusNote}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="decision-band" aria-label="Architecture decision outcomes">
    <div class="decision-copy">
      <strong>These results determine<br />where the workload should run.</strong>
    </div>

    {decisions.map((decision) => (
      <div class:list={['decision-card', `decision-card--${decision.tone}`]}>
        <span class="decision-icon" aria-hidden="true">{decision.icon}</span>
        <div>
          <strong>{decision.name}</strong>
          <span>{decision.description}</span>
        </div>
      </div>
    ))}
  </section>
</div>

<style>
  .performance-evidence {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .evidence-note {
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 14%, var(--border-medium));
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface-blue-subtle) 34%, var(--surface-card));
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .note-spark {
    flex: 0 0 auto;
    color: var(--accent-blue);
    font-size: 1.2rem;
    line-height: 1;
  }

  .evidence-panel {
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: 18px;
    background: var(--surface-card);
    box-shadow: 0 2px 8px rgba(8, 19, 51, 0.018);
  }

  .panel-title {
    margin: 0;
    padding: 15px 20px 8px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .table-scroll {
    width: 100%;
    min-width: 0;
  }

  .evidence-table {
    /* One source of truth for desktop geometry. The proportions are taken from
       the approved reference and intentionally avoid elastic fr competition. */
    --evidence-columns: 25.5% 10.4% 10.4% 14.1% 14.1% 12.3% 13.2%;
    width: 100%;
    min-width: 0;
  }

  .group-row,
  .subhead-row,
  .device-row {
    display: grid;
    grid-template-columns: var(--evidence-columns);
  }

  .group-row {
    min-height: 56px;
    align-items: stretch;
    border-bottom: 1px solid color-mix(in srgb, var(--border-subtle) 82%, transparent);
  }

  .what-matters,
  .metric-group,
  .status-head {
    display: flex;
    align-items: center;
    padding: 9px 10px;
  }

  .what-matters {
    align-items: flex-end;
    padding-left: 20px;
    padding-bottom: 11px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .metric-group,
  .status-head {
    justify-content: center;
    gap: 8px;
  }

  /* Only group boundaries are visible in the upper header. */
  .metric-group--speed,
  .metric-group--memory,
  .metric-group--stability,
  .metric-group--quality,
  .status-head {
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 78%, transparent);
  }

  .metric-group--speed { grid-column: 2 / span 2; }
  .metric-group--memory { grid-column: 4; }
  .metric-group--stability { grid-column: 5; }
  .metric-group--quality { grid-column: 6; }
  .status-head { grid-column: 7; }

  .metric-group strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.2;
    font-weight: 800;
    color: var(--ink-display);
  }

  .metric-icon {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .metric-icon svg { width: 15px; height: 15px; }
  .metric-icon--speed { color: #15803d; background: #edf9f0; }
  .metric-icon--memory { color: #7c3aed; background: #f4efff; }
  .metric-icon--stability { color: #ea580c; background: #fff3ec; }
  .metric-icon--quality { color: var(--accent-blue-dark); background: var(--surface-blue-subtle); }

  .subhead-row {
    min-height: 32px;
    align-items: stretch;
    border-bottom: 1px solid var(--border-medium);
  }

  .subhead-row > div {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px 6px;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.15;
    font-weight: 650;
    text-align: center;
  }

  /* Keep the grid legible without turning it into a spreadsheet. */
  .subhead-row > div:nth-child(2),
  .subhead-row > div:nth-child(4),
  .subhead-row > div:nth-child(5),
  .subhead-row > div:nth-child(6),
  .subhead-row > div:nth-child(7) {
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 70%, transparent);
  }

  .device-row {
    min-height: 88px;
    align-items: stretch;
    border-bottom: 1px solid color-mix(in srgb, var(--border-subtle) 86%, transparent);
  }

  .device-row:last-child {
    border-bottom: 0;
  }

  .device-cell {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
  }

  .device-visual {
    width: 50px;
    height: 48px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .device-visual--mac svg { width: 50px; height: 40px; }
  .device-visual--android svg { width: 28px; height: 44px; }

  .device-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .device-copy > strong,
  .device-copy > span {
    white-space: nowrap;
    overflow: visible;
    text-overflow: clip;
  }

  .device-copy > strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.25;
    font-weight: 800;
    color: var(--ink-display);
  }

  .device-copy > span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.25;
  }

  .device-copy b {
    color: var(--accent-indigo);
    font-weight: 720;
  }

  .metric-value {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 4px;
    text-align: center;
  }

  .metric-value:nth-of-type(2),
  .metric-value:nth-of-type(4),
  .metric-value:nth-of-type(5),
  .metric-value:nth-of-type(6) {
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 70%, transparent);
  }

  .metric-value strong {
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.32vw, 1.35rem);
    line-height: 1.05;
    font-weight: 790;
    letter-spacing: -0.025em;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .metric-value--good strong { color: #169c45; }
  .metric-value--review strong { color: #d97706; }

  .run-status {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    padding: 9px 10px;
    border-left: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
  }

  .run-status > strong {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.15;
    font-weight: 800;
  }

  .run-status--good { color: #169c45; }
  .run-status--review { color: #d97706; }

  .status-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
  }

  .run-status > span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.28;
  }

  .decision-band {
    min-height: 100px;
    display: grid;
    grid-template-columns: 27.5% repeat(3, minmax(0, 1fr));
    gap: 12px;
    align-items: stretch;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-medium));
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface-blue-subtle) 28%, var(--surface-card));
  }

  .decision-copy {
    display: flex;
    align-items: center;
    padding: 4px 18px 4px 2px;
    border-right: 1px solid var(--border-subtle);
  }

  .decision-copy strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.32;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--ink-display);
  }

  .decision-card {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 11px;
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    background: var(--surface-card);
  }

  .decision-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 850;
  }

  .decision-card > div {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .decision-card > div > strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.15;
    font-weight: 800;
  }

  .decision-card > div > span {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.28;
  }

  .decision-card--local { border-color: #d5ebdc; background: #fbfffc; }
  .decision-card--local .decision-icon { color: #169c45; background: #e8f7ed; }
  .decision-card--local > div > strong { color: #169c45; }

  .decision-card--hybrid { border-color: #f4dfbe; background: #fffdf9; }
  .decision-card--hybrid .decision-icon { color: #e88900; background: #fff2dd; }
  .decision-card--hybrid > div > strong { color: #e88900; }

  .decision-card--cloud { border-color: #f4d8d8; background: #fffafa; }
  .decision-card--cloud .decision-icon { color: #ef2323; background: #fde9e9; }
  .decision-card--cloud > div > strong { color: #ef2323; }

  @media (max-width: 900px) {
    .table-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .evidence-table {
      min-width: 880px;
    }

    .decision-band {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .decision-copy {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
      padding: 2px 2px 11px;
    }
  }

  @media (max-width: 640px) {
    .performance-evidence {
      gap: 18px;
    }

    .evidence-note {
      align-items: flex-start;
      padding: 10px 12px;
    }

    .decision-band {
      grid-template-columns: 1fr;
      padding: 12px;
    }

    .decision-copy {
      grid-column: auto;
    }
  }
</style>
