---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;

const deviceRuns = [
  {
    id: 'mac',
    label: 'Mac',
    model: 'Nemotron Nano 4B Q4',
    metrics: {
      ttft: '—',
      tokens: '—',
      peakRam: '—',
      thermal: '—',
      taskSuccess: '—',
    },
  },
  {
    id: 'android',
    label: 'Android',
    model: 'Qwen 3.5 2B Q4_K_M',
    metrics: {
      ttft: '—',
      tokens: '—',
      peakRam: '—',
      thermal: '—',
      taskSuccess: '—',
    },
  },
];

const decisions = [
  {
    name: 'Local',
    description: 'Critical thresholds pass.',
    tone: 'local',
  },
  {
    name: 'Hybrid',
    description: 'Local works, with fallback where needed.',
    tone: 'hybrid',
  },
  {
    name: 'Cloud',
    description: 'A hard requirement is not met locally.',
    tone: 'cloud',
  },
];
---

<div class="performance-lab-surface" aria-label="Performance Lab evidence for Local, Hybrid and Cloud decisions">
  <article class="lab-card">
    <header class="lab-header">
      <div class="lab-heading-copy">
        <h3>Performance Lab</h3>
        <p class="lab-question">Can this workload run locally?</p>
        <p class="lab-purpose">
          Real model × real device → evidence for a Local, Hybrid or Cloud decision.
        </p>
      </div>

      <a href={resolveHref('performance-lab')} class="lab-link">
        Open the lab <span aria-hidden="true">→</span>
      </a>
    </header>

    <section class="evidence-panel" aria-labelledby="evidence-title">
      <div class="evidence-panel__topline">
        <h4 id="evidence-title">Real evidence — my devices</h4>
        <span class="evidence-status">Validated averages pending</span>
      </div>

      <div class="evidence-table-scroll">
        <div class="evidence-table" role="table" aria-label="Performance Lab metrics by device">
          <div class="evidence-groups" role="row">
            <div class="group-label group-label--context" role="columnheader">What matters</div>

            <div class="metric-group metric-group--speed" role="columnheader" aria-colspan="2">
              <span class="metric-icon metric-icon--speed" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m13 2-9 12h8l-1 8 9-12h-8l1-8Z" />
                </svg>
              </span>
              <strong>Speed</strong>
            </div>

            <div class="metric-group metric-group--memory" role="columnheader">
              <span class="metric-icon metric-icon--memory" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="7" y="7" width="10" height="10" rx="1" />
                  <path d="M9 2v3M15 2v3M9 19v3M15 19v3M19 9h3M19 14h3M2 9h3M2 14h3" />
                </svg>
              </span>
              <strong>Memory</strong>
            </div>

            <div class="metric-group metric-group--stability" role="columnheader">
              <span class="metric-icon metric-icon--stability" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 14.76V5a2 2 0 0 0-4 0v9.76a4 4 0 1 0 4 0Z" />
                </svg>
              </span>
              <strong>Stability</strong>
            </div>

            <div class="metric-group metric-group--quality" role="columnheader">
              <span class="metric-icon metric-icon--quality" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m8.5 12 2.2 2.2L15.8 9" />
                </svg>
              </span>
              <strong>Quality</strong>
            </div>
          </div>

          <div class="metric-subheaders" role="row">
            <div aria-hidden="true"></div>
            <div role="columnheader">TTFT</div>
            <div role="columnheader">Tokens/s</div>
            <div role="columnheader">Peak RAM</div>
            <div role="columnheader">Thermal</div>
            <div role="columnheader">Task success</div>
          </div>

          <div class="device-rows" role="rowgroup">
            {deviceRuns.map((device) => (
              <div class="device-row" role="row">
                <div class="device-cell" role="rowheader">
                  <span class:list={['device-icon', `device-icon--${device.id}`]} aria-hidden="true">
                    {device.id === 'mac' ? (
                      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="7" y="6" width="18" height="14" rx="1.8" />
                        <path d="M3.5 24h25M11 24l1-2h8l1 2" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="10" y="3" width="12" height="26" rx="2.5" />
                        <path d="M14 6h4M15 26h2" />
                      </svg>
                    )}
                  </span>
                  <div>
                    <strong>{device.label}</strong>
                    <span>Model: <b>{device.model}</b></span>
                  </div>
                </div>

                <div class="metric-value metric-value--pending" role="cell">
                  <strong>{device.metrics.ttft}</strong>
                  <span>pending</span>
                </div>
                <div class="metric-value metric-value--pending" role="cell">
                  <strong>{device.metrics.tokens}</strong>
                  <span>pending</span>
                </div>
                <div class="metric-value metric-value--pending" role="cell">
                  <strong>{device.metrics.peakRam}</strong>
                  <span>pending</span>
                </div>
                <div class="metric-value metric-value--pending" role="cell">
                  <strong>{device.metrics.thermal}</strong>
                  <span>pending</span>
                </div>
                <div class="metric-value metric-value--pending" role="cell">
                  <strong>{device.metrics.taskSuccess}</strong>
                  <span>pending</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="evidence-panel__footer">
        <span>Publish averages only after representative runs.</span>
        <a href={resolveHref('performance-lab#evidence')}>See full benchmarks →</a>
      </div>
    </section>

    <section class="decision-band" aria-label="Architecture decision outcomes">
      <div class="decision-copy">
        <strong>These results determine where the workload should run.</strong>
      </div>

      <div class="decision-grid">
        {decisions.map((decision) => (
          <div class:list={['decision-card', `decision-card--${decision.tone}`]}>
            <span class="decision-icon" aria-hidden="true">
              {decision.tone === 'local' ? '✓' : decision.tone === 'hybrid' ? '↔' : '☁'}
            </span>
            <div>
              <strong>{decision.name}</strong>
              <span>{decision.description}</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  </article>
</div>

<style>
  .performance-lab-surface {
    width: 100%;
  }

  .lab-card {
    padding: clamp(24px, 3.2vw, 38px);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 16%, var(--border-medium));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 94% 0%, color-mix(in srgb, var(--accent-blue) 6%, transparent), transparent 34%),
      var(--surface-card);
    box-shadow: 0 7px 28px rgba(8, 19, 51, 0.045);
  }

  .lab-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
  }

  .lab-heading-copy {
    max-width: 650px;
  }

  .lab-heading-copy h3 {
    margin: 0 0 7px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 830;
    color: var(--ink-display);
  }

  .lab-question {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.28;
    letter-spacing: -0.025em;
    font-weight: 760;
    color: var(--ink-display);
  }

  .lab-purpose {
    margin: 9px 0 0;
    font-size: 0.9rem;
    line-height: 1.52;
    color: var(--ink-muted);
  }

  .lab-link {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 0 12px;
    border-radius: var(--radius-full);
    color: var(--accent-blue-dark);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 760;
    transition: color var(--duration-fast) ease, background var(--duration-fast) ease;
  }

  .lab-link:hover,
  .lab-link:focus-visible {
    color: var(--accent-blue);
    background: var(--surface-blue-subtle);
  }

  .evidence-panel {
    margin-top: clamp(34px, 5vw, 56px);
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
  }

  .evidence-panel__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 18px 10px;
  }

  .evidence-panel__topline h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.72rem;
    line-height: 1.3;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 820;
    color: var(--ink-muted);
  }

  .evidence-status {
    font-size: 0.7rem;
    line-height: 1.3;
    color: var(--ink-subtle);
  }

  .evidence-table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .evidence-table {
    min-width: 880px;
  }

  .evidence-groups,
  .metric-subheaders,
  .device-row {
    display: grid;
    grid-template-columns: minmax(250px, 1.55fr) repeat(5, minmax(96px, 0.8fr));
  }

  .evidence-groups {
    align-items: stretch;
    border-bottom: 1px solid var(--border-subtle);
  }

  .group-label,
  .metric-group {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 12px 14px;
  }

  .group-label--context {
    align-items: flex-end;
    padding-left: 18px;
    padding-bottom: 15px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 820;
    color: var(--ink-muted);
  }

  .metric-group {
    justify-content: center;
    border-left: 1px solid var(--border-subtle);
    font-family: var(--font-display);
    color: var(--ink-display);
  }

  .metric-group--speed {
    grid-column: 2 / span 2;
  }

  .metric-group--memory { grid-column: 4; }
  .metric-group--stability { grid-column: 5; }
  .metric-group--quality { grid-column: 6; }

  .metric-group strong {
    font-size: 0.84rem;
    line-height: 1.25;
    font-weight: 780;
  }

  .metric-icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }

  .metric-icon svg {
    width: 16px;
    height: 16px;
  }

  .metric-icon--speed {
    color: #15803d;
    background: #edf9f0;
  }

  .metric-icon--memory {
    color: #7c3aed;
    background: #f4efff;
  }

  .metric-icon--stability {
    color: #ea580c;
    background: #fff3ec;
  }

  .metric-icon--quality {
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
  }

  .metric-subheaders {
    min-height: 38px;
    align-items: center;
    border-bottom: 1px solid var(--border-medium);
    color: var(--ink-muted);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .metric-subheaders > div {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--border-subtle);
  }

  .metric-subheaders > div:first-child {
    border-left: 0;
  }

  .device-row {
    min-height: 96px;
    align-items: stretch;
    border-bottom: 1px solid var(--border-subtle);
  }

  .device-row:last-child {
    border-bottom: 0;
  }

  .device-cell {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 15px 18px;
  }

  .device-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
    color: var(--ink-display);
  }

  .device-icon svg {
    width: 29px;
    height: 29px;
  }

  .device-cell > div {
    min-width: 0;
  }

  .device-cell strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.3;
    font-weight: 780;
    color: var(--ink-display);
  }

  .device-cell span {
    display: block;
    margin-top: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .device-cell b {
    color: var(--accent-blue-dark);
    font-weight: 720;
  }

  .metric-value {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 13px 8px;
    border-left: 1px solid var(--border-subtle);
    text-align: center;
  }

  .metric-value strong {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.28rem);
    line-height: 1;
    font-weight: 820;
    color: var(--ink-display);
  }

  .metric-value span {
    font-size: 0.64rem;
    line-height: 1.25;
    color: var(--ink-subtle);
  }

  .metric-value--pending strong {
    color: var(--ink-subtle);
  }

  .evidence-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--surface-subtle) 58%, var(--surface-card));
    font-size: 0.68rem;
    line-height: 1.35;
    color: var(--ink-subtle);
  }

  .evidence-panel__footer a {
    color: var(--accent-blue-dark);
    text-decoration: none;
    font-weight: 720;
    white-space: nowrap;
  }

  .decision-band {
    display: grid;
    grid-template-columns: minmax(230px, 0.9fr) minmax(0, 2fr);
    gap: clamp(20px, 3vw, 38px);
    align-items: center;
    margin-top: 18px;
    padding: clamp(18px, 2.4vw, 24px);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 20%, var(--border-medium));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent-blue) 3%, var(--surface-card));
  }

  .decision-copy strong {
    display: block;
    max-width: 290px;
    font-family: var(--font-display);
    font-size: clamp(0.96rem, 1.35vw, 1.12rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink-display);
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
  }

  .decision-card {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .decision-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
  }

  .decision-card--local .decision-icon {
    color: #15803d;
    background: #edf9f0;
  }

  .decision-card--hybrid .decision-icon {
    color: #d97706;
    background: #fff7e8;
  }

  .decision-card--cloud .decision-icon {
    color: #dc2626;
    background: #fff0f0;
  }

  .decision-card > div {
    min-width: 0;
  }

  .decision-card strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--ink-display);
  }

  .decision-card span:last-child {
    display: block;
    margin-top: 2px;
    font-size: 0.67rem;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .decision-band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .lab-card {
      padding: 20px;
    }

    .lab-header {
      flex-direction: column;
      gap: 14px;
    }

    .lab-link {
      align-self: flex-start;
      padding-left: 0;
    }

    .evidence-panel {
      margin-top: 32px;
    }

    .evidence-panel__topline,
    .evidence-panel__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .decision-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
