---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;

const measurements = [
  {
    title: 'Speed',
    detail: 'TTFT · tokens/s',
    description: 'How quickly the workload becomes useful to the person using it.',
  },
  {
    title: 'Resources',
    detail: 'RAM · thermals · battery',
    description: 'What sustained local execution costs on the target device.',
  },
  {
    title: 'Quality',
    detail: 'Task accuracy · evaluation',
    description: 'Whether the model is good enough for the actual product task.',
  },
  {
    title: 'Privacy',
    detail: 'Network activity · data egress',
    description: 'Whether the observed run respects the expected data boundary.',
  },
];
---

<div class="evidence-surface" aria-label="What I measure before deciding whether Local AI is good enough">
  <article class="evidence-card evidence-card--primary">
    <div class="card-heading-row">
      <div>
        <h3>Performance Lab</h3>
        <p>What should be measured before calling a local setup good enough?</p>
      </div>
      <a href={resolveHref('performance-lab')} class="card-link">
        Open the lab <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="measurement-grid">
      {measurements.map((item) => (
        <div class="measurement-item">
          <div class="measurement-topline">
            <strong>{item.title}</strong>
            <span>{item.detail}</span>
          </div>
          <p>{item.description}</p>
        </div>
      ))}
    </div>

    <p class="evidence-note">
      Representative benchmark numbers belong here only after validated device runs. Until then, the homepage shows what I measure — not sample claims.
    </p>
  </article>

  <article class="evidence-card evidence-card--secondary">
    <div class="card-heading-row">
      <div>
        <h3>Traffic Monitoring</h3>
        <p>Does the observed workload stay inside the boundary we expect?</p>
      </div>
      <a href={resolveHref('traffic-monitoring')} class="card-link">
        See network evidence <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="network-proof-grid">
      <div class="network-proof">
        <span class="proof-icon" aria-hidden="true">◎</span>
        <div>
          <strong>Process-level visibility</strong>
          <p>Observe the AI processes involved in a run instead of assuming the architecture behaves as designed.</p>
        </div>
      </div>
      <div class="network-proof">
        <span class="proof-icon" aria-hidden="true">↗</span>
        <div>
          <strong>Outbound inspection</strong>
          <p>Inspect network activity to verify whether sensitive data leaves the expected boundary during that run.</p>
        </div>
      </div>
    </div>
  </article>

  <div class="evidence-loop">
    <div>
      <strong>Evidence changes the next decision.</strong>
      <span>Measure, then decide again.</span>
    </div>
    <div class="decision-options" aria-label="Architecture decision outcomes">
      <span>Local</span>
      <span>Hybrid</span>
      <span>Cloud</span>
    </div>
  </div>
</div>

<style>
  .evidence-surface {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .evidence-card {
    padding: clamp(20px, 2.6vw, 30px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: 0 5px 22px rgba(8, 19, 51, 0.045);
  }

  .evidence-card--primary {
    background:
      radial-gradient(circle at 92% 2%, color-mix(in srgb, var(--accent-blue) 7%, transparent), transparent 34%),
      var(--surface-card);
  }

  .card-heading-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 20px;
  }

  .card-heading-row h3 {
    margin: 0 0 5px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: var(--ink-display);
  }

  .card-heading-row p {
    max-width: 650px;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .card-link {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 0 11px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink-display);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 720;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .card-link:hover,
  .card-link:focus-visible {
    transform: translateY(-1px);
    color: var(--accent-blue-dark);
    border-color: color-mix(in srgb, var(--accent-blue) 42%, var(--border-medium));
  }

  .measurement-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .measurement-item {
    min-width: 0;
    padding: 17px;
    border-right: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--surface-subtle) 56%, var(--surface-card));
  }

  .measurement-item:last-child { border-right: 0; }

  .measurement-topline {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 10px;
  }

  .measurement-topline strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 780;
    color: var(--ink-display);
  }

  .measurement-topline span {
    font-size: 0.73rem;
    line-height: 1.35;
    color: var(--accent-blue-dark);
    font-weight: 680;
  }

  .measurement-item p {
    margin: 0;
    font-size: 0.79rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .evidence-note {
    margin: 14px 0 0;
    padding-top: 13px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--ink-subtle);
  }

  .network-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .network-proof {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
  }

  .proof-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--surface-blue-subtle);
    color: var(--accent-blue-dark);
    font-weight: 800;
  }

  .network-proof strong {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--ink-display);
  }

  .network-proof p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .evidence-loop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 18%, var(--border-medium));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent-blue) 3.5%, var(--surface-card));
  }

  .evidence-loop > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .evidence-loop strong {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--ink-display);
  }

  .evidence-loop span {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .decision-options {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .decision-options span {
    padding: 5px 9px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 740;
    color: var(--ink-display);
  }

  @media (max-width: 860px) {
    .measurement-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .measurement-item:nth-child(2) { border-right: 0; }
    .measurement-item:nth-child(-n + 2) { border-bottom: 1px solid var(--border-subtle); }
  }

  @media (max-width: 680px) {
    .card-heading-row,
    .evidence-loop {
      align-items: flex-start;
      flex-direction: column;
    }

    .network-proof-grid { grid-template-columns: 1fr; }
    .card-link { width: 100%; justify-content: center; }
  }

  @media (max-width: 480px) {
    .measurement-grid { grid-template-columns: 1fr; }
    .measurement-item,
    .measurement-item:nth-child(2) {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .measurement-item:last-child { border-bottom: 0; }
    .decision-options { flex-wrap: wrap; }
  }
</style>
