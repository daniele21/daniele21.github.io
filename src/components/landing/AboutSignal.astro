---
/** Compact homepage introduction. The full background stays on the About page. */
import { landingData } from '../../content/locales/en/landing';

const { aboutSignal } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const focusAreas = [
  {
    title: 'GenAI systems',
    detail: 'From LLM evaluation and retrieval to production architecture and integration.',
  },
  {
    title: 'Local & on-device AI',
    detail: 'Understanding what can move from cloud APIs to infrastructure and devices we control.',
  },
  {
    title: 'AI engineering & strategy',
    detail: 'Connecting architecture decisions to real product, privacy and performance constraints.',
  },
];
---

<section class="about-signal-section" id="about" aria-labelledby="about-title">
  <div class="shell about-shell">
    <div class="about-main">
      <h2 id="about-title">Who am I?</h2>
      <p class="about-summary">
        I'm an AI engineer and strategy lead focused on turning GenAI choices into systems that can be built, tested and measured — with a particular focus on Local and on-device AI.
      </p>
      <a class="primary-button about-cta" href={`${baseUrl}/about`}>
        More about me <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="focus-list" aria-label="Main areas of work">
      {focusAreas.map((area) => (
        <div class="focus-item">
          <h3>{area.title}</h3>
          <p>{area.detail}</p>
        </div>
      ))}
    </div>

    <div class="about-links" aria-label="Professional profiles">
      <a href={aboutSignal.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={aboutSignal.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
</section>

<style>
  .about-signal-section {
    padding: clamp(62px, 8vw, 104px) 0;
    background: var(--surface-canvas);
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-shell {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(420px, 1.25fr);
    gap: clamp(30px, 5vw, 68px);
    align-items: start;
  }

  .about-main h2 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    font-weight: 840;
    color: var(--ink-display);
  }

  .about-summary {
    max-width: 570px;
    margin: 0 0 24px;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .about-cta {
    min-height: 44px;
    padding-inline: 16px;
  }

  .focus-list {
    border-top: 1px solid var(--border-medium);
  }

  .focus-item {
    display: grid;
    grid-template-columns: minmax(145px, 0.45fr) minmax(0, 1fr);
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .focus-item h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.4;
    font-weight: 780;
    color: var(--ink-display);
  }

  .focus-item p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .about-links {
    grid-column: 2;
    display: flex;
    gap: 18px;
    margin-top: -46px;
    justify-content: flex-end;
  }

  .about-links a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 650;
    transition: color var(--duration-fast) ease;
  }

  .about-links a:hover,
  .about-links a:focus-visible { color: var(--accent-blue-dark); }

  @media (max-width: 860px) {
    .about-shell { grid-template-columns: 1fr; }
    .about-links {
      grid-column: 1;
      margin-top: 0;
      justify-content: flex-start;
    }
  }

  @media (max-width: 560px) {
    .focus-item { grid-template-columns: 1fr; gap: 5px; }
  }
</style>
