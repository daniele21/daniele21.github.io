---
/**
 * LandingHeader.astro
 * Quiet, accessible sticky header with brand mark, section navigation, and CTA.
 */
import { landingData } from '../../content/locales/en/landing';

const { header, hero } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<header class="landing-header" id="site-header">
  <div class="shell header-shell">
    <a class="brand" href={`${baseUrl}/`} aria-label={`${header.brandName} homepage`}>
      <span class="brand-avatar-frame">
        <img
          src={resolveHref(hero.identity.portraitPath)}
          alt={hero.identity.portraitAlt}
          class="brand-avatar"
          width="48"
          height="48"
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="brand-copy">
        <span class="brand-name">{header.brandName}</span>
        <span class="brand-role">{hero.identity.role} · {hero.identity.specialization}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {header.links.map((link) => (
          <li>
            <a class="nav-link" href={resolveHref(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="header-socials" aria-label="Social links">
        <a
          class="header-social-btn"
          href="https://www.linkedin.com/in/daniele-moltisanti/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a
          class="header-social-btn"
          href="https://github.com/daniele21"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>

      <button
        type="button"
        class="header-cta primary-button"
        data-open-contact-modal
        aria-label="Open contact inquiry form"
      >
        <span>{header.cta.label}</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .landing-header {
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-medium);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    position: sticky;
    top: 0;
    z-index: 90;
    transition: border-color var(--duration-fast) ease;
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-display);
    text-decoration: none;
    min-height: var(--touch-target-min);
  }

  .brand-avatar-frame {
    position: relative;
    width: 54px;
    height: 54px;
    flex: 0 0 54px;
    display: grid;
    place-items: center;
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 50%;
    background: linear-gradient(145deg, #ffffff 8%, #e5ebf5 92%);
    box-shadow:
      -3px -3px 8px rgba(255, 255, 255, 0.96),
      4px 5px 12px rgba(8, 19, 51, 0.18),
      inset 1px 1px 1px rgba(255, 255, 255, 0.9),
      inset -1px -1px 2px rgba(8, 19, 51, 0.1);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .brand-avatar-frame::after {
    content: '';
    position: absolute;
    inset: 3px;
    pointer-events: none;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px rgba(8, 19, 51, 0.12),
      inset 2px 2px 3px rgba(255, 255, 255, 0.24),
      inset -2px -2px 4px rgba(8, 19, 51, 0.14);
  }

  .brand-avatar {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 28%;
  }

  .brand:hover .brand-avatar-frame {
    transform: translateY(-1px);
    box-shadow:
      -3px -3px 8px rgba(255, 255, 255, 0.98),
      5px 7px 15px rgba(8, 19, 51, 0.22),
      inset 1px 1px 1px rgba(255, 255, 255, 0.9),
      inset -1px -1px 2px rgba(8, 19, 51, 0.1);
  }

  .brand-copy {
    display: flex;
    align-items: baseline;
    gap: clamp(10px, 1.4vw, 18px);
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 850;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .brand-role {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 620;
    line-height: 1.4;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    padding: 4px 8px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-caption);
    font-weight: 650;
    transition: color var(--duration-fast) ease;
  }

  .nav-link:hover { color: var(--accent-blue); }

  .header-socials {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .header-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-medium);
    background: var(--surface-card);
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--duration-fast) ease, color var(--duration-fast) ease, border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .header-social-btn:hover {
    transform: translateY(-1px);
    color: var(--accent-blue-dark);
    border-color: color-mix(in srgb, var(--accent-blue) 45%, var(--border-medium));
    background: var(--surface-subtle);
  }

  .header-social-btn svg {
    display: block;
    flex-shrink: 0;
  }

  .header-cta {
    padding: 8px 16px;
    font-size: var(--text-caption);
  }

  .ext-icon {
    font-size: 1em;
    line-height: 1;
  }

  @media (max-width: 980px) {
    .brand-role { display: none; }
  }

  @media (max-width: 860px) {
    .nav-list { display: none; }
  }

  @media (max-width: 560px) {
    .brand-avatar-frame {
      width: 50px;
      height: 50px;
      flex-basis: 50px;
    }

    .header-cta {
      padding: 6px 12px;
      font-size: var(--text-caption);
    }
  }

  @media (max-width: 400px) {
    .header-cta { display: none; }
  }
</style>
