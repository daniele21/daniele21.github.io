---
/**
 * LandingHeader.astro
 * Quiet, accessible sticky header with brand mark, section navigation, and CTA.
 */
import { landingData } from '../../content/locales/en/landing';

const { header } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<header class="landing-header" id="site-header">
  <div class="shell header-shell">
    <a class="brand" href={`${baseUrl}/`} aria-label={`${header.brandName} homepage`}>
      <span class="brand-cube" aria-hidden="true"><i></i></span>
      <span class="brand-name">{header.brandName}</span>
    </a>

    <nav class="nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {header.links.map((link) => (
          <li>
            <a class="nav-link" href={resolveHref(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        class="header-cta primary-button"
        href={resolveHref(header.cta.href)}
        target={header.cta.external ? '_blank' : undefined}
        rel={header.cta.external ? 'noopener noreferrer' : undefined}
      >
        {header.cta.label}
        {header.cta.external && <span class="ext-icon" aria-hidden="true">↗</span>}
      </a>
    </nav>
  </div>
</header>

<style>
  .landing-header {
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-medium);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    position: sticky;
    top: 0;
    z-index: 90;
    transition: border-color var(--duration-fast) ease;
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Brand Mark */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-display);
    text-decoration: none;
    min-height: var(--touch-target-min);
  }

  .brand-cube {
    width: 28px;
    height: 28px;
    position: relative;
    display: inline-block;
    clip-path: polygon(50% 0, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
    background: linear-gradient(145deg, var(--accent-blue-light), var(--accent-blue-dark));
    box-shadow: 0 4px 14px rgba(20, 91, 255, 0.28);
    flex-shrink: 0;
  }

  .brand-cube i {
    position: absolute;
    inset: 5px;
    clip-path: inherit;
    background: linear-gradient(145deg, #74a4ff, var(--accent-blue));
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink-display);
  }

  /* Navigation */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    padding: 4px 8px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-caption);
    font-weight: 650;
    transition: color var(--duration-fast) ease;
  }

  .nav-link:hover {
    color: var(--accent-blue);
  }

  .header-cta {
    padding: 8px 16px;
    font-size: var(--text-caption);
  }

  .ext-icon {
    font-size: 0.9em;
    line-height: 1;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .nav-list {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-cta {
      padding: 6px 12px;
      font-size: var(--text-caption);
    }
  }
</style>
