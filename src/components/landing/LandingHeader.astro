---
/**
 * LandingHeader.astro
 * Quiet, accessible sticky header with brand mark, adaptive navigation, and CTA.
 */
import { landingData } from '../../content/locales/en/landing';

const { header } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<header class="landing-header" id="site-header">
  <div class="shell header-shell">
    <a class="brand" href={`${baseUrl}/`} aria-label={`${header.brandName} homepage`}>
      <span class="brand-cube" aria-hidden="true"><i></i></span>
      <span class="brand-name">{header.brandName}</span>
    </a>

    <nav class="nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {header.links.map((link) => (
          <li>
            <a class="nav-link" href={resolveHref(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <details class="mobile-nav">
        <summary>
          <span>Explore</span>
          <span class="mobile-nav-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="mobile-nav-panel">
          <ul>
            {header.links.map((link) => (
              <li>
                <a href={resolveHref(link.href)}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </details>

      <a
        class="header-cta primary-button"
        href={resolveHref(header.cta.href)}
        target={header.cta.external ? '_blank' : undefined}
        rel={header.cta.external ? 'noopener noreferrer' : undefined}
      >
        {header.cta.label}
        {header.cta.external && <span class="ext-icon" aria-hidden="true">↗</span>}
      </a>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });
  });
</script>

<style>
  .landing-header {
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-medium);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    position: sticky;
    top: 0;
    z-index: 90;
    transition: border-color var(--duration-fast) ease;
  }

  .header-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-display);
    text-decoration: none;
    min-height: var(--touch-target-min);
  }

  .brand-cube {
    width: 28px;
    height: 28px;
    position: relative;
    display: inline-block;
    clip-path: polygon(50% 0, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
    background: linear-gradient(145deg, var(--accent-blue-light), var(--accent-blue-dark));
    box-shadow: 0 4px 14px rgba(20, 91, 255, 0.28);
    flex-shrink: 0;
  }

  .brand-cube i {
    position: absolute;
    inset: 5px;
    clip-path: inherit;
    background: linear-gradient(145deg, #74a4ff, var(--accent-blue));
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink-display);
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    padding: 4px 8px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-caption);
    font-weight: 650;
    transition: color var(--duration-fast) ease;
  }

  .nav-link:hover { color: var(--accent-blue); }

  .mobile-nav { display: none; }

  .mobile-nav summary {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .mobile-nav summary::-webkit-details-marker { display: none; }

  .mobile-nav-chevron {
    display: inline-block;
    transition: transform var(--duration-fast) ease;
  }

  .mobile-nav[open] .mobile-nav-chevron { transform: rotate(180deg); }

  .mobile-nav-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(280px, calc(100vw - 32px));
    padding: var(--space-2);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav-panel ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav-panel a {
    min-height: var(--touch-target-min);
    display: flex;
    align-items: center;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 650;
    text-decoration: none;
  }

  .mobile-nav-panel a:hover,
  .mobile-nav-panel a:focus-visible {
    background: var(--surface-blue-subtle);
    color: var(--accent-blue-dark);
  }

  .header-cta {
    padding: 8px 16px;
    font-size: var(--text-caption);
  }

  .ext-icon {
    font-size: 0.9em;
    line-height: 1;
  }

  @media (max-width: 860px) {
    .nav { gap: var(--space-2); }
    .nav-list { display: none; }
    .mobile-nav { display: block; }
  }

  @media (max-width: 560px) {
    .brand-name { display: none; }
  }

  @media (max-width: 420px) {
    .header-cta {
      padding: 6px 10px;
      font-size: var(--text-caption);
    }

    .mobile-nav summary { padding-inline: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-chevron { transition: none; }
  }
</style>
