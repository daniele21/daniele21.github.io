---
/** Plane 01: Strategy / DECIDE - Where should this workload run? */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import DecisionDiagram from './DecisionDiagram.astro';

const { decisionStage } = landingData;
---

<PlaneTemplate
  id="strategy"
  number={1}
  side="left"
  surface="canvas"
  kicker={decisionStage.kicker}
  title={decisionStage.title}
  intro={decisionStage.intro}
  handoff={decisionStage.handoff}
  nextLabel="BUILD"
  visualLabel="Workload decision framework diagram"
>
  <DecisionDiagram />
</PlaneTemplate>
