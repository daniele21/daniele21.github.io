---
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import DecisionTable from './DecisionTable.astro';

const { decisionStage } = landingData;
---

<PlaneTemplate
  id="strategy"
  number={1}
  side="left"
  surface="subtle"
  kicker=""
  title="Start from the problem, not the model."
  intro="Translate product goals, data boundaries, latency, reliability, governance and scale into an architecture. Where AI should run—Local, Hybrid or Cloud—is one explicit decision, not the mission itself."
  handoff={decisionStage.handoff}
  nextLabel="BUILD"
  visualLabel="Local, Hybrid and Cloud workload decision matrix"
>
  <DecisionTable />
</PlaneTemplate>
