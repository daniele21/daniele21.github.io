---
/** Plane 01: Strategy / DECIDE - When does Local AI actually make sense? */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import DecisionTable from './DecisionTable.astro';

const { decisionStage } = landingData;
---

<PlaneTemplate
  id="strategy"
  number={1}
  side="left"
  surface="canvas"
  kicker={decisionStage.kicker}
  title={decisionStage.title}
  intro={decisionStage.intro}
  handoff={decisionStage.handoff}
  nextLabel="BUILD"
  visualLabel="Workload decision trade-off matrix"
>
  <DecisionTable />
</PlaneTemplate>
