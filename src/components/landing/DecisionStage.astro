---
/** Plane 01: decide where the workload should run. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import DecisionTable from './DecisionTable.astro';

const { decisionStage } = landingData;
---

<PlaneTemplate
  id="strategy"
  number={1}
  side="left"
  surface="subtle"
  kicker=""
  title="Where should AI run?"
  intro="Start with the workload, not the model. Privacy, latency, control, capability and scale tell you whether Local, Hybrid or Cloud makes sense."
  handoff={decisionStage.handoff}
  nextLabel="BUILD"
  visualLabel="Local, Hybrid and Cloud workload decision matrix"
>
  <DecisionTable />
</PlaneTemplate>
