---
/** Plane 01: decide where the workload should run. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import DecisionTable from './DecisionTable.astro';

const { decisionStage } = landingData;
---

<PlaneTemplate
  id="strategy"
  number={1}
  side="left"
  surface="subtle"
  kicker=""
  title="Where should AI run?"
  intro="Start with the workload, not the model. Compare what Local, Hybrid and Cloud make possible—and the constraints each one introduces."
  handoff={decisionStage.handoff}
  nextLabel="BUILD"
  visualLabel="Local, Hybrid and Cloud deployment choices and trade-offs"
>
  <DecisionTable />
</PlaneTemplate>
