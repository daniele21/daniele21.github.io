---
/** Plane 04: measure whether the architecture is actually good enough. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import EvidenceMatrix from './EvidenceMatrix.astro';

const { measureStage } = landingData;
---

<PlaneTemplate
  id="evidence"
  number={4}
  side="right"
  surface="subtle"
  kicker=""
  title="Is it actually good enough?"
  intro="Local only makes sense if quality, speed and resource use work for the real workload."
  handoff={measureStage.handoff}
  nextLabel="DECIDE AGAIN"
  visualLabel="Performance, resource, quality and privacy measurement framework"
  isFinal
>
  <EvidenceMatrix />
</PlaneTemplate>
