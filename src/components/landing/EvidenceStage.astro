---
/** Dedicated Measure stage tuned to the approved Performance Lab reference. */
import StageRail from './StageRail.astro';
import EvidenceMatrix from './EvidenceMatrix.astro';
---

<section
  class="stage-section method-stage evidence-stage stage-right"
  id="evidence"
  data-stage="04"
  aria-labelledby="evidence-title"
>
  <div class="shell stage-shell evidence-shell">
    <StageRail number={4} side="right" isFinal />

    <div class="stage-layout evidence-layout">
      <header class="stage-copy evidence-hero">
        <div class="evidence-copy">
          <p class="stage-kicker evidence-kicker">Performance Lab</p>
          <h2 id="evidence-title" class="stage-heading evidence-heading">Can this workload run locally?</h2>
          <p class="stage-intro evidence-intro">
            Performance Lab benchmarks the <strong>real model</strong> on <strong>real devices</strong>
            to turn <strong>evidence</strong> into a <strong>Local, Hybrid or Cloud</strong> decision.
          </p>
        </div>
      </header>

      <div class="stage-visual evidence-visual" aria-label="Performance Lab benchmark evidence matrix">
        <EvidenceMatrix />
      </div>
    </div>
  </div>
</section>

<style>
  .evidence-stage {
    --plane-rail-inset: clamp(48px, 5vw, 68px);
    position: relative;
    overflow: clip;
    padding: clamp(54px, 5.5vw, 76px) 0 clamp(72px, 7vw, 96px);
    background: var(--surface-canvas);
  }

  .evidence-shell {
    position: relative;
  }

  .evidence-layout {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3.5vw, 36px);
    padding-inline: clamp(64px, 7vw, 96px);
  }

  .evidence-hero {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .evidence-copy {
    min-width: 0;
    max-width: 720px;
  }

  .evidence-kicker {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.2;
    font-weight: 820;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    color: var(--accent-blue);
  }

  @media (max-width: 640px) {
    .stage-wip-ribbon-wrap {
      width: 145px;
      height: 145px;
    }

    .stage-wip-ribbon {
      top: 28px;
      right: -38px;
      width: 190px;
      padding: 6px 0;
      font-size: 0.62rem;
      gap: 5px;
      letter-spacing: 0.05em;
    }

    .stage-wip-icon {
      width: 12px;
      height: 12px;
    }
  }

  .evidence-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 2.9vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.048em;
    font-weight: 850;
    color: var(--ink-display);
    text-wrap: pretty;
  }

  .evidence-intro {
    max-width: 680px;
    margin: 14px 0 0;
    font-size: clamp(1rem, 1.1vw, 1.12rem);
    line-height: 1.55;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .evidence-intro strong {
    color: var(--ink-display);
    font-weight: 740;
  }

  .evidence-visual {
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 760px) {
    .evidence-stage {
      padding: 50px 0 68px;
    }

    .evidence-layout {
      padding-left: 48px;
      padding-right: 12px;
    }

    .evidence-heading {
      font-size: clamp(1.85rem, 8vw, 2.5rem);
    }
  }

  @media (max-width: 540px) {
    .evidence-stage {
      padding: 44px 0 60px;
    }

    .evidence-layout {
      padding-left: 42px;
      padding-right: 4px;
    }
  }
</style>
