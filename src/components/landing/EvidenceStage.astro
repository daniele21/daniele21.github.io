---
/** Plane 04: compact evidence surfaces without unqualified or fabricated numeric claims. */
import { landingData } from '../../content/locales/en/landing';
import StageRail from './StageRail.astro';
import StageHandoff from './StageHandoff.astro';

const { measureStage } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<section class="stage-section method-stage stage-right" id="evidence" data-stage="04" aria-labelledby="measure-title">
  <div class="shell stage-shell">
    <StageRail number={4} side="right" isFinal />

    <div class="stage-layout">
      <div class="stage-copy">
        <p class="stage-kicker">{measureStage.kicker}</p>
        <h2 id="measure-title" class="stage-heading">{measureStage.title}</h2>
        <p class="stage-intro">{measureStage.intro}</p>
        <StageHandoff handoff={measureStage.handoff} number={4} nextLabel="DECIDE AGAIN" />
      </div>

      <div class="stage-visual evidence-tools" aria-label="Performance and observability tools">
        <a class="evidence-card performance-card" href={resolveHref('/performance-lab')}>
          <header><span>01</span><h3>Performance Lab</h3></header>
          <div class="measurement-grid" aria-label="Measurement dimensions used to evaluate a real workload">
            <div><small>01</small><span><strong>Quality</strong><em>Task result</em></span></div>
            <div><small>02</small><span><strong>Latency</strong><em>Response time</em></span></div>
            <div><small>03</small><span><strong>Throughput</strong><em>Work over time</em></span></div>
            <div><small>04</small><span><strong>Resources</strong><em>Memory · compute · thermal</em></span></div>
          </div>
          <p class="measurement-note">Measure the complete execution profile on the real workload and hardware.</p>
          <footer>Explore the measurement lab <i aria-hidden="true">↗</i></footer>
        </a>

        <a class="evidence-card boundary-card" href={resolveHref('/traffic-monitoring')}>
          <header><span>02</span><h3>Traffic Monitoring</h3></header>
          <div class="boundary-media">
            <img src={asset('images/traffic-monitoring/overview.png')} alt="Traffic Monitoring overview" loading="lazy" decoding="async" />
          </div>
          <div class="boundary-status"><i aria-hidden="true"></i><strong>Observe the declared boundary</strong></div>
          <footer>Inspect network behavior <i aria-hidden="true">↗</i></footer>
        </a>

        <a class="evidence-card feedback-card" href={resolveHref('/local-ai-performance')}>
          <header><span>03</span><h3>Decision feedback</h3></header>
          <div class="feedback-loop" aria-label="Evidence returns to the next execution decision">
            {['Workload', 'Evidence', 'Next boundary'].map((label, index) => (
              <div><small>0{index + 1}</small><strong>{label}</strong>{index < 2 && <i aria-hidden="true">↓</i>}</div>
            ))}
          </div>
          <p>Evidence can confirm—or change—the architecture choice.</p>
          <footer>See the measurement method <i aria-hidden="true">↗</i></footer>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .stage-section {
    padding: clamp(48px, 6vw, 72px) 0;
    overflow: clip;
    background: var(--surface-subtle);
  }

  .evidence-tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 18px);
  }

  .evidence-card {
    min-width: 0;
    min-height: 350px;
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 2.2vw, 24px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-lg);
    color: inherit;
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out-expo), border-color var(--duration-fast) ease, box-shadow var(--duration-base) ease;
  }

  .evidence-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: 0 22px 48px rgba(8, 19, 51, 0.09);
  }

  .evidence-card > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .evidence-card > header span {
    color: var(--accent-blue);
    font-size: var(--text-badge);
    font-weight: 800;
  }

  .evidence-card h3 {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    text-align: right;
  }

  .evidence-card > footer {
    min-height: var(--touch-target-min);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 750;
  }

  .evidence-card footer i { font-style: normal; transition: transform var(--duration-fast) ease; }
  .evidence-card:hover footer i { transform: translate(2px, -2px); }

  .measurement-grid {
    display: grid;
    gap: 7px;
    margin: var(--space-4) 0 var(--space-3);
  }

  .measurement-grid > div {
    min-height: 48px;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-2);
    align-items: center;
    padding: 7px 9px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--surface-blue-subtle), var(--surface-card));
  }

  .measurement-grid small {
    color: var(--accent-blue);
    font-size: var(--text-badge);
    font-weight: 800;
  }

  .measurement-grid span { display: grid; gap: 1px; }
  .measurement-grid strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-badge);
  }

  .measurement-grid em {
    color: var(--ink-muted);
    font-size: var(--text-badge);
    font-style: normal;
    line-height: 1.35;
  }

  .measurement-note {
    margin: 0 0 var(--space-3);
    color: var(--ink-muted);
    font-size: var(--text-badge);
    line-height: 1.5;
  }

  .boundary-media {
    height: 145px;
    margin: var(--space-4) 0 var(--space-3);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
  }

  .boundary-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: top;
  }

  .boundary-status {
    display: grid;
    grid-template-columns: 10px 1fr;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-3);
    color: var(--ink-display);
    font-size: var(--text-badge);
  }

  .boundary-status > i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-good-text);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-good-text) 10%, transparent);
  }

  .feedback-loop { display: grid; gap: 0; padding: var(--space-4) 0; }
  .feedback-loop > div {
    position: relative;
    min-height: 48px;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-2);
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
  }

  .feedback-loop small { color: var(--accent-blue); font-weight: 800; }
  .feedback-loop strong { color: var(--ink-display); font-family: var(--font-display); font-size: var(--text-badge); }
  .feedback-loop i { position: absolute; right: 0; bottom: -11px; z-index: 2; color: var(--accent-blue); font-style: normal; }
  .feedback-card > p { margin: 0 0 var(--space-3); color: var(--ink-muted); font-size: var(--text-badge); line-height: 1.5; }

  @media (max-width: 1040px) {
    .evidence-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .evidence-card:last-child { grid-column: 1 / -1; min-height: 250px; }
  }

  @media (max-width: 680px) {
    .evidence-tools {
      width: calc(100% + 20px);
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(252px, 84%);
      gap: var(--space-3);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
      padding: 4px 20px 12px 0;
    }

    .evidence-tools::-webkit-scrollbar { display: none; }
    .evidence-card,
    .evidence-card:last-child { min-height: 350px; grid-column: auto; scroll-snap-align: start; }
  }
</style>
