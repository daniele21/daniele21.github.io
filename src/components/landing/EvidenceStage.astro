---
/** Plane 04: Observability & Measurement / MEASURE - Is it actually good enough? */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import EvidenceMatrix from './EvidenceMatrix.astro';

const { measureStage } = landingData;
---

<PlaneTemplate
  id="evidence"
  number={4}
  side="right"
  surface="subtle"
  kicker={measureStage.kicker}
  title={measureStage.title}
  intro={measureStage.intro}
  handoff={measureStage.handoff}
  nextLabel="DECIDE AGAIN"
  visualLabel="Performance and observability evidence matrix"
  isFinal
>
  <EvidenceMatrix />
</PlaneTemplate>
