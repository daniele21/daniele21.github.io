---
/** Plane 04: reproducible experiments / MEASURE. */
import { landingData } from '../../content/locales/en/landing';
import StageRail from './StageRail.astro';
import ExperimentResultsExplorer from './ExperimentResultsExplorer.astro';

const { measureStage } = landingData;
const experiments = measureStage.systems[0];
---

<section
  class="stage-section method-stage evidence-stage stage-right"
  id="evidence"
  data-stage="04"
  aria-labelledby="evidence-title"
>
  <div class="shell stage-shell evidence-shell">
    <StageRail number={4} side="right" isFinal />

    <div class="stage-layout evidence-layout">
      <header class="stage-copy evidence-hero">
        <p class="stage-kicker evidence-kicker">{measureStage.kicker}</p>
        <h2 id="evidence-title" class="stage-heading evidence-heading">{measureStage.title}</h2>
        <p class="stage-intro evidence-intro">{measureStage.intro}</p>
      </header>

      <div class="experiments-surface">
        <div class="experiments-toolbar">
          <div class="experiments-toolbar__context">
            <span class="experiments-toolbar__eyebrow">{experiments.title}</span>
            <span class="experiments-toolbar__divider" aria-hidden="true"></span>
            <span class="experiments-toolbar__meta">{experiments.tag}</span>
          </div>

          <a href={experiments.href} target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>

        <ExperimentResultsExplorer tracks={experiments.tracks || []} />
      </div>
    </div>
  </div>
</section>

<style>
  .evidence-stage {
    --plane-rail-inset: clamp(48px, 5vw, 68px);
    position: relative;
    overflow: clip;
    padding: clamp(54px, 5.5vw, 76px) 0 clamp(72px, 7vw, 96px);
    background:
      radial-gradient(
        ellipse 62% 38% at 74% 30%,
        color-mix(in srgb, var(--accent-blue) 4%, transparent),
        transparent 74%
      ),
      var(--journey-surface-tint, var(--surface-subtle));
  }

  .evidence-shell {
    position: relative;
  }

  .evidence-layout {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3.4vw, 40px);
    padding-inline: clamp(64px, 7vw, 96px);
  }

  .evidence-hero {
    width: min(100%, 760px);
    align-self: flex-end;
  }

  .evidence-kicker {
    margin: 0 0 10px;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .evidence-heading {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2rem, 2.9vw, 3rem);
    font-weight: 850;
    letter-spacing: -0.048em;
    line-height: 1.05;
  }

  .evidence-intro {
    max-width: 700px;
    margin: 12px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.1vw, 1.08rem);
    line-height: 1.55;
  }

  .experiments-surface {
    width: 100%;
    min-width: 0;
  }

  .experiments-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }

  .experiments-toolbar__context {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .experiments-toolbar__eyebrow {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 780;
  }

  .experiments-toolbar__divider {
    width: 18px;
    height: 1px;
    background: var(--border-medium);
  }

  .experiments-toolbar__meta {
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    line-height: 1.3;
  }

  .experiments-toolbar a {
    flex: 0 0 auto;
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 740;
    text-decoration: none;
  }

  .experiments-toolbar a:hover,
  .experiments-toolbar a:focus-visible {
    color: var(--accent-blue);
  }

  @media (max-width: 760px) {
    .evidence-layout {
      padding-left: 48px;
      padding-right: 12px;
    }

    .evidence-hero {
      align-self: flex-start;
    }
  }

  @media (max-width: 540px) {
    .evidence-layout {
      padding-left: 42px;
      padding-right: 4px;
    }

    .experiments-toolbar {
      align-items: flex-start;
    }

    .experiments-toolbar__meta,
    .experiments-toolbar__divider {
      display: none;
    }

    .experiments-toolbar a {
      min-height: auto;
    }
  }
</style>
