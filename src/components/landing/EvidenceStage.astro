---
/** Plane 04: reproducible experiments / MEASURE. */
import { landingData } from '../../content/locales/en/landing';
import StageRail from './StageRail.astro';
import ExperimentResultsExplorer from './ExperimentResultsExplorer.astro';

const { measureStage } = landingData;
const experiments = measureStage.systems[0];
---

<section
  class="stage-section method-stage evidence-stage stage-right"
  id="evidence"
  data-stage="04"
  aria-labelledby="evidence-title"
>
  <div class="shell stage-shell evidence-shell">
    <StageRail number={4} side="right" isFinal />

    <div class="stage-layout evidence-layout">
      <header class="stage-copy evidence-hero">
        <p class="stage-kicker evidence-kicker">{experiments.title}</p>
        <h2 id="evidence-title" class="stage-heading evidence-heading">{measureStage.title}</h2>
        <p class="stage-intro evidence-intro">{measureStage.intro}</p>
      </header>

      <div class="experiments-card">
        <div class="experiments-card__header">
          <div>
            <span class="experiments-card__tag">{experiments.tag}</span>
            <h3>{experiments.question}</h3>
          </div>
          <a href={experiments.href} target="_blank" rel="noopener noreferrer">
            Open repository <span aria-hidden="true">↗</span>
          </a>
        </div>

        <ExperimentResultsExplorer tracks={experiments.tracks || []} />
      </div>

      <p class="evidence-closing">{measureStage.closingMessage}</p>
    </div>
  </div>
</section>

<style>
  .evidence-stage {
    --plane-rail-inset: clamp(48px, 5vw, 68px);
    position: relative;
    overflow: clip;
    padding: clamp(54px, 5.5vw, 76px) 0 clamp(72px, 7vw, 96px);
    background:
      radial-gradient(
        ellipse 66% 42% at 72% 34%,
        color-mix(in srgb, var(--accent-blue) 4%, transparent),
        transparent 76%
      ),
      var(--journey-surface-tint, var(--surface-subtle));
  }

  .evidence-shell { position: relative; }

  .evidence-layout {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(26px, 3.5vw, 40px);
    padding-inline: clamp(64px, 7vw, 96px);
  }

  .evidence-hero {
    width: min(100%, 820px);
    align-self: flex-end;
  }

  .evidence-kicker {
    margin: 0 0 10px;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .evidence-heading {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(2rem, 2.9vw, 3rem);
    font-weight: 850;
    letter-spacing: -0.048em;
    line-height: 1.05;
  }

  .evidence-intro {
    max-width: 760px;
    margin: 14px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.1vw, 1.12rem);
    line-height: 1.58;
  }

  .experiments-card {
    width: 100%;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-xs);
  }

  .experiments-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .experiments-card__tag {
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 820;
    letter-spacing: 0.075em;
  }

  .experiments-card h3 {
    max-width: 760px;
    margin: 8px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.28;
    letter-spacing: -0.025em;
  }

  .experiments-card__header a {
    flex: 0 0 auto;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 760;
    text-decoration: none;
  }

  .evidence-closing {
    max-width: 760px;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .evidence-layout {
      padding-left: 48px;
      padding-right: 12px;
    }

    .evidence-hero { align-self: flex-start; }
    .experiments-card__header { flex-direction: column; }
  }

  @media (max-width: 540px) {
    .evidence-layout {
      padding-left: 42px;
      padding-right: 4px;
    }
  }
</style>
