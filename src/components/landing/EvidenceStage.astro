---
/** Plane 04: measure whether the architecture is actually good enough. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import EvidenceMatrix from './EvidenceMatrix.astro';

const { measureStage } = landingData;
---

<PlaneTemplate
  id="evidence"
  number={4}
  side="right"
  surface="subtle"
  kicker="PERFORMANCE LAB"
  title="Can this workload run locally?"
  intro="Performance Lab benchmarks the real model on real devices to turn evidence into a Local, Hybrid or Cloud decision."
  handoff={measureStage.handoff}
  nextLabel="DECIDE AGAIN"
  visualLabel="Real-device Performance Lab evidence and Local, Hybrid or Cloud decision framework"
  isFinal
>
  <EvidenceMatrix />
</PlaneTemplate>
