---
/** Dedicated Measure stage. This intentionally does not use PlaneTemplate:
 * the Performance Lab target needs a two-column hero followed by one evidence surface. */
import StageRail from './StageRail.astro';
import EvidenceMatrix from './EvidenceMatrix.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;
---

<section
  class="stage-section method-stage evidence-stage stage-right"
  id="evidence"
  data-stage="04"
  aria-labelledby="evidence-title"
>
  <div class="shell evidence-shell">
    <StageRail number={4} side="right" isFinal />

    <div class="evidence-layout">
      <header class="evidence-hero">
        <div class="evidence-copy">
          <p class="evidence-kicker">Performance Lab</p>
          <h2 id="evidence-title">Can this workload run locally?</h2>
          <p>
            Performance Lab benchmarks the <strong>real model</strong> on <strong>real devices</strong>
            to turn <strong>evidence</strong> into a <strong>Local, Hybrid or Cloud</strong> decision.
          </p>
        </div>

        <div class="evidence-method">
          <a href={resolveHref('performance-lab')} class="lab-link">
            Open the lab <span aria-hidden="true">→</span>
          </a>

          <div class="method-flow" aria-label="Performance Lab method">
            <div class="flow-item">
              <span class="flow-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 3h8l4 4v14H6z" />
                  <path d="M14 3v5h5" />
                </svg>
              </span>
              <strong>Workload</strong>
            </div>
            <span class="flow-operator" aria-hidden="true">×</span>
            <div class="flow-item">
              <span class="flow-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 2 8 4.5v9L12 20l-8-4.5v-9z" />
                  <path d="m4 6.5 8 4.5 8-4.5M12 11v9" />
                </svg>
              </span>
              <strong>Model</strong>
            </div>
            <span class="flow-operator" aria-hidden="true">×</span>
            <div class="flow-item">
              <span class="flow-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="4" width="16" height="11" rx="1.5" />
                  <path d="M2 19h20M8 19l1-2h6l1 2" />
                </svg>
              </span>
              <strong>Device</strong>
            </div>
            <span class="flow-arrow" aria-hidden="true">→</span>
            <div class="flow-item">
              <span class="flow-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <path d="M5 19V10M12 19V5M19 19v-7" />
                </svg>
              </span>
              <strong>Evidence</strong>
            </div>
            <span class="flow-arrow" aria-hidden="true">→</span>
            <div class="flow-item">
              <span class="flow-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8" />
                  <circle cx="12" cy="12" r="3.5" />
                  <path d="M12 2v3M22 12h-3" />
                </svg>
              </span>
              <strong>Decision</strong>
            </div>
          </div>
        </div>
      </header>

      <EvidenceMatrix />
    </div>
  </div>
</section>

<style>
  .evidence-stage {
    --plane-rail-inset: clamp(48px, 5vw, 68px);
    position: relative;
    overflow: clip;
    padding: clamp(58px, 6vw, 82px) 0 clamp(76px, 8vw, 108px);
    background: var(--surface-subtle);
  }

  .evidence-shell {
    position: relative;
  }

  .evidence-layout {
    min-width: 0;
    padding-inline: clamp(64px, 7vw, 96px);
  }

  .evidence-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(540px, 1.1fr);
    align-items: start;
    gap: clamp(42px, 5vw, 76px);
    margin-bottom: clamp(28px, 3.5vw, 42px);
  }

  .evidence-copy {
    max-width: 650px;
  }

  .evidence-kicker {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.25;
    font-weight: 820;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-blue);
  }

  .evidence-copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.55vw, 3.5rem);
    line-height: 1.03;
    letter-spacing: -0.055em;
    font-weight: 850;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .evidence-copy > p:last-child {
    max-width: 640px;
    margin: 16px 0 0;
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .evidence-copy strong {
    color: var(--ink-display);
    font-weight: 740;
  }

  .evidence-method {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .lab-link {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 6px;
    color: var(--accent-blue-dark);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 780;
    border-radius: var(--radius-sm);
  }

  .lab-link:hover,
  .lab-link:focus-visible {
    color: var(--accent-blue);
  }

  .method-flow {
    width: 100%;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(7px, 1vw, 13px);
    margin-top: clamp(34px, 4vw, 48px);
    padding: 14px clamp(16px, 2vw, 24px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: 0 2px 8px rgba(8, 19, 51, 0.025);
  }

  .flow-item {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .flow-item strong {
    font-family: var(--font-display);
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 760;
  }

  .flow-icon {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--ink-display);
  }

  .flow-icon svg {
    width: 21px;
    height: 21px;
  }

  .flow-operator,
  .flow-arrow {
    flex: 0 0 auto;
    color: var(--ink-subtle);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 720;
  }

  @media (max-width: 1080px) {
    .evidence-layout {
      padding-left: clamp(54px, 6vw, 72px);
      padding-right: clamp(28px, 4vw, 44px);
    }

    .evidence-hero {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .evidence-method {
      align-items: stretch;
    }

    .lab-link {
      align-self: flex-start;
      order: 2;
      margin-top: 12px;
    }

    .method-flow {
      order: 1;
      margin-top: 4px;
    }
  }

  @media (max-width: 760px) {
    .evidence-stage {
      padding: 56px 0 72px;
    }

    .evidence-layout {
      padding-left: 48px;
      padding-right: 4px;
    }

    .evidence-copy h2 {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .method-flow {
      justify-content: flex-start;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
