---
/**
 * DecisionTable.astro
 * Comparison matrix: Local AI vs Hybrid vs Cloud.
 *
 * Renders two responsive views:
 *   • Desktop (>760px)  → Classic 4-column side-by-side matrix
 *   • Mobile  (≤760px)  → Comparative Factor Cards with Local-First lens
 *                         and transparent trade-off architecture.
 */

/* ── Data types ── */
interface ComparisonItem {
  text: string;
  strength?: boolean;
}

interface CriterionRow {
  dimension: string;
  detail: string;
  local: ComparisonItem;
  hybrid: ComparisonItem;
  cloud: ComparisonItem;
}

/* ── Comparison data ── */
const criteria: CriterionRow[] = [
  {
    dimension: 'Privacy',
    detail: 'Where data is processed',
    local: { text: 'Stays on device', strength: true },
    hybrid: { text: 'Split by policy' },
    cloud: { text: 'Processed remotely' },
  },
  {
    dimension: 'Network & latency',
    detail: 'Connectivity dependency',
    local: { text: 'Works without network', strength: true },
    hybrid: { text: 'Local fallback' },
    cloud: { text: 'Network required' },
  },
  {
    dimension: 'Runtime control',
    detail: 'Deployment & model lifecycle',
    local: { text: 'You control the runtime', strength: true },
    hybrid: { text: 'Shared control' },
    cloud: { text: 'Provider managed' },
  },
  {
    dimension: 'Model capability',
    detail: 'Largest model available',
    local: { text: 'Bound by device' },
    hybrid: { text: 'Routes by workload', strength: true },
    cloud: { text: 'Frontier models', strength: true },
  },
  {
    dimension: 'Elastic scale',
    detail: 'Burst capacity',
    local: { text: 'Fixed by hardware' },
    hybrid: { text: 'Cloud overflow', strength: true },
    cloud: { text: 'Elastic', strength: true },
  },
];

/** Core strengths where Local AI excels */
const coreCriteria = criteria.slice(0, 3);

/** Architectural trade-offs where Hybrid / Cloud provide capacity */
const tradeoffCriteria = criteria.slice(3);

/** Best-fit heuristics for each deployment model */
const bestFit = {
  local: 'Privacy, latency & control',
  hybrid: 'Variable workloads',
  cloud: 'Maximum capability',
};
---

<div class="decision-surface">

  {/* ════════════════════════════════════════════════════
      DESKTOP: Classic 4-column table (hidden on mobile)
      ════════════════════════════════════════════════════ */}
  <div class="matrix-card matrix-card--desktop">
    <table class="matrix-table" aria-label="Local, Hybrid and Cloud workload decision matrix">
      <colgroup>
        <col class="col-criteria" />
        <col class="col-local" />
        <col class="col-secondary" />
        <col class="col-secondary" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col" class="criterion-heading">Decision factor</th>
          <th scope="col" class="local-column local-column--header">
            <span class="local-heading">
              <span class="local-dot" aria-hidden="true"></span>
              <span>Local AI</span>
              <span class="focus-label">Local-first lens</span>
            </span>
          </th>
          <th scope="col" class="platform-heading platform-heading--hybrid">
            <span class="platform-heading-label">
              <span class="platform-dot" aria-hidden="true"></span>
              <span>Hybrid</span>
            </span>
          </th>
          <th scope="col" class="platform-heading platform-heading--cloud">
            <span class="platform-heading-label">
              <span class="platform-dot" aria-hidden="true"></span>
              <span>Cloud</span>
            </span>
          </th>
        </tr>
      </thead>

      <tbody>
        {criteria.map((row, index) => (
          <>
          {index === 3 && (
            <tr class="group-divider-row">
              <th colspan="4" class="group-divider-cell">
                <span>Trade-offs</span>
                <small>Where Local AI trades capacity for control</small>
              </th>
            </tr>
          )}

          <tr>
            <th scope="row" class="criterion-cell">
              <strong>{row.dimension}</strong>
              <span>{row.detail}</span>
            </th>

            <td class="comparison-cell local-column" data-label="Local AI">
              <span class:list={['comparison-value', row.local.strength && 'comparison-value--strength']}>
                {row.local.strength && (
                  <><span class="sr-only">Strength: </span><span class="status-check" aria-hidden="true">✓</span></>
                )}
                <span>{row.local.text}</span>
              </span>
            </td>

            <td class="comparison-cell secondary-column hybrid-column" data-label="Hybrid">
              <span class:list={['comparison-value', row.hybrid.strength && 'comparison-value--secondary-strength']}>
                {row.hybrid.strength && (
                  <><span class="sr-only">Strength: </span><span class="status-check" aria-hidden="true">✓</span></>
                )}
                <span>{row.hybrid.text}</span>
              </span>
            </td>

            <td class="comparison-cell secondary-column cloud-column" data-label="Cloud">
              <span class:list={['comparison-value', row.cloud.strength && 'comparison-value--secondary-strength']}>
                {row.cloud.strength && (
                  <><span class="sr-only">Strength: </span><span class="status-check" aria-hidden="true">✓</span></>
                )}
                <span>{row.cloud.text}</span>
              </span>
            </td>
          </tr>
          </>
        ))}

        <tr class="best-for-row">
          <th scope="row" class="best-for-heading">Best fit</th>
          <td class="local-column" data-label="Local AI">
            <strong>Privacy, latency & control</strong>
          </td>
          <td class="hybrid-column" data-label="Hybrid">
            Variable workloads
          </td>
          <td class="cloud-column" data-label="Cloud">
            Maximum capability
          </td>
        </tr>
      </tbody>
    </table>
  </div>


  {/* ════════════════════════════════════════════════════
      MOBILE: Comparative Factor Cards (hidden on desktop)
      ════════════════════════════════════════════════════ */}
  <div class="mobile-matrix" aria-label="Deployment model decision cards">

    {/* ── Section 1: Core Strengths ── */}
    <div class="mobile-section">
      <div class="section-badge-bar">
        <span class="section-tag section-tag--primary">
          <span class="section-dot" aria-hidden="true"></span>
          <span>Core Strengths</span>
        </span>
        <span class="section-subtext">Where Local-first deployment excels</span>
      </div>

      <div class="factor-cards-list">
        {coreCriteria.map((row) => (
          <article class="factor-card factor-card--strength">
            <header class="factor-header">
              <span class="factor-dimension">{row.dimension}</span>
              <span class="factor-detail">{row.detail}</span>
            </header>

            <div class="factor-body">
              {/* Local AI Hero Box */}
              <div class="model-box model-box--local model-box--hero">
                <div class="model-meta">
                  <span class="model-pill model-pill--local">
                    <span class="model-dot dot--blue" aria-hidden="true"></span>
                    <span>Local AI</span>
                  </span>
                  <span class="hero-badge">
                    <span class="badge-icon" aria-hidden="true">✓</span>
                    <span>Focus strength</span>
                  </span>
                </div>
                <div class="model-value model-value--hero">
                  <strong>{row.local.text}</strong>
                </div>
              </div>

              {/* Alternatives comparison: Hybrid & Cloud */}
              <div class="alternatives-grid">
                <div class="model-box model-box--secondary model-box--hybrid">
                  <div class="model-meta">
                    <span class="model-pill model-pill--hybrid">
                      <span class="model-dot dot--violet" aria-hidden="true"></span>
                      <span>Hybrid</span>
                    </span>
                  </div>
                  <div class="model-value">
                    <span>{row.hybrid.text}</span>
                  </div>
                </div>

                <div class="model-box model-box--secondary model-box--cloud">
                  <div class="model-meta">
                    <span class="model-pill model-pill--cloud">
                      <span class="model-dot dot--teal" aria-hidden="true"></span>
                      <span>Cloud</span>
                    </span>
                  </div>
                  <div class="model-value">
                    <span>{row.cloud.text}</span>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>


    {/* ── Section 2: Architectural Trade-offs ── */}
    <div class="mobile-section mobile-section--tradeoffs">
      <div class="section-badge-bar section-badge-bar--tradeoffs">
        <span class="section-tag section-tag--tradeoff">
          <span class="section-dot dot--amber" aria-hidden="true"></span>
          <span>Trade-offs</span>
        </span>
        <span class="section-subtext">Where Local AI trades capacity for control</span>
      </div>

      <div class="factor-cards-list">
        {tradeoffCriteria.map((row) => (
          <article class="factor-card factor-card--tradeoff">
            <header class="factor-header">
              <span class="factor-dimension">{row.dimension}</span>
              <span class="factor-detail">{row.detail}</span>
            </header>

            <div class="factor-body">
              {/* Local AI constraint */}
              <div class="model-box model-box--local model-box--bound">
                <div class="model-meta">
                  <span class="model-pill model-pill--local">
                    <span class="model-dot dot--blue" aria-hidden="true"></span>
                    <span>Local AI</span>
                  </span>
                  <span class="bound-tag">Device bound</span>
                </div>
                <div class="model-value model-value--neutral">
                  <span>{row.local.text}</span>
                </div>
              </div>

              {/* Hybrid & Cloud advantages for this trade-off */}
              <div class="alternatives-grid">
                <div class:list={['model-box', 'model-box--secondary', 'model-box--hybrid', row.hybrid.strength && 'model-box--advantage']}>
                  <div class="model-meta">
                    <span class="model-pill model-pill--hybrid">
                      <span class="model-dot dot--violet" aria-hidden="true"></span>
                      <span>Hybrid</span>
                    </span>
                    {row.hybrid.strength && (
                      <span class="advantage-badge advantage-badge--violet" aria-label="Advantage">✓</span>
                    )}
                  </div>
                  <div class="model-value">
                    <strong>{row.hybrid.text}</strong>
                  </div>
                </div>

                <div class:list={['model-box', 'model-box--secondary', 'model-box--cloud', row.cloud.strength && 'model-box--advantage']}>
                  <div class="model-meta">
                    <span class="model-pill model-pill--cloud">
                      <span class="model-dot dot--teal" aria-hidden="true"></span>
                      <span>Cloud</span>
                    </span>
                    {row.cloud.strength && (
                      <span class="advantage-badge advantage-badge--teal" aria-label="Advantage">✓</span>
                    )}
                  </div>
                  <div class="model-value">
                    <strong>{row.cloud.text}</strong>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>


    {/* ── Best Fit Decision Heuristic Summary ── */}
    <div class="mobile-best-fit">
      <div class="best-fit-header">
        <span class="best-fit-tag">Decision Heuristic</span>
        <h4 class="best-fit-title">Best fit by workload</h4>
      </div>

      <div class="best-fit-grid">
        <div class="best-fit-card best-fit-card--local">
          <div class="best-fit-platform">
            <span class="model-dot dot--blue" aria-hidden="true"></span>
            <strong>Local AI</strong>
          </div>
          <p class="best-fit-text">{bestFit.local}</p>
        </div>

        <div class="best-fit-card best-fit-card--hybrid">
          <div class="best-fit-platform">
            <span class="model-dot dot--violet" aria-hidden="true"></span>
            <strong>Hybrid</strong>
          </div>
          <p class="best-fit-text">{bestFit.hybrid}</p>
        </div>

        <div class="best-fit-card best-fit-card--cloud">
          <div class="best-fit-platform">
            <span class="model-dot dot--teal" aria-hidden="true"></span>
            <strong>Cloud</strong>
          </div>
          <p class="best-fit-text">{bestFit.cloud}</p>
        </div>
      </div>
    </div>

  </div>


  {/* ── CTA hook (shared desktop & mobile) ── */}
  <div class="decision-hook">
    <div>
      <h3>Analyzing an AI workload?</h3>
      <p>I share architecture analyses and trade-off breakdowns regularly.</p>
    </div>
    <a
      href="https://www.linkedin.com/in/daniele-moltisanti/"
      target="_blank"
      rel="noopener noreferrer"
      class="primary-button decision-cta"
    >
      <span>Follow on LinkedIn</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

</div>


<style>
  /* ================================================================
     SHARED FOUNDATION
     ================================================================ */
  .decision-surface {
    --hybrid-ink: color-mix(in srgb, var(--accent-violet) 76%, var(--ink-display));
    --cloud-ink: color-mix(in srgb, var(--accent-teal) 72%, var(--ink-display));
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Dot indicators */
  .model-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .dot--blue {
    background: var(--accent-blue);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-blue) 16%, transparent);
  }

  .dot--violet {
    background: var(--accent-violet);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-violet) 16%, transparent);
  }

  .dot--teal {
    background: var(--accent-teal);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-teal) 16%, transparent);
  }

  .dot--amber {
    background: var(--accent-amber);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-amber) 16%, transparent);
  }


  /* ================================================================
     DESKTOP TABLE (>760px)
     ================================================================ */
  .matrix-card {
    width: 100%;
    overflow: hidden;
    background: var(--surface-card);
    border: 1px solid color-mix(in srgb, var(--ink-display) 11%, transparent);
    border-radius: 16px;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--ink-display) 3%, transparent);
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }

  .col-criteria { width: 28%; }
  .col-local { width: 26%; }
  .col-secondary { width: 23%; }

  .matrix-table th,
  .matrix-table td {
    padding: 13px clamp(14px, 1.65vw, 20px);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .matrix-table thead th {
    height: 54px;
    padding-top: 11px;
    padding-bottom: 11px;
    background: color-mix(in srgb, var(--surface-subtle) 42%, var(--surface-card));
    border-bottom-color: var(--border-medium);
  }

  .criterion-heading,
  .best-for-heading {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 720;
    letter-spacing: 0.075em;
    color: var(--ink-subtle);
    text-transform: uppercase;
  }

  .platform-heading {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .platform-heading-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .platform-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .matrix-table thead .platform-heading--hybrid {
    color: var(--hybrid-ink);
  }

  .platform-heading--hybrid .platform-dot {
    background: var(--accent-violet);
  }

  .matrix-table thead .platform-heading--cloud {
    color: var(--cloud-ink);
  }

  .platform-heading--cloud .platform-dot {
    background: var(--accent-teal);
  }

  .local-column {
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-card));
    border-left: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-subtle));
    border-right: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-subtle));
  }

  .matrix-table thead .local-column--header {
    background: color-mix(in srgb, var(--accent-blue) 6%, var(--surface-card));
    box-shadow: inset 0 2px 0 var(--accent-blue);
  }

  .local-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 760;
    letter-spacing: -0.015em;
    color: var(--accent-blue-dark);
  }

  .local-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 10%, transparent);
  }

  .focus-label {
    margin-left: 2px;
    padding-left: 9px;
    border-left: 1px solid color-mix(in srgb, var(--accent-blue) 23%, transparent);
    font-size: 0.875rem;
    line-height: 1.15;
    font-weight: 620;
    color: var(--ink-subtle);
  }

  .criterion-cell strong {
    display: block;
    margin-bottom: 1px;
    font-family: var(--font-display);
    font-size: 0.91rem;
    line-height: 1.25;
    font-weight: 720;
    letter-spacing: -0.015em;
    color: var(--ink-display);
  }

  .criterion-cell > span {
    display: block;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--ink-subtle);
    font-weight: 450;
  }

  .group-divider-cell {
    padding-top: 8px !important;
    padding-bottom: 8px !important;
    background: color-mix(in srgb, var(--surface-subtle) 48%, var(--surface-card));
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium) !important;
  }

  .group-divider-cell span,
  .group-divider-cell small {
    display: inline;
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .group-divider-cell span {
    font-weight: 720;
    letter-spacing: 0.075em;
    color: var(--ink-subtle);
    text-transform: uppercase;
  }

  .group-divider-cell small {
    margin-left: 8px;
    font-weight: 480;
    color: var(--ink-subtle);
  }

  .comparison-value {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    line-height: 1.35;
    font-weight: 540;
    color: var(--ink-muted);
  }

  .comparison-value--strength {
    font-family: var(--font-display);
    font-weight: 680;
    color: var(--accent-blue-dark);
  }

  .comparison-value--secondary-strength {
    padding: 4px 7px;
    border-radius: 7px;
    font-family: var(--font-display);
    font-weight: 680;
  }

  .hybrid-column .comparison-value--secondary-strength,
  .hybrid-column .comparison-value--secondary-strength .status-check {
    color: var(--hybrid-ink);
  }

  .hybrid-column .comparison-value--secondary-strength {
    background: color-mix(in srgb, var(--accent-violet) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-violet) 14%, transparent);
  }

  .cloud-column .comparison-value--secondary-strength,
  .cloud-column .comparison-value--secondary-strength .status-check {
    color: var(--cloud-ink);
  }

  .cloud-column .comparison-value--secondary-strength {
    background: color-mix(in srgb, var(--accent-teal) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-teal) 14%, transparent);
  }

  .status-check {
    flex: 0 0 auto;
    color: var(--accent-blue);
    font-size: 0.875rem;
    font-weight: 760;
  }

  .best-for-row th,
  .best-for-row td {
    padding-top: 12px;
    padding-bottom: 13px;
    border-top: 1px solid var(--border-medium);
    border-bottom: 0;
  }

  .best-for-row td {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .best-for-row .local-column {
    color: var(--accent-blue-dark);
  }

  .best-for-row .hybrid-column {
    color: var(--hybrid-ink);
  }

  .best-for-row .cloud-column {
    color: var(--cloud-ink);
  }

  .best-for-row strong {
    font-family: var(--font-display);
    font-weight: 760;
  }


  /* ================================================================
     MOBILE COMPARATIVE CARDS (≤760px)
     ================================================================ */
  .mobile-matrix {
    display: none;
  }

  @media (max-width: 760px) {
    .matrix-card--desktop {
      display: none;
    }

    .mobile-matrix {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
    }
  }

  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  /* ── Section Header Bar ── */
  .section-badge-bar {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-inline: 2px;
  }

  .section-tag {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-tag--primary {
    background: color-mix(in srgb, var(--accent-blue) 10%, var(--surface-card));
    color: var(--accent-blue-dark);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 22%, transparent);
  }

  .section-tag--tradeoff {
    background: color-mix(in srgb, var(--accent-amber) 10%, var(--surface-card));
    color: var(--accent-amber);
    border: 1px solid color-mix(in srgb, var(--accent-amber) 22%, transparent);
  }

  .section-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-blue);
  }

  .section-subtext {
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--ink-subtle);
    font-weight: 500;
  }

  /* ── Factor Cards List ── */
  .factor-cards-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .factor-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 2px 6px color-mix(in srgb, var(--ink-display) 3%, transparent);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .factor-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .factor-dimension {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.015em;
    color: var(--ink-display);
  }

  .factor-detail {
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--ink-subtle);
    font-weight: 480;
  }

  /* ── Factor Body & Model Boxes ── */
  .factor-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .model-box {
    display: flex;
    flex-direction: column;
