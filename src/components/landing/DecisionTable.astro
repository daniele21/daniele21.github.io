---
interface ComparisonItem {
  text: string;
  strength?: boolean;
}

interface CriterionRow {
  dimension: string;
  detail: string;
  local: ComparisonItem;
  hybrid: ComparisonItem;
  cloud: ComparisonItem;
}

const criteria: CriterionRow[] = [
  {
    dimension: 'Privacy',
    detail: 'Where data is processed',
    local: { text: 'Stays on device', strength: true },
    hybrid: { text: 'Split by policy' },
    cloud: { text: 'Processed remotely' },
  },
  {
    dimension: 'Network & latency',
    detail: 'Connectivity dependency',
    local: { text: 'Works without network', strength: true },
    hybrid: { text: 'Local fallback' },
    cloud: { text: 'Network required' },
  },
  {
    dimension: 'Runtime control',
    detail: 'Deployment & model lifecycle',
    local: { text: 'You control the runtime', strength: true },
    hybrid: { text: 'Shared control' },
    cloud: { text: 'Provider managed' },
  },
  {
    dimension: 'Model capability',
    detail: 'Largest model available',
    local: { text: 'Bound by device' },
    hybrid: { text: 'Routes by workload', strength: true },
    cloud: { text: 'Frontier models', strength: true },
  },
  {
    dimension: 'Elastic scale',
    detail: 'Burst capacity',
    local: { text: 'Fixed by hardware' },
    hybrid: { text: 'Cloud overflow', strength: true },
    cloud: { text: 'Elastic', strength: true },
  },
];
---

<div class="decision-surface">
  <div class="matrix-card">
    <table class="matrix-table" aria-label="Local, Hybrid and Cloud workload decision matrix">
      <colgroup>
        <col class="col-criteria" />
        <col class="col-local" />
        <col class="col-secondary" />
        <col class="col-secondary" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col" class="criterion-heading">Decision factor</th>
          <th scope="col" class="local-column local-column--header">
            <span class="local-heading">
              <span class="local-dot" aria-hidden="true"></span>
              <span>Local AI</span>
              <span class="focus-label">Local-first lens</span>
            </span>
          </th>
          <th scope="col" class="platform-heading platform-heading--hybrid">
            <span class="platform-heading-label">
              <span class="platform-dot" aria-hidden="true"></span>
              <span>Hybrid</span>
            </span>
          </th>
          <th scope="col" class="platform-heading platform-heading--cloud">
            <span class="platform-heading-label">
              <span class="platform-dot" aria-hidden="true"></span>
              <span>Cloud</span>
            </span>
          </th>
        </tr>
      </thead>

      <tbody>
        {criteria.map((row, index) => (
          <>
          {index === 3 && (
            <tr class="group-divider-row">
              <th colspan="4" class="group-divider-cell">
                <span>Trade-offs</span>
                <small>Where Local AI trades capacity for control</small>
              </th>
            </tr>
          )}

          <tr>
            <th scope="row" class="criterion-cell">
              <strong>{row.dimension}</strong>
              <span>{row.detail}</span>
            </th>

            <td class="comparison-cell local-column" data-label="Local AI">
              <span class="mobile-cell-label">Local AI</span>
              <span class:list={['comparison-value', row.local.strength && 'comparison-value--strength']}>
                {row.local.strength && (
                  <><span class="sr-only">Strength: </span><span class="status-check" aria-hidden="true">✓</span></>
                )}
                <span>{row.local.text}</span>
              </span>
            </td>

            <td class="comparison-cell secondary-column hybrid-column" data-label="Hybrid">
              <span class="mobile-cell-label">Hybrid</span>
              <span class:list={['comparison-value', row.hybrid.strength && 'comparison-value--secondary-strength']}>
                {row.hybrid.strength && (
                  <><span class="sr-only">Strength: </span><span class="status-check" aria-hidden="true">✓</span></>
                )}
                <span>{row.hybrid.text}</span>
              </span>
            </td>

            <td class="comparison-cell secondary-column cloud-column" data-label="Cloud">
              <span class="mobile-cell-label">Cloud</span>
              <span class:list={['comparison-value', row.cloud.strength && 'comparison-value--secondary-strength']}>
                {row.cloud.strength && (
                  <><span class="sr-only">Strength: </span><span class="status-check" aria-hidden="true">✓</span></>
                )}
                <span>{row.cloud.text}</span>
              </span>
            </td>
          </tr>
          </>
        ))}

        <tr class="best-for-row">
          <th scope="row" class="best-for-heading">Best fit</th>
          <td class="local-column" data-label="Local AI">
            <span class="mobile-cell-label">Local AI</span>
            <strong>Privacy, latency & control</strong>
          </td>
          <td class="hybrid-column" data-label="Hybrid">
            <span class="mobile-cell-label">Hybrid</span>
            Variable workloads
          </td>
          <td class="cloud-column" data-label="Cloud">
            <span class="mobile-cell-label">Cloud</span>
            Maximum capability
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="decision-hook">
    <div>
      <h3>Not sure where your workload belongs?</h3>
      <p>Tell me what you're building and what constraints matter.</p>
    </div>
    <button type="button" class="primary-button decision-cta" data-open-contact-modal>
      <span>Evaluate my workload</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>
</div>

<style>
  .decision-surface {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .matrix-card {
    --hybrid-ink: color-mix(in srgb, var(--accent-violet) 76%, var(--ink-display));
    --cloud-ink: color-mix(in srgb, var(--accent-teal) 72%, var(--ink-display));
    width: 100%;
    overflow: hidden;
    background: var(--surface-card);
    border: 1px solid color-mix(in srgb, var(--ink-display) 11%, transparent);
    border-radius: 16px;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--ink-display) 3%, transparent);
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }

  .col-criteria { width: 28%; }
  .col-local { width: 26%; }
  .col-secondary { width: 23%; }

  .matrix-table th,
  .matrix-table td {
    padding: 13px clamp(14px, 1.65vw, 20px);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .matrix-table thead th {
    height: 54px;
    padding-top: 11px;
    padding-bottom: 11px;
    background: color-mix(in srgb, var(--surface-subtle) 42%, var(--surface-card));
    border-bottom-color: var(--border-medium);
  }

  .criterion-heading,
  .best-for-heading {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 720;
    letter-spacing: 0.075em;
    color: var(--ink-subtle);
    text-transform: uppercase;
  }

  .platform-heading {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .platform-heading-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .platform-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .matrix-table thead .platform-heading--hybrid {
    color: var(--hybrid-ink);
  }

  .platform-heading--hybrid .platform-dot {
    background: var(--accent-violet);
  }

  .matrix-table thead .platform-heading--cloud {
    color: var(--cloud-ink);
  }

  .platform-heading--cloud .platform-dot {
    background: var(--accent-teal);
  }

  .local-column {
    background: color-mix(in srgb, var(--accent-blue) 4%, var(--surface-card));
    border-left: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-subtle));
    border-right: 1px solid color-mix(in srgb, var(--accent-blue) 13%, var(--border-subtle));
  }

  .matrix-table thead .local-column--header {
    background: color-mix(in srgb, var(--accent-blue) 6%, var(--surface-card));
    box-shadow: inset 0 2px 0 var(--accent-blue);
  }

  .local-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 760;
    letter-spacing: -0.015em;
    color: var(--accent-blue-dark);
  }

  .local-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 10%, transparent);
  }

  .focus-label {
    margin-left: 2px;
    padding-left: 9px;
    border-left: 1px solid color-mix(in srgb, var(--accent-blue) 23%, transparent);
    font-size: 0.66rem;
    line-height: 1.15;
    font-weight: 620;
    color: var(--ink-subtle);
  }

  .criterion-cell strong {
    display: block;
    margin-bottom: 1px;
    font-family: var(--font-display);
    font-size: 0.91rem;
    line-height: 1.25;
    font-weight: 720;
    letter-spacing: -0.015em;
    color: var(--ink-display);
  }

  .criterion-cell > span {
    display: block;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--ink-subtle);
    font-weight: 450;
  }

  .group-divider-cell {
    padding-top: 8px !important;
    padding-bottom: 8px !important;
    background: color-mix(in srgb, var(--surface-subtle) 48%, var(--surface-card));
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium) !important;
  }

  .group-divider-cell span,
  .group-divider-cell small {
    display: inline;
    font-family: var(--font-display);
    font-size: 0.68rem;
    line-height: 1.2;
  }

  .group-divider-cell span {
    font-weight: 720;
    letter-spacing: 0.075em;
    color: var(--ink-subtle);
    text-transform: uppercase;
  }

  .group-divider-cell small {
    margin-left: 8px;
    font-weight: 480;
    color: var(--ink-subtle);
  }

  .comparison-value {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    line-height: 1.35;
    font-weight: 540;
    color: var(--ink-muted);
  }

  .comparison-value--strength {
    font-family: var(--font-display);
    font-weight: 680;
    color: var(--accent-blue-dark);
  }

  .comparison-value--secondary-strength {
    padding: 4px 7px;
    border-radius: 7px;
    font-family: var(--font-display);
    font-weight: 680;
  }

  .hybrid-column .comparison-value--secondary-strength,
  .hybrid-column .comparison-value--secondary-strength .status-check {
    color: var(--hybrid-ink);
  }

  .hybrid-column .comparison-value--secondary-strength {
    background: color-mix(in srgb, var(--accent-violet) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-violet) 14%, transparent);
  }

  .cloud-column .comparison-value--secondary-strength,
  .cloud-column .comparison-value--secondary-strength .status-check {
    color: var(--cloud-ink);
  }

  .cloud-column .comparison-value--secondary-strength {
    background: color-mix(in srgb, var(--accent-teal) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-teal) 14%, transparent);
  }

  .status-check {
    flex: 0 0 auto;
    color: var(--accent-blue);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .best-for-row th,
  .best-for-row td {
    padding-top: 12px;
    padding-bottom: 13px;
    border-top: 1px solid var(--border-medium);
    border-bottom: 0;
  }

  .best-for-row td {
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .best-for-row .local-column {
    color: var(--accent-blue-dark);
  }

  .best-for-row .hybrid-column {
    color: var(--hybrid-ink);
  }

  .best-for-row .cloud-column {
    color: var(--cloud-ink);
  }

  .best-for-row strong {
    font-family: var(--font-display);
    font-weight: 760;
  }

  .decision-hook {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--ink-display) 10%, transparent);
    border-radius: 14px;
    background: var(--surface-card);
  }

  .decision-hook h3 {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 1.3;
    font-weight: 720;
    color: var(--ink-display);
  }

  .decision-hook p {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .decision-cta {
    flex-shrink: 0;
    min-height: 38px;
    padding-inline: 14px;
    cursor: pointer;
    white-space: nowrap;
  }

  .mobile-cell-label {
    display: none;
  }

  @media (max-width: 760px) {
    .matrix-card {
      overflow: hidden;
      border: 1px solid var(--border-medium);
      border-radius: 14px;
      background: var(--surface-card);
    }

    .matrix-table,
    .matrix-table tbody {
      display: block;
      width: 100%;
    }

    .matrix-table colgroup,
    .matrix-table thead {
      display: none;
    }

    .matrix-table tbody tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      background: var(--surface-card);
      border: 0;
      border-bottom: 1px solid var(--border-medium);
      border-radius: 0;
    }

    .matrix-table th,
    .matrix-table td {
      display: block;
      min-width: 0;
      padding: 12px 14px;
      border: 0;
    }

    .criterion-cell {
      grid-column: 1 / -1;
      border-bottom: 1px solid var(--border-subtle) !important;
    }

    .mobile-cell-label {
      display: block;
      margin-bottom: 5px;
      font-family: var(--font-display);
      font-size: var(--text-caption);
      line-height: 1.2;
      font-weight: 720;
      letter-spacing: 0.035em;
      color: var(--ink-subtle);
      text-transform: uppercase;
    }

    .comparison-cell.local-column {
      grid-column: 1 / -1;
      padding-top: 12px;
      padding-bottom: 12px;
      border: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--accent-blue) 18%, var(--border-subtle));
      box-shadow: inset 3px 0 0 var(--accent-blue);
    }

    .comparison-cell.local-column .mobile-cell-label,
    .best-for-row .local-column .mobile-cell-label {
      color: var(--accent-blue-dark);
    }

    .comparison-cell.hybrid-column .mobile-cell-label,
    .best-for-row .hybrid-column .mobile-cell-label {
      color: var(--hybrid-ink);
    }

    .comparison-cell.cloud-column .mobile-cell-label,
    .best-for-row .cloud-column .mobile-cell-label {
      color: var(--cloud-ink);
    }

    .secondary-column + .secondary-column {
      border-left: 1px solid var(--border-subtle);
    }

    .group-divider-row {
      display: block !important;
    }

    .group-divider-cell {
      padding: 12px 14px !important;
    }

    .group-divider-cell span,
    .group-divider-cell small {
      display: block;
    }

    .group-divider-cell small {
      margin: 4px 0 0;
    }

    .best-for-row .best-for-heading {
      grid-column: 1 / -1;
      border-bottom: 1px solid var(--border-subtle);
    }

    .best-for-row .local-column {
      grid-column: 1 / -1;
      border: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--accent-blue) 18%, var(--border-subtle));
      box-shadow: inset 3px 0 0 var(--accent-blue);
    }

    .best-for-row td:last-child {
      border-left: 1px solid var(--border-subtle);
    }

    .matrix-table tbody .best-for-row {
      border-bottom: 0;
    }

    .decision-hook {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .decision-cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
