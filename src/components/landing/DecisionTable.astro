---
interface CriterionRow {
  dimension: string;
  detail: string;
  local: string;
  hybrid: string;
  cloud: string;
}

const criteria: CriterionRow[] = [
  {
    dimension: 'Sensitive data',
    detail: 'Where data is allowed to go',
    local: 'Strongest boundary',
    hybrid: 'Split boundary',
    cloud: 'External boundary',
  },
  {
    dimension: 'Offline & latency',
    detail: 'Network dependence',
    local: 'No network needed',
    hybrid: 'Local fallback',
    cloud: 'Network dependent',
  },
  {
    dimension: 'System control',
    detail: 'Runtime, models and lifecycle',
    local: 'Full control',
    hybrid: 'Control where it matters',
    cloud: 'Provider constraints',
  },
  {
    dimension: 'Model capability',
    detail: 'What the workload needs',
    local: 'Hardware limited',
    hybrid: 'Route when needed',
    cloud: 'Frontier models',
  },
  {
    dimension: 'Scale',
    detail: 'How capacity changes',
    local: 'Fixed capacity',
    hybrid: 'Flexible',
    cloud: 'Elastic',
  },
];
---

<div class="decision-surface">
  <div class="matrix-card" aria-label="Local, Hybrid and Cloud workload decision matrix">
    <div class="matrix-scroll-wrap">
      <table class="matrix-table">
        <thead>
          <tr>
            <th scope="col" class="criterion-heading">What matters?</th>
            <th scope="col"><span class="architecture-label architecture-label--local">Local</span></th>
            <th scope="col"><span class="architecture-label architecture-label--hybrid">Hybrid</span></th>
            <th scope="col"><span class="architecture-label architecture-label--cloud">Cloud</span></th>
          </tr>
        </thead>
        <tbody>
          {criteria.map((row) => (
            <tr>
              <th scope="row" class="criterion-cell">
                <strong>{row.dimension}</strong>
                <span>{row.detail}</span>
              </th>
              <td class="local-cell">{row.local}</td>
              <td>{row.hybrid}</td>
              <td>{row.cloud}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="matrix-outcome">
      <span>The goal isn't to choose Local.</span>
      <strong>It's to choose the right boundary.</strong>
      <div class="outcome-options" aria-label="Possible architecture outcomes">
        <span>Local</span>
        <span>Hybrid</span>
        <span>Cloud</span>
      </div>
    </div>
  </div>

  <div class="decision-hook">
    <div>
      <h3>Not sure where your workload belongs?</h3>
      <p>Tell me what you're building and what constraints matter.</p>
    </div>
    <button type="button" class="primary-button decision-cta" data-open-contact-modal>
      <span>Evaluate my workload</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>
</div>

<style>
  .decision-surface {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .matrix-card {
    width: 100%;
    overflow: hidden;
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 5px 22px rgba(8, 19, 51, 0.045);
  }

  .matrix-scroll-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .matrix-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    text-align: left;
  }

  .matrix-table th,
  .matrix-table td {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .matrix-table thead th {
    background: var(--surface-subtle);
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  .criterion-heading {
    width: 31%;
    color: var(--ink-display) !important;
  }

  .architecture-label {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 5px 11px;
    border-radius: var(--radius-full);
    font-weight: 780;
  }

  .architecture-label--local {
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    border: 1px solid color-mix(in srgb, var(--accent-blue) 22%, var(--border-subtle));
  }

  .architecture-label--hybrid {
    color: #6d28d9;
    background: color-mix(in srgb, #7c3aed 7%, var(--surface-card));
    border: 1px solid color-mix(in srgb, #7c3aed 18%, var(--border-subtle));
  }

  .architecture-label--cloud {
    color: #0369a1;
    background: color-mix(in srgb, #0284c7 7%, var(--surface-card));
    border: 1px solid color-mix(in srgb, #0284c7 18%, var(--border-subtle));
  }

  .criterion-cell {
    width: 31%;
    background: color-mix(in srgb, var(--surface-subtle) 45%, transparent);
  }

  .criterion-cell strong {
    display: block;
    margin-bottom: 3px;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 760;
    color: var(--ink-display);
  }

  .criterion-cell span {
    display: block;
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--ink-subtle);
  }

  .matrix-table td {
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .local-cell {
    font-weight: 680;
    color: var(--ink-display) !important;
    background: color-mix(in srgb, var(--surface-blue-subtle) 42%, transparent);
  }

  .matrix-table tbody tr:last-child th,
  .matrix-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .matrix-outcome {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px 10px;
    padding: 16px 18px;
    border-top: 1px solid var(--border-medium);
    background: color-mix(in srgb, var(--surface-subtle) 62%, var(--surface-card));
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .matrix-outcome strong {
    color: var(--ink-display);
    font-weight: 760;
  }

  .outcome-options {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
  }

  .outcome-options span {
    padding: 4px 8px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 740;
  }

  .decision-hook {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 20px;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 18%, var(--border-medium));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent-blue) 3.5%, var(--surface-card));
  }

  .decision-hook h3 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 780;
    color: var(--ink-display);
  }

  .decision-hook p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .decision-cta {
    flex-shrink: 0;
    min-height: 42px;
    padding-inline: 15px;
    cursor: pointer;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .decision-hook {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .decision-cta { width: 100%; justify-content: center; }
  }
</style>
