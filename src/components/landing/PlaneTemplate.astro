---
/** Shared homepage plane structure: question → short explanation → evidence. */
import type { MethodStageHandoff } from '../../types/landing';
import StageRail from './StageRail.astro';

interface Props {
  id: string;
  number: 1 | 2 | 3 | 4;
  side: 'left' | 'right';
  kicker?: string;
  title: string;
  intro: string;
  handoff?: MethodStageHandoff;
  nextLabel?: string;
  visualLabel: string;
  surface?: 'canvas' | 'subtle';
  isFinal?: boolean;
}

const {
  id,
  number,
  side,
  kicker = '',
  title,
  intro,
  visualLabel,
  surface = 'canvas',
  isFinal = false,
} = Astro.props;

const stage = String(number).padStart(2, '0');
const titleId = `${id}-title`;
---

<section
  class:list={[
    'stage-section',
    'method-stage',
    'plane-section',
    `stage-${side}`,
    `plane-section--${surface}`,
  ]}
  id={id}
  data-stage={stage}
  aria-labelledby={titleId}
>
  <div class="shell stage-shell plane-shell">
    <StageRail number={number} side={side} isFinal={isFinal} />

    <div class="stage-layout plane-layout">
      <header class="stage-copy plane-intro">
        {kicker && <p class="stage-kicker">{kicker}</p>}
        <h2 id={titleId} class="stage-heading">{title}</h2>
        <p class="stage-intro">{intro}</p>
      </header>

      <div class="stage-visual plane-visual" aria-label={visualLabel}>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .plane-section {
    --plane-rail-inset: 42px;
    position: relative;
    min-height: auto;
    display: grid;
    align-items: start;
    overflow: clip;
    padding: 42px 0 56px;
  }

  .plane-section--canvas {
    background: var(--journey-surface-canvas, var(--surface-canvas));
  }

  .plane-section--subtle {
    background:
      radial-gradient(
        ellipse 92% 34% at 50% 18%,
        color-mix(in srgb, var(--accent-blue) 3%, transparent),
        transparent 78%
      ),
      var(--journey-surface-tint, var(--surface-subtle));
  }

  .plane-shell { position: relative; }

  .plane-layout {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-left: 34px;
    padding-right: 0;
  }

  .plane-intro {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-self: flex-start;
  }

  .plane-intro .stage-kicker {
    margin: 0 0 var(--space-2);
    justify-content: flex-start;
  }

  .plane-intro .stage-heading {
    max-width: 100%;
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 8.2vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.042em;
    font-weight: 820;
    color: var(--ink-display);
    text-wrap: pretty;
  }

  .plane-intro .stage-intro {
    max-width: 100%;
    margin: 0;
    font-size: 1rem;
    line-height: 1.58;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .plane-visual {
    width: 100%;
    max-width: 1180px;
    min-width: 0;
    align-self: center;
  }

  @media (min-width: 541px) {
    .plane-section {
      --plane-rail-inset: clamp(48px, 7vw, 64px);
      padding: clamp(54px, 8vw, 78px) 0 clamp(62px, 9vw, 88px);
    }

    .plane-layout {
      gap: clamp(24px, 5vw, 40px);
      padding-left: clamp(48px, 7vw, 68px);
      padding-right: clamp(24px, 4vw, 40px);
    }

    .plane-intro .stage-heading {
      font-size: clamp(1.75rem, 5vw, 2.4rem);
    }

    .plane-intro .stage-intro {
      max-width: 680px;
      font-size: clamp(1rem, 1.25vw, 1.12rem);
    }
  }

  @media (min-width: 981px) {
    .plane-section {
      --plane-rail-inset: clamp(44px, 5vw, 68px);
      min-height: calc(100svh - var(--header-height));
      align-items: center;
      padding: var(--plane-rail-inset) 0 clamp(68px, 8vw, 108px);
    }

    .plane-layout {
      gap: clamp(28px, 4vw, 52px);
      padding-inline: clamp(64px, 7vw, 96px);
    }

    .plane-intro { width: min(100%, 960px); }
    .plane-section.stage-left .plane-intro { align-self: flex-start; }
    .plane-section.stage-right .plane-intro { align-self: flex-end; }

    .plane-intro .stage-heading {
      font-size: clamp(1.75rem, 3.1vw, 2.95rem);
    }

    .plane-section.stage-left .plane-visual { transform-origin: left center; }
    .plane-section.stage-right .plane-visual { transform-origin: right center; }
  }
</style>
