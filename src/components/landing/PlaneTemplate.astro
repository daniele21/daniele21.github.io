---
/**
 * Shared homepage plane structure.
 * True alternating desktop composition:
 * - stage-left: copy on left, visual on right
 * - stage-right: visual on left, copy on right
 */
import type { MethodStageHandoff } from '../../types/landing';
import StageRail from './StageRail.astro';
import StageHandoff from './StageHandoff.astro';

interface Props {
  id: string;
  number: 1 | 2 | 3 | 4;
  side: 'left' | 'right';
  kicker: string;
  title: string;
  intro: string;
  handoff: MethodStageHandoff;
  nextLabel: string;
  visualLabel: string;
  surface?: 'canvas' | 'subtle';
  isFinal?: boolean;
}

const {
  id,
  number,
  side,
  kicker,
  title,
  intro,
  handoff,
  nextLabel,
  visualLabel,
  surface = 'canvas',
  isFinal = false,
} = Astro.props;

const stage = String(number).padStart(2, '0');
const titleId = `${id}-title`;
---

<section
  class:list={[
    'stage-section',
    'method-stage',
    'plane-section',
    `stage-${side}`,
    `plane-section--${surface}`,
  ]}
  id={id}
  data-stage={stage}
  aria-labelledby={titleId}
>
  <div class="shell stage-shell plane-shell">
    <StageRail number={number} side={side} isFinal={isFinal} />

    <div class="stage-layout plane-layout">
      <header class="stage-copy plane-intro">
        <p class="stage-kicker">{kicker}</p>
        <h2 id={titleId} class="stage-heading">{title}</h2>
        <p class="stage-intro">{intro}</p>

        <div class="plane-handoff">
          <StageHandoff handoff={handoff} number={number} nextLabel={nextLabel} compact />
        </div>
      </header>

      <div class="stage-visual plane-visual" aria-label={visualLabel}>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .plane-section {
    --plane-rail-inset: clamp(32px, 4vh, 52px);

    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    padding: var(--plane-rail-inset) 0;
    overflow: clip;
    position: relative;
  }

  .plane-section--canvas { background: var(--surface-canvas); }
  .plane-section--subtle { background: var(--surface-subtle); }

  .plane-shell {
    position: relative;
    width: 100%;
  }

  /* Two-column alternating desktop grid */
  .plane-layout {
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(380px, 1.25fr);
    gap: clamp(32px, 4.5vw, 64px);
    align-items: center;
    width: 100%;
  }

  /* Left-aligned plane: copy left, visual right */
  .plane-section.stage-left .plane-layout {
    grid-template-columns: minmax(320px, 0.95fr) minmax(380px, 1.25fr);
    padding-left: clamp(28px, 4vw, 56px);
  }

  .plane-section.stage-left .plane-intro {
    grid-column: 1;
    grid-row: 1;
    text-align: left;
  }

  .plane-section.stage-left .plane-visual {
    grid-column: 2;
    grid-row: 1;
  }

  /* Right-aligned plane: visual left, copy right */
  .plane-section.stage-right .plane-layout {
    grid-template-columns: minmax(380px, 1.25fr) minmax(320px, 0.95fr);
    padding-right: clamp(28px, 4vw, 56px);
  }

  .plane-section.stage-right .plane-intro {
    grid-column: 2;
    grid-row: 1;
    text-align: left;
  }

  .plane-section.stage-right .plane-visual {
    grid-column: 1;
    grid-row: 1;
  }

  /* Typography & Copy */
  .plane-intro {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .plane-intro .stage-kicker {
    margin: 0 0 var(--space-2);
    justify-content: flex-start;
  }

  .plane-intro .stage-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 2.6vw, 2.65rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .plane-intro .stage-intro {
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    color: var(--ink-muted);
    line-height: 1.55;
    text-wrap: pretty;
    margin: 0 0 var(--space-4);
  }

  .plane-handoff {
    width: 100%;
    margin-top: auto;
  }

  .plane-visual {
    width: 100%;
    min-width: 0;
  }

  /* Responsive below 980px */
  @media (max-width: 980px) {
    .plane-section {
      min-height: auto;
      padding: clamp(48px, 6vw, 72px) 0;
    }

    .plane-section.stage-left .plane-layout,
    .plane-section.stage-right .plane-layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-left: clamp(44px, 6vw, 64px);
      padding-right: 0;
    }

    .plane-section.stage-left .plane-intro,
    .plane-section.stage-right .plane-intro {
      grid-column: 1;
      grid-row: 1;
    }

    .plane-section.stage-left .plane-visual,
    .plane-section.stage-right .plane-visual {
      grid-column: 1;
      grid-row: 2;
    }

    .plane-intro .stage-heading {
      font-size: clamp(1.75rem, 6vw, 2.25rem);
    }
  }

  @media (max-width: 540px) {
    .plane-section.stage-left .plane-layout,
    .plane-section.stage-right .plane-layout {
      padding-left: 36px;
      gap: var(--space-5);
    }
  }
</style>
