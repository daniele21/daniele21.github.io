---
/** Plane 03: use real products as proving grounds. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import PlaneCardGrid from './PlaneCardGrid.astro';
import ProjectProofCard from './ProjectProofCard.astro';

const { testStage } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;
---

<PlaneTemplate
  id="applications"
  number={3}
  side="left"
  surface="subtle"
  kicker=""
  title="Does it work in a real product?"
  intro="Infrastructure only matters when a real application can depend on it."
  handoff={testStage.handoff}
  nextLabel="MEASURE"
  visualLabel="Applications used as empirical proving grounds"
>
  <PlaneCardGrid layout="grid">
    {testStage.applications.map((app) => (
      <ProjectProofCard
        variant="compact"
        title={app.name}
        description={app.question}
        href={resolveHref(app.href)}
        logoPath={app.logoPath}
        logoAlt={`${app.name} logo`}
        imagePath={app.imagePath}
        imageAlt={`${app.name} product interface`}
        tone={app.colorClass as 'blue' | 'green' | 'purple' | 'red'}
        features={app.features}
        ctaLabel={`See the proof`}
      />
    ))}
  </PlaneCardGrid>
</PlaneTemplate>
