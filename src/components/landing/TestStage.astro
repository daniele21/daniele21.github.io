---
/** Plane 03: three compact product cards used as real proving grounds. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import PlaneCardGrid from './PlaneCardGrid.astro';
import ProjectProofCard from './ProjectProofCard.astro';

const { testStage } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;
---

<PlaneTemplate
  id="applications"
  number={3}
  side="left"
  surface="canvas"
  kicker={testStage.kicker}
  title={testStage.title}
  intro={testStage.intro}
  handoff={testStage.handoff}
  nextLabel="MEASURE"
  visualLabel="Applications used as proving grounds"
>
  <PlaneCardGrid>
    {testStage.applications.map((app) => (
      <ProjectProofCard
        variant="proof"
        eyebrow={app.name === 'RedactGuard' ? 'SENSITIVE DOCUMENTS' : app.name === 'Aura Finance' ? 'PERSONAL FINANCE' : 'MEETINGS'}
        title={app.name}
        description={app.question}
        href={resolveHref(app.href)}
        logoPath={app.logoPath}
        logoAlt={`${app.name} logo`}
        features={app.features}
        evidenceLabel="REVEALS"
        evidence={app.evidence}
        ctaLabel="See the test"
      />
    ))}
  </PlaneCardGrid>
</PlaneTemplate>
