---
/** Plane 03: show the real product interfaces that test local-AI infrastructure. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import TestProductGallery from './TestProductGallery.astro';

const { testStage } = landingData;
---

<PlaneTemplate
  id="applications"
  number={3}
  side="left"
  surface="subtle"
  kicker=""
  title="Does it survive a real product?"
  intro="Infrastructure only matters when real applications can depend on it. These products put privacy, usability and integration assumptions to the test."
  handoff={testStage.handoff}
  nextLabel="MEASURE"
  visualLabel="Three real AI products with application screenshots, workloads and infrastructure links"
>
  <TestProductGallery />
</PlaneTemplate>
