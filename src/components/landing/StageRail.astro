---
/**
 * StageRail — the persistent segment of the Decide / Build / Test / Measure path.
 *
 * The rail lives inside a stage while MethodThread bridges the space between
 * stages. Both use the same 2% edge coordinate, so the path reads as one
 * continuous alternating line rather than a set of decorative separators.
 * The rail anchor has zero width so its axis matches the SVG coordinate
 * exactly, without a half-pixel offset at either handoff.
 */
interface Props {
  number: number;
  side: 'left' | 'right';
  isFinal?: boolean;
}

const { number, side, isFinal = false } = Astro.props;
const label = String(number).padStart(2, '0');
---

<div class={`stage-rail rail-${side} ${isFinal ? 'rail-final' : ''}`} aria-hidden="true">
  <span class="rail-guide"></span>
  <span class="rail-progress"></span>
  <span class="stage-node">{label}</span>
  {isFinal && <span class="rail-terminal"></span>}
</div>

<style>
  .stage-rail {
    --path-progress: 0;
    position: absolute;
    top: calc(-1 * clamp(48px, 6vw, 72px));
    bottom: calc(-1 * clamp(48px, 6vw, 72px));
    z-index: 4;
    width: 0;
    pointer-events: none;
  }

  .rail-left { left: 2%; }
  .rail-right { right: 2%; }

  .rail-guide,
  .rail-progress {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--method-path-width);
    transform: translateX(-50%);
  }

  .rail-guide {
    background: var(--method-path-guide);
  }

  .rail-progress {
    background: var(--accent-blue);
    filter: var(--method-path-glow);
    transform: translateX(-50%) scaleY(var(--path-progress));
    transform-origin: top;
    will-change: transform;
  }

  .stage-node {
    position: absolute;
    top: clamp(48px, 6vw, 72px);
    left: 0;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%) scale(var(--node-scale, 0.72));
    border: 6px solid var(--surface-canvas);
    border-radius: 50%;
    background: var(--ink-display);
    color: var(--ink-inverse);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent-blue) 32%, transparent),
      0 12px 30px rgba(8, 19, 51, 0.16);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.04em;
    opacity: var(--node-opacity, 0);
    transition:
      background var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
    will-change: transform, opacity;
  }

  :global(.method-stage.is-active) .stage-node {
    background: var(--accent-blue);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent-blue) 38%, transparent),
      0 0 0 8px color-mix(in srgb, var(--accent-blue) 9%, transparent),
      0 16px 36px rgba(20, 91, 255, 0.24);
  }

  .rail-terminal {
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 13px;
    height: 13px;
    transform: translateX(-50%);
    border: 3px solid var(--surface-canvas);
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 1px var(--border-strong);
  }

  @media (max-width: 760px) {
    .stage-rail,
    .rail-right {
      left: 14px;
      right: auto;
    }

    .stage-node {
      width: 42px;
      height: 42px;
      border-width: 5px;
      font-size: var(--text-badge);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-progress {
      transform: translateX(-50%) scaleY(1);
    }

    .stage-node {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
  }
</style>
