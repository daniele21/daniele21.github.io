---
import { landingData } from '../../content/locales/en/landing';

const { buildStage } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const hrefFor = (href: string, external?: boolean) => {
  if (external || href.startsWith('http')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};

const symbolFor = (id: string) => {
  if (id === 'decisio') return 'D';
  if (id === 'local-asr-server') return 'ASR';
  return id === 'korgis' ? 'K' : 'H';
};
---

<div class="systems-showcase">
  <div class="systems-grid" aria-label="Reusable AI infrastructure">
    {buildStage.projects.map((project) => (
      <article class="system-card">
        <div class="system-card__topline">
          <span class="system-card__eyebrow">{project.eyebrow}</span>
          {project.status && <span class="system-card__status">{project.status}</span>}
        </div>

        <div class="system-card__identity">
          <div class="system-card__mark" aria-hidden="true">
            {project.logoPath ? (
              <img src={hrefFor(project.logoPath)} alt="" loading="lazy" />
            ) : (
              <span>{symbolFor(project.id)}</span>
            )}
          </div>
          <div>
            <h3>{project.title}</h3>
            {project.layer && <p class="system-card__layer">{project.layer}</p>}
          </div>
        </div>

        <p class="system-card__summary">{project.summary}</p>

        <div class="system-card__features" aria-label={`${project.title} capabilities`}>
          {project.features.map((feature) => (
            <span>{feature.label}</span>
          ))}
        </div>

        <div class="system-card__proof">
          <span>WHY IT EXISTS</span>
          <p>{project.evidence}</p>
        </div>

        <a
          class="system-card__link"
          href={hrefFor(project.href, project.external)}
          target={project.external ? '_blank' : undefined}
          rel={project.external ? 'noopener noreferrer' : undefined}
        >
          {project.external ? 'Open repository' : 'Explore system'} <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </div>

  <div class="visual-placeholder" role="img" aria-label="Placeholder for the AI systems ecosystem relationship map">
    <div class="visual-placeholder__label">VISUAL PLACEHOLDER · ECOSYSTEM MAP</div>
    <strong>Show how the reusable primitives connect to real products.</strong>
    <p>
      Final graphic expected here: Korgis, Harnex, Decisio and Local ASR as four distinct
      infrastructure nodes feeding ClosedRoom, RedactGuard and Aura Finance. Use arrows only for
      real dependencies; distinguish current integrations from planned ones and keep Local / Hybrid /
      Cloud boundaries visible.
    </p>
  </div>
</div>

<style>
  .systems-showcase {
    display: grid;
    gap: clamp(22px, 3vw, 34px);
  }

  .systems-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 20px);
  }

  .system-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.6vw, 28px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 88% 6%, color-mix(in srgb, var(--accent-blue) 8%, transparent), transparent 34%),
      var(--surface-card);
    box-shadow: var(--shadow-xs);
  }

  .system-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 18px;
  }

  .system-card__eyebrow,
  .system-card__status,
  .system-card__proof > span {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .system-card__eyebrow { color: var(--accent-blue-dark); }

  .system-card__status {
    padding: 4px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--ink-muted);
    letter-spacing: 0.045em;
    background: var(--surface-subtle);
  }

  .system-card__identity {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .system-card__mark {
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent-blue) 25%, var(--border-medium));
    border-radius: 14px;
    background: var(--surface-subtle);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .system-card__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .system-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink-display);
  }

  .system-card__layer {
    margin: 4px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.35;
  }

  .system-card__summary {
    margin: 18px 0 0;
    color: var(--ink-muted);
    font-size: 0.96rem;
    line-height: 1.56;
  }

  .system-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }

  .system-card__features span {
    padding: 5px 9px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 650;
  }

  .system-card__proof {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .system-card__proof > span { color: var(--ink-muted); }

  .system-card__proof p {
    margin: 6px 0 0;
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .system-card__link {
    width: fit-content;
    margin-top: auto;
    padding-top: 20px;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 760;
    text-decoration: none;
  }

  .system-card__link:hover,
  .system-card__link:focus-visible {
    color: var(--accent-blue);
  }

  .visual-placeholder {
    min-height: 210px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 42px);
    border: 1.5px dashed color-mix(in srgb, var(--accent-blue) 36%, var(--border-medium));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 4%, transparent), transparent 55%),
      var(--surface-subtle);
  }

  .visual-placeholder__label {
    margin-bottom: 12px;
    color: var(--accent-blue-dark);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 750;
    letter-spacing: 0.055em;
  }

  .visual-placeholder strong {
    max-width: 760px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.3;
  }

  .visual-placeholder p {
    max-width: 850px;
    margin: 10px 0 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  @media (max-width: 820px) {
    .systems-grid { grid-template-columns: 1fr; }
  }
</style>
