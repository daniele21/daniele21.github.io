---
import { landingData } from '../../content/locales/en/landing';

const { buildStage } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const hrefFor = (href: string, external?: boolean) => {
  if (external || href.startsWith('http')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};

const metaIconFor = (id: string) => {
  if (id === 'korgis') return '▣';
  if (id === 'harnex') return '▯';
  if (id === 'decisio') return '◇';
  return '≋';
};
---

<div class="systems-showcase">
  <div class="systems-grid" aria-label="Reusable AI infrastructure">
    {buildStage.projects.map((project) => (
      <article class="system-card" data-project={project.id}>
        <div class="system-card__topline">
          <span class="system-card__eyebrow">
            <span class="system-card__meta-icon" aria-hidden="true">{metaIconFor(project.id)}</span>
            {project.eyebrow}
          </span>

          {project.status && (
            <span
              class:list={[
                'system-card__status',
                { 'system-card__status--experimental': project.status === 'EXPERIMENTAL' },
              ]}
            >
              <span class="system-card__status-dot" aria-hidden="true"></span>
              {project.status}
            </span>
          )}
        </div>

        <div class="system-card__identity">
          <div class="system-card__mark" aria-hidden="true">
            {project.logoPath ? (
              <img src={hrefFor(project.logoPath)} alt="" loading="lazy" />
            ) : project.id === 'decisio' ? (
              <span class="decisio-mark">
                <i></i><i></i><i></i>
              </span>
            ) : (
              <span class="asr-mark">
                <i></i><i></i><i></i><i></i><i></i>
              </span>
            )}
          </div>

          <div class="system-card__identity-copy">
            <h3>{project.title}</h3>
            {project.layer && <p class="system-card__layer">{project.layer}</p>}
          </div>
        </div>

        <p class="system-card__summary">{project.summary}</p>

        <div class="system-card__features" aria-label={`${project.title} capabilities`}>
          {project.features.slice(0, 3).map((feature) => (
            <span>{feature.label}</span>
          ))}
        </div>

        <div class="system-card__footer">
          <a
            class="system-card__link"
            href={hrefFor(project.href, project.external)}
            target={project.external ? '_blank' : undefined}
            rel={project.external ? 'noopener noreferrer' : undefined}
          >
            Explore system <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="visual-placeholder" role="img" aria-label="Placeholder for the AI systems ecosystem relationship map">
    <div class="visual-placeholder__label">VISUAL PLACEHOLDER · ECOSYSTEM MAP</div>
    <strong>Show how the reusable primitives connect to real products.</strong>
    <p>
      Final graphic expected here: Korgis, Harnex, Decisio and Local ASR as four distinct
      infrastructure nodes feeding ClosedRoom, RedactGuard and Aura Finance. Use arrows only for
      real dependencies; distinguish current integrations from planned ones and keep Local / Hybrid /
      Cloud boundaries visible.
    </p>
  </div>
</div>

<style>
  .systems-showcase {
    display: grid;
    gap: clamp(22px, 3vw, 34px);
  }

  .systems-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 20px);
  }

  .system-card {
    --card-accent: var(--accent-blue);
    --card-accent-2: var(--accent-blue-light);
    --card-soft: color-mix(in srgb, var(--card-accent) 8%, transparent);
    --card-softer: color-mix(in srgb, var(--card-accent-2) 5%, transparent);

    position: relative;
    isolation: isolate;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.25vw, 26px);
    border: 1px solid color-mix(in srgb, var(--card-accent) 34%, var(--border-medium));
    border-radius: clamp(18px, 2vw, 22px);
    background:
      radial-gradient(
        circle at 94% 4%,
        color-mix(in srgb, var(--card-accent-2) 19%, transparent) 0,
        transparent 36%
      ),
      radial-gradient(
        ellipse at 38% 112%,
        color-mix(in srgb, var(--card-accent) 10%, transparent) 0,
        transparent 44%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--surface-card) 95%, var(--card-accent) 5%),
        color-mix(in srgb, var(--surface-card) 98%, var(--card-accent-2) 2%)
      );
    box-shadow:
      0 14px 34px color-mix(in srgb, var(--card-accent) 8%, transparent),
      var(--shadow-xs);
    transition:
      transform var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
  }

  .system-card::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: 56%;
    height: 62%;
    right: -14%;
    bottom: -24%;
    border-radius: 50%;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--card-accent) 7%, transparent),
      color-mix(in srgb, var(--card-accent-2) 2%, transparent)
    );
    transform: rotate(-16deg);
    pointer-events: none;
  }

  .system-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--card-accent) 50%, var(--border-medium));
    box-shadow:
      0 18px 40px color-mix(in srgb, var(--card-accent) 11%, transparent),
      var(--shadow-sm);
  }

  .system-card[data-project='korgis'] {
    --card-accent: #1677ff;
    --card-accent-2: #22d3ee;
  }

  .system-card[data-project='harnex'] {
    --card-accent: #7c3aed;
    --card-accent-2: #2dd4bf;
  }

  .system-card[data-project='decisio'] {
    --card-accent: #4f46e5;
    --card-accent-2: #8b5cf6;
  }

  .system-card[data-project='local-asr-server'] {
    --card-accent: #0ea5e9;
    --card-accent-2: #60a5fa;
  }

  .system-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .system-card__eyebrow {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: color-mix(in srgb, var(--card-accent) 76%, var(--ink-muted));
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .system-card__meta-icon {
    color: color-mix(in srgb, var(--card-accent) 70%, var(--ink-muted));
    font-size: 0.92rem;
    line-height: 1;
  }

  .system-card__status {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--status-good-text) 20%, var(--border-subtle));
    border-radius: var(--radius-full);
    color: color-mix(in srgb, var(--status-good-text) 82%, var(--ink));
    background: color-mix(in srgb, var(--status-good-bg) 68%, var(--surface-card));
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 800;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .system-card__status--experimental {
    border-color: color-mix(in srgb, var(--accent-amber) 25%, var(--border-subtle));
    color: var(--status-warn-text);
    background: color-mix(in srgb, var(--status-warn-bg) 72%, var(--surface-card));
  }

  .system-card__status-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--status-good-text);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--status-good-text) 8%, transparent);
  }

  .system-card__status--experimental .system-card__status-dot {
    background: var(--accent-amber);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-amber) 9%, transparent);
  }

  .system-card__identity {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .system-card__identity-copy {
    min-width: 0;
  }

  .system-card__mark {
    width: 58px;
    height: 58px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--card-accent) 32%, var(--border-medium));
    border-radius: 16px;
    background:
      radial-gradient(circle at 30% 22%, color-mix(in srgb, var(--card-accent-2) 12%, transparent), transparent 42%),
      color-mix(in srgb, var(--surface-card) 82%, var(--card-accent) 18%);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 65%, transparent),
      0 8px 18px color-mix(in srgb, var(--card-accent) 10%, transparent);
  }

  .system-card__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .decisio-mark {
    display: grid;
    gap: 5px;
    width: 30px;
  }

  .decisio-mark i {
    display: block;
    height: 5px;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--card-accent), var(--card-accent-2));
    box-shadow: 0 2px 5px color-mix(in srgb, var(--card-accent) 18%, transparent);
  }

  .asr-mark {
    height: 34px;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .asr-mark i {
    width: 4px;
    border-radius: var(--radius-full);
    background: linear-gradient(180deg, var(--card-accent-2), var(--card-accent));
  }

  .asr-mark i:nth-child(1),
  .asr-mark i:nth-child(5) { height: 14px; }

  .asr-mark i:nth-child(2),
  .asr-mark i:nth-child(4) { height: 24px; }

  .asr-mark i:nth-child(3) { height: 34px; }

  .system-card h3 {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.9vw, 1.65rem);
    font-weight: 820;
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .system-card__layer {
    margin: 4px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.35;
  }

  .system-card__summary {
    max-width: 95%;
    margin: 16px 0 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .system-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }

  .system-card__features span {
    padding: 5px 10px;
    border: 1px solid color-mix(in srgb, var(--card-accent) 10%, var(--border-subtle));
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--card-accent) 7%, var(--surface-card));
    color: color-mix(in srgb, var(--card-accent) 60%, var(--ink));
    font-size: var(--text-caption);
    font-weight: 650;
    line-height: 1.3;
  }

  .system-card__footer {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--card-accent) 10%, var(--border-subtle));
  }

  .system-card__link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: color-mix(in srgb, var(--card-accent) 88%, var(--ink-display));
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 780;
    text-decoration: none;
  }

  .system-card__link span {
    transition: transform var(--duration-fast) ease;
  }

  .system-card__link:hover span,
  .system-card__link:focus-visible span {
    transform: translateX(3px);
  }

  .visual-placeholder {
    min-height: 210px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 42px);
    border: 1.5px dashed color-mix(in srgb, var(--accent-blue) 36%, var(--border-medium));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 4%, transparent), transparent 55%),
      var(--surface-subtle);
  }

  .visual-placeholder__label {
    margin-bottom: 12px;
    color: var(--accent-blue-dark);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 750;
    letter-spacing: 0.055em;
  }

  .visual-placeholder strong {
    max-width: 760px;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.3;
  }

  .visual-placeholder p {
    max-width: 850px;
    margin: 10px 0 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  html[data-theme='dark'] .system-card {
    background:
      radial-gradient(
        circle at 94% 4%,
        color-mix(in srgb, var(--card-accent-2) 13%, transparent) 0,
        transparent 36%
      ),
      radial-gradient(
        ellipse at 38% 112%,
        color-mix(in srgb, var(--card-accent) 10%, transparent) 0,
        transparent 44%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--surface-card) 94%, var(--card-accent) 6%),
        var(--surface-card)
      );
  }

  html[data-theme='dark'] .system-card__mark {
    background:
      radial-gradient(circle at 30% 22%, color-mix(in srgb, var(--card-accent-2) 12%, transparent), transparent 42%),
      color-mix(in srgb, var(--surface-card) 86%, var(--card-accent) 14%);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 820px) {
    .systems-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .system-card {
      padding: 18px;
      border-radius: 18px;
    }

    .system-card__topline {
      align-items: flex-start;
    }

    .system-card__eyebrow {
      font-size: var(--text-caption);
    }

    .system-card__status {
      min-height: 28px;
      padding-inline: 8px;
    }

    .system-card__mark {
      width: 52px;
      height: 52px;
    }

    .system-card__summary {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .system-card,
    .system-card__link span {
      transition: none;
    }

    .system-card:hover {
      transform: none;
    }
  }
</style>
