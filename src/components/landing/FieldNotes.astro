---
/**
 * FieldNotes.astro
 * Dated research notes, articles, and methodology essays.
 */
import { landingData } from '../../content/locales/en/landing';

const { fieldNotes } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<section class="stage-section" id="notes" aria-labelledby="notes-title">
  <div class="shell stage-shell">
    <header class="stage-header">
      <p class="stage-kicker">{fieldNotes.kicker}</p>
      <h2 id="notes-title" class="stage-heading">{fieldNotes.title}</h2>
      <p class="stage-intro">{fieldNotes.description}</p>
    </header>

    <div class="notes-list">
      {fieldNotes.notes.map((note) => (
        <article class="note-item">
          <div class="note-meta">
            <time class="note-date">{note.date}</time>
            <span class="note-read-time">{note.readTime}</span>
          </div>

          <div class="note-content">
            <h3 class="note-title">
              <a href={resolveHref(note.href)}>{note.title}</a>
            </h3>
            <p class="note-excerpt">{note.excerpt}</p>
          </div>

          <div class="note-action">
            <a class="note-read-btn" href={resolveHref(note.href)} aria-label={`Read note: ${note.title}`}>
              Read article <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stage-section {
    padding: clamp(48px, 7vw, 84px) 0;
    background: var(--surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .stage-header {
    max-width: 820px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .stage-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--ink-display);
  }

  .stage-intro {
    font-size: var(--text-lead);
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-medium);
  }

  .note-item {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: clamp(16px, 3vw, 32px);
    align-items: center;
    padding: clamp(22px, 3vw, 30px) 0;
    border-bottom: 1px solid var(--border-medium);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .note-item:hover {
    transform: translateX(6px);
    border-color: var(--border-strong);
  }

  .note-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--accent-blue-dark);
  }

  .note-read-time {
    font-size: var(--text-badge);
    color: var(--ink-subtle);
  }

  .note-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .note-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    line-height: 1.35;
  }

  .note-title a {
    color: var(--ink-display);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .note-title a:hover {
    color: var(--accent-blue);
  }

  .note-excerpt {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .note-action {
    display: flex;
    align-items: center;
  }

  .note-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--touch-target-min);
    padding: 6px 0 6px 14px;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--accent-blue);
    background: transparent;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .note-read-btn:hover {
    color: var(--accent-blue-hover);
  }

  @media (max-width: 820px) {
    .note-item {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-2);
    }

    .note-meta {
      flex-direction: row;
      gap: var(--space-3);
    }
  }
</style>
