---
/** Plane 02: the reusable infrastructure projects that make local execution usable. */
import { landingData } from '../../content/locales/en/landing';
import PlaneTemplate from './PlaneTemplate.astro';
import PlaneCardGrid from './PlaneCardGrid.astro';
import ProjectProofCard from './ProjectProofCard.astro';

const { buildStage } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => `${baseUrl}/${href.replace(/^\//, '')}`;
---

<PlaneTemplate
  id="infrastructure"
  number={2}
  side="right"
  surface="subtle"
  kicker={buildStage.kicker}
  title={buildStage.title}
  intro={buildStage.intro}
  handoff={buildStage.handoff}
  nextLabel="TEST"
  visualLabel="Local AI infrastructure projects"
>
  <PlaneCardGrid>
    {buildStage.projects.map((project) => (
      <ProjectProofCard
        variant="execution"
        eyebrow={project.eyebrow}
        title={project.title}
        description={project.summary}
        href={resolveHref(project.href)}
        logoPath={project.logoPath}
        logoAlt={project.logoAlt}
        symbol={project.id === 'local-asr-server' ? 'audio' : undefined}
        features={project.features}
        evidenceLabel="ENABLES"
        evidence={project.evidence}
        ctaLabel="See how it works"
      />
    ))}
  </PlaneCardGrid>
</PlaneTemplate>
