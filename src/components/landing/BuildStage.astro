import PlaneTemplate from './PlaneTemplate.astro';
import BuildSystemsShowcase from './BuildSystemsShowcase.astro';

const { buildStage } = landingData;
---

<PlaneTemplate
  id="infrastructure"
  number={2}
  side="right"
  surface="canvas"
  kicker=""
  title={buildStage.title}
  intro={buildStage.intro}
  handoff={buildStage.handoff}
  nextLabel="TEST"
  visualLabel="Reusable AI infrastructure systems"
>
  <BuildSystemsShowcase />
</PlaneTemplate>
