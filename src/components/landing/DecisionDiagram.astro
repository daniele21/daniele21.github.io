---
/**
 * DecisionDiagram.astro
 * Visualizes the decision framework:
 * Inputs (Privacy, Control, Dependency, Fit) -> Workload Boundary -> Local / Hybrid / Cloud.
 */
import { landingData } from '../../content/locales/en/landing';

const { decisionStage } = landingData;
---

<div class="decision-diagram" aria-label="Workload decision framework diagram">
  <!-- Column 1: Inputs / Drivers -->
  <div class="diagram-column diagram-column--inputs">
    <span class="column-title">WORKLOAD INPUTS</span>
    <div class="inputs-stack">
      {decisionStage.drivers.map((driver) => (
        <div class="driver-card">
          <span class="driver-icon" aria-hidden="true">{driver.icon}</span>
          <div class="driver-info">
            <strong class="driver-name">{driver.title}</strong>
            <span class="driver-desc">{driver.text}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Connector 1 -->
  <div class="diagram-connector" aria-hidden="true">
    <svg viewBox="0 0 40 100" preserveAspectRatio="none" class="connector-svg">
      <path d="M 0 50 H 40" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" />
      <polygon points="34,46 40,50 34,54" fill="currentColor" />
    </svg>
  </div>

  <!-- Column 2: The Core Boundary Evaluation -->
  <div class="diagram-column diagram-column--boundary">
    <div class="boundary-core-card">
      <span class="boundary-badge">EVALUATION</span>
      <h3 class="boundary-title">Workload Boundary</h3>
      <p class="boundary-desc">Smallest viable model & controlled execution fit</p>
      <div class="boundary-metrics">
        <span class="metric-tag">Data Sensitivity</span>
        <span class="metric-tag">Latency Floor</span>
        <span class="metric-tag">Hardware Target</span>
      </div>
    </div>
  </div>

  <!-- Connector 2 -->
  <div class="diagram-connector" aria-hidden="true">
    <svg viewBox="0 0 40 100" preserveAspectRatio="none" class="connector-svg">
      <path d="M 0 50 H 40" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" />
      <polygon points="34,46 40,50 34,54" fill="currentColor" />
    </svg>
  </div>

  <!-- Column 3: Outcomes (Local / Hybrid / Cloud) -->
  <div class="diagram-column diagram-column--outcomes">
    <span class="column-title">DESTINATIONS</span>
    <div class="outcomes-stack">
      <div class="outcome-branch outcome-branch--local">
        <div class="outcome-head">
          <span class="outcome-dot" aria-hidden="true"></span>
          <strong>LOCAL</strong>
        </div>
        <p>Private compute & on-device</p>
      </div>

      <div class="outcome-branch outcome-branch--hybrid">
        <div class="outcome-head">
          <span class="outcome-dot" aria-hidden="true"></span>
          <strong>HYBRID</strong>
        </div>
        <p>Local baseline + cloud fallback</p>
      </div>

      <div class="outcome-branch outcome-branch--cloud">
        <div class="outcome-head">
          <span class="outcome-dot" aria-hidden="true"></span>
          <strong>CLOUD</strong>
        </div>
        <p>Frontier scale & external APIs</p>
      </div>
    </div>
  </div>
</div>

<style>
  .decision-diagram {
    display: grid;
    grid-template-columns: 1.15fr auto 1.1fr auto 0.95fr;
    gap: clamp(8px, 1.2vw, 16px);
    align-items: center;
    padding: clamp(18px, 2.4vw, 28px);
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    width: 100%;
  }

  .diagram-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .column-title {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.1em;
    color: var(--accent-blue-dark);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  /* Inputs Stack */
  .inputs-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .driver-card {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 10px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .driver-card:hover {
    border-color: var(--border-strong);
    transform: translateX(2px);
  }

  .driver-icon {
    font-size: 0.95rem;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .driver-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .driver-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--ink-display);
    line-height: 1.2;
  }

  .driver-desc {
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.35;
    margin-top: 1px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Connectors */
  .diagram-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    color: var(--accent-blue);
    opacity: 0.75;
  }

  .connector-svg {
    width: 100%;
    height: 40px;
    overflow: visible;
  }

  /* Boundary Core Card */
  .boundary-core-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px 12px;
    background: linear-gradient(145deg, #f0f5ff 0%, #ffffff 100%);
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(20, 91, 255, 0.08);
  }

  .boundary-badge {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--accent-blue-dark);
    background: #dbeafe;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    margin-bottom: 6px;
  }

  .boundary-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.2;
  }

  .boundary-desc {
    margin: 0 0 10px;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.35;
  }

  .boundary-metrics {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .metric-tag {
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.9);
    padding: 3px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-medium);
  }

  /* Outcomes Stack */
  .outcomes-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .outcome-branch {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    transition: transform var(--duration-fast) ease;
  }

  .outcome-branch:hover {
    transform: translateX(2px);
  }

  .outcome-head {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .outcome-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .outcome-branch--local {
    border-left: 3px solid var(--accent-blue);
    color: var(--accent-blue-dark);
  }

  .outcome-branch--hybrid {
    border-left: 3px solid #8b5cf6;
    color: #6d28d9;
  }

  .outcome-branch--cloud {
    border-left: 3px solid #0284c7;
    color: #0369a1;
  }

  .outcome-head strong {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 850;
    color: var(--ink-display);
    letter-spacing: 0.03em;
  }

  .outcome-branch p {
    margin: 2px 0 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.3;
  }

  @media (max-width: 680px) {
    .decision-diagram {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .diagram-connector {
      display: none;
    }
  }
</style>
