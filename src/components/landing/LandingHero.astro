---
import { landingData } from '../../content/locales/en/landing';
import { portfolioNarrative } from '../../content/portfolio';

const { hero } = landingData;
const { mission, capabilities } = portfolioNarrative;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};

const linkedinUrl = hero.identity.socials?.find((link) => link.platform === 'linkedin')?.href ?? 'https://www.linkedin.com/in/daniele-moltisanti/';
const githubUrl = hero.identity.socials?.find((link) => link.platform === 'github')?.href ?? 'https://github.com/daniele21';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <div class="hero-main">
      <p class="hero-eyebrow">{mission.eyebrow}</p>
      <h1 id="hero-title" class="hero-heading">{mission.title}</h1>

      <p class="hero-lead">
        Strategy <span>·</span> Product <span>·</span> Architecture <span>·</span> Engineering <span>·</span> Evaluation
      </p>

      <p class="hero-explanation">{mission.lede}</p>
      <p class="hero-specialization">{mission.specialization}</p>

      <div class="hero-actions">
        <a class="primary-button" href={resolveHref('#strategy')}>
          Explore the method <span aria-hidden="true">↓</span>
        </a>
        <a class="secondary-button" href={resolveHref('/about')}>
          About me <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-context" aria-label="Professional context">
        <span><strong>{hero.identity.role}</strong></span>
        <span>Enterprise AI experience at {hero.identity.affiliation}</span>
        <span>Independent systems & product builder</span>
      </div>
    </div>

    <div class="hero-loop" aria-label="End-to-end AI systems lifecycle">
      {capabilities.map((capability, index) => (
        <a class="loop-step" href={resolveHref(index === 0 ? '#strategy' : index === 1 ? '#infrastructure' : index === 2 ? '#applications' : '#evidence')}>
          <span class="loop-index">0{index + 1}</span>
          <span class="loop-copy">
            <strong>{capability.label}</strong>
            <small>{capability.title}</small>
          </span>
          {index < capabilities.length - 1 && <span class="loop-arrow" aria-hidden="true">→</span>}
        </a>
      ))}
    </div>

    <div class="hero-trust">
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <span>Verified project state: {portfolioNarrative.lastVerified}</span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    overflow: clip;
    padding: clamp(34px, 4.5vw, 62px) 0 clamp(44px, 6vw, 76px);
    background:
      radial-gradient(ellipse 64% 50% at 78% 16%, rgba(20, 91, 255, 0.08), transparent 72%),
      radial-gradient(ellipse 46% 38% at 10% 72%, rgba(124, 58, 237, 0.045), transparent 64%),
      linear-gradient(180deg, var(--surface-canvas) 0%, var(--surface-subtle) 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent-blue) 2.7%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent-blue) 2.7%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 68% at 52% 42%, black 16%, transparent 88%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .hero-main {
    max-width: 1050px;
    padding: clamp(48px, 7vw, 88px) 0 clamp(28px, 4vw, 48px);
  }

  .hero-eyebrow {
    margin: 0 0 16px;
    color: var(--accent-blue);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hero-heading {
    max-width: 980px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 6.2vw, 5.8rem);
    line-height: 0.99;
    letter-spacing: -0.062em;
    font-weight: 870;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .hero-lead {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 24px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.45vw, 1.22rem);
    font-weight: 760;
  }

  .hero-lead span { color: var(--accent-blue); }

  .hero-explanation {
    max-width: 860px;
    margin: 18px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.02rem, 1.35vw, 1.18rem);
    line-height: 1.65;
  }

  .hero-specialization {
    max-width: 860px;
    margin: 12px 0 0;
    padding-left: 14px;
    border-left: 3px solid color-mix(in srgb, var(--accent-blue) 62%, transparent);
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-actions a {
    min-height: 48px;
    padding-inline: 18px;
    gap: 10px;
  }

  .hero-context {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .hero-context span {
    padding: 7px 11px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface-card) 86%, transparent);
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .hero-context strong { color: var(--ink-display); }

  .hero-loop {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--border-medium);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface-card) 92%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .loop-step {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
    padding: 17px 18px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-fast) ease;
  }

  .loop-step + .loop-step { border-left: 1px solid var(--border-subtle); }
  .loop-step:hover { background: var(--surface-subtle); }

  .loop-index {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 820;
  }

  .loop-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .loop-copy strong {
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
  }

  .loop-copy small {
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .loop-arrow {
    color: var(--ink-subtle);
    font-size: 0.9rem;
  }

  .hero-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding-top: 18px;
    color: var(--ink-subtle);
    font-size: var(--text-caption);
  }

  .hero-trust a {
    color: var(--ink-muted);
    font-weight: 690;
    text-decoration: none;
  }

  .hero-trust a:hover { color: var(--accent-blue-dark); }

  @media (max-width: 900px) {
    .hero-section { min-height: auto; }
    .hero-loop { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .loop-step:nth-child(3) { border-left: 0; border-top: 1px solid var(--border-subtle); }
    .loop-step:nth-child(4) { border-top: 1px solid var(--border-subtle); }
  }

  @media (max-width: 560px) {
    .hero-main { padding-top: 42px; }
    .hero-heading { font-size: clamp(2.45rem, 13vw, 3.7rem); }
    .hero-actions { align-items: stretch; }
    .hero-actions a { width: 100%; justify-content: center; }
    .hero-loop { grid-template-columns: 1fr; }
    .loop-step + .loop-step { border-left: 0; border-top: 1px solid var(--border-subtle); }
    .loop-arrow { transform: rotate(90deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-step { transition: none; }
  }
</style>
