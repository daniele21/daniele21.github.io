---
/**
 * LandingHero.astro
 * Premium single-column hero: compact identity strip + full-width mission.
 * Keeps the personal context visible without competing with the core Local AI thesis.
 */
import { landingData } from '../../content/locales/en/landing';

const { hero } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <div class="identity-strip" aria-label="Professional identity">
      <div class="identity-main">
        <span class="identity-name">{hero.identity.name}</span>
        <span class="identity-role">{hero.identity.role} · {hero.identity.specialization}</span>
      </div>

      <div class="identity-meta">
        <span class="identity-location">{hero.identity.location}</span>
        <a class="identity-about" href={resolveHref('/about')}>
          About
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero-main">
      <div class="hero-eyebrow-row">
        <span class="hero-signal" aria-hidden="true"></span>
        <p class="hero-eyebrow">{hero.mission.eyebrow}</p>
      </div>

      <h1 id="hero-title" class="hero-heading">
        <span>{hero.mission.title}</span>
        <span class="hero-highlight">{hero.mission.titleHighlight}</span>
      </h1>

      <p class="hero-challenge">{hero.mission.challenge}</p>
      <p class="hero-explanation">{hero.mission.explanation}</p>

      <div class="hero-position">
        <span class="position-line" aria-hidden="true"></span>
        <p>{hero.mission.position}</p>
      </div>

      <div class="hero-actions">
        <a class="primary-button hero-primary-cta" href={resolveHref(hero.mission.primaryCta.href)}>
          <span>{hero.mission.primaryCta.label}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <nav class="method-strip" aria-label="Research method">
      <span class="method-step is-active"><span class="step-index">01</span> DECIDE</span>
      <span class="method-arrow" aria-hidden="true">→</span>
      <span class="method-step"><span class="step-index">02</span> BUILD</span>
      <span class="method-arrow" aria-hidden="true">→</span>
      <span class="method-step"><span class="step-index">03</span> TEST</span>
      <span class="method-arrow" aria-hidden="true">→</span>
      <span class="method-step"><span class="step-index">04</span> MEASURE</span>
    </nav>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    overflow: clip;
    padding: clamp(34px, 4.5vw, 62px) 0 clamp(44px, 6vw, 76px);
    background:
      radial-gradient(ellipse 62% 48% at 76% 18%, rgba(20, 91, 255, 0.075), transparent 72%),
      radial-gradient(ellipse 48% 48% at 12% 88%, rgba(124, 58, 237, 0.04), transparent 64%),
      linear-gradient(155deg, #ffffff 0%, #f8fafe 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(20, 91, 255, 0.027) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(20, 91, 255, 0.027) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 78% 66% at 52% 42%, black 16%, transparent 88%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .identity-strip {
    min-height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: 0 0 clamp(18px, 2vw, 24px);
    border-bottom: 1px solid color-mix(in srgb, var(--border-medium) 78%, transparent);
  }

  .identity-main,
  .identity-meta {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .identity-main {
    gap: clamp(12px, 2vw, 22px);
    flex-wrap: wrap;
  }

  .identity-meta {
    gap: clamp(16px, 2.4vw, 28px);
    flex-shrink: 0;
  }

  .identity-name {
    font-family: var(--font-display);
    font-size: clamp(0.84rem, 0.92vw, 0.98rem);
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-display);
  }

  .identity-role,
  .identity-location {
    font-size: 0.84rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  .identity-role {
    font-weight: 620;
  }

  .identity-location {
    font-family: var(--font-display);
    font-size: var(--text-badge);
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .identity-about {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border-radius: var(--radius-sm);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 760;
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .identity-about:hover {
    color: var(--accent-blue);
    background: color-mix(in srgb, var(--surface-card) 76%, transparent);
    transform: translateX(2px);
  }

  .hero-main {
    max-width: 1040px;
    padding: clamp(48px, 7vw, 90px) 0 clamp(34px, 4.5vw, 56px);
  }

  .hero-eyebrow-row {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(12px, 1.5vw, 18px);
  }

  .hero-signal {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent-blue) 10%, transparent);
  }

  .hero-eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue-dark);
  }

  .hero-heading {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.2em;
    margin: 0 0 clamp(18px, 2.2vw, 28px);
    max-width: 1100px;
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 8.2vw, 7.4rem);
    line-height: 0.94;
    letter-spacing: -0.067em;
    font-weight: 860;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .hero-highlight {
    position: relative;
    color: var(--accent-blue);
  }

  .hero-highlight::after {
    content: '';
    position: absolute;
    left: 0.03em;
    right: 0;
    bottom: -0.065em;
    height: 0.04em;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--accent-blue), color-mix(in srgb, var(--accent-blue) 38%, transparent));
  }

  .hero-challenge {
    max-width: 790px;
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.32rem, 2.15vw, 2rem);
    line-height: 1.24;
    font-weight: 760;
    letter-spacing: -0.025em;
    color: var(--ink-display);
  }

  .hero-explanation {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.16rem);
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .hero-position {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(18px, 2vw, 26px);
  }

  .position-line {
    width: 34px;
    height: 1px;
    flex: 0 0 auto;
    background: var(--accent-blue);
  }

  .hero-position p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    margin-top: clamp(24px, 3vw, 34px);
  }

  .hero-primary-cta {
    min-height: 48px;
    padding-inline: 18px;
    gap: 10px;
  }

  .method-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(8px, 1.3vw, 16px);
    padding-top: clamp(18px, 2vw, 24px);
    border-top: 1px solid color-mix(in srgb, var(--border-medium) 78%, transparent);
  }

  .method-step,
  .method-arrow {
    font-family: var(--font-display);
  }

  .method-step {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 760;
    letter-spacing: 0.045em;
  }

  .method-step.is-active {
    color: var(--accent-blue-dark);
  }

  .step-index {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border-medium);
    border-radius: 50%;
    color: var(--ink-display);
    font-size: var(--text-badge);
    font-weight: 820;
    background: color-mix(in srgb, var(--surface-card) 86%, transparent);
  }

  .method-step.is-active .step-index {
    border-color: color-mix(in srgb, var(--accent-blue) 38%, var(--border-medium));
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
  }

  .method-arrow {
    color: var(--ink-subtle);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .hero-section {
      min-height: auto;
      padding-top: 24px;
    }

    .identity-strip {
      align-items: flex-start;
    }

    .identity-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
    }

    .identity-meta {
      gap: 8px;
    }

    .identity-location {
      display: none;
    }

    .hero-main {
      padding-top: clamp(42px, 8vw, 64px);
    }

    .hero-heading {
      font-size: clamp(3rem, 13vw, 5.4rem);
      line-height: 0.96;
    }
  }

  @media (max-width: 560px) {
    .hero-section {
      padding-bottom: 36px;
    }

    .identity-strip {
      gap: 12px;
    }

    .identity-role {
      max-width: 240px;
    }

    .identity-about {
      padding-inline: 6px;
    }

    .hero-main {
      padding-bottom: 30px;
    }

    .hero-heading {
      font-size: clamp(2.7rem, 14vw, 4.15rem);
      letter-spacing: -0.058em;
    }

    .hero-challenge {
      font-size: 1.22rem;
    }

    .method-strip {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 12px;
    }

    .method-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .identity-about,
    .hero-primary-cta {
      transition: none;
    }
  }
</style>
