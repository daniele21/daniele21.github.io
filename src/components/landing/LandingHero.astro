---
/**
 * LandingHero.astro
 * Premium single-column hero focused on the core Local AI thesis.
 * Professional identity lives in the persistent landing header.
 */
import { landingData } from '../../content/locales/en/landing';

const { hero } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <div class="hero-main">
      <div class="hero-eyebrow-row">
        <span class="hero-signal" aria-hidden="true"></span>
        <p class="hero-eyebrow">{hero.mission.eyebrow}</p>
      </div>

      <h1 id="hero-title" class="hero-heading">
        <span>{hero.mission.title}</span>
        <span class="hero-highlight">{hero.mission.titleHighlight}</span>
      </h1>

      <p class="hero-challenge">{hero.mission.challenge}</p>
      <p class="hero-explanation" set:html={hero.mission.explanation} />

      <div class="hero-position">
        <p>{hero.mission.position}</p>
      </div>

      <div class="hero-actions">
        <a class="primary-button hero-primary-cta" href={resolveHref(hero.mission.primaryCta.href)}>
          <span>{hero.mission.primaryCta.label}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <nav class="method-strip" aria-label="Research method">
      <span class="method-step is-active"><span class="step-index">01</span> DECIDE</span>
      <span class="method-arrow" aria-hidden="true">→</span>
      <span class="method-step"><span class="step-index">02</span> BUILD</span>
      <span class="method-arrow" aria-hidden="true">→</span>
      <span class="method-step"><span class="step-index">03</span> TEST</span>
      <span class="method-arrow" aria-hidden="true">→</span>
      <span class="method-step"><span class="step-index">04</span> MEASURE</span>
    </nav>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    overflow: clip;
    padding: clamp(34px, 4.5vw, 62px) 0 clamp(44px, 6vw, 76px);
    background:
      radial-gradient(ellipse 62% 48% at 76% 18%, rgba(20, 91, 255, 0.075), transparent 72%),
      radial-gradient(ellipse 48% 48% at 12% 88%, rgba(124, 58, 237, 0.04), transparent 64%),
      linear-gradient(155deg, #ffffff 0%, #f8fafe 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(20, 91, 255, 0.027) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(20, 91, 255, 0.027) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 78% 66% at 52% 42%, black 16%, transparent 88%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .hero-main {
    max-width: 1040px;
    padding: clamp(48px, 7vw, 90px) 0 clamp(34px, 4.5vw, 56px);
  }

  .hero-eyebrow-row {
    display: flex;
    align-items: center;
    width: fit-content;
    gap: 9px;
    margin-bottom: clamp(12px, 1.5vw, 18px);
  }

  .hero-signal {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent-blue) 10%, transparent);
  }

  .hero-eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue-dark);
  }

  .hero-heading {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: nowrap;
    gap: 0.28em;
    margin: 0 0 clamp(18px, 2.2vw, 28px);
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4.35vw, 4.35rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
    font-weight: 860;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .hero-heading::after {
    content: '';
    position: absolute;
    left: 0.03em;
    right: 0;
    bottom: -0.065em;
    height: 0.04em;
    border-radius: 99px;
    background: linear-gradient(
      90deg,
      var(--ink-display) 0%,
      var(--accent-blue-dark) 42%,
      var(--accent-blue) 75%,
      color-mix(in srgb, var(--accent-blue) 38%, transparent) 100%
    );
  }

  .hero-highlight {
    color: var(--accent-blue);
  }

  .hero-challenge {
    max-width: 790px;
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.32rem, 2.15vw, 2rem);
    line-height: 1.24;
    font-weight: 760;
    letter-spacing: -0.025em;
    color: var(--ink-display);
  }

  .hero-explanation {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.16rem);
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .hero-explanation :global(strong) {
    color: var(--ink-display);
    font-weight: 740;
  }

  .hero-position {
    margin-top: clamp(18px, 2vw, 26px);
  }

  .hero-position p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    margin-top: clamp(24px, 3vw, 34px);
  }

  .hero-primary-cta {
    min-height: 48px;
    padding-inline: 18px;
    gap: 10px;
  }

  .method-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(8px, 1.3vw, 16px);
    padding-top: clamp(18px, 2vw, 24px);
    border-top: 1px solid color-mix(in srgb, var(--border-medium) 78%, transparent);
  }

  .method-step,
  .method-arrow {
    font-family: var(--font-display);
  }

  .method-step {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 760;
    letter-spacing: 0.045em;
  }

  .method-step.is-active {
    color: var(--accent-blue-dark);
  }

  .step-index {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border-medium);
    border-radius: 50%;
    color: var(--ink-display);
    font-size: var(--text-badge);
    font-weight: 820;
    background: color-mix(in srgb, var(--surface-card) 86%, transparent);
  }

  .method-step.is-active .step-index {
    border-color: color-mix(in srgb, var(--accent-blue) 38%, var(--border-medium));
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
  }

  .method-arrow {
    color: var(--ink-subtle);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .hero-section {
      min-height: auto;
      padding-top: 24px;
    }

    .hero-main {
      padding-top: clamp(42px, 8vw, 64px);
    }

    .hero-heading {
      font-size: clamp(1.65rem, 5vw, 2.8rem);
      line-height: 1.12;
    }
  }

  @media (max-width: 560px) {
    .hero-section {
      padding-bottom: 36px;
    }

    .hero-main {
      padding-bottom: 30px;
    }

    .hero-heading {
      flex-wrap: wrap;
      white-space: normal;
      font-size: clamp(1.85rem, 8vw, 2.4rem);
      letter-spacing: -0.045em;
      line-height: 1.15;
    }

    .hero-challenge {
      font-size: 1.22rem;
    }

    .method-strip {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 12px;
    }

    .method-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-primary-cta {
      transition: none;
    }
  }
</style>
