---
/**
 * LandingHero.astro
 * Experiment-first hero: keep the Local AI thesis, make the practical value
 * explicit, and offer both a workload conversation and the evidence path.
 */
import { landingData } from '../../content/locales/en/landing';

const { hero } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};

const githubUrl = hero.identity.socials?.find((link) => link.platform === 'github')?.href ?? 'https://github.com/daniele21';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <div class="hero-main">
      <h1 id="hero-title" class="hero-heading">
        <span>{hero.mission.title}</span>
        <span class="hero-highlight">{hero.mission.titleHighlight}</span>
      </h1>

      <p class="hero-challenge">{hero.mission.challenge}</p>
      <p class="hero-explanation" set:html={hero.mission.explanation} />

      {hero.mission.position && (
        <div class="hero-position">
          <p>{hero.mission.position}</p>
        </div>
      )}

      <div class="hero-actions">
        <button
          type="button"
          class="primary-button hero-primary-cta"
          data-open-contact-modal
          aria-label="Discuss an AI workload"
        >
          <span>{hero.mission.primaryCta.label}</span>
          <span aria-hidden="true">→</span>
        </button>

        <a class="secondary-button hero-secondary-cta" href={resolveHref(hero.mission.secondaryCta.href)}>
          <span>{hero.mission.secondaryCta.label}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="hero-trust" aria-label="Professional proof">
      <span class="trust-role">{hero.identity.role}</span>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">
        Open-source systems <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    overflow: clip;
    padding: clamp(34px, 4.5vw, 62px) 0 clamp(44px, 6vw, 76px);
    background:
      radial-gradient(ellipse 62% 48% at 76% 18%, rgba(20, 91, 255, 0.075), transparent 72%),
      radial-gradient(ellipse 48% 40% at 12% 70%, rgba(124, 58, 237, 0.035), transparent 64%),
      linear-gradient(180deg, var(--surface-canvas) 0%, var(--surface-subtle) 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent-blue) 2.7%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent-blue) 2.7%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 78% 66% at 52% 42%, black 16%, transparent 88%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .hero-main {
    max-width: 1040px;
    padding: clamp(52px, 7vw, 92px) 0 clamp(34px, 4.5vw, 54px);
  }

  .hero-heading {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: nowrap;
    gap: 0.28em;
    margin: 0 0 clamp(18px, 2.2vw, 28px);
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4.35vw, 4.35rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
    font-weight: 860;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .hero-heading::after {
    content: '';
    position: absolute;
    left: 0.03em;
    right: 0;
    bottom: -0.065em;
    height: 0.04em;
    border-radius: 99px;
    background: linear-gradient(
      90deg,
      var(--ink-display) 0%,
      var(--accent-blue-dark) 42%,
      var(--accent-blue) 75%,
      color-mix(in srgb, var(--accent-blue) 38%, transparent) 100%
    );
  }

  .hero-highlight {
    color: var(--accent-blue);
  }

  .hero-challenge {
    max-width: 790px;
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.32rem, 2.15vw, 2rem);
    line-height: 1.24;
    font-weight: 760;
    letter-spacing: -0.025em;
    color: var(--ink-display);
  }

  .hero-explanation {
    max-width: 900px;
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.16rem);
    line-height: 1.58;
    color: var(--ink-muted);
  }

  .hero-explanation :global(strong) {
    color: var(--ink-display);
    font-weight: 740;
  }

  .hero-position {
    margin-top: clamp(18px, 2vw, 26px);
  }

  .hero-position p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 34px);
  }

  .hero-primary-cta,
  .hero-secondary-cta {
    min-height: 48px;
    padding-inline: 18px;
    gap: 10px;
  }

  .hero-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px clamp(20px, 3vw, 34px);
    padding-top: clamp(17px, 2vw, 22px);
    border-top: 1px solid color-mix(in srgb, var(--border-medium) 78%, transparent);
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .trust-role {
    color: var(--ink);
    font-weight: 690;
  }

  .hero-trust a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink-muted);
    font-weight: 650;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .hero-trust a:hover,
  .hero-trust a:focus-visible {
    color: var(--accent-blue-dark);
  }

  @media (max-width: 820px) {
    .hero-section {
      min-height: auto;
      padding-top: 24px;
    }

    .hero-main {
      padding-top: clamp(42px, 8vw, 64px);
    }

    .hero-heading {
      font-size: clamp(1.65rem, 5vw, 2.8rem);
      line-height: 1.12;
    }
  }

  @media (max-width: 560px) {
    .hero-section {
      padding-bottom: 36px;
    }

    .hero-main {
      padding-bottom: 30px;
    }

    .hero-heading {
      flex-wrap: wrap;
      white-space: normal;
      font-size: clamp(1.85rem, 8vw, 2.4rem);
      letter-spacing: -0.045em;
      line-height: 1.15;
    }

    .hero-challenge {
      font-size: 1.22rem;
    }

    .hero-actions {
      align-items: stretch;
    }

    .hero-primary-cta,
    .hero-secondary-cta {
      width: 100%;
      justify-content: center;
    }

    .hero-trust {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-primary-cta,
    .hero-secondary-cta,
    .hero-trust a {
      transition: none;
    }
  }
</style>
