---
/**
 * LandingHero.astro
 * Two-column hero: 1/3 Identity Anchor + 2/3 Strategic Research Mission.
 */
import { landingData } from '../../content/locales/en/landing';

const { hero } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <!-- Identity Column (1/3) -->
    <aside class="hero-identity-card" aria-label="Author identity">
      <div class="portrait-frame">
        <img
          src={asset(hero.identity.portraitPath)}
          alt={hero.identity.portraitAlt}
          width="130"
          height="130"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="identity-info">
        <p class="identity-greeting">Hi, I'm <strong class="identity-name">{hero.identity.name}</strong></p>
        <p class="identity-role">{hero.identity.role}</p>
        <p class="identity-bio">{hero.identity.bio}</p>
      </div>
    </aside>

    <!-- Mission Column (2/3) -->
    <div class="hero-mission-card">
      <p class="hero-eyebrow">{hero.mission.eyebrow}</p>
      <p class="hero-lead">{hero.mission.lead}</p>

      <h1 id="hero-title" class="hero-heading">
        {hero.mission.title} <span class="hero-highlight">{hero.mission.titleHighlight}</span>
      </h1>

      <p class="hero-challenge">{hero.mission.challenge}</p>
      <p class="hero-explanation">{hero.mission.explanation}</p>

      <div class="hero-stance">
        <p class="stance-position"><strong>{hero.mission.position}</strong></p>
        <p class="stance-proof">{hero.mission.proofLine}</p>
      </div>

      <div class="hero-actions">
        <a class="primary-button hero-primary-cta" href={resolveHref(hero.mission.primaryCta.href)}>
          {hero.mission.primaryCta.label} <span aria-hidden="true">↓</span>
        </a>
        <a class="secondary-button hero-secondary-cta" href={resolveHref(hero.mission.secondaryCta.href)}>
          {hero.mission.secondaryCta.label} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    padding: clamp(54px, 7vw, 96px) 0;
    overflow: clip;
    background:
      radial-gradient(circle at 82% 22%, rgba(20, 91, 255, 0.11), transparent 31%),
      linear-gradient(145deg, #ffffff 0%, #f6f8fd 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(20, 91, 255, 0.04) 1px, transparent 1px);
    background-size: 100% 92px;
    mask-image: linear-gradient(90deg, transparent, black 35%, black 85%, transparent);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 350px);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }

  /* Identity Column */
  .hero-identity-card {
    order: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: clamp(24px, 3vw, 34px);
    background: var(--ink-display);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    box-shadow: 0 30px 80px rgba(8, 19, 51, 0.2);
  }

  .portrait-frame {
    width: 164px;
    height: 190px;
    border-radius: 22px;
    overflow: hidden;
    margin-bottom: var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.24);
    background: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .identity-greeting {
    font-size: var(--text-body);
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 var(--space-1);
  }

  .identity-name {
    font-family: var(--font-display);
    color: var(--ink-inverse);
    font-weight: 800;
  }

  .identity-role {
    font-size: var(--text-caption);
    font-weight: 700;
    color: #9dbbff;
    margin: 0 0 var(--space-3);
  }

  .identity-bio {
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.55;
    margin: 0;
  }

  /* Mission Column */
  .hero-mission-card {
    order: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
  }

  .hero-eyebrow {
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue);
    margin: 0 0 var(--space-2);
  }

  .hero-lead {
    font-size: var(--text-lead);
    font-weight: 700;
    color: var(--ink-display);
    margin: 0 0 var(--space-1);
  }

  .hero-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    max-width: 840px;
    font-size: clamp(3rem, 5.4vw, 5.35rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 800;
    color: var(--ink-display);
  }

  .hero-highlight {
    color: var(--accent-blue);
    display: inline-block;
  }

  .hero-challenge {
    font-family: var(--font-display);
    max-width: 720px;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }

  .hero-explanation {
    max-width: 700px;
    font-size: var(--text-body);
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }

  .hero-stance {
    max-width: 700px;
    padding: 2px 0 2px var(--space-4);
    border-left: 3px solid var(--accent-blue);
    margin-bottom: var(--space-5);
  }

  .stance-position {
    font-family: var(--font-display);
    font-size: var(--text-body);
    color: var(--accent-blue-dark);
    margin: 0 0 var(--space-1);
  }

  .stance-proof {
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .hero-section { min-height: auto; }

    .hero-shell {
      grid-template-columns: 1fr;
    }

    .hero-identity-card {
      flex-direction: row;
      text-align: left;
      gap: var(--space-4);
      align-items: center;
      padding: var(--space-5);
    }

    .portrait-frame {
      margin-bottom: 0;
      width: 104px;
      height: 116px;
    }
  }

  @media (max-width: 600px) {
    .hero-section {
      padding: 38px 0 44px;
    }

    .hero-shell {
      display: block;
    }

    .hero-identity-card {
      position: absolute;
      top: -8px;
      right: 0;
      width: 68px;
      padding: 0;
      background: transparent;
      border: 0;
      box-shadow: none;
    }

    .portrait-frame {
      width: 68px;
      height: 68px;
      margin: 0;
      border: 3px solid var(--surface-canvas);
      border-radius: 50%;
      box-shadow: 0 10px 26px rgba(8, 19, 51, 0.18);
    }

    .identity-info { display: none; }

    .hero-eyebrow,
    .hero-lead {
      max-width: calc(100% - 82px);
    }

    .hero-heading { font-size: clamp(2.65rem, 13vw, 4rem); }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions a {
      width: 100%;
    }
  }
</style>
