---
/**
 * LandingHero.astro
 * Hero Section: Identity Anchor (Left) + Strategic Research Mission (Right).
 * Designed for immediate clarity: Who Daniele is + What the research seeks to solve.
 */
import { landingData } from '../../content/locales/en/landing';

const { hero } = landingData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
const resolveHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <!-- LEFT COLUMN: Identity Anchor (~32%) -->
    <aside class="hero-identity-card" aria-label="Author identity & background">
      <div class="identity-header">
        <div class="portrait-container">
          <div class="portrait-frame">
            <img
              src={asset(hero.identity.portraitPath)}
              alt={hero.identity.portraitAlt}
              width="100"
              height="115"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="identity-lead-info">
          <h2 class="identity-name">{hero.identity.name}</h2>
          <p class="identity-role">{hero.identity.role}</p>
        </div>
      </div>

      <!-- Bio statement -->
      <p class="identity-bio">{hero.identity.bio}</p>

      <!-- Social & Professional Action Links -->
      <div class="identity-social-actions">
        {hero.identity.socials?.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`social-button social-${social.platform}`}
            aria-label={social.label}
          >
            {social.platform === 'linkedin' && (
              <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.66 1.66 0 0 0-1.67 1.66 1.66 1.66 0 0 0 1.67-1.66A1.66 1.66 0 0 0 7.83 6.2z"/>
              </svg>
            )}
            {social.platform === 'github' && (
              <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
              </svg>
            )}
            <span class="social-text">{social.label}</span>
            <span class="external-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </aside>

    <!-- RIGHT COLUMN: Research Mission (~68%) -->
    <div class="hero-mission-card">
      <div class="hero-eyebrow-container">
        <span class="pulse-beacon" aria-hidden="true"></span>
        <p class="hero-eyebrow">{hero.mission.eyebrow}</p>
      </div>

      <h1 id="hero-title" class="hero-heading">
        <span class="hero-title-nowrap">{hero.mission.title} <span class="hero-highlight">{hero.mission.titleHighlight}</span></span>
      </h1>

      <p class="hero-challenge">{hero.mission.challenge}</p>
      <p class="hero-explanation">{hero.mission.explanation}</p>

      <!-- Stance / Hypothesis Box -->
      <div class="hero-stance-card">
        <div class="stance-header">
          <p class="stance-position"><strong>{hero.mission.position}</strong></p>
        </div>
        
        <div class="stance-loop-indicator" aria-label="Research loop progression: Decide, Build, Test, Measure">
          <span class="loop-step is-active"><span class="step-num">01</span> Decide</span>
          <span class="loop-arrow" aria-hidden="true">→</span>
          <span class="loop-step"><span class="step-num">02</span> Build</span>
          <span class="loop-arrow" aria-hidden="true">→</span>
          <span class="loop-step"><span class="step-num">03</span> Test</span>
          <span class="loop-arrow" aria-hidden="true">→</span>
          <span class="loop-step"><span class="step-num">04</span> Measure</span>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="hero-actions">
        <a class="primary-button hero-primary-cta" href={resolveHref(hero.mission.primaryCta.href)}>
          <span>{hero.mission.primaryCta.label}</span>
          <span class="cta-arrow" aria-hidden="true">↓</span>
        </a>
        <a class="secondary-button hero-secondary-cta" href={resolveHref(hero.mission.secondaryCta.href)}>
          <span>{hero.mission.secondaryCta.label}</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    padding: clamp(48px, 6vw, 84px) 0;
    overflow: clip;
    background:
      radial-gradient(ellipse 65% 55% at 75% 20%, rgba(20, 91, 255, 0.08), transparent 70%),
      radial-gradient(ellipse 50% 50% at 15% 85%, rgba(124, 58, 237, 0.05), transparent 60%),
      linear-gradient(155deg, #ffffff 0%, #f7f9fd 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(20, 91, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(20, 91, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 20%, transparent 85%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  /* ==========================================================================
     IDENTITY CARD (LEFT COLUMN)
     ========================================================================== */
  .hero-identity-card {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2vw, 26px);
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgba(8, 19, 51, 0.04);
    position: relative;
    overflow: hidden;
  }

  .identity-header {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .portrait-container {
    display: flex;
    flex-shrink: 0;
  }

  .portrait-frame {
    width: 68px;
    height: 76px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4px 12px rgba(8, 19, 51, 0.08);
    background: var(--surface-subtle);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .identity-lead-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .identity-name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    color: var(--ink-display);
    font-weight: 800;
    margin: 0 0 2px;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .identity-role {
    font-size: 0.82rem;
    font-weight: 650;
    color: var(--accent-blue-dark);
    line-height: 1.35;
    margin: 0;
  }

  /* Bio */
  .identity-bio {
    font-size: 0.88rem;
    color: var(--ink-muted);
    line-height: 1.55;
    margin: 0 0 var(--space-4);
  }

  /* Social Actions */
  .identity-social-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
  }

  .social-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
    cursor: pointer;
    min-height: 38px;
  }

  .social-linkedin {
    flex: 1;
    background: var(--surface-subtle);
    color: var(--ink-display);
    border: 1px solid var(--border-medium);
  }

  .social-linkedin:hover {
    background: var(--surface-card);
    border-color: var(--border-strong);
    color: var(--accent-blue-dark);
    transform: translateY(-1px);
  }

  .social-github {
    flex: 1;
    background: var(--surface-subtle);
    color: var(--ink-display);
    border: 1px solid var(--border-medium);
  }

  .social-github:hover {
    background: var(--surface-card);
    border-color: var(--border-strong);
    color: var(--accent-blue-dark);
    transform: translateY(-1px);
  }

  .external-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
    transition: transform var(--duration-fast) ease;
  }

  .social-button:hover .external-arrow {
    transform: translate(1px, -1px);
    opacity: 1;
  }

  /* ==========================================================================
     MISSION CARD (RIGHT COLUMN)
     ========================================================================== */
  .hero-mission-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    container-type: inline-size;
  }

  .hero-eyebrow-container {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-2);
  }

  .pulse-beacon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 0 0 rgba(20, 91, 255, 0.7);
    animation: pulseGlow 2s infinite cubic-bezier(0.66, 0, 0, 1);
  }

  @keyframes pulseGlow {
    0% {
      box-shadow: 0 0 0 0 rgba(20, 91, 255, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(20, 91, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(20, 91, 255, 0);
    }
  }

  .hero-eyebrow {
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-blue);
    margin: 0;
  }

  .hero-lead {
    font-size: var(--text-lead);
    font-weight: 700;
    color: var(--ink-display);
    margin: 0 0 var(--space-1);
  }

  .hero-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 5.1cqw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--ink-display);
    white-space: nowrap !important;
    overflow: visible;
  }

  .hero-title-nowrap {
    display: inline-block;
    white-space: nowrap !important;
  }

  .hero-highlight {
    color: var(--accent-blue);
    display: inline !important;
    white-space: nowrap !important;
  }

  .hero-challenge {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.45vw, 1.35rem);
    font-weight: 700;
    color: var(--ink-display);
    margin: 0 0 var(--space-2);
    line-height: 1.35;
  }

  .hero-explanation {
    font-size: var(--text-lead);
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
    max-width: 680px;
  }

  /* Stance Box */
  .hero-stance-card {
    background: linear-gradient(135deg, rgba(240, 245, 255, 0.85) 0%, rgba(255, 255, 255, 0.95) 100%);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent-blue);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
    box-shadow: 0 4px 18px rgba(20, 91, 255, 0.05);
    max-width: 720px;
  }

  .stance-header {
    margin-bottom: var(--space-3);
  }

  .stance-position {
    font-family: var(--font-display);
    font-size: 1.08rem;
    color: var(--ink-display);
    margin: 0;
  }

  .stance-loop-indicator {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border-medium);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--ink-subtle);
  }

  .loop-step {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink);
  }

  .loop-step.is-active {
    color: var(--accent-blue-dark);
    font-weight: 800;
  }

  .step-num {
    font-size: var(--text-badge);
    opacity: 0.75;
    font-family: var(--font-mono);
  }

  .loop-arrow {
    color: var(--border-strong);
    font-size: var(--text-badge);
  }

  /* CTAs */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .hero-primary-cta {
    padding: 12px 26px;
    font-size: 0.95rem;
  }

  .hero-secondary-cta {
    padding: 12px 24px;
    font-size: 0.95rem;
  }

  .cta-arrow {
    transition: transform var(--duration-fast) ease;
  }

  .hero-primary-cta:hover .cta-arrow {
    transform: translateY(2px);
  }

  .hero-secondary-cta:hover .cta-arrow {
    transform: translateX(2px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .hero-section {
      min-height: auto;
      padding: 40px 0 56px;
    }

    .hero-shell {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero-identity-card {
      order: 1;
      max-width: 580px;
    }

    .hero-mission-card {
      order: 2;
    }
  }

  @media (max-width: 540px) {
    .hero-section {
      padding: 28px 0 44px;
    }

    .identity-header {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .portrait-frame {
      width: 60px;
      height: 68px;
      border-radius: 10px;
    }

    .identity-name {
      font-size: 1.15rem;
    }

    .identity-social-actions {
      flex-direction: row;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions a {
      width: 100%;
    }
  }
</style>
