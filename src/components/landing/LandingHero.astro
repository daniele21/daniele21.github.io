---
/** Homepage hero: clear positioning first, Local AI thesis second. */
---

<section class="hero-section" id="top" aria-labelledby="hero-title">
  <div class="shell hero-shell">
    <div class="hero-main">
      <h1 id="hero-title" class="hero-heading">
        I help teams decide where AI should run — and prove it works.
      </h1>

      <p class="hero-explanation">
        I design and test <strong>GenAI systems</strong> across <strong>Local</strong>, <strong>Hybrid</strong>, and <strong>Cloud</strong>, based on privacy, control, performance and real product constraints.
      </p>

      <p class="hero-thesis">Local AI first ≠ Local AI only.</p>

      <div class="hero-actions">
        <button
          type="button"
          class="primary-button hero-primary-cta"
          data-open-contact-modal
          aria-label="Discuss an AI workload"
        >
          <span>Discuss a workload</span>
          <span aria-hidden="true">→</span>
        </button>
        <a class="hero-secondary-cta" href="#strategy">
          <span>See how I work</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    overflow: clip;
    padding: clamp(42px, 6vw, 78px) 0;
    background:
      radial-gradient(ellipse 62% 48% at 76% 18%, rgba(20, 91, 255, 0.075), transparent 72%),
      radial-gradient(ellipse 48% 48% at 12% 88%, rgba(124, 58, 237, 0.04), transparent 64%),
      linear-gradient(155deg, var(--surface-canvas) 0%, var(--surface-subtle) 100%);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent-blue) 2.7%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent-blue) 2.7%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 78% 66% at 52% 42%, black 16%, transparent 88%);
  }

  .hero-shell {
    position: relative;
    z-index: 1;
  }

  .hero-main {
    max-width: 1000px;
    padding: clamp(40px, 7vw, 88px) 0;
  }

  .hero-heading {
    max-width: 980px;
    margin: 0 0 clamp(20px, 2.6vw, 30px);
    font-family: var(--font-display);
    font-size: clamp(2.45rem, 5.4vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.06em;
    font-weight: 860;
    color: var(--ink-display);
    text-wrap: balance;
  }

  .hero-explanation {
    max-width: 780px;
    margin: 0;
    font-size: clamp(1.06rem, 1.45vw, 1.22rem);
    line-height: 1.62;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .hero-explanation strong {
    color: var(--ink-display);
    font-weight: 720;
  }

  .hero-thesis {
    width: fit-content;
    margin: clamp(20px, 2.5vw, 28px) 0 0;
    padding-bottom: 5px;
    border-bottom: 2px solid color-mix(in srgb, var(--accent-blue) 58%, transparent);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.55vw, 1.28rem);
    line-height: 1.35;
    font-weight: 760;
    letter-spacing: -0.02em;
    color: var(--ink-display);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(28px, 3.5vw, 40px);
  }

  .hero-primary-cta {
    min-height: 48px;
    padding-inline: 18px;
    gap: 9px;
    cursor: pointer;
  }

  .hero-secondary-cta {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .hero-secondary-cta:hover,
  .hero-secondary-cta:focus-visible {
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
  }

  @media (max-width: 820px) {
    .hero-section { min-height: auto; }
    .hero-main { padding: clamp(58px, 10vw, 88px) 0; }
    .hero-heading {
      max-width: 760px;
      font-size: clamp(2.2rem, 8vw, 3.7rem);
      line-height: 1.04;
    }
  }

  @media (max-width: 560px) {
    .hero-section { padding: 22px 0 36px; }
    .hero-main { padding: 50px 0 42px; }
    .hero-heading {
      font-size: clamp(2rem, 10vw, 2.8rem);
      letter-spacing: -0.05em;
    }
    .hero-actions { align-items: stretch; }
    .hero-primary-cta,
    .hero-secondary-cta { justify-content: center; }
  }
</style>
