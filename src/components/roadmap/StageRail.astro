---
/**
 * StageRail -Numbered badge + vertical rail line for each roadmap stage.
 *
 * Uses PURE CSS for the vertical line (no SVG, zero distortion).
 * Positioned at 4% left or 4% right to match FlowTransition endpoints.
 *
 * @prop number  -Stage number displayed in the badge (1–4)
 * @prop side    -"left" or "right" positioning
 * @prop isFinal -If true, adds a terminal footer dot at the bottom
 */
interface Props {
  number: number;
  side: 'left' | 'right';
  isFinal?: boolean;
}

const { number, side, isFinal = false } = Astro.props;
const isFirst = number === 1;
---

<div class={`stage-rail rail-${side}`} aria-hidden="true">
  <!-- Pure CSS vertical line -cannot be distorted -->
  <div class={`rail-line ${isFirst ? 'line-first' : ''} ${isFinal ? 'line-final' : ''}`}>
    <div class="rail-glow"></div>
    <div class="rail-pulse"></div>
  </div>

  <!-- Numbered Stage Badge -->
  <span class="stage-badge">{number}</span>

  {isFinal && <span class="rail-foot"></span>}
</div>

<style>
  .stage-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 7;
    pointer-events: none;
  }

  /* Positioned at exactly 4% from edge -matches FlowTransition SVG x=40/960 */
  .rail-left { left: 4%; }
  .rail-right { right: 4%; }

  /* ---- Pure CSS vertical line ---- */
  .rail-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    transform: translateX(-50%);
    background: #145bff;
    border-radius: 2px;
    overflow: hidden;
    /* Progressive draw animation */
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Stage 1: line starts from badge center */
  .line-first { top: 50px; }

  /* Stage 4: line ends above foot */
  .line-final { bottom: 8px; }

  /* When visible: reveal line top-to-bottom */
  :global(.journey-stage.is-visible) .rail-line {
    clip-path: inset(0 0 0% 0);
  }

  /* Soft ambient glow behind the line */
  .rail-glow {
    position: absolute;
    inset: 0;
    width: 14px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(20, 91, 255, 0.2);
    border-radius: 7px;
    filter: blur(4px);
  }

  /* Animated laser pulse traveling down */
  .rail-pulse {
    position: absolute;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(96, 165, 250, 0.9) 50%,
      transparent
    );
    border-radius: 2px;
    animation: railPulse 3s ease-in-out infinite;
    opacity: 0;
    transition: opacity 0.5s ease 0.8s;
  }

  :global(.journey-stage.is-visible) .rail-pulse {
    opacity: 1;
  }

  @keyframes railPulse {
    0%   { top: -60px; }
    100% { top: calc(100% + 60px); }
  }

  /* ---- Badge ---- */
  .stage-badge {
    position: absolute;
    top: 20px;
    left: 50%;
    width: 54px;
    height: 54px;
    transform: translateX(-50%) scale(0.5);
    opacity: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(180deg, #1f67ff, #084be3);
    border: 5px solid #f4f8ff;
    box-shadow: 0 0 0 2px #c7d8ff, 0 0 20px rgba(20, 91, 255, 0.36);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    z-index: 8;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
                opacity 0.5s ease 0.2s,
                box-shadow 0.3s ease;
  }

  :global(.journey-stage.is-visible) .stage-badge {
    transform: translateX(-50%) scale(1);
    opacity: 1;
  }

  :global(.journey-stage.is-active) .stage-badge {
    box-shadow: 0 0 0 3px #9bbaff,
                0 0 28px rgba(20, 91, 255, 0.6);
  }

  /* ---- Terminal footer dot (Stage 4) ---- */
  .rail-foot {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 28px;
    height: 6px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #d7e4ff;
    box-shadow: 0 4px 14px rgba(20, 91, 255, 0.35);
  }

  /* ---- Responsive ---- */
  @media (max-width: 700px) {
    .stage-rail {
      left: 50% !important;
      right: auto !important;
      bottom: auto;
      height: 60px;
    }
    .rail-line { display: none; }
    .stage-badge {
      top: 4px;
      width: 48px;
      height: 48px;
      font-size: 1.25rem;
      transform: translateX(-50%) scale(1) !important;
      opacity: 1 !important;
    }
  }
</style>
