---
/**
 * StageRail — Numbered badge + vertical SVG rail line for each roadmap stage.
 *
 * Implements the EXACT same multi-layer SVG rendering and progressive animation
 * system as FlowTransition:
 *   1. Track Guide (subtle ambient background track)
 *   2. Track Glow (ambient soft glow)
 *   3. Track Line (progressive drawing line animated on scroll via stroke-dashoffset)
 *   4. Track Pulse (continuous traveling gradient laser beam)
 *
 * Uses the exact same coordinate system (`viewBox="0 0 1000 100"`, x=40 for left, x=960 for right).
 *
 * @prop number  — Stage number displayed in the badge (1–4)
 * @prop side    — "left" (x=40) or "right" (x=960)
 * @prop isFinal — If true, adds a terminal footer cap at the bottom (Stage 4)
 */
interface Props {
  number: number;
  side: 'left' | 'right';
  isFinal?: boolean;
}

const { number, side, isFinal = false } = Astro.props;
const xCoord = side === 'left' ? 40 : 960;
---

<div class={`stage-rail-container rail-${side} stage-rail-${number}`} aria-hidden="true">
  <!-- Full-stage SVG vertical rail line -->
  <svg class="stage-rail-svg" viewBox="0 0 1000 100" preserveAspectRatio="none" fill="none">
    <defs>
      <filter id={`glow-rail-${number}`} x="-20%" y="-80%" width="140%" height="260%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Gradient for vertical traveling laser pulse -->
      <linearGradient id={`grad-rail-${number}`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#145bff" />
        <stop offset="50%" stop-color="#60a5fa" />
        <stop offset="100%" stop-color="#145bff" />
      </linearGradient>
    </defs>

    <!-- 1. Subtle ambient guide track -->
    <line
      class="rail-track-guide"
      x1={xCoord}
      y1="24"
      x2={xCoord}
      y2="100"
      stroke="rgba(20, 91, 255, 0.14)"
      stroke-width="4"
      stroke-linecap="round"
    />

    <!-- 2. Ambient glow behind line -->
    <line
      class="rail-track-glow"
      x1={xCoord}
      y1="24"
      x2={xCoord}
      y2="100"
      stroke="rgba(20, 91, 255, 0.3)"
      stroke-width="14"
      stroke-linecap="round"
    />

    <!-- 3. Progressive drawing line (animates stroke-dashoffset on scroll) -->
    <line
      class="rail-track-line"
      x1={xCoord}
      y1="24"
      x2={xCoord}
      y2="100"
      stroke="#145bff"
      stroke-width="4"
      stroke-linecap="round"
      filter={`url(#glow-rail-${number})`}
    />

    <!-- 4. Animated laser beam traveling along the vertical rail -->
    <line
      class="rail-track-pulse"
      x1={xCoord}
      y1="24"
      x2={xCoord}
      y2="100"
      stroke={`url(#grad-rail-${number})`}
      stroke-width="5"
      stroke-linecap="round"
    />
  </svg>

  <!-- Numbered Stage Badge centered on the exact xCoord -->
  <div class={`stage-badge-wrap badge-pos-${side}`}>
    <span class="stage-badge">{number}</span>
  </div>

  <!-- Terminal footer dot for Stage 4 -->
  {isFinal && (
    <div class={`rail-foot-wrap foot-pos-${side}`}>
      <span class="rail-foot"></span>
    </div>
  )}
</div>

<style>
  .stage-rail-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 7;
  }

  .stage-rail-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
  }

  /* Progressive vertical line drawing animation */
  .rail-track-line {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.journey-stage.is-drawn) .rail-track-line,
  :global(.journey-stage.is-visible) .rail-track-line {
    stroke-dashoffset: 0;
  }

  .rail-track-glow {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  :global(.journey-stage.is-drawn) .rail-track-glow,
  :global(.journey-stage.is-visible) .rail-track-glow {
    opacity: 1;
  }

  /* Moving laser pulse traveling vertically */
  .rail-track-pulse {
    stroke-dasharray: 140 1060;
    animation: pulseTravelVertical 3.5s linear infinite;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  :global(.journey-stage.is-drawn) .rail-track-pulse,
  :global(.journey-stage.is-visible) .rail-track-pulse {
    opacity: 0.9;
  }

  @keyframes pulseTravelVertical {
    0% {
      stroke-dashoffset: 1000;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Badge Wrapper anchored to 4% (x=40) or 96% (x=960) */
  .stage-badge-wrap {
    position: absolute;
    top: 24px;
    transform: translate(-50%, -50%);
    z-index: 8;
  }

  .badge-pos-left {
    left: 4%;
  }

  .badge-pos-right {
    left: 96%;
  }

  /* Numbered Badge styling */
  .stage-badge {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(180deg, #1f67ff, #084be3);
    border: 5px solid #f4f8ff;
    box-shadow: 0 0 0 2px #c7d8ff, 0 0 20px rgba(20, 91, 255, 0.36);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    transform: scale(0.6);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.6s ease,
                box-shadow 0.3s ease;
  }

  :global(.journey-stage.is-visible) .stage-badge {
    transform: scale(1);
    opacity: 1;
  }

  :global(.journey-stage.is-active) .stage-badge {
    transform: scale(1.08);
    box-shadow: 0 0 0 3px #9bbaff,
                0 0 32px rgba(20, 91, 255, 0.65);
  }

  /* Terminal footer dot for Stage 4 */
  .rail-foot-wrap {
    position: absolute;
    bottom: 0;
    transform: translate(-50%, 0);
  }

  .foot-pos-left {
    left: 4%;
  }

  .foot-pos-right {
    left: 96%;
  }

  .rail-foot {
    display: block;
    width: 28px;
    height: 6px;
    border-radius: 50%;
    background: #d7e4ff;
    box-shadow: 0 4px 14px rgba(20, 91, 255, 0.35);
    transform: scale(0);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s;
  }

  :global(.journey-stage.is-visible) .rail-foot {
    transform: scale(1);
  }

  /* ---- Responsive ---- */
  @media (max-width: 700px) {
    .stage-rail-svg {
      display: none;
    }
    .stage-badge-wrap {
      top: 24px;
      left: 50% !important;
    }
    .stage-badge {
      width: 48px;
      height: 48px;
      font-size: 1.25rem;
      transform: scale(1) !important;
      opacity: 1 !important;
    }
  }
</style>
