---
/**
 * FlowTransition — Animated SVG connector line + pill label between roadmap stages.
 *
 * Uses continuous cubic Bézier vector paths with SVG stroke-dashoffset animation
 * so the line draws itself smoothly in real time as the user scrolls.
 *
 * @prop direction — "ltr" (left-to-right) or "rtl" (right-to-left)
 * @prop icon      — Unicode icon displayed in the pill badge
 * @prop label     — Main label text (e.g. "DECIDE → BUILD")
 * @prop sublabel  — Descriptive subtext below the label
 * @prop filterId  — Unique SVG filter ID
 */
interface Props {
  direction: 'ltr' | 'rtl';
  icon: string;
  label: string;
  sublabel: string;
  filterId: string;
}

const { direction, icon, label, sublabel, filterId } = Astro.props;

/**
 * Perfectly smooth cubic Bézier S-curves.
 * Starts at 4% (x=40) and ends at 96% (x=960) out of 1000.
 */
const pathD = direction === 'ltr'
  ? 'M 40,0 L 40,24 C 40,58 70,58 100,58 L 900,58 C 930,58 960,58 960,92 L 960,120'
  : 'M 960,0 L 960,24 C 960,58 930,58 900,58 L 100,58 C 70,58 40,58 40,92 L 40,120';
---

<div class={`flow-transition transition-${direction}`} aria-hidden="true" data-transition>
  <svg class="transition-svg" viewBox="0 0 1000 120" preserveAspectRatio="none" fill="none">
    <defs>
      <filter id={filterId} x="-20%" y="-80%" width="140%" height="260%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <linearGradient id={`grad-${filterId}`} x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#145bff" />
        <stop offset="50%" stop-color="#60a5fa" />
        <stop offset="100%" stop-color="#145bff" />
      </linearGradient>
    </defs>

    <!-- Subtle ambient guide track -->
    <path
      class="track-guide"
      d={pathD}
      fill="none"
      stroke="rgba(20, 91, 255, 0.14)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Ambient glow behind line -->
    <path
      class="track-glow"
      d={pathD}
      fill="none"
      stroke="rgba(20, 91, 255, 0.3)"
      stroke-width="14"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Progressive drawing line (animates stroke-dashoffset on scroll) -->
    <path
      class="track-line"
      d={pathD}
      fill="none"
      stroke="#145bff"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter={`url(#${filterId})`}
    />

    <!-- Animated laser beam traveling along the curve -->
    <path
      class={`track-pulse ${direction === 'ltr' ? 'pulse-ltr' : 'pulse-rtl'}`}
      d={pathD}
      fill="none"
      stroke={`url(#grad-${filterId})`}
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>

  <!-- Transition pill label sitting directly on the horizontal segment -->
  <div class="transition-pill">
    <span class="pill-icon">{icon}</span>
    <div class="pill-text">
      <strong>{label}</strong>
      <small>{sublabel}</small>
    </div>
  </div>
</div>

<style>
  .flow-transition {
    position: relative;
    height: 120px;
    margin: 0;
    padding: 0;
    z-index: 6;
    overflow: visible;
  }

  .transition-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
  }

  /* Progressive drawing line */
  .track-line {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* When scrolled into view, draw the line */
  .flow-transition.is-drawn .track-line {
    stroke-dashoffset: 0;
  }

  .track-glow {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .flow-transition.is-drawn .track-glow {
    opacity: 1;
  }

  /* Moving light pulse */
  .track-pulse {
    stroke-dasharray: 140 1060;
    animation: pulseTravel 3.5s linear infinite;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .flow-transition.is-drawn .track-pulse {
    opacity: 0.9;
  }

  .pulse-rtl {
    animation-direction: reverse;
  }

  @keyframes pulseTravel {
    0% {
      stroke-dashoffset: 1200;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Transition Pill Label */
  .transition-pill {
    position: absolute;
    top: 58px;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.92);
    opacity: 0;
    min-width: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 10px 22px;
    border: 1px solid #c7d7fb;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 14px rgba(11, 33, 76, 0.08),
                0 0 28px rgba(20, 91, 255, 0.14);
    z-index: 8;
    backdrop-filter: blur(8px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.6s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
  }

  .flow-transition.is-drawn .transition-pill {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  .transition-pill:hover {
    transform: translate(-50%, -52%) scale(1.02);
    border-color: #9bbaff;
    box-shadow: 0 8px 24px rgba(11, 33, 76, 0.12),
                0 0 36px rgba(20, 91, 255, 0.25);
  }

  .pill-text strong {
    display: block;
    color: var(--rm-blue, #145bff);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .pill-text small {
    display: block;
    color: #60708e;
    font-size: 0.65rem;
    line-height: 1.4;
  }

  .pill-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--rm-blue, #145bff);
    font-size: 1.05rem;
    border: 1px solid #bcd0ff;
    border-radius: 50%;
    background: #f8fbff;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(20, 91, 255, 0.1);
  }

  /* ---- Responsive ---- */
  @media (max-width: 700px) {
    .flow-transition {
      height: 90px;
    }
    .transition-svg {
      display: none;
    }
    .transition-pill {
      top: 45px;
      min-width: 0;
      width: calc(100% - 24px);
      padding: 8px 16px;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>
