---
/**
 * FlowTransition -SVG S-curve connector between roadmap stages.
 *
 * Uses `vector-effect: non-scaling-stroke` on every path to prevent
 * preserveAspectRatio="none" from distorting the stroke width.
 * Lines remain a crisp 4px regardless of viewport scaling.
 *
 * @prop direction -"ltr" or "rtl"
 * @prop icon      -Unicode icon for the pill
 * @prop label     -Main label text
 * @prop sublabel  -Descriptive subtext
 * @prop filterId  -Unique SVG filter ID
 */
interface Props {
  direction: 'ltr' | 'rtl';
  icon: string;
  label: string;
  sublabel: string;
  filterId: string;
}

const { direction, icon, label, sublabel, filterId } = Astro.props;

/**
 * S-curve path from x=40 (4%) to x=960 (96%) out of 1000.
 * Uses cubic Bézier for perfectly smooth curves.
 */
const pathD = direction === 'ltr'
  ? 'M 40,0 L 40,24 C 40,58 40,58 100,58 L 900,58 C 960,58 960,58 960,92 L 960,120'
  : 'M 960,0 L 960,24 C 960,58 960,58 900,58 L 100,58 C 40,58 40,58 40,92 L 40,120';
---

<div class={`flow-transition transition-${direction}`} aria-hidden="true">
  <svg class="transition-svg" viewBox="0 0 1000 120" preserveAspectRatio="none" fill="none">
    <!-- Subtle ambient guide track (always visible) -->
    <path
      class="track-guide"
      d={pathD}
      stroke="rgba(20, 91, 255, 0.12)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />

    <!-- Ambient glow behind the line -->
    <path
      class="track-glow"
      d={pathD}
      stroke="rgba(20, 91, 255, 0.18)"
      stroke-width="12"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />

    <!-- Main progressive drawing line -->
    <path
      class="track-line"
      d={pathD}
      stroke="#145bff"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />

    <!-- Traveling laser pulse -->
    <path
      class={`track-pulse ${direction === 'ltr' ? 'pulse-ltr' : 'pulse-rtl'}`}
      d={pathD}
      stroke="#60a5fa"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <!-- Transition pill label -->
  <div class="transition-pill">
    <span class="pill-icon">{icon}</span>
    <div class="pill-text">
      <strong>{label}</strong>
      <small>{sublabel}</small>
    </div>
  </div>
</div>

<style>
  .flow-transition {
    position: relative;
    height: 120px;
    z-index: 6;
  }

  .transition-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
  }

  /* Progressive line drawing (stroke-dashoffset) */
  .track-line {
    stroke-dasharray: 2400;
    stroke-dashoffset: 2400;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .flow-transition.is-drawn .track-line {
    stroke-dashoffset: 0;
  }

  /* Glow fades in with the line */
  .track-glow {
    opacity: 0;
    transition: opacity 1s ease;
  }

  .flow-transition.is-drawn .track-glow {
    opacity: 1;
  }

  /* Traveling laser pulse along the curve */
  .track-pulse {
    stroke-dasharray: 120 2280;
    animation: pulseTravel 3.5s linear infinite;
    opacity: 0;
    transition: opacity 0.5s ease 0.8s;
  }

  .flow-transition.is-drawn .track-pulse {
    opacity: 0.85;
  }

  .pulse-rtl {
    animation-direction: reverse;
  }

  @keyframes pulseTravel {
    0%   { stroke-dashoffset: 2400; }
    100% { stroke-dashoffset: 0; }
  }

  /* ---- Transition Pill ---- */
  .transition-pill {
    position: absolute;
    top: 58px;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.92);
    opacity: 0;
    min-width: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 10px 22px;
    border: 1px solid #c7d7fb;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 14px rgba(11, 33, 76, 0.08),
                0 0 28px rgba(20, 91, 255, 0.14);
    z-index: 8;
    backdrop-filter: blur(8px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.4s,
                opacity 0.5s ease 0.4s;
  }

  .flow-transition.is-drawn .transition-pill {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  .pill-text strong {
    display: block;
    color: var(--rm-blue, #145bff);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    line-height: 1.15;
  }

  .pill-text small {
    display: block;
    color: #60708e;
    font-size: 0.65rem;
    line-height: 1.4;
  }

  .pill-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--rm-blue, #145bff);
    font-size: 1.05rem;
    border: 1px solid #bcd0ff;
    border-radius: 50%;
    background: #f8fbff;
    flex-shrink: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 700px) {
    .flow-transition { height: 90px; }
    .transition-svg { display: none; }
    .transition-pill {
      top: 45px;
      min-width: 0;
      width: calc(100% - 24px);
      padding: 8px 16px;
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>
