---
/**
 * RoadmapHero — Full-width hero section for the roadmap landing page.
 *
 * Displays the main value proposition, supporting proof text, and
 * two CTA buttons. All copy is sourced from the roadmap content layer.
 */
import { heroContent } from '../../content/locales/en/roadmap';
---

<section class="mock-hero" aria-labelledby="hero-title">
  <h1 id="hero-title">
    {heroContent.title}<br />
    <span>{heroContent.titleHighlight}</span>
  </h1>

  <p class="hero-principle">{heroContent.principle}</p>
  <p class="hero-proof">{heroContent.proof}</p>

  <div class="hero-actions">
    <a class="primary-button" href={heroContent.primaryCta.href}>
      {heroContent.primaryCta.label} <span aria-hidden="true">→</span>
    </a>
    <a class="secondary-button" href={heroContent.secondaryCta.href}>
      {heroContent.secondaryCta.label}
    </a>
  </div>
</section>

<style>
  .mock-hero {
    text-align: center;
    padding: 54px 0 34px;
  }

  .mock-hero h1 {
    margin: 0 auto;
    max-width: 900px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.45rem, 4.2vw, 4.35rem);
    line-height: 1.03;
    letter-spacing: -0.055em;
    font-weight: 800;
  }

  .mock-hero h1 span {
    color: var(--rm-blue, #145bff);
  }

  .hero-principle {
    max-width: 760px;
    margin: 14px auto 0;
    color: #34415f;
    font-size: clamp(0.95rem, 1.25vw, 1.12rem);
    line-height: 1.55;
  }

  .hero-proof {
    max-width: 680px;
    margin: 10px auto 0;
    color: var(--rm-muted, #52617e);
    font-size: 0.91rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 22px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 700px) {
    .mock-hero { padding: 36px 2px 26px; }
    .mock-hero h1 { font-size: clamp(2rem, 10vw, 3rem); }
    .hero-principle { font-size: 0.88rem; }
    .hero-proof { font-size: 0.8rem; }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions a { width: 100%; }
  }
</style>
