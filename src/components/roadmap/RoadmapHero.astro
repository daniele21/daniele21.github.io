---
import type { RoadmapData } from '../../content/locales/en/roadmap';

interface Props {
  data: RoadmapData['hero'];
}

const { data } = Astro.props;
---

<section class="roadmap-hero" data-observe="stage" aria-labelledby="roadmap-hero-title">
  <div class="hero-inner" data-reveal="visual">
    <h1 id="roadmap-hero-title">
      {data.title}<br />
      <span>{data.principle}</span>
    </h1>
    <p class="hero-principle">{data.subtitle}</p>
    <p class="hero-proof">{data.proof}</p>
    <div class="hero-actions">
      <a class="primary-button" href={data.primaryCta.href}>{data.primaryCta.label}</a>
      <a class="secondary-button" href={data.secondaryCta.href}>{data.secondaryCta.label}</a>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span><small>Scroll to explore the decision path</small></div>
  </div>
</section>

<style>
  .roadmap-hero {
    min-height: calc(100svh - var(--roadmap-header-h));
    display: grid;
    place-items: center;
    text-align: center;
    padding: clamp(52px, 8svh, 90px) 0;
  }
  .hero-inner { width: min(100%, 940px); margin-inline: auto; }
  h1 {
    margin: 0 auto;
    max-width: 900px;
    color: var(--roadmap-ink);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.75rem, 5vw, 5.1rem);
    line-height: 1.01;
    letter-spacing: -.058em;
    font-weight: 800;
  }
  h1 span { color: var(--roadmap-blue); }
  .hero-principle {
    max-width: 780px;
    margin: 18px auto 0;
    color: #34415f;
    font-size: clamp(1rem,1.35vw,1.2rem);
    line-height: 1.58;
  }
  .hero-proof {
    max-width: 690px;
    margin: 11px auto 0;
    color: var(--roadmap-muted);
    font-size: .93rem;
    line-height: 1.58;
  }
  .hero-actions { display: flex; justify-content: center; gap: 15px; margin-top: 24px; }
  .primary-button,.secondary-button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    padding: 0 23px;
    font-size: .79rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .primary-button { color: #fff; background: var(--roadmap-blue); box-shadow: 0 8px 18px rgba(20,91,255,.18); }
  .secondary-button { color: var(--roadmap-ink); background: #fff; border: 1px solid #ccd6e9; }
  .primary-button:hover,.secondary-button:hover { transform: translateY(-2px); }
  .scroll-cue {
    margin: clamp(42px, 8svh, 76px) auto 0;
    display: grid;
    justify-items: center;
    gap: 8px;
    color: var(--roadmap-subtle);
  }
  .scroll-cue span {
    width: 22px;
    height: 34px;
    position: relative;
    border: 1px solid rgba(20,91,255,.28);
    border-radius: 999px;
  }
  .scroll-cue span::after {
    content: '';
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 7px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--roadmap-blue);
    animation: roadmapScrollCue 1.8s ease-in-out infinite;
  }
  .scroll-cue small { font-size: .67rem; letter-spacing: .03em; }
  @keyframes roadmapScrollCue {
    0%,100% { transform: translate(-50%,0); opacity: .35; }
    45% { transform: translate(-50%,9px); opacity: 1; }
  }
  @media (max-width: 700px) {
    .roadmap-hero { min-height: auto; padding: 54px 2px 44px; }
    h1 { font-size: clamp(2.15rem,10vw,3.25rem); }
    .hero-principle { font-size: .9rem; }
    .hero-proof { font-size: .8rem; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions a { width: 100%; }
    .scroll-cue { margin-top: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue span::after { animation: none; }
  }
</style>
