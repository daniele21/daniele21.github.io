---
import type { RoadmapData } from '../../content/locales/en/roadmap';

interface Props {
  data: RoadmapData['header'];
}

const { data } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => {
  if (href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('http')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
};
---

<header class="roadmap-header">
  <div class="roadmap-shell roadmap-nav-shell">
    <a class="roadmap-brand" href={`${baseUrl}/`} aria-label={`${data.brand} home`}>
      <span class="brand-cube" aria-hidden="true"><i></i></span>
      <span>{data.brand}</span>
    </a>

    <nav class="roadmap-nav" aria-label="Primary navigation">
      {data.links.map((link) => <a href={resolveHref(link.href)}>{link.label}</a>)}
      <a class="nav-cta" href={resolveHref(data.cta.href)}>{data.cta.label}</a>
    </nav>
  </div>
</header>

<style>
  .roadmap-header {
    height: var(--roadmap-header-h);
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 90;
    border-bottom: 1px solid rgba(213,222,239,.7);
    background: rgba(255,255,255,.9);
    backdrop-filter: blur(18px) saturate(135%);
  }
  .roadmap-nav-shell { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .roadmap-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--roadmap-ink);
    font-size: 1.03rem;
    font-weight: 800;
    letter-spacing: -.03em;
    text-decoration: none;
  }
  .brand-cube {
    width: 30px;
    height: 30px;
    position: relative;
    display: inline-block;
    clip-path: polygon(50% 0, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%);
    background: linear-gradient(145deg,#347bff,#0d47df);
    box-shadow: 0 7px 18px rgba(20,91,255,.28);
  }
  .brand-cube::after {
    content: '';
    position: absolute;
    inset: 6px;
    clip-path: inherit;
    background: linear-gradient(145deg, rgba(255,255,255,.22), rgba(2,39,132,.14));
  }
  .roadmap-nav { display: flex; align-items: center; gap: 30px; }
  .roadmap-nav a {
    color: var(--roadmap-ink);
    text-decoration: none;
    font-size: .77rem;
    font-weight: 750;
    transition: color 160ms ease, transform 160ms ease;
  }
  .roadmap-nav a:hover { color: var(--roadmap-blue); }
  .roadmap-nav .nav-cta {
    color: #fff;
    padding: .72rem 1rem;
    border-radius: 7px;
    background: var(--roadmap-blue);
    box-shadow: 0 7px 18px rgba(20,91,255,.18);
  }
  .roadmap-nav .nav-cta:hover { color: #fff; transform: translateY(-1px); }

  @media (max-width: 980px) {
    .roadmap-nav { gap: 16px; }
    .roadmap-nav a:not(.nav-cta) { display: none; }
  }
  @media (max-width: 700px) {
    .roadmap-brand { font-size: .9rem; }
    .brand-cube { width: 25px; height: 25px; }
    .roadmap-nav .nav-cta { padding: .62rem .78rem; font-size: .67rem; }
  }
</style>
