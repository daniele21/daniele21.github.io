---
/**
 * RoadmapHeader -Sticky mockup header with hexagon brand cube and simple nav.
 *
 * This is the header specific to the roadmap landing page, independent from
 * the global SiteHeader. Features glassmorphism backdrop on scroll.
 */
import { headerNav } from '../../content/locales/en/roadmap';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const page = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<header class="mock-header">
  <div class="mock-shell nav-shell">
    <a class="mock-brand" href={`${baseUrl}/`} aria-label="Daniele Moltisanti home">
      <img
        src={`${baseUrl}/images/sign_1.png`}
        alt="Daniele Moltisanti signature"
        class="brand-signature brand-signature-light"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
      />
      <img
        src={`${baseUrl}/images/sign_dark.png`}
        alt="Daniele Moltisanti signature"
        class="brand-signature brand-signature-dark"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
      />
      <span>{headerNav.brandName}</span>
    </a>

    <nav class="mock-nav" aria-label="Primary navigation">
      {headerNav.links.map((link) => (
        <a href={link.href.startsWith('#') ? link.href : page(link.href)}>
          {link.label}
        </a>
      ))}
      <a class="nav-cta" href={headerNav.cta.href}>
        {headerNav.cta.label}
      </a>
    </nav>
  </div>
</header>

<style>
  .mock-header {
    height: 74px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(213, 222, 239, 0.7);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 80;
  }

  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ---- Brand (signature + name) ---- */
  .mock-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--rm-ink, #081333);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 1.03rem;
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .brand-signature {
    height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
    transition: transform var(--duration-fast, 0.2s) ease;
  }

  .mock-brand:hover .brand-signature {
    transform: scale(1.06);
  }

  .brand-signature-light {
    display: block;
  }

  .brand-signature-dark {
    display: none;
  }

  :global([data-theme="dark"]) .brand-signature-light,
  :global(.dark) .brand-signature-light,
  [data-theme="dark"] .brand-signature-light {
    display: none;
  }

  :global([data-theme="dark"]) .brand-signature-dark,
  :global(.dark) .brand-signature-dark,
  [data-theme="dark"] .brand-signature-dark {
    display: block;
  }

  /* ---- Navigation links ---- */
  .mock-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .mock-nav a {
    color: var(--rm-ink, #081333);
    text-decoration: none;
    font-size: 0.77rem;
    font-weight: 750;
  }

  .mock-nav a:hover {
    color: var(--rm-blue, #145bff);
  }

  .mock-nav .nav-cta {
    color: white;
    padding: 0.72rem 1rem;
    border-radius: 7px;
    background: var(--rm-blue, #145bff);
    box-shadow: 0 7px 18px rgba(20, 91, 255, 0.18);
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .mock-nav { gap: 16px; }
    .mock-nav a:not(.nav-cta) { display: none; }
  }

  @media (max-width: 700px) {
    .mock-header { height: 64px; }
    .mock-brand { font-size: 0.9rem; }
    .brand-signature { height: 26px; }
    .mock-nav .nav-cta { padding: 0.62rem 0.78rem; font-size: 0.67rem; }
  }
</style>
