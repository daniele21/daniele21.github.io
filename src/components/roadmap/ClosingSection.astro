---
import type { RoadmapData } from '../../content/locales/en/roadmap';

interface Props {
  data: RoadmapData['closing'];
}

const { data } = Astro.props;
---

<section class="roadmap-closing" aria-labelledby="closing-title" data-observe="closing">
  <div class="closing-evidence" data-reveal="copy">
    <div class="closing-icon" aria-hidden="true">⌁</div>
    <div>
      <h2 id="closing-title">{data.evidenceTitle}</h2>
      <p>{data.evidenceText}</p>
    </div>
  </div>

  <div class="closing-divider" aria-hidden="true"></div>

  <div class="closing-collab" data-reveal="visual">
    <h3>{data.collaborationTitle}</h3>
    <p>{data.collaborationText}</p>
    <div class="closing-actions">
      <a class="primary-button" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20conversation">{data.primaryCta}</a>
      <a class="secondary-button" href="#strategy">{data.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .roadmap-closing {
    margin: clamp(28px, 6svh, 64px) 0 10px;
    min-height: 160px;
    border-radius: 18px;
    padding: 26px 30px;
    display: grid;
    grid-template-columns: 1fr 1px .92fr;
    gap: 30px;
    align-items: center;
  }
  .closing-evidence { display: grid; grid-template-columns: 62px 1fr; gap: 18px; align-items: center; }
  .closing-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--roadmap-blue);
    background: var(--roadmap-blue-soft);
    border: 1px solid rgba(20,91,255,.18);
    font-size: 1.4rem;
    box-shadow: 0 0 0 7px rgba(20,91,255,.035);
  }
  h2,h3 { margin: 0; color: var(--roadmap-ink); letter-spacing: -.03em; }
  h2 { font-size: 1.18rem; }
  h3 { font-size: 1rem; }
  p { margin: 6px 0 0; color: var(--roadmap-muted); font-size: .73rem; line-height: 1.5; }
  .closing-divider { width: 1px; height: 78px; background: #dbe4f2; }
  .closing-actions { display: flex; gap: 12px; margin-top: 13px; }
  .primary-button,.secondary-button {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 7px;
    font-size: .68rem;
    font-weight: 800;
    text-decoration: none;
  }
  .primary-button { color: #fff; background: var(--roadmap-blue); box-shadow: 0 7px 18px rgba(20,91,255,.17); }
  .secondary-button { color: var(--roadmap-ink); background: #fff; border: 1px solid #ccd6e9; }

  @media (max-width: 700px) {
    .roadmap-closing { grid-template-columns: 1fr; gap: 20px; padding: 22px 18px; }
    .closing-divider { width: 100%; height: 1px; }
    .closing-evidence { grid-template-columns: 48px 1fr; }
    .closing-icon { width: 46px; height: 46px; }
    .closing-actions { flex-direction: column; }
  }
</style>
