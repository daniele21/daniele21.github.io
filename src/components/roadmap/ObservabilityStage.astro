---
/**
 * ObservabilityStage -Stage 4: "Does it actually work well?"
 *
 * Contains four metric cards (Performance Lab, Traffic Monitoring,
 * Key Metrics, Resource Usage) and the observability copy with the
 * evaluation checklist.
 */
import StageRail from './StageRail.astro';
import {
  observabilityContent,
  performanceLabMetrics,
  trafficMetrics,
  keyMetrics,
  resourceUsage,
} from '../../content/locales/en/roadmap';
---

<section class="journey-stage stage-right stage-final" id="evidence" aria-labelledby="observability-title">
  <StageRail number={4} side="right" isFinal />

  <div class="stage-grid observability-grid">
    <!-- Left: metrics dashboard cards -->
    <div class="metrics-grid" aria-label="Performance and observability metrics">

      <!-- Performance Lab -->
      <article class="metric-card">
        <h3>{performanceLabMetrics.title}</h3>
        <svg class="spark-chart" viewBox="0 0 180 74" aria-hidden="true">
          <polyline points={performanceLabMetrics.sparkline} />
        </svg>
        <div class="metric-stats">
          {performanceLabMetrics.stats.map((s) => (
            <span>{s.label} <b class={s.className ?? ''}>{s.value}</b></span>
          ))}
        </div>
      </article>

      <!-- Traffic Monitoring -->
      <article class="metric-card">
        <h3>{trafficMetrics.title}</h3>
        <div class="bar-chart" aria-hidden="true">
          {trafficMetrics.barHeights.map((h) => (
            <i style={`height:${h}`}></i>
          ))}
        </div>
        <div class="metric-stats">
          {trafficMetrics.stats.map((s) => (
            <span>{s.label} <b class={s.className ?? ''}>{s.value}</b></span>
          ))}
        </div>
      </article>

      <!-- Key Metrics -->
      <article class="metric-card key-metrics">
        <h3>{keyMetrics.title}</h3>
        {keyMetrics.rows.map((row) => (
          <div class="metric-mini">
            <span>{row.label}</span>
            <b>{row.value}</b>
            <i class={row.barClass}></i>
          </div>
        ))}
      </article>

      <!-- Resource Usage -->
      <article class="metric-card resource-card">
        <h3>{resourceUsage.title}</h3>
        <div class="donut-row">
          <div class="donut"><span></span></div>
          <ul>
            {resourceUsage.donut.map((d) => (
              <li><i class={d.colorClass}></i>{d.label} <b>{d.value}</b></li>
            ))}
          </ul>
        </div>
        <div class="resource-lines">
          {resourceUsage.lines.map((l) => (
            <span>{l.label} <b>{l.value}</b></span>
          ))}
        </div>
      </article>
    </div>

    <!-- Right: observability copy + checklist -->
    <div class="stage-copy observability-copy">
      <p class="stage-kicker">{observabilityContent.kicker}</p>
      <h2 id="observability-title">{observabilityContent.title}</h2>
      <p class="stage-intro">{observabilityContent.intro}</p>

      <div class="stage-list observability-list">
        {observabilityContent.items.map((item) => (
          <div class="list-item">
            <span class="list-icon" aria-hidden="true">{item.icon}</span>
            <p><strong>{item.title} -</strong><br /><span>{item.text}</span></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Observability grid layout ---- */
  .observability-grid {
    grid-template-columns: 65% 35%;
    min-height: 290px;
    padding: 10px 84px 12px 22px;
  }

  .observability-copy { padding-left: 4px; }
  .observability-list { gap: 8px; margin-top: 12px; }

  /* ---- Metrics grid (4 cards) ---- */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 9px;
  }

  .metric-card {
    min-height: 230px;
    padding: 14px 12px 12px;
    border: 1px solid #dae4f2;
    border-radius: 10px;
    background: white;
    box-shadow: 0 6px 18px rgba(19, 45, 91, 0.04);
  }

  .metric-card h3 {
    margin: 0 0 10px;
    font-size: 0.68rem;
    font-weight: 800;
  }

  /* ---- Sparkline chart ---- */
  .spark-chart {
    width: 100%;
    height: 76px;
    display: block;
    border-bottom: 1px solid #e5ebf4;
  }

  .spark-chart polyline {
    fill: none;
    stroke: var(--rm-blue, #145bff);
    stroke-width: 2;
  }

  /* ---- Metric stats ---- */
  .metric-stats {
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }

  .metric-stats span {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: #5b6d87;
    font-size: 0.54rem;
  }

  .metric-stats b {
    color: var(--rm-ink, #081333);
    font-size: 0.56rem;
  }

  .metric-stats :global(.positive) { color: #16a34a; }
  .metric-stats :global(.negative) { color: #ef4444; }

  /* ---- Bar chart ---- */
  .bar-chart {
    height: 77px;
    display: flex;
    align-items: end;
    gap: 8px;
    padding: 8px 4px 0;
    border-bottom: 1px solid #e5ebf4;
  }

  .bar-chart i {
    flex: 1;
    background: linear-gradient(180deg, #9bbaff, #2563ff);
    border-radius: 3px 3px 0 0;
  }

  /* ---- Key Metrics mini-rows ---- */
  .key-metrics {
    display: grid;
    align-content: start;
  }

  .metric-mini {
    display: grid;
    grid-template-columns: 1fr auto 27px;
    gap: 5px;
    align-items: center;
    min-height: 27px;
    border-bottom: 1px solid #eef2f7;
    font-size: 0.49rem;
  }

  .metric-mini b { font-size: 0.51rem; }

  .metric-mini i {
    height: 7px;
    border-radius: 99px;
  }

  :global(.mini-green) { background: linear-gradient(90deg, #a7f3d0, #16a34a); }
  :global(.mini-blue)  { background: linear-gradient(90deg, #bfdbfe, #2563eb); }
  :global(.mini-red)   { background: linear-gradient(90deg, #fecaca, #ef4444); }

  /* ---- Donut chart ---- */
  .donut-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 7px;
    align-items: center;
    margin-top: 15px;
  }

  .donut {
    width: 67px;
    height: 67px;
    border-radius: 50%;
    background: conic-gradient(#2363ff 0 34%, #5f88ff 34% 62%, #9e7ef8 62% 88%, #dbe4f3 88%);
    display: grid;
    place-items: center;
  }

  .donut span {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: white;
  }

  .donut-row ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 5px;
  }

  .donut-row li {
    display: grid;
    grid-template-columns: 7px 1fr auto;
    gap: 4px;
    color: #5e6f89;
    font-size: 0.48rem;
  }

  .donut-row li i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2363ff;
  }

  .donut-row li :global(.gpu) { background: #5f88ff; }
  .donut-row li :global(.ram) { background: #9e7ef8; }
  .donut-row li :global(.disk) { background: #dbe4f3; }

  /* ---- Resource lines ---- */
  .resource-lines {
    margin-top: 14px;
    display: grid;
    gap: 8px;
  }

  .resource-lines span {
    display: flex;
    justify-content: space-between;
    color: #5b6d87;
    font-size: 0.5rem;
  }

  .resource-lines b {
    color: #334460;
    font-size: 0.51rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .observability-grid {
      grid-template-columns: 1fr;
      padding-left: 82px;
      padding-right: 82px;
      gap: 24px;
    }
    .metrics-grid { order: 2; grid-template-columns: repeat(2, 1fr); }
    .observability-copy { order: 1; }
    .stage-copy { max-width: 620px; }
  }

  @media (max-width: 700px) {
    .observability-grid {
      padding: 62px 12px 18px;
      gap: 20px;
    }
    .metrics-grid { grid-template-columns: 1fr; }
    .metric-card { min-height: 210px; }
  }
</style>
