---
/**
 * HarnessCta.astro
 * Call to action card footer.
 */
import { harnessData } from '../../content/harness';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { cta } = harnessData;
---

<section class="cta">
  <div class="shell">
    <div class="cta-box reveal">
      <div class="cta-badge">{cta.badge}</div>
      <h2>{cta.title}</h2>
      <p>{cta.sub}</p>
      <div class="cta-actions-row">
        <a class="btn primary" href="https://github.com/daniele21/android-local-llm-harness" target="_blank" rel="noreferrer">Explore Harnex on GitHub ↗</a>
        <a class="btn secondary" href={`${baseUrl}/`} target="_blank" rel="noreferrer">Back to Daniele Moltisanti Portfolio ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  .cta-box {
    text-align: center;
    padding: clamp(48px, 6vw, 72px) var(--space-6);
    border-radius: var(--radius-xl);
    background: linear-gradient(140deg, #172554, #0f172a);
    color: #ffffff;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .cta-box::after {
    content: "";
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    right: -100px;
    top: -180px;
    background: radial-gradient(circle, rgba(45, 212, 191, 0.24), transparent 70%);
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(96, 165, 250, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #93c5fd;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-box h2 {
    font-family: var(--font-display);
    color: #ffffff !important;
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    line-height: 1.12;
    max-width: 820px;
    margin: 18px auto 0;
  }

  .cta-box p {
    color: #cbd5e1 !important;
    max-width: 660px;
    margin: var(--space-4) auto 0;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .cta-actions-row {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    position: relative;
    z-index: 2;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 10px 22px;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-small);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .btn.primary {
    background: linear-gradient(135deg, var(--accent-blue-dark), var(--accent-blue));
    color: #ffffff;
    box-shadow: var(--shadow-glow);
  }

  .btn.secondary {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .btn:hover {
    transform: translateY(-2px);
  }
</style>
