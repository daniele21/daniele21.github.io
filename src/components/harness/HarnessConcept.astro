---
/**
 * HarnessConcept.astro
 * Dark plain-wrap concept container.
 */
import { harnessData } from '../../content/harness';
const { concept } = harnessData;
---

<section class="section tight" id="concept">
  <div class="shell">
    <div class="plain-wrap reveal">
      <div class="plain-grid">
        <div>
          <div class="eyebrow-chip">{concept.eyebrow}</div>
          <h2>{concept.title}</h2>
          <p class="lede">{concept.lede}</p>
        </div>

        <div class="what-list">
          {concept.items.map((item) => (
            <div class="what">
              <span class="n">{item.n}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .plain-wrap {
    background: linear-gradient(140deg, #0f172a, #1e293b);
    color: #ffffff;
    border-radius: var(--radius-xl);
    padding: clamp(32px, 5vw, 64px);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.2);
    box-shadow: var(--shadow-lg);
  }

  [data-theme="dark"] .plain-wrap {
    background: linear-gradient(140deg, #090d16, #111827);
    border-color: rgba(96, 165, 250, 0.25);
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(147, 197, 253, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #93c5fd;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .plain-wrap h2 {
    font-family: var(--font-display);
    color: #ffffff !important;
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    line-height: 1.12;
    margin: 14px 0 0;
  }

  .plain-wrap .lede {
    color: #cbd5e1 !important;
    font-size: var(--text-body-lg);
    line-height: 1.6;
    margin-top: 12px;
  }

  .plain-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-10);
    align-items: center;
  }

  .what-list {
    display: grid;
    gap: var(--space-3);
  }

  .what {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
  }

  .what .n {
    font-family: var(--font-display);
    font-weight: 800;
    color: #93c5fd;
  }

  .what strong {
    color: #ffffff;
    font-size: var(--text-small);
  }

  .what p {
    margin: 4px 0 0;
    color: #cbd5e1;
    font-size: var(--text-small);
  }

  @media (max-width: 1020px) {
    .plain-grid { grid-template-columns: 1fr; }
  }
</style>
