---
/**
 * HarnessMaturity.astro
 * Evidence & maturity cards matching prototype (3).
 */
import { harnessData } from '../../content/harness';
const { maturity } = harnessData;
---

<section class="section tight" id="status">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">{maturity.eyebrow}</div>
        <h2>{maturity.title}</h2>
      </div>
      <p>{maturity.sub}</p>
    </div>

    <div class="maturity">
      {maturity.cards.map((card) => (
        <article class={`maturity-card ${card.type} reveal`}>
          <h3>{card.title}</h3>
          <ul>
            {card.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    align-items: flex-end;
    margin-bottom: var(--space-8);
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 0;
  }

  .section-head p {
    max-width: 600px;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
  }

  .maturity {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .maturity-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .maturity-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }

  .maturity-card ul {
    padding-left: var(--space-5);
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .maturity-card li {
    margin-bottom: var(--space-2);
  }

  .maturity-card.good {
    border-color: rgba(13, 148, 136, 0.35);
    background: linear-gradient(180deg, var(--surface-teal), var(--surface-card));
  }

  .maturity-card.wait {
    border-color: rgba(217, 119, 6, 0.35);
    background: linear-gradient(180deg, var(--status-prototype-bg), var(--surface-card));
  }

  @media (max-width: 760px) {
    .maturity { grid-template-columns: 1fr; }
  }
</style>
