---
/**
 * HarnessArchitecture.astro
 * System design architecture breakdown matching prototype (3).
 */
import { harnessData } from '../../content/harness';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { architecture } = harnessData;
---

<section class="section tight" id="architecture">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">{architecture.eyebrow}</div>
        <h2>{architecture.title}</h2>
      </div>
      <p>{architecture.sub}</p>
    </div>

    <div class="architecture-simple reveal">
      {architecture.steps.map((item) => (
        <div class="arch-step">
          {item.label}
          <small>{item.detail}</small>
        </div>
      ))}
    </div>

    <details class="tech-panel reveal" open>
      <summary>Full technical architecture</summary>
      <div style="padding-top: 14px;">
        <img class="tech-img" data-zoomable src={`${baseUrl}/${architecture.imageDetail}`} alt="Full Architecture Diagram" />
      </div>
    </details>
  </div>
</section>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    align-items: flex-end;
    margin-bottom: var(--space-8);
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 0;
  }

  .section-head p {
    max-width: 600px;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
  }

  .architecture-simple {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-2);
    align-items: stretch;
  }

  .arch-step {
    position: relative;
    padding: var(--space-4) var(--space-2);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    color: var(--ink);
    border-radius: var(--radius-md);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .arch-step:not(:last-child):after {
    content: "→";
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    color: var(--accent-blue);
    font-size: 1.15rem;
  }

  .arch-step small {
    display: block;
    color: var(--ink-subtle);
    font-size: 0.65rem;
    font-weight: 500;
    margin-top: 5px;
  }

  .tech-panel {
    margin-top: var(--space-8);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    color: var(--ink);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    box-shadow: var(--shadow-sm);
  }

  .tech-panel summary {
    cursor: pointer;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  .tech-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    cursor: zoom-in;
    background: #ffffff;
    padding: 8px;
  }

  @media (max-width: 1020px) {
    .architecture-simple { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 760px) {
    .architecture-simple { grid-template-columns: repeat(2, 1fr); }
    .arch-step:after { display: none; }
  }
</style>
