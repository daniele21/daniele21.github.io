---
/**
 * HarnessRoadmap.astro
 * 4-phase execution plan roadmap.
 */
import { harnessData } from '../../content/harness';
const { roadmap } = harnessData;
---

<section class="section tight" id="status">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">{roadmap.eyebrow}</div>
        <h2>{roadmap.title}</h2>
      </div>
      <p>{roadmap.sub}</p>
    </div>

    <div class="roadmap">
      {roadmap.phases.map((item) => (
        <div class={`phase-card ${item.active ? 'active' : ''} reveal`}>
          <span class="phase-no">{item.phase}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    align-items: flex-end;
    margin-bottom: var(--space-8);
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 0;
  }

  .section-head p {
    max-width: 600px;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
  }

  .roadmap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .phase-card {
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .phase-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .phase-card h3 {
    font-family: var(--font-display);
    color: var(--ink);
    margin: var(--space-1) 0 var(--space-2);
  }

  .phase-card .phase-no {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .phase-card p {
    font-size: var(--text-small);
    color: var(--ink-muted);
    margin-bottom: 0;
  }

  .phase-card.active {
    border-color: var(--accent-teal);
    box-shadow: 0 0 0 3px var(--surface-teal);
  }

  .phase-card.active::before {
    content: "CURRENT";
    position: absolute;
    right: 14px;
    top: 14px;
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--accent-teal);
    background: var(--surface-teal);
    padding: 4px 8px;
    border-radius: var(--radius-full);
  }

  @media (max-width: 1020px) {
    .roadmap { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 760px) {
    .roadmap { grid-template-columns: 1fr; }
  }
</style>
