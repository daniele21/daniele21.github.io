---
/**
 * HarnessHero.astro
 * Hero section aligned 100% in typography, font sizes, pills, and hero dimensions with Home Hero.
 */
import { harnessData } from '../../content/harness';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { hero } = harnessData;
---

<section class="hero harness-hero" id="top">
  <div class="shell harness-hero-grid">
    <div class="harness-hero-copy reveal">
      <div class="eyebrow-pill">{hero.eyebrow}</div>
      <h1>{hero.titleLine1}<br><span class="blue-text">{hero.titleLine2}</span></h1>
      <p class="hero-lede" set:html={hero.lede.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>

      <div class="hero-key-pills" aria-label="Harness key ideas">
        {hero.keyPills.map((pill) => (
          <span class="key-pill" set:html={pill.replace(/(Local-first|Explicit|Measured)/g, '<b>$1</b>')} />
        ))}
      </div>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="#why">Why Harness exists <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="https://github.com/daniele21/android-local-llm-harness" target="_blank" rel="noreferrer">Explore GitHub <span aria-hidden="true">↗</span></a>
      </div>

      <div class="badge-row">
        {hero.badges.map((badge) => (
          <span class="tech-badge">{badge}</span>
        ))}
      </div>
    </div>

    <figure class="gateway-visual reveal" aria-label="Local AI Gateway vision">
      <img class="hero-architecture-image" data-zoomable src={`${baseUrl}/${hero.imageHero}`} alt="Android Local LLM Harness Architecture" />
      <div class="hero-image-note">
        <span>{hero.imageNoteLeft}</span>
        <strong>{hero.imageNoteRight}</strong>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: clamp(40px, 5vw, 80px) 0 60px;
    position: relative;
    overflow: clip;
  }

  .harness-hero::before {
    content: "";
    position: absolute;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    right: -240px;
    top: -280px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.14), transparent 68%);
    pointer-events: none;
  }

  .harness-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 3.5vw, 56px);
  }

  .harness-hero-copy {
    max-width: 560px;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface-blue);
    color: var(--accent-blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.08);
  }

  .harness-hero-copy h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--ink);
  }

  .blue-text {
    color: var(--accent-blue);
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lede {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .hero-key-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .key-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .key-pill b {
    color: var(--accent-blue);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease;
    cursor: pointer;
    border: none;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-primary {
    color: #ffffff;
    background: linear-gradient(135deg, var(--accent-blue-dark), var(--accent-blue));
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.28);
  }

  .button-secondary {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .badge-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  .tech-badge {
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .gateway-visual {
    background: var(--surface-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    padding: var(--space-3);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .hero-architecture-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    cursor: zoom-in;
    background: #ffffff;
    padding: 8px;
  }

  .hero-image-note {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: center;
    padding: 10px 10px 4px;
    color: var(--ink-subtle);
    font-size: var(--text-xs);
  }

  .hero-image-note strong {
    color: var(--ink-muted);
  }

  @media (max-width: 1020px) {
    .harness-hero-grid { grid-template-columns: 1fr; }
  }
</style>
