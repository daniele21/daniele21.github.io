---
/**
 * ClosedRoomProduct.astro
 * Product proof section with automated looping image carousels for paired screenshots.
 */
import { closedRoomData } from '../../content/closedRoom';

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
const { product } = closedRoomData;
---

<section class="section" id="product">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{product.kicker}</div>
      <h2>
        {product.titleLine1}<br />
        <span class="accent-text">{product.titleLine2}</span>
      </h2>
    </div>

    <div class="scenarios-list">
      {product.scenarios.map((scenario, scenarioIndex) => (
        <div class={`scenario reveal ${scenario.reverse ? 'reverse' : ''}`} data-scenario-carousel={scenarioIndex}>
          <div class="copy">
            <span class="tag">{scenario.tag}</span>
            <h2>{scenario.title}</h2>
            <p>{scenario.description}</p>

            <div class="scenario-controls">
              <span class="step-indicator">Slide <span data-step-text>1</span> / {scenario.shots.length}</span>
              <div class="dots-group">
                {scenario.shots.map((_, i) => (
                  <button
                    type="button"
                    class={`dot ${i === 0 ? 'active' : ''}`}
                    data-dot-index={i}
                    aria-label={`Go to slide ${i + 1}`}
                  ></button>
                ))}
              </div>
            </div>
          </div>

          <div class="shots-carousel">
            {scenario.shots.map((shot, shotIndex) => (
              <div class={`shot slide ${shotIndex === 0 ? 'is-active' : ''}`} data-shot-index={shotIndex}>
                <img
                  data-zoomable
                  src={`${baseUrl}/${shot.image.replace(/^\//, '')}`}
                  alt={shot.alt}
                  loading="lazy"
                />
                <div class="shot-label">{shot.label}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-head {
    max-width: 780px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 800;
    color: var(--ink);
  }

  .accent-text {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .scenarios-list {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 72px);
  }

  .scenario {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  .scenario.reverse .copy {
    order: 2;
  }

  .scenario.reverse .shots-carousel {
    order: 1;
  }

  .copy {
    max-width: 470px;
  }

  .copy h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .copy p {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0;
  }

  .tag {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--ink-subtle);
    text-transform: uppercase;
  }

  .scenario-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .step-indicator {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 750;
    color: var(--ink-muted);
  }

  .dots-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    background: var(--border-strong, #94a3b8);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .dot.active {
    background: var(--accent-blue);
    transform: scale(1.35);
  }

  /* Single shot Carousel container */
  .shots-carousel {
    position: relative;
    width: 100%;
  }

  .shot.slide {
    display: none;
    padding: 10px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .shot.slide.is-active {
    display: block;
    opacity: 1;
    transform: scale(1);
    z-index: 2;
  }

  .shot img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    display: block;
  }

  .shot-label {
    padding: 10px 6px 4px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 750;
    color: var(--ink-muted);
  }

  @media (max-width: 980px) {
    .scenario {
      grid-template-columns: 1fr;
    }

    .scenario.reverse .copy,
    .scenario.reverse .shots-carousel {
      order: initial;
    }
  }
</style>

<script>
  // Automatic looping carousel script for scenarios
  const scenarios = document.querySelectorAll('[data-scenario-carousel]');
  scenarios.forEach((scenario) => {
    const slides = scenario.querySelectorAll<HTMLElement>('.shot.slide');
    const dots = scenario.querySelectorAll<HTMLButtonElement>('.dot');
    const stepText = scenario.querySelector<HTMLElement>('[data-step-text]');
    let currentIndex = 0;
    let timer: any = null;

    function goToSlide(index: number) {
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
      if (stepText) stepText.textContent = String(index + 1);
      currentIndex = index;
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slides.length);
    }

    function startAutoLoop() {
      stopAutoLoop();
      timer = setInterval(nextSlide, 2000);
    }

    function stopAutoLoop() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goToSlide(i);
        startAutoLoop();
      });
    });

    scenario.addEventListener('mouseenter', stopAutoLoop);
    scenario.addEventListener('mouseleave', startAutoLoop);

    startAutoLoop();
  });
</script>
