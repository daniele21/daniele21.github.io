---
/**
 * ClosedRoomValues.astro
 * Core values & key principles section ("What matters").
 */
import { closedRoomData } from '../../content/closedRoom';

const { values } = closedRoomData;
---

<section class="section section-alt">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{values.kicker}</div>
      <h2>
        {values.titleLine1}<br />
        <span class="accent-text">{values.titleLine2}</span>
      </h2>
    </div>

    <div class="values-grid reveal">
      {values.items.map((item) => (
        <article class={`card value ${item.featured ? 'featured' : ''}`}>
          <div class={`icon ${item.color}`}>{item.id}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {item.quote && <span class="quote">“{item.quote}”</span>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-alt {
    background: var(--surface-muted);
    border-block: 1px solid var(--border-subtle);
  }

  .section-head {
    max-width: 780px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 800;
    color: var(--ink);
  }

  .accent-text {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .card {
    min-height: 235px;
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }
  }

  .card.featured {
    border-color: var(--accent-teal-light, #14b8a6);
    background: linear-gradient(145deg, var(--surface-teal), var(--surface-card) 72%);
  }

  .icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
  }

  .icon.teal {
    color: var(--accent-teal);
    background: var(--surface-teal);
  }

  .icon.blue {
    color: var(--accent-blue);
    background: var(--surface-blue);
  }

  .icon.violet {
    color: var(--accent-violet);
    background: var(--surface-violet);
  }

  .icon.amber {
    color: var(--accent-amber);
    background: var(--status-prototype-bg);
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: var(--space-2);
    color: var(--ink);
  }

  p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .quote {
    display: block;
    margin-top: var(--space-4);
    color: var(--accent-teal);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
  }

  @media (max-width: 980px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
