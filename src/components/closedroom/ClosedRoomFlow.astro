---
/**
 * ClosedRoomFlow.astro
 * End-to-end flow diagram section.
 */
import { closedRoomData } from '../../content/closedRoom';

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
const { flow } = closedRoomData;
---

<section class="section section-alt" id="flow">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{flow.kicker}</div>
      <h2>
        {flow.titleLine1}<br />
        <span class="accent-text">{flow.titleLine2}</span>
      </h2>
    </div>

    <div class="arch-card reveal">
      <img
        data-zoomable
        src={`${baseUrl}/${flow.image.replace(/^\//, '')}`}
        alt="ClosedRoom end-to-end meeting flow architecture diagram"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-alt {
    background: var(--surface-muted);
    border-block: 1px solid var(--border-subtle);
  }

  .section-head {
    max-width: 780px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 800;
    color: var(--ink);
  }

  .accent-text {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .arch-card {
    padding: 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    box-shadow: var(--shadow-lg);

    img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-lg);
      display: block;
    }
  }
</style>
