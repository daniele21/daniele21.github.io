---
/**
 * ClosedRoomTrust.astro
 * Privacy boundary comparison (Default local path vs Explicit opt-in path).
 */
import { closedRoomData } from '../../content/closedRoom';

const { trust } = closedRoomData;
---

<section class="section section-alt" id="trust">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{trust.kicker}</div>
      <h2>
        {trust.titleLine1}<br />
        <span class="accent-text">{trust.titleLine2}</span>
      </h2>
    </div>

    <div class="trust-grid reveal">
      <div class="trust-box local">
        <h3>{trust.local.title}</h3>
        <p>{trust.local.description}</p>
        <strong>{trust.local.stack}</strong>
      </div>

      <div class="trust-box cloud">
        <h3>{trust.cloud.title}</h3>
        <p>{trust.cloud.description}</p>
        <strong>{trust.cloud.tagline}</strong>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-alt {
    background: var(--surface-muted);
    border-block: 1px solid var(--border-subtle);
  }

  .section-head {
    max-width: 780px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 800;
    color: var(--ink);
  }

  .accent-text {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .trust-box {
    padding: clamp(24px, 3.5vw, 32px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .trust-box.local {
    background: linear-gradient(145deg, var(--surface-teal), var(--surface-card) 78%);
    border-color: rgba(15, 118, 110, 0.25);
  }

  .trust-box.cloud {
    background: linear-gradient(145deg, var(--status-prototype-bg), var(--surface-card) 78%);
    border-color: rgba(217, 119, 6, 0.25);
  }

  .trust-box h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: var(--space-3);
    color: var(--ink);
  }

  .trust-box p {
    margin-top: 0;
    margin-bottom: var(--space-4);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .trust-box strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 750;
    color: var(--ink);
  }

  @media (max-width: 980px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
