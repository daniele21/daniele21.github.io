---
/**
 * RedactGuardCta.astro
 * CTA section matching prototype (2).
 */
import { redactGuardData } from '../../content/redactGuard';
const { cta } = redactGuardData;
---

<section class="section">
  <div class="shell cta-wrap reveal">
    <div>
      <div class="kicker-chip">{cta.kicker}</div>
      <h2>
        {cta.titleLine1} <span class="teal-accent">{cta.titleLine2}</span>
      </h2>
      <p set:html={cta.sub.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
    </div>

    <a class="btn primary-btn" href="https://github.com/daniele21/redact-guard" target="_blank" rel="noreferrer">
      Explore RedactGuard ↗
    </a>
  </div>
</section>

<style>
  .section {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  .cta-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: clamp(36px, 5vw, 56px);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #0f172a, #1e3a8a 70%, #0f766e);
    color: #ffffff;
    box-shadow: var(--shadow-lg);
  }

  .kicker-chip {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(147, 197, 253, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #93c5fd;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .cta-wrap h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    line-height: 1.12;
    color: #ffffff !important;
    margin: 0 0 var(--space-3);
  }

  .teal-accent {
    color: #5eead4 !important;
  }

  .cta-wrap p {
    max-width: 660px;
    margin: 0;
    color: #cbd5e1 !important;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .cta-wrap strong {
    color: #ffffff !important;
  }

  .primary-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 10px 24px;
    border-radius: var(--radius-md);
    background: #ffffff;
    color: var(--ink);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-fast) ease;
  }

  .primary-btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 760px) {
    .cta-wrap {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
