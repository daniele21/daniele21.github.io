---
/**
 * RedactGuardBenefits.astro
 * Benefits section matching prototype (2).
 */
import { redactGuardData } from '../../content/redactGuard';
const { benefits } = redactGuardData;
---

<section class="section alt">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{benefits.kicker}</div>
      <h2>{benefits.title}</h2>
    </div>

    <div class="benefits-grid">
      {benefits.items.map((item) => (
        <article class={`card benefit-card ${item.featured ? 'featured' : ''} reveal`}>
          <div class={`icon ${item.color}`}>{item.id}</div>
          <h3>{item.title}</h3>
          <p set:html={item.description.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
          {item.quote && <span class="benefit-quote">{item.quote}</span>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section.alt {
    background: var(--surface-card);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-head {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 10px;
    color: var(--accent-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 0;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .benefit-card {
    min-height: 230px;
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .benefit-card.featured {
    border-color: var(--accent-blue-light);
    background: linear-gradient(145deg, var(--surface-blue), var(--surface-card) 70%);
    box-shadow: var(--shadow-md);
  }

  .icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 850;
    font-size: var(--text-small);
  }

  .icon.blue { color: var(--accent-blue); background: var(--surface-blue); }
  .icon.violet { color: var(--accent-violet); background: var(--surface-violet); }
  .icon.teal { color: var(--accent-teal); background: var(--surface-teal); }

  .benefit-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }

  .benefit-card p {
    font-size: var(--text-small);
    color: var(--ink-muted);
    margin: 0;
  }

  .benefit-quote {
    display: block;
    margin-top: var(--space-4);
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 750;
    line-height: 1.35;
  }

  @media (max-width: 980px) {
    .benefits-grid { grid-template-columns: 1fr; }
  }
</style>
