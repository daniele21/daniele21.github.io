---
/**
 * RedactGuardProblem.astro
 * Problem section matching prototype (2).
 */
import { redactGuardData } from '../../content/redactGuard';
const { problem } = redactGuardData;
---

<section class="section alt" id="problem">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{problem.kicker}</div>
      <h2>{problem.title}</h2>
      <p class="lead" set:html={problem.lede.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
    </div>

    <div class="pain-grid">
      {problem.items.map((item) => (
        <article class="card reveal">
          <div class={`icon ${item.color}`}>{item.id}</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>

    <div class="pain-line reveal" set:html={problem.painLine.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section.alt {
    background: var(--surface-card);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-head {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 10px;
    color: var(--accent-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-3);
  }

  .lead {
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 850;
    font-size: var(--text-small);
  }

  .icon.blue { color: var(--accent-blue); background: var(--surface-blue); }
  .icon.violet { color: var(--accent-violet); background: var(--surface-violet); }
  .icon.teal { color: var(--accent-teal); background: var(--surface-teal); }

  .card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }

  .card p {
    font-size: var(--text-small);
    color: var(--ink-muted);
    margin: 0;
  }

  .pain-line {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-violet);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    font-weight: 650;
    color: var(--ink);
  }

  @media (max-width: 980px) {
    .pain-grid { grid-template-columns: 1fr; }
  }
</style>
