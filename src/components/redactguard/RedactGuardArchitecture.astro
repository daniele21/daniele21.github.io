---
/**
 * RedactGuardArchitecture.astro
 * Technical architecture section matching prototype (2).
 */
import { redactGuardData } from '../../content/redactGuard';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { architecture } = redactGuardData;
---

<section class="section alt" id="architecture">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{architecture.kicker}</div>
      <h2>{architecture.title}</h2>
      <p>{architecture.sub}</p>
    </div>

    <div class="tech-layout">
      <div class="architecture-img-wrap reveal">
        <img
          data-zoomable
          src={`${baseUrl}/${architecture.image}`}
          alt="RedactGuard local-first technical architecture"
        />
      </div>

      <div class="tech-points reveal">
        {architecture.points.map((point) => (
          <div class="tech-point">
            <h3>{point.title}</h3>
            <p set:html={point.description.replace(/`(.*?)`/g, '<code>$1</code>')}></p>
          </div>
        ))}

        <a class="btn secondary-btn" href="https://github.com/daniele21/redact-guard" target="_blank" rel="noreferrer">
          Explore the architecture on GitHub ↗
        </a>
      </div>
    </div>

    <div class="disclaimer reveal">
      <div class="disclaimer-icon">⚠</div>
      <p set:html={architecture.disclaimer.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section.alt {
    background: var(--surface-card);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-head {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 10px;
    color: var(--accent-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-2);
  }

  .section-head p {
    color: var(--ink-muted);
    font-size: var(--text-body);
    margin: 0;
  }

  .tech-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-6);
    align-items: start;
  }

  .architecture-img-wrap {
    padding: 11px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    background: #07111f;
    box-shadow: var(--shadow-lg);
  }

  .architecture-img-wrap img {
    border-radius: var(--radius-lg);
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }

  .tech-points {
    display: grid;
    gap: var(--space-3);
  }

  .tech-point {
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .tech-point h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 6px;
  }

  .tech-point p {
    margin: 0;
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 10px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--ink);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .secondary-btn:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .disclaimer {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px solid #fecaca;
    border-radius: var(--radius-lg);
    background: var(--status-experimental-bg);
  }

  .disclaimer-icon {
    font-size: 1.2rem;
    color: #b91c1c;
  }

  .disclaimer p {
    margin: 0;
    color: #991b1b;
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .tech-layout { grid-template-columns: 1fr; }
  }
</style>
