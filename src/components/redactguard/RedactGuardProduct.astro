---
/**
 * RedactGuardProduct.astro
 * Product screens section matching prototype (2).
 */
import { redactGuardData } from '../../content/redactGuard';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { product } = redactGuardData;
---

<section class="section" id="product">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{product.kicker}</div>
      <h2>{product.title}</h2>
      <p>{product.sub}</p>
    </div>

    <div class="screens-grid">
      {product.screens.map((screen) => (
        <article class="screen-card reveal">
          <div class="screen-img-wrap">
            <img
              data-zoomable
              src={`${baseUrl}/${screen.image}`}
              alt={`RedactGuard ${screen.title} screen`}
            />
          </div>
          <div class="screen-copy">
            <span class="screen-tag">{screen.tag}</span>
            <h3>{screen.title}</h3>
            <p>{screen.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section-head {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 10px;
    color: var(--accent-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-2);
  }

  .section-head p {
    color: var(--ink-muted);
    font-size: var(--text-body);
    margin: 0;
  }

  .screens-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .screen-card {
    padding: 10px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .screen-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .screen-img-wrap img {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }

  .screen-copy {
    padding: 14px 10px 8px;
  }

  .screen-tag {
    display: inline-flex;
    margin-bottom: 7px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    color: var(--ink-subtle);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .screen-copy h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 6px;
  }

  .screen-copy p {
    margin: 0;
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  @media (max-width: 980px) {
    .screens-grid { grid-template-columns: 1fr; }
  }
</style>
