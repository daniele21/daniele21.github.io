---
/**
 * PillarCard - Card component for an individual infrastructure pillar.
 */
import type { Pillar } from '../../types/content';

interface Props {
  pillar: Pillar;
}

const { pillar } = Astro.props;

const iconClassMap = {
  teal: 'project-icon-teal',
  blue: 'project-icon-blue',
  violet: 'project-icon-violet',
};
---

<article class="project-card pillar-card reveal">
  <div class="project-card-top">
    <span class={`project-icon ${iconClassMap[pillar.accent]}`} aria-hidden="true">
      {pillar.accent === 'teal' && (
        <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/><path d="m8 9.8 8-4.5"/></svg>
      )}
      {pillar.accent === 'blue' && (
        <svg viewBox="0 0 24 24"><path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 10v4"/></svg>
      )}
      {pillar.accent === 'violet' && (
        <svg viewBox="0 0 100 100" class="harness-symbol-svg">
          <path fill="#7C5CFC" d="M8,8 L33,20 L33,42 L16,50 L33,58 L33,80 L8,92 Z" />
          <path fill="#25C2A0" d="M92,8 L67,20 L67,42 L84,50 L67,58 L67,80 L92,92 Z" />
          <path fill="#7C5CFC" d="M41.964,48.724 H44.643 V51.276 H41.964 Z" />
          <path fill="#6467EB" d="M46.429,48.724 H49.107 V51.276 H46.429 Z" />
          <path fill="#3E97CD" d="M50.893,48.724 H53.571 V51.276 H50.893 Z" />
          <path fill="#25C2A0" d="M55.357,48.724 H58.036 V51.276 H55.357 Z" />
        </svg>
      )}
    </span>
    <span class={`status ${pillar.status === 'experimental' ? 'status-progress' : 'status-active'}`}>{pillar.statusLabel}</span>
  </div>
  <h3>
    {pillar.pageUrl ? (
      <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + pillar.pageUrl} class="pillar-title-link">
        {pillar.name} <span class="link-arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      pillar.name
    )}
  </h3>

  <div class="pillar-problem-block">
    <span class="pillar-block-label">PROBLEM</span>
    <p set:html={pillar.problem}></p>
  </div>

  <div class="pillar-solution-block">
    <span class="pillar-block-label">SOLUTION</span>
    <p set:html={pillar.role}></p>
  </div>

  <div class="tech-tags">
    {pillar.technologies.map((tech) => (
      <span class="tech-pill">{tech}</span>
    ))}
  </div>
  <details class="project-disclosure">
    <summary>Explore the pillar <span aria-hidden="true">+</span></summary>
    <div class="disclosure-body">
      <p set:html={pillar.description}></p>
      <ul>
        {pillar.capabilities.slice(0, 3).map((cap) => (
          <li set:html={cap}></li>
        ))}
      </ul>
      <div class="project-links">
        {pillar.pageUrl && (
          <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + pillar.pageUrl} class="pillar-page-btn">
            Explore Harness Page →
          </a>
        )}
        <a href={pillar.repositoryUrl} target="_blank" rel="noreferrer">View repository ↗</a>
      </div>
    </div>
  </details>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) ease,
                background-color var(--duration-base) ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .project-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .project-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    color: #ffffff;
    box-shadow: 0 10px 24px rgba(41, 74, 140, 0.18);
    transition: transform var(--duration-base) var(--ease-out-expo), box-shadow var(--duration-base) ease;
  }

  .project-card:hover .project-icon {
    transform: scale(1.06);
    box-shadow: 0 14px 30px rgba(23, 92, 255, 0.28);
  }

  .project-icon svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project-icon svg.harness-symbol-svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: none;
  }

  .project-icon-teal { background: linear-gradient(145deg, #0fa6a4, #077b86); }
  .project-icon-blue { background: linear-gradient(145deg, #397dff, #284dcc); }
  .project-icon-violet {
    background: #ffffff;
    border: 1px solid rgba(124, 92, 252, 0.2);
    box-shadow: 0 8px 20px rgba(124, 92, 252, 0.12);
  }

  .status {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 24px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .status-active { color: var(--status-active-text); background: var(--status-active-bg); }
  .status-progress { color: var(--status-progress-text); background: var(--status-progress-bg); }

  .project-card h3 {
    margin: var(--space-4) 0 var(--space-2);
    font-family: var(--font-body);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .pillar-problem-block,
  .pillar-solution-block {
    margin-top: var(--space-3);
  }

  .pillar-block-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }

  .pillar-problem-block .pillar-block-label {
    color: var(--ink-subtle);
  }

  .pillar-problem-block p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .pillar-solution-block .pillar-block-label {
    color: var(--accent-blue);
  }

  .pillar-solution-block p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink);
    font-weight: 600;
    line-height: 1.45;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .tech-tags span,
  .tech-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-blue);
    background: var(--surface-blue);
    border: 1px solid var(--border-subtle);
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .tech-tags span:hover,
  .tech-pill:hover {
    background: var(--surface-card);
    border-color: var(--accent-blue-light);
    transform: translateY(-1px);
  }

  .project-disclosure {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .project-disclosure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--accent-blue);
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-fast) ease;
  }

  .project-disclosure summary:hover {
    color: var(--accent-blue-light);
  }

  .project-disclosure summary::-webkit-details-marker { display: none; }
  .project-disclosure summary span { font-size: 1.2rem; transition: transform var(--duration-fast) ease; }
  .project-disclosure[open] summary span { transform: rotate(45deg); }

  .disclosure-body {
    padding-top: var(--space-3);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .disclosure-body ul {
    padding-left: var(--space-5);
    margin-top: var(--space-2);
  }

  .disclosure-body li { margin-bottom: var(--space-1); }

  .project-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-small);
    transition: color var(--duration-fast) ease;
  }

  .project-links a:hover {
    color: var(--accent-blue-light);
    text-decoration: underline;
  }

  .pillar-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .pillar-title-link:hover {
    color: var(--accent-violet);
  }

  .pillar-title-link .link-arrow {
    display: inline-block;
    transition: transform var(--duration-fast) ease;
  }

  .pillar-title-link:hover .link-arrow {
    transform: translateX(4px);
  }

  .pillar-page-btn {
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-violet);
    color: var(--accent-violet) !important;
    border: 1px solid var(--border-subtle);
    font-weight: 750;
    text-decoration: none !important;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .pillar-page-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent-violet);
  }
</style>

