---
/**
 * AuraSolution.astro
 * Solution section matching prototype.
 */
import { auraFinanceData } from '../../content/auraFinance';
const { solution } = auraFinanceData;
---

<section class="section" id="solution">
  <div class="shell solution-wrap reveal">
    <div class="solution-intro">
      <div class="kicker-chip">{solution.kicker}</div>
      <h2>
        {solution.titleLine1}<br>
        <span class="teal-accent">{solution.titleLine2}</span>
      </h2>

      <p class="lead" set:html={solution.lede.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
    </div>

    <div class="solution-flow" aria-label="Aura Finance workflow">
      {solution.steps.map((step) => (
        <div class="flow-step">
          <div class="flow-num">{step.step}</div>
          <b>{step.title}</b>
          <span>{step.description}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .solution-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: var(--space-10);
    align-items: center;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #082434, #063b66 68%, #0f766e);
    color: #ffffff;
    overflow: hidden;
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .solution-wrap::after {
    content: "";
    position: absolute;
    width: 350px;
    height: 350px;
    right: -150px;
    bottom: -180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(94, 234, 212, 0.26), transparent 68%);
  }

  .kicker-chip {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(157, 212, 232, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #9dd4e8;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .solution-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.1;
    color: #ffffff !important;
    margin: var(--space-2) 0 var(--space-4);
  }

  .teal-accent {
    color: #74e0cd !important;
  }

  .solution-intro .lead {
    color: #d6e8ef !important;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .solution-intro strong {
    color: #ffffff !important;
  }

  .solution-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    position: relative;
    z-index: 2;
  }

  .flow-step {
    min-height: 130px;
    padding: var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
  }

  .flow-step b {
    display: block;
    margin-bottom: 6px;
    color: #ffffff;
    font-size: var(--text-small);
  }

  .flow-step span {
    color: #cde1e8;
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .flow-num {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    margin-bottom: 12px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--accent-blue-dark);
    font-size: var(--text-xs);
    font-weight: 850;
  }

  @media (max-width: 980px) {
    .solution-wrap { grid-template-columns: 1fr; }
    .solution-flow { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .solution-flow { grid-template-columns: 1fr; }
  }
</style>
