---
/**
 * AuraPayment.astro
 * Android payment detection capability section matching prototype.
 */
import { auraFinanceData } from '../../content/auraFinance';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { payment } = auraFinanceData;
---

<section class="section alt" id="payment">
  <div class="shell payment-wrap reveal">
    <div class="payment-intro">
      <div class="kicker-green">{payment.kicker}</div>
      <h2>{payment.title}</h2>
      <p class="lead" set:html={payment.lede.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>

      <div class="payment-steps">
        {payment.steps.map((step) => (
          <div class="mini-step">
            <b>{step.title}</b>
            <span>{step.description}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="payment-image-wrap">
      <div class="payment-image">
        <img data-zoomable src={`${baseUrl}/${payment.image}`} alt="Aura Android payment detection review interface" />
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section.alt {
    background: var(--surface-card);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .payment-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-8);
    align-items: center;
    border: 1px solid rgba(21, 128, 61, 0.25);
    background: linear-gradient(145deg, var(--surface-teal), var(--surface-card) 75%);
    border-radius: var(--radius-xl);
    padding: clamp(28px, 4vw, 42px);
    box-shadow: var(--shadow-sm);
  }

  .kicker-green {
    margin-bottom: 10px;
    color: #15803d;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .payment-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-3);
  }

  .payment-intro .lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .payment-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .mini-step {
    padding: var(--space-3);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    border-radius: var(--radius-md);
  }

  .mini-step b {
    display: block;
    margin-bottom: 4px;
    font-size: var(--text-small);
    color: var(--ink);
  }

  .mini-step span {
    display: block;
    color: var(--ink-subtle);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .payment-image-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .payment-image {
    max-width: 230px;
    width: 100%;
    padding: 8px;
    border: 1px solid var(--border-subtle);
    border-radius: 22px;
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-fast) ease;
  }

  .payment-image:hover {
    transform: translateY(-2px);
  }

  .payment-image img {
    border-radius: 16px;
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: contain;
    cursor: zoom-in;
  }

  @media (max-width: 980px) {
    .payment-wrap { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .payment-steps { grid-template-columns: 1fr; }
    .payment-image { max-width: 210px; }
  }
</style>
