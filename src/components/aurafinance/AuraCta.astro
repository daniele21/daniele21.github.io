---
/**
 * AuraCta.astro
 * Bottom CTA section matching prototype.
 */
import { auraFinanceData } from '../../content/auraFinance';
const { cta } = auraFinanceData;
---

<section class="section">
  <div class="shell cta-wrap reveal">
    <div>
      <div class="kicker-chip">{cta.kicker}</div>
      <h2>
        {cta.titleLine1} <span class="teal-accent">{cta.titleLine2}</span>
      </h2>
      <p set:html={cta.sub.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
    </div>

    <a class="btn primary-btn" href="https://github.com/daniele21/personal-budget/tree/new-features" target="_blank" rel="noreferrer">
      Explore Aura Finance ↗
    </a>
  </div>
</section>

<style>
  .section {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  .cta-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: clamp(36px, 5vw, 56px);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #082434, #063b66 66%, #0f766e);
    color: #ffffff;
    box-shadow: var(--shadow-lg);
  }

  .kicker-chip {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(157, 212, 232, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #9dd4e8;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .cta-wrap h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    line-height: 1.12;
    color: #ffffff !important;
    margin: 0 0 var(--space-3);
  }

  .teal-accent {
    color: #74e0cd !important;
  }

  .cta-wrap p {
    max-width: 680px;
    margin: 0;
    color: #d4e6ec !important;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .cta-wrap strong {
    color: #ffffff !important;
  }

  .primary-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 10px 24px;
    border-radius: var(--radius-md);
    background: #ffffff;
    color: var(--ink);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-fast) ease;
  }

  .primary-btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 760px) {
    .cta-wrap {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
