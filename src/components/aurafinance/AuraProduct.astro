---
/**
 * AuraProduct.astro
 * Product scenarios section with compact, fixed-height mobile screenshot cards.
 */
import { auraFinanceData } from '../../content/auraFinance';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { product } = auraFinanceData;
---

<section class="section" id="product">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{product.kicker}</div>
      <h2>{product.title}</h2>
      <p>{product.sub}</p>
    </div>

    <div class="scenarios">
      {product.scenarios.map((scenario) => (
        <div class={`scenario ${scenario.reverse ? 'reverse' : ''} reveal`}>
          <div class="scenario-copy">
            <span class="tag">{scenario.tag}</span>
            <h2>{scenario.question}</h2>
            <p set:html={scenario.description.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>
          </div>

          <div class="scenario-visual">
            <div class="shot">
              <img data-zoomable src={`${baseUrl}/${scenario.shot1.image}`} alt={scenario.shot1.alt} />
              <div class="shot-label">{scenario.shot1.label}</div>
            </div>
            <div class="shot">
              <img data-zoomable src={`${baseUrl}/${scenario.shot2.image}`} alt={scenario.shot2.alt} />
              <div class="shot-label">{scenario.shot2.label}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 10px;
    color: var(--accent-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-2);
  }

  .section-head p {
    color: var(--ink-muted);
    font-size: var(--text-body);
    margin: 0;
  }

  .scenarios {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .scenario {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--space-8);
    align-items: center;
  }

  .scenario.reverse .scenario-copy { order: 2; }
  .scenario.reverse .scenario-visual { order: 1; }

  .scenario-copy {
    max-width: 460px;
  }

  .scenario-copy .tag {
    display: inline-flex;
    margin-bottom: 9px;
    padding: 5px 10px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    color: var(--ink-subtle);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .scenario-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }

  .scenario-copy p {
    font-size: var(--text-body);
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  .scenario-visual {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    max-width: 400px;
    margin-inline: auto;
  }

  .shot {
    padding: 6px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease;
    overflow: hidden;
  }

  .shot:hover {
    transform: translateY(-2px);
  }

  .shot img {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top;
    cursor: zoom-in;
  }

  .shot-label {
    padding: 7px 4px 2px;
    font-size: var(--text-xs);
    font-weight: 750;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 980px) {
    .scenario { grid-template-columns: 1fr; }
    .scenario.reverse .scenario-copy,
    .scenario.reverse .scenario-visual { order: initial; }
  }

  @media (max-width: 620px) {
    .scenario-visual { grid-template-columns: 1fr; max-width: 200px; }
  }
</style>
