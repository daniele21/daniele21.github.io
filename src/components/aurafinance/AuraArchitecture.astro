---
/**
 * AuraArchitecture.astro
 * Architecture section matching prototype.
 */
import { auraFinanceData } from '../../content/auraFinance';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { architecture } = auraFinanceData;
---

<section class="section" id="architecture">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{architecture.kicker}</div>
      <h2>{architecture.title}</h2>
      <p>{architecture.sub}</p>
    </div>

    <div class="arch-wrap reveal">
      <img
        data-zoomable
        src={`${baseUrl}/${architecture.image}`}
        alt="Aura Finance local-first technical architecture"
      />
    </div>

    <div class="arch-points reveal">
      {architecture.points.map((point) => (
        <div class="arch-point">
          <h3>{point.title}</h3>
          <p>{point.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(48px, 6vw, 84px) 0;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: 10px;
    color: var(--accent-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: var(--space-2) 0 var(--space-2);
  }

  .section-head p {
    color: var(--ink-muted);
    font-size: var(--text-body);
    margin: 0;
  }

  .arch-wrap {
    padding: 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    background: #ffffff;
    box-shadow: var(--shadow-lg);
  }

  .arch-wrap img {
    border-radius: var(--radius-lg);
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }

  .arch-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .arch-point {
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .arch-point h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 6px;
  }

  .arch-point p {
    margin: 0;
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  @media (max-width: 980px) {
    .arch-points { grid-template-columns: 1fr; }
  }
</style>
