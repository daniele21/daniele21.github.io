---
/**
 * AuraHero.astro
 * Hero section for Aura Finance subpage with compact, elegant phone screenshot stage.
 */
import { auraFinanceData } from '../../content/auraFinance';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const { hero } = auraFinanceData;
---

<section class="hero aurafinance-hero" id="top">
  <div class="shell hero-grid">
    <div class="hero-copy reveal">
      <div class="eyebrow-pill">{hero.eyebrow}</div>
      <h1>{hero.titleLine1}<br><span class="blue-text">{hero.titleLine2}</span></h1>
      <p class="hero-lede" set:html={hero.lede.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="#solution">See how Aura works <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="https://github.com/daniele21/personal-budget/tree/new-features" target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>
      </div>

      <div class="pills">
        {hero.pills.map((pill) => (
          <span class="pill" set:html={pill.replace(/(Local-first|Explainable|Human-reviewed)/g, '<strong>$1</strong>')} />
        ))}
      </div>
    </div>

    <div class="phone-stage reveal" aria-label="Aura Finance Actual and Net mobile view switcher">
      <div class="stage-header">
        <div class="stage-tag">{hero.noteTitle} {hero.noteSub}</div>

        <div class="view-switch" role="tablist" aria-label="Choose ledger view">
          <button
            type="button"
            class="switch-btn active"
            data-view="actual"
            role="tab"
            aria-selected="true"
            aria-controls="view-actual-panel"
          >
            <span class="dot actual-dot"></span>
            <span class="btn-title">Actual</span>
            <span class="btn-sub">· what happened</span>
          </button>
          <button
            type="button"
            class="switch-btn"
            data-view="net"
            role="tab"
            aria-selected="false"
            aria-controls="view-net-panel"
          >
            <span class="dot net-dot"></span>
            <span class="btn-title">Net</span>
            <span class="btn-sub">· repeatable</span>
          </button>
        </div>
      </div>

      <div class="showcase-container">
        <div class="phone-view active" id="view-actual-panel" data-panel="actual" role="tabpanel">
          <div class="phone-frame">
            <img data-zoomable src={`${baseUrl}/${hero.phoneActual}`} alt="Aura Finance Actual home view - what happened" />
          </div>
          <p class="view-caption"><strong>Actual View:</strong> Tracks raw income and expenditure, including one-off purchases and edge cases.</p>
        </div>

        <div class="phone-view" id="view-net-panel" data-panel="net" role="tabpanel">
          <div class="phone-frame">
            <img data-zoomable src={`${baseUrl}/${hero.phoneNet}`} alt="Aura Finance Net home view - what is repeatable" />
          </div>
          <p class="view-caption"><strong>Net View:</strong> Filters out one-time anomalies to reveal your true baseline budget.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(40px, 5vw, 80px) 0 60px;
    position: relative;
    overflow: clip;
  }

  .aurafinance-hero::before {
    content: "";
    position: absolute;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    right: -240px;
    top: -280px;
    background: radial-gradient(circle, rgba(15, 118, 110, 0.14), transparent 68%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(24px, 3.5vw, 56px);
  }

  .hero-copy {
    max-width: 560px;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface-teal);
    color: var(--accent-teal);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 2px 10px rgba(15, 118, 110, 0.08);
  }

  .hero-copy h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.4vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--ink);
  }

  .blue-text {
    color: var(--accent-blue);
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lede {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease;
    cursor: pointer;
    border: none;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-primary {
    color: #ffffff;
    background: linear-gradient(135deg, var(--accent-blue-dark), var(--accent-teal));
    box-shadow: 0 8px 24px rgba(15, 118, 110, 0.28);
  }

  .button-secondary {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: var(--space-5);
  }

  .pill {
    padding: 6px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .pill strong {
    color: var(--accent-teal);
  }

  .phone-stage {
    position: relative;
    padding: clamp(16px, 2vw, 22px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    background: linear-gradient(145deg, var(--surface-card), var(--surface-teal));
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: 360px;
    margin-inline: auto;
    width: 100%;
  }

  .phone-stage::after {
    content: "";
    position: absolute;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    right: -100px;
    bottom: -100px;
    background: radial-gradient(circle, rgba(15, 118, 110, 0.15), transparent 70%);
    pointer-events: none;
  }

  .stage-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    z-index: 2;
  }

  .stage-tag {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-align: center;
  }

  .view-switch {
    display: inline-flex;
    align-items: center;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px;
    box-shadow: var(--shadow-sm);
    gap: 3px;
    width: auto;
  }

  .switch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 5px 12px;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--duration-fast) ease,
                color var(--duration-fast) ease,
                box-shadow var(--duration-fast) ease;
    outline: none;
  }

  .switch-btn:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .actual-dot { background: var(--accent-blue); }
  .net-dot { background: var(--accent-teal); }

  .btn-title {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--ink-muted);
  }

  .btn-sub {
    font-size: 0.68rem;
    color: var(--ink-subtle);
    font-weight: 500;
  }

  .switch-btn.active {
    background: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  .switch-btn[data-view="actual"].active .btn-title {
    color: var(--accent-blue);
  }

  .switch-btn[data-view="net"].active .btn-title {
    color: var(--accent-teal);
  }

  .showcase-container {
    width: 100%;
    max-width: 215px;
    position: relative;
    z-index: 2;
  }

  .phone-view {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: fadeInView 240ms ease-out forwards;
  }

  .phone-view.active {
    display: flex;
  }

  @keyframes fadeInView {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .phone-frame {
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 5px;
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    width: 100%;
    max-height: 380px;
    display: flex;
    align-items: flex-start;
  }

  .phone-frame img {
    border-radius: 15px;
    width: 100%;
    max-height: 370px;
    object-fit: cover;
    object-position: top;
    display: block;
    cursor: zoom-in;
  }

  .view-caption {
    font-size: 0.72rem;
    color: var(--ink-muted);
    text-align: center;
    line-height: 1.4;
    margin: 0;
    padding: 0 4px;
  }

  @media (max-width: 1020px) {
    .hero-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .view-switch { font-size: 0.7rem; }
  }
</style>

<script>
  function setupAuraViewSwitcher() {
    const stage = document.querySelector('.phone-stage');
    if (!stage) return;

    const buttons = stage.querySelectorAll<HTMLButtonElement>('.switch-btn');
    const panels = stage.querySelectorAll<HTMLElement>('.phone-view');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetView = btn.dataset.view;

        buttons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const matches = panel.dataset.panel === targetView;
          panel.classList.toggle('active', matches);
        });
      });
    });
  }

  setupAuraViewSwitcher();
  document.addEventListener('astro:page-load', setupAuraViewSwitcher);
</script>
