---
export interface Props {
  title: string;
  body: string;
  evidenced?: string[];
  missing?: string[];
}

const { title, body, evidenced = [], missing = [] } = Astro.props;
---

<div class="evidence-note">
  <div class="evidence-note-copy">
    <p class="evidence-note-kicker">EVIDENCE BOUNDARY</p>
    <p class="evidence-note-title">{title}</p>
    <p class="evidence-note-body">{body}</p>
  </div>

  {(evidenced.length > 0 || missing.length > 0) && (
    <div class="evidence-columns">
      {evidenced.length > 0 && (
        <div>
          <p class="evidence-label">Supported today</p>
          <ul>{evidenced.map((item) => <li>{item}</li>)}</ul>
        </div>
      )}
      {missing.length > 0 && (
        <div>
          <p class="evidence-label">Not claimed here</p>
          <ul>{missing.map((item) => <li>{item}</li>)}</ul>
        </div>
      )}
    </div>
  )}
</div>

<style>
  .evidence-note {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto clamp(44px, 6vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .9fr);
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(22px, 3.5vw, 36px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .evidence-note-kicker,
  .evidence-label {
    margin: 0;
    color: var(--accent-blue);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .evidence-note-title {
    margin: 10px 0 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .evidence-note-body {
    margin: 10px 0 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
    line-height: 1.65;
  }

  .evidence-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .evidence-columns ul {
    margin: 10px 0 0;
    padding-left: 18px;
    color: var(--ink);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  .evidence-columns li + li { margin-top: 6px; }

  @media (max-width: 820px) {
    .evidence-note,
    .evidence-columns { grid-template-columns: 1fr; }
    .evidence-note { width: min(1120px, calc(100% - 28px)); }
  }
</style>
