---
export interface ProjectRelationItem {
  stage: string;
  title: string;
  href?: string;
  current?: boolean;
  note?: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  items: ProjectRelationItem[];
}

const {
  eyebrow = 'CONNECTED SYSTEM',
  title = 'Where this project fits',
  items,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const resolveHref = (href: string) => href.startsWith('http') || href.startsWith('#')
  ? href
  : `${baseUrl}/${href.replace(/^\//, '')}`;
---

<section class="project-relations" aria-labelledby="project-relations-title">
  <div class="shell relations-shell">
    <header class="relations-header">
      <p>{eyebrow}</p>
      <h2 id="project-relations-title">{title}</h2>
    </header>

    <div class="relations-track">
      {items.map((item, index) => (
        <>
          {item.href && !item.current ? (
            <a class="relation-node" href={resolveHref(item.href)}>
              <span class="relation-stage">{item.stage}</span>
              <strong>{item.title}</strong>
              {item.note && <span class="relation-note">{item.note}</span>}
            </a>
          ) : (
            <div class:list={['relation-node', item.current && 'is-current']} aria-current={item.current ? 'step' : undefined}>
              <span class="relation-stage">{item.stage}</span>
              <strong>{item.title}</strong>
              {item.note && <span class="relation-note">{item.note}</span>}
            </div>
          )}
          {index < items.length - 1 && <span class="relation-arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .project-relations {
    border-top: 1px solid var(--border-subtle);
    padding: clamp(48px, 6vw, 72px) 0;
    background: var(--surface-subtle);
  }

  .relations-shell {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
  }

  .relations-header {
    max-width: 700px;
  }

  .relations-header p {
    margin: 0 0 6px;
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .relations-header h2 {
    margin: 0;
    color: var(--ink-display);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.7rem);
    font-weight: 820;
    letter-spacing: -0.04em;
  }

  .relations-track {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(10px, 2vw, 22px);
    align-items: center;
  }

  .relation-node {
    min-height: 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: clamp(18px, 2.5vw, 24px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: var(--ink-display);
    text-decoration: none;
    transition:
      transform var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  a.relation-node:hover {
    transform: translateY(-2px);
    border-color: var(--accent-blue);
    box-shadow: var(--shadow-md);
  }

  .relation-node.is-current {
    border-color: color-mix(in srgb, var(--accent-blue) 45%, var(--border-medium));
    background: var(--surface-blue-subtle);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent-blue) 8%, transparent);
  }

  .relation-stage {
    color: var(--accent-blue-dark);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 820;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .relation-node strong {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.3;
  }

  .relation-note {
    color: var(--ink-muted);
    font-size: var(--text-caption);
    line-height: 1.45;
  }

  .relation-arrow {
    color: var(--ink-subtle);
    font-size: 1.25rem;
  }

  @media (max-width: 760px) {
    .relations-track {
      grid-template-columns: 1fr;
    }

    .relation-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }

    .relation-node {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .relation-node { transition: none; }
  }
</style>
