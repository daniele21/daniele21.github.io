---
import { trafficMonitoringAndroidData as android } from '../../../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<section class="maturity-section" id="status">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">CURRENT MATURITY & VALIDATION GAPS</span>
      <h2 class="section-title">{android.maturity.title}</h2>
    </div>

    <!-- Harness Relationship Box -->
    <div class="harness-relationship-box">
      <div class="relationship-header">
        <h3 class="rel-title">{android.harnessRelationship.title}</h3>
        <p class="rel-desc">{android.harnessRelationship.description}</p>
      </div>

      <div class="rel-grid">
        <a href={`${baseUrl}/android-local-llm-harness`} class="rel-card">
          <span class="rel-badge">LOCAL AI PILLAR</span>
          <h4 class="card-title">{android.harnessRelationship.harnessBox.title}</h4>
          <p class="card-text">{android.harnessRelationship.harnessBox.text}</p>
        </a>

        <div class="rel-card">
          <span class="rel-badge badge-evidence">EVIDENCE PILLAR</span>
          <h4 class="card-title">{android.harnessRelationship.trafficBox.title}</h4>
          <p class="card-text">{android.harnessRelationship.trafficBox.text}</p>
        </div>
      </div>
    </div>

    <!-- Maturity Lists Grid -->
    <div class="maturity-grid">
      <div class="maturity-card card-implemented">
        <h3 class="group-title">✓ Implemented Capabilities</h3>
        <ul class="group-list">
          {android.maturity.implemented.map((item) => (
            <li>
              <span class="bullet-check">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="maturity-card card-pending">
        <h3 class="group-title">⏳ Field Validation Pending</h3>
        <ul class="group-list">
          {android.maturity.fieldValidationRequired.map((item) => (
            <li>
              <span class="bullet-pending">⏳</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="maturity-card card-planned">
        <h3 class="group-title">🔮 Planned Milestones</h3>
        <ul class="group-list">
          {android.maturity.planned.map((item) => (
            <li>
              <span class="bullet-plan">❖</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .maturity-section {
    padding: var(--space-20) 0;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue-light, #0dc1f9);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
  }

  .harness-relationship-box {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-12);
  }

  .relationship-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-6);
  }

  .rel-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .rel-desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .rel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .rel-grid {
      grid-template-columns: 1fr;
    }
  }

  .rel-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    display: block;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  a.rel-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-blue-light, #0dc1f9);
  }

  .rel-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-2);
  }

  .badge-evidence {
    color: var(--accent-blue-light, #0dc1f9);
  }

  .card-title {
    font-size: var(--text-base);
    font-weight: 750;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .card-text {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .maturity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .maturity-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
  }

  .card-implemented { border-top: 4px solid #22c55e; }
  .card-pending { border-top: 4px solid #f59e0b; }
  .card-planned { border-top: 4px solid #64748b; }

  .group-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .group-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .group-list li {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    line-height: 1.5;
  }

  .bullet-check { color: #22c55e; font-weight: 800; }
  .bullet-pending { color: #f59e0b; font-weight: 800; }
  .bullet-plan { color: #64748b; font-weight: 800; }
</style>
