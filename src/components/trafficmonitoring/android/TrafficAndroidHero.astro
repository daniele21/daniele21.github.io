---
import { trafficMonitoringAndroidData as android } from '../../../content';
import TrafficBrandMark from '../shared/TrafficBrandMark.astro';
import GitHubIcon from '../../icons/GitHubIcon.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<section class="android-hero-section" id="hero">
  <div class="shell">
    <div class="hero-header">
      <div class="hero-brand">
        <TrafficBrandMark size={48} variant="android" />
        <span class="eyebrow">{android.hero.eyebrow}</span>
        <a href={`${baseUrl}/traffic-monitoring`} class="platform-switch-link" title="Switch to macOS implementation">
           macOS Version →
        </a>
      </div>
      <h1 class="headline">
        {android.hero.headline}<span class="highlight">{android.hero.headlineHighlight}</span>
      </h1>
      <p class="lede">{android.hero.lede}</p>

      <div class="status-tags">
        {android.hero.statusLabels.map((label) => (
          <span class="status-tag">{label}</span>
        ))}
      </div>

      <div class="hero-actions">
        <a href={android.hero.primaryCtaHref} class="btn-primary">
          {android.hero.primaryCtaLabel}
        </a>
        <a
          href={android.hero.secondaryCtaHref}
          class="btn-secondary btn-icon-only"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub repository"
          title="GitHub"
        >
          <GitHubIcon size={19} />
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="device-frame">
        <div class="device-header">
          <span class="notch"></span>
          <span class="device-title">Traffic Monitoring Android</span>
        </div>
        <button
          type="button"
          class="zoom-trigger-btn"
          data-zoom-src={`${baseUrl}/${android.hero.heroImage.replace(/^\//, '')}`}
          data-zoom-caption="Traffic Monitoring for Android - Overview Dashboard"
          aria-label="Click to zoom Android Overview screenshot"
        >
          <img
            src={`${baseUrl}/${android.hero.heroImage.replace(/^\//, '')}`}
            alt="Sanitized Android Overview screenshot"
            class="hero-img"
            loading="eager"
            width="800"
            height="500"
          />
          <span class="zoom-badge">🔍 Click to Zoom</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .android-hero-section {
    padding: var(--space-16) 0 var(--space-20);
    background: radial-gradient(circle at 50% 0%, rgba(13, 193, 249, 0.12), transparent 70%);
  }

  .hero-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-12);
  }

  .hero-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-blue-light, #0dc1f9);
    text-transform: uppercase;
  }

  .platform-switch-link {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    margin-left: var(--space-2);
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .platform-switch-link:hover {
    color: var(--accent-blue-light, #0dc1f9);
    border-color: var(--accent-blue-light, #0dc1f9);
  }

  .headline {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 850;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .highlight {
    color: var(--accent-blue-light, #0dc1f9);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .status-tags {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .status-tag {
    font-size: var(--text-xs);
    font-weight: 650;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-primary {
    padding: 12px 24px;
    border-radius: var(--radius-full);
    background: var(--accent-blue-light, #0dc1f9);
    color: #020d2c;
    font-size: var(--text-sm);
    font-weight: 750;
    text-decoration: none;
    transition: transform var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    background: #207cce;
    color: #ffffff;
  }

  .btn-secondary {
    padding: 12px 24px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--accent-blue-light, #0dc1f9);
  }

  .btn-secondary.btn-icon-only {
    width: 44px;
    height: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hero-visual {
    max-width: 780px;
    margin: 0 auto;
  }

  .device-frame {
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .device-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 12px 16px;
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border-subtle);
  }

  .notch {
    width: 60px;
    height: 6px;
    border-radius: 3px;
    background: var(--border-subtle);
    position: absolute;
    left: 24px;
  }

  .device-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .zoom-trigger-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
    position: relative;
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .zoom-badge {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }
</style>
