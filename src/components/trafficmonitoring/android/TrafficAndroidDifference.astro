---
import { trafficMonitoringAndroidData as android } from '../../../content';
---

<section class="difference-section" id="why-different">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">PRODUCT PHILOSOPHY</span>
      <h2 class="section-title">{android.difference.title}</h2>
      <p class="section-subtitle">{android.difference.subtitle}</p>
    </div>

    <div class="questions-grid">
      {android.difference.questions.map((q, idx) => (
        <div class="question-card">
          <span class="q-num">Question 0{idx + 1}</span>
          <h3 class="q-title">{q.question}</h3>
          <p class="q-answer">{q.answer}</p>
          <ul class="q-details">
            {q.details.map((detail) => (
              <li>
                <span class="bullet">•</span>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .difference-section {
    padding: var(--space-16) 0;
    background: var(--surface-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue-light, #0dc1f9);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .questions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-8);
  }

  .question-card {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .q-num {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-blue-light, #0dc1f9);
    display: block;
    margin-bottom: var(--space-2);
  }

  .q-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .q-answer {
    font-size: var(--text-sm);
    color: var(--ink);
    font-weight: 650;
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .q-details {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2.5);
  }

  .q-details li {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    line-height: 1.4;
  }

  .bullet {
    color: var(--accent-blue-light, #0dc1f9);
    font-weight: 800;
  }
</style>
