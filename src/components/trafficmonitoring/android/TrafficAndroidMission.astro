---
import { trafficMonitoringAndroidData as android } from '../../../content';
---

<section class="mission-section" id="mission">
  <div class="shell">
    <div class="mission-card">
      <h2 class="mission-statement">"{android.mission.statement}"</h2>
      <p class="mission-copy">{android.mission.supportingCopy}</p>
      <div class="principles-row">
        {android.mission.principles.map((item) => (
          <span class="principle-pill">✓ {item}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .mission-section {
    padding: var(--space-12) 0;
  }

  .mission-card {
    padding: var(--space-10) var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
  }

  .mission-statement {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
    line-height: 1.3;
  }

  .mission-copy {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 720px;
    margin-inline: auto;
  }

  .principles-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .principle-pill {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-blue-light, #0dc1f9);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
  }
</style>
