---
import { trafficMonitoringAndroidData as android } from '../../../content';
---

<section class="roadmap-section" id="roadmap">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">PARALLEL DEVELOPMENT TRACKS</span>
      <h2 class="section-title">{android.roadmap.title}</h2>
      <p class="section-subtitle">{android.roadmap.subtitle}</p>
    </div>

    <div class="tracks-grid">
      <!-- M Roadmap Track -->
      <div class="track-card">
        <div class="track-header">
          <span class="track-tag">M ROADMAP</span>
          <h3 class="track-title">Android Measurement Reliability</h3>
        </div>
        <div class="roadmap-items">
          {android.roadmap.mRoadmap.map((item) => (
            <div class="roadmap-item">
              <div class="item-meta">
                <span class="item-code">{item.code}</span>
                <span class={`status-pill status-${item.status}`}>{item.statusLabel}</span>
              </div>
              <h4 class="item-name">{item.name}</h4>
              <p class="item-desc">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- E Roadmap Track -->
      <div class="track-card">
        <div class="track-header">
          <span class="track-tag tag-evidence">E ROADMAP</span>
          <h3 class="track-title">Evidence-First Product Roadmap</h3>
        </div>
        <div class="roadmap-items">
          {android.roadmap.eRoadmap.map((item) => (
            <div class="roadmap-item">
              <div class="item-meta">
                <span class="item-code">{item.code}</span>
                <span class={`status-pill status-${item.status}`}>{item.statusLabel}</span>
              </div>
              <h4 class="item-name">{item.name}</h4>
              <p class="item-desc">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap-section {
    padding: var(--space-20) 0;
    background: var(--surface-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue-light, #0dc1f9);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 900px) {
    .tracks-grid {
      grid-template-columns: 1fr;
    }
  }

  .track-card {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .track-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .track-tag {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 4px;
  }

  .track-tag.tag-evidence {
    color: var(--accent-blue-light, #0dc1f9);
  }

  .track-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
  }

  .roadmap-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .roadmap-item {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
  }

  .item-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .item-code {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-blue-light, #0dc1f9);
  }

  .status-pill {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .status-implemented,
  .status-pass-emulator {
    background: rgba(34, 197, 94, 0.15);
    color: #15803d;
  }

  .status-field-pending {
    background: rgba(245, 158, 11, 0.15);
    color: #b45309;
  }

  .status-planned,
  .status-exploratory {
    background: rgba(100, 116, 139, 0.15);
    color: #475569;
  }

  .item-name {
    font-size: var(--text-sm);
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .item-desc {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.4;
  }
</style>
