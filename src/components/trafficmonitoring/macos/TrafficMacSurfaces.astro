---
import { trafficMonitoringData as mac } from '../../../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<section class="surfaces-section" id="product-surfaces">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">PRODUCT SURFACES IN ACTION</span>
      <h2 class="section-title">{mac.surfaces.title}</h2>
      <p class="section-subtitle">{mac.surfaces.subtitle}</p>
    </div>

    <div class="surfaces-stack">
      {mac.surfaces.items.map((surface, idx) => (
        <div class="surface-card">
          <div class="surface-info">
            <div class="surface-header">
              <span class="surface-num">0{idx + 1}</span>
              <span class="surface-badge">{surface.capabilityLabel}</span>
            </div>
            <h3 class="surface-name">{surface.name}</h3>
            <h4 class="surface-question">"{surface.question}"</h4>
            <p class="surface-desc">{surface.description}</p>
          </div>

          <div class="surface-media">
            <button
              type="button"
              class="zoom-trigger-btn"
              data-zoom-src={`${baseUrl}/${surface.imagePath.replace(/^\//, '')}`}
              data-zoom-caption={`${surface.name} - ${surface.question}`}
              aria-label={`Click to zoom ${surface.name} screenshot`}
            >
              <img
                src={`${baseUrl}/${surface.imagePath.replace(/^\//, '')}`}
                alt={surface.altText}
                class="surface-img"
                loading="lazy"
                width="800"
                height="500"
              />
              <span class="zoom-badge">🔍 Zoom</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .surfaces-section {
    padding: var(--space-20) 0;
    background: var(--surface-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .surfaces-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .surface-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 900px) {
    .surface-card {
      grid-template-columns: 1fr;
    }
  }

  .surface-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .surface-num {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-blue);
  }

  .surface-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink-muted);
  }

  .surface-name {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .surface-question {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-blue);
    font-style: italic;
    margin-bottom: var(--space-4);
  }

  .surface-desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .surface-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-muted);
  }

  .zoom-trigger-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
    position: relative;
  }

  .surface-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform var(--duration-fast) ease;
  }

  .zoom-trigger-btn:hover .surface-img {
    transform: scale(1.02);
  }

  .zoom-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }
</style>
