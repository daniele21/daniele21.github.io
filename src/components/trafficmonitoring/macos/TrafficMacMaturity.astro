---
import { trafficMonitoringData as mac } from '../../../content';
---

<section class="maturity-section" id="status">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">ACCURACY & MATURITY MATRIX</span>
      <h2 class="section-title">{mac.maturity.title}</h2>
    </div>

    <div class="matrix-table-wrapper">
      <table class="maturity-table">
        <thead>
          <tr>
            <th>Capability</th>
            <th>Display Status</th>
            <th>Notes & Safeguards</th>
          </tr>
        </thead>
        <tbody>
          {mac.maturity.matrix.map((row) => (
            <tr>
              <td class="cap-cell">{row.capability}</td>
              <td>
                <span class={`status-badge status-${row.displayStatus.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}>
                  {row.displayStatus}
                </span>
              </td>
              <td class="note-cell">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .maturity-section {
    padding: var(--space-20) 0;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-10);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
  }

  .matrix-table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .maturity-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: var(--text-sm);
  }

  .maturity-table th {
    padding: var(--space-4) var(--space-6);
    background: var(--surface-muted);
    font-weight: 750;
    color: var(--ink);
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .maturity-table td {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .maturity-table tr:last-child td {
    border-bottom: none;
  }

  .cap-cell {
    font-weight: 700;
    color: var(--ink);
  }

  .note-cell {
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    display: inline-block;
    white-space: nowrap;
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
  }

  .status-implemented {
    background: rgba(34, 197, 94, 0.15);
    color: #15803d;
    border-color: rgba(34, 197, 94, 0.3);
  }

  .status-beta---best-effort,
  .status-best-effort {
    background: rgba(13, 193, 249, 0.15);
    color: #0369a1;
    border-color: rgba(13, 193, 249, 0.3);
  }

  .status-experimental,
  .status-not-release-validated {
    background: rgba(245, 158, 11, 0.15);
    color: #b45309;
    border-color: rgba(245, 158, 11, 0.3);
  }

  .status-future {
    background: rgba(100, 116, 139, 0.15);
    color: #475569;
  }
</style>
