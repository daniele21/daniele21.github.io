---
import { trafficMonitoringData as mac } from '../../../content';
---

<section class="tiers-section" id="evidence-tiers">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">EVIDENCE MODEL</span>
      <h2 class="section-title">{mac.tiers.title}</h2>
      <p class="section-subtitle">{mac.tiers.subtitle}</p>
    </div>

    <div class="tiers-stack">
      {mac.tiers.items.map((tier) => (
        <div class={`tier-card tier-${tier.status}`}>
          <div class="tier-badge-row">
            <span class="tier-number">Tier {tier.tierNumber}</span>
            <span class={`status-badge badge-${tier.status}`}>{tier.statusLabel}</span>
          </div>

          <div class="tier-header">
            <h3 class="tier-title">{tier.title}</h3>
            <p class="tier-subtitle">{tier.subtitle}</p>
          </div>

          <div class="tier-body">
            <ul class="tier-features">
              {tier.features.map((feat) => (
                <li>
                  <span class="bullet">•</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <div class="safe-conclusion-box">
              <span class="box-label">SAFE PUBLIC CONCLUSION:</span>
              <p class="box-text">"{tier.safeConclusion}"</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tiers-section {
    padding: var(--space-20) 0;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .tiers-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .tier-card {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease;
  }

  .tier-card.tier-authoritative {
    border-left: 4px solid var(--accent-blue);
  }

  .tier-card.tier-preview {
    border-left: 4px solid var(--accent-blue-light, #0dc1f9);
  }

  .tier-card.tier-experimental {
    border-left: 4px solid var(--semantic-warning, #f59e0b);
  }

  .tier-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .tier-number {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
  }

  .status-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .badge-authoritative {
    background: rgba(32, 124, 206, 0.15);
    color: var(--accent-blue);
  }

  .badge-preview {
    background: rgba(13, 193, 249, 0.15);
    color: #0284c7;
  }

  .badge-experimental {
    background: rgba(245, 158, 11, 0.15);
    color: #b45309;
  }

  .tier-header {
    margin-bottom: var(--space-6);
  }

  .tier-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-1);
  }

  .tier-subtitle {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .tier-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (max-width: 768px) {
    .tier-body {
      grid-template-columns: 1fr;
    }
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2.5);
  }

  .tier-features li {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    line-height: 1.5;
  }

  .bullet {
    color: var(--accent-blue);
    font-weight: 800;
  }

  .safe-conclusion-box {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
  }

  .box-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    display: block;
    margin-bottom: var(--space-2);
  }

  .box-text {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--ink);
    font-style: italic;
    line-height: 1.5;
  }
</style>
