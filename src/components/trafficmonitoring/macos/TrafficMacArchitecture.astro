---
import { trafficMonitoringData as mac } from '../../../content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<section class="arch-section" id="architecture">
  <div class="shell">
    <div class="section-header">
      <span class="kicker">SYSTEM DESIGN</span>
      <h2 class="section-title">{mac.architecture.title}</h2>
      <p class="section-subtitle">{mac.architecture.subtitle}</p>
    </div>

    <!-- Simplified Flow -->
    <div class="flow-box">
      <span class="flow-title">DATA PIPELINE FLOW</span>
      <div class="flow-steps">
        {mac.architecture.simplifiedFlow.map((step) => (
          step === '↓' ? (
            <span class="flow-arrow">↓</span>
          ) : (
            <div class="flow-step-card">{step}</div>
          )
        ))}
      </div>
    </div>

    <!-- Architecture Visual & Technical Details -->
    <div class="arch-content">
      <div class="arch-media">
        <button
          type="button"
          class="zoom-trigger-btn"
          data-zoom-src={`${baseUrl}/${mac.architecture.imagePath.replace(/^\//, '')}`}
          data-zoom-caption="Traffic Monitoring for macOS - Architecture Diagram"
          aria-label="Click to zoom Architecture Diagram"
        >
          <img
            src={`${baseUrl}/${mac.architecture.imagePath.replace(/^\//, '')}`}
            alt="Traffic Monitoring macOS Architecture Diagram"
            class="arch-img"
            loading="lazy"
            width="900"
            height="560"
          />
          <span class="zoom-badge">🔍 Zoom Diagram</span>
        </button>
      </div>

      <div class="arch-details-card">
        <h3 class="details-title">Key Architectural Features</h3>
        <ul class="details-list">
          {mac.architecture.details.map((item) => (
            <li>
              <span class="bullet">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .arch-section {
    padding: var(--space-20) 0;
    background: var(--surface-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .flow-box {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-12);
  }

  .flow-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: var(--space-4);
  }

  .flow-steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .flow-step-card {
    font-size: var(--text-xs);
    font-weight: 650;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    width: 100%;
    max-width: 600px;
  }

  .flow-arrow {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--accent-blue);
  }

  .arch-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (max-width: 900px) {
    .arch-content {
      grid-template-columns: 1fr;
    }
  }

  .arch-media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-muted);
  }

  .zoom-trigger-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
    position: relative;
  }

  .arch-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .zoom-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  .arch-details-card {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
  }

  .details-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .details-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .details-list li {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    line-height: 1.5;
  }

  .bullet {
    color: var(--accent-blue);
    font-weight: 800;
  }
</style>
