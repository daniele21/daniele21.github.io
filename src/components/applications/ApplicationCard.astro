---
/**
 * ApplicationCard - Card for reference applications (ClosedRoom, Aura Finance).
 */
import type { ReferenceApplication } from '../../types/content';

interface Props {
  application: ReferenceApplication;
}

const { application } = Astro.props;
---

<article class="application-card reveal">
  <div class="application-identity">
    <img src={application.logoPath} alt={`${application.name} logo`} class="application-logo-img" />
    <div>
      <span class={`status ${application.status === 'experimental' ? 'status-progress' : 'status-active'}`}>{application.statusLabel}</span>
      <h3>{application.name}</h3>
      <p class="application-tagline" set:html={application.tagline}></p>
    </div>
  </div>
  <p set:html={application.description}></p>
  <div class="feature-badges">
    {application.features.map((feature) => (
      <span class="feature-badge">{feature}</span>
    ))}
  </div>
  <details class="project-disclosure" style="margin-top: 20px;">
    <summary>What it validates <span aria-hidden="true">+</span></summary>
    <div class="disclosure-body">
      <ul>
        {application.validates.map((item) => (
          <li set:html={item}></li>
        ))}
      </ul>
      {application.repositoryUrl && (
        <div class="project-links">
          <a href={application.repositoryUrl} target="_blank" rel="noreferrer">View repository ↗</a>
        </div>
      )}
    </div>
  </details>
</article>

<style>
  .application-card {
    padding: clamp(28px, 4vw, 40px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.97), rgba(240, 246, 255, 0.86));
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .application-identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .application-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    box-shadow: 0 10px 20px rgba(10, 26, 58, 0.12);
    background: #ffffff;
    padding: 6px;
  }

  .application-identity h3 {
    margin: 4px 0 2px;
    font-size: 1.35rem;
  }

  .application-tagline {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    font-size: var(--text-small);
  }

  .application-card > p {
    margin: var(--space-5) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .status {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 24px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .status-active { color: var(--status-active-text); background: var(--status-active-bg); }
  .status-progress { color: var(--status-progress-text); background: var(--status-progress-bg); }

  .feature-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .feature-badge {
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--ink-muted);
  }

  .project-disclosure {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .project-disclosure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--accent-blue);
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    list-style: none;
  }

  .project-disclosure summary::-webkit-details-marker { display: none; }
  .project-disclosure summary span { font-size: 1.2rem; transition: transform 160ms ease; }
  .project-disclosure[open] summary span { transform: rotate(45deg); }

  .disclosure-body {
    padding-top: var(--space-3);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .disclosure-body ul { padding-left: var(--space-5); margin-top: var(--space-2); }
  .disclosure-body li { margin-bottom: var(--space-1); }
  .project-links { margin-top: var(--space-4); }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-small);
  }

  .project-links a:hover { text-decoration: underline; }

  @media (max-width: 580px) {
    .application-identity { align-items: flex-start; }
  }
</style>
