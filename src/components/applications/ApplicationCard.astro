---
/**
 * ApplicationCard - Card for reference applications (ClosedRoom, Aura Finance).
 */
import type { ReferenceApplication } from '../../types/content';

interface Props {
  application: ReferenceApplication;
}

const { application } = Astro.props;
const targetUrl = application.pageUrl ? `${import.meta.env.BASE_URL}${application.pageUrl.replace(/^\//, '')}` : null;
---

<article 
  class={`application-card reveal ${targetUrl ? 'is-clickable' : ''}`}
  data-href={targetUrl || undefined}
>
  <div class="card-top-bar">
    {application.microLabel ? (
      <span class="app-micro-label">{application.microLabel}</span>
    ) : <span></span>}
    <span class={`status ${application.status === 'experimental' ? 'status-progress' : 'status-active'}`}>{application.statusLabel}</span>
  </div>
  <div class="application-identity">
    <img src={`${import.meta.env.BASE_URL}${application.logoPath.replace(/^\//, '')}`} alt={`${application.name} logo`} class="application-logo-img" />
    <div>
      <h3>
        {targetUrl ? (
          <a href={targetUrl} class="app-title-link">
            {application.name} →
          </a>
        ) : (
          application.name
        )}
      </h3>
      <p class="application-tagline" set:html={application.tagline}></p>
    </div>
  </div>
  <p class="application-description" set:html={application.description}></p>
  <div class="feature-badges">
    {application.features.map((feature) => (
      <span class="feature-badge">{feature}</span>
    ))}
  </div>
  {application.provesLine && (
    <div class="app-proves-bar">
      <div class="proves-badge">
        <svg class="proves-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
        <span>PROVES</span>
      </div>
      <span class="proves-text">{application.provesLine.replace(/^PROVES\s*(?:→|->)\s*/i, '')}</span>
    </div>
  )}
  <details class="project-disclosure">
    <summary>What it validates <span aria-hidden="true">+</span></summary>
    <div class="disclosure-body">
      <ul>
        {application.validates.map((item) => (
          <li set:html={item}></li>
        ))}
      </ul>
      <div class="project-links">
        {targetUrl && (
          <a href={targetUrl} class="deep-dive-btn">Read Deep-Dive →</a>
        )}
        {application.repositoryUrl && (
          <a href={application.repositoryUrl} target="_blank" rel="noreferrer" class="repo-link">View repository ↗</a>
        )}
      </div>
    </div>
  </details>
</article>

<script>
  document.querySelectorAll<HTMLElement>('.application-card.is-clickable').forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      // Do not trigger card navigation if clicking interactive elements inside
      if (target.closest('a, details, summary, button')) {
        return;
      }
      const href = card.dataset.href;
      if (href) {
        window.location.href = href;
      }
    });
  });
</script>

<style>
  .application-card {
    padding: clamp(24px, 3.5vw, 36px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-sm);
    grid-row: span 6;
    display: grid;
    grid-template-rows: subgrid;
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) ease;
  }

  .application-card.is-clickable {
    cursor: pointer;
  }

  .application-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    width: 100%;
  }

  .app-micro-label {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    text-transform: uppercase;
    margin: 0;
  }

  .application-identity {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin: 0;
  }

  .application-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    box-shadow: 0 10px 24px rgba(10, 26, 58, 0.14);
    background: #ffffff;
    padding: 6px;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .application-card:hover .application-logo-img {
    transform: scale(1.06);
  }

  .application-identity h3 {
    margin: 4px 0 2px;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--ink);
  }

  .app-title-link {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .app-title-link:hover {
    color: var(--accent-blue);
  }

  .application-tagline {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    font-size: var(--text-small);
    line-height: 1.35;
  }

  .application-description {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .status {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 24px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-left: auto;
  }

  .status-active { color: var(--status-active-text); background: var(--status-active-bg); }
  .status-progress { color: var(--status-progress-text); background: var(--status-progress-bg); }

  .feature-badges {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2);
    margin: 0;
  }

  .feature-badge {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--ink-muted);
    transition: transform var(--duration-fast) ease,
                background-color var(--duration-fast) ease,
                color var(--duration-fast) ease,
                border-color var(--duration-fast) ease;
  }

  .feature-badge:hover {
    transform: translateY(-1px);
    background-color: var(--surface-blue);
    color: var(--accent-blue);
    border-color: var(--accent-blue-light);
  }

  .app-proves-bar {
    margin: 0;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.04) 0%, rgba(59, 130, 246, 0.08) 100%);
    border: 1px solid rgba(37, 99, 235, 0.16);
    border-left: 3px solid var(--accent-blue);
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.04);
    transition: all var(--duration-fast) ease;
  }

  .application-card:hover .app-proves-bar {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.07) 0%, rgba(59, 130, 246, 0.12) 100%);
    border-color: rgba(37, 99, 235, 0.28);
    border-left-color: var(--accent-blue);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
  }

  .proves-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: var(--radius-sm);
    background: var(--accent-blue);
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.22);
  }

  .proves-icon {
    flex-shrink: 0;
  }

  .proves-text {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--ink);
    line-height: 1.35;
    letter-spacing: -0.005em;
  }

  .project-disclosure {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .project-disclosure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--accent-blue);
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-fast) ease;
  }

  .project-disclosure summary:hover {
    color: var(--accent-blue-light);
  }

  .project-disclosure summary::-webkit-details-marker { display: none; }
  .project-disclosure summary span { font-size: 1.2rem; transition: transform var(--duration-fast) ease; }
  .project-disclosure[open] summary span { transform: rotate(45deg); }

  .disclosure-body {
    padding-top: var(--space-3);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .disclosure-body ul { padding-left: var(--space-5); margin-top: var(--space-2); }
  .disclosure-body li { margin-bottom: var(--space-1); }
  .project-links { margin-top: var(--space-4); }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-small);
    transition: color var(--duration-fast) ease;
  }

  .project-links a:hover {
    color: var(--accent-blue-light);
    text-decoration: underline;
  }

  @media (max-width: 1040px) {
    .application-card {
      grid-row: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .app-proves-bar {
      margin-top: auto;
    }
  }

  @media (max-width: 580px) {
    .application-card { padding: 22px 18px; }
    .application-identity { align-items: flex-start; gap: 12px; }
    .application-logo-img { width: 52px; height: 52px; }
  }
</style>


