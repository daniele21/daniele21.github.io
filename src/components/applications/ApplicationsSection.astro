---
/**
 * ApplicationsSection - Section presenting the reference applications.
 */
import ApplicationCard from './ApplicationCard.astro';
import { applications } from '../../content/applications';
---

<section class="section section-applications" id="applications" aria-labelledby="applications-title">
  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker">PROVING GROUNDS</p>
        <h2 id="applications-title">Reference applications that validate the stack</h2>
      </div>
      <p>ClosedRoom, RedactGuard, and Aura Finance demonstrate how privacy-first AI protects conversations, sensitive documents, and personal financial data in practice.</p>
    </div>

    <div class="application-grid">
      {applications.map((app) => (
        <ApplicationCard application={app} />
      ))}
    </div>

    <div class="apps-note reveal">
      <svg style="width:20px;height:20px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <span>Reference applications validate the infrastructure and show what it can enable. They are the beginning, not the limit, of the ecosystem.</span>
    </div>
  </div>
</section>

<style>
  .section-applications {
    background: linear-gradient(180deg, transparent, rgba(235, 242, 255, 0.52), transparent);
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto 1fr auto auto auto;
    row-gap: var(--space-4);
    column-gap: var(--space-5);
  }

  .apps-note {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    border-left: 3px solid var(--accent-blue);
    color: var(--ink-muted);
    font-size: var(--text-small);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 1040px) {
    .application-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      gap: var(--space-5);
    }
  }

  @media (max-width: 720px) {
    .application-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: var(--space-5);
    }
  }
</style>
