---
/**
 * CredibilitySection - Professional Track Record & Proof Points.
 * Engineering and research credibility designed in clean blue/neutral aesthetic.
 */
import { credibilityProofs, getContent } from '../../content';

const { credibility: cred } = getContent().home;
---

<section class="section section-credibility" id="credibility" aria-labelledby="credibility-title">
  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker">{cred.kicker}</p>
        <h2 id="credibility-title">
          {cred.titlePrefix}<strong>{cred.titleHighlight}</strong>
        </h2>
      </div>
      <p class="credibility-intro-text">
        {cred.introText}
      </p>
    </div>


    <div class="credibility-grid">
      {credibilityProofs.map((item) => (
        <article class="credibility-card reveal">
          <div class="metric-display">
            <span class="metric-value">{item.metric}</span>
          </div>

          <div class="card-content">
            <h3>{item.title}</h3>
            <p class="card-subtitle">{item.subtitle}</p>
            <p class="card-description">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-credibility {
    position: relative;
    background: var(--surface-card);
    border-block: 1px solid var(--border-subtle);
    padding: clamp(60px, 8vw, 96px) 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-10);
  }

  .section-heading h2 strong {
    color: var(--accent-blue);
  }

  .credibility-intro-text {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* Grid Layout */
  .credibility-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  /* Card Base Styling */
  .credibility-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-canvas);
    border: 1px solid var(--border-subtle);
    transition: transform var(--duration-fast) ease,
                border-color var(--duration-fast) ease,
                box-shadow var(--duration-fast) ease;
  }

  .credibility-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .metric-display {
    margin-bottom: var(--space-4);
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent-blue);
    letter-spacing: -0.02em;
  }

  .card-content h3 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .card-subtitle {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .card-description {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  @media (max-width: 1040px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .credibility-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .credibility-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
