---
/**
 * CredibilitySection - Premium evidence & track record from professional leadership.
 * Displays executive-level proof points with high-contrast, ultra-readable Gold metallic styling.
 * Column 1 (Min Gold) to Column 4 (Max Gold) progression with 100% WCAG legibility.
 */
import { credibilityIntro, credibilityProofs } from '../../content/credibility';

const goldAccents = ['gold-min', 'gold-med', 'gold-high', 'gold-max'] as const;
---

<section class="section section-credibility" id="credibility" aria-labelledby="credibility-title">
  <div class="gold-ambient-glow" aria-hidden="true"></div>

  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker">
          <span class="kicker-dot"></span>
          REAL-WORLD EVIDENCE & TRACK RECORD
        </p>
        <h2 id="credibility-title">
          Proven capability to <span class="gold-gradient-text">deliver at scale</span>
        </h2>
      </div>
      
      <div class="quote-card">
        <p class="quote-text">"{credibilityIntro.quote}"</p>
        <span class="quote-author">— Daniele Moltisanti</span>
      </div>
    </div>

    <div class="credibility-grid">
      {credibilityProofs.map((item, index) => {
        const accentLevel = goldAccents[index % 4];
        return (
          <div class="credibility-card reveal" data-accent={accentLevel}>
            <div class="card-top-bar" aria-hidden="true"></div>

            <div class="card-header">
              <div class="icon-avatar">
                {item.iconType === 'leadership' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
                {item.iconType === 'articles' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h8M8 11h6"/></svg>
                )}
                {item.iconType === 'mentoring' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                )}
                {item.iconType === 'award' && (
                  <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                )}
              </div>

              {item.metric && (
                <div class="metric-badge">
                  <span>{item.metric}</span>
                </div>
              )}
            </div>

            <div class="card-body">
              <span class="card-tag">{item.tag || item.subtitle}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>

            <div class="card-footer">
              <span class="card-subtitle">{item.subtitle}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .section-credibility {
    position: relative;
    background: var(--surface-canvas);
    border-block: 1px solid var(--border-subtle);
    padding: clamp(60px, 8vw, 96px) 0;
    overflow: hidden;
  }

  .gold-ambient-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 380px;
    background: radial-gradient(ellipse at center, rgba(217, 119, 6, 0.08), transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="dark"] .gold-ambient-glow {
    background: radial-gradient(ellipse at center, rgba(251, 191, 36, 0.12), transparent 75%);
  }

  .shell {
    position: relative;
    z-index: 1;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-10);
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: #78350f;
    margin-bottom: var(--space-2);
  }

  [data-theme="dark"] .section-kicker {
    color: #fde047;
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d97706;
    box-shadow: 0 0 10px #f59e0b;
    animation: gold-kicker-pulse 2s infinite ease-in-out;
  }

  @keyframes gold-kicker-pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }

  .gold-gradient-text {
    background: linear-gradient(135deg, #713f12 0%, #b45309 45%, #92400e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
  }

  [data-theme="dark"] .gold-gradient-text {
    background: linear-gradient(135deg, #fef08a 0%, #ffd700 40%, #f59e0b 80%, #d97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Quote Card */
  .quote-card {
    position: relative;
    padding: var(--space-5) var(--space-6);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid #d97706;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 20px rgba(217, 119, 6, 0.06);
  }

  .quote-text {
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--ink-muted);
    font-style: italic;
  }

  .quote-author {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #78350f;
  }

  [data-theme="dark"] .quote-author {
    color: #fde047;
  }

  /* Grid Layout */
  .credibility-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  /* Card Base Styling */
  .credibility-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px 24px 20px;
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4px 24px rgba(15, 23, 42, 0.05);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 320ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 320ms ease;
    overflow: hidden;
  }

  /* Metallic Shimmer Sweep on Hover */
  .credibility-card::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -70%;
    width: 50%;
    height: 200%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transform: rotate(25deg);
    transition: left 750ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .credibility-card:hover::after {
    left: 140%;
  }

  /* Metallic Top Accent Line */
  .card-top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }

  .credibility-card[data-accent="gold-min"] .card-top-bar { background: linear-gradient(90deg, #d97706, #f59e0b); }
  .credibility-card[data-accent="gold-med"] .card-top-bar { background: linear-gradient(90deg, #b45309, #d4af37); }
  .credibility-card[data-accent="gold-high"] .card-top-bar { background: linear-gradient(90deg, #92400e, #ca8a04); }
  .credibility-card[data-accent="gold-max"] .card-top-bar { background: linear-gradient(90deg, #713f12, #f59e0b, #ffd700); }

  /* Card Header Row */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  /* Metallic Gold Icon Avatars - High Contrast Fills */
  .icon-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    transition: transform var(--duration-fast) ease;
  }

  .credibility-card[data-accent="gold-min"] .icon-avatar { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); box-shadow: 0 4px 14px rgba(217, 119, 6, 0.28); }
  .credibility-card[data-accent="gold-med"] .icon-avatar { background: linear-gradient(135deg, #b45309 0%, #d4af37 100%); box-shadow: 0 4px 16px rgba(180, 83, 9, 0.32); }
  .credibility-card[data-accent="gold-high"] .icon-avatar { background: linear-gradient(135deg, #92400e 0%, #ca8a04 100%); box-shadow: 0 4px 16px rgba(146, 64, 14, 0.35); }
  .credibility-card[data-accent="gold-max"] .icon-avatar { background: linear-gradient(135deg, #713f12 0%, #b45309 50%, #ffd700 100%); box-shadow: 0 4px 18px rgba(113, 63, 18, 0.38); }

  .credibility-card:hover .icon-avatar {
    transform: scale(1.08) rotate(-2deg);
  }

  .icon-avatar svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #ffffff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Metric Badges per Gold Level - High Contrast Text */
  .metric-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .credibility-card[data-accent="gold-min"] .metric-badge { background: rgba(217, 119, 6, 0.12); border: 1.5px solid rgba(217, 119, 6, 0.4); color: #78350f; }
  .credibility-card[data-accent="gold-med"] .metric-badge { background: rgba(180, 83, 9, 0.12); border: 1.5px solid rgba(180, 83, 9, 0.4); color: #854d0e; }
  .credibility-card[data-accent="gold-high"] .metric-badge { background: rgba(146, 64, 14, 0.12); border: 1.5px solid rgba(146, 64, 14, 0.4); color: #92400e; }
  .credibility-card[data-accent="gold-max"] .metric-badge { background: rgba(113, 63, 18, 0.14); border: 1.5px solid rgba(113, 63, 18, 0.45); color: #713f12; }

  [data-theme="dark"] .credibility-card[data-accent="gold-min"] .metric-badge { background: rgba(253, 230, 138, 0.18); border-color: rgba(253, 230, 138, 0.45); color: #fde047; }
  [data-theme="dark"] .credibility-card[data-accent="gold-med"] .metric-badge { background: rgba(254, 240, 138, 0.18); border-color: rgba(254, 240, 138, 0.45); color: #fef08a; }
  [data-theme="dark"] .credibility-card[data-accent="gold-high"] .metric-badge { background: rgba(250, 219, 109, 0.2); border-color: rgba(250, 219, 109, 0.5); color: #fadb6d; }
  [data-theme="dark"] .credibility-card[data-accent="gold-max"] .metric-badge { background: rgba(255, 215, 0, 0.25); border-color: rgba(255, 215, 0, 0.55); color: #fff176; }

  /* Card Body & Category Tag - Deep Readable Colors */
  .card-body {
    flex-grow: 1;
    margin-bottom: var(--space-4);
  }

  .card-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .credibility-card[data-accent="gold-min"] .card-tag { color: #78350f; }
  .credibility-card[data-accent="gold-med"] .card-tag { color: #854d0e; }
  .credibility-card[data-accent="gold-high"] .card-tag { color: #92400e; }
  .credibility-card[data-accent="gold-max"] .card-tag { color: #713f12; }

  [data-theme="dark"] .credibility-card[data-accent="gold-min"] .card-tag { color: #fde047; }
  [data-theme="dark"] .credibility-card[data-accent="gold-med"] .card-tag { color: #fef08a; }
  [data-theme="dark"] .credibility-card[data-accent="gold-high"] .card-tag { color: #fadb6d; }
  [data-theme="dark"] .credibility-card[data-accent="gold-max"] .card-tag { color: #fff176; }

  .credibility-card h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .credibility-card p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* Card Footer */
  .card-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
    margin-top: auto;
  }

  .card-subtitle {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-subtle);
  }

  /* Hover States */
  .credibility-card:hover {
    transform: translateY(-6px);
  }

  .credibility-card[data-accent="gold-min"]:hover { border-color: #f59e0b; box-shadow: 0 16px 36px rgba(245, 158, 11, 0.22); }
  .credibility-card[data-accent="gold-med"]:hover { border-color: #d97706; box-shadow: 0 16px 36px rgba(217, 119, 6, 0.25); }
  .credibility-card[data-accent="gold-high"]:hover { border-color: #ca8a04; box-shadow: 0 16px 36px rgba(202, 138, 4, 0.28); }
  .credibility-card[data-accent="gold-max"]:hover { border-color: #d4af37; box-shadow: 0 16px 36px rgba(212, 175, 55, 0.32); }

  @media (max-width: 1040px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .credibility-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .credibility-grid {
      grid-template-columns: 1fr;
    }
    .credibility-card {
      padding: var(--space-5);
    }
  }
</style>
