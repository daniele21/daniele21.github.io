---
/**
 * CredibilitySection - Evidence and track record from professional leadership.
 */
import { credibilityIntro, credibilityProofs } from '../../content/credibility';
---

<section class="section section-credibility" id="credibility" aria-labelledby="credibility-title">
  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker">BUILT ON REAL-WORLD EXPERIENCE</p>
        <h2 id="credibility-title">Evidence that I can <strong>deliver at scale</strong></h2>
      </div>
      <p>{credibilityIntro.quote}</p>
    </div>

    <div class="credibility-grid">
      {credibilityProofs.map((item) => (
        <div class="credibility-card reveal">
          <div class="card-header">
            {item.iconType === 'leadership' && (
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            )}
            {item.iconType === 'articles' && (
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            )}
            {item.iconType === 'mentoring' && (
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            )}
            {item.iconType === 'award' && (
              <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
            )}
            <span class="card-subtitle">{item.subtitle}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-credibility {
    background: var(--surface-canvas);
    border-block: 1px solid var(--border-subtle);
  }

  .credibility-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .credibility-card {
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) ease;
  }

  .credibility-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-header svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--accent-blue);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .card-subtitle {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-blue);
  }

  .credibility-card h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .credibility-card p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (max-width: 1040px) {
    .credibility-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .credibility-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
