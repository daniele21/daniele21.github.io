---
/**
 * PossibilitiesSection - "What This Enables" grid.
 * Displays future exploration areas with a clean 2-color horizontal gradient progression
 * (Sapphire Blue -> Cyber Cyan) flowing across the section columns.
 */
import { enablements } from '../../content/principles';

/** 4 steps along the 2-color spectrum across grid columns */
const columnAccents = ['col-step-1', 'col-step-2', 'col-step-3', 'col-step-4'] as const;
---

<section class="section section-enables" id="possibilities" aria-labelledby="enables-title">
  <div class="brand-ambient-glow" aria-hidden="true"></div>

  <div class="shell">
    <div class="section-heading reveal">
      <div>
        <p class="section-kicker">
          <span class="kicker-dot"></span>
          WHAT THIS ENABLES
        </p>
        <h2 id="enables-title">
          What the stack makes <span class="dual-gradient-text">easier to build next</span>
        </h2>
      </div>
      <p class="section-subtitle">
        Exploration areas unlocked by core <em>local AI infrastructure</em>.
      </p>
    </div>

    <div class="enablement-grid">
      {enablements.map((item, index) => {
        const stepNum = (index % 4) + 1;
        const colAccent = columnAccents[index % 4];
        return (
          <article class={`enablement-card reveal col-step-${stepNum}`} data-accent={colAccent}>
            <div class="card-top-bar" aria-hidden="true"></div>

            <div class="card-header">
              <div class="icon-avatar">
                {index === 0 && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg>}
                {index === 1 && <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M16 10h5M8 8v8M5 11h6"/></svg>}
                {index === 2 && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>}
                {index === 3 && <svg aria-hidden="true" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
                {index === 4 && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>}
                {index === 5 && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.7 5.2c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/></svg>}
                {index === 6 && <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>}
                {index === 7 && <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>}
              </div>

              <span class="number-badge">0{index + 1}</span>
            </div>

            <div class="card-body">
              <h3>{item.title}</h3>
              <p set:html={item.description}></p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .section-enables {
    position: relative;
    background: var(--surface-canvas);
    border-block: 1px solid var(--border-subtle);
    padding: clamp(60px, 8vw, 96px) 0;
    overflow: hidden;
  }

  .brand-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 850px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.08), transparent 70%);
    filter: blur(85px);
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="dark"] .brand-ambient-glow {
    background: radial-gradient(ellipse at center, rgba(34, 211, 238, 0.1), transparent 75%);
  }

  .shell {
    position: relative;
    z-index: 1;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-10);
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 850;
    letter-spacing: 0.08em;
    color: #1d4ed8;
    margin-bottom: var(--space-2);
  }

  [data-theme="dark"] .section-kicker {
    color: #38bdf8;
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1d4ed8;
    box-shadow: 0 0 10px #2563eb;
    animation: kicker-pulse 2s infinite ease-in-out;
  }

  @keyframes kicker-pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }

  /* Title: Smooth 2-color gradient across text */
  .dual-gradient-text {
    background-image: linear-gradient(90deg, #1d4ed8 0%, #0891b2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: #1d4ed8;
    display: inline-block;
    font-weight: 850;
  }

  [data-theme="dark"] .dual-gradient-text {
    background-image: linear-gradient(90deg, #60a5fa 0%, #22d3ee 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: #60a5fa;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-body);
    color: var(--ink-muted);
    max-width: 420px;
    text-align: right;
  }

  .enablement-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .enablement-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 210px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 300ms ease;
    overflow: hidden;
  }

  /* Subtle Shimmer Sweep */
  .enablement-card::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -70%;
    width: 50%;
    height: 200%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transform: rotate(25deg);
    transition: left 750ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .enablement-card:hover::after {
    left: 140%;
  }

  .enablement-card:hover {
    transform: translateY(-6px);
  }

  /* Top Accent Bar: Clean single color step across columns */
  .card-top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: #1d4ed8;
  }

  .enablement-card.col-step-1 .card-top-bar, .enablement-card[data-accent="col-step-1"] .card-top-bar { background: #1d4ed8 !important; }
  .enablement-card.col-step-2 .card-top-bar, .enablement-card[data-accent="col-step-2"] .card-top-bar { background: #2563eb !important; }
  .enablement-card.col-step-3 .card-top-bar, .enablement-card[data-accent="col-step-3"] .card-top-bar { background: #0284c7 !important; }
  .enablement-card.col-step-4 .card-top-bar, .enablement-card[data-accent="col-step-4"] .card-top-bar { background: #0891b2 !important; }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  /* Icon Avatars: Clean 2-color horizontal progression (Blue -> Cyan) across grid columns */
  .icon-avatar {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #1d4ed8;
    transition: transform var(--duration-fast) ease;
  }

  .enablement-card.col-step-1 .icon-avatar, .enablement-card[data-accent="col-step-1"] .icon-avatar { background: #1d4ed8 !important; box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35); }
  .enablement-card.col-step-2 .icon-avatar, .enablement-card[data-accent="col-step-2"] .icon-avatar { background: #2563eb !important; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35); }
  .enablement-card.col-step-3 .icon-avatar, .enablement-card[data-accent="col-step-3"] .icon-avatar { background: #0284c7 !important; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35); }
  .enablement-card.col-step-4 .icon-avatar, .enablement-card[data-accent="col-step-4"] .icon-avatar { background: #0891b2 !important; box-shadow: 0 4px 14px rgba(8, 145, 178, 0.35); }

  .enablement-card:hover .icon-avatar {
    transform: scale(1.08) rotate(-2deg);
  }

  .icon-avatar svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #ffffff !important;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Number Badges: Clean step colors matching column position */
  .number-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 850;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: 0.05em;
  }

  .enablement-card.col-step-1 .number-badge, .enablement-card[data-accent="col-step-1"] .number-badge { color: #1d4ed8 !important; background: rgba(29, 78, 216, 0.12) !important; border: 1.5px solid rgba(29, 78, 216, 0.35) !important; }
  .enablement-card.col-step-2 .number-badge, .enablement-card[data-accent="col-step-2"] .number-badge { color: #2563eb !important; background: rgba(37, 99, 235, 0.12) !important; border: 1.5px solid rgba(37, 99, 235, 0.35) !important; }
  .enablement-card.col-step-3 .number-badge, .enablement-card[data-accent="col-step-3"] .number-badge { color: #0284c7 !important; background: rgba(2, 132, 199, 0.12) !important; border: 1.5px solid rgba(2, 132, 199, 0.35) !important; }
  .enablement-card.col-step-4 .number-badge, .enablement-card[data-accent="col-step-4"] .number-badge { color: #0891b2 !important; background: rgba(8, 145, 178, 0.12) !important; border: 1.5px solid rgba(8, 145, 178, 0.35) !important; }

  [data-theme="dark"] .enablement-card.col-step-1 .number-badge { color: #60a5fa !important; background: rgba(96, 165, 250, 0.18) !important; border-color: rgba(96, 165, 250, 0.45) !important; }
  [data-theme="dark"] .enablement-card.col-step-2 .number-badge { color: #60a5fa !important; background: rgba(96, 165, 250, 0.18) !important; border-color: rgba(96, 165, 250, 0.45) !important; }
  [data-theme="dark"] .enablement-card.col-step-3 .number-badge { color: #38bdf8 !important; background: rgba(56, 189, 248, 0.18) !important; border-color: rgba(56, 189, 248, 0.45) !important; }
  [data-theme="dark"] .enablement-card.col-step-4 .number-badge { color: #22d3ee !important; background: rgba(34, 211, 238, 0.18) !important; border-color: rgba(34, 211, 238, 0.45) !important; }

  /* Hover Card Borders & Shadows per Column Color */
  .enablement-card.col-step-1:hover { border-color: #1d4ed8; box-shadow: 0 16px 36px rgba(29, 78, 216, 0.22); }
  .enablement-card.col-step-2:hover { border-color: #2563eb; box-shadow: 0 16px 36px rgba(37, 99, 235, 0.22); }
  .enablement-card.col-step-3:hover { border-color: #0284c7; box-shadow: 0 16px 36px rgba(2, 132, 199, 0.22); }
  .enablement-card.col-step-4:hover { border-color: #0891b2; box-shadow: 0 16px 36px rgba(8, 145, 178, 0.22); }

  .card-body h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }

  .card-body p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (max-width: 1040px) {
    .section-heading { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .section-subtitle { text-align: left; max-width: 100%; }
    .enablement-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 580px) {
    .enablement-grid { grid-template-columns: 1fr; }
    .enablement-card { padding: var(--space-5); }
  }
</style>

