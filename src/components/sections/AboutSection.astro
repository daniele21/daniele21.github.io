---
/**
 * AboutSection - Personal bio and profile photo.
 */
import { socialLinks } from '../../content/site';
---

<section class="section section-about" id="about" aria-labelledby="about-title">
  <div class="shell about-grid">
    <div class="about-copy reveal">
      <p class="section-kicker">ABOUT DANIELE</p>
      <h2 id="about-title">I work where <strong>AI infrastructure</strong>, <strong>product strategy</strong>, and <strong>clear engineering</strong> intersect.</h2>
      <p>I am <strong>Daniele Moltisanti</strong>, an AI technical leader and builder based in Milan. My work combines <em>technical architecture</em>, <em>product thinking</em>, and the ability to transform complex AI research into understandable decisions and reliable, intuitive software.</p>
      <p>Alongside my independent work, I lead and design AI initiatives in complex organisations, translating technical possibilities into systems that can be adopted, governed, and scaled.</p>
      <p>I also write, teach, and speak about AI architecture, strategy, and the path from experimentation to reliable products.</p>
      
      <div class="about-links">
        <a class="about-link" href={socialLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a class="about-link" href={socialLinks.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a class="about-link" href={socialLinks.staituned} target="_blank" rel="noreferrer">stAI tuned ↗</a>
        <span class="about-link-muted" title="Coming soon">Speaking & public work <small>(coming soon)</small></span>
      </div>
    </div>

    <div class="about-photo-wrapper reveal">
      <img src={`${import.meta.env.BASE_URL}images/profile-photo.jpg`} alt="Daniele Moltisanti" class="about-photo" />
    </div>
  </div>
</section>


<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .about-copy p {
    margin-top: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--text-body);
    line-height: 1.7;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    font-size: var(--text-small);
    font-weight: 650;
    text-decoration: none;
    transition: border-color var(--duration-fast) ease,
                color var(--duration-fast) ease,
                transform var(--duration-fast) ease;
  }

  .about-link:hover {
    border-color: var(--border-strong);
    color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .about-link-muted {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    color: var(--ink-subtle);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .about-link-muted small {
    opacity: 0.7;
    font-size: var(--text-xs);
  }


  .about-photo-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .about-photo-wrapper::before {
    content: "";
    position: absolute;
    inset: -12px;
    border-radius: calc(var(--radius-lg) + 12px);
    background: radial-gradient(circle, var(--accent-blue) 0%, transparent 70%);
    opacity: 0.12;
    filter: blur(20px);
    z-index: 0;
    transition: opacity var(--duration-base) ease;
  }

  .about-photo-wrapper:hover::before {
    opacity: 0.22;
  }

  .about-photo {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
    transition: transform var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) ease;
  }

  .about-photo-wrapper:hover .about-photo {
    transform: translateY(-4px) scale(1.01);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 1040px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .about-photo {
      max-width: 320px;
    }
  }
</style>

