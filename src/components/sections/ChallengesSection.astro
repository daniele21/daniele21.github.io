---
/**
 * ChallengesSection - Technical gap and difficulty explanation section.
 * Positioned after Vision/Mission to contextualize why infrastructure is needed.
 */
import { getContent } from '../../content';

const { challenges: ch } = getContent().home;
---

<section class="section section-challenges" id="challenges" aria-labelledby="challenges-heading">
  <div class="shell">
    <div class="challenges-card reveal">
      <div class="challenges-header">
        <p class="section-kicker">{ch.kicker}</p>
        <h2 id="challenges-heading">{ch.titlePrefix}<em>{ch.titleHighlight}</em></h2>
        <p class="challenges-intro">
          {ch.introPrefix}<strong>{ch.introHighlight}</strong>{ch.introSuffix}
        </p>
      </div>

      <div class="challenges-grid">
        {ch.items.map((item) => (
          <article class="challenge-item">
            <div class="challenge-item-header">
              <span class="challenge-num">{item.number}</span>
              <h3>{item.title}</h3>
            </div>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

</section>

<style>
  .section-challenges {
    padding: clamp(44px, 5vw, 72px) 0;
  }

  .challenges-card {
    padding: clamp(28px, 3.5vw, 48px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-sm);
    transition: border-color var(--duration-base) ease, box-shadow var(--duration-base) ease;
  }

  .challenges-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .challenges-header {
    max-width: 760px;
    margin-bottom: var(--space-6);
  }

  .challenges-header h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.3vw, 2.05rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .challenges-intro {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .challenges-intro strong {
    color: var(--ink);
  }

  /* 2x2 Grid Layout */
  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .challenge-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-canvas);
    border: 1px solid var(--border-subtle);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .challenge-item:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .challenge-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .challenge-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-blue);
    background: var(--surface-blue);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
    border-radius: 6px;
    line-height: 1;
    flex-shrink: 0;
  }

  .challenge-item h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .challenge-item p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .challenges-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>

