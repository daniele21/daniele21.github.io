---
/**
 * ChallengesSection - Technical gap and difficulty explanation section.
 * Positioned after Vision/Mission to contextualize why infrastructure is needed.
 * Features ultra-compact, executive-grade design that fits within standard viewport height.
 */
import { getContent } from '../../content';

const { challenges: ch } = getContent().home;
---

<section class="section section-challenges" id="challenges" aria-labelledby="challenges-heading">
  <div class="shell">
    <div class="challenges-wrapper reveal">
      <!-- Section Header -->
      <div class="challenges-header">
        <div class="kicker-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>{ch.kicker}</span>
        </div>
        
        <h2 id="challenges-heading">
          {ch.titlePrefix}<span class="title-highlight">{ch.titleHighlight}</span>
        </h2>
        
        <p class="challenges-intro">
          {ch.introPrefix}<strong class="intro-highlight">{ch.introHighlight}</strong>{ch.introSuffix}
        </p>
      </div>

      <!-- 2x2 Compact Domain Grid -->
      <div class="challenges-grid">
        {ch.items.map((item) => (
          <article class={`challenge-card accent-${item.accent || 'blue'}`}>
            <div class="card-top">
              <span class="challenge-num">{item.number}</span>
              <div class="icon-wrapper" aria-hidden="true">
                {item.icon === 'lifecycle' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6"/>
                    <path d="M2 11.5a10 10 0 0 1 18.8-4.3L21.5 8M22 12.5a10 10 0 0 1-18.8 4.2L2.5 16"/>
                  </svg>
                )}
                {item.icon === 'telemetry' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                  </svg>
                )}
                {item.icon === 'hardware' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="2"/>
                    <rect x="9" y="9" width="6" height="6"/>
                    <line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
                    <line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
                    <line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/>
                    <line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/>
                  </svg>
                )}
                {item.icon === 'ergonomics' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                  </svg>
                )}
              </div>
            </div>

            <div class="card-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>

            {item.tags && item.tags.length > 0 && (
              <div class="card-tags">
                {item.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section-challenges {
    padding: clamp(16px, 2.5vw, 32px) 0;
  }

  .challenges-wrapper {
    position: relative;
    padding: clamp(16px, 2.5vw, 24px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-sm);
    transition: border-color var(--duration-base) ease, box-shadow var(--duration-base) ease;
    overflow: hidden;
  }

  .challenges-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-teal), var(--accent-violet));
    opacity: 0.85;
  }

  .challenges-wrapper:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  /* Compact Header Section */
  .challenges-header {
    max-width: 860px;
    margin-bottom: var(--space-3);
  }

  .kicker-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    background: var(--surface-blue);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-blue);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .pulse-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--accent-blue);
    box-shadow: 0 0 6px var(--accent-blue);
    animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .challenges-header h2 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-weight: 700;
  }

  .title-highlight {
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-violet) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
  }

  .challenges-intro {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    line-height: 1.45;
  }

  .intro-highlight {
    color: var(--ink);
    background: var(--surface-muted);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    font-weight: 600;
  }

  /* 2x2 Grid Layout */
  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.5vw, 14px);
  }

  /* Domain Cards */
  .challenge-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(12px, 1.5vw, 16px);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-out-expo),
                border-color var(--duration-fast) ease,
                box-shadow var(--duration-fast) ease;
    overflow: hidden;
  }

  .challenge-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    transition: background var(--duration-fast) ease;
  }

  .challenge-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  /* Card Accents */
  .challenge-card.accent-blue:hover::before {
    background: var(--accent-blue);
  }
  .challenge-card.accent-teal:hover::before {
    background: var(--accent-teal);
  }
  .challenge-card.accent-violet:hover::before {
    background: var(--accent-violet);
  }
  .challenge-card.accent-indigo:hover::before {
    background: var(--accent-indigo);
  }

  /* Top Bar */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .challenge-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 800;
    line-height: 1;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
  }

  .accent-blue .challenge-num {
    color: var(--accent-blue);
    background: var(--surface-blue);
  }
  .accent-teal .challenge-num {
    color: var(--accent-teal-dark);
    background: var(--surface-teal);
  }
  .accent-violet .challenge-num {
    color: var(--accent-violet);
    background: var(--surface-violet);
  }
  .accent-indigo .challenge-num {
    color: var(--accent-indigo);
    background: var(--surface-muted);
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    transition: transform var(--duration-fast) ease;
  }

  .challenge-card:hover .icon-wrapper {
    transform: scale(1.05);
  }

  .accent-blue .icon-wrapper {
    color: var(--accent-blue);
  }
  .accent-teal .icon-wrapper {
    color: var(--accent-teal-dark);
  }
  .accent-violet .icon-wrapper {
    color: var(--accent-violet);
  }
  .accent-indigo .icon-wrapper {
    color: var(--accent-indigo);
  }

  /* Card Content */
  .card-content {
    flex: 1;
    margin-bottom: 8px;
  }

  .card-content h3 {
    margin: 0 0 3px;
    font-family: var(--font-display);
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .card-content p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.825rem;
    line-height: 1.4;
  }

  /* Tag Pills */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-top: 6px;
    border-top: 1px dashed var(--border-subtle);
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.675rem;
    font-weight: 500;
    color: var(--ink-subtle);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    padding: 1px 6px;
    border-radius: 4px;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .challenge-card:hover .tag-pill {
    color: var(--ink);
    border-color: var(--border-strong);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .challenges-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .challenges-wrapper {
      padding: 14px;
    }
  }
</style>
