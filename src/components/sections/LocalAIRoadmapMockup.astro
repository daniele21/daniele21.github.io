---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
const page = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;

const strategyItems = [
  ['Keep sensitive data closer', 'Reduce unnecessary movement of private data.'],
  ['Stay in control', 'Own the models, runtimes and execution path.'],
  ['Reduce dependency', 'Limit exposure to vendor lock-in and changing API costs.'],
  ['Trace the system', 'Understand what happened from input to output.'],
];

const architectureItems = [
  ['Desktop & local infrastructure', 'Run open models while keeping control over data and inference.'],
  ['Mobile / on-device', 'See what survives real memory, battery and thermal constraints.'],
  ['Local speech', 'Add private ASR without making the cloud mandatory.'],
  ['Runtimes & deployment', 'Turn individual components into systems that can actually be used.'],
];

const applicationQuestions = [
  'Can sensitive documents stay local?',
  'How useful can AI become on-device?',
  'Can meeting intelligence stay private?',
];

const observabilityItems = [
  ['Is it fast enough?', 'Latency and throughput.'],
  ['Does it fit?', 'Memory, CPU/GPU and storage.'],
  ['Can the device sustain it?', 'Thermals and battery.'],
  ['Is it reliable?', 'Errors, requests and runtime behavior.'],
];
---

<div class="roadmap-page">
  <header class="mock-header">
    <div class="mock-shell nav-shell">
      <a class="mock-brand" href={`${baseUrl}/`} aria-label="Daniele Moltisanti home">
        <span class="brand-cube" aria-hidden="true"><i></i></span>
        <span>Daniele Moltisanti</span>
      </a>
      <nav class="mock-nav" aria-label="Primary navigation">
        <a href="#strategy">Work</a>
        <a href="#applications">Projects</a>
        <a href={page('insights')}>Articles</a>
        <a href={page('about')}>About</a>
        <a class="nav-cta" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20conversation">Get in touch</a>
      </nav>
    </div>
  </header>

  <main class="mock-shell mock-main">
    <section class="mock-hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Run AI where it makes sense.<br /><span>Local AI first ≠ Local AI only</span></h1>
      <p class="hero-principle">
        Start by asking what can stay under your control. Then choose Local, Hybrid or Cloud based on privacy,
        cost, latency and real product constraints.
      </p>
      <p class="hero-proof">
        I build, test and measure AI across local infrastructure, desktops and mobile devices to understand what
        actually works outside the cloud.
      </p>
      <div class="hero-actions">
        <a class="primary-button" href="#strategy">Explore the work <span aria-hidden="true">→</span></a>
        <a class="secondary-button" href="#strategy">See the decision framework</a>
      </div>
    </section>

    <div class="roadmap-flow">
      <section class="journey-stage stage-left" id="strategy" aria-labelledby="strategy-title">
        <div class="stage-rail rail-left" aria-hidden="true">
          <span class="stage-badge">1</span>
          <span class="rail-line"></span>
        </div>

        <div class="stage-grid strategy-grid">
          <div class="stage-copy strategy-copy">
            <p class="stage-kicker">01 — STRATEGY</p>
            <h2 id="strategy-title">Where should AI<br />actually run?</h2>
            <p class="stage-intro">
              Local AI creates value when keeping data, execution and dependencies under your control matters.
            </p>
            <div class="stage-list">
              {strategyItems.map(([title, text], index) => (
                <div class="list-item">
                  <span class="list-icon" aria-hidden="true">{['◇','▣','↗','⌕'][index]}</span>
                  <p><strong>{title} —</strong><br /><span>{text}</span></p>
                </div>
              ))}
            </div>
          </div>

          <div class="strategy-panels" aria-label="Local, Hybrid and Cloud decision framework">
            <article class="mini-panel decision-panel">
              <h3>Decision framework</h3>
              <div class="decision-flow" aria-hidden="true">
                <span class="decision-box">Use case</span>
                <span class="decision-arrow">↓</span>
                <span class="decision-diamond">Sensitive?</span>
                <div class="decision-branches">
                  <span><small>Yes</small><b>Local / Hybrid</b></span>
                  <span><small>No</small><b>Cloud / Hybrid</b></span>
                </div>
              </div>
              <p>Decide based on privacy, control, cost and constraints.</p>
            </article>

            <article class="mini-panel compare-panel">
              <h3>Local vs Hybrid vs Cloud</h3>
              <div class="comparison-table" role="table" aria-label="Local Hybrid Cloud comparison">
                <div class="comparison-head"><span></span><b>Local</b><b>Hybrid</b><b>Cloud</b></div>
                <div><span>Privacy</span><i class="good">✓</i><i class="good">✓</i><i>–</i></div>
                <div><span>Control</span><i class="good">✓</i><i class="good">✓</i><i class="bad">×</i></div>
                <div><span>Cost</span><i class="good">$</i><i class="warn">$$</i><i class="bad">$$$</i></div>
                <div><span>Latency</span><i class="good">✓</i><i class="good">✓</i><i class="bad">×</i></div>
                <div><span>Reliability</span><i class="good">✓</i><i class="good">✓</i><i class="bad">×</i></div>
              </div>
              <p>No single winner.<br />Choose by constraints.</p>
            </article>

            <article class="mini-panel tradeoff-panel">
              <h3>Trade-off guide</h3>
              <ul>
                <li><span>▤</span>Where is my data?</li>
                <li><span>♙</span>Who should access it?</li>
                <li><span>◷</span>Where does it need to run well?</li>
                <li><span>⚙</span>What can I operate and maintain?</li>
                <li><span>△</span>What happens if it fails?</li>
              </ul>
              <p>Make trade-offs explicit.<br />Revisit as needs evolve.</p>
            </article>
          </div>
        </div>
      </section>

      <div class="flow-transition transition-ltr" aria-hidden="true">
        <svg viewBox="0 0 1000 118" preserveAspectRatio="none">
          <defs>
            <filter id="glow-a" x="-30%" y="-100%" width="160%" height="300%">
              <feGaussianBlur stdDeviation="7" result="blur" />
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <path class="flow-glow" d="M55 0 V24 Q55 58 90 58 H910 Q945 58 945 92 V118" />
          <path class="flow-path" d="M55 0 V24 Q55 58 90 58 H910 Q945 58 945 92 V118" filter="url(#glow-a)" />
        </svg>
        <span class="flow-dot dot-left"></span><span class="flow-dot dot-right"></span>
        <div class="transition-pill"><span class="pill-icon">◎</span><div><strong>DECIDE → BUILD</strong><small>If it should run locally, make it possible.</small></div></div>
      </div>

      <section class="journey-stage stage-right" id="infrastructure" aria-labelledby="architecture-title">
        <div class="stage-rail rail-right" aria-hidden="true">
          <span class="stage-badge">2</span>
          <span class="rail-line"></span>
        </div>

        <div class="stage-grid architecture-grid">
          <div class="architecture-visual visual-card">
            <img src={asset('images/ecosystem-map.png')} alt="Connected Local AI stack across desktop, Android, local server and cloud" loading="lazy" />
          </div>

          <div class="stage-copy architecture-copy">
            <p class="stage-kicker">02 — ARCHITECTURE & INFRASTRUCTURE</p>
            <h2 id="architecture-title">Can we actually<br />run it locally?</h2>
            <p class="stage-intro">
              I build the pieces needed to test Local AI across very different environments — from local servers to mobile devices.
            </p>
            <div class="stage-list architecture-list">
              {architectureItems.map(([title, text], index) => (
                <div class="list-item">
                  <span class="list-icon" aria-hidden="true">{['▱','▯','⌁','⬡'][index]}</span>
                  <p><strong>{title} —</strong><br /><span>{text}</span></p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <div class="flow-transition transition-rtl" aria-hidden="true">
        <svg viewBox="0 0 1000 118" preserveAspectRatio="none">
          <defs>
            <filter id="glow-b" x="-30%" y="-100%" width="160%" height="300%">
              <feGaussianBlur stdDeviation="7" result="blur" />
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <path class="flow-glow" d="M945 0 V24 Q945 58 910 58 H90 Q55 58 55 92 V118" />
          <path class="flow-path" d="M945 0 V24 Q945 58 910 58 H90 Q55 58 55 92 V118" filter="url(#glow-b)" />
        </svg>
        <span class="flow-dot dot-right"></span><span class="flow-dot dot-left"></span>
        <div class="transition-pill"><span class="pill-icon">⬡</span><div><strong>BUILD → TEST</strong><small>If it runs, put it inside a real product.</small></div></div>
      </div>

      <section class="journey-stage stage-left" id="applications" aria-labelledby="applications-title">
        <div class="stage-rail rail-left" aria-hidden="true">
          <span class="stage-badge">3</span>
          <span class="rail-line"></span>
        </div>

        <div class="stage-grid applications-grid">
          <div class="stage-copy applications-copy">
            <p class="stage-kicker">03 — APPLICATIONS</p>
            <h2 id="applications-title">What happens in<br />a real product?</h2>
            <p class="stage-intro">Infrastructure only matters when it survives real data, users and workflows.</p>
            <p class="stage-note">I use applications as test beds for the stack.</p>
            <div class="question-list">
              {applicationQuestions.map((question) => (
                <div><span>?</span><strong>{question}</strong></div>
              ))}
            </div>
          </div>

          <div class="application-cards">
            <a class="app-card" href={page('redact-guard')}>
              <div class="app-icon red"><img src={asset('images/redact-guard/logo.png')} alt="" loading="lazy" /></div>
              <h3>RedactGuard</h3>
              <p>Local-first redaction for sensitive documents.</p>
              <span>View project →</span>
            </a>
            <a class="app-card" href={page('aura-finance')}>
              <div class="app-icon purple"><img src={asset('images/aura/logo.png')} alt="" loading="lazy" /></div>
              <h3>Aura</h3>
              <p>On-device assistant for private use and real workflows.</p>
              <span>View project →</span>
            </a>
            <a class="app-card" href={page('closedroom')}>
              <div class="app-icon blue"><img src={asset('images/closedroom/logo.png')} alt="" loading="lazy" /></div>
              <h3>ClosedRoom</h3>
              <p>Private meetings and local-first conversation intelligence.</p>
              <span>View project →</span>
            </a>
            <article class="app-card next-card">
              <div class="next-icon">＋</div>
              <h3>Your next application</h3>
              <p>Your idea, built with the same local-first principles.</p>
              <span>Coming soon</span>
            </article>
          </div>
        </div>
      </section>

      <div class="flow-transition transition-ltr" aria-hidden="true">
        <svg viewBox="0 0 1000 118" preserveAspectRatio="none">
          <defs>
            <filter id="glow-c" x="-30%" y="-100%" width="160%" height="300%">
              <feGaussianBlur stdDeviation="7" result="blur" />
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <path class="flow-glow" d="M55 0 V24 Q55 58 90 58 H910 Q945 58 945 92 V118" />
          <path class="flow-path" d="M55 0 V24 Q55 58 90 58 H910 Q945 58 945 92 V118" filter="url(#glow-c)" />
        </svg>
        <span class="flow-dot dot-left"></span><span class="flow-dot dot-right"></span>
        <div class="transition-pill"><span class="pill-icon">▥</span><div><strong>TEST → MEASURE</strong><small>If it works, prove how well.</small></div></div>
      </div>

      <section class="journey-stage stage-right stage-final" id="evidence" aria-labelledby="observability-title">
        <div class="stage-rail rail-right" aria-hidden="true">
          <span class="stage-badge">4</span>
          <span class="rail-line final-line"></span>
          <span class="rail-foot"></span>
        </div>

        <div class="stage-grid observability-grid">
          <div class="metrics-grid" aria-label="Performance and observability metrics">
            <article class="metric-card">
              <h3>Performance Lab</h3>
              <svg class="spark-chart" viewBox="0 0 180 74" aria-hidden="true"><polyline points="0,54 12,42 23,48 36,36 48,49 61,31 73,37 85,24 97,38 110,30 122,43 136,32 150,40 165,22 180,29" /></svg>
              <div class="metric-stats"><span>P95 Latency <b>62 ms</b></span><span>Throughput <b>12.4K/min</b></span><span>Error rate <b class="positive">0.02%</b></span></div>
            </article>
            <article class="metric-card">
              <h3>Traffic Monitoring</h3>
              <div class="bar-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <div class="metric-stats"><span>Requests <b>18,542</b></span><span>Tokens <b>2.1M</b></span><span>Errors <b class="negative">23 (0.12%)</b></span></div>
            </article>
            <article class="metric-card key-metrics">
              <h3>Key Metrics</h3>
              <div class="metric-mini"><span>Latency (p95)</span><b>62 ms</b><i class="mini-green"></i></div>
              <div class="metric-mini"><span>Throughput</span><b>12.4K/min</b><i class="mini-blue"></i></div>
              <div class="metric-mini"><span>Error Rate</span><b>0.02%</b><i class="mini-red"></i></div>
              <div class="metric-mini"><span>Success Rate</span><b>99.65%</b><i class="mini-green"></i></div>
              <div class="metric-mini"><span>Tokens / min</span><b>1.8M</b><i class="mini-green"></i></div>
            </article>
            <article class="metric-card resource-card">
              <h3>Resource Usage</h3>
              <div class="donut-row"><div class="donut"><span></span></div><ul><li><i class="cpu"></i>CPU <b>34%</b></li><li><i class="gpu"></i>GPU <b>28%</b></li><li><i class="ram"></i>RAM <b>26%</b></li><li><i class="disk"></i>Disk <b>12%</b></li></ul></div>
              <div class="resource-lines"><span>RAM <b>10.8 / 32 GB</b></span><span>VRAM <b>10.1 / 24 GB</b></span></div>
            </article>
          </div>

          <div class="stage-copy observability-copy">
            <p class="stage-kicker">04 — OBSERVABILITY & MEASUREMENT</p>
            <h2 id="observability-title">Does it actually<br />work well?</h2>
            <p class="stage-intro">It runs isn't enough. Local AI has to perform under real hardware and product constraints.</p>
            <div class="stage-list observability-list">
              {observabilityItems.map(([title, text], index) => (
                <div class="list-item">
                  <span class="list-icon" aria-hidden="true">{['▥','▧','♨','◇'][index]}</span>
                  <p><strong>{title} —</strong><br /><span>{text}</span></p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="closing-card" id="contact">
      <div class="closing-left"><span class="wave-badge" aria-hidden="true">⌁</span><div><h2>Evidence feeds the next decision.</h2><p>Measure what happened. Learn from the constraints.<br />Decide again whether the next workload belongs Local, Hybrid or Cloud.</p></div></div>
      <div class="closing-divider"></div>
      <div class="closing-right"><h2>Let's build something together.</h2><p>Have a project, idea or question? I'd love to hear from you.</p><div class="closing-actions"><a class="primary-button" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20conversation">Get in touch</a><a class="secondary-button" href="#strategy">View my work</a></div></div>
    </section>
  </main>
</div>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #ffffff; color: #081333; }
  :global(#main) { min-height: 100vh; }
  :global(.skip-link) { z-index: 9999; }

  .roadmap-page {
    --blue: #145bff;
    --blue-2: #2563ff;
    --blue-soft: #eaf1ff;
    --ink: #081333;
    --muted: #52617e;
    --subtle: #76839d;
    --line: #dbe4f3;
    --card: rgba(255,255,255,.97);
    min-height: 100vh;
    background: radial-gradient(circle at 50% 0%, #f8fbff 0%, #fff 30%);
    color: var(--ink);
    font-family: Inter, system-ui, sans-serif;
  }

  .mock-shell { width: min(calc(100% - 48px), 1180px); margin-inline: auto; }

  .mock-header { height: 74px; display: flex; align-items: center; border-bottom: 1px solid rgba(213,222,239,.7); background: rgba(255,255,255,.92); backdrop-filter: blur(14px); position: sticky; top: 0; z-index: 80; }
  .nav-shell { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .mock-brand { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.03rem; text-decoration: none; letter-spacing: -0.03em; }
  .brand-cube { width: 29px; height: 29px; position: relative; display: inline-block; clip-path: polygon(50% 0, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%); background: linear-gradient(145deg,#2f73ff,#0d47df); box-shadow: 0 7px 18px rgba(20,91,255,.28); }
  .brand-cube i { position: absolute; inset: 6px; clip-path: inherit; background: linear-gradient(145deg,#5d92ff,#145bff); }
  .mock-nav { display: flex; align-items: center; gap: 28px; }
  .mock-nav a { color: var(--ink); text-decoration: none; font-size: .77rem; font-weight: 750; }
  .mock-nav a:hover { color: var(--blue); }
  .mock-nav .nav-cta { color: white; padding: .72rem 1rem; border-radius: 7px; background: var(--blue); box-shadow: 0 7px 18px rgba(20,91,255,.18); }

  .mock-main { padding-bottom: 36px; }
  .mock-hero { text-align: center; padding: 54px 0 34px; }
  .mock-hero h1 { margin: 0 auto; max-width: 900px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(2.45rem, 4.2vw, 4.35rem); line-height: 1.03; letter-spacing: -.055em; font-weight: 800; }
  .mock-hero h1 span { color: var(--blue); }
  .hero-principle { max-width: 760px; margin: 14px auto 0; color: #34415f; font-size: clamp(.95rem,1.25vw,1.12rem); line-height: 1.55; }
  .hero-proof { max-width: 680px; margin: 10px auto 0; color: var(--muted); font-size: .91rem; line-height: 1.55; }
  .hero-actions { display: flex; justify-content: center; gap: 15px; margin-top: 22px; }
  .primary-button, .secondary-button { min-height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; border-radius: 7px; padding: 0 22px; font-size: .78rem; font-weight: 800; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .primary-button { color: #fff; background: var(--blue); box-shadow: 0 8px 18px rgba(20,91,255,.18); }
  .secondary-button { color: var(--ink); background: #fff; border: 1px solid #ccd6e9; }
  .primary-button:hover,.secondary-button:hover { transform: translateY(-2px); }

  .roadmap-flow { position: relative; }
  .journey-stage { position: relative; scroll-margin-top: 92px; }
  .stage-grid { display: grid; gap: 42px; align-items: center; }
  .strategy-grid { grid-template-columns: 30% 70%; min-height: 425px; padding: 24px 56px 14px 84px; }
  .architecture-grid { grid-template-columns: 61% 39%; min-height: 355px; padding: 18px 84px 18px 22px; }
  .applications-grid { grid-template-columns: 30% 70%; min-height: 310px; padding: 12px 56px 14px 84px; }
  .observability-grid { grid-template-columns: 65% 35%; min-height: 290px; padding: 10px 84px 12px 22px; }

  .stage-copy h2 { margin: 6px 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(1.55rem, 2.2vw, 2.2rem); line-height: 1.08; letter-spacing: -.045em; }
  .stage-kicker { margin: 0; color: var(--blue); font-size: .69rem; font-weight: 850; letter-spacing: .035em; }
  .stage-intro { margin: 0; color: #4e5d78; font-size: .79rem; line-height: 1.55; max-width: 360px; }
  .stage-note { margin: 13px 0 0; color: #66758f; font-size: .72rem; }
  .stage-list { display: grid; gap: 10px; margin-top: 17px; }
  .list-item { display: grid; grid-template-columns: 24px 1fr; gap: 9px; align-items: start; }
  .list-icon { width: 21px; height: 21px; display: grid; place-items: center; color: var(--blue); font-size: .75rem; font-weight: 850; border: 1px solid #bcd0ff; border-radius: 6px; background: #f8fbff; }
  .list-item p { margin: 0; color: var(--muted); font-size: .69rem; line-height: 1.38; }
  .list-item strong { color: var(--ink); font-size: .72rem; }

  .stage-rail { position: absolute; top: 27px; bottom: -1px; width: 66px; z-index: 7; pointer-events: none; }
  .rail-left { left: 2px; }
  .rail-right { right: 2px; }
  .stage-badge { position: absolute; top: 0; left: 50%; width: 54px; height: 54px; transform: translateX(-50%); display: grid; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(180deg,#1f67ff,#084be3); border: 5px solid #f4f8ff; box-shadow: 0 0 0 2px #c7d8ff, 0 0 20px rgba(20,91,255,.36); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.45rem; font-weight: 800; }
  .rail-line { position: absolute; top: 50px; bottom: 0; left: 50%; width: 4px; transform: translateX(-50%); border-radius: 999px; background: var(--blue); box-shadow: 0 0 8px rgba(20,91,255,.35), 0 0 18px rgba(20,91,255,.18); }
  .final-line { bottom: 7px; }
  .rail-foot { position: absolute; bottom: 0; left: 50%; width: 30px; height: 7px; transform: translateX(-50%); border-radius: 50%; background: #d7e4ff; box-shadow: 0 5px 16px rgba(20,91,255,.28); }

  .flow-transition { position: relative; height: 108px; z-index: 6; }
  .flow-transition svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .flow-path { fill: none; stroke: var(--blue); stroke-width: 4; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .flow-glow { fill: none; stroke: rgba(20,91,255,.12); stroke-width: 16; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .transition-pill { position: absolute; top: 58px; left: 50%; transform: translate(-50%,-50%); min-width: 330px; display: flex; align-items: center; justify-content: center; gap: 13px; padding: 10px 20px; border: 1px solid #c7d7fb; border-radius: 999px; background: rgba(255,255,255,.97); box-shadow: 0 3px 8px rgba(11,33,76,.08), 0 0 24px rgba(20,91,255,.12); z-index: 3; }
  .transition-pill strong { display: block; color: var(--blue); font-family: 'Plus Jakarta Sans',sans-serif; font-size: .9rem; line-height: 1.15; }
  .transition-pill small { display: block; color: #60708e; font-size: .64rem; line-height: 1.4; }
  .pill-icon { width: 29px; height: 29px; display: grid; place-items: center; color: var(--blue); font-size: 1rem; border: 1px solid #bcd0ff; border-radius: 50%; background: #f8fbff; }
  .flow-dot { position: absolute; top: 58px; width: 10px; height: 10px; border: 2px solid #fff; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 2px #bcd0ff; z-index: 4; }
  .dot-left { left: 5.5%; transform: translate(-50%,-50%); }
