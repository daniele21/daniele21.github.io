---
/**
 * LocalAIRoadmapMockup -Page assembly for the Local AI Roadmap landing page.
 *
 * Composes all roadmap sub-components into a single cohesive page with
 * progressive scroll-driven line drawing, smooth Bézier transitions,
 * and stage-by-stage viewport focus.
 */
import RoadmapHeader from '../roadmap/RoadmapHeader.astro';
import RoadmapHero from '../roadmap/RoadmapHero.astro';
import StrategyStage from '../roadmap/StrategyStage.astro';
import FlowTransition from '../roadmap/FlowTransition.astro';
import ArchitectureStage from '../roadmap/ArchitectureStage.astro';
import ApplicationsStage from '../roadmap/ApplicationsStage.astro';
import ObservabilityStage from '../roadmap/ObservabilityStage.astro';
import ClosingSection from '../roadmap/ClosingSection.astro';
import { flowTransitions } from '../../content/locales/en/roadmap';

import '../roadmap/roadmap-tokens.css';
---

<div class="roadmap-page">
  <RoadmapHeader />

  <main class="mock-shell mock-main">
    <RoadmapHero />

    <div class="roadmap-flow" data-flow>
      <!-- Stage 1: Strategy -->
      <StrategyStage />

      <!-- Transition: DECIDE → BUILD (Left to Right) -->
      <FlowTransition
        direction={flowTransitions[0].direction}
        icon={flowTransitions[0].icon}
        label={flowTransitions[0].label}
        sublabel={flowTransitions[0].sublabel}
        filterId="glow-a"
      />

      <!-- Stage 2: Architecture & Infrastructure -->
      <ArchitectureStage />

      <!-- Transition: BUILD → TEST (Right to Left) -->
      <FlowTransition
        direction={flowTransitions[1].direction}
        icon={flowTransitions[1].icon}
        label={flowTransitions[1].label}
        sublabel={flowTransitions[1].sublabel}
        filterId="glow-b"
      />

      <!-- Stage 3: Applications -->
      <ApplicationsStage />

      <!-- Transition: TEST → MEASURE (Left to Right) -->
      <FlowTransition
        direction={flowTransitions[2].direction}
        icon={flowTransitions[2].icon}
        label={flowTransitions[2].label}
        sublabel={flowTransitions[2].sublabel}
        filterId="glow-c"
      />

      <!-- Stage 4: Observability & Measurement -->
      <ObservabilityStage />
    </div>

    <ClosingSection />
  </main>
</div>

<script>
  /**
   * Scroll observer for Roadmap stages and flow transitions:
   * 1. Draws the connecting lines progressively as they enter the viewport
   * 2. Focuses the active stage ("un piano alla volta") while scrolling
   */
  function initRoadmapScroll() {
    const stages = document.querySelectorAll('.journey-stage');
    const transitions = document.querySelectorAll('.flow-transition');

    if (stages.length === 0) return;

    // 1. Reveal and line-drawing observer
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible', 'is-drawn');
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px',
      }
    );

    stages.forEach((stage) => revealObserver.observe(stage));
    transitions.forEach((t) => revealObserver.observe(t));

    // 2. Active Stage focus observer (highlights current stage in viewport)
    const focusObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            stages.forEach((s) => s.classList.remove('is-active'));
            entry.target.classList.add('is-active');
          }
        });
      },
      {
        threshold: 0.35,
        rootMargin: '-10% 0px -10% 0px',
      }
    );

    stages.forEach((stage) => focusObserver.observe(stage));

    // Initial state: Stage 1 active immediately
    if (stages[0]) {
      stages[0].classList.add('is-visible', 'is-drawn', 'is-active');
    }
  }

  // Initialize on load and on client-side navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRoadmapScroll);
  } else {
    initRoadmapScroll();
  }
</script>

<style>
  /* ---- Global overrides for the roadmap page ---- */
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    background: #ffffff;
    color: #081333;
  }
  :global(#main) {
    min-height: 100vh;
  }
  :global(.skip-link) {
    z-index: 9999;
  }
</style>
