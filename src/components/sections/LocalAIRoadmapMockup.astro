---
import RoadmapHeader from '../roadmap/RoadmapHeader.astro';
import RoadmapHero from '../roadmap/RoadmapHero.astro';
import StrategyStage from '../roadmap/StrategyStage.astro';
import FlowTransition from '../roadmap/FlowTransition.astro';
import ArchitectureStage from '../roadmap/ArchitectureStage.astro';
import ApplicationsStage from '../roadmap/ApplicationsStage.astro';
import ObservabilityStage from '../roadmap/ObservabilityStage.astro';
import ClosingSection from '../roadmap/ClosingSection.astro';
import { roadmapData } from '../../content';

import '../roadmap/roadmap-tokens.css';
import '../roadmap/roadmap-layout.css';
import '../roadmap/roadmap-polish.css';
---

<div class="roadmap-page">
  <RoadmapHeader data={roadmapData.header} />

  <main class="roadmap-shell roadmap-main">
    <RoadmapHero data={roadmapData.hero} />

    <div class="roadmap-flow">
      <StrategyStage data={roadmapData.strategy} />

      <FlowTransition
        direction={roadmapData.transitions[0].direction}
        label={roadmapData.transitions[0].label}
        sublabel={roadmapData.transitions[0].sublabel}
        icon={roadmapData.transitions[0].icon}
        filterId={roadmapData.transitions[0].filterId}
      />

      <ArchitectureStage data={roadmapData.architecture} />

      <FlowTransition
        direction={roadmapData.transitions[1].direction}
        label={roadmapData.transitions[1].label}
        sublabel={roadmapData.transitions[1].sublabel}
        icon={roadmapData.transitions[1].icon}
        filterId={roadmapData.transitions[1].filterId}
      />

      <ApplicationsStage data={roadmapData.applications} />

      <FlowTransition
        direction={roadmapData.transitions[2].direction}
        label={roadmapData.transitions[2].label}
        sublabel={roadmapData.transitions[2].sublabel}
        icon={roadmapData.transitions[2].icon}
        filterId={roadmapData.transitions[2].filterId}
      />

      <ObservabilityStage data={roadmapData.observability} />
    </div>

    <ClosingSection data={roadmapData.closing} />
  </main>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.roadmap-page');

  if (root && root.dataset.motionInitialized !== 'true') {
    root.dataset.motionInitialized = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const observed = Array.from(root.querySelectorAll<HTMLElement>('[data-observe]'));

    if (reducedMotion || !('IntersectionObserver' in window)) {
      observed.forEach((element) => element.classList.add('is-active'));
    } else {
      const activateVisibleElements = () => {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        observed.forEach((element) => {
          const rect = element.getBoundingClientRect();
          const visible = rect.top < viewportHeight * 0.82 && rect.bottom > viewportHeight * 0.18;
          if (visible) element.classList.add('is-active');
        });
      };

      activateVisibleElements();
      root.dataset.motion = 'ready';

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const element = entry.target as HTMLElement;
            if (entry.isIntersecting && entry.intersectionRatio >= 0.22) {
              element.classList.add('is-active');
            } else if (!entry.isIntersecting) {
              element.classList.remove('is-active');
            }
          }
        },
        {
          threshold: [0, 0.22, 0.45, 0.7],
          rootMargin: '-10% 0px -10% 0px',
        },
      );

      observed.forEach((element) => observer.observe(element));
    }
  }
</script>
