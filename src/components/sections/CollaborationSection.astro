---
/**
 * CollaborationSection - Dark card CTA section with contact email and location.
 */
import { socialLinks } from '../../content/site';
---

<section class="collaboration" id="collaborate" aria-labelledby="collaboration-title">
  <div class="shell collaboration-inner reveal">
    <div>
      <p class="section-kicker">COLLABORATE</p>
      <h2 id="collaboration-title">Let's build the future of <strong>local AI infrastructure</strong>.</h2>
      <p>Open to collaboration, architecture feedback, and engineering challenges across <em>local LLM performance</em>, <em>Android on-device inference</em>, and <em>privacy-first product design</em>.</p>
      <div class="collaboration-info" style="margin-top: 20px;">
        <span><svg style="width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> {socialLinks.email}</span>
        <span><svg style="width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2" viewBox="0 0 24 24"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg> Milan, Italy</span>
      </div>
    </div>

    <div class="collaboration-actions">
      <a class="button button-primary" href={`mailto:${socialLinks.email}`}>Get in touch <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href={socialLinks.linkedin} target="_blank" rel="noreferrer" style="color:#fff;border-color:rgba(255,255,255,0.4);background:transparent;">Connect on LinkedIn ↗</a>
    </div>
  </div>
</section>

<style>
  .collaboration {
    padding: var(--space-10) 0 clamp(60px, 8vw, 100px);
  }

  .collaboration-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-10);
    padding: clamp(32px, 5vw, 58px);
    border-radius: var(--radius-xl);
    color: #ffffff;
    background:
      radial-gradient(circle at 86% 10%, rgba(95, 119, 255, 0.45), transparent 20rem),
      linear-gradient(135deg, #0c1c43, #153d91);
    box-shadow: 0 28px 80px rgba(18, 48, 108, 0.25);
  }

  .collaboration .section-kicker {
    color: #a7c3ff;
  }

  .collaboration h2 {
    max-width: 780px;
    color: #ffffff;
  }

  .collaboration p {
    max-width: 740px;
    margin-top: var(--space-4);
    margin-bottom: 0;
    color: #cbd8f5;
    font-size: var(--text-body);
  }

  .collaboration-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-4);
    min-width: 220px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 52px;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 750;
    font-size: var(--text-small);
    transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
    cursor: pointer;
    border: none;
  }

  .collaboration .button-primary {
    color: var(--accent-blue);
    background: #ffffff;
    box-shadow: none;
  }

  .collaboration .button-primary:hover {
    background: var(--surface-muted);
  }

  .collaboration-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: #cbd8f5;
  }

  .collaboration-info span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 820px) {
    .collaboration-inner {
      grid-template-columns: 1fr;
    }

    .collaboration-actions {
      align-items: flex-start;
      min-width: 0;
    }
  }
</style>
