---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const focusAreas = [
  {
    index: '01',
    title: 'Local inference',
    text: 'Quantization, GGUF, llama.cpp, MLX and hardware-aware inference for workloads that do not need a cloud round trip.',
    tags: ['Quantization', 'GGUF', 'llama.cpp', 'MLX'],
  },
  {
    index: '02',
    title: 'Runtime engineering',
    text: 'Model lifecycle, memory, concurrency, observability and failure modes: the systems work between a model file and a reliable product.',
    tags: ['Memory', 'Lifecycle', 'Telemetry', 'Reliability'],
  },
  {
    index: '03',
    title: 'On-device AI',
    text: 'Desktop, Android and edge execution where hardware constraints, thermal behaviour and application integration become product decisions.',
    tags: ['Android', 'Desktop', 'Edge', 'IPC'],
  },
  {
    index: '04',
    title: 'Hybrid architectures',
    text: 'Choosing what should run locally, what still belongs in the cloud, and how to keep those boundaries portable instead of vendor-locked.',
    tags: ['Local-first', 'Cloud', 'Routing', 'Portability'],
  },
];

const labProjects = [
  {
    eyebrow: 'INFRASTRUCTURE · ACTIVE RESEARCH',
    title: 'Android Local LLM Harness',
    text: 'A shared on-device LLM runtime for Android, focused on model residency, memory pressure, lifecycle, Binder/AIDL integration and evidence from physical devices.',
    href: `${baseUrl}/android-local-llm-harness`,
    tags: ['Android', 'llama.cpp', 'GGUF', 'Memory', 'IPC'],
  },
  {
    eyebrow: 'INFRASTRUCTURE · ACTIVE DEVELOPMENT',
    title: 'Local LLM Server',
    text: 'Reusable local inference infrastructure for desktop products: model lifecycle, routing, concurrency, multiple backends and runtime telemetry.',
    href: `${baseUrl}/local-llm-server`,
    tags: ['GGUF', 'MLX', 'Routing', 'Lifecycle', 'Telemetry'],
  },
  {
    eyebrow: 'REFERENCE APPLICATION',
    title: 'ClosedRoom',
    text: 'Private meeting intelligence running on-device. A proving ground for local speech, local language models and end-to-end product constraints.',
    href: `${baseUrl}/closedroom`,
    tags: ['Local ASR', 'Local LLM', 'macOS', 'Privacy'],
  },
  {
    eyebrow: 'REFERENCE APPLICATION',
    title: 'RedactGuard',
    text: 'Local document intelligence for identifying and reviewing sensitive information without turning raw documents into a cloud dependency.',
    href: `${baseUrl}/redact-guard`,
    tags: ['PII', 'Documents', 'Local LLM', 'Privacy'],
  },
];

const evidenceMetrics = [
  ['TTFT', 'How long until the first useful token?'],
  ['Tokens / sec', 'What throughput does this device sustain?'],
  ['Peak RAM', 'Can the workload coexist with the rest of the product?'],
  ['Load time', 'How expensive is model residency and switching?'],
  ['Thermals', 'Does performance hold after the first benchmark?'],
  ['Task quality', 'Does the smaller local system still solve the workload?'],
];

const principles = [
  {
    number: '01',
    title: 'Local-first is not local-only.',
    text: 'Use frontier cloud models where their additional capability creates value. Keep a local execution path where control matters more.',
  },
  {
    number: '02',
    title: 'Running the model is the easy part.',
    text: 'Lifecycle, memory, observability, concurrency and hardware variability are what turn inference into infrastructure.',
  },
  {
    number: '03',
    title: 'Model choice is a systems problem.',
    text: 'Quality cannot be separated from RAM, latency, thermals, context requirements, runtime support and the actual product workload.',
  },
  {
    number: '04',
    title: 'Privacy is only one reason to go local.',
    text: 'Control, offline execution, predictable unit economics and independence from model-provider lifecycle decisions matter too.',
  },
  {
    number: '05',
    title: 'Benchmark the workload, not the leaderboard.',
    text: 'The right system is the smallest one that reliably solves the task under the constraints of the device and product.',
  },
];

const channels = [
  {
    label: 'GitHub',
    title: 'Code and experiments',
    text: 'Infrastructure, implementation details and the engineering work behind the claims.',
    href: 'https://github.com/daniele21',
  },
  {
    label: 'stAI tuned',
    title: 'Long-form research',
    text: 'Technical analysis, model evaluations and deeper reasoning about AI architectures and products.',
    href: 'https://staituned.com',
  },
  {
    label: 'LinkedIn',
    title: 'Working ideas in public',
    text: 'Shorter observations, experiments and discussions around local AI, architecture and the AI market.',
    href: 'https://www.linkedin.com/in/daniele-moltisanti/',
  },
];

const advisory = [
  ['Local AI feasibility', 'Can this workload realistically run locally, on which devices, and with which quality / latency trade-offs?'],
  ['Architecture review', 'Where should the boundary sit between local, cloud and hybrid execution?'],
  ['Technical evaluation', 'Benchmark models, runtimes and hardware against the actual workload rather than generic leaderboards.'],
];
---

<section class="brand-hero" id="top" aria-labelledby="brand-hero-title">
  <div class="shell brand-hero-grid">
    <div class="brand-hero-copy reveal">
      <div class="eyebrow-pill">LOCAL AI · ON-DEVICE AI · AI INFRASTRUCTURE</div>
      <p class="identity-line">Daniele Moltisanti</p>
      <h1 id="brand-hero-title">I build and study AI that runs <span>closer to the user.</span></h1>
      <p class="hero-lede">
        I explore how <strong>local and hybrid AI can become reliable infrastructure for real products</strong> — across desktop, mobile and privacy-sensitive workloads.
      </p>
      <p class="hero-thesis">Running a model is the easy part. Making it product-ready is the work.</p>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="#local-ai-lab">Explore the Local AI Lab <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={`${baseUrl}/local-ai`}>Read the field guide <span aria-hidden="true">→</span></a>
      </div>
      <a class="follow-link" href="https://www.linkedin.com/in/daniele-moltisanti/" target="_blank" rel="noreferrer">Follow my research on LinkedIn ↗</a>
    </div>

    <aside class="identity-card reveal" aria-label="Daniele Moltisanti profile and current focus">
      <div class="identity-top">
        <img src={`${baseUrl}/images/profile-photo.jpg`} alt="Daniele Moltisanti" loading="eager" />
        <div>
          <strong>Daniele Moltisanti</strong>
          <span>AI Technical Leader · Builder</span>
          <span>Milan, Italy</span>
        </div>
      </div>
      <div class="identity-divider"></div>
      <p class="card-kicker">CURRENT FOCUS</p>
      <ul class="focus-list">
        <li><span></span> Product-grade local inference</li>
        <li><span></span> Android & desktop runtimes</li>
        <li><span></span> Local / cloud boundaries</li>
        <li><span></span> Evidence from real devices</li>
      </ul>
      <div class="build-loop">BUILD <b>→</b> MEASURE <b>→</b> DOCUMENT <b>→</b> SHARE</div>
    </aside>
  </div>
</section>

<div class="section-divider"></div>

<section class="section" id="expertise" aria-labelledby="expertise-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <div class="section-kicker">WHAT I WORK ON</div>
        <h2 id="expertise-title">Making local AI product-ready.</h2>
      </div>
      <p>The interesting question is no longer whether a model can run locally. It is what the rest of the system needs to make that useful, repeatable and accountable.</p>
    </div>

    <div class="expertise-grid">
      {focusAreas.map((area) => (
        <article class="expertise-card">
          <div class="card-index">{area.index}</div>
          <h3>{area.title}</h3>
          <p>{area.text}</p>
          <div class="tag-row">
            {area.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section lab-section" id="local-ai-lab" aria-labelledby="lab-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <div class="section-kicker">LOCAL AI LAB</div>
        <h2 id="lab-title">Infrastructure, experiments and proving grounds.</h2>
      </div>
      <p>The projects are not the personal brand. They are the evidence behind it: reusable infrastructure first, reference applications second.</p>
    </div>

    <div class="lab-grid" id="projects">
      {labProjects.map((project) => (
        <a class="lab-card" href={project.href}>
          <div class="lab-eyebrow">{project.eyebrow}</div>
          <h3>{project.title}</h3>
          <p>{project.text}</p>
          <div class="tag-row">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <div class="card-link">Explore project <span aria-hidden="true">→</span></div>
        </a>
      ))}
    </div>

    <div class="evidence-project">
      <div>
        <div class="lab-eyebrow">MEASUREMENT LAYER</div>
        <h3>Traffic Monitoring & evidence</h3>
        <p>Separate what was observed from what is merely assumed. Network evidence complements runtime telemetry so privacy and local-execution claims remain measurable rather than rhetorical.</p>
      </div>
      <div class="evidence-links">
        <a href={`${baseUrl}/traffic-monitoring`}>macOS evidence →</a>
        <a href={`${baseUrl}/traffic-monitoring-android`}>Android evidence →</a>
      </div>
    </div>
  </div>
</section>

<section class="section evidence-section" id="evidence" aria-labelledby="evidence-title">
  <div class="shell evidence-layout">
    <div class="evidence-copy">
      <div class="section-kicker">MEASURE, DON'T CLAIM</div>
      <h2 id="evidence-title">Local AI needs evidence, not demos.</h2>
      <p>A single successful generation says very little about whether a local system belongs in a product. The useful unit of evidence is the workload running on the actual device under the actual constraints.</p>
      <div class="evidence-question">
        <span>THE QUESTION I WANT EACH TEST TO ANSWER</span>
        <strong>What is the smallest system that solves this workload reliably?</strong>
      </div>
      <a class="text-link" href={`${baseUrl}/local-ai#benchmarks`}>Open the benchmark framework →</a>
    </div>

    <div class="metric-grid" aria-label="Local AI measurement framework">
      {evidenceMetrics.map(([metric, description]) => (
        <div class="metric-card">
          <strong>{metric}</strong>
          <span>{description}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section" id="thesis" aria-labelledby="thesis-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <div class="section-kicker">MY LOCAL AI THESIS</div>
        <h2 id="thesis-title">How I think about the local / cloud boundary.</h2>
      </div>
      <p>Expertise is more useful when it produces testable opinions. These are the principles currently guiding my work.</p>
    </div>

    <div class="principles-list">
      {principles.map((principle) => (
        <article class="principle-row">
          <span class="principle-number">{principle.number}</span>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section research-section" id="research" aria-labelledby="research-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <div class="section-kicker">BUILD IN PUBLIC</div>
        <h2 id="research-title">One research trail, three surfaces.</h2>
      </div>
      <p>Code shows what exists. Long-form writing explains the reasoning. Social discussion exposes ideas early enough to be challenged.</p>
    </div>

    <div class="channel-grid">
      {channels.map((channel) => (
        <a class="channel-card" href={channel.href} target="_blank" rel="noreferrer">
          <span class="channel-label">{channel.label}</span>
          <h3>{channel.title}</h3>
          <p>{channel.text}</p>
          <span class="card-link">Open {channel.label} ↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section" id="about" aria-labelledby="about-title">
  <div class="shell about-grid">
    <div>
      <div class="section-kicker">BEYOND THE LAB</div>
      <h2 id="about-title">Technical depth, product context.</h2>
      <p class="about-copy">My independent local-AI work builds on experience evaluating, designing and scaling AI systems in complex organisations. The goal is not to collect demos, but to understand which architectures survive real product constraints.</p>
    </div>
    <div class="proof-grid">
      <div class="proof"><strong>Enterprise</strong><span>AI technical leadership</span></div>
      <div class="proof"><strong>80+</strong><span>technical articles published</span></div>
      <div class="proof"><strong>150+</strong><span>AI projects reviewed</span></div>
      <div class="proof"><strong>Top Nova 111</strong><span>Nova Talent recognition</span></div>
    </div>
  </div>
</section>

<section class="section advisory-section" id="advisory" aria-labelledby="advisory-title">
  <div class="shell advisory-shell">
    <div class="advisory-copy">
      <div class="section-kicker">ADVISORY</div>
      <h2 id="advisory-title">Should part of your AI stack run locally?</h2>
      <p>I work with teams that need a technical and strategic answer to that question — before committing to a runtime, device strategy or architecture.</p>
      <a class="button button-primary" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20workload">Discuss an AI workload <span aria-hidden="true">→</span></a>
    </div>
    <div class="advisory-list">
      {advisory.map(([title, description], index) => (
        <div class="advisory-item">
          <span>0{index + 1}</span>
          <div><strong>{title}</strong><p>{description}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .brand-hero {
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 112px);
    overflow: clip;
  }

  .brand-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(330px, 0.65fr);
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
  }

  .brand-hero-copy { max-width: 760px; }

  .eyebrow-pill {
    display: inline-flex;
    padding: 7px 13px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--accent-blue);
    background: var(--surface-blue);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: .1em;
  }

  .identity-line {
    margin: var(--space-6) 0 var(--space-2);
    color: var(--ink-muted);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .brand-hero h1 {
    margin: 0;
    max-width: 780px;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.2vw, 5rem);
    line-height: .99;
    letter-spacing: -.055em;
    color: var(--ink);
  }

  .brand-hero h1 span {
    color: var(--accent-blue);
  }

  .hero-lede {
    max-width: 690px;
    margin: var(--space-6) 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.65;
  }

  .hero-thesis {
    margin: var(--space-4) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 11px 22px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 750;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--accent-blue); box-shadow: 0 8px 24px rgba(37,99,235,.22); }
  .button-secondary { color: var(--ink); background: var(--surface-card); border: 1px solid var(--border-subtle); }
  .button-secondary:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }

  .follow-link,
  .text-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 650;
  }
  .follow-link:hover,
  .text-link:hover { color: var(--accent-blue); }

  .identity-card {
    position: relative;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--surface-card), var(--surface-blue));
    box-shadow: var(--shadow-lg);
  }

  .identity-card::after {
    content: '';
    position: absolute;
    inset: auto 24px -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-blue), transparent);
  }

  .identity-top {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: var(--space-4);
    align-items: center;
  }

  .identity-top img {
    width: 76px;
    height: 76px;
    border-radius: 22px;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }

  .identity-top strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; }
  .identity-top span { display: block; margin-top: 4px; color: var(--ink-muted); font-size: var(--text-small); }
  .identity-divider { height: 1px; margin: var(--space-6) 0; background: var(--border-subtle); }
  .card-kicker { margin: 0 0 var(--space-3); color: var(--accent-blue); font-size: var(--text-xs); font-weight: 800; letter-spacing: .12em; }
  .focus-list { display: grid; gap: 11px; padding: 0; margin: 0; list-style: none; color: var(--ink-muted); font-size: var(--text-small); }
  .focus-list li { display: flex; gap: 10px; align-items: center; }
  .focus-list li span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-teal); box-shadow: 0 0 0 4px var(--surface-teal); }
  .build-loop { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px dashed var(--border-subtle); color: var(--ink-subtle); font-family: var(--font-mono); font-size: .69rem; letter-spacing: .03em; }
  .build-loop b { color: var(--accent-blue); }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .expertise-card,
  .metric-card,
  .channel-card,
  .proof {
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    border-radius: var(--radius-md);
  }

  .expertise-card { padding: var(--space-6); }
  .card-index { color: var(--accent-blue); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 800; }
  .expertise-card h3,
  .lab-card h3,
  .channel-card h3 { margin: var(--space-4) 0 var(--space-2); color: var(--ink); font-family: var(--font-display); font-size: 1.12rem; }
  .expertise-card p,
  .lab-card p,
  .channel-card p { margin: 0; color: var(--ink-muted); font-size: var(--text-small); line-height: 1.6; }

  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-5); }
  .tag-row span { padding: 5px 8px; border-radius: 999px; background: var(--surface-muted); color: var(--ink-subtle); font-size: .68rem; font-weight: 650; }

  .lab-section { background: linear-gradient(180deg, transparent, var(--surface-muted) 16%, var(--surface-muted) 84%, transparent); }
  .lab-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .lab-card {
    display: block;
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out-expo), box-shadow var(--duration-base) ease, border-color var(--duration-fast) ease;
  }
  .lab-card:hover { transform: translateY(-4px); border-color: var(--border-strong); box-shadow: var(--shadow-md); }
  .lab-eyebrow,
  .channel-label { color: var(--accent-blue); font-size: .69rem; font-weight: 800; letter-spacing: .1em; }
  .card-link { margin-top: var(--space-6); color: var(--accent-blue); font-size: var(--text-small); font-weight: 750; }

  .evidence-project {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-8);
    margin-top: var(--space-4);
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--surface-card), var(--surface-teal));
  }
  .evidence-project h3 { margin: var(--space-3) 0 var(--space-2); color: var(--ink); font-family: var(--font-display); font-size: 1.25rem; }
  .evidence-project p { max-width: 760px; margin: 0; color: var(--ink-muted); line-height: 1.6; }
  .evidence-links { display: flex; flex-direction: column; gap: var(--space-2); }
  .evidence-links a { color: var(--accent-teal); text-decoration: none; font-size: var(--text-small); font-weight: 750; }

  .evidence-layout { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 88px); align-items: center; }
  .evidence-copy h2,
  .about-grid h2,
  .advisory-copy h2 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: var(--text-h2); line-height: 1.12; letter-spacing: -.03em; }
  .evidence-copy > p,
  .about-copy,
  .advisory-copy > p { margin: var(--space-4) 0 0; color: var(--ink-muted); font-size: var(--text-body-lg); line-height: 1.65; }
  .evidence-question { margin-top: var(--space-6); padding: var(--space-5); border-left: 3px solid var(--accent-blue); background: var(--surface-blue); }
  .evidence-question span { display: block; color: var(--accent-blue); font-size: .66rem; font-weight: 800; letter-spacing: .1em; }
  .evidence-question strong { display: block; margin-top: var(--space-2); color: var(--ink); font-family: var(--font-display); line-height: 1.4; }
  .metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .metric-card { padding: var(--space-5); }
  .metric-card strong { display: block; color: var(--ink); font-family: var(--font-mono); font-size: .9rem; }
  .metric-card span { display: block; margin-top: var(--space-2); color: var(--ink-muted); font-size: var(--text-small); line-height: 1.5; }

  .principles-list { border-top: 1px solid var(--border-subtle); }
  .principle-row { display: grid; grid-template-columns: 56px minmax(220px, .75fr) minmax(0, 1.25fr); gap: var(--space-6); align-items: start; padding: var(--space-6) 0; border-bottom: 1px solid var(--border-subtle); }
  .principle-number { color: var(--accent-blue); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 800; }
  .principle-row h3 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; }
  .principle-row p { margin: 0; color: var(--ink-muted); font-size: var(--text-small); line-height: 1.65; }

  .research-section { background: var(--surface-muted); }
