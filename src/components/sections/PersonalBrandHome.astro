---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const focusAreas = [
  {
    index: '01',
    symbol: '◫',
    title: 'Local inference',
    question: 'What can run well on the device?',
    text: 'Quantization, GGUF, llama.cpp, MLX and hardware-aware inference for workloads that do not need a cloud round trip.',
    tags: ['Quantization', 'GGUF', 'llama.cpp', 'MLX'],
  },
  {
    index: '02',
    symbol: '⌘',
    title: 'Runtime engineering',
    question: 'What makes inference reliable?',
    text: 'Model lifecycle, memory, concurrency, observability and failure modes between a model file and a dependable product.',
    tags: ['Memory', 'Lifecycle', 'Telemetry', 'Reliability'],
  },
  {
    index: '03',
    symbol: '▣',
    title: 'On-device AI',
    question: 'What changes on real hardware?',
    text: 'Desktop, Android and edge execution where RAM, thermals and application integration become product constraints.',
    tags: ['Android', 'Desktop', 'Edge', 'IPC'],
  },
  {
    index: '04',
    symbol: '⇄',
    title: 'Hybrid architectures',
    question: 'Where should local stop and cloud begin?',
    text: 'Choosing the right execution boundary and keeping it portable instead of binding the product to one provider.',
    tags: ['Local-first', 'Cloud', 'Routing', 'Portability'],
  },
];

const labProjects = [
  {
    group: 'Infrastructure',
    status: 'Active research',
    title: 'Android Local LLM Harness',
    text: 'Shared on-device LLM infrastructure for Android: residency, memory pressure, lifecycle, Binder/AIDL and physical-device evidence.',
    href: `${baseUrl}/android-local-llm-harness`,
    logo: `${baseUrl}/images/harness/logo.svg`,
    tags: ['Android', 'llama.cpp', 'GGUF', 'IPC'],
  },
  {
    group: 'Infrastructure',
    status: 'Active development',
    title: 'Local LLM Server',
    text: 'Reusable desktop inference infrastructure for model lifecycle, routing, concurrency, multiple backends and telemetry.',
    href: `${baseUrl}/local-llm-server`,
    logo: `${baseUrl}/images/local-llm-server/logo.svg`,
    tags: ['GGUF', 'MLX', 'Routing', 'Telemetry'],
  },
  {
    group: 'Application',
    status: 'Proving ground',
    title: 'ClosedRoom',
    text: 'Private meeting intelligence used to test local speech, local LLMs and end-to-end product constraints.',
    href: `${baseUrl}/closedroom`,
    logo: `${baseUrl}/images/closedroom/logo.png`,
    tags: ['Local ASR', 'Local LLM', 'macOS'],
  },
  {
    group: 'Application',
    status: 'Proving ground',
    title: 'RedactGuard',
    text: 'Local document intelligence for identifying and reviewing sensitive information without a raw-document cloud dependency.',
    href: `${baseUrl}/redact-guard`,
    logo: `${baseUrl}/images/redact-guard/logo.png`,
    tags: ['PII', 'Documents', 'Local LLM'],
  },
];

const evidenceMetrics = [
  { group: 'Speed', metric: 'TTFT', description: 'Time until the first useful token.' },
  { group: 'Speed', metric: 'Tokens / sec', description: 'Sustained generation throughput.' },
  { group: 'Capacity', metric: 'Peak RAM', description: 'Whether the workload fits beside the rest of the product.' },
  { group: 'Lifecycle', metric: 'Load time', description: 'Cost of model residency and switching.' },
  { group: 'Stability', metric: 'Thermals', description: 'Whether performance survives repeated use.' },
  { group: 'Outcome', metric: 'Task quality', description: 'Whether the local system still solves the real task.' },
];

const principles = [
  {
    number: '01',
    title: 'Local-first is not local-only.',
    text: 'Use frontier cloud models where their additional capability creates value. Keep a local execution path where control matters more.',
  },
  {
    number: '02',
    title: 'Running the model is the easy part.',
    text: 'Lifecycle, memory, observability, concurrency and hardware variability are what turn inference into infrastructure.',
  },
  {
    number: '03',
    title: 'Model choice is a systems problem.',
    text: 'Quality cannot be separated from RAM, latency, thermals, context requirements, runtime support and the product workload.',
  },
  {
    number: '04',
    title: 'Privacy is only one reason to go local.',
    text: 'Control, offline execution, predictable unit economics and independence from provider lifecycle decisions matter too.',
  },
  {
    number: '05',
    title: 'Benchmark the workload, not the leaderboard.',
    text: 'The right system is the smallest one that reliably solves the task under the constraints of the device and product.',
  },
];

const channels = [
  {
    label: 'GitHub',
    mark: 'GH',
    title: 'Code & evidence',
    text: 'Infrastructure, implementation details and reproducible engineering work.',
    href: 'https://github.com/daniele21',
  },
  {
    label: 'stAI tuned',
    mark: 'AI',
    title: 'Long-form research',
    text: 'Technical analysis, model evaluations and deeper architectural reasoning.',
    href: 'https://staituned.com',
  },
  {
    label: 'LinkedIn',
    mark: 'in',
    title: 'Working ideas',
    text: 'New findings, experiments and discussions shared while the work is evolving.',
    href: 'https://www.linkedin.com/in/daniele-moltisanti/',
  },
];

const advisory = [
  ['Local AI feasibility', 'Can this workload realistically run locally, on which devices, and with which quality / latency trade-offs?'],
  ['Architecture review', 'Where should the boundary sit between local, cloud and hybrid execution?'],
  ['Technical evaluation', 'Benchmark models, runtimes and hardware against the actual workload rather than generic leaderboards.'],
];
---

<section class="brand-hero" id="top" aria-labelledby="brand-hero-title">
  <div class="shell brand-hero-grid">
    <div class="brand-hero-copy reveal">
      <div class="hero-identity">
        <span class="hero-name">Daniele Moltisanti</span>
        <span class="hero-dot" aria-hidden="true"></span>
        <span>Local AI · On-device AI · AI infrastructure</span>
      </div>
      <h1 id="brand-hero-title">I build and study AI that runs <span>closer to the user.</span></h1>
      <p class="hero-lede">
        I explore how <strong>local and hybrid AI become reliable infrastructure for real products</strong> — across desktop, mobile and privacy-sensitive workloads.
      </p>
      <div class="hero-thesis">
        <span aria-hidden="true">↳</span>
        <p><strong>Running a model is the easy part.</strong> Making it product-ready is the work.</p>
      </div>

      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="#local-ai-lab">Explore the Local AI Lab <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={`${baseUrl}/local-ai`}>Understand Local AI <span aria-hidden="true">→</span></a>
      </div>
      <a class="follow-link" href="https://www.linkedin.com/in/daniele-moltisanti/" target="_blank" rel="noreferrer">Follow new research on LinkedIn ↗</a>
    </div>

    <aside class="identity-card reveal" aria-label="Daniele Moltisanti profile and current focus">
      <div class="identity-top">
        <img src={`${baseUrl}/images/profile-photo.jpg`} alt="Daniele Moltisanti" loading="eager" />
        <div>
          <strong>Daniele Moltisanti</strong>
          <span>AI Technical Leader · Builder</span>
          <span>Milan, Italy</span>
        </div>
      </div>
      <div class="identity-divider"></div>
      <p class="card-kicker">CURRENT RESEARCH</p>
      <ul class="focus-list">
        <li><span></span><div><strong>Inference</strong><small>quantized models on real devices</small></div></li>
        <li><span></span><div><strong>Runtimes</strong><small>memory, lifecycle and shared execution</small></div></li>
        <li><span></span><div><strong>Architecture</strong><small>local / cloud boundaries</small></div></li>
        <li><span></span><div><strong>Evidence</strong><small>measurements instead of claims</small></div></li>
      </ul>
      <div class="build-loop"><span>BUILD</span><b>→</b><span>MEASURE</span><b>→</b><span>DOCUMENT</span><b>→</b><span>SHARE</span></div>
    </aside>
  </div>

  <div class="shell orientation-rail" aria-label="How to explore the site">
    <div><span>01</span><strong>Understand</strong><small>the local AI problem</small></div>
    <b aria-hidden="true">→</b>
    <div><span>02</span><strong>Inspect</strong><small>running infrastructure</small></div>
    <b aria-hidden="true">→</b>
    <div><span>03</span><strong>Verify</strong><small>evidence & measurements</small></div>
    <b aria-hidden="true">→</b>
    <div><span>04</span><strong>Apply</strong><small>to real workloads</small></div>
  </div>
</section>

<section class="section expertise-section" id="expertise" aria-labelledby="expertise-title">
  <div class="shell">
    <div class="section-heading compact-heading">
      <div>
        <div class="section-kicker">WHAT I WORK ON</div>
        <h2 id="expertise-title">Making local AI product-ready.</h2>
      </div>
      <p>Four questions define most of the work.</p>
    </div>

    <div class="expertise-grid">
      {focusAreas.map((area) => (
        <article class="expertise-card">
          <div class="expertise-card-top">
            <span class="expertise-symbol" aria-hidden="true">{area.symbol}</span>
            <span class="card-index">{area.index}</span>
          </div>
          <h3>{area.title}</h3>
          <p class="decision-question">{area.question}</p>
          <p class="expertise-copy">{area.text}</p>
          <div class="tag-row">
            {area.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section lab-section" id="local-ai-lab" aria-labelledby="lab-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <div class="section-kicker">LOCAL AI LAB</div>
        <h2 id="lab-title">How the work connects.</h2>
      </div>
      <p>Infrastructure runs the models. Evidence shows what actually happened. Applications expose whether the system is useful.</p>
    </div>

    <div class="lab-map" aria-label="Local AI Lab architecture">
      <div class="lab-map-step">
        <span>01 · FOUNDATION</span>
        <strong>Runtime infrastructure</strong>
        <small>Load · route · share · observe</small>
      </div>
      <div class="map-arrow" aria-hidden="true">→</div>
      <div class="lab-map-step evidence-step">
        <span>02 · PROOF</span>
        <strong>Runtime & network evidence</strong>
        <small>Measure · compare · expose uncertainty</small>
      </div>
      <div class="map-arrow" aria-hidden="true">→</div>
      <div class="lab-map-step application-step">
        <span>03 · VALIDATION</span>
        <strong>Reference applications</strong>
        <small>Test real product constraints</small>
      </div>
    </div>

    <div class="lab-group-label" id="projects"><span>Projects in the lab</span><small>Click any card for architecture, constraints and evidence.</small></div>
    <div class="lab-grid">
      {labProjects.map((project) => (
        <a class="lab-card" href={project.href}>
          <div class="lab-card-head">
            <img src={project.logo} alt="" width="42" height="42" loading="lazy" />
            <div>
              <span class="lab-group">{project.group}</span>
              <span class="status-pill">{project.status}</span>
            </div>
          </div>
          <h3>{project.title}</h3>
          <p>{project.text}</p>
          <div class="tag-row">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <div class="card-link">Explore project <span aria-hidden="true">→</span></div>
        </a>
      ))}
    </div>

    <div class="evidence-project">
      <div class="evidence-project-mark" aria-hidden="true">◎</div>
      <div>
        <div class="lab-group">MEASUREMENT LAYER</div>
        <h3>Traffic Monitoring & evidence</h3>
        <p>Separate what was observed from what is merely assumed. Network evidence complements runtime telemetry so local-execution claims remain measurable.</p>
      </div>
      <div class="evidence-links">
        <a href={`${baseUrl}/traffic-monitoring`}>macOS evidence →</a>
        <a href={`${baseUrl}/traffic-monitoring-android`}>Android evidence →</a>
      </div>
    </div>
  </div>
</section>

<section class="section evidence-section" id="evidence" aria-labelledby="evidence-title">
  <div class="shell evidence-layout">
    <div class="evidence-copy">
      <div class="section-kicker">MEASURE, DON'T CLAIM</div>
      <h2 id="evidence-title">Local AI needs evidence, not demos.</h2>
      <p>A successful generation does not tell you whether a local system belongs in a product. Measure the workload on the actual device, under the actual constraints.</p>
      <div class="evidence-question">
        <span>THE DECISION QUESTION</span>
        <strong>What is the smallest system that solves this workload reliably?</strong>
      </div>
      <a class="text-link" href={`${baseUrl}/local-ai#benchmarks`}>Open the benchmark framework →</a>
    </div>

    <div class="metric-panel" aria-label="Local AI measurement framework">
      <div class="metric-panel-head">
        <span>MEASUREMENT FRAMEWORK</span>
        <small>Performance → capacity → stability → outcome</small>
      </div>
      <div class="metric-grid">
        {evidenceMetrics.map((item) => (
          <div class="metric-card">
            <span class="metric-group">{item.group}</span>
            <strong>{item.metric}</strong>
            <span class="metric-description">{item.description}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section thesis-section" id="thesis" aria-labelledby="thesis-title">
  <div class="shell">
    <div class="section-heading compact-heading">
      <div>
        <div class="section-kicker">MY LOCAL AI THESIS</div>
        <h2 id="thesis-title">Five opinions that guide the work.</h2>
      </div>
      <p>Short enough to remember. Specific enough to test.</p>
    </div>

    <div class="principles-list">
      {principles.map((principle) => (
        <article class="principle-row">
          <span class="principle-number">{principle.number}</span>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section research-section" id="research" aria-labelledby="research-title">
  <div class="shell">
    <div class="section-heading compact-heading">
      <div>
        <div class="section-kicker">BUILD IN PUBLIC</div>
        <h2 id="research-title">One research trail, three surfaces.</h2>
      </div>
      <p>Choose the depth you want.</p>
    </div>

    <div class="channel-grid">
      {channels.map((channel) => (
        <a class="channel-card" href={channel.href} target="_blank" rel="noreferrer">
          <div class="channel-head">
            <span class="channel-mark">{channel.mark}</span>
            <span class="channel-label">{channel.label}</span>
          </div>
          <h3>{channel.title}</h3>
          <p>{channel.text}</p>
          <span class="card-link">Open {channel.label} ↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section about-section" id="about" aria-labelledby="about-title">
  <div class="shell about-grid">
    <div>
      <div class="section-kicker">BEYOND THE LAB</div>
      <h2 id="about-title">Technical depth, product context.</h2>
      <p class="about-copy">My independent local-AI work builds on experience evaluating, designing and scaling AI systems in complex organisations. The goal is to understand which architectures survive real product constraints.</p>
    </div>
    <div class="proof-grid" aria-label="Professional track record">
      <div class="proof"><strong>Enterprise</strong><span>AI technical leadership</span></div>
      <div class="proof"><strong>80+</strong><span>technical articles published</span></div>
      <div class="proof"><strong>150+</strong><span>AI projects reviewed</span></div>
      <div class="proof"><strong>Top Nova 111</strong><span>Nova Talent recognition</span></div>
    </div>
  </div>
</section>

<section class="section advisory-section" id="advisory" aria-labelledby="advisory-title">
  <div class="shell advisory-shell">
    <div class="advisory-copy">
      <div class="section-kicker">ADVISORY</div>
      <h2 id="advisory-title">Should part of your AI stack run locally?</h2>
      <p>I work with teams that need a technical and strategic answer before committing to a runtime, device strategy or architecture.</p>
      <a class="button button-primary" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20workload">Discuss an AI workload <span aria-hidden="true">→</span></a>
    </div>
    <div class="advisory-list">
      {advisory.map(([title, description], index) => (
        <div class="advisory-item">
          <span>0{index + 1}</span>
          <div><strong>{title}</strong><p>{description}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .brand-hero {
    padding: clamp(42px, 6vw, 84px) 0 clamp(52px, 7vw, 88px);
    overflow: clip;
  }

  .brand-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, .62fr);
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
  }

  .brand-hero-copy { max-width: 760px; }

  .hero-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-bottom: var(--space-5);
    color: var(--ink-subtle);
    font-size: .73rem;
    font-weight: 750;
    letter-spacing: .075em;
    text-transform: uppercase;
  }

  .hero-name { color: var(--ink); font-weight: 850; }
  .hero-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent-blue); }

  .brand-hero h1 {
    margin: 0;
    max-width: 790px;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.2vw, 5rem);
    line-height: 1;
    letter-spacing: -.055em;
    color: var(--ink);
  }

  .brand-hero h1 span { color: var(--accent-blue); }

  .hero-lede {
    max-width: 690px;
    margin: var(--space-6) 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.04rem, 1.4vw, 1.22rem);
    line-height: 1.62;
  }

  .hero-thesis {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 650px;
    margin-top: var(--space-4);
    padding: 11px 14px;
    border-left: 2px solid var(--accent-blue);
    background: linear-gradient(90deg, var(--surface-blue), transparent);
  }
  .hero-thesis > span { color: var(--accent-blue); font-weight: 800; }
  .hero-thesis p { margin: 0; color: var(--ink-muted); font-size: var(--text-small); line-height: 1.55; }
  .hero-thesis strong { color: var(--ink); }

  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7, 28px); }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 11px 20px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 760;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--accent-blue); box-shadow: 0 8px 24px rgba(37,99,235,.2); }
  .button-primary:hover { box-shadow: 0 12px 30px rgba(37,99,235,.28); }
  .button-secondary { color: var(--ink); background: var(--surface-card); border: 1px solid var(--border-subtle); }
  .button-secondary:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }

  .follow-link,
  .text-link { display: inline-block; margin-top: var(--space-4); color: var(--ink-muted); text-decoration: none; font-size: var(--text-small); font-weight: 650; }
  .follow-link:hover,
  .text-link:hover { color: var(--accent-blue); }

  .identity-card {
    position: relative;
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
  }
  .identity-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(circle at 100% 0%, var(--surface-blue), transparent 42%);
  }
  .identity-card > * { position: relative; }

  .identity-top { display: grid; grid-template-columns: 72px 1fr; gap: var(--space-4); align-items: center; }
  .identity-top img { width: 72px; height: 72px; border-radius: 20px; object-fit: cover; border: 1px solid var(--border-subtle); }
  .identity-top strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: 1.04rem; }
  .identity-top span { display: block; margin-top: 4px; color: var(--ink-muted); font-size: .78rem; }
  .identity-divider { height: 1px; margin: var(--space-5) 0; background: var(--border-subtle); }
  .card-kicker { margin: 0 0 var(--space-3); color: var(--accent-blue); font-size: .68rem; font-weight: 850; letter-spacing: .12em; }
  .focus-list { display: grid; gap: 12px; padding: 0; margin: 0; list-style: none; }
  .focus-list li { display: grid; grid-template-columns: 8px 1fr; gap: 11px; align-items: center; }
  .focus-list li > span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-teal); box-shadow: 0 0 0 4px var(--surface-teal); }
  .focus-list strong { display: block; color: var(--ink); font-size: .82rem; }
  .focus-list small { display: block; margin-top: 1px; color: var(--ink-subtle); font-size: .72rem; line-height: 1.35; }
  .build-loop { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px dashed var(--border-subtle); color: var(--ink-subtle); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .03em; }
  .build-loop b { color: var(--accent-blue); }

  .orientation-rail {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    margin-top: clamp(42px, 6vw, 72px);
    padding: 18px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }
  .orientation-rail > div { display: grid; grid-template-columns: auto 1fr; column-gap: 9px; align-items: baseline; }
  .orientation-rail span { grid-row: span 2; color: var(--accent-blue); font-family: var(--font-mono); font-size: .66rem; font-weight: 800; }
  .orientation-rail strong { color: var(--ink); font-size: .8rem; }
  .orientation-rail small { color: var(--ink-subtle); font-size: .7rem; }
  .orientation-rail > b { color: var(--border-strong); font-weight: 500; }

  .expertise-section { border-top: 1px solid var(--border-subtle); }
  .compact-heading { align-items: center; }
  .compact-heading > p { max-width: 360px; }

  .expertise-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .expertise-card,
  .metric-card,
  .channel-card,
  .proof { border: 1px solid var(--border-subtle); background: var(--surface-card); border-radius: var(--radius-md); }

  .expertise-card { display: flex; flex-direction: column; min-height: 330px; padding: var(--space-5); }
  .expertise-card-top { display: flex; justify-content: space-between; align-items: center; }
  .expertise-symbol { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--surface-blue); color: var(--accent-blue); font-family: var(--font-mono); font-weight: 800; }
  .card-index { color: var(--ink-subtle); font-family: var(--font-mono); font-size: .68rem; font-weight: 800; }
  .expertise-card h3,
  .lab-card h3,
