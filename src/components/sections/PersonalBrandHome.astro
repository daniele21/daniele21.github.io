---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const featuredWork = [
  {
    className: 'feature-card feature-card-harness',
    label: 'ANDROID · RUNTIME',
    title: 'Android Local LLM Harness',
    text: 'A shared local LLM runtime, tested on real devices.',
    href: `${baseUrl}/android-local-llm-harness`,
    image: `${baseUrl}/images/harness/harness-playground-current.webp`,
    imageAlt: 'Android Local LLM Harness running a local Qwen model and showing runtime metrics.',
  },
  {
    className: 'feature-card feature-card-server',
    label: 'DESKTOP · INFRASTRUCTURE',
    title: 'Local LLM Server',
    text: 'Reusable local inference across products.',
    href: `${baseUrl}/local-llm-server`,
    image: `${baseUrl}/images/local-llm-server/chat-studio.png`,
    imageAlt: 'Local LLM Server interface.',
  },
  {
    className: 'feature-card feature-card-closedroom',
    label: 'MACOS · PRODUCT',
    title: 'ClosedRoom',
    text: 'Private meeting intelligence, running on-device.',
    href: `${baseUrl}/closedroom`,
    image: `${baseUrl}/images/closedroom/home.jpg`,
    imageAlt: 'ClosedRoom local meeting intelligence application.',
  },
];

const currentQuestions = [
  {
    number: '01',
    question: 'Can multiple Android apps share one resident model?',
    context: 'Residency · IPC · memory pressure',
    href: `${baseUrl}/android-local-llm-harness`,
  },
  {
    number: '02',
    question: 'How much infrastructure does local inference really need?',
    context: 'Lifecycle · routing · observability',
    href: `${baseUrl}/local-llm-server`,
  },
  {
    number: '03',
    question: 'Can PII detection stay local without retraining a model?',
    context: 'Local LLM · documents · configurable PII',
    href: `${baseUrl}/redact-guard`,
  },
];

const channels = [
  {
    name: 'GitHub',
    purpose: 'Code & experiments',
    href: 'https://github.com/daniele21',
    mark: 'GH',
  },
  {
    name: 'stAI tuned',
    purpose: 'Long-form research',
    href: 'https://staituned.com',
    mark: 'AI',
  },
  {
    name: 'LinkedIn',
    purpose: 'Working ideas',
    href: 'https://www.linkedin.com/in/daniele-moltisanti/',
    mark: 'in',
  },
];

const trackRecord = [
  ['Enterprise', 'AI technical leadership'],
  ['80+', 'technical articles'],
  ['150+', 'AI projects reviewed'],
  ['Top Nova 111', 'Nova Talent'],
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy reveal">
      <div class="hero-person">
        <img src={`${baseUrl}/images/profile-photo.jpg`} alt="Daniele Moltisanti" width="46" height="46" loading="eager" />
        <div>
          <strong>Daniele Moltisanti</strong>
          <span>Local AI · On-device AI · AI infrastructure</span>
        </div>
      </div>

      <h1 id="hero-title">I make local AI work <span>in real products.</span></h1>
      <p class="hero-lede">On-device inference, runtimes and hybrid architectures — built and measured on real hardware.</p>

      <div class="hero-actions">
        <a class="button button-primary" href="#projects">See what I'm building <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={`${baseUrl}/local-ai`}>Local AI Field Guide <span aria-hidden="true">→</span></a>
      </div>

      <div class="hero-current">
        <span class="live-dot" aria-hidden="true"></span>
        <span><strong>Current experiment:</strong> shared local LLM infrastructure on Android.</span>
      </div>
    </div>

    <a class="hero-proof-card reveal" href={`${baseUrl}/android-local-llm-harness`} aria-label="Open Android Local LLM Harness">
      <div class="proof-card-top">
        <span>RUNNING SOFTWARE</span>
        <small>Android · real device</small>
      </div>
      <div class="proof-screen">
        <img src={`${baseUrl}/images/harness/harness-playground-current.webp`} alt="Harness running Qwen3.5-2B locally on Android." loading="eager" />
      </div>
      <div class="proof-card-bottom">
        <div>
          <strong>Qwen3.5-2B Q4_K_M</strong>
          <span>Local inference in Harness</span>
        </div>
        <div class="proof-number">
          <strong>≈ 9.50</strong>
          <span>tok/s</span>
        </div>
      </div>
    </a>
  </div>
</section>

<section class="section featured" id="local-ai-lab" aria-labelledby="featured-title">
  <div class="shell">
    <div class="section-head">
      <div>
        <span class="kicker">FEATURED WORK</span>
        <h2 id="featured-title">The projects are the proof.</h2>
      </div>
      <p>Infrastructure, products and experiments built to answer concrete Local AI questions.</p>
    </div>

    <div class="feature-grid" id="projects">
      {featuredWork.map((item) => (
        <a class={item.className} href={item.href}>
          <div class="feature-image">
            <img src={item.image} alt={item.imageAlt} loading="lazy" />
          </div>
          <div class="feature-copy">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <b aria-hidden="true">→</b>
          </div>
        </a>
      ))}
    </div>

    <div class="more-work">
      <a href={`${baseUrl}/redact-guard`}>
        <span>RedactGuard</span>
        <strong>Local PII intelligence for documents</strong>
        <b>→</b>
      </a>
      <a href={`${baseUrl}/traffic-monitoring`}>
        <span>Traffic Monitoring</span>
        <strong>Evidence for what local software sends</strong>
        <b>→</b>
      </a>
      <a href={`${baseUrl}/local-ai`}>
        <span>Field Guide</span>
        <strong>A practical map of the Local AI stack</strong>
        <b>→</b>
      </a>
    </div>
  </div>
</section>

<section class="section evidence" id="evidence" aria-labelledby="evidence-title">
  <div class="shell evidence-grid">
    <div class="evidence-intro">
      <span class="kicker">REAL DEVICE · ONE OBSERVED RUN</span>
      <h2 id="evidence-title">One run. Four numbers.</h2>
      <p>Useful Local AI decisions start with what actually happened on the device.</p>
      <a class="text-link" href={`${baseUrl}/android-local-llm-harness`}>Explore Harness evidence →</a>
    </div>

    <div class="metric-board" aria-label="Observed Android Harness run metrics">
      <div class="metric metric-primary">
        <span>TTFT</span>
        <strong>1318 <small>ms</small></strong>
        <p>First visible token</p>
      </div>
      <div class="metric">
        <span>DECODE</span>
        <strong>≈ 9.50 <small>tok/s</small></strong>
        <p>Local generation speed</p>
      </div>
      <div class="metric">
        <span>TOTAL</span>
        <strong>3451 <small>ms</small></strong>
        <p>End-to-end run</p>
      </div>
      <div class="metric metric-model">
        <span>MODEL</span>
        <strong>Qwen3.5-2B</strong>
        <p>Q4_K_M · GGUF</p>
      </div>
      <div class="metric-note">Single observed Harness run. Device, model, prompt and runtime context matter.</div>
    </div>
  </div>
</section>

<section class="section questions" aria-labelledby="questions-title">
  <div class="shell">
    <div class="section-head section-head-tight">
      <div>
        <span class="kicker">CURRENT RESEARCH</span>
        <h2 id="questions-title">The questions I'm testing now.</h2>
      </div>
    </div>

    <div class="question-list">
      {currentQuestions.map((item) => (
        <a class="question-row" href={item.href}>
          <span class="question-number">{item.number}</span>
          <h3>{item.question}</h3>
          <span class="question-context">{item.context}</span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section research" id="research" aria-labelledby="research-title">
  <div class="shell research-grid">
    <div class="research-copy">
      <span class="kicker">FOLLOW THE WORK</span>
      <h2 id="research-title">Code. Research. Ideas.</h2>
      <p>The same work, at three levels of depth.</p>
    </div>

    <div class="channel-list">
      {channels.map((channel) => (
        <a href={channel.href} target="_blank" rel="noreferrer">
          <span class="channel-mark">{channel.mark}</span>
          <div>
            <strong>{channel.name}</strong>
            <small>{channel.purpose}</small>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section track" aria-labelledby="track-title">
  <div class="shell track-shell">
    <div class="track-copy">
      <span class="kicker">BEYOND THE LAB</span>
      <h2 id="track-title">Technical depth, product context.</h2>
      <p>AI technical leader and builder based in Milan.</p>
    </div>

    <div class="track-grid">
      {trackRecord.map(([value, label]) => (
        <div class="track-item">
          <strong>{value}</strong>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section advisory" id="advisory" aria-labelledby="advisory-title">
  <div class="shell advisory-card">
    <div>
      <span class="advisory-kicker">ADVISORY</span>
      <h2 id="advisory-title">Deciding what should run locally?</h2>
      <p>I help teams evaluate feasibility, runtime choices and the local / cloud boundary.</p>
    </div>
    <div class="advisory-side">
      <div class="advisory-tags">
        <span>Feasibility</span>
        <span>Architecture</span>
        <span>Technical evaluation</span>
      </div>
      <a class="button advisory-button" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20workload">Discuss a workload <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(48px, 7vw, 92px) 0 clamp(64px, 8vw, 108px);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr);
    gap: clamp(44px, 7vw, 100px);
    align-items: center;
  }

  .hero-copy { max-width: 720px; }

  .hero-person {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: clamp(24px, 4vw, 42px);
  }

  .hero-person img {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }

  .hero-person strong,
  .hero-person span { display: block; }
  .hero-person strong { color: var(--ink); font-size: .92rem; }
  .hero-person span { margin-top: 3px; color: var(--ink-subtle); font-size: .72rem; font-weight: 700; letter-spacing: .055em; text-transform: uppercase; }

  .hero h1 {
    margin: 0;
    max-width: 760px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6vw, 6.25rem);
    line-height: .92;
    letter-spacing: -.064em;
  }

  .hero h1 span { color: #7557ff; }

  .hero-lede {
    max-width: 620px;
    margin: 24px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.08rem, 1.45vw, 1.3rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 11px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 750;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: #7557ff; box-shadow: 0 10px 30px rgba(117,87,255,.24); }
  .button-secondary { color: var(--ink); background: var(--surface-card); border: 1px solid var(--border-subtle); }
  .button-secondary:hover { border-color: var(--border-strong); }

  .hero-current {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    color: var(--ink-subtle);
    font-size: .8rem;
  }

  .hero-current strong { color: var(--ink-muted); }
  .live-dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: #2dd4bf; box-shadow: 0 0 0 5px rgba(45,212,191,.12); }

  .hero-proof-card {
    position: relative;
    display: block;
    padding: 14px;
    border: 1px solid var(--border-subtle);
    border-radius: 30px;
    background: linear-gradient(150deg, var(--surface-card), rgba(117,87,255,.07));
    box-shadow: 0 28px 80px rgba(15,23,42,.18);
    text-decoration: none;
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .hero-proof-card:hover { transform: translateY(-5px) rotate(-.25deg); box-shadow: 0 34px 90px rgba(15,23,42,.24); }

  .proof-card-top,
  .proof-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .proof-card-top { padding: 4px 5px 13px; }
  .proof-card-top span { color: #7557ff; font-size: .68rem; font-weight: 850; letter-spacing: .12em; }
  .proof-card-top small { color: var(--ink-subtle); font-size: .75rem; }

  .proof-screen {
    height: min(52vw, 560px);
    max-height: 560px;
    min-height: 420px;
    border-radius: 21px;
    overflow: hidden;
    background: #080d18;
  }

  .proof-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .proof-card-bottom { padding: 16px 6px 5px; }
  .proof-card-bottom strong,
  .proof-card-bottom span { display: block; }
  .proof-card-bottom > div:first-child strong { color: var(--ink); font-family: var(--font-display); font-size: 1rem; }
  .proof-card-bottom > div:first-child span { margin-top: 3px; color: var(--ink-subtle); font-size: .78rem; }
  .proof-number { text-align: right; }
  .proof-number strong { color: #7557ff; font-family: var(--font-display); font-size: 1.2rem; }
  .proof-number span { color: var(--ink-subtle); font-size: .72rem; }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 440px);
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .section-head-tight { grid-template-columns: 1fr; }
  .kicker,
  .advisory-kicker { color: #7557ff; font-size: .72rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }

  .section-head h2,
  .evidence-intro h2,
  .research-copy h2,
  .track-copy h2,
  .advisory-card h2 {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.55rem);
    line-height: 1.02;
    letter-spacing: -.04em;
  }

  .section-head > p,
  .evidence-intro > p,
  .research-copy > p,
  .track-copy > p,
  .advisory-card > div > p {
    margin: 0;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .featured { background: linear-gradient(180deg, transparent, var(--surface-muted) 10%, var(--surface-muted) 92%, transparent); }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, .84fr);
    grid-template-rows: repeat(2, minmax(250px, 1fr));
    gap: 16px;
  }

  .feature-card {
    position: relative;
    display: grid;
    overflow: hidden;
    min-height: 290px;
    border: 1px solid var(--border-subtle);
    border-radius: 26px;
    background: var(--surface-card);
    text-decoration: none;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .feature-card:hover { transform: translateY(-4px); border-color: var(--border-strong); box-shadow: var(--shadow-md); }
  .feature-card-harness { grid-row: 1 / span 2; min-height: 600px; }

  .feature-image { position: absolute; inset: 0; overflow: hidden; background: var(--surface-muted); }
  .feature-image::after { content: ''; position: absolute; inset: 34% 0 0; background: linear-gradient(180deg, transparent, rgba(7,12,24,.9)); }
  .feature-card-server .feature-image::after,
  .feature-card-closedroom .feature-image::after { inset: 22% 0 0; }

  .feature-image img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform .4s ease; }
  .feature-card:hover .feature-image img { transform: scale(1.025); }

  .feature-copy {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: clamp(22px, 3vw, 32px);
    color: #fff;
  }

  .feature-copy > span { font-size: .67rem; font-weight: 850; letter-spacing: .12em; opacity: .76; }
  .feature-copy h3 { margin: 8px 0 0; font-family: var(--font-display); font-size: clamp(1.35rem, 2.25vw, 2.1rem); letter-spacing: -.025em; }
  .feature-copy p { margin: 6px 0 0; max-width: 520px; color: rgba(255,255,255,.76); line-height: 1.45; }
  .feature-copy b { position: absolute; right: 26px; bottom: 28px; font-size: 1.3rem; }

  .more-work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .more-work a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 12px;
    padding: 18px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    background: var(--surface-card);
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease;
  }

  .more-work a:hover { transform: translateY(-2px); border-color: var(--border-strong); }
  .more-work span { grid-column: 1; color: #7557ff; font-size: .7rem; font-weight: 800; }
  .more-work strong { grid-column: 1; color: var(--ink); font-size: .9rem; line-height: 1.35; }
  .more-work b { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--ink-subtle); }

  .evidence-grid {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(40px, 7vw, 92px);
    align-items: center;
  }

  .evidence-intro { max-width: 470px; }
  .evidence-intro > p { margin-top: 16px; font-size: 1.08rem; }
  .text-link { display: inline-block; margin-top: 20px; color: #7557ff; text-decoration: none; font-size: .86rem; font-weight: 750; }

  .metric-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--border-subtle);
    border-radius: 28px;
    background: linear-gradient(145deg, var(--surface-muted), var(--surface-card));
  }

  .metric {
    min-height: 158px;
    padding: 22px;
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    background: var(--surface-card);
  }

  .metric > span { color: var(--ink-subtle); font-size: .68rem; font-weight: 850; letter-spacing: .1em; }
  .metric > strong { display: block; margin-top: 13px; color: var(--ink); font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 3rem); line-height: 1; letter-spacing: -.04em; }
  .metric > strong small { color: var(--ink-subtle); font-family: var(--font-sans); font-size: .78rem; letter-spacing: 0; }
  .metric p { margin: 10px 0 0; color: var(--ink-muted); font-size: .8rem; }
  .metric-primary { background: linear-gradient(145deg, rgba(117,87,255,.11), var(--surface-card)); }
  .metric-primary > strong { color: #7557ff; }
  .metric-model > strong { font-size: clamp(1.35rem, 2.5vw, 2.35rem); }
  .metric-note { grid-column: 1 / -1; padding: 6px 8px 2px; color: var(--ink-subtle); font-size: .72rem; text-align: center; }

  .questions { background: var(--surface-muted); }
  .question-list { border-top: 1px solid var(--border-subtle); }
  .question-row {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) minmax(220px, .52fr) 30px;
    gap: 20px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
  }

  .question-number { color: #7557ff; font-family: var(--font-mono); font-size: .72rem; font-weight: 800; }
  .question-row h3 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(1.05rem, 1.8vw, 1.35rem); }
  .question-context { color: var(--ink-subtle); font-size: .78rem; }
  .question-row b { color: var(--ink-subtle); transition: transform .18s ease, color .18s ease; }
  .question-row:hover b { transform: translateX(4px); color: #7557ff; }

  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, .68fr) minmax(0, 1.32fr);
    gap: clamp(40px, 7vw, 92px);
    align-items: center;
  }

  .research-copy > p { margin-top: 12px; }
  .channel-list { display: grid; gap: 10px; }
  .channel-list a {
    display: grid;
    grid-template-columns: 46px 1fr 24px;
    gap: 14px;
    align-items: center;
    padding: 15px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: 17px;
    background: var(--surface-card);
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease;
  }

  .channel-list a:hover { transform: translateX(4px); border-color: var(--border-strong); }
  .channel-mark { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px; background: rgba(117,87,255,.1); color: #7557ff; font-family: var(--font-mono); font-size: .75rem; font-weight: 850; }
  .channel-list strong,
  .channel-list small { display: block; }
  .channel-list strong { color: var(--ink); }
  .channel-list small { margin-top: 2px; color: var(--ink-subtle); }
  .channel-list b { color: var(--ink-subtle); }

  .track-shell {
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr);
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
    padding: clamp(26px, 4vw, 42px);
    border: 1px solid var(--border-subtle);
    border-radius: 28px;
    background: var(--surface-card);
  }

  .track-copy > p { margin-top: 10px; }
