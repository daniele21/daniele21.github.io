---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const whyItems = [
  { label: 'CONTROL', title: 'Own the execution path.', symbol: '01' },
  { label: 'PRIVACY', title: 'Keep sensitive work closer.', symbol: '02' },
  { label: 'CHOICE', title: 'Use local, cloud — or both.', symbol: '03' },
];

const pillars = [
  {
    title: 'Inference',
    subtitle: 'What can run well on-device?',
    tags: ['GGUF', 'Quantization', 'llama.cpp', 'MLX'],
    mark: '01',
  },
  {
    title: 'Runtimes',
    subtitle: 'What makes it reliable?',
    tags: ['Memory', 'Lifecycle', 'IPC', 'Telemetry'],
    mark: '02',
  },
  {
    title: 'Boundaries',
    subtitle: 'What belongs local vs cloud?',
    tags: ['Hybrid', 'Routing', 'Privacy', 'Portability'],
    mark: '03',
  },
];

const projects = [
  {
    title: 'Android LLM Harness',
    type: 'Infrastructure',
    href: `${baseUrl}/android-local-llm-harness`,
    logo: `${baseUrl}/images/harness/logo.svg`,
    summary: 'Shared on-device LLM runtime.',
  },
  {
    title: 'Local LLM Server',
    type: 'Infrastructure',
    href: `${baseUrl}/local-llm-server`,
    logo: `${baseUrl}/images/local-llm-server/logo.svg`,
    summary: 'Reusable desktop inference layer.',
  },
  {
    title: 'ClosedRoom',
    type: 'Application',
    href: `${baseUrl}/closedroom`,
    logo: `${baseUrl}/images/closedroom/logo.png`,
    summary: 'Private meeting intelligence.',
  },
  {
    title: 'RedactGuard',
    type: 'Application',
    href: `${baseUrl}/redact-guard`,
    logo: `${baseUrl}/images/redact-guard/logo.png`,
    summary: 'Local PII document intelligence.',
  },
];

const thesis = [
  ['01', 'Local-first ≠ local-only', 'Use cloud when it adds value.'],
  ['02', 'Running is easy. Reliability is hard.', 'Infrastructure is the real work.'],
  ['03', 'Benchmark the workload.', 'Not the leaderboard.'],
];

const channels = [
  ['GitHub', 'Code & evidence', 'https://github.com/daniele21'],
  ['stAI tuned', 'Long-form research', 'https://staituned.com'],
  ['LinkedIn', 'Working ideas', 'https://www.linkedin.com/in/daniele-moltisanti/'],
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy reveal">
      <div class="identity-line">
        <strong>Daniele Moltisanti</strong>
        <span>Local AI · On-device AI · AI Infrastructure</span>
      </div>

      <h1 id="hero-title">Local AI,<br /><span>made product-ready.</span></h1>
      <p class="hero-sub">I turn local AI from a demo into something you can actually build products on.</p>

      <div class="hero-actions">
        <a class="button primary" href="#local-ai-lab">Explore the Lab <span>→</span></a>
        <a class="button secondary" href={`${baseUrl}/local-ai`}>Field Guide <span>→</span></a>
      </div>

      <div class="hero-proof">
        <span class="pulse-dot"></span>
        <span>Building, measuring and documenting on real devices.</span>
      </div>
    </div>

    <div class="system-visual reveal" aria-label="Local AI system from device to product">
      <div class="visual-head">
        <span>LOCAL AI SYSTEM</span>
        <small>from model to product</small>
      </div>

      <div class="visual-stage devices-stage">
        <div class="stage-label">DEVICE</div>
        <div class="device-row">
          <div class="device-chip">
            <span class="phone-shape"><i></i></span>
            <b>Android</b>
          </div>
          <div class="device-chip">
            <span class="laptop-shape"><i></i></span>
            <b>Desktop</b>
          </div>
        </div>
      </div>

      <div class="visual-connector"><span></span><b>↓</b></div>

      <div class="visual-stage runtime-stage">
        <div class="stage-label">RUNTIME</div>
        <div class="runtime-core">
          <span class="core-orbit"></span>
          <strong>Inference layer</strong>
          <small>llama.cpp · MLX · lifecycle</small>
        </div>
      </div>

      <div class="visual-connector"><span></span><b>↓</b></div>

      <div class="visual-stage evidence-stage">
        <div class="stage-label">EVIDENCE</div>
        <div class="metric-mini-row">
          <span>TTFT</span>
          <span>tok/s</span>
          <span>RAM</span>
          <span>Thermals</span>
        </div>
      </div>

      <div class="visual-connector"><span></span><b>↓</b></div>

      <div class="product-stage">
        <strong>REAL PRODUCT</strong>
        <span>useful · measurable · controlled</span>
      </div>
    </div>
  </div>
</section>

<section class="section why" aria-labelledby="why-title">
  <div class="shell">
    <div class="mini-heading">
      <span>WHY LOCAL AI</span>
      <h2 id="why-title">The point is not “offline AI”.<br />It is <em>more control over the product.</em></h2>
    </div>

    <div class="why-grid">
      {whyItems.map((item) => (
        <article class="why-card">
          <span class="why-number">{item.symbol}</span>
          <div class="why-icon" aria-hidden="true"><span></span></div>
          <small>{item.label}</small>
          <strong>{item.title}</strong>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section work" id="expertise" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-row-head">
      <div>
        <span class="kicker">WHAT I WORK ON</span>
        <h2 id="work-title">Three layers. One system.</h2>
      </div>
      <a href={`${baseUrl}/local-ai`}>Understand the stack →</a>
    </div>

    <div class="pillar-grid">
      {pillars.map((pillar) => (
        <article class="pillar-card">
          <span class="pillar-mark">{pillar.mark}</span>
          <div class="pillar-line"></div>
          <h3>{pillar.title}</h3>
          <p>{pillar.subtitle}</p>
          <div class="tag-row">
            {pillar.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section lab" id="local-ai-lab" aria-labelledby="lab-title">
  <div class="shell">
    <div class="mini-heading lab-heading">
      <span>LOCAL AI LAB</span>
      <h2 id="lab-title">Infrastructure first.<br /><em>Applications second. Evidence always.</em></h2>
    </div>

    <div class="lab-map" aria-label="Local AI Lab architecture map">
      <div class="map-column">
        <span class="map-label">FOUNDATION</span>
        <div class="map-node strong-node">
          <span class="node-dot"></span>
          <div><strong>Runtime infrastructure</strong><small>load · route · share</small></div>
        </div>
      </div>

      <div class="map-flow" aria-hidden="true"><span></span><b>→</b></div>

      <div class="map-column">
        <span class="map-label">PROOF</span>
        <div class="map-node evidence-node">
          <span class="node-ring"></span>
          <div><strong>Evidence</strong><small>measure · compare</small></div>
        </div>
      </div>

      <div class="map-flow" aria-hidden="true"><span></span><b>→</b></div>

      <div class="map-column">
        <span class="map-label">VALIDATION</span>
        <div class="map-node product-node">
          <span class="node-square"></span>
          <div><strong>Real applications</strong><small>test product constraints</small></div>
        </div>
      </div>
    </div>

    <div class="project-grid" id="projects">
      {projects.map((project) => (
        <a class="project-card" href={project.href}>
          <div class="project-top">
            <img src={project.logo} alt="" width="38" height="38" loading="lazy" />
            <span>{project.type}</span>
          </div>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <b>→</b>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section proof-section" id="evidence" aria-labelledby="proof-title">
  <div class="shell proof-shell">
    <div class="proof-copy">
      <span class="kicker">MEASURE, DON'T CLAIM</span>
      <h2 id="proof-title">A demo proves almost nothing.</h2>
      <p>Real devices. Real constraints. Real workloads.</p>
      <a href={`${baseUrl}/local-ai#benchmarks`}>Benchmark framework →</a>
    </div>

    <div class="proof-visual" aria-label="Local AI benchmark dimensions">
      <div class="proof-band speed-band">
        <span>SPEED</span>
        <strong>TTFT</strong>
        <strong>tok/s</strong>
      </div>
      <div class="proof-band stability-band">
        <span>STABILITY</span>
        <strong>RAM</strong>
        <strong>Load</strong>
        <strong>Thermals</strong>
      </div>
      <div class="proof-band outcome-band">
        <span>OUTCOME</span>
        <strong>Task quality</strong>
      </div>
    </div>
  </div>
</section>

<section class="section thesis" id="thesis" aria-labelledby="thesis-title">
  <div class="shell">
    <div class="section-row-head">
      <div>
        <span class="kicker">MY THESIS</span>
        <h2 id="thesis-title">Three things I believe.</h2>
      </div>
      <a href={`${baseUrl}/local-ai`}>Read the Field Guide →</a>
    </div>

    <div class="thesis-grid">
      {thesis.map(([number, title, line]) => (
        <article class="thesis-card">
          <span>{number}</span>
          <h3>{title}</h3>
          <p>{line}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section follow" id="research" aria-labelledby="follow-title">
  <div class="shell follow-shell">
    <div>
      <span class="kicker">FOLLOW THE WORK</span>
      <h2 id="follow-title">Code. Research. Ideas.</h2>
    </div>

    <div class="channel-row">
      {channels.map(([label, purpose, href]) => (
        <a href={href} target="_blank" rel="noreferrer">
          <span>{label}</span>
          <strong>{purpose}</strong>
          <b>↗</b>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section advisory" id="advisory" aria-labelledby="advisory-title">
  <div class="shell advisory-box">
    <div>
      <span class="advisory-kicker">ADVISORY</span>
      <h2 id="advisory-title">What should actually run locally?</h2>
      <p>I help teams answer that before they commit to an architecture.</p>
    </div>
    <div class="advisory-actions">
      <div class="advisory-tags">
        <span>Feasibility</span><span>Architecture</span><span>Evaluation</span>
      </div>
      <a class="button advisory-button" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20workload">Discuss a workload <span>→</span></a>
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(48px, 7vw, 96px) 0 clamp(56px, 8vw, 100px); overflow: clip; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .82fr); gap: clamp(40px, 7vw, 96px); align-items: center; }
  .hero-copy { max-width: 710px; }
  .identity-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; margin-bottom: var(--space-6); color: var(--ink-subtle); font-size: .74rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .identity-line strong { color: var(--ink); font-size: .8rem; }
  .identity-line strong::after { content: ''; display: inline-block; width: 4px; height: 4px; margin-left: 14px; border-radius: 50%; background: var(--accent-blue); vertical-align: middle; }
  .hero h1 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(3.1rem, 6vw, 6.2rem); line-height: .92; letter-spacing: -.065em; }
  .hero h1 span { color: var(--accent-blue); }
  .hero-sub { max-width: 610px; margin: var(--space-6) 0 0; color: var(--ink-muted); font-size: clamp(1.05rem, 1.35vw, 1.22rem); line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 48px; padding: 11px 20px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); text-decoration: none; font-size: var(--text-small); font-weight: 750; transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease; }
  .button:hover { transform: translateY(-2px); }
  .button.primary { color: #fff; border-color: var(--accent-blue); background: var(--accent-blue); box-shadow: 0 10px 30px rgba(37,99,235,.2); }
  .button.secondary { color: var(--ink); background: var(--surface-card); }
  .button.secondary:hover { border-color: var(--border-strong); }
  .hero-proof { display: flex; align-items: center; gap: 10px; margin-top: var(--space-5); color: var(--ink-subtle); font-size: .78rem; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-teal); box-shadow: 0 0 0 5px var(--surface-teal); }

  .system-visual { position: relative; padding: 22px; border: 1px solid var(--border-subtle); border-radius: 28px; background: linear-gradient(155deg, var(--surface-card), var(--surface-blue)); box-shadow: var(--shadow-lg); }
  .system-visual::before { content: ''; position: absolute; inset: 14px; border: 1px dashed color-mix(in srgb, var(--border-subtle) 70%, transparent); border-radius: 20px; pointer-events: none; }
  .visual-head { position: relative; z-index: 1; display: flex; justify-content: space-between; gap: 20px; padding: 2px 4px 18px; border-bottom: 1px solid var(--border-subtle); }
  .visual-head span { color: var(--accent-blue); font-family: var(--font-mono); font-size: .68rem; font-weight: 800; letter-spacing: .12em; }
  .visual-head small { color: var(--ink-subtle); font-size: .7rem; }
  .visual-stage { position: relative; z-index: 1; display: grid; grid-template-columns: 68px 1fr; gap: 16px; align-items: center; padding: 14px 6px; }
  .stage-label { color: var(--ink-subtle); font-family: var(--font-mono); font-size: .62rem; font-weight: 800; letter-spacing: .09em; }
  .device-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .device-chip { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border-subtle); border-radius: 12px; background: var(--surface-card); color: var(--ink); font-size: .75rem; }
  .phone-shape { position: relative; width: 13px; height: 22px; border: 1.5px solid var(--accent-blue); border-radius: 3px; }
  .phone-shape i { position: absolute; left: 50%; bottom: 2px; width: 3px; height: 3px; border-radius: 50%; background: var(--accent-blue); transform: translateX(-50%); }
  .laptop-shape { position: relative; width: 24px; height: 16px; border: 1.5px solid var(--accent-blue); border-radius: 2px; }
  .laptop-shape::after { content: ''; position: absolute; left: -3px; right: -3px; bottom: -4px; height: 2px; border-radius: 2px; background: var(--accent-blue); }
  .runtime-core { position: relative; overflow: hidden; padding: 14px 18px; border: 1px solid var(--border-strong); border-radius: 14px; background: var(--surface-card); }
  .runtime-core strong, .runtime-core small { position: relative; z-index: 1; display: block; }
  .runtime-core strong { color: var(--ink); font-family: var(--font-display); font-size: .95rem; }
  .runtime-core small { margin-top: 4px; color: var(--ink-subtle); }
  .core-orbit { position: absolute; width: 70px; height: 70px; right: -20px; top: -20px; border: 1px solid var(--accent-blue); border-radius: 50%; opacity: .18; }
  .core-orbit::after { content: ''; position: absolute; inset: 12px; border: 1px solid var(--accent-teal); border-radius: 50%; }
  .metric-mini-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .metric-mini-row span { padding: 7px 9px; border-radius: 8px; background: var(--surface-muted); color: var(--ink-muted); font-family: var(--font-mono); font-size: .67rem; font-weight: 700; }
  .visual-connector { position: relative; z-index: 1; display: grid; grid-template-columns: 68px 1fr; gap: 16px; height: 18px; }
  .visual-connector span { grid-column: 2; justify-self: center; width: 1px; height: 12px; background: var(--border-strong); }
  .visual-connector b { position: absolute; left: calc(68px + 50%); bottom: -6px; color: var(--accent-blue); font-size: .7rem; transform: translateX(-50%); }
  .product-stage { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 10px 6px 4px 84px; padding: 13px 15px; border-radius: 12px; color: #fff; background: linear-gradient(135deg, var(--accent-blue-dark), var(--accent-blue)); }
  .product-stage strong { font-size: .72rem; letter-spacing: .08em; }
  .product-stage span { font-size: .7rem; opacity: .85; }

  .mini-heading { max-width: 820px; }
  .mini-heading > span, .kicker { display: inline-block; margin-bottom: var(--space-3); color: var(--accent-blue); font-size: var(--text-xs); font-weight: 800; letter-spacing: .13em; }
  .mini-heading h2, .section-row-head h2, .proof-copy h2, .follow h2 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(2rem, 3.3vw, 3.3rem); line-height: 1.05; letter-spacing: -.04em; }
  .mini-heading h2 em { color: var(--accent-blue); font-style: normal; }

  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-10); }
  .why-card { position: relative; min-height: 210px; padding: var(--space-6); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-card); overflow: hidden; }
  .why-number { position: absolute; right: 18px; top: 14px; color: var(--border-subtle); font-family: var(--font-display); font-size: 3rem; font-weight: 800; }
  .why-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--surface-blue); }
  .why-icon span { width: 13px; height: 13px; border: 2px solid var(--accent-blue); border-radius: 50%; box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent-blue) 10%, transparent); }
  .why-card small { display: block; margin-top: var(--space-8); color: var(--ink-subtle); font-family: var(--font-mono); font-size: .64rem; font-weight: 800; letter-spacing: .1em; }
  .why-card strong { display: block; max-width: 240px; margin-top: 7px; color: var(--ink); font-family: var(--font-display); font-size: 1.15rem; line-height: 1.3; }

  .section-row-head { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: var(--space-10); }
  .section-row-head a, .proof-copy a { color: var(--accent-blue); text-decoration: none; font-size: var(--text-small); font-weight: 750; }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .pillar-card { position: relative; padding: 30px 28px 28px; border-right: 1px solid var(--border-subtle); }
  .pillar-card:last-child { border-right: 0; }
  .pillar-mark { color: var(--accent-blue); font-family: var(--font-mono); font-size: .68rem; font-weight: 800; }
  .pillar-line { width: 36px; height: 3px; margin: 16px 0 28px; border-radius: 4px; background: var(--accent-blue); }
  .pillar-card h3 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: 1.4rem; }
  .pillar-card p { margin: 7px 0 0; color: var(--ink-muted); font-size: .88rem; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-6); }
  .tag-row span { padding: 5px 8px; border-radius: 999px; background: var(--surface-muted); color: var(--ink-subtle); font-size: .66rem; font-weight: 650; }

  .lab { background: linear-gradient(180deg, transparent 0%, var(--surface-muted) 9%, var(--surface-muted) 91%, transparent 100%); }
  .lab-heading { margin-bottom: var(--space-10); }
  .lab-map { display: grid; grid-template-columns: 1fr 70px 1fr 70px 1fr; gap: 0; align-items: center; padding: 20px; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-card); }
  .map-column { min-width: 0; }
  .map-label { display: block; margin-bottom: 9px; color: var(--ink-subtle); font-family: var(--font-mono); font-size: .62rem; font-weight: 800; letter-spacing: .1em; }
  .map-node { display: flex; align-items: center; gap: 12px; min-height: 84px; padding: 16px; border: 1px solid var(--border-subtle); border-radius: 14px; background: var(--surface-muted); }
  .map-node strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: .92rem; }
  .map-node small { display: block; margin-top: 4px; color: var(--ink-subtle); font-size: .7rem; }
  .node-dot { flex: 0 0 auto; width: 15px; height: 15px; border-radius: 50%; background: var(--accent-blue); box-shadow: 0 0 0 7px var(--surface-blue); }
  .node-ring { flex: 0 0 auto; width: 17px; height: 17px; border: 3px solid var(--accent-teal); border-radius: 50%; box-shadow: 0 0 0 6px var(--surface-teal); }
  .node-square { flex: 0 0 auto; width: 17px; height: 17px; border: 3px solid var(--accent-violet); border-radius: 4px; }
  .map-flow { display: flex; align-items: center; justify-content: center; color: var(--accent-blue); }
  .map-flow span { width: 30px; height: 1px; background: var(--border-strong); }
  .map-flow b { margin-left: -2px; font-size: .8rem; }
  .project-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin-top: var(--space-5); }
  .project-card { position: relative; display: block; min-height: 205px; padding: 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-card); text-decoration: none; transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease; }
  .project-card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
  .project-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .project-top img { width: 38px; height: 38px; object-fit: contain; border-radius: 9px; }
  .project-top span { color: var(--ink-subtle); font-size: .63rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .project-card h3 { margin: 24px 0 5px; color: var(--ink); font-family: var(--font-display); font-size: 1rem; }
  .project-card p { margin: 0; color: var(--ink-muted); font-size: .78rem; line-height: 1.5; }
  .project-card > b { position: absolute; right: 18px; bottom: 16px; color: var(--accent-blue); }

  .proof-shell { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(40px, 7vw, 86px); align-items: center; }
  .proof-copy p { margin: var(--space-4) 0 var(--space-5); color: var(--ink-muted); font-size: var(--text-body-lg); }
  .proof-visual { display: grid; gap: 10px; }
