---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const localHref = (href: string) => href.startsWith('http') ? href : `${baseUrl}/${href.replace(/^\//, '')}`;

const stages = [
  {
    id: 'build', number: '01', verb: 'BUILD', title: 'Build the foundation.',
    description: 'Reusable local capabilities before product-specific glue.',
    transition: 'What gets built must be measured.',
    projects: [
      {
        name: 'Android Local LLM Harness',
        question: 'Can local inference become a reusable Android platform capability?',
        signal: 'Runtime · model lifecycle · Android gateway',
        siteHref: '/android-local-llm-harness',
        githubHref: 'https://github.com/daniele21/android-local-llm-harness',
        image: '/images/harness/harness-playground-current.webp',
        imageAlt: 'Android Local LLM Harness running a quantized Qwen model locally and showing runtime measurements.',
        kind: 'ON-DEVICE INFRASTRUCTURE', status: 'ACTIVE',
      },
      {
        name: 'Local LLM Server',
        question: 'What does a product-grade local AI control plane need?',
        signal: 'Lifecycle · resources · routing · observability',
        siteHref: '/local-llm-server',
        githubHref: 'https://github.com/daniele21/local-llm-server',
        image: '/images/local-llm-server/chat-studio.png',
        imageAlt: 'Local LLM Server Studio interface for running and inspecting local inference.',
        kind: 'LOCAL CONTROL PLANE',
      },
      {
        name: 'Local ASR Server',
        question: 'Can speech become another reusable local capability?',
        signal: 'MLX Whisper · local transcription · API boundary',
        githubHref: 'https://github.com/daniele21/local-asr-server',
        kind: 'LOCAL SPEECH',
      },
    ],
  },
  {
    id: 'measure', number: '02', verb: 'MEASURE', title: 'Replace claims with evidence.',
    description: 'Model names are not enough. Device, runtime, configuration and workload belong to the result.',
    transition: 'What survives measurement gets a real workload.',
    projects: [
      {
        name: 'AI Performance Lab',
        question: 'Is this model/runtime/config good enough for this workload on this device?',
        signal: 'Quality · TTFT · throughput · resources · comparability',
        githubHref: 'https://github.com/daniele21/performance-lab',
        kind: 'EVALUATION SYSTEM', status: 'BUILDING',
      },
      {
        name: 'Traffic Monitoring',
        question: 'Does a local-first claim match observed network behaviour?',
        signal: 'Network evidence · uncertainty · local observability',
        siteHref: '/traffic-monitoring',
        githubHref: 'https://github.com/daniele21/traffic-monitoring',
        image: '/images/traffic-monitoring/overview.png',
        imageAlt: 'Traffic Monitoring overview showing local network usage evidence on macOS.',
        kind: 'EVIDENCE & OBSERVABILITY',
      },
      {
        name: 'Traffic Monitoring Android',
        question: 'How trustworthy is the attribution behind a network measurement?',
        signal: 'Coverage · attribution · measurement health',
        githubHref: 'https://github.com/daniele21/traffic-monitoring-android',
        kind: 'ANDROID EVIDENCE',
      },
    ],
  },
  {
    id: 'apply', number: '03', verb: 'APPLY', title: 'Stress it with real product constraints.',
    description: 'Applications are proving grounds: privacy, UX and domain requirements expose what infrastructure still misses.',
    transition: 'What survives the workload becomes knowledge.',
    projects: [
      {
        name: 'RedactGuard',
        question: 'Can sensitive documents be minimized before they leave the device?',
        signal: 'Local LLM · PII · human review · data minimization',
        siteHref: '/redact-guard',
        githubHref: 'https://github.com/daniele21/redact-guard',
        image: '/images/redact-guard/redactguard-review.jpg',
        imageAlt: 'RedactGuard review interface showing locally detected sensitive information before redaction.',
        kind: 'PRIVACY WORKFLOW', status: 'PUBLIC REPO',
      },
      {
        name: 'RedactGuard Android',
        question: 'Can an Android app consume local AI without owning the runtime?',
        signal: 'Consumer SDK · Binder IPC · Harness host',
        githubHref: 'https://github.com/daniele21/redactguard-android',
        kind: 'HARNESS CONSUMER',
      },
      {
        name: 'ClosedRoom',
        question: 'Can meeting intelligence stay local end-to-end?',
        signal: 'Local ASR · local LLM · private meeting workflows',
        siteHref: '/closedroom',
        image: '/images/closedroom/home.jpg',
        imageAlt: 'ClosedRoom local-first meeting intelligence application.',
        kind: 'REFERENCE APPLICATION',
      },
    ],
  },
];

const currentQuestions = [
  ['ANDROID', 'Can multiple apps share one resident model without each owning the native runtime?', 'https://github.com/daniele21/android-local-llm-harness'],
  ['EVALUATION', 'What evidence is enough to replace one local model/runtime with another?', 'https://github.com/daniele21/performance-lab'],
  ['OBSERVABILITY', 'How much of a “local-first” claim can be supported by observed network evidence?', 'https://github.com/daniele21/traffic-monitoring'],
];

const publishingLinks = [
  ['Field Guide', 'Working map of the Local AI stack', '/local-ai', false],
  ['GitHub', 'Code, ADRs and engineering evidence', 'https://github.com/daniele21?tab=repositories', true],
  ['stAI tuned', 'Long-form research and explanations', 'https://staituned.com', true],
  ['LinkedIn', 'Findings, questions and work in progress', 'https://www.linkedin.com/in/daniele-moltisanti/', true],
];

const trackRecord = [
  ['Enterprise', 'AI technical leadership'], ['80+', 'articles published'], ['150+', 'AI projects reviewed'], ['Top Nova 111', 'recognition'],
];
---

<section class="home-hero" id="top" aria-labelledby="home-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="eyebrow"><span></span>DANIELE MOLTISANTI · LOCAL AI</div>
      <h1 id="home-title">Making Local AI<br /><em>product-ready.</em></h1>
      <p class="hero-lede">I build the infrastructure, measure it on real hardware, and test it in real products.</p>
      <p class="hero-thesis">Every project tests a part of the same thesis.</p>
      <div class="hero-actions">
        <a class="button primary" href="#approach">Follow the work <span>↓</span></a>
        <a class="button secondary" href="https://github.com/daniele21?tab=repositories" target="_blank" rel="noreferrer">Browse GitHub <span>↗</span></a>
      </div>
    </div>

    <div class="method-card" aria-label="Build, measure, apply and learn research loop">
      <div class="method-top"><span>HOW I WORK</span><small>one question · four stages</small></div>
      <div class="method-question">What does it take to make Local AI reliable enough for real products?</div>
      <div class="method-steps">
        <a href="#build" class="method-step build-step"><b>01</b><strong>BUILD</strong><span>Infrastructure</span><small>Harness · LLM Server</small></a>
        <span class="method-arrow">↓</span>
        <a href="#measure" class="method-step measure-step"><b>02</b><strong>MEASURE</strong><span>Evidence</span><small>Performance Lab · Traffic</small></a>
        <span class="method-arrow">↓</span>
        <a href="#apply" class="method-step apply-step"><b>03</b><strong>APPLY</strong><span>Products</span><small>RedactGuard · ClosedRoom</small></a>
        <span class="method-arrow">↓</span>
        <a href="#learn" class="method-step learn-step"><b>04</b><strong>LEARN</strong><span>Research</span><small>Field Guide · Writing</small></a>
      </div>
      <div class="method-loop"><span>↺</span> findings shape the next build</div>
    </div>
  </div>
</section>

<section class="approach" id="approach" aria-labelledby="approach-title">
  <div class="shell">
    <div class="section-heading centered"><span class="kicker">THE RESEARCH LOOP</span><h2 id="approach-title">One thesis. Four ways to test it.</h2></div>
    <div class="approach-track" aria-label="Research stages">
      <a href="#build"><b>01</b><strong>Build</strong><span>Reusable capabilities</span></a><i>→</i>
      <a href="#measure"><b>02</b><strong>Measure</strong><span>Real evidence</span></a><i>→</i>
      <a href="#apply"><b>03</b><strong>Apply</strong><span>Product constraints</span></a><i>→</i>
      <a href="#learn"><b>04</b><strong>Learn</strong><span>Publish findings</span></a><i class="loop-back">↺</i>
    </div>
  </div>
</section>

<div class="research-journey" id="work">
  {stages.map((stage, stageIndex) => (
    <div class="stage-wrap">
      <section class={`research-stage stage-${stage.id}`} id={stage.id} aria-labelledby={`${stage.id}-title`}>
        <div class="shell">
          <div class="stage-header">
            <div class="stage-identity"><span>{stage.number}</span><strong>{stage.verb}</strong></div>
            <div class="stage-copy"><h2 id={`${stage.id}-title`}>{stage.title}</h2><p>{stage.description}</p></div>
          </div>

          <div class="project-layout">
            {stage.projects.map((project, projectIndex) => (
              <article class:list={['project-card', projectIndex === 0 && 'project-featured', !project.image && 'project-text-only']}>
                {project.image ? (
                  <a class="project-image" href={localHref(project.siteHref || project.githubHref || '#')} target={project.siteHref ? undefined : '_blank'} rel={project.siteHref ? undefined : 'noreferrer'}>
                    <img src={localHref(project.image)} alt={project.imageAlt || ''} loading="lazy" /><span class="image-scrim"></span>
                  </a>
                ) : (
                  <div class={`text-visual text-visual-${stage.id}`} aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
                )}
                <div class="project-body">
                  <div class="project-meta"><span>{project.kind}</span>{project.status && <b>{project.status}</b>}</div>
                  <h3>{project.name}</h3>
                  <p class="project-question">{project.question}</p>
                  <p class="project-signal">{project.signal}</p>
                  <div class="project-links">
                    {project.siteHref && <a href={localHref(project.siteHref)}>Deep dive <span>→</span></a>}
                    {project.githubHref && <a href={project.githubHref} target="_blank" rel="noreferrer">GitHub <span>↗</span></a>}
                  </div>
                </div>
              </article>
            ))}
          </div>

          {stage.id === 'measure' && (
            <div class="observed-run" aria-label="Single observed Android Harness run">
              <div class="run-copy"><span class="kicker">ONE OBSERVED RUN</span><strong>Qwen3.5-2B · Q4_K_M · Android Harness</strong><small>A single retained observation, not a generalized benchmark.</small></div>
              <div class="run-metrics"><div><strong>1318</strong><span>ms TTFT</span></div><div><strong>9.50</strong><span>tok/s</span></div><div><strong>3451</strong><span>ms total</span></div></div>
              <a href={localHref('/android-local-llm-harness')}>See Harness →</a>
            </div>
          )}
        </div>
      </section>
      {stageIndex < stages.length - 1 && <div class="journey-transition" aria-hidden="true"><span>↓</span><strong>{stage.transition}</strong></div>}
    </div>
  ))}
  <div class="journey-transition final-transition" aria-hidden="true"><span>↓</span><strong>{stages[2].transition}</strong></div>
</div>

<section class="learn-section" id="learn" aria-labelledby="learn-title">
  <div class="shell learn-grid">
    <div class="learn-copy">
      <div class="stage-identity learn-identity"><span>04</span><strong>LEARN</strong></div>
      <h2 id="learn-title">Publish what survives.</h2>
      <p>Code, ADRs, measurements, limits and open questions stay attached to the work — so the conclusion can be inspected, not just repeated.</p>
      <a class="button secondary" href="https://github.com/daniele21?tab=repositories" target="_blank" rel="noreferrer">Evidence lives on GitHub ↗</a>
    </div>
    <div class="repo-proof" aria-label="What is published with the work">
      <div><span>01</span><strong>Code</strong><small>What actually runs</small></div>
      <div><span>02</span><strong>Architecture</strong><small>Decisions & ADRs</small></div>
      <div><span>03</span><strong>Evidence</strong><small>Runs & measurements</small></div>
      <div><span>04</span><strong>Limits</strong><small>What is not proven yet</small></div>
    </div>
  </div>
</section>

<section class="questions-section" id="findings" aria-labelledby="questions-title">
  <div class="shell">
    <div class="section-heading split-heading"><div><span class="kicker">CURRENT QUESTIONS</span><h2 id="questions-title">What I am trying to prove next.</h2></div><a href="https://github.com/daniele21?tab=repositories" target="_blank" rel="noreferrer">Follow the repos ↗</a></div>
    <div class="question-list">
      {currentQuestions.map((item, index) => (
        <a href={item[2]} target="_blank" rel="noreferrer" class="question-row"><span class="question-number">0{index + 1}</span><div><small>{item[0]}</small><strong>{item[1]}</strong></div><b>↗</b></a>
      ))}
    </div>
  </div>
</section>

<section class="publishing-section" id="writing" aria-labelledby="publishing-title">
  <div class="shell">
    <div class="section-heading split-heading"><div><span class="kicker">FROM WORK TO KNOWLEDGE</span><h2 id="publishing-title">The output is not only software.</h2></div><p>Experiments become reusable knowledge across code, research and writing.</p></div>
    <div class="publishing-grid">
      {publishingLinks.map((item) => (
        <a href={localHref(item[2] as string)} target={item[3] ? '_blank' : undefined} rel={item[3] ? 'noreferrer' : undefined}><span>{item[0]}</span><strong>{item[1]}</strong><b>{item[3] ? '↗' : '→'}</b></a>
      ))}
    </div>
  </div>
</section>

<section class="track-section" id="about" aria-labelledby="track-title">
  <div class="shell track-shell">
    <div><span class="kicker">TRACK RECORD</span><h2 id="track-title">Built on production AI experience.</h2></div>
    <div class="track-grid">{trackRecord.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div>
  </div>
</section>

<section class="advisory-section" id="advisory" aria-labelledby="advisory-title">
  <div class="shell advisory-card">
    <div><span class="kicker">ADVISORY</span><h2 id="advisory-title">Deciding what should run locally?</h2><p>I help teams evaluate local, cloud and hybrid AI architectures against the actual workload.</p></div>
    <a class="button primary" href="mailto:danielemoltisanti@gmail.com?subject=Local%20AI%20workload">Discuss a workload <span>→</span></a>
  </div>
</section>

<style>
  .home-hero{position:relative;overflow:clip;padding:clamp(58px,8vw,112px) 0 clamp(64px,9vw,120px)}
  .home-hero::before{content:'';position:absolute;width:640px;height:640px;right:-260px;top:-260px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.1),transparent 68%);pointer-events:none}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(380px,.82fr);gap:clamp(48px,8vw,112px);align-items:center}.hero-copy{max-width:760px}
  .eyebrow,.kicker{display:flex;align-items:center;gap:9px;color:var(--accent-blue);font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.eyebrow>span{width:7px;height:7px;border-radius:50%;background:var(--accent-teal);box-shadow:0 0 0 4px rgba(45,212,191,.1)}
  .home-hero h1{margin:16px 0 0;color:var(--ink);font-family:var(--font-display);font-size:clamp(3.25rem,6.4vw,6.6rem);line-height:.91;letter-spacing:-.065em}.home-hero h1 em{color:var(--accent-blue);font-style:normal}.hero-lede{max-width:650px;margin:26px 0 0;color:var(--ink-muted);font-size:clamp(1.08rem,1.5vw,1.28rem);line-height:1.58}.hero-thesis{margin:14px 0 0;color:var(--ink);font-size:.92rem;font-weight:720}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:11px 20px;border:1px solid var(--border-subtle);border-radius:var(--radius-full);text-decoration:none;font-size:var(--text-small);font-weight:760;transition:transform var(--duration-fast) ease,border-color var(--duration-fast) ease,box-shadow var(--duration-fast) ease}.button:hover{transform:translateY(-2px)}.button.primary{color:#fff;border-color:var(--accent-blue);background:var(--accent-blue);box-shadow:0 10px 28px rgba(37,99,235,.22)}.button.secondary{color:var(--ink);background:var(--surface-card)}.button.secondary:hover{border-color:var(--border-strong)}
  .method-card{position:relative;padding:20px;border:1px solid var(--border-subtle);border-radius:30px;background:linear-gradient(155deg,var(--surface-card),var(--surface-muted));box-shadow:var(--shadow-lg)}.method-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:16px;border-bottom:1px solid var(--border-subtle)}.method-top span{color:var(--ink);font-size:.72rem;font-weight:800;letter-spacing:.1em}.method-top small{color:var(--ink-subtle);font-size:.72rem}.method-question{margin:18px 0;color:var(--ink);font-family:var(--font-display);font-size:clamp(1.08rem,1.8vw,1.35rem);line-height:1.3}.method-steps{display:grid;gap:6px}.method-step{display:grid;grid-template-columns:36px 92px 1fr auto;align-items:center;gap:10px;min-height:58px;padding:10px 12px;border:1px solid transparent;border-radius:15px;text-decoration:none;color:var(--ink);background:var(--surface-card);transition:transform var(--duration-fast) ease,border-color var(--duration-fast) ease}.method-step:hover{transform:translateX(4px);border-color:var(--border-strong)}.method-step b{color:var(--ink-subtle);font-size:.72rem}.method-step strong{font-size:.78rem;letter-spacing:.07em}.method-step span{color:var(--ink-muted);font-size:.84rem}.method-step small{color:var(--ink-subtle);font-size:.7rem;text-align:right}.build-step strong{color:var(--accent-blue)}.measure-step strong{color:var(--accent-teal)}.apply-step strong{color:#7c5cff}.learn-step strong{color:var(--ink)}.method-arrow{justify-self:center;color:var(--ink-subtle);font-size:.8rem;line-height:1}.method-loop{display:flex;justify-content:flex-end;gap:7px;margin-top:12px;color:var(--ink-subtle);font-size:.7rem}.method-loop span{color:var(--accent-blue);font-size:1rem}
  .approach{padding:clamp(64px,8vw,96px) 0;border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);background:var(--surface-muted)}.section-heading h2,.stage-copy h2,.learn-copy h2,.track-shell h2,.advisory-card h2{margin:9px 0 0;color:var(--ink);font-family:var(--font-display);letter-spacing:-.035em}.section-heading h2{font-size:clamp(2rem,4vw,3.25rem)}.section-heading.centered{text-align:center}.section-heading.centered .kicker{justify-content:center}.approach-track{display:grid;grid-template-columns:repeat(7,auto);align-items:center;justify-content:center;gap:clamp(10px,2vw,22px);margin-top:36px}.approach-track a{display:grid;gap:3px;min-width:150px;text-decoration:none;color:var(--ink)}.approach-track a b{color:var(--ink-subtle);font-size:.68rem}.approach-track a strong{font-family:var(--font-display);font-size:1.1rem}.approach-track a span{color:var(--ink-muted);font-size:.78rem}.approach-track i{color:var(--ink-subtle);font-style:normal;font-size:1.05rem}.approach-track .loop-back{color:var(--accent-blue)}
  .research-stage{padding:clamp(72px,10vw,128px) 0}.stage-measure{background:linear-gradient(180deg,transparent,rgba(45,212,191,.035),transparent)}.stage-header{display:grid;grid-template-columns:155px minmax(0,1fr);gap:32px;align-items:start;margin-bottom:34px}.stage-identity{display:flex;align-items:center;gap:12px;padding-top:7px}.stage-identity span{color:var(--ink-subtle);font-size:.72rem;font-weight:800}.stage-identity strong{color:var(--accent-blue);font-size:.76rem;letter-spacing:.12em}.stage-measure .stage-identity strong{color:var(--accent-teal)}.stage-apply .stage-identity strong{color:#7c5cff}.stage-copy h2{font-size:clamp(2.35rem,4.5vw,4.2rem);line-height:1}.stage-copy p{max-width:700px;margin:12px 0 0;color:var(--ink-muted);font-size:1rem;line-height:1.6}
  .project-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.82fr);gap:16px}.project-card{overflow:hidden;border:1px solid var(--border-subtle);border-radius:24px;background:var(--surface-card);min-width:0}.project-card:not(.project-featured){display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}.project-card:nth-child(3){grid-column:2}.project-featured{grid-row:span 2}.project-text-only{min-height:215px}.project-image{position:relative;display:block;min-height:210px;overflow:hidden;background:#090d18}.project-featured .project-image{min-height:clamp(330px,38vw,510px)}.project-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.project-featured .project-image img{object-position:top center}.project-card:hover .project-image img{transform:scale(1.02)}.image-scrim{position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(4,8,20,.16));pointer-events:none}.text-visual{height:62px;margin:18px 18px 0;display:flex;align-items:flex-end;gap:7px;padding:12px;border-radius:14px;background:var(--surface-muted);overflow:hidden}.text-visual span{display:block;flex:1;border-radius:4px 4px 1px 1px;background:var(--accent-blue);opacity:.75}.text-visual span:nth-child(1){height:30%}.text-visual span:nth-child(2){height:65%}.text-visual span:nth-child(3){height:44%}.text-visual span:nth-child(4){height:84%}.text-visual span:nth-child(5){height:56%}.text-visual-measure span{background:var(--accent-teal)}.text-visual-apply span{background:#7c5cff}.project-body{padding:20px}.project-featured .project-body{padding:24px}.project-meta{display:flex;align-items:center;justify-content:space-between;gap:12px}.project-meta span{color:var(--accent-blue);font-size:.66rem;font-weight:800;letter-spacing:.1em}.stage-measure .project-meta span{color:var(--accent-teal)}.stage-apply .project-meta span{color:#7c5cff}.project-meta b{padding:4px 7px;border-radius:999px;background:var(--surface-muted);color:var(--ink-subtle);font-size:.58rem;letter-spacing:.06em}.project-body h3{margin:12px 0 0;color:var(--ink);font-family:var(--font-display);font-size:clamp(1.15rem,2vw,1.55rem)}.project-question{margin:8px 0 0;color:var(--ink);font-size:.92rem;font-weight:680;line-height:1.42}.project-signal{margin:10px 0 0;color:var(--ink-subtle);font-size:.74rem}.project-links{display:flex;flex-wrap:wrap;gap:14px;margin-top:18px}.project-links a{color:var(--ink-muted);text-decoration:none;font-size:.76rem;font-weight:720}.project-links a:hover{color:var(--accent-blue)}
