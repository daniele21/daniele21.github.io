---
/**
 * ProductSubHeader.astro
 * Shared secondary navigation for project deep-dives.
 * The global header owns site navigation; this bar owns project context and sections only.
 */
export interface SubHeaderLink {
  label: string;
  href: string;
}

export interface Props {
  title: string;
  badge?: string;
  logoPath?: string;
  links: SubHeaderLink[];
  cta?: {
    label: string;
    href: string;
  };
  /**
   * Migrated project pages use the canonical sticky SiteHeader above this bar.
   * Legacy routes with dedicated non-sticky headers can leave this false until migration.
   */
  underSiteHeader?: boolean;
}

const {
  title,
  badge,
  logoPath,
  links,
  cta,
  underSiteHeader = false,
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<div
  class={`product-subheader ${underSiteHeader ? 'under-site-header' : ''}`}
  data-product-subheader
>
  <div class="shell subheader-inner">
    <div class="subheader-brand">
      <a href="#top" class="subheader-title-link" aria-label={`${title}, back to project overview`}>
        {logoPath && (
          <img
            src={`${baseUrl}/${logoPath.replace(/^\//, '')}`}
            alt=""
            class="subheader-logo-img"
            width="20"
            height="20"
          />
        )}
        <span class="subheader-title">{title}</span>
      </a>
      {badge && <span class="subheader-badge">{badge}</span>}
    </div>

    <nav class="subheader-nav" aria-label={`${title} sections`}>
      <ul class="subheader-links">
        {links.map((link, index) => (
          <li>
            <a
              href={link.href}
              class={`subheader-link ${index === 0 ? 'is-active' : ''}`}
              data-sublink
              aria-current={index === 0 ? 'location' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {cta && (
      <a
        href={cta.href}
        class="subheader-cta"
        target={cta.href.startsWith('http') ? '_blank' : '_self'}
        rel={cta.href.startsWith('http') ? 'noreferrer' : undefined}
      >
        {cta.label}
      </a>
    )}
  </div>
</div>

<style>
  .product-subheader {
    position: sticky;
    top: 0;
    z-index: 40;
    min-height: 48px;
    background: color-mix(in srgb, var(--surface-card) 88%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(16px) saturate(1.35);
    -webkit-backdrop-filter: blur(16px) saturate(1.35);
  }

  .product-subheader.under-site-header {
    top: var(--header-height);
  }

  .subheader-inner {
    min-height: 48px;
    display: grid;
    grid-template-columns: minmax(150px, auto) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
  }

  .subheader-brand {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .subheader-title-link {
    min-height: var(--touch-target-min);
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .subheader-title-link:hover .subheader-title,
  .subheader-title-link:focus-visible .subheader-title {
    color: var(--accent-blue-dark);
  }

  .subheader-logo-img {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 5px;
  }

  .subheader-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    letter-spacing: -0.012em;
    transition: color var(--duration-fast) ease;
  }

  .subheader-badge {
    padding: 3px 7px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    color: var(--ink-subtle);
    font-size: var(--text-caption);
    font-weight: 650;
    line-height: 1.2;
    white-space: nowrap;
  }

  .subheader-nav {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: 18px;
  }

  .subheader-nav::-webkit-scrollbar { display: none; }

  .subheader-links {
    display: flex;
    align-items: stretch;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .subheader-link {
    position: relative;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    padding: 4px 12px;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .subheader-link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -1px;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) ease;
  }

  .subheader-link:hover,
  .subheader-link:focus-visible,
  .subheader-link.is-active {
    color: var(--accent-blue-dark);
  }

  .subheader-link.is-active {
    font-weight: 700;
  }

  .subheader-link.is-active::after {
    transform: scaleX(1);
  }

  .subheader-cta {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) ease,
                border-color var(--duration-fast) ease,
                background-color var(--duration-fast) ease;
  }

  .subheader-cta:hover,
  .subheader-cta:focus-visible {
    color: var(--accent-blue-dark);
    border-color: var(--accent-blue-light);
    background: var(--surface-blue-subtle);
  }

  @media (max-width: 900px) {
    .subheader-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 10px;
    }

    .subheader-badge {
      display: none;
    }

    .subheader-link {
      padding-inline: 10px;
    }
  }

  @media (max-width: 768px) {
    .product-subheader {
      min-height: 88px;
    }

    .subheader-inner {
      width: 100%;
      min-height: 88px;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 40px 48px;
      column-gap: 8px;
      row-gap: 0;
      padding-inline: 14px;
    }

    .subheader-brand {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .subheader-title-link {
      width: 100%;
      min-height: 40px;
    }

    .subheader-logo-img {
      width: 18px;
      height: 18px;
    }

    .subheader-cta {
      grid-column: 2;
      grid-row: 1;
      min-height: 36px;
      padding-inline: 10px;
    }

    .subheader-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      width: calc(100% + 28px);
      margin-inline: -14px;
      justify-content: flex-start;
      scroll-behavior: smooth;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
      border-top: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
    }

    .subheader-links {
      padding-inline: 18px;
    }

    .subheader-link {
      min-height: 48px;
      padding-inline: 11px;
    }
  }

  @media (max-width: 420px) {
    .subheader-cta {
      max-width: 96px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subheader-title,
    .subheader-link,
    .subheader-link::after,
    .subheader-cta { transition: none; }
    .subheader-nav { scroll-behavior: auto; }
  }
</style>

<script>
  function initProductSubHeader() {
    const root = document.querySelector<HTMLElement>('[data-product-subheader]');
    if (!root) return;

    const nav = root.querySelector<HTMLElement>('.subheader-nav');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-sublink]'));
    if (!links.length) return;

    const sectionLinks = links
      .map((link) => {
        const href = link.getAttribute('href') ?? '';
        if (!href.startsWith('#') || href === '#top') return null;
        const target = document.querySelector<HTMLElement>(href);
        return target ? { link, href, target } : null;
      })
      .filter((item): item is NonNullable<typeof item> => item !== null);

    const overviewLink = links.find((link) => link.getAttribute('href') === '#top');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobileNavigation = window.matchMedia('(max-width: 768px)');
    let currentActive = links.find((link) => link.classList.contains('is-active'));

    const keepActiveLinkVisible = (activeLink: HTMLAnchorElement | undefined) => {
      if (!activeLink || !nav) return;

      const navRect = nav.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const behavior = reduceMotion.matches ? 'auto' : 'smooth';

      if (mobileNavigation.matches) {
        const currentRelativeLeft = linkRect.left - navRect.left + nav.scrollLeft;
        const desired = currentRelativeLeft - (nav.clientWidth - linkRect.width) / 2;
        const maxScroll = Math.max(0, nav.scrollWidth - nav.clientWidth);
        const target = Math.min(maxScroll, Math.max(0, desired));
        if (Math.abs(nav.scrollLeft - target) > 2) nav.scrollTo({ left: target, behavior });
        return;
      }

      let delta = 0;
      if (linkRect.left < navRect.left) delta = linkRect.left - navRect.left;
      else if (linkRect.right > navRect.right) delta = linkRect.right - navRect.right;
      if (Math.abs(delta) > 1) nav.scrollBy({ left: delta, behavior });
    };

    const setActive = (activeLink: HTMLAnchorElement | undefined) => {
      if (activeLink === currentActive) {
        keepActiveLinkVisible(activeLink);
        return;
      }
      currentActive = activeLink;

      links.forEach((link) => {
        const active = link === activeLink;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      keepActiveLinkVisible(activeLink);
    };

    const updateFromScroll = () => {
      if (!sectionLinks.length) {
        setActive(overviewLink);
        return;
      }

      const marker = Math.max(root.getBoundingClientRect().bottom + 12, window.innerHeight * 0.28);
      let active = overviewLink;

      for (const item of sectionLinks) {
        if (item.target.getBoundingClientRect().top <= marker) active = item.link;
        else break;
      }

      setActive(active);
    };

    let frame = 0;
    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateFromScroll();
      });
    };

    links.forEach((link) => link.addEventListener('click', () => {
      setActive(link);
      window.requestAnimationFrame(() => keepActiveLinkVisible(link));
    }));
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    mobileNavigation.addEventListener('change', requestUpdate);
    updateFromScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductSubHeader, { once: true });
  } else {
    initProductSubHeader();
  }
</script>
