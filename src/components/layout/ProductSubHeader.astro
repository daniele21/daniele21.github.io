---
/**
 * ProductSubHeader.astro
 * Shared sticky navigation for project deep-dives.
 * Keeps one predictable phase model across desktop and mobile with scroll-spy state.
 */
export interface SubHeaderLink {
  label: string;
  href: string;
}

export interface Props {
  title: string;
  badge?: string;
  logoPath?: string;
  links: SubHeaderLink[];
  cta?: {
    label: string;
    href: string;
  };
}

const { title, badge, logoPath, links, cta } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<div class="product-subheader" data-product-subheader>
  <div class="shell subheader-inner">
    <div class="subheader-brand">
      <a href="#top" class="subheader-title-link">
        {logoPath && (
          <img
            src={`${baseUrl}/${logoPath.replace(/^\//, '')}`}
            alt=""
            class="subheader-logo-img"
            width="22"
            height="22"
          />
        )}
        <span class="subheader-title">{title}</span>
      </a>
      {badge && <span class="subheader-badge">{badge}</span>}
    </div>

    <nav class="subheader-nav" aria-label="Project page sections">
      <ul class="subheader-links">
        {links.map((link, index) => (
          <li>
            <a
              href={link.href}
              class={`subheader-link ${index === 0 ? 'is-active' : ''}`}
              data-sublink
              aria-current={index === 0 ? 'location' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {cta && (
      <a
        href={cta.href}
        class="subheader-cta"
        target={cta.href.startsWith('http') ? '_blank' : '_self'}
        rel={cta.href.startsWith('http') ? 'noreferrer' : undefined}
      >
        {cta.label}
      </a>
    )}
  </div>
</div>

<style>
  .product-subheader {
    position: sticky;
    top: 0;
    z-index: 40;
    min-height: 48px;
    background: var(--glass-bg);
    border-bottom: 1px solid var(--glass-border);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.8);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.8);
    transition: background-color var(--duration-base) ease, border-color var(--duration-base) ease;
  }

  .subheader-inner {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .subheader-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .subheader-title-link {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink);
  }

  .subheader-logo-img {
    width: 22px;
    height: 22px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--surface-inverse);
    border: 1px solid var(--border-medium);
    flex-shrink: 0;
  }

  .subheader-title {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .subheader-badge {
    padding: 4px 8px;
    border-radius: var(--radius-full);
    background: var(--surface-blue-subtle);
    color: var(--accent-blue-dark);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-caption);
    font-weight: 700;
    white-space: nowrap;
  }

  .subheader-nav {
    min-width: 0;
    display: flex;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: 18px;
  }

  .subheader-nav::-webkit-scrollbar { display: none; }

  .subheader-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .subheader-link {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
  }

  .subheader-link:hover {
    color: var(--accent-blue-dark);
    background: var(--surface-muted);
  }

  .subheader-link.is-active {
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    font-weight: 700;
  }

  .subheader-cta {
    min-height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .subheader-cta:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .subheader-inner {
      width: 100%;
      gap: 0;
    }

    .subheader-brand,
    .subheader-cta {
      display: none;
    }

    .subheader-nav {
      width: 100%;
      justify-content: flex-start;
      scroll-behavior: smooth;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 18px, #000 calc(100% - 18px), transparent 100%);
    }

    .subheader-links {
      padding-inline: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subheader-link,
    .subheader-cta { transition: none; }
    .subheader-nav { scroll-behavior: auto; }
  }
</style>

<script>
  function initProductSubHeader() {
    const root = document.querySelector<HTMLElement>('[data-product-subheader]');
    if (!root) return;

    const nav = root.querySelector<HTMLElement>('.subheader-nav');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-sublink]'));
    if (!links.length) return;

    const phaseLinks = links
      .map((link) => {
        const href = link.getAttribute('href') ?? '';
        if (!href.startsWith('#') || href === '#top') return null;
        const target = document.querySelector<HTMLElement>(href);
        return target ? { link, href, target } : null;
      })
      .filter((item): item is NonNullable<typeof item> => item !== null);

    const overviewLink = links.find((link) => link.getAttribute('href') === '#top');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobileNavigation = window.matchMedia('(max-width: 768px)');
    let currentActive = links.find((link) => link.classList.contains('is-active'));

    const keepActiveLinkVisible = (activeLink: HTMLAnchorElement | undefined) => {
      if (!activeLink || !nav) return;

      const navRect = nav.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const behavior = reduceMotion.matches ? 'auto' : 'smooth';

      if (mobileNavigation.matches) {
        const currentRelativeLeft = linkRect.left - navRect.left + nav.scrollLeft;
        const desired = currentRelativeLeft - (nav.clientWidth - linkRect.width) / 2;
        const maxScroll = Math.max(0, nav.scrollWidth - nav.clientWidth);
        const target = Math.min(maxScroll, Math.max(0, desired));
        if (Math.abs(nav.scrollLeft - target) > 2) nav.scrollTo({ left: target, behavior });
        return;
      }

      let delta = 0;
      if (linkRect.left < navRect.left) delta = linkRect.left - navRect.left;
      else if (linkRect.right > navRect.right) delta = linkRect.right - navRect.right;
      if (Math.abs(delta) > 1) nav.scrollBy({ left: delta, behavior });
    };

    const setActive = (activeLink: HTMLAnchorElement | undefined) => {
      if (activeLink === currentActive) {
        keepActiveLinkVisible(activeLink);
        return;
      }
      currentActive = activeLink;

      links.forEach((link) => {
        const active = link === activeLink;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      keepActiveLinkVisible(activeLink);
    };

    const updateFromScroll = () => {
      if (!phaseLinks.length) {
        setActive(overviewLink);
        return;
      }

      const marker = Math.max(root.getBoundingClientRect().bottom + 12, window.innerHeight * 0.28);
      let active = overviewLink;

      for (const item of phaseLinks) {
        if (item.target.getBoundingClientRect().top <= marker) active = item.link;
        else break;
      }

      setActive(active);
    };

    let frame = 0;
    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateFromScroll();
      });
    };

    links.forEach((link) => link.addEventListener('click', () => {
      setActive(link);
      window.requestAnimationFrame(() => keepActiveLinkVisible(link));
    }));
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    mobileNavigation.addEventListener('change', requestUpdate);
    updateFromScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductSubHeader, { once: true });
  } else {
    initProductSubHeader();
  }
</script>
