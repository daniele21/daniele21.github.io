---
/**
 * SiteFooter - Footer component with dynamic copyright year.
 */
import { socialLinks, getContent } from '../../content';

const { footer: ftr } = getContent().common;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="brand">
      <img src={`${import.meta.env.BASE_URL}images/sign_1.png`} alt={ftr.brandAltLight} class="brand-signature brand-signature-light" height="36" />
      <img src={`${import.meta.env.BASE_URL}images/sign_dark.png`} alt={ftr.brandAltDark} class="brand-signature brand-signature-dark" height="36" />
      <span class="brand-name">{ftr.brandName}</span>
    </div>
    <p>{ftr.copyrightTemplate.replace('{year}', currentYear.toString())}</p>
    <div class="footer-links" aria-label="Social and external links">
      <a href={socialLinks.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn profile" title="LinkedIn" class="footer-icon-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
      <a href={socialLinks.github} target="_blank" rel="noreferrer" aria-label="GitHub profile" title="GitHub" class="footer-icon-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href={socialLinks.staituned} target="_blank" rel="noreferrer">stAI tuned ↗</a>
    </div>
  </div>
</footer>


<style>
  .site-footer {
    padding: var(--space-8) 0 var(--space-10);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }




  .footer-inner p {
    margin: 0;
    text-align: center;
    color: var(--ink-muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .footer-links a {
    position: relative;
    text-decoration: none;
    color: var(--ink-muted);
    transition: color var(--duration-fast) ease;
    display: inline-flex;
    align-items: center;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-muted);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .footer-icon-link:hover {
    color: var(--accent-blue);
    transform: translateY(-1px);
  }

  .footer-icon-link::after {
    display: none !important;
  }

  .footer-links a:not(.footer-icon-link)::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .footer-links a:hover {
    color: var(--accent-blue);
  }

  .footer-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }

    .footer-links a {
      padding: 6px 10px;
    }
  }
</style>


