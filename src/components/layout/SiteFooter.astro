---
/**
 * SiteFooter - Footer component with dynamic copyright year.
 */
import { socialLinks } from '../../content/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="brand">
      <img src={`${import.meta.env.BASE_URL}images/sign_1.png`} alt="Daniele Moltisanti signature" class="brand-signature brand-signature-light" height="36" />
      <img src={`${import.meta.env.BASE_URL}images/sign_dark.png`} alt="Daniele Moltisanti signature" class="brand-signature brand-signature-dark" height="36" />
      <span class="brand-name">Daniele Moltisanti</span>
    </div>
    <p>© {currentYear} · Built with local-first principles as a lightweight Astro static site.</p>
    <div class="footer-links">
      <a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={socialLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={socialLinks.staituned} target="_blank" rel="noreferrer">stAI tuned</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-8) 0 var(--space-10);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }




  .footer-inner p {
    margin: 0;
    text-align: center;
    color: var(--ink-muted);
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
  }

  .footer-links a {
    position: relative;
    text-decoration: none;
    color: var(--ink-muted);
    transition: color var(--duration-fast) ease;
  }

  .footer-links a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .footer-links a:hover {
    color: var(--accent-blue);
  }

  .footer-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
</style>

