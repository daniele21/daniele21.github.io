---
/**
 * SiteFooter - Clean, compact footer component with dynamic copyright year.
 */
import { socialLinks, getContent } from '../../content';
import GitHubIcon from '../icons/GitHubIcon.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';

const { footer: ftr } = getContent().common;
const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-left">
      <a class="footer-brand" href={`${baseUrl}/#top`} aria-label={`${ftr.brandName}, back to top`}>
        <img
          src={`${baseUrl}/images/sign_1.png`}
          alt=""
          class="brand-signature brand-signature-light"
          width="32"
          height="22"
        />
        <img
          src={`${baseUrl}/images/sign_dark.png`}
          alt=""
          class="brand-signature brand-signature-dark"
          width="32"
          height="22"
        />
        <span class="brand-name">{ftr.brandName}</span>
      </a>
      <span class="footer-divider" aria-hidden="true">·</span>
      <span class="footer-copy">{ftr.copyrightTemplate.replace('{year}', currentYear.toString())}</span>
    </div>

    <div class="footer-links" aria-label="Footer and social links">
      <a href={`${baseUrl}/privacy/`} class="footer-text-link">Privacy & Terms</a>
      <a href={socialLinks.staituned} target="_blank" rel="noreferrer" class="footer-text-link">stAI tuned ↗</a>
      <div class="footer-socials">
        <a
          href={socialLinks.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
          class="footer-icon-link"
        >
          <LinkedInIcon size={16} />
        </a>
        <a
          href={socialLinks.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
          class="footer-icon-link"
        >
          <GitHubIcon size={16} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) 0 var(--space-8);
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-left {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-signature {
    display: block;
    width: 32px;
    height: 22px;
    object-fit: contain;
  }

  .brand-signature-dark { display: none; }
  :global(html[data-theme='dark']) .brand-signature-light { display: none; }
  :global(html[data-theme='dark']) .brand-signature-dark { display: block; }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-display);
    transition: color var(--duration-fast) ease;
  }

  .footer-brand:hover .brand-name,
  .footer-brand:focus-visible .brand-name {
    color: var(--accent-blue);
  }

  .footer-divider {
    color: var(--ink-subtle);
    opacity: 0.6;
  }

  .footer-copy {
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 20px);
  }

  .footer-text-link {
    position: relative;
    text-decoration: none;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 500;
    transition: color var(--duration-fast) ease;
  }

  .footer-text-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .footer-text-link:hover,
  .footer-text-link:focus-visible {
    color: var(--accent-blue);
  }

  .footer-text-link:hover::after,
  .footer-text-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    color: var(--ink-muted);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .footer-icon-link:hover,
  .footer-icon-link:focus-visible {
    color: var(--accent-blue);
    background: var(--surface-blue-subtle);
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .footer-left {
      justify-content: center;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
    }
  }
</style>


