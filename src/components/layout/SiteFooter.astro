---
/**
 * SiteFooter - Clean, compact footer component with dynamic copyright year.
 */
import { socialLinks, getContent } from '../../content';

const { footer: ftr } = getContent().common;
const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-left">
      <a class="footer-brand" href={`${baseUrl}/#top`} aria-label={`${ftr.brandName}, back to top`}>
        <img
          src={`${baseUrl}/images/sign_1.png`}
          alt=""
          class="brand-signature brand-signature-light"
          width="32"
          height="22"
        />
        <img
          src={`${baseUrl}/images/sign_dark.png`}
          alt=""
          class="brand-signature brand-signature-dark"
          width="32"
          height="22"
        />
        <span class="brand-name">{ftr.brandName}</span>
      </a>
      <span class="footer-divider" aria-hidden="true">·</span>
      <span class="footer-copy">{ftr.copyrightTemplate.replace('{year}', currentYear.toString())}</span>
    </div>

    <div class="footer-links" aria-label="Footer and social links">
      <a href={`${baseUrl}/privacy/`} class="footer-text-link">Privacy & Terms</a>
      <a href={socialLinks.staituned} target="_blank" rel="noreferrer" class="footer-text-link">stAI tuned ↗</a>
      <div class="footer-socials">
        <a
          href={socialLinks.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
          class="footer-icon-link"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a
          href={socialLinks.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
          class="footer-icon-link"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) 0 var(--space-8);
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-left {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-signature {
    display: block;
    width: 32px;
    height: 22px;
    object-fit: contain;
  }

  .brand-signature-dark { display: none; }
  :global(html[data-theme='dark']) .brand-signature-light { display: none; }
  :global(html[data-theme='dark']) .brand-signature-dark { display: block; }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-display);
    transition: color var(--duration-fast) ease;
  }

  .footer-brand:hover .brand-name,
  .footer-brand:focus-visible .brand-name {
    color: var(--accent-blue);
  }

  .footer-divider {
    color: var(--ink-subtle);
    opacity: 0.6;
  }

  .footer-copy {
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 20px);
  }

  .footer-text-link {
    position: relative;
    text-decoration: none;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    font-weight: 500;
    transition: color var(--duration-fast) ease;
  }

  .footer-text-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .footer-text-link:hover,
  .footer-text-link:focus-visible {
    color: var(--accent-blue);
  }

  .footer-text-link:hover::after,
  .footer-text-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    color: var(--ink-muted);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .footer-icon-link:hover,
  .footer-icon-link:focus-visible {
    color: var(--accent-blue);
    background: var(--surface-blue-subtle);
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .footer-left {
      justify-content: center;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
    }
  }
</style>


