---
/**
 * SiteFooter - Footer component.
 */
import { socialLinks } from '../../content/site';
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">DM</span>
      <span>Daniele Moltisanti</span>
    </div>
    <p>Built with local-first principles as a lightweight Astro static site.</p>
    <div class="footer-links">
      <a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={socialLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={socialLinks.staituned} target="_blank" rel="noreferrer">stAI tuned</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-8) 0 var(--space-10);
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    font-weight: 750;
  }

  .footer-brand .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--ink);
    border-radius: 9px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: -0.08em;
  }

  .footer-inner p {
    margin: 0;
    text-align: center;
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
  }

  .footer-links a {
    text-decoration: none;
    color: var(--ink-muted);
    transition: color 150ms ease;
  }

  .footer-links a:hover {
    color: var(--accent-blue);
  }

  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
</style>
