---
/**
 * SiteHeader - Sticky navigation bar.
 * Transparent at top, frosted on scroll via JS .is-scrolled class.
 */
import { navigation } from '../../content/site';
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label="Daniele Moltisanti, home">
      <img src={`${import.meta.env.BASE_URL}images/sign_1.png`} alt="Daniele Moltisanti signature" class="brand-signature" />
      <span class="brand-name">Daniele Moltisanti</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
      <span class="sr-only">Open navigation</span>
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="site-navigation" aria-label="Primary navigation" data-navigation>
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a class="nav-cta" href="#collaborate">Collaborate</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(250, 252, 255, 0.88);
    border-bottom: 1px solid rgba(203, 215, 239, 0.8);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.79rem;
    color: var(--ink);
  }

  .brand-signature {
    height: 36px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    display: inline-block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: var(--text-small);
    font-weight: 650;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--ink-muted);
    transition: color 150ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--accent-blue);
  }

  .nav-cta {
    padding: 9px 18px !important;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.8);
    color: var(--ink) !important;
    font-weight: 700 !important;
    transition: all 150ms ease !important;
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    background: var(--accent-blue) !important;
    color: #ffffff !important;
    border-color: var(--accent-blue) !important;
  }

  .menu-toggle { display: none; }

  @media (max-width: 820px) {
    .menu-toggle {
      display: grid;
      place-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.85);
      cursor: pointer;
    }

    .menu-toggle span:not(.sr-only) {
      width: 20px;
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition: transform 160ms ease, opacity 160ms ease;
    }

    .menu-toggle[aria-expanded="true"] span:nth-child(2) { transform: translateY(7px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:nth-child(3) { opacity: 0; }
    .menu-toggle[aria-expanded="true"] span:nth-child(4) { transform: translateY(-7px) rotate(-45deg); }

    .site-nav {
      position: fixed;
      left: 14px;
      right: 14px;
      top: 76px;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 14px;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.97);
      box-shadow: var(--shadow-lg);
    }

    .site-nav.is-open { display: flex; }
    .site-nav a { padding: 12px 14px; border-radius: var(--radius-sm); }
    .site-nav a:hover { background: var(--surface-muted); }
    .nav-cta { border: 0; color: #ffffff !important; background: var(--accent-blue) !important; text-align: center; }
  }
</style>
