---
/** Canonical site navigation built around the questions visitors need answered. */
import { navigation, getContent } from '../../content';
import NavIcon from '../icons/NavIcon.astro';

const { header: hdr } = getContent().common;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function getHref(href: string) {
  if (href.startsWith('#')) return `${baseUrl}/${href}`;
  if (href.startsWith('http')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
}
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={`${baseUrl}/#top`} aria-label={`${hdr.brandName}, home`}>
      <span class="brand-signature-wrap" aria-hidden="true">
        <img
          src={`${baseUrl}/images/sign_1.png`}
          alt=""
          class="brand-signature brand-signature-light"
          width="40"
          height="28"
        />
        <img
          src={`${baseUrl}/images/sign_dark.png`}
          alt=""
          class="brand-signature brand-signature-dark"
          width="40"
          height="28"
        />
      </span>
      <span class="brand-text">
        <span class="brand-name">{hdr.brandName}</span>
        {hdr.brandRole && <span class="brand-role">{hdr.brandRole}</span>}
      </span>
    </a>

    <nav class="site-nav" id="site-navigation" aria-label="Primary navigation" data-navigation>
      {navigation.map((item) => (
        <a href={getHref(item.href)} class="nav-link">
          {item.icon && (
            <span class="nav-link-icon" aria-hidden="true">
              <NavIcon name={item.icon} size={16} />
            </span>
          )}
          <span class="nav-link-text">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="header-cta-btn primary-button"
        data-open-contact-modal
        aria-label="Discuss an AI workload"
      >
        <span>Discuss a workload</span>
        <span aria-hidden="true">→</span>
      </button>

      <button class="theme-toggle" type="button" aria-label={hdr.themeToggleAriaLabel} data-theme-toggle>
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
        <span class="sr-only">{hdr.menuToggleAriaLabel}</span>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: color-mix(in srgb, var(--surface-card) 92%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(14px) saturate(1.25);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    transition: background-color var(--duration-base) var(--ease-in-out-smooth), border-color var(--duration-base) var(--ease-in-out-smooth), box-shadow var(--duration-base) var(--ease-in-out-smooth);
  }

  .site-header.is-scrolled {
    background: var(--glass-bg);
    border-bottom-color: var(--glass-border);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(12px, 1.7vw, 26px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: var(--touch-target-min);
    text-decoration: none;
    color: inherit;
  }

  .brand-signature-wrap {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-signature {
    display: block;
    width: 38px;
    height: 26px;
    object-fit: contain;
  }

  .brand-signature-dark { display: none; }
  :global(html[data-theme='dark']) .brand-signature-light { display: none; }
  :global(html[data-theme='dark']) .brand-signature-dark { display: block; }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.22;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 760;
    letter-spacing: -0.012em;
    color: var(--ink-display);
    white-space: nowrap;
  }

  .brand-role {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .site-nav {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(6px, 1vw, 14px);
    white-space: nowrap;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 6px 8px;
    min-height: var(--touch-target-min);
    color: var(--ink-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) ease;
  }

  .nav-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-subtle);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .nav-link-text {
    font-size: clamp(0.68rem, 0.72vw, 0.76rem);
    font-weight: 580;
    letter-spacing: -0.015em;
    line-height: 1.15;
    white-space: nowrap;
    text-align: center;
    transition: color var(--duration-fast) ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 2px;
    height: 2px;
    border-radius: 99px;
    background: var(--accent-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--ink-display);
  }

  .nav-link:hover .nav-link-icon,
  .nav-link:focus-visible .nav-link-icon {
    color: var(--accent-blue);
    transform: translateY(-1px);
  }

  .nav-link:hover .nav-link-text,
  .nav-link:focus-visible .nav-link-text {
    color: var(--ink-display);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .header-cta-btn {
    min-height: 36px;
    padding: 6px 13px;
    border-radius: var(--radius-full);
    font-size: var(--text-caption);
    font-weight: 670;
    white-space: nowrap;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--accent-blue-light);
    color: var(--accent-blue);
    background: var(--surface-blue-subtle);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sun-icon { display: block; }
  .moon-icon { display: none; }
  :global(html[data-theme='dark']) .sun-icon { display: none; }
  :global(html[data-theme='dark']) .moon-icon { display: block; }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    padding: 9px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    cursor: pointer;
  }

  .menu-toggle > span:not(.sr-only) {
    display: block;
    width: 100%;
    height: 2px;
    margin: 3px 0;
    border-radius: 99px;
    background: var(--ink);
  }

  @media (max-width: 1200px) {
    .brand-role { display: none; }
    .site-nav { gap: 6px; }
    .nav-link { padding: 4px 6px; }
    .nav-link-text { font-size: 0.67rem; }
  }

  @media (max-width: 980px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }

    .menu-toggle { display: block; }

    .site-nav {
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px max(20px, calc((100vw - var(--shell-max)) / 2));
      background: color-mix(in srgb, var(--surface-card) 98%, transparent);
      border-bottom: 1px solid var(--border-medium);
      box-shadow: var(--shadow-md);
      white-space: normal;
    }

    .site-nav.is-open { display: flex; }

    .nav-link {
      min-height: 48px;
      padding: 0 6px;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .nav-link-icon {
      color: var(--accent-blue);
    }

    .nav-link-text {
      font-size: 0.92rem;
      font-weight: 600;
      text-align: left;
    }

    .nav-link:last-child { border-bottom: 0; }
    .nav-link::after { display: none; }
  }

  @media (max-width: 620px) {
    .header-cta-btn { display: none; }
    .brand-signature { width: 34px; }
    .brand-name { font-size: 0.78rem; }
  }
</style>
