---
import { evidenceData } from '../../content';
import GitHubIcon from '../icons/GitHubIcon.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';

function getHref(href: string) {
  if (href.startsWith('http')) return href;
  return `${baseUrl}/${href.replace(/^\//, '')}`;
}
---

<section class="evidence-section" id="evidence">
  <div class="shell">
    <!-- Clean Minimal Header -->
    <div class="section-header">
      <div class="brand-eyebrow">
        <img
          src={`${baseUrl}/images/traffic-monitoring/shield.png`}
          alt="Traffic Monitoring shield"
          class="header-shield"
          width="24"
          height="24"
        />
        <span class="kicker">{evidenceData.kicker}</span>
      </div>
      <h2 class="title">{evidenceData.title}</h2>
      <p class="subtitle">
        Local network measurement and evidence quality - zero cloud telemetry, zero payload inspection.
      </p>
    </div>

    <!-- 3 Compact Principles Bar -->
    <div class="principles-bar">
      {evidenceData.principles.map((item, idx) => (
        <div class="principle-item">
          <span class="principle-num">0{idx + 1}</span>
          <div class="principle-text">
            <strong>{item.title}</strong>
            <span>{item.description}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Minimal Platform Switcher Component -->
    <div class="platform-container" data-platform-container>
      <!-- Sleek Platform Tabs -->
      <div class="platform-tabs" role="tablist" aria-label="Platform view selector">
        {evidenceData.platforms.map((platform, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${platform.id}`}
            id={`tab-${platform.id}`}
            class={`tab-btn ${idx === 0 ? 'is-active' : ''}`}
            data-platform-tab={platform.id}
          >
            <img
              src={`${baseUrl}/${platform.logoPath.replace(/^\//, '')}`}
              alt=""
              width="18"
              height="18"
              class="tab-logo"
            />
            <span class="tab-title">Traffic Monitoring for {platform.platform}</span>
          </button>
        ))}
      </div>

      <!-- Platform Panels -->
      <div class="platform-panels">
        {evidenceData.platforms.map((platform, idx) => (
          <div
            id={`panel-${platform.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${platform.id}`}
            class={`platform-panel ${idx === 0 ? 'is-active' : ''}`}
            data-platform-panel={platform.id}
          >
            <div class="panel-layout">
              <div class="panel-content">
                <div class="status-badge-wrapper">
                  <span class="status-badge">{platform.statusLabel}</span>
                </div>

                <h3 class="panel-headline">{platform.headline}</h3>
                <p class="panel-desc">{platform.description}</p>

                <!-- Micro Tags -->
                <div class="tags-row">
                  {platform.principles.map((p) => (
                    <span class="tag-pill">✓ {p}</span>
                  ))}
                </div>

                <!-- Progressive Disclosure: Technical details inside collapsible element -->
                <details class="tech-disclosure">
                  <summary class="disclosure-trigger">
                    <span>Technical capabilities & limitations</span>
                    <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="disclosure-content">
                    <ul class="cap-list">
                      {platform.currentCapabilities.map((cap) => (
                        <li>{cap}</li>
                      ))}
                    </ul>
                  </div>
                </details>

                <div class="panel-actions">
                  <a href={getHref(platform.pageUrl)} class="btn-primary">
                    Explore {platform.platform} Deep Dive →
                  </a>
                  <a
                    href={platform.repositoryUrl}
                    class="btn-secondary btn-icon-only"
                    target="_blank"
                    rel="noreferrer"
                    aria-label="GitHub repository"
                    title="GitHub"
                  >
                    <GitHubIcon size={16} />
                  </a>
                </div>
              </div>

              <div class="panel-preview">
                <a href={getHref(platform.pageUrl)} class="preview-link" title={`Open ${platform.name}`}>
                  <img
                    src={`${baseUrl}/${platform.heroImage.replace(/^\//, '')}`}
                    alt={`Preview of ${platform.name}`}
                    class="preview-img"
                    loading="lazy"
                    width="600"
                    height="380"
                  />
                  <span class="hover-badge">Explore Page →</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <p class="bottom-note">{evidenceData.bottomNote}</p>
  </div>
</section>

<script>
  function setupPlatformTabs() {
    const containers = document.querySelectorAll('[data-platform-container]');
    containers.forEach((container) => {
      const tabs = container.querySelectorAll<HTMLButtonElement>('[data-platform-tab]');
      const panels = container.querySelectorAll<HTMLElement>('[data-platform-panel]');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetId = tab.getAttribute('data-platform-tab');

          tabs.forEach((t) => {
            const isActive = t === tab;
            t.classList.toggle('is-active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          panels.forEach((panel) => {
            const isActive = panel.getAttribute('data-platform-panel') === targetId;
            panel.classList.toggle('is-active', isActive);
          });
        });
      });
    });
  }

  setupPlatformTabs();
  document.addEventListener('astro:page-load', setupPlatformTabs);
</script>

<style>
  .evidence-section {
    padding: var(--space-16) 0;
    background: var(--surface-subtle);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-8);
  }

  .brand-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .header-shield {
    object-fit: contain;
  }

  .kicker {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .title {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: var(--ink);
    margin-bottom: var(--space-3);
    line-height: 1.25;
  }

  .subtitle {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* Principles Bar - Horizontal & Compact */
  .principles-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .principle-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
  }

  .principle-num {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--accent-blue);
    line-height: 1.4;
  }

  .principle-text strong {
    display: block;
    font-size: var(--text-xs);
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .principle-text span {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  /* Platform Container */
  .platform-container {
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }

  .platform-tabs {
    display: flex;
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border-subtle);
    padding: 6px;
    gap: 6px;
  }

  .tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2.5);
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .tab-btn:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.03);
  }

  .tab-btn.is-active {
    color: var(--accent-blue);
    background: var(--surface-card);
    border-color: var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .tab-logo {
    object-fit: contain;
  }

  .platform-panels {
    padding: var(--space-6) var(--space-8);
  }

  .platform-panel {
    display: none;
  }

  .platform-panel.is-active {
    display: block;
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (max-width: 820px) {
    .panel-layout {
      grid-template-columns: 1fr;
    }
  }

  .status-badge-wrapper {
    margin-bottom: var(--space-3);
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 650;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink-muted);
  }

  .panel-headline {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .panel-desc {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .tag-pill {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-blue);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: rgba(32, 124, 206, 0.08);
    border: 1px solid rgba(32, 124, 206, 0.2);
  }

  /* Progressive Disclosure Collapsible */
  .tech-disclosure {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--surface-muted);
    overflow: hidden;
  }

  .disclosure-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
  }

  .disclosure-trigger:hover {
    color: var(--accent-blue);
  }

  .tech-disclosure[open] .chevron {
    transform: rotate(180deg);
  }

  .disclosure-content {
    padding: 10px 12px 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .cap-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cap-list li {
    font-size: 0.75rem;
    color: var(--ink-muted);
    line-height: 1.4;
    position: relative;
    padding-left: 14px;
  }

  .cap-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent-blue);
    font-weight: 800;
  }

  .panel-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-primary {
    padding: 8px 18px;
    border-radius: var(--radius-full);
    background: var(--accent-blue);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: #002996;
  }

  .btn-secondary {
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 650;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
    border-color: var(--accent-blue);
  }

  .btn-secondary.btn-icon-only {
    width: 32px;
    height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .panel-preview {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-muted);
  }

  .preview-link {
    display: block;
    text-decoration: none;
    position: relative;
  }

  .preview-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .preview-link:hover .preview-img {
    transform: scale(1.02);
  }

  .hover-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  .bottom-note {
    text-align: center;
    font-size: 0.75rem;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.5;
    font-style: italic;
  }
</style>
