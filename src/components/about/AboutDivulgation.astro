---
/**
 * AboutDivulgation.astro
 * Showcases stAI tuned publication, high-impact articles, and technical mentorship.
 */
import type { DivulgationHighlight } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  staiTunedSummary: string;
  staiTunedMetrics: { label: string; value: string }[];
  featuredArticles: DivulgationHighlight[];
  mentorshipSummary: string;
}

const {
  kicker,
  title,
  subtitle,
  staiTunedSummary,
  staiTunedMetrics,
  featuredArticles,
  mentorshipSummary,
} = Astro.props;
---

<section class="about-section divulgation-section" aria-labelledby="divulgation-title">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="divulgation-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <!-- Platform Showcase Box -->
  <div class="platform-showcase">
    <div class="showcase-narrative">
      <div class="showcase-badge-row">
        <span class="showcase-badge">FOUNDER & LEAD AUTHOR</span>
        <span class="showcase-distinction">Gold Impact Writer</span>
      </div>

      <h3 class="showcase-brand">stAI tuned</h3>
      <p class="showcase-desc">{staiTunedSummary}</p>
      <p class="showcase-mentor">{mentorshipSummary}</p>

      <div class="showcase-action">
        <a class="primary-button" href="https://staituned.com" target="_blank" rel="noopener noreferrer">
          Explore stAI tuned essays <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Key Metrics Display -->
    <div class="showcase-metrics-column">
      {staiTunedMetrics.map((m) => (
        <div class="metric-block">
          <span class="metric-figure">{m.value}</span>
          <span class="metric-caption">{m.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Featured Technical Deep Dives -->
  <div class="articles-grid">
    {featuredArticles.map((article) => (
      <article class="deep-dive-card">
        <div class="deep-dive-top">
          <span class="topic-pill">{article.topic}</span>
          <span class="read-duration">{article.readTime}</span>
        </div>

        <h4 class="article-headline">{article.title}</h4>
        <p class="article-abstract">{article.summary}</p>

        {article.keyInsight && (
          <div class="insight-box">
            <span class="insight-kicker">Core Takeaway:</span>
            <p class="insight-text">{article.keyInsight}</p>
          </div>
        )}

        <div class="article-footer">
          <a class="article-action-link" href={article.url} target="_blank" rel="noopener noreferrer">
            Read complete analysis <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .divulgation-section {
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: clamp(20px, 3vw, 28px);
  }

  .section-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  /* Platform Showcase Box */
  .platform-showcase {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.5vw, 28px);
    box-shadow: var(--shadow-sm);
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .showcase-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .showcase-badge {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-blue-dark);
  }

  .showcase-distinction {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 750;
    color: var(--accent-amber);
    background: var(--status-warn-bg);
    padding: 1px 6px;
    border-radius: 3px;
  }

  .showcase-brand {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--ink-display);
  }

  .showcase-desc {
    margin: 0 0 var(--space-2);
    font-size: var(--text-caption);
    color: var(--ink);
    line-height: 1.5;
  }

  .showcase-mentor {
    margin: 0 0 var(--space-3);
    font-size: 0.8125rem;
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .showcase-action a {
    padding: 8px 16px;
    font-size: var(--text-caption);
  }

  .showcase-metrics-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
  }

  .metric-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .metric-block:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .metric-figure {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 850;
    color: var(--accent-blue);
  }

  .metric-caption {
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--ink-display);
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .deep-dive-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-fast) ease;
  }

  .deep-dive-card:hover {
    border-color: var(--border-strong);
  }

  .deep-dive-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .topic-pill {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 750;
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .read-duration {
    font-size: 0.75rem;
    color: var(--ink-subtle);
  }

  .article-headline {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.3;
  }

  .article-abstract {
    margin: 0 0 var(--space-2);
    font-size: 0.8125rem;
    color: var(--ink-muted);
    line-height: 1.45;
    flex-grow: 1;
  }

  .insight-box {
    background: var(--surface-subtle);
    border-left: 2px solid var(--accent-blue);
    padding: 4px 8px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: var(--space-2);
  }

  .insight-kicker {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--accent-blue-dark);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1px;
  }

  .insight-text {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }

  .article-footer {
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .article-action-link {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--accent-blue);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .article-action-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .platform-showcase {
      grid-template-columns: 1fr;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
