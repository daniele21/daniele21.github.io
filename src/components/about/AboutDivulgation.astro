---
/**
 * AboutDivulgation.astro
 * Premium showcase with progressive disclosure on articles.
 * Shows title + topic upfront. Abstract + insight behind toggle.
 * stAI tuned showcase kept compact.
 */
import type { DivulgationHighlight } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  staiTunedSummary: string;
  staiTunedMetrics: { label: string; value: string }[];
  featuredArticles: DivulgationHighlight[];
  mentorshipSummary: string;
}

const {
  kicker, title, subtitle, staiTunedSummary, staiTunedMetrics,
  featuredArticles, mentorshipSummary,
} = Astro.props;
---

<section class="about-section divulgation-section" id="writing" aria-labelledby="divulgation-title" data-reveal="fade-up">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="divulgation-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <!-- Compact Dark Platform Showcase -->
  <div class="platform-showcase" data-reveal="fade-up">
    <div class="showcase-ambient" aria-hidden="true">
      <div class="showcase-orb showcase-orb--blue"></div>
    </div>

    <div class="showcase-content">
      <div class="showcase-narrative">
        <div class="showcase-badge-row">
          <span class="showcase-badge">FOUNDER & LEAD AUTHOR</span>
          <span class="showcase-distinction">⭐ Gold Impact Writer</span>
        </div>
        <h3 class="showcase-brand">stAI tuned</h3>
        <p class="showcase-desc">{staiTunedSummary}</p>
      </div>

      <div class="showcase-metrics-column">
        {staiTunedMetrics.map((m) => (
          <div class="metric-block">
            <span class="metric-figure">{m.value}</span>
            <span class="metric-caption">{m.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Articles: title + topic visible, abstract + insight behind toggle -->
  <div class="articles-grid" data-reveal-stagger="120">
    {featuredArticles.map((article) => (
      <article class="deep-dive-card" data-reveal="fade-up">
        <div class="deep-dive-top">
          <span class="topic-pill">{article.topic}</span>
          <span class="read-duration">{article.readTime}</span>
        </div>

        <h4 class="article-headline">{article.title}</h4>

        <details class="article-details">
          <summary class="article-toggle">
            <span class="toggle-label">Read more</span>
            <span class="toggle-icon" aria-hidden="true"></span>
          </summary>
          <div class="article-expanded">
            <p class="article-abstract">{article.summary}</p>
            {article.keyInsight && (
              <div class="insight-box">
                <span class="insight-kicker">Core Takeaway:</span>
                <p class="insight-text">{article.keyInsight}</p>
              </div>
            )}
          </div>
        </details>

        <div class="article-footer">
          <a class="article-action-link" href={article.url} target="_blank" rel="noopener noreferrer">
            Read full analysis <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .divulgation-section { margin-bottom: clamp(40px, 5vw, 56px); }
  .section-header { max-width: 760px; margin-bottom: clamp(24px, 3vw, 36px); }
  .section-title { margin: 0 0 6px; font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; color: var(--ink-display); letter-spacing: -0.025em; }
  .section-subtitle { margin: 0; font-size: var(--text-caption); color: var(--ink-muted); line-height: 1.5; }

  /* ── Dark Showcase (compact) ── */
  .platform-showcase {
    background: var(--surface-inverse); border-radius: var(--radius-xl);
    padding: clamp(20px, 3vw, 32px); margin-bottom: var(--space-5);
    position: relative; overflow: hidden;
    box-shadow: 0 8px 28px rgba(8, 19, 51, 0.12);
  }

  .platform-showcase::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-teal) 50%, var(--accent-violet) 100%);
  }

  .showcase-ambient { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .showcase-orb--blue { position: absolute; width: 250px; height: 250px; top: -60px; right: -40px; background: var(--accent-blue); border-radius: 50%; filter: blur(60px); opacity: 0.12; }

  .showcase-content { display: grid; grid-template-columns: 1.6fr 1fr; gap: var(--space-5); align-items: center; position: relative; z-index: 1; }
  .showcase-badge-row { display: flex; align-items: center; gap: var(--space-2); margin-bottom: 6px; flex-wrap: wrap; }
  .showcase-badge { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 800; letter-spacing: 0.06em; color: var(--accent-teal); }
  .showcase-distinction { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 750; color: #fbbf24; background: rgba(251, 191, 36, 0.12); padding: 2px 8px; border-radius: 4px; }
  .showcase-brand { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-h3); font-weight: 850; color: #ffffff; }
  .showcase-desc { margin: 0 0 var(--space-3); font-size: var(--text-caption); color: rgba(255, 255, 255, 0.75); line-height: 1.6; }

  .showcase-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 20px; min-height: var(--touch-target-min);
    background: var(--accent-blue); color: #ffffff;
    font-family: var(--font-display); font-size: var(--text-caption); font-weight: 700;
    text-decoration: none; border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(20, 91, 255, 0.3);
    transition: all var(--duration-fast) ease;
  }

  .showcase-btn:hover { background: var(--accent-blue-hover); transform: translateY(-2px); }

  .showcase-metrics-column { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-md); }
  .metric-block { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  .metric-block:last-child { border-bottom: none; }
  .metric-figure { font-family: var(--font-display); font-size: clamp(1.3rem, 2vw, 1.6rem); font-weight: 850; color: #ffffff; }
  .metric-caption { font-size: var(--text-caption); font-weight: 700; color: rgba(255, 255, 255, 0.7); }

  /* ── Articles Grid ── */
  .articles-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }

  .deep-dive-card {
    background: var(--surface-card); border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg); padding: var(--space-4);
    box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column;
    transition: all var(--duration-base) var(--ease-out-expo);
  }

  .deep-dive-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); transform: translateY(-4px); }

  .deep-dive-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .topic-pill { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 750; color: var(--accent-blue-dark); background: var(--surface-blue-subtle); padding: 2px 7px; border-radius: 4px; }
  .read-duration { font-size: var(--text-caption); color: var(--ink-subtle); }
  .article-headline { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: 0.9375rem; font-weight: 800; color: var(--ink-display); line-height: 1.35; flex-grow: 1; }

  /* ── Progressive Disclosure ── */
  .article-details { margin-bottom: var(--space-3); }

  .article-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: var(--font-display); font-size: var(--text-caption); font-weight: 700;
    color: var(--accent-blue); padding: 4px 0;
    list-style: none; user-select: none;
  }

  .article-toggle::-webkit-details-marker { display: none; }
  .article-toggle:hover { color: var(--accent-blue-hover); }

  .toggle-icon::after { content: '▸'; display: inline-block; transition: transform var(--duration-fast) ease; }
  details[open] .toggle-icon::after { transform: rotate(90deg); }
  details[open] .toggle-label { display: none; }
  details[open] .toggle-icon::before { content: 'Collapse'; font-family: var(--font-display); }

  .article-expanded {
    padding-top: var(--space-3);
    display: flex; flex-direction: column; gap: var(--space-3);
    animation: expand-in var(--duration-base) var(--ease-out-expo);
  }

  @keyframes expand-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .article-abstract { margin: 0; font-size: var(--text-caption); color: var(--ink-muted); line-height: 1.5; }
  .insight-box { background: var(--surface-subtle); border-left: 2px solid var(--accent-blue); padding: var(--space-2) var(--space-3); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .insight-kicker { display: block; font-family: var(--font-display); font-size: var(--text-caption); font-weight: 800; color: var(--accent-blue-dark); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px; }
  .insight-text { margin: 0; font-size: var(--text-caption); font-weight: 600; color: var(--ink); line-height: 1.4; }

  .article-footer { padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); margin-top: auto; }
  .article-action-link { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 750; color: var(--accent-blue); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
  .article-action-link:hover { text-decoration: underline; color: var(--accent-blue-hover); }

  @media (max-width: 860px) {
    .showcase-content { grid-template-columns: 1fr; }
    .articles-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) { .article-expanded { animation: none; } }
</style>
