---
/**
 * AboutRecognition.astro
 * Honors, industry recognition, and academic foundations.
 * Enhanced with larger card layout, accent borders, and reveal animations.
 */
import type { RecognitionItem, EducationItem } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  awards: RecognitionItem[];
  education: EducationItem[];
}

const { kicker, title, subtitle, awards, education } = Astro.props;
---

<section class="about-section recognition-section" id="recognition" aria-labelledby="recognition-title" data-reveal="fade-up">
  <!-- Subtle background band -->
  <div class="recognition-canvas">
    <div class="section-header">
      <p class="stage-kicker">{kicker}</p>
      <h2 id="recognition-title" class="section-title">{title}</h2>
      <p class="section-subtitle">{subtitle}</p>
    </div>

    <div class="recognition-grid" data-reveal-stagger="120">
      <!-- Awards Column -->
      <div class="column-block" data-reveal="fade-up">
        <h3 class="block-heading">
          <span class="heading-icon" aria-hidden="true">🏆</span>
          Honors & Awards
        </h3>
        <div class="cards-list">
          {awards.map((award) => (
            <article class="rec-card rec-card--award">
              <div class="rec-top">
                <span class="rec-year">{award.year}</span>
                <span class="rec-badge rec-badge--gold">{award.badge}</span>
              </div>
              <h4 class="rec-title">{award.title}</h4>
              <p class="rec-org">{award.organization}</p>
              <p class="rec-desc">{award.description}</p>
              {award.url && (
                <div class="rec-link-wrap">
                  <a class="rec-link" href={award.url} target="_blank" rel="noopener noreferrer">
                    Learn more <span aria-hidden="true">↗</span>
                  </a>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>

      <!-- Education Column -->
      <div class="column-block" data-reveal="fade-up">
        <h3 class="block-heading">
          <span class="heading-icon" aria-hidden="true">🎓</span>
          Academic Engineering Foundations
        </h3>
        <div class="cards-list">
          {education.map((edu) => (
            <article class="rec-card rec-card--edu">
              <div class="rec-top">
                <span class="rec-year">{edu.period}</span>
                {edu.badge && <span class="rec-badge">{edu.badge}</span>}
              </div>
              <h4 class="rec-title">{edu.degree}</h4>
              <p class="rec-org">{edu.institution} · {edu.location}</p>
              <p class="rec-desc">{edu.details}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .recognition-section {
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  /* Subtle background band */
  .recognition-canvas {
    background: var(--surface-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 3vw, 36px);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .section-title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .recognition-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .column-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .block-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    font-weight: 800;
    color: var(--ink-display);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .heading-icon {
    font-size: 1.2rem;
  }

  .cards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rec-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: all var(--duration-base) var(--ease-out-expo);
  }

  .rec-card--award {
    border-left: 3px solid var(--accent-amber);
  }

  .rec-card--edu {
    border-left: 3px solid var(--accent-indigo);
  }

  .rec-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .rec-card--award:hover {
    border-left-color: var(--accent-amber);
  }

  .rec-card--edu:hover {
    border-left-color: var(--accent-indigo);
  }

  .rec-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .rec-year {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--ink-subtle);
  }

  .rec-badge {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .rec-badge--gold {
    color: var(--accent-amber);
    background: var(--status-warn-bg);
    border: 1px solid rgba(217, 119, 6, 0.15);
  }

  .rec-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.35;
  }

  .rec-org {
    margin: 0 0 var(--space-2);
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--accent-blue);
  }

  .rec-desc {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
    flex-grow: 1;
  }

  .rec-link-wrap {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .rec-link {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--accent-blue);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--duration-fast) ease;
  }

  .rec-link:hover {
    text-decoration: underline;
    color: var(--accent-blue-hover);
  }

  @media (max-width: 720px) {
    .recognition-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
