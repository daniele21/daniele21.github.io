---
/**
 * AboutHero.astro
 * Compact magazine-grade editorial hero for the /about page.
 * Refined dimensions, elegant portrait aura, crisp typography, and compact stats ribbon.
 */
import type { AboutProfile } from '../../types/about';

interface Props {
  profile: AboutProfile;
}

const { profile } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<header class="about-hero" aria-label="Author Profile & Background">
  <div class="hero-editorial-card">
    <div class="hero-editorial-grid">
      <!-- Left: Compact Portrait with Ambient Aura -->
      <div class="portrait-column">
        <div class="portrait-frame">
          <div class="portrait-aura" aria-hidden="true"></div>
          <img
            src={asset(profile.portraitPath)}
            alt={profile.portraitAlt}
            width="104"
            height="104"
            loading="eager"
            class="portrait-img"
          />
        </div>
        <div class="status-indicator">
          <span class="pulse-beacon" aria-hidden="true"></span>
          <span class="status-text">{profile.location}</span>
        </div>
      </div>

      <!-- Right: Narrative & Editorial Intro -->
      <div class="editorial-column">
        <div class="meta-badge-row">
          <span class="stage-kicker">EXECUTIVE PROFILE</span>
          <span class="role-pill">{profile.affiliation}</span>
          <span class="role-pill role-pill-subtle">{profile.affiliationRole}</span>
        </div>

        <h1 class="author-name">{profile.name}</h1>
        <p class="author-headline">{profile.headline}</p>
        <p class="author-subheadline">{profile.subheadline}</p>

        <p class="editorial-lead">{profile.leadParagraph}</p>

        <!-- Focus Badges -->
        <div class="badges-row" aria-label="Core focus areas">
          {profile.badges.map((badge) => (
            <span class="focus-badge">{badge}</span>
          ))}
        </div>

        <!-- Action Links -->
        <div class="hero-actions">
          <a
            class="primary-button"
            href={profile.socialLinks.email ? `mailto:${profile.socialLinks.email}?subject=AI%20Architecture%20conversation` : '#contact'}
          >
            Discuss an AI architecture →
          </a>
          <a
            class="secondary-button"
            href={profile.socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a
            class="secondary-button"
            href={profile.socialLinks.staituned}
            target="_blank"
            rel="noopener noreferrer"
          >
            stAI tuned <span aria-hidden="true">↗</span>
          </a>
          <a
            class="secondary-button"
            href={profile.socialLinks.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Verified Stats Strip -->
    <div class="stats-ribbon" aria-label="Key accomplishments">
      {profile.stats.map((stat) => (
        <div class="stat-cell">
          <div class="stat-header">
            <span class="stat-tag">{stat.tag}</span>
            <span class="stat-metric">{stat.metric}</span>
          </div>
          <span class="stat-label">{stat.label}</span>
          <p class="stat-detail">{stat.detail}</p>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  .about-hero {
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .hero-editorial-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 32px);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .hero-editorial-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-teal) 50%, var(--accent-indigo) 100%);
  }

  .hero-editorial-grid {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: clamp(20px, 3vw, 32px);
    align-items: flex-start;
    margin-bottom: clamp(20px, 3vw, 28px);
  }

  .portrait-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .portrait-frame {
    position: relative;
    width: 104px;
    height: 104px;
  }

  .portrait-aura {
    position: absolute;
    inset: -6px;
    border-radius: var(--radius-full);
    background: radial-gradient(circle, rgba(20, 91, 255, 0.2) 0%, rgba(13, 148, 136, 0.1) 60%, transparent 80%);
    filter: blur(8px);
    z-index: 0;
  }

  .portrait-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--border-strong);
    box-shadow: 0 4px 16px rgba(8, 19, 51, 0.08);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
  }

  .pulse-beacon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-teal);
    box-shadow: 0 0 5px var(--accent-teal);
  }

  .status-text {
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--ink);
  }

  .editorial-column {
    display: flex;
    flex-direction: column;
  }

  .meta-badge-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .stage-kicker {
    margin: 0;
  }

  .role-pill {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 750;
    color: var(--accent-blue);
    background: var(--surface-blue-subtle);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
  }

  .role-pill-subtle {
    color: var(--ink-muted);
    background: var(--surface-subtle);
    border-color: var(--border-subtle);
  }

  .author-name {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 2.8vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--ink-display);
    line-height: 1.15;
  }

  .author-headline {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 750;
    color: var(--accent-blue);
  }

  .author-subheadline {
    margin: 0 0 var(--space-3);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .editorial-lead {
    margin: 0 0 var(--space-3);
    font-size: var(--text-body-sm);
    line-height: 1.6;
    color: var(--ink);
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-4);
  }

  .focus-badge {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
    color: var(--ink-display);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-actions a {
    padding: 8px 16px;
    font-size: var(--text-caption);
  }

  /* Stats Ribbon */
  .stats-ribbon {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .stat-cell {
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-fast) ease;
  }

  .stat-cell:hover {
    border-color: var(--border-strong);
  }

  .stat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
  }

  .stat-tag {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .stat-metric {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 850;
    color: var(--accent-blue);
  }

  .stat-label {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--ink-display);
    margin-bottom: 2px;
  }

  .stat-detail {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  @media (max-width: 840px) {
    .stats-ribbon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .hero-editorial-grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }

    .meta-badge-row,
    .badges-row,
    .hero-actions {
      justify-content: center;
    }

    .hero-actions a {
      width: 100%;
    }

    .stats-ribbon {
      grid-template-columns: 1fr;
    }
  }
</style>
