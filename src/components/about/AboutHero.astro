---
/**
 * AboutHero.astro
 * Dramatic dark-background editorial hero for the /about page.
 * Full-width dark canvas with large portrait, animated gradient ring,
 * bold typography, and prominent stats with count-up animation.
 */
import type { AboutProfile } from '../../types/about';

interface Props {
  profile: AboutProfile;
}

const { profile } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${baseUrl}/${path.replace(/^\//, '')}`;
---

<header class="about-hero" aria-label="Author Profile & Background" data-reveal="fade-in">
  <!-- Full-width dark canvas -->
  <div class="hero-canvas">
    <!-- Ambient background gradients -->
    <div class="hero-ambient" aria-hidden="true">
      <div class="ambient-orb ambient-orb--blue"></div>
      <div class="ambient-orb ambient-orb--teal"></div>
    </div>

    <div class="hero-inner">
      <!-- Portrait with animated gradient ring -->
      <div class="portrait-block" data-reveal="scale-in">
        <div class="portrait-ring" aria-hidden="true"></div>
        <img
          src={asset(profile.portraitPath)}
          alt={profile.portraitAlt}
          width="160"
          height="160"
          loading="eager"
          class="portrait-img"
        />
        <div class="status-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span class="status-text">{profile.location}</span>
        </div>
      </div>

      <!-- Editorial narrative -->
      <div class="narrative-block" data-reveal="fade-up">
        <div class="meta-row">
          <span class="hero-kicker">EXECUTIVE PROFILE</span>
          <span class="affiliation-pill">{profile.affiliation}</span>
          <span class="role-pill">{profile.affiliationRole}</span>
        </div>

        <h1 class="author-name">{profile.name}</h1>
        <p class="author-headline">{profile.headline}</p>
        <p class="author-subheadline">{profile.subheadline}</p>

        <p class="editorial-lead">{profile.leadParagraph}</p>

        <!-- Focus badges -->
        <div class="badges-row" aria-label="Core focus areas">
          {profile.badges.map((badge) => (
            <span class="focus-badge">{badge}</span>
          ))}
        </div>

        <!-- Action links -->
        <div class="hero-actions">
          <a
            class="hero-primary-btn"
            href={profile.socialLinks.email ? `mailto:${profile.socialLinks.email}?subject=AI%20Architecture%20conversation` : '#contact'}
          >
            Discuss an AI architecture →
          </a>
          <a
            class="hero-secondary-btn"
            href={profile.socialLinks.staituned}
            target="_blank"
            rel="noopener noreferrer"
          >
            stAI tuned <span aria-hidden="true">↗</span>
          </a>
          <div class="hero-social-group" aria-label="Social profiles">
            <a
              class="hero-social-icon-btn"
              href={profile.socialLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profile"
              title="LinkedIn"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a
              class="hero-social-icon-btn"
              href={profile.socialLinks.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub profile"
              title="GitHub"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats ribbon - prominent numbers -->
    <div class="stats-ribbon" data-reveal="fade-up" data-reveal-stagger="120">
      {profile.stats.map((stat) => (
        <div class="stat-cell" data-reveal="fade-up">
          <span class="stat-tag">{stat.tag}</span>
          <span class="stat-metric">{stat.metric}</span>
          <span class="stat-label">{stat.label}</span>
          <p class="stat-detail">{stat.detail}</p>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  /* ── Dark Canvas ── */
  .about-hero {
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .hero-canvas {
    background: var(--surface-inverse);
    border-radius: var(--radius-xl);
    padding: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px);
    position: relative;
    overflow: hidden;
    box-shadow:
      0 8px 32px rgba(8, 19, 51, 0.12),
      0 0 0 1px rgba(20, 91, 255, 0.08);
  }

  /* Accent gradient top line */
  .hero-canvas::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-teal) 40%, var(--accent-violet) 80%, var(--accent-indigo) 100%);
  }

  /* ── Ambient background orbs ── */
  .hero-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
  }

  .ambient-orb--blue {
    width: 400px;
    height: 400px;
    top: -120px;
    right: -80px;
    background: var(--accent-blue);
    animation: orb-float 8s ease-in-out infinite alternate;
  }

  .ambient-orb--teal {
    width: 300px;
    height: 300px;
    bottom: -100px;
    left: -60px;
    background: var(--accent-teal);
    animation: orb-float 10s ease-in-out infinite alternate-reverse;
  }

  @keyframes orb-float {
    0% { transform: translate(0, 0); }
    100% { transform: translate(20px, -15px); }
  }

  /* ── Inner layout ── */
  .hero-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(28px, 4vw, 48px);
    align-items: flex-start;
    position: relative;
    z-index: 1;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  /* ── Portrait ── */
  .portrait-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .portrait-ring {
    position: absolute;
    width: 176px;
    height: 176px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /* Gradient ring */
    background: conic-gradient(
      from 0deg,
      var(--accent-blue),
      var(--accent-teal),
      var(--accent-violet),
      var(--accent-blue)
    );
    mask: radial-gradient(circle, transparent 78px, black 79px);
    -webkit-mask: radial-gradient(circle, transparent 78px, black 79px);
    animation: ring-rotate 6s linear infinite;
    opacity: 0.8;
  }

  @keyframes ring-rotate {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .portrait-block {
    position: relative;
  }

  .portrait-img {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    position: relative;
    z-index: 1;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    position: relative;
    z-index: 1;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-teal);
    box-shadow: 0 0 8px var(--accent-teal);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 4px var(--accent-teal); opacity: 1; }
    50% { box-shadow: 0 0 12px var(--accent-teal), 0 0 20px rgba(13, 148, 136, 0.3); opacity: 0.8; }
  }

  .status-text {
    font-size: var(--text-caption);
    font-weight: 650;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Narrative ── */
  .narrative-block {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .hero-kicker {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-teal);
  }

  .affiliation-pill {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: var(--accent-blue-light);
    background: rgba(20, 91, 255, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(20, 91, 255, 0.2);
  }

  .role-pill {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .author-name {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    color: #ffffff;
    line-height: 1.1;
  }

  .author-headline {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 750;
    color: var(--accent-blue-light);
  }

  .author-subheadline {
    margin: 0 0 var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }

  .editorial-lead {
    margin: 0 0 var(--space-4);
    font-size: var(--text-body-sm);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    max-width: 620px;
  }

  /* ── Focus Badges ── */
  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-5);
  }

  .focus-badge {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    transition: all var(--duration-fast) ease;
  }

  .focus-badge:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* ── Action Buttons ── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--touch-target-min);
    padding: 10px 24px;
    background: var(--accent-blue);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 20px rgba(20, 91, 255, 0.35);
    transition: all var(--duration-fast) ease;
    cursor: pointer;
    border: none;
  }

  .hero-primary-btn:hover {
    background: var(--accent-blue-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(20, 91, 255, 0.45);
  }

  .hero-secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: var(--touch-target-min);
    padding: 10px 18px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 650;
    text-decoration: none;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all var(--duration-fast) ease;
    cursor: pointer;
  }

  .hero-secondary-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .hero-social-group {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero-social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all var(--duration-fast) ease;
    cursor: pointer;
    text-decoration: none;
  }

  .hero-social-icon-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .hero-social-icon-btn svg {
    display: block;
    flex-shrink: 0;
  }

  /* ── Stats Ribbon ── */
  .stats-ribbon {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    padding-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    z-index: 1;
  }

  .stat-cell {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    transition: all var(--duration-fast) ease;
  }

  .stat-cell:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .stat-tag {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-teal);
    margin-bottom: var(--space-1);
  }

  .stat-metric {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 850;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 2px;
  }

  .stat-label {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 750;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 4px;
  }

  .stat-detail {
    margin: 0;
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.45;
  }

  /* ── Responsive ── */
  @media (max-width: 840px) {
    .stats-ribbon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }

    .meta-row,
    .badges-row,
    .hero-actions {
      justify-content: center;
    }

    .editorial-lead {
      text-align: center;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-primary-btn {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .stats-ribbon {
      grid-template-columns: 1fr;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .portrait-ring {
      animation: none;
    }

    .pulse-dot {
      animation: none;
    }

    .ambient-orb {
      animation: none;
    }
  }
</style>
