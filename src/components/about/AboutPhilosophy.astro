---
/**
 * AboutPhilosophy.astro
 * Architectural Manifesto with progressive disclosure.
 * Shows icon + title + quote upfront. Description + takeaway behind toggle.
 */
import type { ManifestoPrinciple } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  principles: ManifestoPrinciple[];
}

const { kicker, title, subtitle, principles } = Astro.props;
---

<section class="about-section manifesto-section" id="philosophy" aria-labelledby="manifesto-title" data-reveal="fade-up">
  <div class="manifesto-canvas">
    <div class="section-header">
      <p class="stage-kicker">{kicker}</p>
      <h2 id="manifesto-title" class="section-title">{title}</h2>
      <p class="section-subtitle">{subtitle}</p>
    </div>

    <div class="manifesto-grid" data-reveal-stagger="120">
      {principles.map((p) => (
        <article class="manifesto-card" data-reveal="fade-up">
          {/* Always visible: icon, number, title, quote */}
          <div class="card-icon-block">
            <div class="icon-circle" aria-hidden="true">
              <span class="manifesto-icon">{p.icon}</span>
            </div>
            <div class="card-labels">
              <span class="manifesto-num">{p.number}</span>
              <span class="manifesto-kicker">{p.kicker}</span>
            </div>
          </div>

          <h3 class="manifesto-heading">{p.title}</h3>

          <div class="manifesto-quote-box">
            <p class="quote-text">"{p.quote}"</p>
          </div>

          {/* Progressive disclosure: description + takeaway */}
          <details class="principle-details">
            <summary class="principle-toggle">
              <span class="toggle-label">Why this matters</span>
              <span class="toggle-icon" aria-hidden="true"></span>
            </summary>
            <div class="principle-expanded">
              <p class="manifesto-desc">{p.description}</p>
              <div class="manifesto-takeaway">
                <span class="takeaway-bullet" aria-hidden="true">↳</span>
                <p class="takeaway-core"><strong>Takeaway:</strong> {p.takeaway}</p>
              </div>
            </div>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .manifesto-section { margin-bottom: clamp(40px, 5vw, 56px); }

  .manifesto-canvas {
    background: var(--surface-subtle);
    border-radius: var(--radius-xl);
    padding: clamp(28px, 4vw, 44px) clamp(24px, 3vw, 36px);
  }

  .section-header { max-width: 760px; margin-bottom: clamp(24px, 3vw, 36px); }
  .section-title { margin: 0 0 6px; font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; color: var(--ink-display); letter-spacing: -0.025em; }
  .section-subtitle { margin: 0; font-size: var(--text-caption); color: var(--ink-muted); line-height: 1.5; }

  .manifesto-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }

  .manifesto-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 28px);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: all var(--duration-base) var(--ease-out-expo);
  }

  .manifesto-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); transform: translateY(-3px); }

  .card-icon-block { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }

  .icon-circle {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, var(--surface-blue-subtle) 0%, var(--surface-teal-subtle) 100%);
    border: 1px solid var(--border-medium);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }

  .manifesto-icon { font-size: 1.35rem; line-height: 1; }
  .card-labels { display: flex; flex-direction: column; gap: 1px; }
  .manifesto-num { font-family: var(--font-mono); font-size: var(--text-caption); font-weight: 700; color: var(--accent-blue); }
  .manifesto-kicker { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 800; letter-spacing: 0.06em; color: var(--accent-blue-dark); text-transform: uppercase; }
  .manifesto-heading { margin: 0 0 var(--space-3); font-family: var(--font-display); font-size: var(--text-lead); font-weight: 800; color: var(--ink-display); line-height: 1.3; }

  .manifesto-quote-box {
    background: linear-gradient(135deg, var(--surface-blue-subtle) 0%, var(--surface-subtle) 100%);
    border-left: 3px solid var(--accent-blue);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }

  .quote-text { margin: 0; font-family: var(--font-display); font-size: var(--text-body-sm); font-style: italic; font-weight: 650; color: var(--ink-display); line-height: 1.5; }

  /* ── Progressive Disclosure ── */
  .principle-details { margin-top: 0; }

  .principle-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: var(--font-display); font-size: var(--text-caption); font-weight: 700;
    color: var(--accent-blue); padding: 4px 0;
    list-style: none; user-select: none;
    transition: color var(--duration-fast) ease;
  }

  .principle-toggle::-webkit-details-marker { display: none; }
  .principle-toggle:hover { color: var(--accent-blue-hover); }

  .toggle-icon::after { content: '▸'; display: inline-block; transition: transform var(--duration-fast) ease; }
  details[open] .toggle-icon::after { transform: rotate(90deg); }
  details[open] .toggle-label { display: none; }
  details[open] .toggle-icon::before { content: 'Collapse'; font-family: var(--font-display); }

  .principle-expanded {
    padding-top: var(--space-3);
    display: flex; flex-direction: column; gap: var(--space-3);
    animation: expand-in var(--duration-base) var(--ease-out-expo);
  }

  @keyframes expand-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .manifesto-desc { margin: 0; font-size: var(--text-caption); color: var(--ink); line-height: 1.6; }

  .manifesto-takeaway { display: flex; align-items: baseline; gap: var(--space-2); padding: var(--space-3); background: var(--surface-blue-subtle); border-radius: var(--radius-sm); }
  .takeaway-bullet { color: var(--accent-blue); font-weight: 800; font-size: 1.1rem; flex-shrink: 0; }
  .takeaway-core { margin: 0; font-size: var(--text-caption); color: var(--ink-display); line-height: 1.4; }

  @media (max-width: 800px) { .manifesto-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .principle-expanded { animation: none; } }
</style>
