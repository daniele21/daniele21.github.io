---
/**
 * AboutPhilosophy.astro
 * Architectural Manifesto & Operating Principles.
 * Compact editorial quotes and practical takeaways.
 */
import type { ManifestoPrinciple } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  principles: ManifestoPrinciple[];
}

const { kicker, title, subtitle, principles } = Astro.props;
---

<section class="about-section manifesto-section" aria-labelledby="manifesto-title">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="manifesto-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="manifesto-grid">
    {principles.map((p) => (
      <article class="manifesto-card">
        <div class="card-meta">
          <span class="manifesto-icon" aria-hidden="true">{p.icon}</span>
          <span class="manifesto-num">{p.number}</span>
          <span class="manifesto-kicker">{p.kicker}</span>
        </div>

        <h3 class="manifesto-heading">{p.title}</h3>

        <div class="manifesto-quote-box">
          <p class="quote-text">“{p.quote}”</p>
        </div>

        <p class="manifesto-desc">{p.description}</p>

        <div class="manifesto-takeaway">
          <span class="takeaway-bullet">↳</span>
          <p class="takeaway-core"><strong>Takeaway:</strong> {p.takeaway}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .manifesto-section {
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: clamp(20px, 3vw, 28px);
  }

  .section-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .manifesto-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.5vw, 24px);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-fast) ease;
  }

  .manifesto-card:hover {
    border-color: var(--border-strong);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }

  .manifesto-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .manifesto-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .manifesto-kicker {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-blue-dark);
    text-transform: uppercase;
  }

  .manifesto-heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.3;
  }

  .manifesto-quote-box {
    background: var(--surface-subtle);
    border-left: 2px solid var(--accent-blue);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
  }

  .quote-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-style: italic;
    font-weight: 650;
    color: var(--ink-display);
    line-height: 1.45;
  }

  .manifesto-desc {
    margin: 0 0 var(--space-3);
    font-size: var(--text-caption);
    color: var(--ink);
    line-height: 1.55;
    flex-grow: 1;
  }

  .manifesto-takeaway {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 10px;
    background: var(--surface-blue-subtle);
    border-radius: var(--radius-sm);
  }

  .takeaway-bullet {
    color: var(--accent-blue);
    font-weight: 800;
  }

  .takeaway-core {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-display);
    line-height: 1.35;
  }

  @media (max-width: 800px) {
    .manifesto-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
