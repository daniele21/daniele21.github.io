---
/**
 * AboutExperience.astro
 * Career timeline with progressive disclosure.
 * Shows role + company + period + description upfront.
 * Responsibilities + technologies behind expand toggle.
 */
import type { CareerRole } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  roles: CareerRole[];
}

const { kicker, title, subtitle, roles } = Astro.props;

const badgeAccents: Record<string, string> = {
  'Enterprise Leadership': '--accent-blue',
  'Systems Research': '--accent-teal',
  'Editorial & Education': '--accent-violet',
  'Academic Foundations': '--accent-indigo',
};
---

<section class="about-section experience-section" id="experience" aria-labelledby="experience-title" data-reveal="fade-up">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="experience-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="timeline-container" data-reveal-stagger="150">
    {roles.map((role, idx) => {
      const accentVar = badgeAccents[role.badge || ''] || '--accent-blue';
      return (
        <article class="timeline-entry" data-reveal="fade-up" style={`--role-accent: var(${accentVar})`}>
          <div class="timeline-rail" aria-hidden="true">
            <div class="timeline-dot"></div>
            {idx !== roles.length - 1 && <div class="timeline-line"></div>}
          </div>

          <div class="timeline-card">
            {/* Always visible: badge, title, company, period, description */}
            <div class="card-header">
              <div class="header-main">
                <span class="role-badge">{role.badge || 'Leadership'}</span>
                <h3 class="role-title">{role.role}</h3>
                <div class="company-row">
                  {role.companyUrl ? (
                    <a href={role.companyUrl} target="_blank" rel="noopener noreferrer" class="company-link">
                      {role.company} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="company-name">{role.company}</span>
                  )}
                  <span class="meta-sep" aria-hidden="true">·</span>
                  <span class="role-location">{role.location}</span>
                </div>
              </div>
              <time class="role-period">{role.period}</time>
            </div>

            <p class="role-desc">{role.description}</p>

            {/* Progressive disclosure: responsibilities + technologies */}
            <details class="role-details">
              <summary class="role-toggle">
                <span class="toggle-label">Show details</span>
                <span class="toggle-icon" aria-hidden="true"></span>
              </summary>
              <div class="role-expanded">
                <div class="responsibilities-block">
                  <span class="resp-heading">Key Focus & Systems Delivered:</span>
                  <ul class="resp-list">
                    {role.responsibilities.map((resp) => <li>{resp}</li>)}
                  </ul>
                </div>

                {role.technologies && role.technologies.length > 0 && (
                  <div class="tech-row">
                    {role.technologies.map((tech) => <span class="tech-pill">{tech}</span>)}
                  </div>
                )}
              </div>
            </details>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .experience-section { margin-bottom: clamp(40px, 5vw, 56px); }
  .section-header { max-width: 760px; margin-bottom: clamp(24px, 3vw, 36px); }
  .section-title { margin: 0 0 6px; font-family: var(--font-display); font-size: var(--text-h2); font-weight: 800; color: var(--ink-display); letter-spacing: -0.025em; }
  .section-subtitle { margin: 0; font-size: var(--text-caption); color: var(--ink-muted); line-height: 1.5; }

  .timeline-container { display: flex; flex-direction: column; gap: var(--space-4); position: relative; }

  .timeline-entry { display: grid; grid-template-columns: 24px 1fr; gap: var(--space-4); position: relative; }
  .timeline-rail { display: flex; flex-direction: column; align-items: center; padding-top: 18px; }

  .timeline-dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--role-accent, var(--accent-blue));
    border: 3px solid var(--surface-canvas);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--role-accent, var(--accent-blue)) 30%, transparent),
                0 0 12px color-mix(in srgb, var(--role-accent, var(--accent-blue)) 20%, transparent);
    flex-shrink: 0; z-index: 2;
  }

  .timeline-line {
    width: 2px; flex-grow: 1;
    background: linear-gradient(to bottom, var(--role-accent, var(--border-medium)), var(--border-subtle));
    margin-top: 6px; opacity: 0.4;
  }

  .timeline-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-left: 3px solid var(--role-accent, var(--accent-blue));
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.5vw, 24px);
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-base) var(--ease-out-expo);
  }

  .timeline-card:hover { border-color: var(--border-strong); border-left-color: var(--role-accent, var(--accent-blue)); box-shadow: var(--shadow-md); transform: translateY(-2px); }

  .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-2); margin-bottom: var(--space-2); flex-wrap: wrap; }

  .role-badge {
    display: inline-block; font-family: var(--font-display); font-size: var(--text-caption);
    font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--role-accent, var(--accent-blue-dark));
    background: color-mix(in srgb, var(--role-accent, var(--accent-blue)) 10%, transparent);
    padding: 2px 8px; border-radius: 4px; margin-bottom: 4px;
  }

  .role-title { margin: 0 0 4px; font-family: var(--font-display); font-size: var(--text-lead); font-weight: 800; color: var(--ink-display); line-height: 1.3; }
  .company-row { display: flex; align-items: center; gap: 6px; font-size: var(--text-caption); font-weight: 600; color: var(--ink-muted); flex-wrap: wrap; }
  .company-link { color: var(--accent-blue); text-decoration: none; font-weight: 750; }
  .company-link:hover { text-decoration: underline; }
  .company-name { color: var(--ink); font-weight: 750; }
  .meta-sep { color: var(--ink-subtle); }
  .role-period { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 750; color: var(--ink-display); background: var(--surface-subtle); border: 1px solid var(--border-medium); padding: 3px 10px; border-radius: var(--radius-full); white-space: nowrap; }

  .role-desc { margin: 0 0 var(--space-3); font-size: var(--text-caption); color: var(--ink); line-height: 1.6; }

  /* ── Progressive Disclosure ── */
  .role-details { margin-top: 0; }

  .role-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: var(--font-display); font-size: var(--text-caption); font-weight: 700;
    color: var(--accent-blue); padding: 4px 0;
    list-style: none; user-select: none;
    transition: color var(--duration-fast) ease;
  }

  .role-toggle::-webkit-details-marker { display: none; }
  .role-toggle:hover { color: var(--accent-blue-hover); }

  .toggle-icon::after { content: '▸'; display: inline-block; transition: transform var(--duration-fast) ease; }
  details[open] .toggle-icon::after { transform: rotate(90deg); }
  details[open] .toggle-label { display: none; }
  details[open] .toggle-icon::before { content: 'Collapse'; font-family: var(--font-display); }

  .role-expanded {
    padding-top: var(--space-3);
    display: flex; flex-direction: column; gap: var(--space-3);
    animation: expand-in var(--duration-base) var(--ease-out-expo);
  }

  @keyframes expand-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .responsibilities-block { margin-bottom: 0; }
  .resp-heading { display: block; font-family: var(--font-display); font-size: var(--text-caption); font-weight: 800; color: var(--ink-display); margin-bottom: 6px; }
  .resp-list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }
  .resp-list li { font-size: var(--text-caption); color: var(--ink-muted); line-height: 1.5; }
  .resp-list li::marker { color: var(--role-accent, var(--accent-blue)); }

  .tech-row { display: flex; flex-wrap: wrap; gap: 5px; padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); }
  .tech-pill { font-family: var(--font-mono); font-size: var(--text-caption); color: var(--ink-muted); background: var(--surface-subtle); border: 1px solid var(--border-medium); padding: 2px 8px; border-radius: 4px; transition: all var(--duration-fast) ease; }
  .tech-pill:hover { background: var(--surface-card); border-color: var(--border-strong); color: var(--ink-display); }

  @media (max-width: 640px) {
    .timeline-entry { grid-template-columns: 1fr; }
    .timeline-rail { display: none; }
    .card-header { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) { .role-expanded { animation: none; } }
</style>
