---
/**
 * AboutExperience.astro
 * Sleek timeline of leadership, open-weight research, and engineering foundations.
 */
import type { CareerRole } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  roles: CareerRole[];
}

const { kicker, title, subtitle, roles } = Astro.props;
---

<section class="about-section experience-section" aria-labelledby="experience-title">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="experience-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="timeline-container">
    {roles.map((role, idx) => (
      <article class="timeline-entry">
        <div class="timeline-rail" aria-hidden="true">
          <div class="timeline-dot"></div>
          {idx !== roles.length - 1 && <div class="timeline-line"></div>}
        </div>

        <div class="timeline-card">
          <div class="card-header">
            <div class="header-main">
              <span class="role-badge">{role.badge || 'Leadership'}</span>
              <h3 class="role-title">{role.role}</h3>
              <div class="company-row">
                {role.companyUrl ? (
                  <a href={role.companyUrl} target="_blank" rel="noopener noreferrer" class="company-link">
                    {role.company} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="company-name">{role.company}</span>
                )}
                <span class="meta-sep" aria-hidden="true">·</span>
                <span class="role-location">{role.location}</span>
              </div>
            </div>
            <time class="role-period">{role.period}</time>
          </div>

          <p class="role-desc">{role.description}</p>

          <div class="responsibilities-block">
            <span class="resp-heading">Key Focus & Systems Delivered:</span>
            <ul class="resp-list">
              {role.responsibilities.map((resp) => (
                <li>{resp}</li>
              ))}
            </ul>
          </div>

          {role.technologies && role.technologies.length > 0 && (
            <div class="tech-row">
              {role.technologies.map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .experience-section {
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: clamp(20px, 3vw, 28px);
  }

  .section-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--space-3);
    position: relative;
  }

  .timeline-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 16px;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-blue);
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 2px rgba(20, 91, 255, 0.2);
    flex-shrink: 0;
    z-index: 2;
  }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background: var(--border-medium);
    margin-top: 6px;
  }

  .timeline-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(16px, 2.5vw, 24px);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--duration-fast) ease;
  }

  .timeline-card:hover {
    border-color: var(--border-strong);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .role-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue-dark);
    background: var(--surface-blue-subtle);
    padding: 1px 6px;
    border-radius: 3px;
    margin-bottom: 4px;
  }

  .role-title {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.3;
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .company-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 750;
  }

  .company-link:hover {
    text-decoration: underline;
  }

  .company-name {
    color: var(--ink);
    font-weight: 750;
  }

  .meta-sep {
    color: var(--ink-subtle);
  }

  .role-period {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 750;
    color: var(--ink-display);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .role-desc {
    margin: 0 0 var(--space-3);
    font-size: var(--text-caption);
    color: var(--ink);
    line-height: 1.55;
  }

  .responsibilities-block {
    margin-bottom: var(--space-3);
  }

  .resp-heading {
    display: block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--ink-display);
    margin-bottom: 4px;
    letter-spacing: 0.02em;
  }

  .resp-list {
    margin: 0;
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .resp-list li {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    padding: 1px 6px;
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .timeline-entry {
      grid-template-columns: 1fr;
    }

    .timeline-rail {
      display: none;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
