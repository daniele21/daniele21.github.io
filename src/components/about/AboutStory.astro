---
/**
 * AboutStory.astro
 * Vertical timeline narrative with progressive disclosure.
 * Shows chapter title + timeframe + first paragraph. Full content
 * revealed on click via <details>/<summary> for accessibility.
 */
import type { NarrativeChapter } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  chapters: NarrativeChapter[];
}

const { kicker, title, subtitle, chapters } = Astro.props;
---

<section class="about-section story-section" id="story" aria-labelledby="story-title" data-reveal="fade-up">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="story-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="timeline-flow">
    <div class="timeline-track" aria-hidden="true"></div>

    {chapters.map((chapter, idx) => (
      <article
        class={`chapter-entry ${idx % 2 === 0 ? 'chapter--left' : 'chapter--right'}`}
        data-reveal={idx % 2 === 0 ? 'slide-right' : 'slide-left'}
      >
        <div class="timeline-node" aria-hidden="true">
          <span class="node-number">{chapter.number}</span>
        </div>

        <div class="chapter-card">
          {/* Always visible: kicker, timeframe, title, first paragraph */}
          <div class="chapter-meta">
            <span class="chapter-kicker">{chapter.kicker}</span>
            <span class="chapter-timeframe">{chapter.timeframe}</span>
          </div>
          <h3 class="chapter-heading">{chapter.title}</h3>
          <p class="chapter-lead">{chapter.paragraphs[0]}</p>

          {/* Progressive disclosure: remaining content */}
          {(chapter.paragraphs.length > 1 || chapter.pullQuote || chapter.keyTakeaway || (chapter.tags && chapter.tags.length > 0)) && (
            <details class="chapter-details">
              <summary class="chapter-toggle">
                <span class="toggle-label">Continue reading</span>
                <span class="toggle-icon" aria-hidden="true"></span>
              </summary>

              <div class="chapter-expanded">
                {chapter.paragraphs.length > 1 && (
                  <div class="chapter-body">
                    {chapter.paragraphs.slice(1).map((p) => <p>{p}</p>)}
                  </div>
                )}

                {chapter.pullQuote && (
                  <blockquote class="chapter-quote">
                    <span class="quote-mark" aria-hidden="true">"</span>
                    <p>{chapter.pullQuote}</p>
                  </blockquote>
                )}

                {chapter.keyTakeaway && (
                  <div class="chapter-takeaway">
                    <span class="takeaway-icon" aria-hidden="true">↳</span>
                    <div class="takeaway-content">
                      <span class="takeaway-label">Key Insight</span>
                      <span class="takeaway-text">{chapter.keyTakeaway}</span>
                    </div>
                  </div>
                )}

                {chapter.tags && chapter.tags.length > 0 && (
                  <div class="chapter-tags">
                    {chapter.tags.map((t) => <span class="tag-pill">{t}</span>)}
                  </div>
                )}
              </div>
            </details>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .story-section {
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .section-title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* ── Timeline Flow ── */
  .timeline-flow {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3.5vw, 40px);
  }

  .timeline-track {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, var(--accent-blue) 0%, var(--accent-teal) 40%, var(--accent-violet) 80%, var(--accent-indigo) 100%);
    border-radius: var(--radius-full);
    opacity: 0.3;
  }

  /* ── Chapter Entry ── */
  .chapter-entry {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    align-items: flex-start;
    position: relative;
  }

  .chapter--left .chapter-card { grid-column: 1; grid-row: 1; }
  .chapter--left .timeline-node { grid-column: 2; grid-row: 1; }
  .chapter--right .chapter-card { grid-column: 3; grid-row: 1; }
  .chapter--right .timeline-node { grid-column: 2; grid-row: 1; }
  .chapter--left::after { content: ''; grid-column: 3; grid-row: 1; }
  .chapter--right::before { content: ''; grid-column: 1; grid-row: 1; }

  .timeline-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-blue);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 850;
    z-index: 2;
    justify-self: center;
    box-shadow: 0 0 0 4px var(--surface-canvas), 0 0 20px rgba(20, 91, 255, 0.2);
    margin-top: var(--space-4);
  }

  .node-number { line-height: 1; }

  /* ── Chapter Card ── */
  .chapter-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.5vw, 24px);
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-base) var(--ease-out-expo);
  }

  .chapter-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .chapter-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--space-2);
  }

  .chapter-kicker {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-blue-dark);
  }

  .chapter-timeframe {
    font-size: var(--text-caption);
    color: var(--ink-subtle);
    font-weight: 600;
  }

  .chapter-heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.3;
  }

  .chapter-lead {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink);
    line-height: 1.6;
  }

  /* ── Progressive Disclosure ── */
  .chapter-details {
    margin-top: var(--space-3);
  }

  .chapter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--accent-blue);
    padding: 4px 0;
    list-style: none;
    user-select: none;
    transition: color var(--duration-fast) ease;
  }

  .chapter-toggle::-webkit-details-marker { display: none; }

  .chapter-toggle:hover { color: var(--accent-blue-hover); }

  .toggle-icon::after {
    content: '▸';
    display: inline-block;
    transition: transform var(--duration-fast) ease;
  }

  details[open] .toggle-icon::after {
    transform: rotate(90deg);
  }

  details[open] .toggle-label { display: none; }
  details[open] .toggle-icon::before { content: 'Collapse'; font-family: var(--font-display); }

  .chapter-expanded {
    padding-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    animation: expand-in var(--duration-base) var(--ease-out-expo);
  }

  @keyframes expand-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chapter-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .chapter-body p {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink);
    line-height: 1.6;
  }

  .chapter-quote {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: linear-gradient(135deg, var(--surface-blue-subtle) 0%, var(--surface-subtle) 100%);
    border-left: 3px solid var(--accent-blue);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    position: relative;
  }

  .quote-mark {
    position: absolute;
    top: -8px;
    left: 12px;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    color: var(--accent-blue);
    opacity: 0.15;
    line-height: 1;
  }

  .chapter-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-body-sm);
    font-style: italic;
    font-weight: 650;
    color: var(--ink-display);
    line-height: 1.5;
  }

  .chapter-takeaway {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--surface-blue-subtle);
    border-radius: var(--radius-sm);
  }

  .takeaway-icon { color: var(--accent-blue); font-weight: 800; font-size: 1.1rem; flex-shrink: 0; }
  .takeaway-content { display: flex; flex-direction: column; gap: 2px; }
  .takeaway-label { font-family: var(--font-display); font-size: var(--text-caption); font-weight: 800; color: var(--accent-blue-dark); }
  .takeaway-text { font-size: var(--text-caption); font-weight: 600; color: var(--ink); line-height: 1.4; }

  .chapter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ink-muted);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* ── Mobile ── */
  @media (max-width: 860px) {
    .timeline-track { left: 20px; }

    .chapter-entry { grid-template-columns: 48px 1fr; }

    .chapter--left .chapter-card,
    .chapter--right .chapter-card { grid-column: 2; grid-row: 1; }

    .chapter--left .timeline-node,
    .chapter--right .timeline-node { grid-column: 1; grid-row: 1; }

    .chapter--left::after,
    .chapter--right::before { display: none; }

    .timeline-node { width: 36px; height: 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-expanded { animation: none; }
  }
</style>
