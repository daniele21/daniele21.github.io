---
/**
 * AboutStory.astro
 * First-person narrative storytelling with compact editorial design.
 */
import type { NarrativeChapter } from '../../types/about';

interface Props {
  kicker: string;
  title: string;
  subtitle: string;
  chapters: NarrativeChapter[];
}

const { kicker, title, subtitle, chapters } = Astro.props;
---

<section class="about-section story-section" aria-labelledby="story-title">
  <div class="section-header">
    <p class="stage-kicker">{kicker}</p>
    <h2 id="story-title" class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="story-chapters">
    {chapters.map((chapter) => (
      <article class="chapter-card">
        <div class="chapter-meta">
          <span class="chapter-num">{chapter.number}</span>
          <div class="chapter-labels">
            <span class="chapter-kicker">{chapter.kicker}</span>
            <span class="chapter-timeframe">{chapter.timeframe}</span>
          </div>
        </div>

        <h3 class="chapter-heading">{chapter.title}</h3>

        <div class="chapter-body">
          {chapter.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        {chapter.pullQuote && (
          <blockquote class="chapter-quote">
            <p>“{chapter.pullQuote}”</p>
          </blockquote>
        )}

        {chapter.keyTakeaway && (
          <div class="chapter-takeaway">
            <span class="takeaway-label">Key Insight:</span>
            <span class="takeaway-text">{chapter.keyTakeaway}</span>
          </div>
        )}

        {chapter.tags && chapter.tags.length > 0 && (
          <div class="chapter-tags">
            {chapter.tags.map((t) => (
              <span class="tag-pill">{t}</span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .story-section {
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: clamp(20px, 3vw, 28px);
  }

  .section-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .section-subtitle {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .story-chapters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .chapter-card {
    background: var(--surface-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.5vw, 24px);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-fast) ease;
  }

  .chapter-card:hover {
    border-color: var(--border-strong);
  }

  .chapter-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .chapter-num {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 850;
    color: var(--accent-blue);
    background: var(--surface-blue-subtle);
    padding: 1px 8px;
    border-radius: var(--radius-sm);
  }

  .chapter-labels {
    display: flex;
    flex-direction: column;
  }

  .chapter-kicker {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-blue-dark);
  }

  .chapter-timeframe {
    font-size: 0.75rem;
    color: var(--ink-subtle);
    font-weight: 600;
  }

  .chapter-heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--ink-display);
    line-height: 1.3;
  }

  .chapter-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    flex-grow: 1;
  }

  .chapter-body p {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink);
    line-height: 1.55;
  }

  .chapter-quote {
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--surface-subtle);
    border-left: 2px solid var(--accent-blue);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .chapter-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-style: italic;
    font-weight: 600;
    color: var(--ink-display);
    line-height: 1.45;
  }

  .chapter-takeaway {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 6px 10px;
    background: var(--surface-blue-subtle);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .takeaway-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-blue-dark);
  }

  .takeaway-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }

  .chapter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    padding: 1px 6px;
    border-radius: 3px;
  }

  @media (max-width: 800px) {
    .story-chapters {
      grid-template-columns: 1fr;
    }
  }
</style>
