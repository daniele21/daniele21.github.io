---
/**
 * AboutCta.astro
 * Compact Advisory & collaboration callout for the /about page.
 */
interface Props {
  kicker: string;
  title: string;
  description: string;
  primaryActionLabel: string;
  primaryActionHref: string;
  secondaryActionLabel: string;
  secondaryActionHref: string;
}

const {
  kicker,
  title,
  description,
  primaryActionLabel,
  primaryActionHref,
  secondaryActionLabel,
  secondaryActionHref,
} = Astro.props;
---

<section class="about-section about-cta-section" id="contact" aria-labelledby="cta-title">
  <div class="cta-editorial-box">
    <div class="cta-narrative">
      <span class="stage-kicker">{kicker}</span>
      <h2 id="cta-title" class="cta-title">{title}</h2>
      <p class="cta-desc">{description}</p>
    </div>

    <div class="cta-button-group">
      <a class="primary-button" href={primaryActionHref}>
        {primaryActionLabel}
      </a>
      <a
        class="secondary-button"
        href={secondaryActionHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {secondaryActionLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .about-cta-section {
    margin-bottom: clamp(24px, 4vw, 36px);
  }

  .cta-editorial-box {
    background: linear-gradient(135deg, var(--surface-card) 0%, var(--surface-blue-subtle) 100%);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 32px);
    box-shadow: var(--shadow-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    position: relative;
    overflow: hidden;
  }

  .cta-editorial-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-teal) 100%);
  }

  .cta-narrative {
    max-width: 600px;
  }

  .stage-kicker {
    margin: 0 0 2px;
  }

  .cta-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 800;
    color: var(--ink-display);
    letter-spacing: -0.025em;
  }

  .cta-desc {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .cta-button-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 220px;
  }

  .cta-button-group a {
    width: 100%;
    text-align: center;
    padding: 8px 16px;
    font-size: var(--text-caption);
  }

  @media (max-width: 800px) {
    .cta-editorial-box {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-button-group {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .cta-button-group a {
      width: auto;
      flex: 1 1 180px;
    }
  }

  @media (max-width: 500px) {
    .cta-button-group {
      flex-direction: column;
    }

    .cta-button-group a {
      width: 100%;
    }
  }
</style>
