---
/**
 * LocalLlmHero.astro
 * Hero section for the Local LLM Server page.
 * Displays eyebrow, headline, key pills, CTAs, and dominant product visual.
 */
import { localLlmServerData } from '../../content/localLlmServer';

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
const { hero } = localLlmServerData;
---

<section class="hero-section" id="top">
  <div class="shell">
    <div class="hero-grid">
      <div class="hero-content reveal">
        <div class="hero-eyebrow-row">
          <img
            src={`${baseUrl}/images/local-llm-server/logo.svg`}
            alt="Local LLM Server logo"
            class="hero-logo-img"
            width="32"
            height="32"
          />
          <span class="hero-eyebrow">{hero.eyebrow}</span>
          <div class="hero-badges">
            {hero.badges.map((b) => (
              <span class="hero-badge">{b}</span>
            ))}
          </div>
        </div>

        <h1 class="hero-title">
          {hero.titleLine1}<br />
          <span class="hero-title-accent">{hero.titleLine2}</span>
        </h1>

        <p class="hero-lede">{hero.lede}</p>

        <div class="hero-pills">
          {hero.keyPills.map((pill) => (
            <span class="pill-item">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {pill}
            </span>
          ))}
        </div>

        <div class="hero-actions">
          <a href={hero.primaryCta.href} class="btn btn-primary">
            {hero.primaryCta.label}
          </a>
          <a
            href={hero.secondaryCta.href}
            class="btn btn-secondary"
            target="_blank"
            rel="noreferrer"
          >
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="visual-frame">
          <div class="window-bar">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
            <span class="window-title">Local LLM Studio - Chat Studio</span>
          </div>
          <img
            data-zoomable
            src={`${baseUrl}/${hero.imageHero.replace(/^\//, '')}`}
            alt="Local LLM Server Chat Studio interface preview"
            width="1200"
            height="750"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(40px, 6vw, 80px) 0;
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .hero-logo-img {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: #090d16;
    border: 1px solid rgba(13, 148, 136, 0.4);
    box-shadow: 0 4px 16px rgba(13, 148, 136, 0.3);
    flex-shrink: 0;
  }

  .hero-eyebrow {
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-badges {
    display: flex;
    gap: var(--space-2);
  }

  .hero-badge {
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--surface-blue);
    color: var(--accent-blue);
    border: 1px solid var(--border-subtle);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 var(--space-4) 0;
  }

  .hero-title-accent {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 var(--space-5) 0;
    max-width: 540px;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .pill-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .pill-item svg {
    color: var(--accent-teal);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: var(--radius-full);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-primary {
    background: var(--accent-blue);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(23, 92, 255, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(23, 92, 255, 0.4);
  }

  .btn-secondary {
    background: var(--surface-card);
    color: var(--ink);
    border: 1px solid var(--border-subtle);
  }

  .btn-secondary:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .hero-visual {
    width: 100%;
  }

  .visual-frame {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    transition: transform var(--duration-base) ease;
  }

  .visual-frame:hover {
    transform: translateY(-4px);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--surface-muted);
    border-bottom: 1px solid var(--border-subtle);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .window-title {
    margin-left: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-muted);
    font-family: var(--font-mono, monospace);
  }

  .visual-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
