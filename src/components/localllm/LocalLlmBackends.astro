---
/**
 * LocalLlmBackends.astro
 * Backend engine comparison table component.
 */
import { localLlmServerData } from '../../content/localLlmServer';

const { backends } = localLlmServerData;
---

<section class="section" id="backends">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{backends.eyebrow}</div>
      <h2>{backends.title}</h2>
      <p class="lead">{backends.sub}</p>
    </div>

    <div class="table-wrapper reveal">
      <table class="backend-table">
        <thead>
          <tr>
            <th>Backend Engine</th>
            <th>Format</th>
            <th>Execution Model</th>
            <th>Current Role &amp; Target Workloads</th>
          </tr>
        </thead>
        <tbody>
          {backends.matrix.map((row) => (
            <tr>
              <td class="cell-backend" data-label="Backend engine">
                <code>{row.backend}</code>
              </td>
              <td data-label="Format">
                <span class="format-badge">{row.format}</span>
              </td>
              <td class="cell-exec" data-label="Execution model">{row.execution}</td>
              <td class="cell-role" data-label="Role / workload">{row.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: var(--text-caption);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
    font-weight: 800;
    color: var(--ink);
  }

  .lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .backend-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: var(--text-body-sm);
  }

  .backend-table th {
    padding: 14px 20px;
    background: var(--surface-muted);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-subtle);
  }

  .backend-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--ink-muted);
  }

  .backend-table tr:last-child td { border-bottom: none; }

  .cell-backend code {
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface-blue);
    color: var(--accent-blue);
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    font-size: var(--text-caption);
  }

  .format-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    color: var(--ink);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  .cell-exec {
    font-weight: 600;
    color: var(--ink);
  }

  .cell-role { line-height: 1.5; }

  @media (max-width: 640px) {
    .table-wrapper {
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .backend-table,
    .backend-table tbody,
    .backend-table tr,
    .backend-table td {
      display: block;
      width: 100%;
    }

    .backend-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .backend-table tbody {
      display: grid;
      gap: var(--space-3);
    }

    .backend-table tr {
      padding: var(--space-4);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      background: var(--surface-card);
      box-shadow: var(--shadow-sm);
    }

    .backend-table td {
      display: grid;
      grid-template-columns: minmax(112px, 0.44fr) minmax(0, 1fr);
      gap: var(--space-3);
      align-items: start;
      padding: var(--space-2) 0;
      border: 0;
      overflow-wrap: anywhere;
    }

    .backend-table td::before {
      content: attr(data-label);
      font-family: var(--font-display);
      font-size: var(--text-caption);
      font-weight: 750;
      color: var(--ink-subtle);
    }
  }
</style>
