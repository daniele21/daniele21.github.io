---
/**
 * LocalLlmRuntimeFlow.astro
 * Stable runtime request flow component.
 */
import { localLlmServerData } from '../../content/localLlmServer';

const { runtimeFlow } = localLlmServerData;
---

<section class="section flow-section" id="runtime">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{runtimeFlow.eyebrow}</div>
      <h2>{runtimeFlow.title}</h2>
      <p class="lead">{runtimeFlow.sub}</p>
    </div>

    <div class="flow-timeline reveal">
      {runtimeFlow.steps.map((st, index) => (
        <div class="flow-step">
          <div class="step-badge">{st.step}</div>
          <div class="step-body">
            <h3>{st.title}</h3>
            <p>{st.desc}</p>
          </div>
          {index < runtimeFlow.steps.length - 1 && (
            <div class="step-connector" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .flow-section {
    padding: clamp(60px, 7vw, 96px) 0;
    background: var(--surface-muted);
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
    font-weight: 800;
    color: var(--ink);
  }

  .lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .flow-timeline {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    align-items: stretch;
  }

  .flow-step {
    position: relative;
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
  }

  .step-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--surface-blue);
    color: var(--accent-blue);
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    margin-bottom: var(--space-3);
  }

  .step-body h3 {
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 750;
    color: var(--ink);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.3;
  }

  .step-body p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .step-connector {
    display: none;
  }

  @media (max-width: 1100px) {
    .flow-timeline {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .flow-timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
