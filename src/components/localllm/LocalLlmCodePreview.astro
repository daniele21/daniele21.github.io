---
/**
 * LocalLlmCodePreview.astro
 * OpenAI SDK Python code example with syntax block.
 */
import { localLlmServerData } from '../../content/localLlmServer';

const { codePreview } = localLlmServerData;
---

<section class="section" id="code">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{codePreview.eyebrow}</div>
      <h2>{codePreview.title}</h2>
      <p class="lead">{codePreview.sub}</p>
    </div>

    <div class="code-card reveal">
      <div class="code-header">
        <div class="code-title">
          <span class="dot"></span>
          python_client_example.py
        </div>
        <span class="lang-badge">OpenAI Python SDK</span>
      </div>
      <pre class="code-block"><code>{codePreview.code}</code></pre>
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
    font-weight: 800;
    color: var(--ink);
  }

  .lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .code-card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: #020617;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
  }

  .code-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
  }

  .lang-badge {
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: #1e293b;
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .code-block {
    margin: 0;
    padding: 24px;
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.88rem;
    line-height: 1.65;
    color: #e2e8f0;
  }
</style>
