---
/**
 * LocalLlmArchitecture.astro
 * System architecture diagram and technical breakdown.
 */
import { localLlmServerData } from '../../content/localLlmServer';

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
const { architecture } = localLlmServerData;
---

<section class="section arch-section" id="architecture">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{architecture.eyebrow}</div>
      <h2>{architecture.title}</h2>
      <p class="lead">{architecture.sub}</p>
    </div>

    <div class="arch-card reveal">
      <img
        data-zoomable
        src={`${baseUrl}/${architecture.image.replace(/^\//, '')}`}
        alt="Local LLM Server system architecture diagram"
        width="1000"
        height="600"
        loading="lazy"
      />
    </div>

    <div class="arch-details-grid reveal">
      {architecture.details.map((item) => (
        <div class="arch-detail-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .arch-section {
    padding: clamp(60px, 7vw, 96px) 0;
    background: var(--surface-muted);
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
    font-weight: 800;
    color: var(--ink);
  }

  .lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .arch-card {
    padding: 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: #020617;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-6);

    img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-lg);
      display: block;
      cursor: zoom-in;
    }
  }

  .arch-details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .arch-detail-card {
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .arch-detail-card h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 750;
    color: var(--ink);
    margin: 0 0 var(--space-2) 0;
  }

  .arch-detail-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  @media (max-width: 768px) {
    .arch-details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
