---
/**
 * LocalLlmProblems.astro
 * The 4 Infrastructure Gap dimensions section.
 */
import { localLlmServerData } from '../../content/localLlmServer';

const { problems } = localLlmServerData;
---

<section class="section" id="why">
  <div class="shell">
    <div class="section-head reveal">
      <div class="kicker">{problems.eyebrow}</div>
      <h2>{problems.title}</h2>
      <p class="lead">{problems.sub}</p>
    </div>

    <div class="problems-grid reveal">
      {problems.items.map((item) => (
        <div class="problem-card">
          <div class="problem-num">0{item.id}</div>
          <h3 class="problem-title">{item.title}</h3>
          <p class="problem-desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: clamp(60px, 7vw, 96px) 0;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--accent-blue);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
    font-weight: 800;
    color: var(--ink);
  }

  .lead {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .problem-card {
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .problem-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-blue-light, var(--border-subtle));
  }

  .problem-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-blue);
    opacity: 0.85;
    margin-bottom: var(--space-2);
  }

  .problem-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 750;
    color: var(--ink);
    margin: 0 0 var(--space-2) 0;
  }

  .problem-desc {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  @media (max-width: 768px) {
    .problems-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
