---
/**
 * LocalLlmMission.astro
 * Mission band & core architectural principles component.
 */
import { localLlmServerData } from '../../content/localLlmServer';

const { mission } = localLlmServerData;
---

<section class="section mission-section" id="mission">
  <div class="shell">
    <div class="mission-card reveal">
      <div class="eyebrow">{mission.eyebrow}</div>
      <h2 class="statement">"{mission.statement}"</h2>
      <p class="lede">{mission.lede}</p>

      <div class="principles-grid">
        {mission.principles.map((p) => (
          <div class={`principle-item principle-${p.color}`}>
            <h3>{p.title}</h3>
            <p>{p.subtitle}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .mission-section {
    padding: clamp(40px, 5vw, 64px) 0;
  }

  .mission-card {
    padding: clamp(32px, 5vw, 56px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, var(--surface-card), var(--surface-muted));
    box-shadow: var(--shadow-md);
  }

  .eyebrow {
    color: var(--accent-blue);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.2;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 var(--space-3) 0;
  }

  .lede {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 780px;
    margin: 0 0 var(--space-6) 0;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .principle-item {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) ease;
  }

  .principle-item:hover {
    transform: translateY(-2px);
  }

  .principle-item h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 750;
    margin: 0 0 var(--space-2) 0;
  }

  .principle-blue h3 { color: var(--accent-blue); }
  .principle-teal h3 { color: var(--accent-teal); }
  .principle-violet h3 { color: var(--accent-violet, #7c3aed); }

  .principle-item p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  @media (max-width: 840px) {
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
